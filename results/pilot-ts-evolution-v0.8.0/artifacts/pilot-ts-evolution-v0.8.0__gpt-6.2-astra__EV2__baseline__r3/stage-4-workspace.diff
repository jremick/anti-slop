+import assert from "node:assert/strict";
+import test from "node:test";
+import * as api from "../src/index.ts";
+import * as pricing from "../src/pricing.ts";
+import type { BookingNotification } from "../src/index.ts";
+
+const slot = { roomId: "a", customerId: "c", startMinute: 90, endMinute: 150 };
+const groupInput = { ...slot, roomIds: ["a", "b"], discountBps: 5000 };
+
+function setup(notifyHook: (event: BookingNotification) => void) {
+  const service = new api.BookingService({
+    env: { BOOKING_CANCEL_FEE_TIERS_JSON: '{"cutoffMinutes":30,"earlyFeeBps":2500,"lateFeeBps":5000}' },
+    notifyHook,
+  });
+  service.registerRoom({ roomId: "a", name: "A", hourlyRateCents: 100, taxBps: 1000 });
+  service.registerRoom({ roomId: "b", name: "B", hourlyRateCents: 120, taxBps: 0 });
+  return service;
+}
+
+test("pricing and public entry points expose no deposit API", () => {
+  for (const module of [api, pricing]) {
+    assert.deepEqual(Object.keys(module).filter(name => /deposit/i.test(name)), []);
+  }
+});
+
+test("notifications contain the held booking total, the refund, and each discounted group total", () => {
+  const events: BookingNotification[] = [];
+  const service = setup(event => events.push(event));
+  const held = service.createBooking({ ...slot, holdMinutes: 5 });
+  service.confirmHold(held.bookingId, 1);
+  service.cancelBooking(held.bookingId, 2);
+  const group = api.createGroupBooking(service, groupInput);
+  assert.deepEqual(events, [
+    { event: "booking_created", bookingId: held.bookingId, roomId: "a", customerId: "c", amountCents: 110 },
+    { event: "booking_cancelled", bookingId: held.bookingId, roomId: "a", customerId: "c", amountCents: 82 },
+    { event: "booking_created", bookingId: group.bookings[0].bookingId, roomId: "a", customerId: "c", amountCents: 55 },
+    { event: "booking_created", bookingId: group.bookings[1].bookingId, roomId: "b", customerId: "c", amountCents: 60 },
+  ]);
+});
+
+test("a failed creation hook leaves the slot available for a retry", () => {
+  const failure = new Error("notification failed");
+  let fail = true;
+  const service = setup(() => { if (fail) throw failure; });
+  assert.throws(() => service.createBooking(slot), error => error === failure);
+  assert.deepEqual(service.listRoomBookings("a"), []);
+  fail = false;
+  assert.equal(service.createBooking(slot).status, "confirmed");
+});
+
+test("failure on the second group notification leaves neither member stored", () => {
+  const failure = new Error("second notification failed");
+  const rooms: string[] = [];
+  const service = setup(event => {
+    rooms.push(event.roomId);
+    if (rooms.length === 2) throw failure;
+  });
+  assert.throws(() => api.createGroupBooking(service, groupInput), error => error === failure);
+  assert.deepEqual(rooms, ["a", "b"]);
+  assert.deepEqual(service.listRoomBookings("a"), []);
+  assert.deepEqual(service.listRoomBookings("b"), []);
+  assert.equal(api.createGroupBooking(service, groupInput).bookings.length, 2);
+});
+
+test("a failed cancellation hook preserves the booking and its conflict until retry", () => {
+  const failure = new Error("refund notification failed");
+  let fail = true;
+  const service = setup(event => {
+    if (event.event === "booking_cancelled" && fail) throw failure;
+  });
+  const booking = service.createBooking(slot);
+  assert.throws(() => service.cancelBooking(booking.bookingId, 0), error => error === failure);
+  assert.equal(service.getBooking(booking.bookingId).status, "confirmed");
+  assert.throws(() => service.createBooking(slot), api.ConflictError);
+  fail = false;
+  assert.equal(service.cancelBooking(booking.bookingId, 0).booking.status, "cancelled");
+  assert.equal(service.createBooking(slot).status, "confirmed");
+});
