+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  BookingService,
+  ConfigError,
+  ConflictError,
+  ValidationError,
+  computeCancellationRefund,
+  loadCancellationFeeConfig,
+  selectCancellationFeeBps,
+} from "../src/index.ts";
+
+const tiers = { cutoffMinutes: 30, earlyFeeBps: 1250, lateFeeBps: 5000 };
+const slot = { roomId: "a", customerId: "customer", startMinute: 90, endMinute: 150 };
+
+function setup(env: Record<string, string | undefined>) {
+  const service = new BookingService({ env });
+  service.registerRoom({ roomId: "a", name: "A", hourlyRateCents: 100, taxBps: 100 });
+  return { service, booking: service.createBooking(slot) };
+}
+
+test("early and late fees use the taxed total, including at cutoff and start", () => {
+  for (const [nowMinute, feeBps, feeCents] of [
+    [59, 1250, 13], [60, 1250, 13], [61, 5000, 51], [90, 5000, 51],
+  ]) {
+    const { service, booking } = setup({ BOOKING_CANCEL_FEE_TIERS_JSON: JSON.stringify(tiers) });
+    const result = service.cancelBooking(booking.bookingId, nowMinute);
+    assert.deepEqual(result, {
+      booking: { ...booking, status: "cancelled" }, feeBps, feeCents, refundCents: 101 - feeCents,
+    });
+    assert.deepEqual(service.getBooking(booking.bookingId), result.booking);
+    assert.throws(() => service.cancelBooking(booking.bookingId, nowMinute), ValidationError);
+    assert.equal(service.createBooking({ ...slot, nowMinute }).status, "confirmed");
+  }
+});
+
+test("missing or malformed configuration preserves the booking and blocks slot reuse", () => {
+  const env: Record<string, string | undefined> = {};
+  const { service, booking } = setup(env);
+  for (const raw of [
+    undefined, "", "  ", "{", "null", "[]", "false", "0", "{}",
+    JSON.stringify({ cutoffMinutes: 30, earlyFeeBps: 0 }),
+    ...[
+      { cutoffMinutes: -1 }, { cutoffMinutes: 1.5 }, { cutoffMinutes: null },
+      { earlyFeeBps: -1 }, { earlyFeeBps: 10001 }, { earlyFeeBps: 1.5 },
+      { lateFeeBps: -1 }, { lateFeeBps: 10001 }, { lateFeeBps: "500" },
+    ].map(override => JSON.stringify({ ...tiers, ...override })),
+  ]) {
+    env.BOOKING_CANCEL_FEE_TIERS_JSON = raw;
+    assert.throws(() => service.cancelBooking(booking.bookingId, 60), ConfigError);
+    assert.equal(service.getBooking(booking.bookingId).status, "confirmed");
+    assert.throws(() => service.createBooking(slot), ConflictError);
+  }
+  env.BOOKING_CANCEL_FEE_TIERS_JSON = JSON.stringify(tiers);
+  assert.equal(service.cancelBooking(booking.bookingId, 60).feeCents, 13);
+});
+
+test("unknown bookings and past-start cancellations raise ValidationError", () => {
+  const { service, booking } = setup({});
+  assert.throws(() => service.cancelBooking("missing", 90), ValidationError);
+  assert.throws(() => service.cancelBooking(booking.bookingId, 91), ValidationError);
+  assert.equal(service.getBooking(booking.bookingId).status, "confirmed");
+});
+
+test("zero-minute cutoff and fee endpoints are valid, and invalid refund operands are rejected", () => {
+  const cfg = loadCancellationFeeConfig({
+    BOOKING_CANCEL_FEE_TIERS_JSON: '{"cutoffMinutes":0,"earlyFeeBps":0,"lateFeeBps":10000}',
+  });
+  assert.equal(selectCancellationFeeBps(0, cfg), 0);
+  assert.deepEqual(computeCancellationRefund(7, cfg.earlyFeeBps), { feeCents: 0, refundCents: 7 });
+  assert.deepEqual(computeCancellationRefund(7, cfg.lateFeeBps), { feeCents: 7, refundCents: 0 });
+  for (const [total, rate] of [[-1, 0], [1.5, 0], [7, -1], [7, 0.5], [7, 10001]]) {
+    assert.throws(() => computeCancellationRefund(total, rate), ValidationError);
+  }
+});

