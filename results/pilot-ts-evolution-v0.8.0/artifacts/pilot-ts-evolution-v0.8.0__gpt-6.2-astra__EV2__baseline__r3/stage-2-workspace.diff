+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  applyDiscountAndTax,
+  BookingService,
+  ConflictError,
+  createGroupBooking,
+  ValidationError,
+} from "../src/index.ts";
+
+const input = {
+  customerId: "company",
+  roomIds: ["a", "b"],
+  startMinute: 60,
+  endMinute: 90,
+  discountBps: 5000,
+};
+
+function setup(): BookingService {
+  const service = new BookingService({ env: {} });
+  service.registerRoom({ roomId: "a", name: "A", hourlyRateCents: 10, taxBps: 2500 });
+  service.registerRoom({ roomId: "b", name: "B", hourlyRateCents: 18, taxBps: 1250 });
+  return service;
+}
+
+test("group totals sum discounts and taxes rounded independently for each room", () => {
+  const service = setup();
+  const { bookings, groupId, ...totals } = createGroupBooking(service, input);
+  assert.deepEqual(totals, { subtotalCents: 6, discountCents: 8, taxCents: 2, totalCents: 8 });
+  assert.deepEqual(bookings.map(b => [b.roomId, b.subtotalCents, b.discountCents, b.taxCents, b.totalCents]), [
+    ["a", 2, 3, 1, 3],
+    ["b", 4, 5, 1, 5],
+  ]);
+  assert.ok(groupId);
+  assert.notEqual(bookings[0].bookingId, bookings[1].bookingId);
+  for (const booking of bookings) {
+    assert.equal(booking.groupId, groupId);
+    assert.equal(booking.status, "confirmed");
+    assert.equal(booking.customerId, input.customerId);
+    assert.deepEqual(service.getBooking(booking.bookingId), booking);
+  }
+  const adjacent = createGroupBooking(service, { ...input, startMinute: 90, endMinute: 120 });
+  assert.notEqual(adjacent.groupId, groupId);
+});
+
+test("an active hold on the last room prevents every group booking until expiry", () => {
+  const service = setup();
+  const hold = service.createBooking({
+    roomId: "b", customerId: "other", startMinute: 89, endMinute: 91, holdMinutes: 5,
+  });
+  assert.throws(() => createGroupBooking(service, { ...input, nowMinute: 4 }), ConflictError);
+  assert.deepEqual(service.listRoomBookings("a"), []);
+  assert.deepEqual(service.listRoomBookings("b"), [hold]);
+  const group = createGroupBooking(service, { ...input, nowMinute: 5 });
+  assert.equal(group.bookings.length, 2);
+});
+
+test("invalid group requests leave all rooms empty", () => {
+  const service = setup();
+  for (const overrides of [
+    { roomIds: [] }, { roomIds: ["a"] }, { roomIds: ["a", "b", "a"] },
+    { roomIds: ["a", "unknown"] }, { discountBps: -1 }, { discountBps: 10001 },
+    { discountBps: 0.5 }, { customerId: " " }, { endMinute: 60 }, { nowMinute: -1 },
+  ]) {
+    assert.throws(() => createGroupBooking(service, { ...input, ...overrides }), ValidationError);
+  }
+  assert.deepEqual(service.listRoomBookings("a"), []);
+  assert.deepEqual(service.listRoomBookings("b"), []);
+});
+
+test("discount and tax accept both rate bounds and reject invalid cents or rates", () => {
+  assert.deepEqual(applyDiscountAndTax(11, 0, 10000), {
+    subtotalCents: 11, discountCents: 0, taxCents: 11, totalCents: 22,
+  });
+  assert.deepEqual(applyDiscountAndTax(11, 10000, 0), {
+    subtotalCents: 0, discountCents: 11, taxCents: 0, totalCents: 0,
+  });
+  for (const invalid of [-1, 0.1, 10001, NaN]) {
+    assert.throws(() => applyDiscountAndTax(10, invalid, 0), ValidationError);
+    assert.throws(() => applyDiscountAndTax(10, 0, invalid), ValidationError);
+  }
+  for (const invalid of [-1, 0.1, Infinity]) {
+    assert.throws(() => applyDiscountAndTax(invalid, 0, 0), ValidationError);
+  }
