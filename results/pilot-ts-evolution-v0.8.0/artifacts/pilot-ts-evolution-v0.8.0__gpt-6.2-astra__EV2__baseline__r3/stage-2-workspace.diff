+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  calculateBookingPrice,
+  isBookingActiveAt,
+  roundHalfUpDiv,
+  slotsOverlap,
+} from "../src/index.ts";
+
+const room = { roomId: "a", name: "A", hourlyRateCents: 3, taxBps: 2500 };
+const slot = { roomId: "a", customerId: "c", startMinute: 100, endMinute: 130 };
+
+function bookingService(): BookingService {
+  const service = new BookingService({ env: { BOOKING_MAX_HOLD_MINUTES: "5" } });
+  service.registerRoom(room);
+  return service;
+}
+
+test("half-up division rounds ties upward and rejects invalid operands", () => {
+  for (const [n, d, expected] of [[0, 7, 0], [14, 10, 1], [15, 10, 2], [16, 10, 2], [4, 3, 1]]) {
+    assert.equal(roundHalfUpDiv(n, d), expected);
+  }
+  for (const [n, d] of [[-1, 2], [1.5, 2], [1, 0], [1, -2], [1, 2.5], [NaN, 1], [1, Infinity]]) {
+    assert.throws(() => roundHalfUpDiv(n, d), ValidationError);
+  }
+});
+
+test("fractional hours round the subtotal before computing tax and legacy deposit", () => {
+  assert.deepEqual(calculateBookingPrice(room, 30, { legacyDepositMode: true }), {
+    subtotalCents: 2, taxCents: 1, totalCents: 3, depositCents: 1, discountCents: 0,
+  });
+  assert.equal(calculateBookingPrice(room, 1).subtotalCents, 0);
+  assert.equal(calculateBookingPrice(room, 89).subtotalCents, 4);
+  for (const duration of [0, -1, 0.5]) {
+    assert.throws(() => calculateBookingPrice(room, duration), ValidationError);
+  }
+});
+
+test("same-room conflicts include containment and one-minute overlaps, and allow adjacency", () => {
+  const service = bookingService();
+  service.createBooking(slot);
+  for (const [start, end] of [[99, 101], [129, 131], [100, 130], [110, 120], [90, 140]]) {
+    assert.equal(slotsOverlap(100, 130, start, end), true);
+    assert.throws(() => service.createBooking({ ...slot, startMinute: start, endMinute: end }), ConflictError);
+  }
+  for (const [start, end] of [[90, 100], [130, 140]]) {
+    assert.equal(slotsOverlap(100, 130, start, end), false);
+    service.createBooking({ ...slot, startMinute: start, endMinute: end });
+  }
+  service.registerRoom({ ...room, roomId: "b" });
+  service.createBooking({ ...slot, roomId: "b" });
+  assert.equal(service.listRoomBookings("a").length, 3);
+});
+
+test("a hold blocks the slot until its exact expiration minute", () => {
+  const service = bookingService();
+  const hold = service.createBooking({ ...slot, nowMinute: 10, holdMinutes: 5 });
+  assert.equal(hold.status, "held");
+  assert.equal(hold.expiresAt, 15);
+  assert.equal(isBookingActiveAt(hold, 14), true);
+  assert.equal(isBookingActiveAt(hold, 15), false);
+  assert.equal(isBookingActiveAt({ ...hold, expiresAt: undefined }, 14), false);
+  assert.equal(isBookingActiveAt({ ...hold, status: "cancelled" }, 14), false);
+  assert.throws(() => service.createBooking({ ...slot, nowMinute: 14 }), ConflictError);
+  assert.throws(() => service.confirmHold(hold.bookingId, 15), ValidationError);
+  assert.equal(service.createBooking({ ...slot, nowMinute: 15 }).status, "confirmed");
+});
+
+test("confirmation persists the booking and keeps the slot past the original expiry", () => {
+  const service = bookingService();
+  const hold = service.createBooking({ ...slot, holdMinutes: 5 });
+  assert.equal(hold.expiresAt, 5);
+  const confirmed = service.confirmHold(hold.bookingId, 4);
+  assert.equal(confirmed.status, "confirmed");
+  assert.equal(confirmed.expiresAt, undefined);
+  assert.deepEqual({ ...confirmed, status: "held", expiresAt: 5 }, hold);
+  assert.equal(service.getBooking(hold.bookingId), confirmed);
+  assert.throws(() => service.confirmHold(hold.bookingId, 4), ValidationError);
+  assert.throws(() => service.confirmHold("missing", 4), ValidationError);
+  assert.throws(() => service.createBooking({ ...slot, nowMinute: 5, holdMinutes: 1 }), ConflictError);
+});
+
+test("hold durations must be positive integers within the configured limit", () => {
+  const service = bookingService();
+  for (const holdMinutes of [0, -1, 1.5, 6]) {
+    assert.throws(() => service.createBooking({ ...slot, holdMinutes }), ValidationError);
+  }
+  assert.deepEqual(service.listRoomBookings("a"), []);
+});
