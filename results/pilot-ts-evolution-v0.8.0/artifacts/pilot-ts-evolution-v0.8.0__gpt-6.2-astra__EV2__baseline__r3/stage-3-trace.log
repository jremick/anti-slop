arlyFeeBps : cfg.lateFeeBps;\n}\n'\"''')\np=Path('src/pricing.ts')\np.write_text(p.read_text()+'''\nexport function computeCancellationRefund(totalCents: number, feeBps: number) {\n  validateNonNegativeInt(totalCents, \\\"totalCents\\\");\n  validateBasisPoints(feeBps, \\\"feeBps\\\");\n  const feeCents = roundHalfUpDiv(totalCents * feeBps, 10000);\n  return { feeCents, refundCents: totalCents - feeCents };\n}\n''')\np=Path('src/bookings.ts')\ns=p.read_text().replace('import { loadBookingConfig }','import { loadBookingConfig, loadCancellationFeeConfig, resolveBookingEnv, selectCancellationFeeBps }').replace('import { calculateBookingPrice,','import { calculateBookingPrice, computeCancellationRefund,').replace('  readonly config: BookingConfig;','  readonly config: BookingConfig;\\\\n  private readonly env: Record<string, string | undefined>;').replace('    this.config = loadBookingConfig(options.env);','    this.env = resolveBookingEnv(options.env);\\\\n    this.config = loadBookingConfig(this.env);')\np.write_text(s.replace('  confirmHold(','''  cancelBooking(bookingId: string, nowMinute: number) {\n    validateNonNegativeInt(nowMinute, \\\"nowMinute\\\");\n    const booking = this.getBooking(bookingId);\n    if (booking.status === \\\"cancelled\\\") {\n      throw new ValidationError(\"'`Booking ${bookingId} is already cancelled`);\n    }\n    if (nowMinute > booking.startMinute) {\n      throw new ValidationError(`Booking ${bookingId} has already started`);\n    }\n    const tiers = loadCancellationFeeConfig(this.env);\n    const feeBps = selectCancellationFeeBps(booking.startMinute - nowMinute, tiers);\n    const refund = computeCancellationRefund(booking.totalCents, feeBps);\n    const cancelled: Booking = { ...booking, status: \"cancelled\" };\n    this.bookings.set(bookingId, cancelled);\n    return { booking: cancelled, feeBps, ...refund };\n  }\n\n  confirmHold('\"'''))\np=Path('src/index.ts')\np.write_text(p.read_text().replace('  loadBookingConfig,','  lo