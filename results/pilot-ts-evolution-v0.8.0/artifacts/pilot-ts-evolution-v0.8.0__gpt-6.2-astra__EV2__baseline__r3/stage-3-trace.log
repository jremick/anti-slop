{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cat > benchmarks/sources/ev2_ts_bookings/tests/cancellation.test.ts <<'EOF'\nimport assert from \\\"node:assert/strict\\\";\nimport test from \\\"node:test\\\";\nimport {\n  BookingService,\n  ConfigError,\n  ConflictError,\n  ValidationError,\n  computeCancellationRefund,\n  loadCancellationFeeConfig,\n  selectCancellationFeeBps,\n} from \\\"../src/index.ts\\\";\n\nconst tiers = { cutoffMinutes: 30, earlyFeeBps: 1250, lateFeeBps: 5000 };\nconst slot = { roomId: \\\"a\\\", customerId: \\\"customer\\\", startMinute: 90, endMinute: 150 };\n\nfunction setup(env: Record<string, string | undefined>) {\n  const service = new BookingService({ env });\n  service.registerRoom({ roomId: \\\"a\\\", name: \\\"A\\\", hourlyRateCents: 100, taxBps: 100 });\n  return { service, booking: service.createBooking(slot) };\n}\n\ntest(\\\"early and late fees use the taxed total, including at cutoff and start\\\", () => {\n  for (const [nowMinute, feeBps, feeCents] of [\n    [59, 1250, 13], [60, 1250, 13], [61, 5000, 51], [90, 5000, 51],\n  ]) {\n    const { service, booking } = setup({ BOOKING_CANCEL_FEE_TIERS_JSON: JSON.stringify(tiers) });\n    const result = service.cancelBooking(booking.bookingId, nowMinute);\n    assert.deepEqual(result, {\n      booking: { ...booking, status: \\\"cancelled\\\" }, feeBps, feeCents, refundCents: 101 - feeCents,\n    });\n    assert.deepEqual(service.getBooking(booking.bookingId), result.booking);\n    assert.throws(() => service.cancelBooking(booking.bookingId, nowMinute), ValidationError);\n    assert.equal(service.createBooking({ ...slot, nowMinute }).status, \\\"confirmed\\\");\n  }\n});\n\ntest(\\\"missing or malformed configuration preserves the booking and blocks slot reuse\\\", () => {\n  const env: Record<string, string | undefined> = {};\n  const { service, booking } = setup(env);\n  for (const raw of [\n    undefined, \\\"\\\", \\\"  \\\", \\\"{\\\", \\\"null\\\", \\\"[]\\\", \\\"false\\\", \\\"0\\\", \\\"{}\\\",\n    JSON.stringify({ cutoffMinutes: 30, earlyFeeBps: 0 }),\n    ...[\n      { cutoffMinutes: -1 }, { cutoffMinutes: 1.5 }, { cutoffMinutes: null },\n      { earlyFeeBps: -1 }, { earlyFeeBps: 10001 }, { earlyFeeBps: 1.5 },\n      { lateFeeBps: -1 }, { lateFeeBps: 10001 }, { lateFeeBps: \\\"500\\\" },\n    ].map(override => JSON.stringify({ ...tiers, ...override })),\n  ]) {\n    env.BOOKING_CANCEL_FEE_TIERS_JSON = raw;\n    assert.throws(() => service.cancelBooking(booking.bookingId, 60), ConfigError);\n    assert.equal(service.getBooking(booking.bookingId).status, \\\"confirmed\\\");\n    assert.throws(() => service.createBooking(slot), ConflictError);\n  }\n  env.BOOKING_CANCEL_FEE_TIERS_JSON = JSON.stringify(tiers);\n  assert.equal(service.cancelBooking(booking.bookingId, 60).feeCents, 13);\n});\n\ntest(\\\"unknown bookings and past-start cancellations raise ValidationError\\\", () => {\n  const { service, booking } = setup({});\n  assert.throws(() => service.cancelBooking(\\\"missing\\\", 90), ValidationError);\n  assert.throws(() => service.cancelBooking(booking.bookingId, 91), ValidationError);\n  assert.equal(service.getBooking(booking.bookingId).status, \\\"confirmed\\\");\n});\n\ntest(\\\"zero-minute cutoff and fee endpoints are valid, and invalid refund operands are rejected\\\", () => {\n  const cfg = loadCancellationFeeConfig({\n    BOOKING_CANCEL_FEE_TIERS_JSON: '{\\\"cutoffMinutes\\\":0,\\\"earlyFeeBps\\\":0,\\\"lateFeeBps\\\":10000}',\n  });\n  assert.equal(selectCancellationFeeBps(0, cfg), 0);\n  assert.deepEqual(computeCancellationRefund(7, cfg.earlyFeeBps), { feeCents: 0, refundCents: 7 });\n  assert.deepEqual(computeCancellationRefund(7, cfg.lateFeeBps), { feeCents: 7, refundCents: 0 });\n  for (const [total, rate] of [[-1, 0], [1.5, 0], [7, -1], [7, 0.5], [7, 10001]]) {\n    assert.throws(() => computeCancellationRefund(total, rate), ValidationError);\n  }\n});\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
