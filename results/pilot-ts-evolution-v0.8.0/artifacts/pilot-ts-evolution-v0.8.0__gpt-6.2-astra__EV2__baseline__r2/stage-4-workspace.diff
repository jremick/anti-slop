+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  BookingService, ConfigError, ConflictError, ValidationError, computeCancellationRefund,
+  loadCancellationFeeConfig, selectCancellationFeeBps,
+} from "../src/index.ts";
+
+const tiers = { cutoffMinutes: 30, earlyFeeBps: 1000, lateFeeBps: 5000 };
+const slot = { roomId: "a", customerId: "customer", startMinute: 60, endMinute: 120 };
+
+function setup(env: Record<string, string | undefined>) {
+  const service = new BookingService({ env });
+  service.registerRoom({ roomId: "a", name: "Room A", hourlyRateCents: 100, taxBps: 500 });
+  return service;
+}
+
+test("cancellation applies the tier at the cutoff and rounds the fee on the tax-inclusive total", () => {
+  for (const [nowMinute, feeBps, feeCents] of [[29, 1000, 11], [30, 1000, 11], [31, 5000, 53], [60, 5000, 53]]) {
+    const service = setup({ BOOKING_CANCEL_FEE_TIERS_JSON: JSON.stringify(tiers) });
+    const original = service.createBooking(slot);
+    const result = service.cancelBooking(original.bookingId, nowMinute);
+    assert.deepEqual(result, {
+      booking: { ...original, status: "cancelled" }, feeBps, feeCents, refundCents: 105 - feeCents,
+    });
+    assert.deepEqual(service.getBooking(original.bookingId), result.booking);
+    assert.throws(() => service.cancelBooking(original.bookingId, nowMinute), ValidationError);
+    assert.equal(service.createBooking({ ...slot, nowMinute }).status, "confirmed");
+  }
+});
+
+test("missing or malformed fee tiers preserve the reservation until configuration is repaired", () => {
+  const env: Record<string, string | undefined> = {};
+  const service = setup(env);
+  const original = service.createBooking(slot);
+  const invalid = [
+    undefined, "", " ", "{", "null", "false", "1", "[]", "{}",
+    ...[
+      { cutoffMinutes: -1 }, { cutoffMinutes: 0.5 }, { cutoffMinutes: "30" },
+      { earlyFeeBps: -1 }, { earlyFeeBps: 10001 }, { earlyFeeBps: undefined },
+      { lateFeeBps: 0.5 }, { lateFeeBps: 10001 }, { lateFeeBps: "0" },
+    ].map(fields => JSON.stringify({ ...tiers, ...fields })),
+  ];
+  for (const raw of invalid) {
+    env.BOOKING_CANCEL_FEE_TIERS_JSON = raw;
+    assert.throws(() => service.cancelBooking(original.bookingId, 30), ConfigError);
+    assert.deepEqual(service.getBooking(original.bookingId), original);
+    assert.throws(() => service.createBooking(slot), ConflictError);
+  }
+  env.BOOKING_CANCEL_FEE_TIERS_JSON = JSON.stringify(tiers);
+  assert.equal(service.cancelBooking(original.bookingId, 30).refundCents, 94);
+});
+
+test("unknown bookings and cancellations after the start fail validation before fee lookup", () => {
+  const service = setup({});
+  const booking = service.createBooking(slot);
+  assert.throws(() => service.cancelBooking("missing", 0), ValidationError);
+  assert.throws(() => service.cancelBooking(booking.bookingId, 61), ValidationError);
+  assert.equal(service.getBooking(booking.bookingId).status, "confirmed");
+});
+
+test("zero cutoff, zero fee, and full fee are valid and refund inputs are checked", () => {
+  const cfg = loadCancellationFeeConfig({
+    BOOKING_CANCEL_FEE_TIERS_JSON: '{"cutoffMinutes":0,"earlyFeeBps":0,"lateFeeBps":10000}',
+  });
+  assert.equal(selectCancellationFeeBps(0, cfg), 0);
+  assert.deepEqual(computeCancellationRefund(31, 0), { feeCents: 0, refundCents: 31 });
+  assert.deepEqual(computeCancellationRefund(31, 10000), { feeCents: 31, refundCents: 0 });
+  for (const [total, rate] of [[-1, 0], [1.5, 0], [0, -1], [0, 0.5], [0, 10001]]) {
+    assert.throws(() => computeCancellationRefund(total, rate), ValidationError);
+  }
+});

