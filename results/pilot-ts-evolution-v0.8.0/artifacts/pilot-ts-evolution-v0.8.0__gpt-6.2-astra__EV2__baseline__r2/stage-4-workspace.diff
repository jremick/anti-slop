+import assert from "node:assert/strict";
+import test from "node:test";
+import * as api from "../src/index.ts";
+import * as pricing from "../src/pricing.ts";
+import type { BookingNotification } from "../src/index.ts";
+
+const slot = { customerId: " customer ", startMinute: 60, endMinute: 120 };
+const group = { ...slot, roomIds: ["a", "b"], discountBps: 5000 };
+const failure = new Error("notification delivery failed");
+
+function setup(notifyHook: (event: BookingNotification) => void) {
+  const service = new api.BookingService({
+    env: { BOOKING_CANCEL_FEE_TIERS_JSON: '{"cutoffMinutes":0,"earlyFeeBps":5000,"lateFeeBps":0}' },
+    notifyHook,
+  });
+  service.registerRoom({ roomId: "a", name: "A", hourlyRateCents: 100, taxBps: 500 });
+  service.registerRoom({ roomId: "b", name: "B", hourlyRateCents: 300, taxBps: 0 });
+  return service;
+}
+
+test("pricing and package exports contain no deposit API", () => {
+  for (const module of [api, pricing]) {
+    assert.deepEqual(Object.keys(module).filter(name => /deposit/i.test(name)), []);
+  }
+});
+
+test("notifications carry the charged total for each booking and the refund on cancellation", () => {
+  const events: BookingNotification[] = [];
+  const service = setup(event => events.push(event));
+  const held = service.createBooking({ ...slot, roomId: "a", holdMinutes: 5 });
+  service.confirmHold(held.bookingId, 0);
+  service.cancelBooking(held.bookingId, 0);
+  const { bookings: [a, b] } = api.createGroupBooking(service, group);
+  assert.deepEqual(events, [
+    { event: "booking_created", bookingId: held.bookingId, roomId: "a", customerId: "customer", amountCents: 105 },
+    { event: "booking_cancelled", bookingId: held.bookingId, roomId: "a", customerId: "customer", amountCents: 52 },
+    { event: "booking_created", bookingId: a.bookingId, roomId: "a", customerId: "customer", amountCents: 53 },
+    { event: "booking_created", bookingId: b.bookingId, roomId: "b", customerId: "customer", amountCents: 150 },
+  ]);
+});
+
+test("a failed creation hook leaves the slot available for retry", () => {
+  let fail = true;
+  const service = setup(() => { if (fail) throw failure; });
+  const input = { ...slot, roomId: "a" };
+  assert.throws(() => service.createBooking(input), error => error === failure);
+  assert.deepEqual(service.listRoomBookings("a"), []);
+  fail = false;
+  assert.equal(service.createBooking(input).status, "confirmed");
+});
+
+test("a failure on the second group notification leaves neither member stored", () => {
+  const seen: BookingNotification[] = [];
+  const service = setup(event => {
+    seen.push(event);
+    if (seen.length === 2) throw failure;
+  });
+  assert.throws(() => api.createGroupBooking(service, group), error => error === failure);
+  assert.deepEqual(seen.map(e => e.roomId), ["a", "b"]);
+  for (const event of seen) {
+    assert.deepEqual(service.listRoomBookings(event.roomId), []);
+    assert.throws(() => service.getBooking(event.bookingId), api.ValidationError);
+  }
+  assert.equal(api.createGroupBooking(service, group).bookings.length, 2);
+});
+
+test("a failed cancellation hook preserves the original booking and its reservation", () => {
+  let fail = true;
+  const service = setup(event => {
+    if (event.event === "booking_cancelled" && fail) throw failure;
+  });
+  const input = { ...slot, roomId: "a" };
+  const original = service.createBooking(input);
+  assert.throws(() => service.cancelBooking(original.bookingId, 0), error => error === failure);
+  assert.equal(service.getBooking(original.bookingId), original);
+  assert.throws(() => service.createBooking(input), api.ConflictError);
+  fail = false;
+  assert.equal(service.cancelBooking(original.bookingId, 0).booking.status, "cancelled");
+  assert.equal(service.createBooking(input).status, "confirmed");
+});

