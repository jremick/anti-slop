+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  BookingService, ConflictError, ValidationError, calculateBookingPrice,
+  isBookingActiveAt, roundHalfUpDiv, slotsOverlap,
+} from "../src/index.ts";
+
+const room = { roomId: "A", name: "Room A", hourlyRateCents: 30, taxBps: 5000 };
+const slot = { roomId: "A", customerId: "customer", startMinute: 30, endMinute: 60 };
+
+function setup() {
+  const service = new BookingService({ env: { BOOKING_MAX_HOLD_MINUTES: "5" } });
+  service.registerRoom(room);
+  return service;
+}
+
+test("division rounds below, at, and above half and validates both operands", () => {
+  for (const [n, expected] of [[0, 0], [89, 1], [90, 2], [91, 2]]) {
+    assert.equal(roundHalfUpDiv(n, 60), expected);
+  }
+  for (const [n, d] of [[-1, 1], [1.5, 2], [1, 0], [1, -2], [1, 1.5], [Infinity, 1], [1, NaN]]) {
+    assert.throws(() => roundHalfUpDiv(n, d), ValidationError);
+  }
+});
+
+test("minute pricing applies tax to the rounded subtotal", () => {
+  assert.deepEqual(calculateBookingPrice(room, 1), {
+    subtotalCents: 1, discountCents: 0, taxCents: 1, totalCents: 2,
+  });
+  const price = calculateBookingPrice(room, 67);
+  assert.deepEqual(price, {
+    subtotalCents: 34, discountCents: 0, taxCents: 17, totalCents: 51,
+  });
+  for (const duration of [0, -1, 1.5]) {
+    assert.throws(() => calculateBookingPrice(room, duration), ValidationError);
+  }
+});
+
+test("same-room conflicts include partial overlaps, containment, and identical slots", () => {
+  const service = setup();
+  service.createBooking(slot);
+  for (const [startMinute, endMinute] of [[29, 31], [59, 61], [20, 70], [31, 59], [30, 60]]) {
+    assert.equal(slotsOverlap(30, 60, startMinute, endMinute), true);
+    assert.throws(() => service.createBooking({ ...slot, startMinute, endMinute }), ConflictError);
+  }
+  for (const [startMinute, endMinute] of [[0, 30], [60, 61]]) {
+    assert.equal(slotsOverlap(30, 60, startMinute, endMinute), false);
+    service.createBooking({ ...slot, startMinute, endMinute });
+  }
+  service.registerRoom({ ...room, roomId: "B" });
+  service.createBooking({ ...slot, roomId: "B" });
+  assert.equal(service.listRoomBookings("A").length, 3);
+});
+
+test("a hold blocks the room until its exact expiry minute", () => {
+  const service = setup();
+  const held = service.createBooking({ ...slot, holdMinutes: 5, nowMinute: 10 });
+  assert.equal(held.status, "held");
+  assert.equal(held.expiresAt, 15);
+  assert.equal(isBookingActiveAt(held, 14), true);
+  assert.equal(isBookingActiveAt(held, 15), false);
+  assert.equal(isBookingActiveAt({ ...held, status: "cancelled" }, 14), false);
+  assert.equal(isBookingActiveAt({ ...held, expiresAt: undefined }, 14), false);
+  assert.throws(() => service.createBooking({ ...slot, nowMinute: 14 }), ConflictError);
+  assert.throws(() => service.confirmHold(held.bookingId, 15), ValidationError);
+  service.createBooking({ ...slot, nowMinute: 15 });
+  assert.throws(() => service.confirmHold(held.bookingId, 16), ValidationError);
+});
+
+test("confirmation persists the booking and keeps the room reserved past the hold deadline", () => {
+  const service = setup();
+  const held = service.createBooking({ ...slot, holdMinutes: 5 });
+  assert.equal(held.expiresAt, 5);
+  const confirmed = service.confirmHold(held.bookingId, 4);
+  assert.equal(confirmed.expiresAt, undefined);
+  assert.equal(confirmed.status, "confirmed");
+  assert.equal(service.getBooking(held.bookingId), confirmed);
+  assert.equal(isBookingActiveAt(confirmed, 6), true);
+  assert.throws(() => service.createBooking({ ...slot, holdMinutes: 1, nowMinute: 6 }), ConflictError);
+  assert.throws(() => service.confirmHold(held.bookingId, 4), ValidationError);
+  assert.throws(() => service.confirmHold("missing", 4), ValidationError);
+});
+
+test("invalid hold lengths and clock minutes leave the room available", () => {
+  const service = setup();
+  for (const holdMinutes of [0, -1, 1.5, 6]) {
+    assert.throws(() => service.createBooking({ ...slot, holdMinutes }), ValidationError);
+  }
+  for (const nowMinute of [-1, 0.5]) {
+    assert.throws(() => service.createBooking({ ...slot, nowMinute }), ValidationError);
+  }
+  assert.equal(service.listRoomBookings(room.roomId).length, 0);
+});
