{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cd benchmarks/sources/ev2_ts_bookings && cat > tests/notifications.test.ts <<'EOF'\nimport assert from \\\"node:assert/strict\\\";\nimport test from \\\"node:test\\\";\nimport * as api from \\\"../src/index.ts\\\";\nimport * as pricing from \\\"../src/pricing.ts\\\";\nimport type { BookingNotification } from \\\"../src/index.ts\\\";\n\nconst slot = { customerId: \\\" customer \\\", startMinute: 60, endMinute: 120 };\nconst group = { ...slot, roomIds: [\\\"a\\\", \\\"b\\\"], discountBps: 5000 };\nconst failure = new Error(\\\"notification delivery failed\\\");\n\nfunction setup(notifyHook: (event: BookingNotification) => void) {\n  const service = new api.BookingService({\n    env: { BOOKING_CANCEL_FEE_TIERS_JSON: '{\\\"cutoffMinutes\\\":0,\\\"earlyFeeBps\\\":5000,\\\"lateFeeBps\\\":0}' },\n    notifyHook,\n  });\n  service.registerRoom({ roomId: \\\"a\\\", name: \\\"A\\\", hourlyRateCents: 100, taxBps: 500 });\n  service.registerRoom({ roomId: \\\"b\\\", name: \\\"B\\\", hourlyRateCents: 300, taxBps: 0 });\n  return service;\n}\n\ntest(\\\"pricing and package exports contain no deposit API\\\", () => {\n  for (const module of [api, pricing]) {\n    assert.deepEqual(Object.keys(module).filter(name => /deposit/i.test(name)), []);\n  }\n});\n\ntest(\\\"notifications carry the charged total for each booking and the refund on cancellation\\\", () => {\n  const events: BookingNotification[] = [];\n  const service = setup(event => events.push(event));\n  const held = service.createBooking({ ...slot, roomId: \\\"a\\\", holdMinutes: 5 });\n  service.confirmHold(held.bookingId, 0);\n  service.cancelBooking(held.bookingId, 0);\n  const { bookings: [a, b] } = api.createGroupBooking(service, group);\n  assert.deepEqual(events, [\n    { event: \\\"booking_created\\\", bookingId: held.bookingId, roomId: \\\"a\\\", customerId: \\\"customer\\\", amountCents: 105 },\n    { event: \\\"booking_cancelled\\\", bookingId: held.bookingId, roomId: \\\"a\\\", customerId: \\\"customer\\\", amountCents: 52 },\n    { event: \\\"booking_created\\\", bookingId: a.bookingId, roomId: \\\"a\\\", customerId: \\\"customer\\\", amountCents: 53 },\n    { event: \\\"booking_created\\\", bookingId: b.bookingId, roomId: \\\"b\\\", customerId: \\\"customer\\\", amountCents: 150 },\n  ]);\n});\n\ntest(\\\"a failed creation hook leaves the slot available for retry\\\", () => {\n  let fail = true;\n  const service = setup(() => { if (fail) throw failure; });\n  const input = { ...slot, roomId: \\\"a\\\" };\n  assert.throws(() => service.createBooking(input), error => error === failure);\n  assert.deepEqual(service.listRoomBookings(\\\"a\\\"), []);\n  fail = false;\n  assert.equal(service.createBooking(input).status, \\\"confirmed\\\");\n});\n\ntest(\\\"a failure on the second group notification leaves neither member stored\\\", () => {\n  const seen: BookingNotification[] = [];\n  const service = setup(event => {\n    seen.push(event);\n    if (seen.length === 2) throw failure;\n  });\n  assert.throws(() => api.createGroupBooking(service, group), error => error === failure);\n  assert.deepEqual(seen.map(e => e.roomId), [\\\"a\\\", \\\"b\\\"]);\n  for (const event of seen) {\n    assert.deepEqual(service.listRoomBookings(event.roomId), []);\n    assert.throws(() => service.getBooking(event.bookingId), api.ValidationError);\n  }\n  assert.equal(api.createGroupBooking(service, group).bookings.length, 2);\n});\n\ntest(\\\"a failed cancellation hook preserves the original booking and its reservation\\\", () => {\n  let fail = true;\n  const service = setup(event => {\n    if (event.event === \\\"booking_cancelled\\\" && fail) throw failure;\n  });\n  const input = { ...slot, roomId: \\\"a\\\" };\n  const original = service.createBooking(input);\n  assert.throws(() => service.cancelBooking(original.bookingId, 0), error => error === failure);\n  assert.equal(service.getBooking(original.bookingId), original);\n  assert.throws(() => service.createBooking(input), api.ConflictError);\n  fail = false;\n  assert.equal(service.cancelBooking(original.bookingId, 0).booking.status, \\\"cancelled\\\");\n  assert.equal(service.createBooking(input).status, \\\"confirmed\\\");\n});\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
