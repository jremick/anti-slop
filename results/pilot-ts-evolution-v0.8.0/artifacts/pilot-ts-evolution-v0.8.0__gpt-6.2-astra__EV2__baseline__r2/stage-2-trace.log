{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cat > benchmarks/sources/ev2_ts_bookings/tests/corporate.test.ts <<'EOF'\nimport assert from \\\"node:assert/strict\\\";\nimport test from \\\"node:test\\\";\nimport {\n  BookingService, ConflictError, ValidationError, applyDiscountAndTax, createGroupBooking,\n} from \\\"../src/index.ts\\\";\n\nconst input = {\n  customerId: \\\" customer \\\", roomIds: [\\\"a\\\", \\\"b\\\"], startMinute: 60, endMinute: 90, discountBps: 5000,\n};\n\nfunction setup() {\n  const service = new BookingService({ env: {} });\n  service.registerRoom({ roomId: \\\"a\\\", name: \\\"A\\\", hourlyRateCents: 201, taxBps: 5000 });\n  service.registerRoom({ roomId: \\\"b\\\", name: \\\"B\\\", hourlyRateCents: 209, taxBps: 1250 });\n  return service;\n}\n\ntest(\\\"group totals sum the individually rounded room discounts and taxes\\\", () => {\n  const service = setup();\n  const { groupId, bookings, ...totals } = createGroupBooking(service, input);\n  assert.deepEqual(totals, { subtotalCents: 102, discountCents: 104, taxCents: 32, totalCents: 134 });\n  assert.deepEqual(bookings.map(b => [b.roomId, b.subtotalCents, b.discountCents, b.taxCents, b.totalCents]), [\n    [\\\"a\\\", 50, 51, 25, 75],\n    [\\\"b\\\", 52, 53, 7, 59],\n  ]);\n  for (const booking of bookings) {\n    assert.equal(booking.status, \\\"confirmed\\\");\n    assert.equal(booking.customerId, \\\"customer\\\");\n    assert.equal(booking.groupId, groupId);\n    assert.deepEqual(service.getBooking(booking.bookingId), booking);\n  }\n  const adjacent = createGroupBooking(service, { ...input, startMinute: 90, endMinute: 120 });\n  assert.notEqual(adjacent.groupId, groupId);\n});\n\ntest(\\\"a conflict in the last room leaves all rooms untouched until the hold expires\\\", () => {\n  const service = setup();\n  const held = service.createBooking({\n    roomId: \\\"b\\\", customerId: \\\"other\\\", startMinute: 89, endMinute: 100, holdMinutes: 5,\n  });\n  assert.throws(() => createGroupBooking(service, { ...input, nowMinute: 4 }), ConflictError);\n  assert.deepEqual(service.listRoomBookings(\\\"a\\\"), []);\n  assert.deepEqual(service.listRoomBookings(\\\"b\\\"), [held]);\n  const group = createGroupBooking(service, { ...input, nowMinute: 5 });\n  assert.equal(group.bookings.length, 2);\n  assert.throws(() => createGroupBooking(service, { ...input, nowMinute: 6 }), ConflictError);\n});\n\ntest(\\\"invalid group requests fail without reserving any rooms\\\", () => {\n  const service = setup();\n  for (const changes of [\n    { roomIds: [] }, { roomIds: [\\\"a\\\"] }, { roomIds: [\\\"a\\\", \\\"b\\\", \\\"a\\\"] },\n    { roomIds: [\\\"a\\\", \\\"missing\\\"] }, { discountBps: -1 }, { discountBps: 10001 },\n    { discountBps: 1.5 }, { customerId: \\\"  \\\" }, { endMinute: 60 }, { nowMinute: -1 },\n  ]) {\n    assert.throws(() => createGroupBooking(service, { ...input, ...changes }), ValidationError);\n    assert.deepEqual(service.listRoomBookings(\\\"a\\\"), []);\n    assert.deepEqual(service.listRoomBookings(\\\"b\\\"), []);\n  }\n});\n\ntest(\\\"discount and tax accept both rate bounds and reject invalid cents or rates\\\", () => {\n  assert.deepEqual(applyDiscountAndTax(11, 0, 10000), {\n    subtotalCents: 11, discountCents: 0, taxCents: 11, totalCents: 22,\n  });\n  assert.deepEqual(applyDiscountAndTax(11, 10000, 0), {\n    subtotalCents: 0, discountCents: 11, taxCents: 0, totalCents: 0,\n  });\n  for (const invalid of [-1, 0.5, 10001, NaN]) {\n    assert.throws(() => applyDiscountAndTax(11, invalid, 0), ValidationError);\n    assert.throws(() => applyDiscountAndTax(11, 0, invalid), ValidationError);\n  }\n  for (const invalid of [-1, 0.5]) {\n    assert.throws(() => applyDiscountAndTax(invalid, 0, 0), ValidationError);\n  }\n});\nEOF\nnode benchmarks/sources/ev2_ts_bookings/run_checks.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
