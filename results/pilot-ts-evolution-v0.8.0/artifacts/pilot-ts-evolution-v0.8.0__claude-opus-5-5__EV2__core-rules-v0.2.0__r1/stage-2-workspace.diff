+} from "../src/index.ts";
+import type { Booking, Room } from "../src/index.ts";
+
+const ROOM: Room = { roomId: "r1", name: "Room 1", hourlyRateCents: 10000, taxBps: 825 };
+
+function makeService(env: Record<string, string | undefined> = {}): BookingService {
+  const svc = new BookingService({ env });
+  svc.registerRoom(ROOM);
+  svc.registerRoom({ roomId: "r2", name: "Room 2", hourlyRateCents: 6000, taxBps: 0 });
+  return svc;
+}
+
+function baseBooking(overrides: Partial<Booking>): Booking {
+  return {
+    bookingId: "b",
+    roomId: "r1",
+    customerId: "c",
+    startMinute: 0,
+    endMinute: 60,
+    status: "confirmed",
+    subtotalCents: 0,
+    discountCents: 0,
+    taxCents: 0,
+    totalCents: 0,
+    ...overrides,
+  };
+}
+
+// --- roundHalfUpDiv ---------------------------------------------------------
+
+test("roundHalfUpDiv rounds exact halves up and other fractions to nearest", () => {
+  assert.equal(roundHalfUpDiv(0, 7), 0);
+  assert.equal(roundHalfUpDiv(1, 2), 1); // 0.5 -> 1
+  assert.equal(roundHalfUpDiv(3, 2), 2); // 1.5 -> 2
+  assert.equal(roundHalfUpDiv(149, 100), 1);
+  assert.equal(roundHalfUpDiv(150, 100), 2);
+  assert.equal(roundHalfUpDiv(4, 3), 1); // 1.333 -> 1
+  assert.equal(roundHalfUpDiv(5, 3), 2); // 1.667 -> 2
+  assert.equal(roundHalfUpDiv(120, 60), 2);
+  assert.equal(roundHalfUpDiv(29, 60), 0);
+  assert.equal(roundHalfUpDiv(30, 60), 1);
+});
+
+test("roundHalfUpDiv rejects non-integers, negative numerators and non-positive denominators", () => {
+  for (const [n, d] of [
+    [1.5, 2],
+    [1, 2.5],
+    [Number.NaN, 2],
+    [1, Number.POSITIVE_INFINITY],
+    [-1, 2],
+    [1, 0],
+    [1, -3],
+  ] as const) {
+    assert.throws(() => roundHalfUpDiv(n, d), ValidationError, `(${n}, ${d})`);
+  }
+});
+
+// --- calculateBookingPrice --------------------------------------------------
+
+test("calculateBookingPrice supports partial-hour durations with half-up cents", () => {
+  const p90 = calculateBookingPrice(ROOM, 90);
+  assert.equal(p90.subtotalCents, 15000);
+  assert.equal(p90.taxCents, 1238); // 15000 * 8.25% = 1237.5 -> 1238
+  assert.equal(p90.totalCents, 16238);
+
+  const odd: Room = { roomId: "x", name: "X", hourlyRateCents: 1999, taxBps: 825 };
+  const p45 = calculateBookingPrice(odd, 45); // 1499.25 -> 1499
+  assert.equal(p45.subtotalCents, 1499);
+  assert.equal(p45.taxCents, 124); // 123.6675 -> 124
+  assert.equal(p45.totalCents, 1623);
+  assert.equal(calculateBookingPrice(odd, 50).subtotalCents, 1666); // 1665.83 -> 1666
+
+  const penny: Room = { roomId: "p", name: "P", hourlyRateCents: 1, taxBps: 0 };
+  assert.equal(calculateBookingPrice(penny, 30).subtotalCents, 1); // exactly 0.5 -> 1
+  assert.equal(calculateBookingPrice(penny, 29).subtotalCents, 0);
+  assert.equal(calculateBookingPrice(penny, 1).subtotalCents, 0);
+});
+
+test("calculateBookingPrice keeps whole-hour results and legacy deposit", () => {
+  const p = calculateBookingPrice(ROOM, 120, { legacyDepositMode: true });
+  assert.deepEqual(p, {
+    subtotalCents: 20000,
+    discountCents: 0,
+    taxCents: 1650,
+    totalCents: 21650,
+    depositCents: 5000,
+  });
+});
+
+test("calculateBookingPrice rejects non-positive or non-integer durations", () => {
+  for (const d of [0, -60, 1.5, Number.NaN]) {
+    assert.throws(() => calculateBookingPrice(ROOM, d), ValidationError, String(d));
+  }
+});
+
+// --- slotsOverlap / isBookingActiveAt --------------------------------------
+
+test("slotsOverlap uses half-open intervals", () => {
+  assert.equal(slotsOverlap(0, 60, 60, 120), false); // back-to-back
+  assert.equal(slotsOverlap(60, 120, 0, 60), false);
+  assert.equal(slotsOverlap(0, 60, 59, 120), true);
+  assert.equal(slotsOverlap(30, 90, 0, 60), true);
+  assert.equal(slotsOverlap(0, 120, 30, 60), true); // containment
+  assert.equal(slotsOverlap(30, 60, 0, 120), true);
+  assert.equal(slotsOverlap(0, 60, 0, 60), true);
+  assert.equal(slotsOverlap(0, 30, 90, 120), false);
+});
+
+test("isBookingActiveAt treats confirmed as active and holds as active until expiresAt", () => {
+  assert.equal(isBookingActiveAt(baseBooking({ status: "confirmed" }), 10_000), true);
+  const held = baseBooking({ status: "held", expiresAt: 15 });
+  assert.equal(isBookingActiveAt(held, 0), true);
+  assert.equal(isBookingActiveAt(held, 14), true);
+  assert.equal(isBookingActiveAt(held, 15), false); // expires exactly at expiresAt
+  assert.equal(isBookingActiveAt(held, 16), false);
+  assert.equal(isBookingActiveAt(baseBooking({ status: "held" }), 0), false);
+  assert.equal(isBookingActiveAt(baseBooking({ status: "cancelled" }), 0), false);
+});
+
+// --- createBooking: conflicts ----------------------------------------------
+
+test("createBooking throws ConflictError for overlapping slots on the same room", () => {
+  const svc = makeService();
+  svc.createBooking({ roomId: "r1", customerId: "a", startMinute: 60, endMinute: 120 });
+  for (const [s, e] of [[90, 150], [0, 61], [60, 120], [30, 180], [70, 80]]) {
+    assertThrowsConflict(() =>
+      svc.createBooking({ roomId: "r1", customerId: "b", startMinute: s, endMinute: e })
+    );
+  }
+  assert.equal(svc.listRoomBookings("r1").length, 1);
+});
+
+function assertThrowsConflict(fn: () => unknown): void {
+  assert.throws(fn, (err: unknown) => err instanceof ConflictError && !(err instanceof ValidationError));
+}
+
+test("back-to-back bookings and other rooms do not conflict", () => {
+  const svc = makeService();
+  svc.createBooking({ roomId: "r1", customerId: "a", startMinute: 60, endMinute: 120 });
+  svc.createBooking({ roomId: "r1", customerId: "b", startMinute: 120, endMinute: 180 });
+  svc.createBooking({ roomId: "r1", customerId: "c", startMinute: 0, endMinute: 60 });
+  svc.createBooking({ roomId: "r2", customerId: "d", startMinute: 60, endMinute: 120 });
+  assert.equal(svc.listRoomBookings("r1").length, 3);
+  assert.equal(svc.listRoomBookings("r2").length, 1);
+});
