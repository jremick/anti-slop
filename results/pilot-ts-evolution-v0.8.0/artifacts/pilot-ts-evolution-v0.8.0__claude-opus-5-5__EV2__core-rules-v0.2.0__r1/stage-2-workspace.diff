+test("createBooking with holdMinutes creates a held booking with expiresAt", () => {
+  const svc = makeService();
+  const held = svc.createBooking({
+    roomId: "r1", customerId: "a", startMinute: 600, endMinute: 660, nowMinute: 100, holdMinutes: 15,
