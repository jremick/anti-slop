+/**
+ * Exact integer division rounded half-up: round(numerator / denominator).
+ * Requires a non-negative integer numerator and a positive integer denominator.
+ */
+export function roundHalfUpDiv(numerator: number, denominator: number): number {
+  if (!Number.isInteger(numerator) || !Number.isInteger(denominator)) {
+    throw new ValidationError("roundHalfUpDiv requires integer arguments");
+  }
+  if (numerator < 0) {
+    throw new ValidationError("roundHalfUpDiv numerator must be non-negative");
+  }
+  if (denominator <= 0) {
+    throw new ValidationError("roundHalfUpDiv denominator must be positive");
+  }
+  const scaled = numerator * 2 + denominator;
+  if (!Number.isSafeInteger(scaled) || !Number.isSafeInteger(2 * denominator)) {
+    throw new ValidationError("roundHalfUpDiv arguments exceed safe integer range");
+  }
+  return Math.floor(scaled / (2 * denominator));
+}
