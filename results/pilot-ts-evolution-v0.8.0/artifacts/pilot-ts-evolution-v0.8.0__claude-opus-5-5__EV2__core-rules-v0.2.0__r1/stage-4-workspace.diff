+import test from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync, readdirSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  applyDiscountAndTax,
+  calculateBookingPrice,
+  createGroupBooking,
+} from "../src/index.ts";
+
+function makeService(): BookingService {
+  const svc = new BookingService({ env: {} });
+  svc.registerRoom({ roomId: "a", name: "A", hourlyRateCents: 10000, taxBps: 825 });
+  svc.registerRoom({ roomId: "b", name: "B", hourlyRateCents: 4999, taxBps: 0 });
+  svc.registerRoom({ roomId: "c", name: "C", hourlyRateCents: 1999, taxBps: 1000 });
+  return svc;
+}
+
+function totalBookings(svc: BookingService): number {
+  return ["a", "b", "c"].reduce((n, id) => n + svc.listRoomBookings(id).length, 0);
+}
+
+function assertConflict(fn: () => unknown): void {
+  assert.throws(fn, (err: unknown) => err instanceof ConflictError && !(err instanceof ValidationError));
+}
+
+// --- applyDiscountAndTax ---------------------------------------------------
+
+test("applyDiscountAndTax discounts then taxes the discounted subtotal with half-up rounding", () => {
+  assert.deepEqual(applyDiscountAndTax(1000, 1234, 825), {
+    subtotalCents: 877, // discount 123.4 -> 123
+    discountCents: 123,
+    taxCents: 72, // 877 * 8.25% = 72.3525 -> 72
+    totalCents: 949,
+  });
+  assert.deepEqual(applyDiscountAndTax(10, 500, 0), {
+    subtotalCents: 9, // discount exactly 0.5 -> 1
+    discountCents: 1,
+    taxCents: 0,
+    totalCents: 9,
+  });
+  assert.deepEqual(applyDiscountAndTax(12345, 0, 0), {
+    subtotalCents: 12345, discountCents: 0, taxCents: 0, totalCents: 12345,
+  });
+  assert.deepEqual(applyDiscountAndTax(12345, 10000, 825), {
+    subtotalCents: 0, discountCents: 12345, taxCents: 0, totalCents: 0,
+  });
+  assert.deepEqual(applyDiscountAndTax(0, 5000, 10000), {
+    subtotalCents: 0, discountCents: 0, taxCents: 0, totalCents: 0,
+  });
+});
+
+test("applyDiscountAndTax validates integer bounds", () => {
+  for (const [gross, disc, tax] of [
+    [-1, 0, 0],
+    [1.5, 0, 0],
+    [100, -1, 0],
+    [100, 10001, 0],
+    [100, 0.5, 0],
+    [100, 0, -1],
+    [100, 0, 10001],
+    [100, 0, Number.NaN],
+  ] as const) {
+    assert.throws(() => applyDiscountAndTax(gross, disc, tax), ValidationError, `${gross},${disc},${tax}`);
+  }
+});
+
+test("calculateBookingPrice applies optional discountBps through applyDiscountAndTax", () => {
+  const room = { roomId: "a", name: "A", hourlyRateCents: 10000, taxBps: 825 };
+  const p = calculateBookingPrice(room, 90, { discountBps: 1250 });
+  assert.deepEqual(p, {
+    subtotalCents: 13125,
+    discountCents: 1875,
+    taxCents: 1083, // 1082.8125 -> 1083
+    totalCents: 14208,
+  });
+  assert.deepEqual(calculateBookingPrice(room, 90), calculateBookingPrice(room, 90, { discountBps: 0 }));
+  assert.throws(() => calculateBookingPrice(room, 60, { discountBps: 10001 }), ValidationError);
+});
+
+// --- createGroupBooking: pricing ------------------------------------------
+
+test("createGroupBooking prices each room and sums group totals", () => {
+  const svc = makeService();
+  const result = createGroupBooking(svc, {
+    customerId: "  acme ",
+    roomIds: ["a", "b"],
+    startMinute: 60,
+    endMinute: 150,
+    discountBps: 1250,
+  });
+
+  assert.equal(result.bookings.length, 2);
+  const [a, b] = result.bookings;
+  assert.equal(a.roomId, "a");
+  assert.equal(b.roomId, "b");
+  // Room a: gross 15000, discount 1875, subtotal 13125, tax 1083.
+  assert.equal(a.subtotalCents, 13125);
+  assert.equal(a.discountCents, 1875);
+  assert.equal(a.taxCents, 1083);
+  assert.equal(a.totalCents, 14208);
+  // Room b: gross 7498.5 -> 7499, discount 937.375 -> 937, subtotal 6562, no tax.
+  assert.equal(b.subtotalCents, 6562);
+  assert.equal(b.discountCents, 937);
+  assert.equal(b.taxCents, 0);
+  assert.equal(b.totalCents, 6562);
+
+  assert.equal(result.subtotalCents, 19687);
+  assert.equal(result.discountCents, 2812);
+  assert.equal(result.taxCents, 1083);
+  assert.equal(result.totalCents, 20770);
+
+  for (const booking of result.bookings) {
+    assert.equal(booking.groupId, result.groupId);
+    assert.equal(booking.status, "confirmed");
+    assert.equal(booking.customerId, "acme");
+    assert.equal(booking.startMinute, 60);
+    assert.equal(booking.endMinute, 150);
+    assert.equal(booking.expiresAt, undefined);
+    assert.deepEqual(svc.getBooking(booking.bookingId), booking);
+  }
+  assert.notEqual(a.bookingId, b.bookingId);
+});
+
+test("each group gets its own groupId and blocks later overlapping bookings", () => {
+  const svc = makeService();
+  const g1 = createGroupBooking(svc, { customerId: "x", roomIds: ["a", "b"], startMinute: 0, endMinute: 60, discountBps: 0 });
+  const g2 = createGroupBooking(svc, { customerId: "y", roomIds: ["a", "b", "c"], startMinute: 60, endMinute: 120, discountBps: 0 });
+  assert.notEqual(g1.groupId, g2.groupId);
+  assert.equal(g2.bookings.length, 3);
+  assertConflict(() => svc.createBooking({ roomId: "b", customerId: "z", startMinute: 30, endMinute: 90 }));
+  // Single bookings have no groupId.
+  assert.equal(svc.createBooking({ roomId: "c", customerId: "z", startMinute: 0, endMinute: 60 }).groupId, undefined);
+});
+
+// --- createGroupBooking: atomic conflicts ---------------------------------
+
+test("a conflict in any room aborts the whole group with no partial bookings", () => {
+  const svc = makeService();
+  const existing = svc.createBooking({ roomId: "c", customerId: "solo", startMinute: 100, endMinute: 160 });
+  assert.equal(totalBookings(svc), 1);
+
+  // The conflicting room is last, so rooms "a" and "b" would be committed by a non-atomic implementation.
+  assertConflict(() =>
+    createGroupBooking(svc, { customerId: "acme", roomIds: ["a", "b", "c"], startMinute: 60, endMinute: 120, discountBps: 500 })
+  );
+  assert.equal(totalBookings(svc), 1);
+  assert.deepEqual(svc.listRoomBookings("c"), [existing]);
+
+  // The same rooms are still free for a non-conflicting group afterwards.
+  const ok = createGroupBooking(svc, { customerId: "acme", roomIds: ["a", "b", "c"], startMinute: 160, endMinute: 220, discountBps: 500 });
+  assert.equal(ok.bookings.length, 3);
+  assert.equal(totalBookings(svc), 4);
+});
+
+test("active holds block a group; expired holds do not", () => {
+  const svc = makeService();
+  svc.createBooking({ roomId: "b", customerId: "h", startMinute: 0, endMinute: 60, nowMinute: 10, holdMinutes: 20 });
+  assertConflict(() =>
+    createGroupBooking(svc, { customerId: "g", roomIds: ["a", "b"], startMinute: 30, endMinute: 90, discountBps: 0, nowMinute: 29 })
+  );
+  assert.equal(totalBookings(svc), 1);
+  const ok = createGroupBooking(svc, { customerId: "g", roomIds: ["a", "b"], startMinute: 30, endMinute: 90, discountBps: 0, nowMinute: 30 });
+  assert.equal(ok.bookings.length, 2);
+});
+
+test("back-to-back group slots do not conflict", () => {
+  const svc = makeService();
+  createGroupBooking(svc, { customerId: "g", roomIds: ["a", "b"], startMinute: 0, endMinute: 60, discountBps: 0 });
+  const next = createGroupBooking(svc, { customerId: "g", roomIds: ["b", "a"], startMinute: 60, endMinute: 120, discountBps: 0 });
+  assert.deepEqual(next.bookings.map((bk) => bk.roomId), ["b", "a"]);
+});
+
+// --- createGroupBooking: validation ---------------------------------------
+
+test("createGroupBooking rejects invalid input without committing anything", () => {
+  const svc = makeService();
+  const base = { customerId: "acme", roomIds: ["a", "b"], startMinute: 0, endMinute: 60, discountBps: 0 };
+  const bad: Array<[string, Record<string, unknown>]> = [
+    ["single room", { roomIds: ["a"] }],
+    ["no rooms", { roomIds: [] }],
+    ["duplicate rooms", { roomIds: ["a", "b", "a"] }],
+    ["unknown room", { roomIds: ["a", "missing"] }],
+    ["negative discount", { discountBps: -1 }],
+    ["discount > 10000", { discountBps: 10001 }],
+    ["fractional discount", { discountBps: 12.5 }],
+    ["empty customer", { customerId: "  " }],
+    ["inverted window", { startMinute: 60, endMinute: 60 }],
+    ["fractional start", { startMinute: 0.5 }],
+    ["negative nowMinute", { nowMinute: -1 }],
