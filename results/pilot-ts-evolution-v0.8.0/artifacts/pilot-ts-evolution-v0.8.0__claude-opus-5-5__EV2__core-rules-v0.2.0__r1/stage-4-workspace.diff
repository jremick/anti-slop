+import test from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync, readdirSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import * as api from "../src/index.ts";
+import {
+  BookingService,
+  CANCEL_FEE_TIERS_ENV,
+  ConfigError,
+  ConflictError,
+  ValidationError,
+  calculateBookingPrice,
+  createGroupBooking,
+} from "../src/index.ts";
+import type { BookingNotification } from "../src/index.ts";
+
+const TIERS = JSON.stringify({ cutoffMinutes: 1440, earlyFeeBps: 1000, lateFeeBps: 5000 });
+
+class HookFailure extends Error {}
+
+/** Service whose hook records every event and throws on the Nth call (1-based) when `failOn` is set. */
+function makeService(opts: { failOn?: number; env?: Record<string, string | undefined> } = {}) {
+  const events: BookingNotification[] = [];
+  let calls = 0;
+  const svc = new BookingService({
+    env: opts.env ?? { [CANCEL_FEE_TIERS_ENV]: TIERS },
+    notifyHook: (event) => {
+      calls += 1;
+      events.push(event);
+      if (opts.failOn !== undefined && calls >= opts.failOn) {
+        throw new HookFailure(`hook failed on call ${calls}`);
+      }
+    },
+  });
+  svc.registerRoom({ roomId: "a", name: "A", hourlyRateCents: 10000, taxBps: 825 });
+  svc.registerRoom({ roomId: "b", name: "B", hourlyRateCents: 4999, taxBps: 0 });
+  svc.registerRoom({ roomId: "c", name: "C", hourlyRateCents: 1999, taxBps: 1000 });
+  return { svc, events, failAfter: (n: number) => { opts.failOn = calls + n; } };
+}
+
+function allBookings(svc: BookingService) {
+  return ["a", "b", "c"].flatMap((id) => svc.listRoomBookings(id));
+}
+
+// --- legacy deposit removal ------------------------------------------------
+
+test("legacy deposit exports and fields are gone", () => {
+  for (const name of ["LEGACY_DEPOSIT_BPS", "calculateLegacyDeposit"]) {
+    assert.equal(name in api, false, name);
+  }
+  const room = { roomId: "r", name: "R", hourlyRateCents: 4000, taxBps: 0 };
+  assert.deepEqual(Object.keys(calculateBookingPrice(room, 60)).sort(), [
+    "discountCents", "subtotalCents", "taxCents", "totalCents",
+  ]);
+  const svc = new BookingService({ env: {} });
+  svc.registerRoom(room);
+  const booking = svc.createBooking({ roomId: "r", customerId: "c", startMinute: 0, endMinute: 60 });
+  assert.equal("depositCents" in booking, false);
+
+  const srcDir = join(dirname(fileURLToPath(import.meta.url)), "..", "src");
+  for (const file of readdirSync(srcDir)) {
+    const text = readFileSync(join(srcDir, file), "utf8");
+    assert.doesNotMatch(text, /legacy|deposit/i, file);
+  }
+});
+
+// --- event emission --------------------------------------------------------
+
+test("notifyHook rejects non-function values", () => {
+  assert.throws(
+    () => new BookingService({ env: {}, notifyHook: "nope" as unknown as () => void }),
+    ValidationError,
+  );
+});
+
+test("createBooking emits exactly one booking_created event with totalCents", () => {
+  const { svc, events } = makeService();
+  const confirmed = svc.createBooking({ roomId: "a", customerId: " acme ", startMinute: 0, endMinute: 90 });
+  const held = svc.createBooking({ roomId: "b", customerId: "h", startMinute: 0, endMinute: 60, holdMinutes: 10 });
+  assert.deepEqual(events, [
+    { event: "booking_created", bookingId: confirmed.bookingId, roomId: "a", customerId: "acme", amountCents: 16238 },
+    { event: "booking_created", bookingId: held.bookingId, roomId: "b", customerId: "h", amountCents: 4999 },
+  ]);
+});
+
+test("createGroupBooking emits one booking_created event per room in order", () => {
+  const { svc, events } = makeService();
+  const group = createGroupBooking(svc, {
+    customerId: "acme", roomIds: ["b", "a"], startMinute: 60, endMinute: 150, discountBps: 1250,
+  });
+  assert.deepEqual(
+    events,
+    group.bookings.map((bk) => ({
+      event: "booking_created",
+      bookingId: bk.bookingId,
+      roomId: bk.roomId,
+      customerId: "acme",
+      amountCents: bk.totalCents,
+    })),
+  );
+  assert.deepEqual(events.map((e) => [e.roomId, e.amountCents]), [["b", 6562], ["a", 14208]]);
+});
+
+test("cancelBooking emits booking_cancelled with refundCents", () => {
+  const { svc, events } = makeService();
+  const booking = svc.createBooking({ roomId: "a", customerId: "c", startMinute: 2000, endMinute: 2060 });
+  const result = svc.cancelBooking(booking.bookingId, 0);
+  assert.equal(events.length, 2);
+  assert.deepEqual(events[1], {
+    event: "booking_cancelled",
+    bookingId: booking.bookingId,
+    roomId: "a",
+    customerId: "c",
+    amountCents: result.refundCents,
+  });
+  assert.equal(result.refundCents, 9742);
+});
+
+test("failed operations emit no events", () => {
+  const { svc, events } = makeService({ env: {} });
+  const booking = svc.createBooking({ roomId: "a", customerId: "c", startMinute: 0, endMinute: 60 });
+  events.length = 0;
+  assert.throws(() => svc.createBooking({ roomId: "a", customerId: "c", startMinute: 30, endMinute: 90 }), ConflictError);
+  assert.throws(() => svc.createBooking({ roomId: "missing", customerId: "c", startMinute: 0, endMinute: 60 }), ValidationError);
+  assert.throws(
+    () => createGroupBooking(svc, { customerId: "g", roomIds: ["b", "a"], startMinute: 0, endMinute: 60, discountBps: 0 }),
+    ConflictError,
+  );
+  assert.throws(() => svc.cancelBooking(booking.bookingId, 0), ConfigError); // no fee tiers configured
+  assert.deepEqual(events, []);
+});
+
+test("hook observes the committed booking", () => {
+  const seen: string[] = [];
+  const svc: BookingService = new BookingService({
+    env: {},
+    notifyHook: (e) => { seen.push(svc.getBooking(e.bookingId).status); },
+  });
+  svc.registerRoom({ roomId: "a", name: "A", hourlyRateCents: 100, taxBps: 0 });
+  svc.createBooking({ roomId: "a", customerId: "c", startMinute: 0, endMinute: 60 });
+  assert.deepEqual(seen, ["confirmed"]);
+});
+
+// --- fail-closed rollback --------------------------------------------------
+
+test("hook failure on createBooking propagates and persists nothing", () => {
+  const { svc } = makeService({ failOn: 1 });
+  assert.throws(
+    () => svc.createBooking({ roomId: "a", customerId: "c", startMinute: 0, endMinute: 60 }),
+    HookFailure,
+  );
+  assert.deepEqual(allBookings(svc), []);
+  assert.throws(() => svc.getBooking("bkg_0001"), ValidationError);
+});
+
+test("hook failure mid-group rolls back every room booking", () => {
+  const { svc, events, failAfter } = makeService();
+  const existing = svc.createBooking({ roomId: "c", customerId: "solo", startMinute: 500, endMinute: 560 });
+  failAfter(2); // first group room notifies fine, second throws
+  assert.throws(
+    () => createGroupBooking(svc, { customerId: "g", roomIds: ["a", "b", "c"], startMinute: 0, endMinute: 60, discountBps: 0 }),
+    HookFailure,
+  );
+  assert.equal(events.length, 3); // solo + 2 group attempts; third room never notified
+  assert.deepEqual(allBookings(svc), [existing]);
+  for (const e of events.slice(1)) {
+    assert.throws(() => svc.getBooking(e.bookingId), ValidationError);
+  }
+});
+
+test("hook failure on the last group room still rolls back the whole group", () => {
+  const { svc } = makeService({ failOn: 3 });
+  assert.throws(
+    () => createGroupBooking(svc, { customerId: "g", roomIds: ["a", "b", "c"], startMinute: 0, endMinute: 60, discountBps: 0 }),
+    HookFailure,
+  );
+  assert.deepEqual(allBookings(svc), []);
+});
+
+test("hook failure on cancelBooking leaves the booking active", () => {
+  const { svc, failAfter } = makeService();
+  const booking = svc.createBooking({ roomId: "a", customerId: "c", startMinute: 2000, endMinute: 2060 });
+  failAfter(1);
+  assert.throws(() => svc.cancelBooking(booking.bookingId, 0), HookFailure);
+  assert.deepEqual(svc.getBooking(booking.bookingId), booking);
+  assert.throws(
+    () => svc.createBooking({ roomId: "a", customerId: "x", startMinute: 2000, endMinute: 2060 }),
+    ConflictError, // the slot is still occupied; conflicts are detected before any hook call
+  );
+});
+
+test("after a rolled-back operation the slot is free and the service keeps working", () => {
+  const { svc, events, failAfter } = makeService();
+  failAfter(1);
+  assert.throws(
+    () => createGroupBooking(svc, { customerId: "g", roomIds: ["a", "b"], startMinute: 0, endMinute: 60, discountBps: 0 }),
+    HookFailure,
+  );
+  failAfter(Number.POSITIVE_INFINITY);
+  events.length = 0;
+  const group = createGroupBooking(svc, { customerId: "g", roomIds: ["a", "b"], startMinute: 0, endMinute: 60, discountBps: 0 });
+  assert.equal(allBookings(svc).length, 2);
+  assert.deepEqual(events.map((e) => e.bookingId), group.bookings.map((bk) => bk.bookingId));
+});
