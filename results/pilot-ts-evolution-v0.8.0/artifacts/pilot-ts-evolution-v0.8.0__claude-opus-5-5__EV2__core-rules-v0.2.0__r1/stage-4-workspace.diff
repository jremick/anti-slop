+
+export const CANCEL_FEE_TIERS_ENV = "BOOKING_CANCEL_FEE_TIERS_JSON";
+
+function requireBps(obj: Record<string, unknown>, key: string): number {
+  const value = obj[key];
+  if (typeof value !== "number" || !Number.isInteger(value) || value < 0 || value > 10000) {
+    throw new ConfigError(`${CANCEL_FEE_TIERS_ENV}.${key} must be an integer between 0 and 10000`);
+  }
