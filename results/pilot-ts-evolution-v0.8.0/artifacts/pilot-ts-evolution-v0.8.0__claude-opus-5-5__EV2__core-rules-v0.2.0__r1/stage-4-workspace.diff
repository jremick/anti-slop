+}
+
+/**
+ * Loads cancellation fee tiers from BOOKING_CANCEL_FEE_TIERS_JSON.
+ * Fails closed: any missing, malformed or out-of-range value throws ConfigError.
+ */
+export function loadCancellationFeeConfig(
+  env: EnvSource = process.env,
+): CancellationFeeConfig {
+  const raw = env[CANCEL_FEE_TIERS_ENV];
+  if (raw === undefined || raw.trim() === "") {
+    throw new ConfigError(`${CANCEL_FEE_TIERS_ENV} is required`);
+  }
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(raw);
+  } catch (err) {
+    throw new ConfigError(`${CANCEL_FEE_TIERS_ENV} is not valid JSON: ${(err as Error).message}`);
+  }
+  if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) {
+    throw new ConfigError(`${CANCEL_FEE_TIERS_ENV} must be a JSON object`);
+  }
+  const obj = parsed as Record<string, unknown>;
+  const cutoffMinutes = obj.cutoffMinutes;
+  if (typeof cutoffMinutes !== "number" || !Number.isInteger(cutoffMinutes) || cutoffMinutes < 0) {
+    throw new ConfigError(`${CANCEL_FEE_TIERS_ENV}.cutoffMinutes must be a non-negative integer`);
+  }
+  return {
+    cutoffMinutes,
+    earlyFeeBps: requireBps(obj, "earlyFeeBps"),
+    lateFeeBps: requireBps(obj, "lateFeeBps"),
+  };
+}
+
+/** Early tier applies when cancelling at least `cutoffMinutes` before start; otherwise the late tier. */
+export function selectCancellationFeeBps(
+  minutesBeforeStart: number,
