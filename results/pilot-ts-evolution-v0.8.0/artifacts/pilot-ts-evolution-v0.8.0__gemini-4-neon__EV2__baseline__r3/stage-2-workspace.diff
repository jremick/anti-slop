+test("applyDiscountAndTax computes exact half-up discount, net subtotal, tax, and total", () => {
+  // 100 * 150 / 10000 = 1.5 -> discountCents = 2, subtotal = 98, tax = 98 * 500 / 10000 = 4.9 -> 5
+  const exactHalf = applyDiscountAndTax(100, 150, 500);
+  assert.deepEqual(exactHalf, {
+    subtotalCents: 98,
+    discountCents: 2,
+    taxCents: 5,
+    totalCents: 103,
+  });
+
+  // 0% discount leaves gross subtotal unchanged
+  assert.deepEqual(applyDiscountAndTax(20000, 0, 825), {
+    subtotalCents: 20000,
+    discountCents: 0,
+    taxCents: 1650,
+    totalCents: 21650,
+  });
+
+  // 100% discount zeroes subtotal, tax, and total
+  assert.deepEqual(applyDiscountAndTax(12345, 10000, 1000), {
+    subtotalCents: 0,
+    discountCents: 12345,
+    taxCents: 0,
+    totalCents: 0,
+  });
+
+  // Zero gross subtotal
+  assert.deepEqual(applyDiscountAndTax(0, 1500, 825), {
+    subtotalCents: 0,
+    discountCents: 0,
+    taxCents: 0,
+    totalCents: 0,
+  });
+});
+
+test("applyDiscountAndTax rejects out-of-bounds or non-integer inputs with ValidationError", () => {
+  assert.throws(() => applyDiscountAndTax(-1, 0, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100.5, 0, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, -1, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, 10001, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, 50.5, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, 0, -1), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, 0, 10001), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, 0, 8.25), ValidationError);
+});
