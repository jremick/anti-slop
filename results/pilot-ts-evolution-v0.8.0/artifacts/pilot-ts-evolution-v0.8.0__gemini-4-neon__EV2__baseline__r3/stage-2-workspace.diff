+test("createGroupBooking checks conflicts atomically with zero partial bookings on conflict", () => {
+  const svc = new BookingService({ env: {} });
+  svc.registerRoom({ roomId: "r1", name: "Room 1", hourlyRateCents: 4000, taxBps: 500 });
+  svc.registerRoom({ roomId: "r2", name: "Room 2", hourlyRateCents: 4000, taxBps: 500 });
+  svc.registerRoom({ roomId: "r3", name: "Room 3", hourlyRateCents: 4000, taxBps: 500 });
+
+  // Active hold on r3 (last room in list) expiring at minute 20
+  svc.createBooking({
+    roomId: "r3",
+    customerId: "existing_holder",
+    startMinute: 90,
+    endMinute: 150,
+    nowMinute: 5,
+    holdMinutes: 15,
+  });
+
+  // At nowMinute = 19, r3 conflicts; r1 and r2 must remain untouched (atomic rollback)
+  assert.throws(
+    () =>
+      createGroupBooking(svc, {
+        customerId: "corp_1",
+        roomIds: ["r1", "r2", "r3"],
+        startMinute: 60,
+        endMinute: 120,
+        discountBps: 500,
+        nowMinute: 19,
+      }),
+    ConflictError,
+  );
+  assert.equal(svc.listRoomBookings("r1").length, 0);
+  assert.equal(svc.listRoomBookings("r2").length, 0);
+  assert.equal(svc.listRoomBookings("r3").length, 1);
+
+  // At nowMinute = 20, the hold on r3 is expired so the group booking succeeds
+  const committed = createGroupBooking(svc, {
+    customerId: "corp_1",
+    roomIds: ["r1", "r2", "r3"],
+    startMinute: 60,
+    endMinute: 120,
+    discountBps: 500,
+    nowMinute: 20,
+  });
+  assert.equal(committed.bookings.length, 3);
+  assert.equal(svc.listRoomBookings("r1").length, 1);
+  assert.equal(svc.listRoomBookings("r2").length, 1);
+  assert.equal(svc.listRoomBookings("r3").length, 2);
+
+  // Back-to-back group booking [120, 180) succeeds without conflict
+  const adjacent = createGroupBooking(svc, {
+    customerId: "corp_2",
+    roomIds: ["r1", "r2"],
+    startMinute: 120,
+    endMinute: 180,
+    discountBps: 0,
+    nowMinute: 25,
+  });
+  assert.equal(adjacent.bookings.length, 2);
+  assert.notEqual(adjacent.groupId, committed.groupId);
+});
