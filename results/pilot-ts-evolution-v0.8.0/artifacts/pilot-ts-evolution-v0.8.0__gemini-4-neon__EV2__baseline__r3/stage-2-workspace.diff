+test("BookingService.confirmHold transitions active hold to confirmed and clears expiresAt", () => {
+  const svc = new BookingService({ env: {} });
+  svc.registerRoom({
+    roomId: "room_a",
+    name: "Room A",
+    hourlyRateCents: 6000,
+    taxBps: 500,
+  });
+
+  const hold = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_1",
+    startMinute: 120,
+    endMinute: 165,
+    nowMinute: 10,
+    holdMinutes: 20,
+  });
+  assert.equal(hold.status, "held");
+  assert.equal(hold.expiresAt, 30);
+
+  // Confirm right before expiry (nowMinute = 29 < 30)
+  const confirmed = svc.confirmHold(hold.bookingId, 29);
+  assert.equal(confirmed.bookingId, hold.bookingId);
+  assert.equal(confirmed.status, "confirmed");
+  assert.equal(confirmed.expiresAt, undefined);
+  assert.equal("expiresAt" in confirmed, false);
+  assert.equal(confirmed.subtotalCents, hold.subtotalCents);
+  assert.equal(confirmed.totalCents, hold.totalCents);
+
+  // Stored state is updated
+  const stored = svc.getBooking(hold.bookingId);
+  assert.equal(stored.status, "confirmed");
+  assert.equal(stored.expiresAt, undefined);
+
+  // Still blocks overlapping bookings well past the original hold expiry
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "room_a",
+        customerId: "cust_2",
+        startMinute: 130,
+        endMinute: 150,
+        nowMinute: 100,
+      }),
+    ConflictError,
+  );
+
+  // Cannot confirm again, cannot confirm unknown booking, cannot pass invalid nowMinute
+  assert.throws(() => svc.confirmHold(hold.bookingId, 29), ValidationError);
+  assert.throws(() => svc.confirmHold("bkg_missing", 10), ValidationError);
+  assert.throws(() => svc.confirmHold(hold.bookingId, -5), ValidationError);
+});

