+        endMinute: 90,
+        nowMinute: -1,
+      }),
+    ValidationError,
+  );
+
+  // Max holdMinutes allowed; nowMinute defaults to 0
+  const holdDefaultNow = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_1",
+    startMinute: 60,
+    endMinute: 90,
+    holdMinutes: 30,
+  });
+  assert.equal(holdDefaultNow.status, "held");
+  assert.equal(holdDefaultNow.expiresAt, 30);
+
+  // Active at nowMinute = 29 -> overlapping booking rejected
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "room_a",
+        customerId: "cust_2",
+        startMinute: 75,
+        endMinute: 105,
+        nowMinute: 29,
+      }),
+    ConflictError,
+  );
+
+  // Expired at exact boundary nowMinute = 30 -> overlapping booking succeeds
+  const replacement = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_2",
+    startMinute: 75,
+    endMinute: 105,
+    nowMinute: 30,
+    holdMinutes: 10,
