+export function isBookingActiveAt(booking: Booking, nowMinute: number): boolean {
+  if (booking.status === "confirmed") {
+    return true;
+  }
+  if (booking.status === "held") {
+    return booking.expiresAt !== undefined && nowMinute < booking.expiresAt;
+  }
+  return false;
