+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  calculateBookingPrice,
+  isBookingActiveAt,
+  roundHalfUpDiv,
+  slotsOverlap,
+} from "../src/index.ts";
+import type { Booking, Room } from "../src/index.ts";
+
+test("roundHalfUpDiv performs exact integer half-up division", () => {
+  assert.equal(roundHalfUpDiv(0, 60), 0);
+  assert.equal(roundHalfUpDiv(120, 60), 2);
+  assert.equal(roundHalfUpDiv(1, 2), 1);
+  assert.equal(roundHalfUpDiv(3, 2), 2);
+  assert.equal(roundHalfUpDiv(5, 2), 3);
+  assert.equal(roundHalfUpDiv(1, 3), 0);
+  assert.equal(roundHalfUpDiv(2, 3), 1);
+  assert.equal(roundHalfUpDiv(29, 60), 0);
+  assert.equal(roundHalfUpDiv(30, 60), 1);
+  assert.equal(roundHalfUpDiv(31, 60), 1);
+  assert.equal(roundHalfUpDiv(89, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2);
+  assert.equal(roundHalfUpDiv(3, 7), 0);
+  assert.equal(roundHalfUpDiv(4, 7), 1);
+  assert.equal(roundHalfUpDiv(4999, 10000), 0);
+  assert.equal(roundHalfUpDiv(5000, 10000), 1);
+});
+
+test("roundHalfUpDiv rejects invalid numerators and denominators with ValidationError", () => {
+  assert.throws(() => roundHalfUpDiv(-1, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(1.5, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.NaN, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.POSITIVE_INFINITY, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, 0), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, -5), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, 2.5), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, Number.NaN), ValidationError);
+});
+
+test("calculateBookingPrice supports arbitrary positive integer durations with half-up cents", () => {
+  const room: Room = {
+    roomId: "studio_1",
+    name: "Studio 1",
+    hourlyRateCents: 101,
+    taxBps: 825,
+  };
+
+  // 101 * 30 / 60 = 50.5 -> rounds half-up to 51
+  // tax: 51 * 825 / 10000 = 42075 / 10000 = 4.2075 -> 4
+  const halfHour = calculateBookingPrice(room, 30);
+  assert.equal(halfHour.subtotalCents, 51);
+  assert.equal(halfHour.taxCents, 4);
+  assert.equal(halfHour.totalCents, 55);
+  assert.equal(halfHour.depositCents, 0);
+
+  // 100 * 20 / 60 = 33.333... -> 33; 100 * 40 / 60 = 66.666... -> 67
+  const thirdRoom: Room = {
+    roomId: "studio_2",
+    name: "Studio 2",
+    hourlyRateCents: 100,
+    taxBps: 500,
+  };
+  const twentyMin = calculateBookingPrice(thirdRoom, 20, { legacyDepositMode: true });
+  assert.equal(twentyMin.subtotalCents, 33);
+  assert.equal(twentyMin.taxCents, 2); // 33 * 500 / 10000 = 1.65 -> 2
+  assert.equal(twentyMin.totalCents, 35);
+  assert.equal(twentyMin.depositCents, 8); // 33 * 2500 / 10000 = 8.25 -> 8
+
+  const fortyMin = calculateBookingPrice(thirdRoom, 40);
+  assert.equal(fortyMin.subtotalCents, 67);
+  assert.equal(fortyMin.taxCents, 3); // 67 * 500 / 10000 = 3.35 -> 3
+  assert.equal(fortyMin.totalCents, 70);
+
+  // 1-minute duration: 1000 * 1 / 60 = 16.666... -> 17
+  const oneMin = calculateBookingPrice(
+    { roomId: "studio_3", name: "Studio 3", hourlyRateCents: 1000, taxBps: 0 },
+    1,
+  );
+  assert.equal(oneMin.subtotalCents, 17);
+  assert.equal(oneMin.totalCents, 17);
+
+  assert.throws(() => calculateBookingPrice(room, 0), ValidationError);
+  assert.throws(() => calculateBookingPrice(room, -15), ValidationError);
+  assert.throws(() => calculateBookingPrice(room, 15.5), ValidationError);
+});
+
+test("slotsOverlap uses half-open intervals so back-to-back bookings do not conflict", () => {
+  // Back-to-back intervals do not overlap
+  assert.equal(slotsOverlap(60, 120, 120, 180), false);
+  assert.equal(slotsOverlap(120, 180, 60, 120), false);
+  // Disjoint with gap
+  assert.equal(slotsOverlap(0, 30, 45, 90), false);
+  // Overlapping intervals
+  assert.equal(slotsOverlap(60, 120, 119, 180), true);
+  assert.equal(slotsOverlap(119, 180, 60, 120), true);
+  assert.equal(slotsOverlap(60, 120, 60, 120), true);
+  assert.equal(slotsOverlap(60, 180, 90, 120), true);
+  assert.equal(slotsOverlap(90, 120, 60, 180), true);
+});
+
+test("isBookingActiveAt handles confirmed, held, expired, and cancelled bookings", () => {
+  const base: Omit<Booking, "status" | "expiresAt"> = {
+    bookingId: "bkg_0001",
+    roomId: "conf_a",
+    customerId: "cust_1",
+    startMinute: 60,
+    endMinute: 120,
+    subtotalCents: 1000,
+    discountCents: 0,
+    taxCents: 0,
+    totalCents: 1000,
+    depositCents: 0,
+  };
+
+  const confirmed: Booking = { ...base, status: "confirmed" };
+  assert.equal(isBookingActiveAt(confirmed, 0), true);
+  assert.equal(isBookingActiveAt(confirmed, 99999), true);
+
+  const held: Booking = { ...base, status: "held", expiresAt: 30 };
+  assert.equal(isBookingActiveAt(held, 0), true);
+  assert.equal(isBookingActiveAt(held, 29), true);
+  assert.equal(isBookingActiveAt(held, 30), false);
+  assert.equal(isBookingActiveAt(held, 45), false);
+
+  const heldMissingExpiry: Booking = { ...base, status: "held" };
+  assert.equal(isBookingActiveAt(heldMissingExpiry, 0), false);
+
+  const cancelled: Booking = { ...base, status: "cancelled" };
+  assert.equal(isBookingActiveAt(cancelled, 0), false);
+});
+
+test("BookingService enforces conflict detection and allows back-to-back or different rooms", () => {
+  const svc = new BookingService({ env: {} });
+  svc.registerRoom({
+    roomId: "room_a",
+    name: "Room A",
+    hourlyRateCents: 6000,
+    taxBps: 1000,
+  });
+  svc.registerRoom({
+    roomId: "room_b",
+    name: "Room B",
+    hourlyRateCents: 6000,
+    taxBps: 1000,
+  });
+
+  const first = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_1",
+    startMinute: 60,
+    endMinute: 105,
+  });
+  // 45 minutes at 6000 cents/hr = 4500 cents, 10% tax = 450
+  assert.equal(first.subtotalCents, 4500);
+  assert.equal(first.taxCents, 450);
+  assert.equal(first.totalCents, 4950);
+
+  // Back-to-back before and after succeed
+  const before = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_2",
+    startMinute: 15,
+    endMinute: 60,
+  });
+  const after = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_3",
+    startMinute: 105,
+    endMinute: 150,
+  });
+  assert.equal(before.status, "confirmed");
+  assert.equal(after.status, "confirmed");
+
+  // Same slot on different room succeeds
+  const otherRoom = svc.createBooking({
+    roomId: "room_b",
+    customerId: "cust_4",
+    startMinute: 60,
+    endMinute: 105,
+  });
+  assert.equal(otherRoom.status, "confirmed");
+
+  // Overlapping slot on same room throws ConflictError
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "room_a",
+        customerId: "cust_5",
+        startMinute: 104,
+        endMinute: 120,
+      }),
+    ConflictError,
+  );
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "room_a",
+        customerId: "cust_5",
+        startMinute: 70,
+        endMinute: 90,
+        holdMinutes: 15,
+      }),
+    ConflictError,
+  );
+});
+
+test("BookingService holds expire at expiresAt and validate holdMinutes against config", () => {
+  const svc = new BookingService({ env: { BOOKING_MAX_HOLD_MINUTES: "30" } });
+  svc.registerRoom({
+    roomId: "room_a",
+    name: "Room A",
+    hourlyRateCents: 3000,
+    taxBps: 0,
+  });
+
+  // Invalid holdMinutes or nowMinute
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "room_a",
+        customerId: "cust_1",
+        startMinute: 60,
+        endMinute: 90,
+        holdMinutes: 0,
+      }),
+    ValidationError,
+  );
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "room_a",
+        customerId: "cust_1",
+        startMinute: 60,
+        endMinute: 90,
+        holdMinutes: 31,
+      }),
+    ValidationError,
+  );
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "room_a",
+        customerId: "cust_1",
+        startMinute: 60,
+        endMinute: 90,
+        holdMinutes: 10.5,
+      }),
+    ValidationError,
+  );
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "room_a",
+        customerId: "cust_1",
+        startMinute: 60,
+        endMinute: 90,
+        nowMinute: -1,
+      }),
+    ValidationError,
+  );
+
+  // Max holdMinutes allowed; nowMinute defaults to 0
+  const holdDefaultNow = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_1",
+    startMinute: 60,
+    endMinute: 90,
+    holdMinutes: 30,
+  });
+  assert.equal(holdDefaultNow.status, "held");
+  assert.equal(holdDefaultNow.expiresAt, 30);
+
+  // Active at nowMinute = 29 -> overlapping booking rejected
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "room_a",
+        customerId: "cust_2",
+        startMinute: 75,
+        endMinute: 105,
+        nowMinute: 29,
+      }),
+    ConflictError,
+  );
+
+  // Expired at exact boundary nowMinute = 30 -> overlapping booking succeeds
+  const replacement = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_2",
+    startMinute: 75,
+    endMinute: 105,
+    nowMinute: 30,
+    holdMinutes: 10,
+  });
+  assert.equal(replacement.status, "held");
+  assert.equal(replacement.expiresAt, 40);
+
+  // Confirming an expired hold fails with ValidationError
+  assert.throws(() => svc.confirmHold(holdDefaultNow.bookingId, 30), ValidationError);
+  assert.throws(() => svc.confirmHold(holdDefaultNow.bookingId, 35), ValidationError);
+  assert.equal(svc.getBooking(holdDefaultNow.bookingId).status, "held");
+});
+
+test("BookingService.confirmHold transitions active hold to confirmed and clears expiresAt", () => {
+  const svc = new BookingService({ env: {} });
+  svc.registerRoom({
+    roomId: "room_a",
+    name: "Room A",
+    hourlyRateCents: 6000,
+    taxBps: 500,
+  });
+
+  const hold = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_1",
+    startMinute: 120,
+    endMinute: 165,
+    nowMinute: 10,
+    holdMinutes: 20,
+  });
+  assert.equal(hold.status, "held");
+  assert.equal(hold.expiresAt, 30);
+
+  // Confirm right before expiry (nowMinute = 29 < 30)
+  const confirmed = svc.confirmHold(hold.bookingId, 29);
+  assert.equal(confirmed.bookingId, hold.bookingId);
+  assert.equal(confirmed.status, "confirmed");
+  assert.equal(confirmed.expiresAt, undefined);
+  assert.equal("expiresAt" in confirmed, false);
+  assert.equal(confirmed.subtotalCents, hold.subtotalCents);
+  assert.equal(confirmed.totalCents, hold.totalCents);
+
+  // Stored state is updated
+  const stored = svc.getBooking(hold.bookingId);
+  assert.equal(stored.status, "confirmed");
+  assert.equal(stored.expiresAt, undefined);
+
+  // Still blocks overlapping bookings well past the original hold expiry
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "room_a",
+        customerId: "cust_2",
+        startMinute: 130,
+        endMinute: 150,
+        nowMinute: 100,
+      }),
+    ConflictError,
+  );
+
+  // Cannot confirm again, cannot confirm unknown booking, cannot pass invalid nowMinute
+  assert.throws(() => svc.confirmHold(hold.bookingId, 29), ValidationError);
+  assert.throws(() => svc.confirmHold("bkg_missing", 10), ValidationError);
+  assert.throws(() => svc.confirmHold(hold.bookingId, -5), ValidationError);
+});
