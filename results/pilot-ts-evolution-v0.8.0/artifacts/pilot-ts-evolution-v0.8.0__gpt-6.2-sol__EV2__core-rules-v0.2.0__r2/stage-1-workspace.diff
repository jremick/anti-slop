+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  calculateBookingPrice,
+  isBookingActiveAt,
+  roundHalfUpDiv,
+  slotsOverlap,
+} from "../src/index.ts";
+
+const room = { roomId: "a", name: "Room A", hourlyRateCents: 101, taxBps: 5000 };
+const slot = { roomId: room.roomId, customerId: "customer", startMinute: 60, endMinute: 90 };
+
+function setup() {
+  const service = new BookingService({ env: { BOOKING_MAX_HOLD_MINUTES: "10" } });
+  service.registerRoom(room);
+  service.registerRoom({ ...room, roomId: "b", name: "Room B" });
+  return service;
+}
+
+test("roundHalfUpDiv rounds below, at, and above half and validates both operands", () => {
+  assert.equal(roundHalfUpDiv(0, 60), 0);
+  assert.equal(roundHalfUpDiv(89, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2);
+  assert.equal(roundHalfUpDiv(91, 60), 2);
+  assert.equal(roundHalfUpDiv(1, 3), 0);
+  assert.equal(roundHalfUpDiv(2, 3), 1);
+  assert.equal(roundHalfUpDiv(Number.MAX_SAFE_INTEGER, 1), Number.MAX_SAFE_INTEGER);
+  for (const invalid of [-1, 0.5, NaN, Infinity]) {
+    assert.throws(() => roundHalfUpDiv(invalid, 60), ValidationError);
+    assert.throws(() => roundHalfUpDiv(60, invalid), ValidationError);
+  }
+  assert.throws(() => roundHalfUpDiv(60, 0), ValidationError);
+});
+
+test("minute-based pricing rounds the subtotal before calculating tax and legacy deposit", () => {
+  assert.deepEqual(calculateBookingPrice(room, 30, { legacyDepositMode: true }), {
+    subtotalCents: 51,
+    discountCents: 0,
+    taxCents: 26,
+    totalCents: 77,
+    depositCents: 13,
+  });
+  assert.equal(calculateBookingPrice(room, 1).subtotalCents, 2);
+  assert.equal(calculateBookingPrice(room, 61).subtotalCents, 103);
+  assert.equal(calculateBookingPrice({ ...room, hourlyRateCents: 1 }, 1).totalCents, 0);
+  for (const duration of [0, -1, 30.5]) {
+    assert.throws(() => calculateBookingPrice(room, duration), ValidationError);
+  }
+});
+
+test("slot conflicts account for exact overlap, room, and half-open boundaries", () => {
+  const service = setup();
+  const confirmed = service.createBooking(slot);
+  assert.equal(confirmed.status, "confirmed");
+  assert.equal(confirmed.totalCents, 77);
+  assert.equal(isBookingActiveAt(confirmed, 1000), true);
+  assert.equal(isBookingActiveAt({ ...confirmed, status: "cancelled", expiresAt: 10 }, 0), false);
+  assert.equal(isBookingActiveAt({ ...confirmed, status: "held" }, 0), false);
+  assert.equal(slotsOverlap(60, 90, 30, 60), false);
+  assert.equal(slotsOverlap(60, 90, 90, 120), false);
+  assert.equal(slotsOverlap(60, 90, 89, 120), true);
+
+  for (const [startMinute, endMinute] of [[30, 61], [89, 120], [61, 89], [30, 120], [60, 90]]) {
+    assert.throws(
+      () => service.createBooking({ ...slot, startMinute, endMinute, nowMinute: 1000 }),
+      ConflictError,
+    );
+  }
+  service.createBooking({ ...slot, startMinute: 30, endMinute: 60 });
+  service.createBooking({ ...slot, startMinute: 90, endMinute: 120 });
+  service.createBooking({ ...slot, roomId: "b" });
+  assert.equal(service.listRoomBookings("a").length, 3);
+  assert.equal(service.listRoomBookings("b").length, 1);
+});
+
+test("holds validate the configured limit and use minute zero by default", () => {
+  const service = setup();
+  for (const holdMinutes of [-1, 0, 0.5, 11, NaN, Infinity]) {
+    assert.throws(() => service.createBooking({ ...slot, holdMinutes }), ValidationError);
+  }
+  assert.equal(service.listRoomBookings("a").length, 0);
+  const hold = service.createBooking({ ...slot, holdMinutes: 10 });
+  assert.equal(hold.status, "held");
+  assert.equal(hold.expiresAt, 10);
+  assert.throws(() => service.createBooking(slot), ConflictError);
+});
+
+test("holds stop blocking at expiry and cannot be confirmed at or after expiry", () => {
+  const service = setup();
+  const hold = service.createBooking({ ...slot, nowMinute: 20, holdMinutes: 5 });
+  assert.equal(hold.expiresAt, 25);
+  assert.equal(isBookingActiveAt(hold, 24), true);
+  assert.equal(isBookingActiveAt(hold, 25), false);
+  assert.throws(() => service.createBooking({ ...slot, nowMinute: 24 }), ConflictError);
+  assert.throws(() => service.confirmHold(hold.bookingId, 25), ValidationError);
+  const replacement = service.createBooking({ ...slot, nowMinute: 25 });
+  assert.equal(replacement.status, "confirmed");
+  assert.throws(() => service.confirmHold(hold.bookingId, 26), ValidationError);
+  assert.deepEqual(service.getBooking(hold.bookingId), hold);
+});
+
+test("confirmation clears expiry, preserves booking details, and keeps the slot blocked", () => {
+  const service = setup();
+  const hold = service.createBooking({ ...slot, nowMinute: 20, holdMinutes: 5, legacyDepositMode: true });
+  assert.throws(() => service.confirmHold("unknown", 24), ValidationError);
+
+  const confirmed = service.confirmHold(hold.bookingId, 24);
+  const { expiresAt: _expiresAt, ...details } = hold;
+  assert.deepEqual(confirmed, { ...details, status: "confirmed" });
+  assert.deepEqual(service.getBooking(hold.bookingId), confirmed);
+  assert.deepEqual(service.listRoomBookings(room.roomId), [confirmed]);
+  assert.throws(() => service.confirmHold(hold.bookingId, 24), ValidationError);
+  assert.throws(() => service.createBooking({ ...slot, nowMinute: 25 }), ConflictError);
+});
