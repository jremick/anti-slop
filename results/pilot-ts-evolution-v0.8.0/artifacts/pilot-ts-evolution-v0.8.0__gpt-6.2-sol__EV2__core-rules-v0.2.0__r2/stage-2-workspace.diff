+} from "../src/index.ts";
+import type { CreateGroupBookingInput } from "../src/index.ts";
+
+const roomA = { roomId: "a", name: "Room A", hourlyRateCents: 101, taxBps: 5000 };
+const roomB = { roomId: "b", name: "Room B", hourlyRateCents: 301, taxBps: 1250 };
+const input: CreateGroupBookingInput = {
+  customerId: " customer ",
+  roomIds: ["a", "b"],
+  startMinute: 60,
+  endMinute: 90,
+  discountBps: 5000,
+};
