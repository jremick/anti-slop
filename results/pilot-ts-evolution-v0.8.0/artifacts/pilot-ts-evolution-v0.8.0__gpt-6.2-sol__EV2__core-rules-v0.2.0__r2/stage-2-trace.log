m \"./corporate.ts\";\nbenchmarks/sources/ev2_ts_bookings/src/corporate.ts:1:import type { BookingService } from \"./bookings.ts\";\nbenchmarks/sources/ev2_ts_bookings/src/corporate.ts:2:import type { Booking, CreateGroupBookingInput, PriceBreakdown } from \"./models.ts\";\n    const matches: Booking[] = [];\n    for (const booking of this.bookings.values()) {\n      if (booking.roomId === roomId) {\n        matches.push(booking);\n      }\n    }\n    return matches;\n  }\n\n  createBooking(input: CreateBookingInput): Booking {\n    const [booking] = this.prepareBookings(input, [input.roomId]);\n    return this.saveBooking(booking);\n  }\n\n  createGroupBookings(input: CreateGroupBookingInput): { groupId: string; bookings: Booking[] } {\n    const { roomIds, discountBps, customerId, startMinute, endMinute, nowMinute = 0 } = input;\n    if (!Array.isArray(roomIds) || roomIds.length < 2) {\n      throw new ValidationError(\"A group booking requires at least two rooms\");\n    }\n    if (new Set(roomIds).size !== roomIds.length) {\n      throw new ValidationError(\"A group booking cannot have duplicate room IDs\");\n    }\n    validateBasisPoints(discountBps, \"discountBps\");\n\n    const prepared = this.prepareBookings({ customerId, startMinute, endMinute, nowMinute }, roomIds, discountBps);\n    const groupId = this.nextId(\"grp\");\n    const bookings = prepared.map((booking) => this.saveBooking({ ...booking, groupId }));\n    return { groupId, bookings };\n  }\n\n  private prepareBookings(\n    input: Omit<CreateBookingInput, \"roomId\">,\n    roomIds: readonly string[],\n    discountBps = 0,\n  ): Omit<Booking, \"bookingId\">[] {\n    if (typeof input.customerId !== \"string\" || input.customerId.trim() === \"\") {\n      throw new ValidationError(\"customerId must be a non-empty string\");\n    }\n    validateNonNegativeInt(input.startMinute, \"startMinute\");\n    validatePositiveInt(input.endMinute, \"endMinute\");\n    if (input.endMinute <= input.startMinute) {\n      throw new ValidationError(\"endMinute must be strictly greater than startMinute\");\n    }\n    const rooms = Array.from(roomIds, (roomId) => this.getRoom(roomId));\n    const { nowMinute = 0, holdMinutes, legacyDepositMode = false } = input;\n    if (holdMinutes !== undefined) {\n      validatePositiveInt(holdMinutes, \"holdMinutes\");\n      if (holdMinutes > this.config.maxHoldMinutes) {\n        throw new ValidationError(\"holdMinutes cannot exceed maxHoldMinutes\");\n      }\n    }\n    const requestedRooms = new Set(rooms.map((room) => room.roomId));\n    for (const existing of this.bookings.values()) {\n      if (\n        requestedRooms.has(existing.roomId)\n        && isBookingActiveAt(existing, nowMinute)\n        && slotsOverlap(input.startMinute, input.endMinute, existing.startMinute, existing.endMinute)\n      ) {\n        throw new ConflictError(`Room ${existing.roomId} is already booked for part of the requested slot`);\n      }\n    }\n    const duration = input.endMinute - input.startMinute;\n    const customerId = input.customerId.trim();\n    return rooms.map((room) => ({\n      roomId: room.roomId,\n      customerId,\n      startMinute: input.startMinute,\n      endMinute: input.endMinute,\n      ...(holdMinutes === undefined\n        ? { status: \"confirmed\" }\n        : { status: \"held\", expiresAt: nowMinute + holdMinutes }),\n      ...calculateBookingPrice(room, duration, { legacyDepositMode, discountBps }),\n    }));\n  }\n\n  private saveBooking(details: Omit<Booking, \"bookingId\">): Booking {\n    const booking: Booking = { bookingId: this.nextId(\"bkg\"), ...details };\n    this.bookings.set(booking.bookingId, booking);\n    return booking;\n  }\n\n  confirmHold(bookingId: string, nowMinute: number): Booking {\n    const booking = this.getBooking(bookingId);\n    if (booking.status !== \"held\" || !isBookingActiveAt(booking, nowMinute)) {\n      throw new ValidationError(`Booking ${bookingId} is not an active hold`);\n    }\