+test("invalid group inputs are rejected without saving any bookings", () => {
+  const service = setup();
+  const sparseRoomIds = ["a"];
+  sparseRoomIds.length = 2;
+  for (const roomIds of [[], ["a"], ["a", "a"], ["a", "missing"], sparseRoomIds]) {
+    assert.throws(() => createGroupBooking(service, { ...input, roomIds }), ValidationError);
+  }
+  for (const rate of [-1, 0.5, 10001, NaN, Infinity]) {
