+test("a conflict in the last room leaves all rooms unchanged and the request can retry at hold expiry", () => {
+  const service = setup();
+  const hold = service.createBooking({
+    roomId: "b", customerId: "other", startMinute: 89, endMinute: 120, nowMinute: 10, holdMinutes: 5,
