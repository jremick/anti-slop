+    subtotalCents: 25, discountCents: 26, taxCents: 13, totalCents: 38,
+  });
+  assert.deepEqual(applyDiscountAndTax(51, 0, 10000), {
+    subtotalCents: 51, discountCents: 0, taxCents: 51, totalCents: 102,
+  });
+  assert.deepEqual(applyDiscountAndTax(51, 10000, 10000), {
+    subtotalCents: 0, discountCents: 51, taxCents: 0, totalCents: 0,
+  });
+  assert.deepEqual(applyDiscountAndTax(Number.MAX_SAFE_INTEGER, 0, 10000), {
+    subtotalCents: Number.MAX_SAFE_INTEGER,
+    discountCents: 0,
+    taxCents: Number.MAX_SAFE_INTEGER,
+    totalCents: 2 * Number.MAX_SAFE_INTEGER,
+  });
+  assert.deepEqual(calculateBookingPrice(roomA, 30, { discountBps: 5000, legacyDepositMode: true }), {
+    subtotalCents: 25, discountCents: 26, taxCents: 13, totalCents: 38, depositCents: 6,
+  });
+});
+
+test("group pricing applies each room's rate, discount rounding, and tax before summing", () => {
+  const service = setup();
+  const group = createGroupBooking(service, input);
+  assert.ok(group.groupId);
+  assert.deepEqual(group.bookings.map((booking) => booking.roomId), ["a", "b"]);
+  assert.notEqual(group.bookings[0].bookingId, group.bookings[1].bookingId);
+  for (const booking of group.bookings) {
+    assert.equal(booking.groupId, group.groupId);
+    assert.equal(booking.status, "confirmed");
+    assert.equal(booking.customerId, "customer");
+    assert.equal(booking.startMinute, 60);
+    assert.equal(booking.endMinute, 90);
+    assert.deepEqual(service.getBooking(booking.bookingId), booking);
+    assert.deepEqual(service.listRoomBookings(booking.roomId), [booking]);
+  }
+  assert.deepEqual(group.bookings.map(({ subtotalCents, discountCents, taxCents, totalCents }) =>
+    [subtotalCents, discountCents, taxCents, totalCents]), [[25, 26, 13, 38], [75, 76, 9, 84]]);
+  assert.equal(group.subtotalCents, 100);
+  assert.equal(group.discountCents, 102);
+  assert.equal(group.taxCents, 22);
+  assert.equal(group.totalCents, 122);
+
+  const adjacent = createGroupBooking(service, { ...input, startMinute: 90, endMinute: 120 });
+  assert.notEqual(adjacent.groupId, group.groupId);
