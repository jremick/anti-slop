+  const group = createGroupBooking(service, { ...input, nowMinute: 15 });
+  assert.deepEqual(service.listRoomBookings("a"), [group.bookings[0]]);
+  assert.deepEqual(service.listRoomBookings("b"), [hold, group.bookings[1]]);
+  assert.throws(() => service.createBooking({
+    roomId: "a", customerId: "other", startMinute: 60, endMinute: 90, nowMinute: 16,
