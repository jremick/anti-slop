+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConfigError,
+  ConflictError,
+  ValidationError,
+  computeCancellationRefund,
+  isBookingActiveAt,
+  loadCancellationFeeConfig,
+  selectCancellationFeeBps,
+} from "../src/index.ts";
+
+const configKey = "BOOKING_CANCEL_FEE_TIERS_JSON";
+const tiers = { cutoffMinutes: 20, earlyFeeBps: 2500, lateFeeBps: 7500 };
+const slot = { roomId: "a", customerId: "customer", startMinute: 60, endMinute: 120 };
+
+function setup(env: Record<string, string | undefined> = { [configKey]: JSON.stringify(tiers) }) {
+  const service = new BookingService({ env });
+  service.registerRoom({ roomId: "a", name: "Room A", hourlyRateCents: 101, taxBps: 100 });
+  return service;
+}
+
+test("fee configuration selects the early tier at and above the cutoff", () => {
+  const config = loadCancellationFeeConfig({ [configKey]: JSON.stringify(tiers) });
+  assert.deepEqual(config, tiers);
+  assert.equal(selectCancellationFeeBps(21, config), 2500);
+  assert.equal(selectCancellationFeeBps(20, config), 2500);
+  assert.equal(selectCancellationFeeBps(19, config), 7500);
+  const zeroCutoff = { cutoffMinutes: 0, earlyFeeBps: 0, lateFeeBps: 10000 };
+  assert.deepEqual(loadCancellationFeeConfig({ [configKey]: JSON.stringify(zeroCutoff) }), zeroCutoff);
+});
+
+test("refund rounds the fee half up and subtracts it from the original total", () => {
+  assert.deepEqual(computeCancellationRefund(102, 2500), { feeCents: 26, refundCents: 76 });
+  assert.deepEqual(computeCancellationRefund(101, 2500), { feeCents: 25, refundCents: 76 });
+  assert.deepEqual(computeCancellationRefund(103, 2500), { feeCents: 26, refundCents: 77 });
+  assert.deepEqual(computeCancellationRefund(102, 0), { feeCents: 0, refundCents: 102 });
+  assert.deepEqual(computeCancellationRefund(Number.MAX_SAFE_INTEGER, 10000), {
+    feeCents: Number.MAX_SAFE_INTEGER, refundCents: 0,
+  });
+  for (const invalid of [-1, 0.5, 10001, NaN, Infinity]) {
+    assert.throws(() => computeCancellationRefund(102, invalid), ValidationError);
+  }
+  assert.throws(() => computeCancellationRefund(-1, 2500), ValidationError);
+});
+
+test("cancellation applies the correct tier, including at the cutoff and start", () => {
+  for (const [nowMinute, feeBps, feeCents, refundCents] of [
+    [39, 2500, 26, 76],
+    [40, 2500, 26, 76],
+    [41, 7500, 77, 25],
+    [60, 7500, 77, 25],
+  ]) {
+    const service = setup();
+    const booking = service.createBooking({ ...slot, legacyDepositMode: true });
+    assert.equal(booking.totalCents, 102);
+    assert.deepEqual(service.cancelBooking(booking.bookingId, nowMinute), {
+      booking: { ...booking, status: "cancelled" }, feeBps, feeCents, refundCents,
+    });
+  }
+});
+
+test("missing or malformed fee configuration leaves the booking and its slot intact", () => {
+  const invalidConfigs = [
+    undefined, "", "   ", "{", "null", "[]", "false", "42", '"tiers"', "{}",
+    JSON.stringify({ ...tiers, cutoffMinutes: -1 }),
+    JSON.stringify({ ...tiers, cutoffMinutes: 1.5 }),
+    JSON.stringify({ ...tiers, cutoffMinutes: "20" }),
+    JSON.stringify({ ...tiers, earlyFeeBps: -1 }),
+    JSON.stringify({ ...tiers, earlyFeeBps: 0.5 }),
+    JSON.stringify({ ...tiers, earlyFeeBps: "2500" }),
+    JSON.stringify({ ...tiers, lateFeeBps: 10001 }),
+    JSON.stringify({ ...tiers, lateFeeBps: null }),
+    JSON.stringify({ cutoffMinutes: 20, earlyFeeBps: 2500 }),
+  ];
+  for (const raw of invalidConfigs) {
+    const env = raw === undefined ? {} : { [configKey]: raw };
+    assert.throws(() => loadCancellationFeeConfig(env), ConfigError);
+    const service = setup(env);
+    const booking = service.createBooking(slot);
+    assert.throws(() => service.cancelBooking(booking.bookingId, 40), ConfigError);
+    assert.equal(service.getBooking(booking.bookingId).status, "confirmed");
+    assert.deepEqual(service.listRoomBookings("a"), [booking]);
+    assert.throws(() => service.createBooking({ ...slot, nowMinute: 40 }), ConflictError);
+  }
+});
+
+test("invalid cancellations preserve state and a successful retry frees the slot immediately", () => {
+  const env: Record<string, string | undefined> = {};
+  const service = setup(env);
+  const hold = service.createBooking({ ...slot, nowMinute: 35, holdMinutes: 10 });
+  assert.throws(() => service.cancelBooking("unknown", 40), ValidationError);
+  assert.throws(() => service.cancelBooking(hold.bookingId, 61), ValidationError);
+  assert.throws(() => service.cancelBooking(hold.bookingId, 40), ConfigError);
+  assert.equal(service.getBooking(hold.bookingId).status, "held");
+
+  env[configKey] = JSON.stringify(tiers);
+  const { booking } = service.cancelBooking(hold.bookingId, 40);
+  assert.equal(booking.status, "cancelled");
+  assert.equal(isBookingActiveAt(booking, 40), false);
+  assert.equal(service.getBooking(hold.bookingId), booking);
+  assert.throws(() => service.cancelBooking(hold.bookingId, 40), ValidationError);
+  assert.throws(() => service.confirmHold(hold.bookingId, 40), ValidationError);
+  const replacement = service.createBooking({ ...slot, nowMinute: 40 });
+  assert.deepEqual(service.listRoomBookings("a"), [booking, replacement]);
+});
