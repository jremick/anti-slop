+function readCancellationFeeBps(value: unknown, fieldName: string): number {
+  if (typeof value !== "number" || !Number.isInteger(value) || value < 0 || value > 10000) {
+    throw new ConfigError(`${CANCELLATION_TIERS_KEY}.${fieldName} must be an integer from 0 to 10000`);
+  }
+  return value;
+}
+
+export function loadCancellationFeeConfig(env: BookingEnv = resolveBookingEnv()): CancellationFeeConfig {
+  const rawTiers = env[CANCELLATION_TIERS_KEY];
+  if (rawTiers === undefined || rawTiers.trim() === "") {
+    throw new ConfigError(`${CANCELLATION_TIERS_KEY} is required`);
+  }
+
+  let tiers: unknown;
+  try {
+    tiers = JSON.parse(rawTiers);
+  } catch {
+    throw new ConfigError(`${CANCELLATION_TIERS_KEY} must contain valid JSON`);
+  }
+  if (typeof tiers !== "object" || tiers === null || Array.isArray(tiers)) {
+    throw new ConfigError(`${CANCELLATION_TIERS_KEY} must be a JSON object`);
+  }
+
+  const { cutoffMinutes, earlyFeeBps, lateFeeBps } = tiers as Record<string, unknown>;
+  if (typeof cutoffMinutes !== "number" || !Number.isInteger(cutoffMinutes) || cutoffMinutes < 0) {
+    throw new ConfigError(`${CANCELLATION_TIERS_KEY}.cutoffMinutes must be a non-negative integer`);
+  }
+  return {
+    cutoffMinutes,
+    earlyFeeBps: readCancellationFeeBps(earlyFeeBps, "earlyFeeBps"),
+    lateFeeBps: readCancellationFeeBps(lateFeeBps, "lateFeeBps"),
+  };
+}
+
+export function selectCancellationFeeBps(minutesBeforeStart: number, cfg: CancellationFeeConfig): number {
+  return minutesBeforeStart >= cfg.cutoffMinutes ? cfg.earlyFeeBps : cfg.lateFeeBps;
+}

