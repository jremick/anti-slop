+import test from "node:test";
+import assert from "node:assert/strict";
+import { BookingService, ConflictError, ValidationError, createGroupBooking } from "../src/index.ts";
+import type { BookingNotification } from "../src/index.ts";
+
+const slot = { roomId: "conf_a", customerId: " cust_1 ", startMinute: 60, endMinute: 120 };
+const groupInput = {
+  roomIds: ["conf_a", "conf_b"], customerId: "corp_1", startMinute: 120, endMinute: 180,
+  discountBps: 5000,
+};
+
+function createService(notifyHook: (event: BookingNotification) => void): BookingService {
+  const service = new BookingService({
+    env: { BOOKING_CANCEL_FEE_TIERS_JSON: '{"cutoffMinutes":30,"earlyFeeBps":5000,"lateFeeBps":7500}' },
+    notifyHook,
+  });
+  service.registerRoom({ roomId: "conf_a", name: "Conference A", hourlyRateCents: 100, taxBps: 100 });
+  service.registerRoom({ roomId: "conf_b", name: "Conference B", hourlyRateCents: 200, taxBps: 5000 });
+  return service;
+}
+
+test("notifications include the exact creation totals and cancellation refund", () => {
+  const events: BookingNotification[] = [];
+  const service = createService((event) => { events.push(event); });
+  const hold = service.createBooking({ ...slot, holdMinutes: 10 });
+  service.confirmHold(hold.bookingId, 5);
+  const group = createGroupBooking(service, groupInput);
+  service.cancelBooking(hold.bookingId, 30);
+
+  assert.deepEqual(events, [
+    {
+      event: "booking_created", bookingId: hold.bookingId, roomId: "conf_a",
+      customerId: "cust_1", amountCents: 101,
+    },
+    {
+      event: "booking_created", bookingId: group.bookings[0].bookingId, roomId: "conf_a",
+      customerId: "corp_1", amountCents: 51,
+    },
+    {
+      event: "booking_created", bookingId: group.bookings[1].bookingId, roomId: "conf_b",
+      customerId: "corp_1", amountCents: 150,
+    },
+    {
+      event: "booking_cancelled", bookingId: hold.bookingId, roomId: "conf_a",
+      customerId: "cust_1", amountCents: 50,
+    },
+  ]);
+});
+
+test("a creation hook error propagates and the slot remains available for retry", () => {
+  const failure = new Error("creation hook failed");
+  const attempts: BookingNotification[] = [];
+  const service = createService((event) => {
+    attempts.push(event);
+    if (attempts.length === 1) {
+      throw failure;
+    }
+  });
+
+  assert.throws(() => service.createBooking(slot), (error) => error === failure);
+  assert.deepEqual(service.listRoomBookings(slot.roomId), []);
+  assert.equal(attempts.length, 1);
+  const failedBookingId = attempts[0].bookingId;
+  assert.throws(() => service.getBooking(failedBookingId), ValidationError);
+  const booking = service.createBooking(slot);
+  assert.deepEqual(service.listRoomBookings(slot.roomId), [booking]);
+});
+
+test("a hook error on the second group room leaves every group booking uncommitted", () => {
+  const failure = new Error("second room hook failed");
+  const attempts: BookingNotification[] = [];
+  const service: BookingService = createService((event) => {
+    attempts.push(event);
+    assert.deepEqual(service.listRoomBookings("conf_a"), []);
+    assert.deepEqual(service.listRoomBookings("conf_b"), []);
+    if (event.roomId === "conf_b" && attempts.length === 2) {
+      throw failure;
+    }
+  });
+
+  assert.throws(() => createGroupBooking(service, groupInput), (error) => error === failure);
+  assert.deepEqual(attempts.map((event) => event.roomId), ["conf_a", "conf_b"]);
+  assert.deepEqual(service.listRoomBookings("conf_a"), []);
+  assert.deepEqual(service.listRoomBookings("conf_b"), []);
+  for (const { bookingId } of attempts) {
+    assert.throws(() => service.getBooking(bookingId), ValidationError);
+  }
+  assert.equal(createGroupBooking(service, groupInput).bookings.length, 2);
+});
+
+test("a cancellation hook error leaves the booking active until a retry succeeds", () => {
+  const failure = new Error("cancellation hook failed");
+  let cancellationAttempts = 0;
+  const service: BookingService = createService((event) => {
+    if (event.event === "booking_cancelled") {
+      assert.equal(service.getBooking(event.bookingId).status, "confirmed");
+      cancellationAttempts += 1;
+      if (cancellationAttempts === 1) {
+        throw failure;
+      }
+    }
+  });
+  const booking = service.createBooking(slot);
+
+  assert.throws(() => service.cancelBooking(booking.bookingId, 30), (error) => error === failure);
+  assert.deepEqual(service.getBooking(booking.bookingId), { ...booking, status: "confirmed" });
+  assert.throws(() => service.createBooking(slot), ConflictError);
+  assert.equal(service.cancelBooking(booking.bookingId, 30).booking.status, "cancelled");
+  assert.equal(service.createBooking(slot).status, "confirmed");
+});
+
+test("a notification hook cannot write bookings while the current operation is staged", () => {
+  const service: BookingService = createService(() => {
+    service.createBooking(slot);
+  });
+
+  assert.throws(() => service.createBooking(slot), {
+    name: "ValidationError", message: "Bookings cannot be changed from a notification hook",
+  });
+  assert.deepEqual(service.listRoomBookings(slot.roomId), []);
+});

