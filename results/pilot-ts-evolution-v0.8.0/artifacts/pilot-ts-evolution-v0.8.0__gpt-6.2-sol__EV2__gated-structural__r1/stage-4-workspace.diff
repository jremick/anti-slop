+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConfigError,
+  ConflictError,
+  ValidationError,
+  computeCancellationRefund,
+  isBookingActiveAt,
+  loadCancellationFeeConfig,
+  selectCancellationFeeBps,
+} from "../src/index.ts";
+
+const tiers = { cutoffMinutes: 30, earlyFeeBps: 5000, lateFeeBps: 7500 };
+const slot = { roomId: "conf_a", customerId: "cust_1", startMinute: 120, endMinute: 180 };
+
+function createService(env: Record<string, string | undefined>): BookingService {
+  const service = new BookingService({ env });
+  service.registerRoom({ roomId: slot.roomId, name: "Conference A", hourlyRateCents: 100, taxBps: 100 });
+  return service;
+}
+
+test("cancellation policy includes the cutoff in the early tier and accepts zero and full fees", () => {
+  const cfg = loadCancellationFeeConfig({
+    BOOKING_CANCEL_FEE_TIERS_JSON: '{"cutoffMinutes":0,"earlyFeeBps":0,"lateFeeBps":10000}',
+  });
+  assert.deepEqual(cfg, { cutoffMinutes: 0, earlyFeeBps: 0, lateFeeBps: 10000 });
+  assert.equal(selectCancellationFeeBps(0, cfg), 0);
+  assert.equal(selectCancellationFeeBps(-1, cfg), 10000);
+});
+
+test("cancellation applies the right tier to the tax-inclusive total and frees the slot", () => {
+  const cases = [
+    { nowMinute: 89, feeBps: 5000, feeCents: 51, refundCents: 50 },
+    { nowMinute: 90, feeBps: 5000, feeCents: 51, refundCents: 50 },
+    { nowMinute: 91, feeBps: 7500, feeCents: 76, refundCents: 25 },
+    { nowMinute: 120, feeBps: 7500, feeCents: 76, refundCents: 25 },
+  ];
+  for (const { nowMinute, ...expectedRefund } of cases) {
+    const service = createService({ BOOKING_CANCEL_FEE_TIERS_JSON: JSON.stringify(tiers) });
+    const booking = service.createBooking(slot);
+    assert.equal(booking.totalCents, 101);
+    assert.throws(() => service.createBooking({ ...slot, nowMinute }), ConflictError);
+
+    const result = service.cancelBooking(booking.bookingId, nowMinute);
+    assert.deepEqual(result, { booking: { ...booking, status: "cancelled" }, ...expectedRefund });
+    assert.deepEqual(service.getBooking(booking.bookingId), result.booking);
+    assert.equal(isBookingActiveAt(result.booking, nowMinute), false);
+    assert.throws(() => service.cancelBooking(booking.bookingId, nowMinute), ValidationError);
+    assert.equal(service.createBooking({ ...slot, nowMinute }).status, "confirmed");
+  }
+});
+
+test("missing or invalid policy makes cancellation fail closed and keeps the slot blocked", () => {
+  const invalidPolicies = [
+    undefined, "", " \t", "{", "null", "[]", "42", '"fee"', "{}",
