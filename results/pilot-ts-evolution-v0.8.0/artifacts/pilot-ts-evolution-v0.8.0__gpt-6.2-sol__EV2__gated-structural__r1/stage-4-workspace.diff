+import test from "node:test";
+import assert from "node:assert/strict";
+import { ValidationError, applyDiscountAndTax, calculateBookingPrice, roundHalfUpDiv } from "../src/index.ts";
+import * as publicApi from "../src/index.ts";
+import * as pricing from "../src/pricing.ts";
+
+const room = { roomId: "conf_a", name: "Conference A", hourlyRateCents: 90, taxBps: 2500 };
+
+test("the pricing module and public API have no deposit exports", () => {
+  assert.deepEqual(Object.keys(pricing).filter((name) => /deposit/i.test(name)), []);
+  assert.deepEqual(Object.keys(publicApi).filter((name) => /deposit/i.test(name)), []);
+});
+
+test("roundHalfUpDiv rounds below, at, and above half, including odd divisors", () => {
+  assert.equal(roundHalfUpDiv(0, 60), 0);
+  assert.equal(roundHalfUpDiv(89, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2);
+  assert.equal(roundHalfUpDiv(91, 60), 2);
+  assert.equal(roundHalfUpDiv(4, 3), 1);
+  assert.equal(roundHalfUpDiv(5, 3), 2);
+});
+
+test("roundHalfUpDiv rejects invalid numerators and denominators", () => {
+  for (const value of [-1, 0.5, NaN, Infinity]) {
+    assert.throws(() => roundHalfUpDiv(value, 60), ValidationError);
+    assert.throws(() => roundHalfUpDiv(60, value), ValidationError);
+  }
+  assert.throws(() => roundHalfUpDiv(60, 0), ValidationError);
+});
+
+test("partial-hour pricing rounds the subtotal before computing tax", () => {
+  assert.deepEqual(calculateBookingPrice(room, 1), {
+    subtotalCents: 2,
+    discountCents: 0,
+    taxCents: 1,
+    totalCents: 3,
+  });
+  assert.equal(calculateBookingPrice(room, 61).subtotalCents, 92);
+  assert.equal(calculateBookingPrice({ ...room, hourlyRateCents: 89 }, 1).subtotalCents, 1);
+});
+
+test("booking prices require a positive integer duration", () => {
+  for (const durationMinutes of [-1, 0, 1.5, NaN, Infinity]) {
+    assert.throws(() => calculateBookingPrice(room, durationMinutes), ValidationError);
+  }
+});
+
+test("applyDiscountAndTax rounds half-cent discounts up and taxes the net subtotal", () => {
+  assert.deepEqual(applyDiscountAndTax(7, 5000, 5000), {
+    subtotalCents: 3, discountCents: 4, taxCents: 2, totalCents: 5,
+  });
+  assert.deepEqual(applyDiscountAndTax(7, 0, 10000), {
+    subtotalCents: 7, discountCents: 0, taxCents: 7, totalCents: 14,
+  });
+  assert.deepEqual(applyDiscountAndTax(7, 10000, 0), {
+    subtotalCents: 0, discountCents: 7, taxCents: 0, totalCents: 0,
+  });
+  assert.deepEqual(calculateBookingPrice(room, 1, { discountBps: 5000 }), {
+    subtotalCents: 1, discountCents: 1, taxCents: 0, totalCents: 1,
+  });
+});
+
+test("applyDiscountAndTax rejects invalid cents and rates", () => {
+  for (const value of [-1, 0.5, NaN, Infinity]) {
+    assert.throws(() => applyDiscountAndTax(value, 0, 0), ValidationError);
+  }
+  for (const bps of [-1, 0.5, 10001, NaN, Infinity]) {
+    assert.throws(() => applyDiscountAndTax(7, bps, 0), ValidationError);
+    assert.throws(() => applyDiscountAndTax(7, 0, bps), ValidationError);
+  }
+});
