{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"sed -n '15,240p' benchmarks/sources/ev2_ts_bookings/src/bookings.ts\"","aggregated_output":"  validatePositiveInt,\n} from \"./pricing.ts\";\nimport type { BookingPriceOptions } from \"./pricing.ts\";\n\nexport interface BookingServiceOptions {\n  readonly env?: Record<string, string | undefined>;\n  readonly notifyHook?: (event: BookingNotification) => void;\n}\n\nexport interface BookingNotification {\n  readonly event: \"booking_created\" | \"booking_cancelled\";\n  readonly bookingId: string;\n  readonly roomId: string;\n  readonly customerId: string;\n  readonly amountCents: number;\n}\n\nexport interface CancelBookingResult {\n  readonly booking: Booking;\n  readonly feeBps: number;\n  readonly feeCents: number;\n  readonly refundCents: number;\n}\n\nexport function slotsOverlap(startA: number, endA: number, startB: number, endB: number): boolean {\n  return startA < endB && startB < endA;\n}\n\nexport function isBookingActiveAt(booking: Booking, nowMinute: number): boolean {\n  return booking.status === \"confirmed\" || (\n    booking.status === \"held\" && booking.expiresAt !== undefined && nowMinute < booking.expiresAt\n  );\n}\n\nexport class BookingService {\n  readonly config: BookingConfig;\n  private readonly env: Record<string, string | undefined>;\n  private readonly notifyHook: BookingServiceOptions[\"notifyHook\"];\n  private readonly rooms: Map<string, Room> = new Map();\n  private readonly bookings: Map<string, Booking> = new Map();\n  private notifying = false;\n  private seq = 0;\n\n  constructor(options: BookingServiceOptions = {}) {\n    this.env = resolveBookingEnv(options.env);\n    this.config = loadBookingConfig(this.env);\n    this.notifyHook = options.notifyHook;\n  }\n\n  private nextId(prefix: string): string {\n    this.seq += 1;\n    return `${prefix}_${String(this.seq).padStart(4, \"0\")}`;\n  }\n\n  registerRoom(room: Room): void {\n    if (typeof room.roomId !== \"string\" || room.roomId.trim() === \"\") {\n      throw new ValidationError(\"roomId must be a non-empty string\");\n    }\n    if (typeof room.name !== \"string\" || room.name.trim() === \"\") {\n      throw new ValidationError(\"name must be a non-empty string\");\n    }\n    validatePositiveInt(room.hourlyRateCents, \"hourlyRateCents\");\n    validateBasisPoints(room.taxBps, \"taxBps\");\n    this.rooms.set(room.roomId, room);\n  }\n\n  getRoom(roomId: string): Room {\n    const room = this.rooms.get(roomId);\n    if (room === undefined) {\n      throw new ValidationError(`Unknown roomId: ${roomId}`);\n    }\n    return room;\n  }\n\n  getBooking(bookingId: string): Booking {\n    const booking = this.bookings.get(bookingId);\n    if (booking === undefined) {\n      throw new ValidationError(`Unknown bookingId: ${bookingId}`);\n    }\n    return booking;\n  }\n\n  listRoomBookings(roomId: string): Booking[] {\n    this.getRoom(roomId);\n    const matches: Booking[] = [];\n    for (const booking of this.bookings.values()) {\n      if (booking.roomId === roomId) {\n        matches.push(booking);\n      }\n    }\n    return matches;\n  }\n\n  createBooking(input: CreateBookingInput): Booking {\n    this.assertBookingMutationAllowed();\n    const { nowMinute = 0, holdMinutes } = input;\n    if (holdMinutes !== undefined) {\n      validatePositiveInt(holdMinutes, \"holdMinutes\");\n      if (holdMinutes > this.config.maxHoldMinutes) {\n        throw new ValidationError(`holdMinutes cannot exceed ${this.config.maxHoldMinutes}`);\n      }\n    }\n    const expiresAt = holdMinutes === undefined ? undefined : nowMinute + holdMinutes;\n    const prepared = this.prepareBookings(input, [input.roomId], {}, expiresAt);\n    const [booking] = this.commitNewBookings(prepared);\n    return booking;\n  }\n\n  createGroupBookings(input: CreateGroupBookingInput): { groupId: string; bookings: Booking[] } {\n    this.assertBookingMutationAllowed();\n    if (!Array.isArray(input.roomIds) || input.roomIds.length < 2) {\n      throw new ValidationError(\"A group booking requires at least two rooms\");\n    }\n    validateBasisPoints(input.discountBps, \"discountBps\");\n    const prepared = this.prepareBookings(input, input.roomIds, { discountBps: input.discountBps });\n    const groupId = this.nextId(\"grp\");\n    const bookings = this.commitNewBookings(prepared.map((details) => ({ ...details, groupId })));\n    return { groupId, bookings };\n  }\n\n  private prepareBookings(\n    input: Pick<CreateBookingInput, \"customerId\" | \"startMinute\" | \"endMinute\" | \"nowMinute\">,\n    roomIds: readonly string[],\n    priceOptions: BookingPriceOptions,\n    expiresAt?: number,\n  ): Omit<Booking, \"bookingId\">[] {\n    const { customerId, startMinute, endMinute, nowMinute = 0 } = input;\n    if (typeof customerId !== \"string\" || customerId.trim() === \"\") {\n      throw new ValidationError(\"customerId must be a non-empty string\");\n    }\n    validateNonNegativeInt(startMinute, \"startMinute\");\n    validatePositiveInt(endMinute, \"endMinute\");\n    if (endMinute <= startMinute) {\n      throw new ValidationError(\"endMinute must be strictly greater than startMinute\");\n    }\n\n    const requestedRooms = new Set(roomIds);\n    if (requestedRooms.size !== roomIds.length) {\n      throw new ValidationError(\"roomIds must be unique\");\n    }\n    const rooms = Array.from(requestedRooms, (roomId) => this.getRoom(roomId));\n\n    for (const booking of this.bookings.values()) {\n      if (\n        requestedRooms.has(booking.roomId) &&\n        isBookingActiveAt(booking, nowMinute) &&\n        slotsOverlap(booking.startMinute, booking.endMinute, startMinute, endMinute)\n      ) {\n        throw new ConflictError(`Booking overlaps ${booking.bookingId} in room ${booking.roomId}`);\n      }\n    }\n\n    const duration = endMinute - startMinute;\n    const trimmedCustomerId = customerId.trim();\n    return rooms.map((room) => ({\n      roomId: room.roomId,\n      customerId: trimmedCustomerId,\n      startMinute,\n      endMinute,\n      status: expiresAt === undefined ? \"confirmed\" : \"held\",\n      ...(expiresAt === undefined ? {} : { expiresAt }),\n      ...calculateBookingPrice(room, duration, priceOptions),\n    }));\n  }\n\n  private commitNewBookings(prepared: readonly Omit<Booking, \"bookingId\">[]): Booking[] {\n    const bookings = prepared.map((details) => ({ bookingId: this.nextId(\"bkg\"), ...details }));\n    for (const booking of bookings) {\n      this.notify(\"booking_created\", booking, booking.totalCents);\n    }\n    for (const booking of bookings) {\n      this.bookings.set(booking.bookingId, booking);\n    }\n    return bookings;\n  }\n\n  private assertBookingMutationAllowed(): void {\n    if (this.notifying) {\n      throw new ValidationError(\"Bookings cannot be changed from a notification hook\");\n    }\n  }\n\n  private notify(event: BookingNotification[\"event\"], booking: Booking, amountCents: number): void {\n    if (this.notifyHook === undefined) {\n      return;\n    }\n    const { bookingId, roomId, customerId } = booking;\n    this.notifying = true;\n    try {\n      this.notifyHook({ event, bookingId, roomId, customerId, amountCents });\n    } finally {\n      this.notifying = false;\n    }\n  }\n\n  confirmHold(bookingId: string, nowMinute: number): Booking {\n    this.assertBookingMutationAllowed();\n    const booking = this.getBooking(bookingId);\n    if (booking.status !== \"held\") {\n      throw new ValidationError(`Booking ${bookingId} is not held`);\n    }\n    if (!isBookingActiveAt(booking, nowMinute)) {\n      throw new ValidationError(`Hold ${bookingId} has expired`);\n    }\n\n    const { expiresAt, ...details } = booking;\n    const confirmed: Booking = { ...details, status: \"confirmed\" };\n    this.bookings.set(bookingId, confirmed);\n    return confirmed;\n  }\n\n  cancelBooking(bookingId: string, nowMinute: number): CancelBookingResult {\n    this.assertBookingMutationAllowed();\n    const booking = this.getBooking(bookingId);\n    if (booking.status === \"cancelled\") {\n      throw new ValidationError(`Booking ${bookingId} is already cancelled`);\n    }\n    if (nowMinute > booking.startMinute) {\n      throw new ValidationError(`Booking ${bookingId} has already started`);\n    }\n\n    const tiers = loadCancellationFeeConfig(this.env);\n    const feeBps = selectCancellationFeeBps(booking.startMinute - nowMinute, tiers);\n    const refund = computeCancellationRefund(booking.totalCents, feeBps);\n    const cancelled: Booking = { ...booking, status: \"cancelled\" };\n    this.notify(\"booking_cancelled\", cancelled, refund.refundCents);\n","exit_code":0,"status":"completed"}}
