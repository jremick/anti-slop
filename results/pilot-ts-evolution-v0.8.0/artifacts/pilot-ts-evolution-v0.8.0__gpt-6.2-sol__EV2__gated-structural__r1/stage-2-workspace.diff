+
+test("roundHalfUpDiv rounds below, at, and above half, including odd divisors", () => {
+  assert.equal(roundHalfUpDiv(0, 60), 0);
+  assert.equal(roundHalfUpDiv(89, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2);
+  assert.equal(roundHalfUpDiv(91, 60), 2);
+  assert.equal(roundHalfUpDiv(4, 3), 1);
+  assert.equal(roundHalfUpDiv(5, 3), 2);
+});
+
+test("roundHalfUpDiv rejects invalid numerators and denominators", () => {
+  for (const value of [-1, 0.5, NaN, Infinity]) {
+    assert.throws(() => roundHalfUpDiv(value, 60), ValidationError);
+    assert.throws(() => roundHalfUpDiv(60, value), ValidationError);
+  }
+  assert.throws(() => roundHalfUpDiv(60, 0), ValidationError);
+});
+
+test("partial-hour pricing rounds the subtotal before computing tax and legacy deposit", () => {
+  assert.deepEqual(calculateBookingPrice(room, 1, { legacyDepositMode: true }), {
+    subtotalCents: 2,
+    discountCents: 0,
+    taxCents: 1,
+    totalCents: 3,
+    depositCents: 1,
+  });
