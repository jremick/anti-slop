+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  isBookingActiveAt,
+  slotsOverlap,
+} from "../src/index.ts";
+
+const room = { roomId: "conf_a", name: "Conference A", hourlyRateCents: 10000, taxBps: 825 };
+const slot = { roomId: room.roomId, customerId: "cust_1", startMinute: 60, endMinute: 90 };
+
+function createService(): BookingService {
+  const service = new BookingService({ env: { BOOKING_MAX_HOLD_MINUTES: "15" } });
+  service.registerRoom(room);
+  return service;
+}
+
+test("slotsOverlap uses half-open intervals in both argument orders", () => {
+  assert.equal(slotsOverlap(60, 90, 89, 120), true);
+  assert.equal(slotsOverlap(89, 120, 60, 90), true);
+  assert.equal(slotsOverlap(60, 90, 65, 70), true);
+  assert.equal(slotsOverlap(60, 90, 60, 90), true);
+  assert.equal(slotsOverlap(60, 90, 90, 120), false);
+  assert.equal(slotsOverlap(90, 120, 60, 90), false);
+  assert.equal(slotsOverlap(60, 90, 91, 120), false);
+});
+
+test("confirmed bookings block overlapping requests only in the same room", () => {
+  const service = createService();
+  service.registerRoom({ ...room, roomId: "conf_b", name: "Conference B" });
+  const booking = service.createBooking(slot);
+
+  assert.equal(isBookingActiveAt(booking, 1000), true);
+  assert.throws(() => service.createBooking({ ...slot, startMinute: 89, endMinute: 120 }), ConflictError);
+  assert.throws(() => service.createBooking({ ...slot, startMinute: 30, endMinute: 61 }), ConflictError);
+  assert.throws(() => service.createBooking({ ...slot, holdMinutes: 1 }), ConflictError);
+  assert.equal(service.listRoomBookings(room.roomId).length, 1);
+  assert.equal(service.createBooking({ ...slot, startMinute: 30, endMinute: 60 }).status, "confirmed");
+  assert.equal(service.createBooking({ ...slot, startMinute: 90, endMinute: 120 }).status, "confirmed");
+  assert.equal(service.createBooking({ ...slot, roomId: "conf_b" }).status, "confirmed");
+});
+
+test("a hold blocks until its expiration minute", () => {
+  const service = createService();
+  const hold = service.createBooking({ ...slot, nowMinute: 10, holdMinutes: 15 });
+
+  assert.equal(hold.status, "held");
+  assert.equal(hold.expiresAt, 25);
+  assert.equal(hold.subtotalCents, 5000);
+  assert.equal(hold.taxCents, 413);
+  assert.equal(isBookingActiveAt(hold, 24), true);
+  assert.equal(isBookingActiveAt(hold, 25), false);
+  assert.equal(isBookingActiveAt({ ...hold, status: "cancelled" }, 24), false);
+  assert.equal(isBookingActiveAt({ ...hold, expiresAt: undefined }, 24), false);
+  assert.throws(() => service.createBooking({ ...slot, nowMinute: 24 }), ConflictError);
+  assert.throws(() => service.confirmHold(hold.bookingId, 25), ValidationError);
+  assert.equal(service.createBooking({ ...slot, nowMinute: 25 }).status, "confirmed");
+});
+
+test("hold durations must be positive integers within the configured limit", () => {
+  const service = createService();
+  for (const holdMinutes of [-1, 0, 0.5, 16, NaN, Infinity]) {
+    assert.throws(() => service.createBooking({ ...slot, holdMinutes }), ValidationError);
+  }
+  assert.equal(service.listRoomBookings(room.roomId).length, 0);
+
+  const hold = service.createBooking({ ...slot, holdMinutes: 1 });
+  assert.equal(hold.expiresAt, 1);
+  assert.throws(() => service.createBooking(slot), ConflictError);
+  assert.equal(service.createBooking({ ...slot, nowMinute: 1 }).status, "confirmed");
+});
+
+test("confirmHold updates the stored booking and it stays active beyond its original expiration", () => {
+  const service = createService();
+  const hold = service.createBooking({ ...slot, holdMinutes: 5 });
+  const confirmed = service.confirmHold(hold.bookingId, 4);
+  const { expiresAt, ...details } = hold;
+
+  assert.deepEqual(confirmed, { ...details, status: "confirmed" });
+  assert.deepEqual(service.getBooking(hold.bookingId), confirmed);
+  assert.throws(() => service.createBooking({ ...slot, nowMinute: 5 }), ConflictError);
+  assert.throws(() => service.confirmHold(hold.bookingId, 4), ValidationError);
+  assert.throws(() => service.confirmHold("missing", 4), ValidationError);
+});

