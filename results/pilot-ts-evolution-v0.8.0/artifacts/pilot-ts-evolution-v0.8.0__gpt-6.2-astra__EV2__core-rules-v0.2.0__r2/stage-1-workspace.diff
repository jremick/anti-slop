+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService, ConflictError, ValidationError, calculateBookingPrice,
+  isBookingActiveAt, roundHalfUpDiv, slotsOverlap,
+} from "../src/index.ts";
+
+const room = { roomId: "A", name: "Studio", hourlyRateCents: 90, taxBps: 2500 };
+const slot = { roomId: room.roomId, customerId: "guest", startMinute: 100, endMinute: 120 };
+
+function service() {
+  const svc = new BookingService({ env: { BOOKING_MAX_HOLD_MINUTES: "5" } });
+  svc.registerRoom(room);
+  return svc;
+}
+
+test("half-up division rounds below, at, and above a tie", () => {
+  for (const [numerator, expected] of [[0, 0], [14, 1], [15, 2], [16, 2]]) {
+    assert.equal(roundHalfUpDiv(numerator, 10), expected);
+  }
+  for (const [n, d] of [[-1, 2], [2.5, 2], [2, 0], [2, -1], [2, 1.5]]) {
+    assert.throws(() => roundHalfUpDiv(n, d), ValidationError);
+  }
+});
+
+test("one minute rounds to two cents before computing tax and legacy deposit", () => {
+  assert.deepEqual(calculateBookingPrice(room, 1, { legacyDepositMode: true }), {
+    subtotalCents: 2, discountCents: 0, taxCents: 1, totalCents: 3, depositCents: 1,
+  });
+  for (const duration of [0, -1, 0.5]) {
+    assert.throws(() => calculateBookingPrice(room, duration), ValidationError);
+  }
+});
+
+test("only overlapping intervals in the same room conflict", () => {
+  const svc = service();
+  svc.createBooking(slot);
+  for (const [startMinute, endMinute] of [[99, 101], [119, 121], [105, 115], [99, 121], [100, 120]]) {
+    assert.equal(slotsOverlap(100, 120, startMinute, endMinute), true);
+    assert.throws(() => svc.createBooking({ ...slot, startMinute, endMinute }), ConflictError);
+  }
+  assert.equal(slotsOverlap(80, 100, 100, 120), false);
+  svc.createBooking({ ...slot, startMinute: 80, endMinute: 100 });
+  svc.createBooking({ ...slot, startMinute: 120, endMinute: 140 });
+  svc.registerRoom({ ...room, roomId: "B" });
+  svc.createBooking({ ...slot, roomId: "B" });
+});
+
+test("a hold releases its slot at the exact expiry minute", () => {
+  const svc = service();
+  const hold = svc.createBooking({ ...slot, nowMinute: 20, holdMinutes: 5 });
+  assert.equal(hold.status, "held");
+  assert.equal(hold.expiresAt, 25);
+  assert.equal(isBookingActiveAt(hold, 24), true);
+  assert.equal(isBookingActiveAt(hold, 25), false);
+  assert.equal(isBookingActiveAt({ ...hold, expiresAt: undefined }, 0), false);
+  assert.equal(isBookingActiveAt({ ...hold, status: "cancelled" }, 20), false);
+  assert.throws(() => svc.createBooking({ ...slot, nowMinute: 24 }), ConflictError);
+  assert.throws(() => svc.confirmHold(hold.bookingId, 25), ValidationError);
+  assert.equal(svc.createBooking({ ...slot, nowMinute: 25 }).status, "confirmed");
+});
+
+test("confirming an active hold preserves the booking beyond its former expiry", () => {
+  const svc = service();
+  const hold = svc.createBooking({ ...slot, holdMinutes: 5 });
+  assert.equal(hold.expiresAt, 5);
+  const confirmed = svc.confirmHold(hold.bookingId, 4);
+  assert.deepEqual({ ...confirmed, expiresAt: undefined }, {
+    ...hold, status: "confirmed", expiresAt: undefined,
+  });
+  assert.equal(confirmed.expiresAt, undefined);
+  assert.deepEqual(svc.getBooking(hold.bookingId), confirmed);
+  assert.throws(() => svc.confirmHold(hold.bookingId, 4), ValidationError);
+  assert.throws(() => svc.confirmHold("unknown", 4), ValidationError);
+  assert.throws(() => svc.createBooking({ ...slot, nowMinute: 5, holdMinutes: 1 }), ConflictError);
+});
+
+test("invalid hold lengths leave the room available", () => {
+  const svc = service();
+  for (const holdMinutes of [0, -1, 1.5, 6]) {
+    assert.throws(() => svc.createBooking({ ...slot, holdMinutes }), ValidationError);
+  }
+  assert.equal(svc.listRoomBookings(room.roomId).length, 0);
+});
