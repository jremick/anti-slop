test(\\\"baseline rejects'):]\ns=s.replace('import test from', 'import * as api from \\\"../src/index.ts\\\";\\\\nimport * as pricing from \\\"../src/pricing.ts\\\";\\\\nimport test from')\np.write_text(s+'''\ntest(\\\"public API and pricing module expose no deposit exports\\\", () => {\n  for (const module of [api, pricing]) {\n    assert.deepEqual(Object.keys(module).filter(name => /deposit/i.test(name)), []);\n  }\n});\n''')\np=Path('tests/holds-and-pricing.test.ts')\np.write_text(p.read_text().replace(' and legacy deposit','').replace(', { legacyDepositMode: true }','').replace(', depositCents: 1',''))\nPY\ncat src/pricing.ts | tail -22\"","aggregated_output":"  const taxCents = computeTaxCents(subtotalCents, taxBps);\n  return { subtotalCents, discountCents, taxCents, totalCents: subtotalCents + taxCents };\n}\n\nexport function calculateBookingPrice(\n  room: Room,\n  durationMinutes: number,\n  options?: { readonly discountBps?: number },\n): PriceBreakdown {\n  validatePositiveInt(room.hourlyRateCents, \"hourlyRateCents\");\n  validatePositiveInt(durationMinutes, \"durationMinutes\");\n  const grossSubtotalCents = roundHalfUpDiv(room.hourlyRateCents * durationMinutes, 60);\n  const { discountBps = 0 } = options ?? {};\n  return applyDiscountAndTax(grossSubtotalCents, discountBps, room.taxBps);\n}\n\nexport function computeCancellationRefund(totalCents: number, feeBps: number) {\n  validateNonNegativeInt(totalCents, \"totalCents\");\n  validateBasisPoints(feeBps, \"feeBps\");\n  const feeCents = roundHalfUpDiv(totalCents * feeBps, 10000);\n  return { feeCents, refundCents: totalCents - feeCents };\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cd benchmarks/sources/ev2_ts_bookings && cat > tests/notifications.test.ts <<'EOF'\nimport assert from \\\"node:assert/strict\\\";\nimport test from \\\"node:test\\\";\nimport { BookingService, ConflictError, ValidationError, createGroupBooking } from \\\"../src/index.ts\\\";\nimport type { BookingNotification } from \\\"../src/index.ts\\\";\n\nconst slot = { customerId: \\\" guest \\\", roomId: \\\"A\\\", startMinute: 60, endMinute: 120 };\nconst group = { ...slot, roomIds: [\\\"A\\\", \\\"B\\\"], discountBps: 5000 };\n\nfunction service(notifyHook: (event: BookingNotification) => void) {\n  const svc = new BookingService({\n    notifyHook,\n    env: { BOOKING_CANCEL_FEE_TIERS_JSON: '{\\\"cutoffMinutes\\\":10,\\\"earlyFeeBps\\\":2500,\\\"lateFeeBps\\\":5000}' },\n  });\n  svc.registerRoom({ roomId: \\\"A\\\", name: \\\"Studio\\\", hourlyRateCents: 100, taxBps: 0 });\n  svc.registerRoom({ roomId: \\\"B\\\", name: \\\"Hall\\\", hourlyRateCents: 200, taxBps: 1000 });\n  return svc;\n}\n\ntest(\\\"notifications report hold creation, cancellation refund and each group's room total\\\", () => {\n  const events: BookingNotification[] = [];\n  const svc = service(event => events.push(event));\n  const hold = svc.createBooking({ ...slot, holdMinutes: 5 });\n  svc.confirmHold(hold.bookingId, 1);\n  svc.cancelBooking(hold.bookingId, 2);\n  const { bookings: [a, b] } = createGroupBooking(svc, group);\n  assert.deepEqual(events, [\n    { event: \\\"booking_created\\\", bookingId: hold.bookingId, roomId: \\\"A\\\", customerId: \\\"guest\\\", amountCents: 100 },\n    { event: \\\"booking_cancelled\\\", bookingId: hold.bookingId, roomId: \\\"A\\\", customerId: \\\"guest\\\", amountCents: 75 },\n    { event: \\\"booking_created\\\", bookingId: a.bookingId, roomId: \\\"A\\\", customerId: \\\"guest\\\", amountCents: 50 },\n    { event: \\\"booking_created\\\", bookingId: b.bookingId, roomId: \\\"B\\\", customerId: \\\"guest\\\", amountCents: 110 },\n  ]);\n});\n\ntest(\\\"a throwing creation hook leaves no booking and permits retry\\\", () => {\n  const error = new Error(\\\"unavailable\\\");\n  let fail = true;\n  const svc = service(() => { if (fail) throw error; });\n  assert.throws(() => svc.createBooking(slot), caught => caught === error);\n  assert.deepEqual(svc.listRoomBookings(\\\"A\\\"), []);\n  fail = false;\n  assert.equal(svc.createBooking(slot).status, \\\"confirmed\\\");\n});\n\ntest(\\\"failure on the second group notification preserves existing bookings and neither new room is reserved\\\", () => {\n  const error = new Error(\\\"second room rejected\\\");\n  let fail = false;\n  const events: BookingNotification[] = [];\n  const svc = service(event => {\n    events.push(event);\n    if (fail && event.roomId === \\\"B\\\") throw error;\n  });\n  const existing = svc.createBooking({ ...slot, startMinute: 0, endMinute: 60 });\n  fail = true;\n  assert.throws(() => createGroupBooking(svc, group), caught => caught === error);\n  assert.deepEqual(events.slice(1).map(e => e.roomId), [\\\"A\\\", \\\"B\\\"]);\n  assert.deepEqual(svc.listRoomBookings(\\\"A\\\"), [existing]);\n  assert.deepEqual(svc.listRoomBookings(\\\"B\\\"), []);\n  fail = false;\n  assert.equal(createGroupBooking(svc, group).bookings.length, 2);\n});\n\ntest(\\\"a throwing cancellation hook keeps the original booking active until a successful retry\\\", () => {\n  const error = new Error(\\\"refund notification failed\\\");\n  let fail = true;\n  const svc = service(event => { if (fail && event.event === \\\"booking_cancelled\\\") throw error; });\n  const hold = svc.createBooking({ ...slot, holdMinutes: 5 });\n  assert.throws(() => svc.cancelBooking(hold.bookingId, 1), caught => caught === error);\n  assert.equal(svc.getBooking(hold.bookingId).status, \\\"held\\\");\n  assert.throws(() => svc.createBooking({ ...slot, nowMinute: 1 }), ConflictError);\n  fail = false;\n  assert.equal(svc.cancelBooking(hold.bookingId, 1).refundCents, 75);\n  assert.equal(svc.createBooking({ ...slot, nowMinute: 1 }).status, \\\"confirmed\\\");\n});\n\ntest(\\\"a hook cannot re-enter creation and double-book an uncommitted slot\\\", () => {\n  const svc = service(() => { svc.createBooking(slot); });\n  assert.throws(() => svc.createBooking(slot), ValidationError);\n  assert.deepEqual(svc.listRoomBookings(\\\"A\\\"), []);\n});\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
