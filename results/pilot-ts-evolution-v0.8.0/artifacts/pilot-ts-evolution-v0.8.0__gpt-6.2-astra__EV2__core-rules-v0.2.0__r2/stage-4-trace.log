oomId: \\\"B\\\", customerId: \\\"guest\\\", amountCents: 110 },\n  ]);\n});\n\ntest(\\\"a throwing creation hook leaves no booking and permits retry\\\", () => {\n  const error = new Error(\\\"unavailable\\\");\n  let fail = true;\n  const svc = service(() => { if (fail) throw error; });\n  assert.throws(() => svc.createBooking(slot), caught => caught === error);\n  assert.deepEqual(svc.listRoomBookings(\\\"A\\\"), []);\n  fail = false;\n  assert.equal(svc.createBooking(slot).status, \\\"confirmed\\\");\n});\n\ntest(\\\"failure on the second group notification preserves existing bookings and neither new room is reserved\\\", () => {\n  const error = new Error(\\\"second room rejected\\\");\n  let fail = false;\n  const events: BookingNotification[] = [];\n  const svc = service(event => {\n    events.push(event);\n    if (fail && event.roomId === \\\"B\\\") throw error;\n  });\n  const existing = svc.createBooking({ ...slot, startMinute: 0, endMinute: 60 });\n  fail = true;\n  assert.throws(() => createGroupBooking(svc, group), caught => caught === error);\n  assert.deepEqual(events.slice(1).map(e => e.roomId), [\\\"A\\\", \\\"B\\\"]);\n  assert.deepEqual(svc.listRoomBookings(\\\"A\\\"), [existing]);\n  assert.deepEqual(svc.listRoomBookings(\\\"B\\\"), []);\n  fail = false;\n  assert.equal(createGroupBooking(svc, group).bookings.length, 2);\n});\n\ntest(\\\"a throwing cancellation hook keeps the original booking active until a successful retry\\\", () => {\n  const error = new Error(\\\"refund notification failed\\\");\n  let fail = true;\n  const svc = service(event => { if (fail && event.event === \\\"booking_cancelled\\\") throw error; });\n  const hold = svc.createBooking({ ...slot, holdMinutes: 5 });\n  assert.throws(() => svc.cancelBooking(hold.bookingId, 1), caught => caught === error);\n  assert.equal(svc.getBooking(hold.bookingId).status, \\\"held\\\");\n  assert.throws(() => svc.createBooking({ ...slot, nowMinute: 1 }), ConflictError);\n  fail = false;\n  assert.equal(svc.cancelBooking(hold.bookingId, 1).refundCents, 75);\n  assert.equal(svc.createBooking({ ...slot, nowMinute: 1 }).status, \\\"confirmed\\\");\n});\n\ntest(\\\"a hook cannot re-enter creation and double-book an uncommitted slot\\\", () => {\n  const svc = service(() => { svc.createBooking(slot); });\n  assert.throws(() => svc.createBooking(slot), ValidationError);\n  assert.deepEqual(svc.listRoomBookings(\\\"A\\\"), []);\n});\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
