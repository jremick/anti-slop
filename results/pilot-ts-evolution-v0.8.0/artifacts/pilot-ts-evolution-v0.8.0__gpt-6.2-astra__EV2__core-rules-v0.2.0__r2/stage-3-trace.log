{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cd benchmarks/sources/ev2_ts_bookings && cat > tests/cancellation.test.ts <<'EOF'\nimport assert from \\\"node:assert/strict\\\";\nimport test from \\\"node:test\\\";\nimport {\n  BookingService, ConfigError, ConflictError, ValidationError, computeCancellationRefund,\n  loadCancellationFeeConfig, selectCancellationFeeBps,\n} from \\\"../src/index.ts\\\";\n\nconst tiers = { cutoffMinutes: 30, earlyFeeBps: 1000, lateFeeBps: 5000 };\nconst slot = { customerId: \\\"guest\\\", roomId: \\\"A\\\", startMinute: 100, endMinute: 160 };\n\nfunction service(env: Record<string, string | undefined>) {\n  const svc = new BookingService({ env });\n  svc.registerRoom({ roomId: \\\"A\\\", name: \\\"Hall\\\", hourlyRateCents: 100, taxBps: 500 });\n  return svc;\n}\n\ntest(\\\"cancellation uses the tax-inclusive total and the early tier through the cutoff\\\", () => {\n  for (const [nowMinute, feeBps, feeCents, refundCents] of [\n    [69, 1000, 11, 94], [70, 1000, 11, 94], [71, 5000, 53, 52], [100, 5000, 53, 52],\n  ]) {\n    const svc = service({ BOOKING_CANCEL_FEE_TIERS_JSON: JSON.stringify(tiers) });\n    const booking = svc.createBooking(slot);\n    const cancelled = { ...booking, status: \\\"cancelled\\\" };\n    assert.deepEqual(svc.cancelBooking(booking.bookingId, nowMinute), {\n      booking: cancelled, feeBps, feeCents, refundCents,\n    });\n    assert.deepEqual(svc.getBooking(booking.bookingId), cancelled);\n    assert.throws(() => svc.cancelBooking(booking.bookingId, nowMinute), ValidationError);\n    assert.equal(svc.createBooking({ ...slot, nowMinute }).status, \\\"confirmed\\\");\n  }\n});\n\ntest(\\\"invalid cancellation configuration preserves the booking and blocks slot reuse\\\", () => {\n  const invalid = [\n    undefined, \\\"\\\", \\\"   \\\", \\\"{\\\", \\\"null\\\", \\\"[]\\\", \\\"true\\\", \\\"42\\\", \\\"{}\\\", '{\\\"cutoffMinutes\\\":0}',\n    ...[\n      { cutoffMinutes: -1 }, { cutoffMinutes: 1.5 }, { cutoffMinutes: \\\"30\\\" },\n      { earlyFeeBps: -1 }, { earlyFeeBps: 10001 }, { earlyFeeBps: 1.5 },\n      { lateFeeBps: -1 }, { lateFeeBps: 10001 }, { lateFeeBps: \\\"0\\\" }, { lateFeeBps: undefined },\n    ].map(change => JSON.stringify({ ...tiers, ...change })),\n  ];\n  for (const raw of invalid) {\n    const env = { BOOKING_CANCEL_FEE_TIERS_JSON: raw };\n    const svc = service(env);\n    const booking = svc.createBooking(slot);\n    assert.throws(() => svc.cancelBooking(booking.bookingId, 50), ConfigError);\n    assert.deepEqual(svc.getBooking(booking.bookingId), { ...booking, status: \\\"confirmed\\\" });\n    assert.throws(() => svc.createBooking(slot), ConflictError);\n    env.BOOKING_CANCEL_FEE_TIERS_JSON = JSON.stringify(tiers);\n    assert.equal(svc.cancelBooking(booking.bookingId, 50).feeBps, tiers.earlyFeeBps);\n  }\n});\n\ntest(\\\"unknown bookings and cancellations after start fail validation before loading tiers\\\", () => {\n  const svc = service({});\n  assert.throws(() => svc.cancelBooking(\\\"missing\\\", 100), ValidationError);\n  const booking = svc.createBooking(slot);\n  assert.throws(() => svc.cancelBooking(booking.bookingId, 101), ValidationError);\n  assert.equal(svc.getBooking(booking.bookingId).status, \\\"confirmed\\\");\n});\n\ntest(\\\"zero and full fees are valid and refund inputs must be in range\\\", () => {\n  const cfg = { cutoffMinutes: 0, earlyFeeBps: 0, lateFeeBps: 10000 };\n  assert.deepEqual(loadCancellationFeeConfig({ BOOKING_CANCEL_FEE_TIERS_JSON: JSON.stringify(cfg) }), cfg);\n  assert.equal(selectCancellationFeeBps(0, cfg), 0);\n  assert.deepEqual(computeCancellationRefund(105, 0), { feeCents: 0, refundCents: 105 });\n  assert.deepEqual(computeCancellationRefund(105, 10000), { feeCents: 105, refundCents: 0 });\n  for (const [total, bps] of [[-1, 0], [0.5, 0], [0, -1], [10, 10001], [10, 1.5]]) {\n    assert.throws(() => computeCancellationRefund(total, bps), ValidationError);\n  }\n});\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
