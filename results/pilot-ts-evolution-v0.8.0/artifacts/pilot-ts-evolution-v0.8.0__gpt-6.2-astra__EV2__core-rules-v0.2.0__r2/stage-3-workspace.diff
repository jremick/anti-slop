+  ]) {
+    const svc = service({ BOOKING_CANCEL_FEE_TIERS_JSON: JSON.stringify(tiers) });
+    const booking = svc.createBooking(slot);
+    const cancelled = { ...booking, status: "cancelled" };
+    assert.deepEqual(svc.cancelBooking(booking.bookingId, nowMinute), {
+      booking: cancelled, feeBps, feeCents, refundCents,
+    });
+    assert.deepEqual(svc.getBooking(booking.bookingId), cancelled);
+    assert.throws(() => svc.cancelBooking(booking.bookingId, nowMinute), ValidationError);
+    assert.equal(svc.createBooking({ ...slot, nowMinute }).status, "confirmed");
+  }
+});
+
+test("invalid cancellation configuration preserves the booking and blocks slot reuse", () => {
