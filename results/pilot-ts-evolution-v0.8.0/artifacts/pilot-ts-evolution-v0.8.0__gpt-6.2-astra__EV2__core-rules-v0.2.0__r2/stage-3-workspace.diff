+      { cutoffMinutes: -1 }, { cutoffMinutes: 1.5 }, { cutoffMinutes: "30" },
+      { earlyFeeBps: -1 }, { earlyFeeBps: 10001 }, { earlyFeeBps: 1.5 },
+      { lateFeeBps: -1 }, { lateFeeBps: 10001 }, { lateFeeBps: "0" }, { lateFeeBps: undefined },
+    ].map(change => JSON.stringify({ ...tiers, ...change })),
+  ];
+  for (const raw of invalid) {
+    const env = { BOOKING_CANCEL_FEE_TIERS_JSON: raw };
+    const svc = service(env);
+    const booking = svc.createBooking(slot);
+    assert.throws(() => svc.cancelBooking(booking.bookingId, 50), ConfigError);
+    assert.deepEqual(svc.getBooking(booking.bookingId), { ...booking, status: "confirmed" });
