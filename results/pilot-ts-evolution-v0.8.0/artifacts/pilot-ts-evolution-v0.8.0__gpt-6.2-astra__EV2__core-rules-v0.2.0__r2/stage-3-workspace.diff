+
+test("group totals sum the individually rounded discounts and room-specific taxes", () => {
+  const svc = service();
+  const { groupId, bookings, ...totals } = createGroupBooking(svc, input);
+  assert.deepEqual(totals, { subtotalCents: 6, discountCents: 8, taxCents: 3, totalCents: 9 });
+  assert.deepEqual(bookings.map(b => [b.roomId, b.subtotalCents, b.discountCents, b.taxCents, b.totalCents]), [
+    ["A", 2, 3, 1, 3],
+    ["B", 4, 5, 2, 6],
