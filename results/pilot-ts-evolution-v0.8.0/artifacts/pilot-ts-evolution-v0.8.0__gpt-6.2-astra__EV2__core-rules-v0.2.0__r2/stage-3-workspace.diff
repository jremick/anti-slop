+  svc.registerRoom({ roomId: "A", name: "Studio", hourlyRateCents: 10, taxBps: 2500 });
+  svc.registerRoom({ roomId: "B", name: "Hall", hourlyRateCents: 18, taxBps: 5000 });
+  return svc;
