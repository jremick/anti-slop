+
+test("confirmHold rejects unknown, non-held and expired bookings", () => {
+  const svc = makeService();
+  assert.throws(() => svc.confirmHold("bkg_9999", 0), ValidationError);
+
+  const confirmed = svc.createBooking({ roomId: "r1", customerId: "a", startMinute: 0, endMinute: 60 });
+  assert.throws(() => svc.confirmHold(confirmed.bookingId, 0), ValidationError);
+
+  const hold = svc.createBooking({
+    roomId: "r2",
+    customerId: "a",
+    startMinute: 0,
+    endMinute: 60,
+    nowMinute: 0,
+    holdMinutes: 5,
+  });
+  assert.throws(() => svc.confirmHold(hold.bookingId, 5), ValidationError);
+  assert.throws(() => svc.confirmHold(hold.bookingId, -1), ValidationError);
+  assert.equal(svc.getBooking(hold.bookingId).status, "held");
+
+  const again = svc.confirmHold(hold.bookingId, 4);
+  assert.throws(() => svc.confirmHold(again.bookingId, 4), ValidationError);
+});

