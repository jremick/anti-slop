+import test from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync, readdirSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  applyDiscountAndTax,
+  calculateBookingPrice,
+  createGroupBooking,
+} from "../src/index.ts";
+import type { GroupBookingInput } from "../src/index.ts";
+
+function makeService(): BookingService {
+  const svc = new BookingService({ env: {} });
+  svc.registerRoom({ roomId: "a", name: "A", hourlyRateCents: 10000, taxBps: 825 });
+  svc.registerRoom({ roomId: "b", name: "B", hourlyRateCents: 4000, taxBps: 0 });
+  svc.registerRoom({ roomId: "c", name: "C", hourlyRateCents: 2500, taxBps: 1000 });
+  return svc;
+}
+
+function totalBookings(svc: BookingService): number {
+  return ["a", "b", "c"].reduce((n, id) => n + svc.listRoomBookings(id).length, 0);
+}
+
+const GROUP: GroupBookingInput = {
+  customerId: "corp_1",
+  roomIds: ["a", "b", "c"],
+  startMinute: 600,
+  endMinute: 690,
+  discountBps: 1500,
+};
+
+// --- applyDiscountAndTax ---------------------------------------------------
+
+test("applyDiscountAndTax discounts then taxes with half-up rounding", () => {
+  assert.deepEqual(applyDiscountAndTax(10000, 0, 825), {
+    subtotalCents: 10000,
+    discountCents: 0,
+    taxCents: 825,
+    totalCents: 10825,
+  });
+  // 3750 * 15% = 562.5 -> 563; tax 10% of 3187 = 318.7 -> 319
+  assert.deepEqual(applyDiscountAndTax(3750, 1500, 1000), {
+    subtotalCents: 3187,
+    discountCents: 563,
+    taxCents: 319,
+    totalCents: 3506,
+  });
+  assert.equal(applyDiscountAndTax(1, 5000, 0).discountCents, 1); // 0.5 -> 1
+  assert.equal(applyDiscountAndTax(1, 4999, 0).discountCents, 0);
+  assert.deepEqual(applyDiscountAndTax(10000, 10000, 825), {
+    subtotalCents: 0,
+    discountCents: 10000,
+    taxCents: 0,
+    totalCents: 0,
+  });
+  assert.deepEqual(applyDiscountAndTax(0, 2500, 825), {
+    subtotalCents: 0,
+    discountCents: 0,
+    taxCents: 0,
+    totalCents: 0,
+  });
+});
+
+test("applyDiscountAndTax validates integer bounds", () => {
+  const bad: Array<[number, number, number]> = [
+    [-1, 0, 0],
+    [1.5, 0, 0],
+    [100, -1, 0],
+    [100, 10001, 0],
+    [100, 2.5, 0],
+    [100, 0, -1],
+    [100, 0, 10001],
+    [100, 0, 0.5],
+  ];
+  for (const [gross, discount, tax] of bad) {
+    assert.throws(() => applyDiscountAndTax(gross, discount, tax), ValidationError, `${gross},${discount},${tax}`);
+  }
+});
+
+test("calculateBookingPrice applies optional discountBps through the shared helper", () => {
+  const room = { roomId: "a", name: "A", hourlyRateCents: 10000, taxBps: 825 };
+  const price = calculateBookingPrice(room, 90, { discountBps: 1500 });
+  assert.deepEqual(price, { ...applyDiscountAndTax(15000, 1500, 825), depositCents: 0 });
+  assert.equal(price.totalCents, 13802);
+  assert.equal(calculateBookingPrice(room, 60).discountCents, 0);
+  assert.throws(() => calculateBookingPrice(room, 60, { discountBps: 10001 }), ValidationError);
+  // legacy deposit is taken from the discounted subtotal
+  assert.equal(calculateBookingPrice(room, 60, { discountBps: 5000, legacyDepositMode: true }).depositCents, 1250);
+});
+
+test("createBooking accepts a discount for single-room bookings", () => {
+  const svc = makeService();
+  const b = svc.createBooking({ roomId: "c", customerId: "x", startMinute: 0, endMinute: 90, discountBps: 1500 });
+  assert.equal(b.discountCents, 563);
+  assert.equal(b.subtotalCents, 3187);
+  assert.equal(b.totalCents, 3506);
+  assert.equal(b.groupId, undefined);
+});
+
+// --- createGroupBooking: pricing -------------------------------------------
+
+test("createGroupBooking prices each room and sums exact totals", () => {
+  const svc = makeService();
+  const result = createGroupBooking(svc, GROUP);
+
+  assert.equal(result.bookings.length, 3);
+  assert.deepEqual(result.bookings.map((b) => b.roomId), ["a", "b", "c"]);
+  const perRoom = result.bookings.map((b) => [b.subtotalCents, b.discountCents, b.taxCents, b.totalCents]);
+  assert.deepEqual(perRoom, [
+    [12750, 2250, 1052, 13802],
+    [5100, 900, 0, 5100],
+    [3187, 563, 319, 3506],
+  ]);
+  assert.equal(result.subtotalCents, 21037);
+  assert.equal(result.discountCents, 3713);
+  assert.equal(result.taxCents, 1371);
+  assert.equal(result.totalCents, 22408);
+  assert.equal(result.subtotalCents + result.taxCents, result.totalCents);
+
+  for (const booking of result.bookings) {
+    assert.equal(booking.groupId, result.groupId);
+    assert.equal(booking.customerId, "corp_1");
+    assert.equal(booking.status, "confirmed");
+    assert.equal(booking.startMinute, 600);
+    assert.equal(booking.endMinute, 690);
+    assert.deepEqual(svc.getBooking(booking.bookingId), booking);
+  }
+  assert.equal(new Set(result.bookings.map((b) => b.bookingId)).size, 3);
+});
+
+test("separate group bookings get distinct groupIds", () => {
+  const svc = makeService();
+  const first = createGroupBooking(svc, { ...GROUP, roomIds: ["a", "b"] });
+  const second = createGroupBooking(svc, { ...GROUP, roomIds: ["a", "b"], startMinute: 690, endMinute: 750 });
+  assert.notEqual(first.groupId, second.groupId);
+  assert.equal(totalBookings(svc), 4);
+});
+
+// --- createGroupBooking: atomic conflicts ----------------------------------
+
+test("a conflict in any room rolls back the whole group", () => {
+  const svc = makeService();
+  const blocker = svc.createBooking({ roomId: "c", customerId: "other", startMinute: 680, endMinute: 720 });
+
+  assert.throws(() => createGroupBooking(svc, GROUP), (err: unknown) => {
+    assert.ok(err instanceof ConflictError);
+    assert.match(err.message, /room c/);
+    assert.match(err.message, new RegExp(blocker.bookingId));
+    return true;
+  });
+  assert.equal(svc.listRoomBookings("a").length, 0);
+  assert.equal(svc.listRoomBookings("b").length, 0);
+  assert.deepEqual(svc.listRoomBookings("c"), [blocker]);
+
+  // the free rooms remain bookable afterwards
+  const ok = createGroupBooking(svc, { ...GROUP, roomIds: ["a", "b"] });
+  assert.equal(ok.bookings.length, 2);
+});
+
+test("an active hold conflicts, but an expired hold and back-to-back slots do not", () => {
+  const svc = makeService();
+  svc.createBooking({ roomId: "b", customerId: "h", startMinute: 600, endMinute: 660, nowMinute: 0, holdMinutes: 30 });
+  svc.createBooking({ roomId: "a", customerId: "x", startMinute: 540, endMinute: 600 });
+
+  assert.throws(() => createGroupBooking(svc, { ...GROUP, nowMinute: 29 }), ConflictError);
+  assert.equal(totalBookings(svc), 2);
+
+  const result = createGroupBooking(svc, { ...GROUP, nowMinute: 30 });
+  assert.equal(result.bookings.length, 3);
+  assert.equal(totalBookings(svc), 5);
+});
+
+test("createBookings rejects overlapping duplicates within one batch atomically", () => {
+  const svc = makeService();
+  assert.throws(
+    () =>
+      svc.createBookings([
+        { roomId: "a", customerId: "x", startMinute: 0, endMinute: 60 },
+        { roomId: "a", customerId: "x", startMinute: 30, endMinute: 90 },
+      ]),
+    ConflictError,
+  );
+  assert.equal(totalBookings(svc), 0);
+  const ungrouped = svc.createBookings([
+    { roomId: "a", customerId: "x", startMinute: 0, endMinute: 60 },
+    { roomId: "a", customerId: "x", startMinute: 60, endMinute: 120 },
+  ]);
+  assert.deepEqual(ungrouped.map((b) => b.groupId), [undefined, undefined]);
+  assert.throws(() => svc.createBookings([]), ValidationError);
+});
+
+// --- createGroupBooking: validation ----------------------------------------
+
+test("createGroupBooking validation errors commit nothing", () => {
+  const svc = makeService();
+  const invalid: GroupBookingInput[] = [
+    { ...GROUP, roomIds: [] },
+    { ...GROUP, roomIds: ["a"] },
+    { ...GROUP, roomIds: ["a", "b", "a"] },
+    { ...GROUP, roomIds: ["a", "missing"] },
+    { ...GROUP, discountBps: -1 },
+    { ...GROUP, discountBps: 10001 },
+    { ...GROUP, discountBps: 12.5 },
+    { ...GROUP, customerId: "  " },
+    { ...GROUP, startMinute: 700, endMinute: 600 },
+    { ...GROUP, nowMinute: -5 },
+    { ...GROUP, roomIds: "ab" as unknown as readonly string[] },
+  ];
+  for (const input of invalid) {
+    assert.throws(() => createGroupBooking(svc, input), ValidationError, JSON.stringify(input));
+  }
+  assert.equal(totalBookings(svc), 0);
+});
+
+// --- module graph ----------------------------------------------------------
+
+test("src module imports are acyclic and bookings.ts does not import corporate.ts", () => {
+  const srcDir = join(dirname(fileURLToPath(import.meta.url)), "..", "src");
+  const graph = new Map<string, string[]>();
+  for (const file of readdirSync(srcDir).filter((f) => f.endsWith(".ts"))) {
+    const source = readFileSync(join(srcDir, file), "utf8");
+    const deps = [...source.matchAll(/from\s+"\.\/([^"]+)"/g)].map((m) => m[1] ?? "");
+    graph.set(file, deps);
+  }
+  assert.ok(!(graph.get("bookings.ts") ?? []).includes("corporate.ts"));
+  assert.ok((graph.get("corporate.ts") ?? []).includes("bookings.ts"));
+
+  const state = new Map<string, "visiting" | "done">();
+  const visit = (node: string, path: string[]): void => {
+    if (state.get(node) === "done") return;
+    assert.notEqual(state.get(node), "visiting", `import cycle: ${[...path, node].join(" -> ")}`);
+    state.set(node, "visiting");
+    for (const dep of graph.get(node) ?? []) visit(dep, [...path, node]);
+    state.set(node, "done");
+  };
+  for (const node of graph.keys()) visit(node, []);
+});
