+  for (const nowMinute of [-1, 2.5]) {
+    assert.throws(() => svc.createBooking({ ...base, nowMinute }), ValidationError, String(nowMinute));
+  }
+  assert.equal(svc.createBooking({ ...base, holdMinutes: 30 }).expiresAt, 30);
+  assert.equal(svc.listRoomBookings("r1").length, 1);
+});
+
+test("an active hold blocks overlapping bookings until it expires", () => {
+  const svc = makeService();
+  svc.createBooking({
+    roomId: "r1",
+    customerId: "a",
+    startMinute: 600,
+    endMinute: 660,
+    nowMinute: 0,
+    holdMinutes: 20,
+  });
+  const contender = { roomId: "r1", customerId: "b", startMinute: 630, endMinute: 690 };
+  assert.throws(() => svc.createBooking({ ...contender, nowMinute: 0 }), ConflictError);
+  assert.throws(() => svc.createBooking({ ...contender, nowMinute: 19 }), ConflictError);
+  // hold expires exactly at minute 20
+  const won = svc.createBooking({ ...contender, nowMinute: 20 });
+  assert.equal(won.status, "confirmed");
+});
+
+test("confirmHold confirms an unexpired hold and clears expiresAt", () => {
+  const svc = makeService();
+  const hold = svc.createBooking({
+    roomId: "r1",
+    customerId: "a",
+    startMinute: 600,
+    endMinute: 660,
+    nowMinute: 50,
+    holdMinutes: 10,
+  });
+  const confirmed = svc.confirmHold(hold.bookingId, 59);
+  assert.equal(confirmed.status, "confirmed");
+  assert.equal(confirmed.expiresAt, undefined);
