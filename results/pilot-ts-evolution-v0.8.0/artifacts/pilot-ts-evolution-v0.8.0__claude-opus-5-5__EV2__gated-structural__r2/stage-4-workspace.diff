+  if (typeof cutoffMinutes !== "number" || !Number.isSafeInteger(cutoffMinutes) || cutoffMinutes < 0) {
+    throw new ConfigError(`${CANCEL_FEE_TIERS_ENV}.cutoffMinutes must be a non-negative integer`);
+  }
+  return {
+    cutoffMinutes,
+    earlyFeeBps: requireConfigBps(fields.earlyFeeBps, "earlyFeeBps"),
+    lateFeeBps: requireConfigBps(fields.lateFeeBps, "lateFeeBps"),
+  };
