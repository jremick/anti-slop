+/**
+ * Books the same slot in several rooms at once, all-or-nothing. Each room is priced
+ * individually with the group discount; the result carries the summed totals.
+ */
+export function createGroupBooking(
+  service: BookingService,
+  input: GroupBookingInput,
+): GroupBookingResult {
+  const { roomIds } = input;
+  if (!Array.isArray(roomIds) || roomIds.length < 2) {
+    throw new ValidationError("roomIds must contain at least two rooms");
+  }
+  if (new Set(roomIds).size !== roomIds.length) {
+    throw new ValidationError("roomIds must not contain duplicates");
+  }
+  validateBps(input.discountBps, "discountBps");
+  for (const roomId of roomIds) {
+    service.getRoom(roomId);
+  }
+
+  // createBookings validates, prices and conflict-checks every room before
+  // committing any of them, so a conflict in one room books none.
+  const bookings = service.createBookings(
+    roomIds.map((roomId) => ({
+      roomId,
+      customerId: input.customerId,
+      startMinute: input.startMinute,
+      endMinute: input.endMinute,
+      discountBps: input.discountBps,
+      nowMinute: input.nowMinute,
+    })),
+    { grouped: true },
+  );
+
+  const groupId = bookings[0]?.groupId;
+  if (groupId === undefined) {
+    throw new Error("createBookings did not assign a groupId");
+  }
+  let subtotalCents = 0;
+  let discountCents = 0;
+  let taxCents = 0;
+  let totalCents = 0;
+  for (const booking of bookings) {
+    subtotalCents += booking.subtotalCents;
+    discountCents += booking.discountCents;
+    taxCents += booking.taxCents;
+    totalCents += booking.totalCents;
+  }
+  return { groupId, bookings, subtotalCents, discountCents, taxCents, totalCents };
+}

