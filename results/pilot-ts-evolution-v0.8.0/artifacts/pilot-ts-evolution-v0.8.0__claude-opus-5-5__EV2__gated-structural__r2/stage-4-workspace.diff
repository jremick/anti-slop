+import test from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync, readdirSync } from "node:fs";
+import { basename, dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import * as api from "../src/index.ts";
+import {
+  BookingService,
+  CANCEL_FEE_TIERS_ENV,
+  ConfigError,
+  ConflictError,
+  ValidationError,
+  calculateBookingPrice,
+  createGroupBooking,
+} from "../src/index.ts";
+import type { BookingNotification, Env } from "../src/index.ts";
+
+const TIERS_ENV: Env = {
+  [CANCEL_FEE_TIERS_ENV]: JSON.stringify({ cutoffMinutes: 120, earlyFeeBps: 1000, lateFeeBps: 5000 }),
+};
+
+const SLOT = { roomId: "a", customerId: "cust", startMinute: 600, endMinute: 660 } as const;
+
+class HookFailure extends Error {}
+
+interface Harness {
+  readonly svc: BookingService;
+  readonly events: BookingNotification[];
+  /** Throw on the Nth hook call from now (1-based); 0 disables failure. */
+  failOnCall: number;
+}
+
+function makeHarness(env: Env = TIERS_ENV): Harness {
+  const events: BookingNotification[] = [];
+  const harness: Harness = {
+    events,
+    failOnCall: 0,
+    svc: new BookingService({
+      env,
+      notifyHook: (event) => {
+        events.push(event);
+        if (harness.failOnCall > 0) {
+          harness.failOnCall -= 1;
+          if (harness.failOnCall === 0) {
+            throw new HookFailure(`hook rejected ${event.event} ${event.bookingId}`);
+          }
+        }
+      },
+    }),
+  };
+  harness.svc.registerRoom({ roomId: "a", name: "A", hourlyRateCents: 10000, taxBps: 825 });
+  harness.svc.registerRoom({ roomId: "b", name: "B", hourlyRateCents: 4000, taxBps: 0 });
+  harness.svc.registerRoom({ roomId: "c", name: "C", hourlyRateCents: 2500, taxBps: 1000 });
+  return harness;
+}
+
+function bookingCount(svc: BookingService): number {
+  return ["a", "b", "c"].reduce((n, id) => n + svc.listRoomBookings(id).length, 0);
+}
+
+// --- legacy deposit removal ------------------------------------------------
+
+test("legacy deposit exports are gone from the public API", () => {
+  const exported = Object.keys(api);
+  assert.ok(!exported.includes("LEGACY_DEPOSIT_BPS"));
+  assert.ok(!exported.includes("calculateLegacyDeposit"));
+  assert.ok(exported.every((name) => !/deposit/i.test(name)), exported.join(","));
+});
+
+test("prices and bookings no longer carry depositCents", () => {
+  const price = calculateBookingPrice({ roomId: "a", name: "A", hourlyRateCents: 4000, taxBps: 0 }, 60);
+  assert.deepEqual(price, { subtotalCents: 4000, discountCents: 0, taxCents: 0, totalCents: 4000 });
+
+  const { svc } = makeHarness();
+  const booking = svc.createBooking(SLOT);
+  assert.equal("depositCents" in booking, false);
+});
+
+test("no source or other test file mentions the legacy deposit feature", () => {
+  const root = join(dirname(fileURLToPath(import.meta.url)), "..");
+  const self = basename(fileURLToPath(import.meta.url));
+  for (const dir of ["src", "tests"]) {
+    for (const file of readdirSync(join(root, dir)).filter((f) => f.endsWith(".ts") && f !== self)) {
+      const source = readFileSync(join(root, dir, file), "utf8");
+      assert.doesNotMatch(source, /deposit/i, `${dir}/${file}`);
+    }
+  }
+});
+
+// --- notifyHook: exact events ----------------------------------------------
+
+test("createBooking emits booking_created with the booking total", () => {
+  const { svc, events } = makeHarness();
+  const booking = svc.createBooking(SLOT);
+  const hold = svc.createBooking({ ...SLOT, roomId: "b", nowMinute: 0, holdMinutes: 15 });
+  assert.deepEqual(events, [
+    { event: "booking_created", bookingId: booking.bookingId, roomId: "a", customerId: "cust", amountCents: 10825 },
+    { event: "booking_created", bookingId: hold.bookingId, roomId: "b", customerId: "cust", amountCents: 4000 },
+  ]);
+});
+
+test("createGroupBooking emits one booking_created per room in order", () => {
+  const { svc, events } = makeHarness();
+  const group = createGroupBooking(svc, {
+    customerId: "corp",
+    roomIds: ["a", "b", "c"],
+    startMinute: 600,
+    endMinute: 690,
+    discountBps: 1500,
+  });
+  assert.deepEqual(
+    events,
+    group.bookings.map((b) => ({
+      event: "booking_created",
+      bookingId: b.bookingId,
+      roomId: b.roomId,
+      customerId: "corp",
+      amountCents: b.totalCents,
+    })),
+  );
+  assert.deepEqual(events.map((e) => e.amountCents), [13802, 5100, 3506]);
+});
+
+test("cancelBooking emits booking_cancelled with the refund amount", () => {
+  const { svc, events } = makeHarness();
+  const booking = svc.createBooking(SLOT);
+  const result = svc.cancelBooking(booking.bookingId, 481); // late tier: refund 5412
+  assert.equal(result.refundCents, 5412);
+  assert.deepEqual(events.at(-1), {
+    event: "booking_cancelled",
+    bookingId: booking.bookingId,
+    roomId: "a",
+    customerId: "cust",
+    amountCents: 5412,
+  });
+  assert.equal(events.length, 2);
+});
+
+test("the hook observes the operation's state while it runs", () => {
+  let observed: string | undefined;
+  const svc = new BookingService({
+    env: TIERS_ENV,
+    notifyHook: (event) => {
+      observed = svc.getBooking(event.bookingId).status;
+    },
+  });
+  svc.registerRoom({ roomId: "a", name: "A", hourlyRateCents: 10000, taxBps: 0 });
+  const booking = svc.createBooking(SLOT);
+  assert.equal(observed, "confirmed");
+  svc.cancelBooking(booking.bookingId, 0);
+  assert.equal(observed, "cancelled");
+});
+
+test("failed validation, conflicts and config errors never reach the hook", () => {
+  const { svc, events } = makeHarness({});
+  const booking = svc.createBooking(SLOT);
+  events.length = 0;
+  assert.throws(() => svc.createBooking({ ...SLOT, endMinute: 500 }), ValidationError);
+  assert.throws(() => svc.createBooking(SLOT), ConflictError);
+  assert.throws(
+    () => createGroupBooking(svc, { customerId: "x", roomIds: ["b", "a"], startMinute: 600, endMinute: 660, discountBps: 0 }),
+    ConflictError,
+  );
+  assert.throws(() => svc.cancelBooking(booking.bookingId, 0), ConfigError);
+  assert.deepEqual(events, []);
+});
+
+test("works without a notifyHook", () => {
+  const svc = new BookingService({ env: TIERS_ENV });
+  svc.registerRoom({ roomId: "a", name: "A", hourlyRateCents: 10000, taxBps: 0 });
+  const booking = svc.createBooking(SLOT);
+  assert.equal(svc.cancelBooking(booking.bookingId, 0).booking.status, "cancelled");
+});
+
+// --- notifyHook: fail-closed rollback --------------------------------------
+
+test("a throwing hook rolls back a single booking and propagates the error", () => {
+  const h = makeHarness();
+  h.failOnCall = 1;
+  assert.throws(() => h.svc.createBooking(SLOT), HookFailure);
+  assert.equal(bookingCount(h.svc), 0);
+  assert.equal(h.events.length, 1);
+  const rejectedId = h.events[0]?.bookingId ?? "";
+  assert.throws(() => h.svc.getBooking(rejectedId), ValidationError);
+
+  // the slot is free and the next booking gets a fresh id
+  const retry = h.svc.createBooking(SLOT);
+  assert.notEqual(retry.bookingId, rejectedId);
+  assert.equal(bookingCount(h.svc), 1);
+});
+
+test("a hook failure mid-group rolls back every room of the group", () => {
+  const h = makeHarness();
+  const existing = h.svc.createBooking({ ...SLOT, roomId: "c", startMinute: 0, endMinute: 60 });
+  const input = { customerId: "corp", roomIds: ["a", "b", "c"], startMinute: 600, endMinute: 690, discountBps: 0 };
+
+  for (const failingCall of [1, 2, 3]) {
+    h.events.length = 0;
+    h.failOnCall = failingCall;
+    assert.throws(() => createGroupBooking(h.svc, input), HookFailure, `call ${failingCall}`);
+    assert.equal(h.events.length, failingCall);
+    assert.deepEqual(h.svc.listRoomBookings("a"), []);
+    assert.deepEqual(h.svc.listRoomBookings("b"), []);
+    assert.deepEqual(h.svc.listRoomBookings("c"), [existing]);
+  }
+
+  const group = createGroupBooking(h.svc, input);
+  assert.equal(group.bookings.length, 3);
+  assert.equal(bookingCount(h.svc), 4);
+});
+
+test("a throwing hook leaves a cancelled booking confirmed and its slot blocked", () => {
+  const h = makeHarness();
+  const booking = h.svc.createBooking(SLOT);
+  h.failOnCall = 1;
+  assert.throws(() => h.svc.cancelBooking(booking.bookingId, 0), HookFailure);
+  assert.deepEqual(h.svc.getBooking(booking.bookingId), booking);
+  assert.throws(() => h.svc.createBooking({ ...SLOT, customerId: "other" }), ConflictError);
+
+  const result = h.svc.cancelBooking(booking.bookingId, 0);
+  assert.equal(result.booking.status, "cancelled");
+  assert.equal(h.events.at(-1)?.event, "booking_cancelled");
+});
+
+test("a throwing hook on hold cancellation keeps the hold confirmable", () => {
+  const h = makeHarness();
+  const hold = h.svc.createBooking({ ...SLOT, nowMinute: 0, holdMinutes: 30 });
+  h.failOnCall = 1;
+  assert.throws(() => h.svc.cancelBooking(hold.bookingId, 5), HookFailure);
+  assert.deepEqual(h.svc.getBooking(hold.bookingId), hold);
+  assert.equal(h.svc.confirmHold(hold.bookingId, 5).status, "confirmed");
+});
