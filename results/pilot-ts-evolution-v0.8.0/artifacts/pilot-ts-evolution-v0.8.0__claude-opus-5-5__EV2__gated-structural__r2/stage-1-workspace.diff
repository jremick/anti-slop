+/** Half-open interval overlap of `[startA, endA)` and `[startB, endB)`; back-to-back slots do not overlap. */
+export function slotsOverlap(startA: number, endA: number, startB: number, endB: number): boolean {
+  return startA < endB && startB < endA;
+}
+
+/** A booking blocks its slot if confirmed, or held and not yet expired at `nowMinute`. */
+export function isBookingActiveAt(booking: Booking, nowMinute: number): boolean {
+  if (booking.status === "confirmed") {
+    return true;
+  }
+  return booking.status === "held" && booking.expiresAt !== undefined && nowMinute < booking.expiresAt;
+}
 
