+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  ValidationError,
+  applyDiscountAndTax,
+  calculateBookingPrice,
+  computeTaxCents,
+  roundHalfUpDiv,
+} from "../src/index.ts";
+import type { Room } from "../src/index.ts";
+
+test("roundHalfUpDiv performs exact integer half-up rounding across boundaries", () => {
+  assert.equal(roundHalfUpDiv(0, 60), 0);
+  assert.equal(roundHalfUpDiv(120, 60), 2);
+  assert.equal(roundHalfUpDiv(29, 60), 0);
+  assert.equal(roundHalfUpDiv(30, 60), 1);
+  assert.equal(roundHalfUpDiv(31, 60), 1);
+  assert.equal(roundHalfUpDiv(89, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2);
+  assert.equal(roundHalfUpDiv(1, 2), 1);
+  assert.equal(roundHalfUpDiv(3, 2), 2);
+  assert.equal(roundHalfUpDiv(1, 3), 0);
+  assert.equal(roundHalfUpDiv(2, 3), 1);
+  assert.equal(roundHalfUpDiv(4, 3), 1);
+  assert.equal(roundHalfUpDiv(5, 3), 2);
+  assert.equal(roundHalfUpDiv(2, 5), 0);
+  assert.equal(roundHalfUpDiv(3, 5), 1);
+  assert.equal(roundHalfUpDiv(4999, 10000), 0);
+  assert.equal(roundHalfUpDiv(5000, 10000), 1);
+});
+
+test("roundHalfUpDiv rejects invalid numerators and denominators with ValidationError", () => {
+  assert.throws(() => roundHalfUpDiv(-1, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(1.5, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.NaN, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.POSITIVE_INFINITY, 60), ValidationError);
+
+  assert.throws(() => roundHalfUpDiv(10, 0), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, -2), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, 2.5), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, Number.NaN), ValidationError);
+});
+
+test("calculateBookingPrice supports fractional-hour durations with half-up subtotal and tax", () => {
+  const roomHalf: Room = {
+    roomId: "r_half",
+    name: "Half-Cent Room",
+    hourlyRateCents: 101,
+    taxBps: 500,
+  };
+  // 101 * 30 / 60 = 50.5 -> 51 cents; tax = 51 * 500 / 10000 = 2.55 -> 3 cents
+  const halfHour = calculateBookingPrice(roomHalf, 30);
+  assert.equal(halfHour.subtotalCents, 51);
+  assert.equal(halfHour.discountCents, 0);
+  assert.equal(halfHour.taxCents, 3);
+  assert.equal(halfHour.totalCents, 54);
+  assert.equal(halfHour.depositCents, 0);
+
+  const roomThirds: Room = {
+    roomId: "r_thirds",
+    name: "Thirds Room",
+    hourlyRateCents: 100,
+    taxBps: 825,
+  };
+  // 100 * 20 / 60 = 33.333... -> 33 cents; tax = 33 * 825 / 10000 = 2.7225 -> 3 cents
+  const twentyMin = calculateBookingPrice(roomThirds, 20);
+  assert.equal(twentyMin.subtotalCents, 33);
+  assert.equal(twentyMin.taxCents, 3);
+  assert.equal(twentyMin.totalCents, 36);
+
+  // 100 * 40 / 60 = 66.666... -> 67 cents; tax = 67 * 825 / 10000 = 5.5275 -> 6 cents
+  const fortyMin = calculateBookingPrice(roomThirds, 40, { legacyDepositMode: true });
+  assert.equal(fortyMin.subtotalCents, 67);
+  assert.equal(fortyMin.taxCents, 6);
+  assert.equal(fortyMin.totalCents, 73);
+  // legacy deposit = 67 * 2500 / 10000 = 16.75 -> 17 cents
+  assert.equal(fortyMin.depositCents, 17);
+
+  // 1 minute duration on 3000 cents/hour -> 50 cents exact
+  const oneMin = calculateBookingPrice(
+    { roomId: "r_min", name: "Min Room", hourlyRateCents: 3000, taxBps: 100 },
+    1,
+  );
+  assert.equal(oneMin.subtotalCents, 50);
+  assert.equal(oneMin.taxCents, 1); // 50 * 100 / 10000 = 0.5 -> 1
+  assert.equal(oneMin.totalCents, 51);
+});
+
+test("calculateBookingPrice and computeTaxCents reject invalid inputs", () => {
+  const room: Room = {
+    roomId: "r_valid",
+    name: "Valid Room",
+    hourlyRateCents: 6000,
+    taxBps: 500,
+  };
+  assert.throws(() => calculateBookingPrice(room, 0), ValidationError);
+  assert.throws(() => calculateBookingPrice(room, -15), ValidationError);
+  assert.throws(() => calculateBookingPrice(room, 30.5), ValidationError);
+  assert.equal(computeTaxCents(100, 50), 1);
+  assert.equal(computeTaxCents(100, 49), 0);
+});
+
+test("applyDiscountAndTax rounds discount and post-discount tax half-up and validates bounds", () => {
+  // Exact half-up discount: 100 * 50 / 10000 = 0.5 -> 1; net subtotal = 99; tax = 99 * 1000 / 10000 = 9.9 -> 10
+  const halfUp = applyDiscountAndTax(100, 50, 1000);
+  assert.deepEqual(halfUp, {
+    subtotalCents: 99,
+    discountCents: 1,
+    taxCents: 10,
+    totalCents: 109,
+  });
+
+  // Just below half: 100 * 49 / 10000 = 0.49 -> 0; net subtotal = 100; tax = 100 * 50 / 10000 = 0.5 -> 1
+  const belowHalf = applyDiscountAndTax(100, 49, 50);
+  assert.deepEqual(belowHalf, {
+    subtotalCents: 100,
+    discountCents: 0,
+    taxCents: 1,
+    totalCents: 101,
+  });
+
+  // Zero and full discount boundaries
+  assert.deepEqual(applyDiscountAndTax(5000, 0, 825), {
+    subtotalCents: 5000,
+    discountCents: 0,
+    taxCents: 413,
+    totalCents: 5413,
+  });
+  assert.deepEqual(applyDiscountAndTax(5000, 10000, 825), {
+    subtotalCents: 0,
+    discountCents: 5000,
+    taxCents: 0,
+    totalCents: 0,
+  });
+  assert.deepEqual(applyDiscountAndTax(100, 0, 10000), {
+    subtotalCents: 100,
+    discountCents: 0,
+    taxCents: 100,
+    totalCents: 200,
+  });
+
+  // Validation errors
+  assert.throws(() => applyDiscountAndTax(-1, 0, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100.5, 0, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, -1, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, 10001, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, 10.5, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, 0, -1), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, 0, 10001), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, 0, 5.5), ValidationError);
+});
+
+test("calculateBookingPrice applies optional discountBps via applyDiscountAndTax", () => {
+  const room: Room = {
+    roomId: "r_disc",
+    name: "Discount Room",
+    hourlyRateCents: 10001,
+    taxBps: 825,
+  };
+  // 45 minutes: gross = 10001 * 45 / 60 = 7500.75 -> 7501
+  // discount 1500 bps (15%): 7501 * 1500 / 10000 = 1125.15 -> 1125
+  // net subtotal = 7501 - 1125 = 6376
+  // tax 825 bps: 6376 * 825 / 10000 = 526.02 -> 526
+  // total = 6902; legacy deposit = 6376 * 2500 / 10000 = 1594
+  const price = calculateBookingPrice(room, 45, {
+    discountBps: 1500,
+    legacyDepositMode: true,
+  });
+  assert.deepEqual(price, {
+    subtotalCents: 6376,
+    discountCents: 1125,
+    taxCents: 526,
+    totalCents: 6902,
+    depositCents: 1594,
+  });
+});
