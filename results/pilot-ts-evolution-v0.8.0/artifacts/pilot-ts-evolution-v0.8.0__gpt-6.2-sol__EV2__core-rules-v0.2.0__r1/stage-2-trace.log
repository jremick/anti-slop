onMinutes, \"durationMinutes\");\n  const subtotalCents = roundHalfUpDiv(room.hourlyRateCents * durationMinutes, 60);\n  const taxCents = computeTaxCents(subtotalCents, room.taxBps);\n  const depositCents = options?.legacyDepositMode === true\n    ? calculateLegacyDeposit(subtotalCents)\n    : 0;\n  return {\n    subtotalCents,\n    discountCents: 0,\n    taxCents,\n    totalCents: subtotalCents + taxCents,\n    depositCents,\n  };\n}\nbenchmarks/sources/ev2_ts_bookings/src/config.ts\nbenchmarks/sources/ev2_ts_bookings/src/models.ts\nbenchmarks/sources/ev2_ts_bookings/src/index.ts\nbenchmarks/sources/ev2_ts_bookings/src/bookings.ts\nbenchmarks/sources/ev2_ts_bookings/src/pricing.ts\nbenchmarks/sources/ev2_ts_bookings/tests/pricing.test.ts\nbenchmarks/sources/ev2_ts_bookings/tests/bookings.test.ts\nbenchmarks/sources/ev2_ts_bookings/run_checks.mjs\n✔ baseline whole-hour booking computes exact subtotal and tax (0.595084ms)\n✔ baseline legacy deposit mode calculates 25 percent deposit (0.224583ms)\n✔ baseline rejects invalid room or inverted time range (0.434042ms)\n✔ only overlapping slots in the same room conflict (0.32675ms)\n✔ holds block a slot only until their expiration minute (0.399041ms)\n✔ hold length must be a positive integer within the configured limit (0.187708ms)\n✔ confirming a hold preserves its details and clears its expiration (0.563125ms)\n✔ integer division rounds half up (0.626334ms)\n✔ integer division rejects invalid numerators and denominators (0.527167ms)\n✔ partial-hour pricing rounds the subtotal before computing tax and deposit (0.651125ms)\n✔ pricing rejects durations that are not positive integers (0.244625ms)\nℹ tests 11\nℹ suites 0\nℹ pass 11\nℹ fail 0\nℹ cancelled 0\nℹ skipped 0\nℹ todo 0\nℹ duration_ms 210.168167\n","exit_code":0,"status":"completed"}}
