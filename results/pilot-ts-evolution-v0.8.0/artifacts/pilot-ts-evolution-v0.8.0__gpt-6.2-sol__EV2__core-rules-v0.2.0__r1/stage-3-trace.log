iv(grossSubtotalCents * discountBps, 10000);\n  const subtotalCents = grossSubtotalCents - discountCents;\n  const taxCents = computeTaxCents(subtotalCents, taxBps);\n  return { subtotalCents, discountCents, taxCents, totalCents: subtotalCents + taxCents };\n}\n\nexport function calculateLegacyDeposit(subtotalCents: number): number {\n  validateNonNegativeInt(subtotalCents, \"subtotalCents\");\n  return Math.floor((subtotalCents * LEGACY_DEPOSIT_BPS + 5000) / 10000);\n}\n\nexport function calculateBookingPrice(\n  room: Room,\n  durationMinutes: number,\n  options?: { readonly legacyDepositMode?: boolean; readonly discountBps?: number },\n): PriceBreakdown {\n  const { discountBps = 0, legacyDepositMode } = options ?? {};\n  validatePositiveInt(room.hourlyRateCents, \"hourlyRateCents\");\n  validatePositiveInt(durationMinutes, \"durationMinutes\");\n  const grossSubtotalCents = roundHalfUpDiv(room.hourlyRateCents * durationMinutes, 60);\n  const price = applyDiscountAndTax(grossSubtotalCents, discountBps, room.taxBps);\n  const depositCents = legacyDepositMode === true\n    ? calculateLegacyDeposit(price.subtotalCents)\n    : 0;\n  return { ...price, depositCents };\n}\nexport {\n  BookingError,\n  ConfigError,\n  ConflictError,\n  ValidationError,\n} from \"./models.ts\";\nexport type {\n  Booking,\n  BookingStatus,\n  CreateBookingInput,\n  CreateGroupBookingInput,\n  PriceBreakdown,\n  Room,\n} from \"./models.ts\";\nexport {\n  DEFAULT_MAX_HOLD_MINUTES,\n  loadBookingConfig,\n} from \"./config.ts\";\nexport type { BookingConfig } from \"./config.ts\";\nexport {\n  LEGACY_DEPOSIT_BPS,\n  applyDiscountAndTax,\n  calculateBookingPrice,\n  calculateLegacyDeposit,\n  computeTaxCents,\n  roundHalfUpDiv,\n  validateNonNegativeInt,\n  validatePositiveInt,\n} from \"./pricing.ts\";\nexport { BookingService, isBookingActiveAt, slotsOverlap } from \"./bookings.ts\";\nexport type { BookingServiceOptions } from \"./bookings.ts\";\nexport { createGroupBooking } from \"./corporate.ts\";\nexport type { GroupBookingResult } from \"./corporate.ts\";\nbenchmarks/sources/ev2_ts_bookings/src/config.ts:10:  env: Record<string, string | undefined> = process.env,\nbenchmarks/sources/ev2_ts_bookings/src/models.ts:29:export type BookingStatus = \"confirmed\" | \"held\" | \"cancelled\";\nbenchmarks/sources/ev2_ts_bookings/tests/bookings.test.ts:127:  assert.equal(isBookingActiveAt({ ...hold, status: \"cancelled\" }, 14), false);\n✔ baseline whole-hour booking computes exact subtotal and tax (1.149833ms)\n✔ baseline legacy deposit mode calculates 25 percent deposit (0.151375ms)\n✔ baseline rejects invalid room or inverted time range (0.280125ms)\n✔ only overlapping slots in the same room conflict (0.339625ms)\n✔ holds block a slot only until their expiration minute (0.268083ms)\n✔ hold length must be a positive integer within the configured limit (0.142708ms)\n✔ confirming a hold preserves its details and clears its expiration (0.528542ms)\n✔ group pricing rounds each room separately and returns the sum of booked amounts (1.746625ms)\n✔ a hold in the last room prevents all group writes until its exact expiration (0.413542ms)\n✔ invalid group inputs leave all rooms untouched (0.301292ms)\n✔ integer division rounds half up (0.932167ms)\n✔ integer division rejects invalid numerators and denominators (0.559084ms)\n✔ partial-hour pricing rounds the subtotal before computing tax and deposit (0.692333ms)\n✔ pricing rejects durations that are not positive integers (0.216542ms)\n✔ discount and tax round half up, with tax applied to the discounted subtotal (0.120541ms)\n✔ discount and tax must be integer basis points from 0 through 10000 (0.170583ms)\nℹ tests 16\nℹ suites 0\nℹ pass 16\nℹ fail 0\nℹ cancelled 0\nℹ skipped 0\nℹ todo 0\nℹ duration_ms 218.815375\n","exit_code":0,"status":"completed"}}
