   () =>\n      svc.createBooking({\n        roomId: \"missing\",\n        customerId: \"cust_1\",\n        startMinute: 0,\n        endMinute: 60,\n      }),\n    ValidationError,\n  );\n  assert.throws(\n    () =>\n      svc.createBooking({\n        roomId: \"conf_c\",\n        customerId: \"cust_1\",\n        startMinute: 120,\n        endMinute: 60,\n      }),\n    ValidationError,\n  );\n});\n\nconst room = { roomId: \"a\", name: \"Room A\", hourlyRateCents: 90, taxBps: 2500 };\nconst slot = { roomId: room.roomId, customerId: \"cust_1\", startMinute: 60, endMinute: 90 };\n\ntest(\"only overlapping slots in the same room conflict\", () => {\n  const svc = new BookingService({ env: {} });\n  svc.registerRoom(room);\n  svc.registerRoom({ ...room, roomId: \"b\", name: \"Room B\" });\n  const confirmed = svc.createBooking(slot);\n  assert.equal(isBookingActiveAt(confirmed, 1000), true);\n  assert.equal(confirmed.subtotalCents, 45);\n  assert.equal(confirmed.taxCents, 11);\n\n  const overlapping: [number, number][] = [[59, 61], [89, 91], [61, 89], [59, 91], [60, 90]];\nimport test from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { ValidationError, applyDiscountAndTax, calculateBookingPrice, roundHalfUpDiv } from \"../src/index.ts\";\n\nconst room = { roomId: \"a\", name: \"Room A\", hourlyRateCents: 90, taxBps: 2500 };\n\ntest(\"integer division rounds half up\", () => {\n  assert.equal(roundHalfUpDiv(0, 60), 0);\n  assert.equal(roundHalfUpDiv(60, 60), 1);\n  assert.equal(roundHalfUpDiv(89, 60), 1);\n  assert.equal(roundHalfUpDiv(90, 60), 2);\n  assert.equal(roundHalfUpDiv(91, 60), 2);\n  assert.equal(roundHalfUpDiv(1, 3), 0);\n  assert.equal(roundHalfUpDiv(2, 3), 1);\n});\n\ntest(\"integer division rejects invalid numerators and denominators\", () => {\n  for (const invalid of [-1, 1.5, NaN, Infinity]) {\n    assert.throws(() => roundHalfUpDiv(invalid, 60), ValidationError);\n    assert.throws(() => roundHalfUpDiv(60, invalid), ValidationError);\n  }\n  assert.throws(() => roundHalfUpDiv(1, 0), ValidationError);\n});\n\ntest(\"partial-hour pricing rounds the subtotal before computing tax and deposit\", () => {\n  assert.deepEqual(calculateBookingPrice(room, 1, { legacyDepositMode: true }), {\n    subtotalCents: 2,\n    discountCents: 0,\n    taxCents: 1,\n    totalCents: 3,\n    depositCents: 1,\n  });\n  assert.equal(calculateBookingPrice(room, 61).subtotalCents, 92);\n  assert.equal(calculateBookingPrice({ ...room, hourlyRateCents: 1 }, 1).totalCents, 0);\n});\n\ntest(\"pricing rejects durations that are not positive integers\", () => {\n  for (const duration of [0, -1, 1.5, NaN, Infinity]) {\n    assert.throws(() => calculateBookingPrice(room, duration), ValidationError);\n  }\n});\n\ntest(\"discount and tax round half up, with tax applied to the discounted subtotal\", () => {\n  assert.deepEqual(applyDiscountAndTax(2, 2500, 5000), {\n    subtotalCents: 1,\n    discountCents: 1,\n    taxCents: 1,\n    totalCents: 2,\n  });\n  assert.deepEqual(applyDiscountAndTax(5, 10000, 10000), {\n    subtotalCents: 0,\n    discountCents: 5,\n    taxCents: 0,\n    totalCents: 0,\n  });\n  assert.deepEqual(calculateBookingPrice(room, 1, { discountBps: 2500, legacyDepositMode: true }), {\n    subtotalCents: 1,\n    discountCents: 1,\n    taxCents: 0,\n    totalCents: 1,\n    depositCents: 0,\n  });\n});\n\ntest(\"discount and tax must be integer basis points from 0 through 10000\", () => {\n  for (const invalid of [-1, 1.5, 10001, NaN, Infinity]) {\n    assert.throws(() => applyDiscountAndTax(0, invalid, 0), ValidationError);\n    assert.throws(() => applyDiscountAndTax(0, 0, invalid), ValidationError);\n    assert.throws(() => calculateBookingPrice(room, 60, { discountBps: invalid }), ValidationError);\n  }\n  assert.throws(() => applyDiscountAndTax(-1, 0, 0), ValidationError);\n  assert.throws(() => applyDiscountAndTax(1.5, 0, 0), ValidationError);\n});\n","exit_code":0,"status":"completed"}}
