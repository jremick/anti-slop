+import test from "node:test";
+import assert from "node:assert/strict";
+import { BookingService, ConflictError, ValidationError, createGroupBooking } from "../src/index.ts";
+import type { CreateGroupBookingInput } from "../src/index.ts";
+
+const input = {
+  customerId: " corporate ",
+  roomIds: ["a", "b"],
+  startMinute: 60,
+  endMinute: 61,
+  discountBps: 2500,
+};
+
+function makeService(): BookingService {
+  const service = new BookingService({ env: {} });
+  service.registerRoom({ roomId: "a", name: "Room A", hourlyRateCents: 90, taxBps: 5000 });
+  service.registerRoom({ roomId: "b", name: "Room B", hourlyRateCents: 150, taxBps: 2500 });
+  return service;
+}
+
+test("group pricing rounds each room separately and returns the sum of booked amounts", () => {
+  const service = makeService();
+  const { groupId, bookings, ...totals } = createGroupBooking(service, input);
+
+  assert.ok(groupId);
+  assert.deepEqual(totals, { subtotalCents: 3, discountCents: 2, taxCents: 2, totalCents: 5 });
+  assert.deepEqual(bookings.map(({ roomId, subtotalCents, discountCents, taxCents, totalCents }) =>
+    ({ roomId, subtotalCents, discountCents, taxCents, totalCents })), [
+    { roomId: "a", subtotalCents: 1, discountCents: 1, taxCents: 1, totalCents: 2 },
+    { roomId: "b", subtotalCents: 2, discountCents: 1, taxCents: 1, totalCents: 3 },
+  ]);
+  assert.equal(new Set(bookings.map((booking) => booking.bookingId)).size, 2);
+  for (const booking of bookings) {
+    assert.equal(booking.groupId, groupId);
+    assert.equal(booking.customerId, "corporate");
+    assert.equal(booking.status, "confirmed");
+    assert.equal(booking.startMinute, input.startMinute);
+    assert.equal(booking.endMinute, input.endMinute);
+    assert.deepEqual(service.getBooking(booking.bookingId), booking);
+    assert.deepEqual(service.listRoomBookings(booking.roomId), [booking]);
+  }
+  assert.throws(() => service.createBooking({ ...input, roomId: "a" }), ConflictError);
+  const adjacent = createGroupBooking(service, { ...input, startMinute: 61, endMinute: 62, discountBps: 0 });
+  assert.notEqual(adjacent.groupId, groupId);
+  assert.equal(adjacent.discountCents, 0);
+});
+
+test("a hold in the last room prevents all group writes until its exact expiration", () => {
+  const service = makeService();
+  const hold = service.createBooking({ ...input, roomId: "b", holdMinutes: 5 });
+
+  assert.throws(() => createGroupBooking(service, input), ConflictError);
+  assert.throws(() => createGroupBooking(service, { ...input, nowMinute: 4 }), ConflictError);
+  assert.deepEqual(service.listRoomBookings("a"), []);
+  assert.deepEqual(service.listRoomBookings("b"), [hold]);
+
+  const group = createGroupBooking(service, { ...input, nowMinute: 5 });
+  assert.deepEqual(service.listRoomBookings("a"), [group.bookings[0]]);
+  assert.deepEqual(service.listRoomBookings("b"), [hold, group.bookings[1]]);
+});
+
+test("invalid group inputs leave all rooms untouched", () => {
+  const service = makeService();
+  const invalidInputs: Partial<CreateGroupBookingInput>[] = [
+    { roomIds: [] },
+    { roomIds: ["a"] },
+    { roomIds: ["a", "b", "a"] },
+    { roomIds: ["a", "missing"] },
+    { discountBps: -1 },
+    { discountBps: 1.5 },
+    { discountBps: 10001 },
+    { discountBps: NaN },
+    { customerId: " " },
+    { endMinute: 60 },
+  ];
+  for (const invalid of invalidInputs) {
+    assert.throws(() => createGroupBooking(service, { ...input, ...invalid }), ValidationError);
+    assert.deepEqual(service.listRoomBookings("a"), []);
+    assert.deepEqual(service.listRoomBookings("b"), []);
+  }
+});

