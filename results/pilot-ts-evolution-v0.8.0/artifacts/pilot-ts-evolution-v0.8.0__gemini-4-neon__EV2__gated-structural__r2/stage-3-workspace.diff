+import {
+  assertNoRoomConflict,
+  validateBookingRequest,
+  validateNonEmptyString,
+} from "./bookings.ts";
+import type { BookingService } from "./bookings.ts";
+import { ValidationError } from "./models.ts";
+import type { Booking, Room } from "./models.ts";
+import { validateBps } from "./pricing.ts";
+
+export interface CreateGroupBookingInput {
+  readonly customerId: string;
+  readonly roomIds: readonly string[];
+  readonly startMinute: number;
+  readonly endMinute: number;
+  readonly discountBps: number;
+  readonly nowMinute?: number;
+}
+
+export interface GroupBookingResult {
+  readonly groupId: string;
+  readonly bookings: Booking[];
+  readonly subtotalCents: number;
+  readonly discountCents: number;
+  readonly taxCents: number;
+  readonly totalCents: number;
+}
+
+function resolveGroupRooms(service: BookingService, roomIds: readonly string[]): Room[] {
+  if (!Array.isArray(roomIds) || roomIds.length < 2) {
+    throw new ValidationError("roomIds must contain at least 2 rooms");
+  }
+  const seenRoomIds = new Set<string>();
+  const rooms: Room[] = [];
+  for (const roomId of roomIds) {
+    validateNonEmptyString(roomId, "roomId");
+    if (seenRoomIds.has(roomId)) {
+      throw new ValidationError(`Duplicate roomId in group booking: ${roomId}`);
+    }
+    seenRoomIds.add(roomId);
+    rooms.push(service.getRoom(roomId));
+  }
+  return rooms;
+}
+
+function assertRoomsAvailable(
+  service: BookingService,
+  rooms: readonly Room[],
+  startMinute: number,
+  endMinute: number,
+  nowMinute: number,
+): void {
+  for (const room of rooms) {
+    assertNoRoomConflict(
+      room.roomId,
+      service.listRoomBookings(room.roomId),
+      startMinute,
+      endMinute,
+      nowMinute,
+    );
+  }
+}
+
+export function createGroupBooking(
+  service: BookingService,
+  input: CreateGroupBookingInput,
+): GroupBookingResult {
+  const request = validateBookingRequest(input);
+  validateBps(input.discountBps, "discountBps");
+  const rooms = resolveGroupRooms(service, input.roomIds);
+  assertRoomsAvailable(
+    service,
+    rooms,
+    request.startMinute,
+    request.endMinute,
+    request.nowMinute,
+  );
+
+  const groupId = service.nextGroupId();
+  const bookings: Booking[] = [];
+  let subtotalCents = 0;
+  let discountCents = 0;
+  let taxCents = 0;
+  let totalCents = 0;
+
+  for (const room of rooms) {
+    const booking = service.createBooking({
+      roomId: room.roomId,
+      customerId: request.customerId,
+      startMinute: request.startMinute,
+      endMinute: request.endMinute,
+      nowMinute: request.nowMinute,
+      discountBps: input.discountBps,
+      groupId,
+    });
+    bookings.push(booking);
+    subtotalCents += booking.subtotalCents;
+    discountCents += booking.discountCents;
+    taxCents += booking.taxCents;
+    totalCents += booking.totalCents;
+  }
+
+  return { groupId, bookings, subtotalCents, discountCents, taxCents, totalCents };
+}

