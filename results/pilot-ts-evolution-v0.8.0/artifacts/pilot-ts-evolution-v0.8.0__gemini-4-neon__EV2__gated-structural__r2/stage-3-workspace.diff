+  );
+
+  // Zero partial bookings committed to room_a or room_b, and room_c unchanged
+  assert.equal(svc.listRoomBookings("room_a").length, 0);
+  assert.equal(svc.listRoomBookings("room_b").length, 0);
+  assert.equal(svc.listRoomBookings("room_c").length, 1);
