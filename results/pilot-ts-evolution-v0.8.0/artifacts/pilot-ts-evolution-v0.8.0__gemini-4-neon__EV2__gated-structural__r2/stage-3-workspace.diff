+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  calculateBookingPrice,
+  createGroupBooking,
+} from "../src/index.ts";
+
+function setupService(): BookingService {
+  const svc = new BookingService({ env: {} });
+  svc.registerRoom({
+    roomId: "room_a",
+    name: "Alpha",
+    hourlyRateCents: 10000,
+    taxBps: 825,
+  });
+  svc.registerRoom({
+    roomId: "room_b",
+    name: "Beta",
+    hourlyRateCents: 7501,
+    taxBps: 500,
+  });
+  svc.registerRoom({
+    roomId: "room_c",
+    name: "Gamma",
+    hourlyRateCents: 4000,
+    taxBps: 0,
+  });
+  return svc;
+}
+
+test("createGroupBooking prices multiple rooms canonically with shared groupId", () => {
+  const svc = setupService();
+
+  // 45-minute multi-room booking with 15% (1500 bps) corporate discount
+  const result = createGroupBooking(svc, {
+    customerId: "corp_1",
+    roomIds: ["room_a", "room_b", "room_c"],
+    startMinute: 60,
+    endMinute: 105,
+    discountBps: 1500,
+  });
+
+  assert.equal(typeof result.groupId, "string");
+  assert.ok(result.groupId.length > 0);
+  assert.equal(result.bookings.length, 3);
+
+  const expectedA = calculateBookingPrice(svc.getRoom("room_a"), 45, { discountBps: 1500 });
+  const expectedB = calculateBookingPrice(svc.getRoom("room_b"), 45, { discountBps: 1500 });
+  const expectedC = calculateBookingPrice(svc.getRoom("room_c"), 45, { discountBps: 1500 });
+
+  // room_a: gross = 7500, discount = 1125, subtotal = 6375, tax = 526, total = 6901
+  assert.equal(expectedA.subtotalCents, 6375);
+  assert.equal(expectedA.discountCents, 1125);
+  assert.equal(expectedA.taxCents, 526);
+  assert.equal(expectedA.totalCents, 6901);
+
+  // room_b: gross = roundHalfUp(7501 * 45, 60) = 5626, discount = roundHalfUp(5626 * 1500, 10000) = 844,
+  // subtotal = 4782, tax = roundHalfUp(4782 * 500, 10000) = 239, total = 5021
+  assert.equal(expectedB.subtotalCents, 4782);
+  assert.equal(expectedB.discountCents, 844);
+  assert.equal(expectedB.taxCents, 239);
+  assert.equal(expectedB.totalCents, 5021);
+
+  // room_c: gross = 3000, discount = 450, subtotal = 2550, tax = 0, total = 2550
+  assert.equal(expectedC.subtotalCents, 2550);
+  assert.equal(expectedC.discountCents, 450);
+  assert.equal(expectedC.taxCents, 0);
+  assert.equal(expectedC.totalCents, 2550);
+
+  const expectedByRoom = [expectedA, expectedB, expectedC];
+  for (let i = 0; i < result.bookings.length; i += 1) {
+    const booking = result.bookings[i];
+    const expected = expectedByRoom[i];
+    assert.equal(booking.groupId, result.groupId);
+    assert.equal(booking.status, "confirmed");
+    assert.equal(booking.subtotalCents, expected.subtotalCents);
+    assert.equal(booking.discountCents, expected.discountCents);
+    assert.equal(booking.taxCents, expected.taxCents);
+    assert.equal(booking.totalCents, expected.totalCents);
+    assert.deepEqual(svc.getBooking(booking.bookingId), booking);
+  }
+
+  assert.equal(result.subtotalCents, 6375 + 4782 + 2550);
+  assert.equal(result.discountCents, 1125 + 844 + 450);
+  assert.equal(result.taxCents, 526 + 239 + 0);
+  assert.equal(result.totalCents, result.subtotalCents + result.taxCents);
+
+  // Back-to-back booking right after group booking succeeds
+  const followUp = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_after",
+    startMinute: 105,
+    endMinute: 150,
+  });
+  assert.equal(followUp.status, "confirmed");
+
+  // Overlapping booking on any member room fails with ConflictError
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "room_b",
+        customerId: "cust_overlap",
+        startMinute: 90,
+        endMinute: 120,
+      }),
+    ConflictError,
+  );
+});
+
+test("createGroupBooking checks all rooms atomically and commits zero partial bookings on conflict", () => {
+  const svc = setupService();
+
+  // Existing confirmed booking only on the last requested room (room_c)
+  svc.createBooking({
+    roomId: "room_c",
+    customerId: "existing_cust",
+    startMinute: 100,
+    endMinute: 160,
+  });
+
