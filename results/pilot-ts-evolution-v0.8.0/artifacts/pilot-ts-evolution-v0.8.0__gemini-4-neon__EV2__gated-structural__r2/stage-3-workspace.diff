+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  ValidationError,
+  applyDiscountAndTax,
+  calculateBookingPrice,
+  computeCancellationRefund,
+  roundHalfUpDiv,
+} from "../src/index.ts";
+import type { Room } from "../src/index.ts";
+
+test("roundHalfUpDiv performs exact integer half-up rounding", () => {
+  assert.equal(roundHalfUpDiv(0, 60), 0);
+  assert.equal(roundHalfUpDiv(120, 60), 2);
+  assert.equal(roundHalfUpDiv(1, 2), 1);
+  assert.equal(roundHalfUpDiv(3, 2), 2);
+  assert.equal(roundHalfUpDiv(5, 2), 3);
+  assert.equal(roundHalfUpDiv(29, 60), 0);
+  assert.equal(roundHalfUpDiv(30, 60), 1);
+  assert.equal(roundHalfUpDiv(31, 60), 1);
+  assert.equal(roundHalfUpDiv(89, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2);
+  assert.equal(roundHalfUpDiv(4999, 10000), 0);
+  assert.equal(roundHalfUpDiv(5000, 10000), 1);
+  assert.equal(roundHalfUpDiv(5001, 10000), 1);
+});
+
+test("roundHalfUpDiv rejects invalid numerator or denominator", () => {
+  assert.throws(() => roundHalfUpDiv(-1, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(1.5, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.NaN, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.POSITIVE_INFINITY, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, 0), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, -2), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, 2.5), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, Number.NaN), ValidationError);
+});
+
+test("calculateBookingPrice supports fractional durations with integer half-up rounding", () => {
+  const oddRateRoom: Room = {
+    roomId: "studio_1",
+    name: "Studio 1",
+    hourlyRateCents: 1001,
+    taxBps: 750,
+  };
+
+  // 1001 * 30 / 60 = 500.5 -> 501 cents; tax = 501 * 750 / 10000 = 37.575 -> 38 cents
+  const halfHour = calculateBookingPrice(oddRateRoom, 30);
+  assert.equal(halfHour.subtotalCents, 501);
+  assert.equal(halfHour.discountCents, 0);
+  assert.equal(halfHour.taxCents, 38);
+  assert.equal(halfHour.totalCents, 539);
+  assert.equal(halfHour.depositCents, 0);
+
+  const evenRateRoom: Room = {
+    roomId: "studio_2",
+    name: "Studio 2",
+    hourlyRateCents: 1000,
+    taxBps: 825,
+  };
+
+  // 1000 * 20 / 60 = 333.333... -> 333 cents; tax = 333 * 825 / 10000 = 27.4725 -> 27 cents
+  const twentyMin = calculateBookingPrice(evenRateRoom, 20);
+  assert.equal(twentyMin.subtotalCents, 333);
+  assert.equal(twentyMin.taxCents, 27);
+  assert.equal(twentyMin.totalCents, 360);
+
+  // 1000 * 40 / 60 = 666.666... -> 667 cents; tax = 667 * 825 / 10000 = 55.0275 -> 55 cents
+  const fortyMin = calculateBookingPrice(evenRateRoom, 40, { legacyDepositMode: true });
+  assert.equal(fortyMin.subtotalCents, 667);
+  assert.equal(fortyMin.taxCents, 55);
+  assert.equal(fortyMin.totalCents, 722);
+  // deposit = 667 * 2500 / 10000 = 166.75 -> 167 cents
+  assert.equal(fortyMin.depositCents, 167);
+
+  // 1-minute duration: 1000 * 1 / 60 = 16.666... -> 17 cents
+  const oneMin = calculateBookingPrice(evenRateRoom, 1);
+  assert.equal(oneMin.subtotalCents, 17);
+});
+
+test("calculateBookingPrice rejects invalid durationMinutes", () => {
+  const room: Room = {
+    roomId: "studio_3",
+    name: "Studio 3",
+    hourlyRateCents: 6000,
+    taxBps: 500,
+  };
+
+  assert.throws(() => calculateBookingPrice(room, 0), ValidationError);
+  assert.throws(() => calculateBookingPrice(room, -15), ValidationError);
+  assert.throws(() => calculateBookingPrice(room, 30.5), ValidationError);
+});
+
+test("applyDiscountAndTax computes exact half-up discount, net subtotal, tax, and total", () => {
+  // Zero discount
+  assert.deepEqual(applyDiscountAndTax(10000, 0, 825), {
+    subtotalCents: 10000,
+    discountCents: 0,
+    taxCents: 825,
+    totalCents: 10825,
+  });
+
+  // Exact half-up boundary on discount: 1010 * 500 / 10000 = 50.5 -> 51
+  // net subtotal = 1010 - 51 = 959; tax = 959 * 825 / 10000 = 79.1175 -> 79
+  assert.deepEqual(applyDiscountAndTax(1010, 500, 825), {
+    subtotalCents: 959,
+    discountCents: 51,
+    taxCents: 79,
+    totalCents: 1038,
+  });
+
+  // Full 100% discount (10000 bps)
+  assert.deepEqual(applyDiscountAndTax(2500, 10000, 1000), {
+    subtotalCents: 0,
+    discountCents: 2500,
+    taxCents: 0,
+    totalCents: 0,
+  });
+
+  // 1 cent at 50% discount -> 0.5 rounds up to 1
+  assert.deepEqual(applyDiscountAndTax(1, 5000, 1000), {
+    subtotalCents: 0,
+    discountCents: 1,
+    taxCents: 0,
+    totalCents: 0,
+  });
+});
+
+test("applyDiscountAndTax validates integer bounds", () => {
+  assert.throws(() => applyDiscountAndTax(-1, 0, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100.5, 0, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, -1, 500), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 10001, 500), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 12.5, 500), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 500, -1), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 500, 10001), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 500, 8.25), ValidationError);
+});
+
+test("calculateBookingPrice applies optional discountBps via applyDiscountAndTax", () => {
+  const room: Room = {
+    roomId: "studio_disc",
+    name: "Studio Discount",
+    hourlyRateCents: 4000,
+    taxBps: 1000,
+  };
+
+  // 45 min -> gross = 3000; 15% discount = 450 -> net subtotal = 2550; tax = 255; total = 2805; deposit = 638 (2550 * 0.25 = 637.5 -> 638)
+  const breakdown = calculateBookingPrice(room, 45, {
+    discountBps: 1500,
+    legacyDepositMode: true,
+  });
+  assert.deepEqual(breakdown, {
+    subtotalCents: 2550,
+    discountCents: 450,
+    taxCents: 255,
+    totalCents: 2805,
+    depositCents: 638,
+  });
+});
+
+test("computeCancellationRefund computes exact half-up fee and refund", () => {
+  assert.deepEqual(computeCancellationRefund(10000, 0), {
+    feeCents: 0,
+    refundCents: 10000,
+  });
+  assert.deepEqual(computeCancellationRefund(10000, 10000), {
+    feeCents: 10000,
+    refundCents: 0,
+  });
+  // Exact 0.5 boundary: 1010 * 500 / 10000 = 50.5 -> 51
+  assert.deepEqual(computeCancellationRefund(1010, 500), {
+    feeCents: 51,
+    refundCents: 959,
+  });
+  assert.deepEqual(computeCancellationRefund(1, 5000), {
+    feeCents: 1,
+    refundCents: 0,
+  });
+  assert.deepEqual(computeCancellationRefund(0, 2500), {
+    feeCents: 0,
+    refundCents: 0,
+  });
+
+  assert.throws(() => computeCancellationRefund(-1, 500), ValidationError);
+  assert.throws(() => computeCancellationRefund(10.5, 500), ValidationError);
+  assert.throws(() => computeCancellationRefund(1000, -1), ValidationError);
+  assert.throws(() => computeCancellationRefund(1000, 10001), ValidationError);
+  assert.throws(() => computeCancellationRefund(1000, 12.5), ValidationError);
+});
