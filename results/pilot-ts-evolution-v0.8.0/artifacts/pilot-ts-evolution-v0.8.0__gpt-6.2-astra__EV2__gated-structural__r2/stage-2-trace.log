{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cd benchmarks/sources/ev2_ts_bookings/tests && cat > corporate.test.ts <<'EOF'\nimport assert from \\\"node:assert/strict\\\";\nimport test from \\\"node:test\\\";\nimport {\n  BookingService,\n  ConflictError,\n  ValidationError,\n  applyDiscountAndTax,\n  createGroupBooking,\n} from \\\"../src/index.ts\\\";\n\nconst request = {\n  roomIds: [\\\"A\\\", \\\"B\\\"], customerId: \\\"company\\\", startMinute: 30, endMinute: 60, discountBps: 5000,\n};\n\nfunction setup() {\n  const service = new BookingService({ env: {} });\n  service.registerRoom({ roomId: \\\"A\\\", name: \\\"A\\\", hourlyRateCents: 202, taxBps: 1000 });\n  service.registerRoom({ roomId: \\\"B\\\", name: \\\"B\\\", hourlyRateCents: 206, taxBps: 5000 });\n  return service;\n}\n\ntest(\\\"group totals sum each room's rounded discount and tax\\\", () => {\n  const service = setup();\n  const group = createGroupBooking(service, request);\n  const { groupId, bookings, ...totals } = group;\n  assert.ok(groupId);\n  assert.deepEqual(totals, { subtotalCents: 101, discountCents: 103, taxCents: 31, totalCents: 132 });\n  assert.deepEqual(\n    bookings.map(b => [b.roomId, b.subtotalCents, b.discountCents, b.taxCents, b.totalCents]),\n    [[\\\"A\\\", 50, 51, 5, 55], [\\\"B\\\", 51, 52, 26, 77]],\n  );\n  for (const booking of bookings) {\n    assert.equal(booking.groupId, groupId);\n    assert.equal(booking.status, \\\"confirmed\\\");\n    assert.deepEqual(service.getBooking(booking.bookingId), booking);\n  }\n  const next = createGroupBooking(service, { ...request, startMinute: 60, endMinute: 90 });\n  assert.notEqual(next.groupId, groupId);\n});\n\ntest(\\\"a live hold in the last room rejects the entire group until expiration\\\", () => {\n  const service = setup();\n  const held = service.createBooking({\n    roomId: \\\"B\\\", customerId: \\\"guest\\\", startMinute: 59, endMinute: 70, holdMinutes: 5,\n  });\n  assert.throws(() => createGroupBooking(service, { ...request, nowMinute: 4 }), ConflictError);\n  assert.deepEqual(service.listRoomBookings(\\\"A\\\"), []);\n  assert.deepEqual(service.listRoomBookings(\\\"B\\\"), [held]);\n  assert.equal(createGroupBooking(service, { ...request, nowMinute: 5 }).bookings.length, 2);\n});\n\ntest(\\\"invalid groups leave every room available\\\", () => {\n  const service = setup();\n  for (const change of [\n    { roomIds: [] }, { roomIds: [\\\"A\\\"] }, { roomIds: [\\\"A\\\", \\\"A\\\"] }, { roomIds: [\\\"A\\\", \\\"unknown\\\"] },\n    { discountBps: -1 }, { discountBps: 10001 }, { discountBps: 1.5 },\n    { customerId: \\\" \\\" }, { endMinute: request.startMinute }, { nowMinute: -1 },\n  ]) {\n    assert.throws(() => createGroupBooking(service, { ...request, ...change }), ValidationError);\n    assert.deepEqual(service.listRoomBookings(\\\"A\\\"), []);\n    assert.deepEqual(service.listRoomBookings(\\\"B\\\"), []);\n  }\n});\n\ntest(\\\"discount and tax accept both rate limits and validate even a zero taxable amount\\\", () => {\n  assert.deepEqual(applyDiscountAndTax(15, 0, 10000), {\n    subtotalCents: 15, discountCents: 0, taxCents: 15, totalCents: 30,\n  });\n  assert.deepEqual(applyDiscountAndTax(15, 10000, 0), {\n    subtotalCents: 0, discountCents: 15, taxCents: 0, totalCents: 0,\n  });\n  for (const rate of [-1, 0.5, 10001]) {\n    assert.throws(() => applyDiscountAndTax(0, rate, 0), ValidationError);\n    assert.throws(() => applyDiscountAndTax(0, 0, rate), ValidationError);\n  }\n  assert.throws(() => applyDiscountAndTax(-1, 0, 0), ValidationError);\n});\nEOF\ncd ../../../.. && node benchmarks/sources/ev2_ts_bookings/run_checks.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
