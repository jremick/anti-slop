nfirmed\\\");\n  assert.throws(() => service.confirmHold(held.bookingId, 13), ValidationError);\n  assert.equal(isBookingActiveAt({ ...held, expiresAt: undefined }, 0), false);\n  assert.equal(isBookingActiveAt({ ...held, status: \\\"cancelled\\\" }, 0), false);\n});\n\ntest(\\\"confirmation persists and keeps the slot occupied past the original expiry\\\", () => {\n  const service = setup();\n  const held = service.createBooking({ ...slot, holdMinutes: 5 });\n  assert.equal(held.expiresAt, 5);\n  const confirmed = service.confirmHold(held.bookingId, 4);\n  assert.equal(confirmed.status, \\\"confirmed\\\");\n  assert.equal(confirmed.expiresAt, undefined);\n  assert.deepEqual(service.getBooking(held.bookingId), confirmed);\n  assert.throws(() => service.createBooking({ ...slot, nowMinute: 6 }), ConflictError);\n  assert.throws(() => service.confirmHold(held.bookingId, 4), ValidationError);\n  assert.throws(() => service.confirmHold(\\\"missing\\\", 4), ValidationError);\n});\n\ntest(\\\"invalid hold lengths leave the slot available\\\", () => {\n  const service = setup();\n  for (const holdMinutes of [-1, 0, 1.5, 6]) {\n    assert.throws(() => service.createBooking({ ...slot, holdMinutes }), ValidationError);\n  }\n  assert.equal(service.createBooking(slot).status, \\\"confirmed\\\");\n});\nEOF\ncat > tests/pricing.test.ts <<'EOF'\nimport assert from \\\"node:assert/strict\\\";\nimport test from \\\"node:test\\\";\nimport { ValidationError, calculateBookingPrice, roundHalfUpDiv } from \\\"../src/index.ts\\\";\n\ntest(\\\"integer division rounds ties up and rejects invalid operands\\\", () => {\n  for (const [numerator, denominator, expected] of [[0, 2, 0], [14, 10, 1], [15, 10, 2], [16, 10, 2], [8, 3, 3]]) {\n    assert.equal(roundHalfUpDiv(numerator, denominator), expected);\n  }\n  for (const [numerator, denominator] of [[-1, 2], [1.5, 2], [1, 0], [1, -2], [1, 2.5]]) {\n    assert.throws(() => roundHalfUpDiv(numerator, denominator), ValidationError);\n  }\n});\n\ntest(\\\"one minute at 90 cents per hour rounds to two cents before tax and deposit\\\", () => {\n  const room = { roomId: \\\"A\\\", name: \\\"Room A\\\", hourlyRateCents: 90, taxBps: 2500 };\n  assert.deepEqual(calculateBookingPrice(room, 1, { legacyDepositMode: true }), {\n    subtotalCents: 2, taxCents: 1, depositCents: 1, totalCents: 3, discountCents: 0,\n  });\n  for (const duration of [0, -1, 1.5]) {\n    assert.throws(() => calculateBookingPrice(room, duration), ValidationError);\n  }\n});\nEOF\nnode run_checks.mjs\"","aggregated_output":"✔ baseline whole-hour booking computes exact subtotal and tax (1.705208ms)\n✔ baseline legacy deposit mode calculates 25 percent deposit (0.102208ms)\n✔ baseline rejects invalid room or inverted time range (0.630375ms)\n✔ confirmed bookings block every overlapping shape in the same room (1.727833ms)\n✔ a held slot becomes available at the expiration minute (1.389542ms)\n✔ confirmation persists and keeps the slot occupied past the original expiry (0.213875ms)\n✔ invalid hold lengths leave the slot available (0.105375ms)\n✔ integer division rounds ties up and rejects invalid operands (1.061125ms)\n✔ one minute at 90 cents per hour rounds to two cents before tax and deposit (1.022167ms)\nℹ tests 9\nℹ suites 0\nℹ pass 9\nℹ fail 0\nℹ cancelled 0\nℹ skipped 0\nℹ todo 0\nℹ duration_ms 336.345917\n","exit_code":0,"status":"completed"}}
