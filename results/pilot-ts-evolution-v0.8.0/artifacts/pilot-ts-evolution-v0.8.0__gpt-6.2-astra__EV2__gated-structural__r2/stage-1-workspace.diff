+import assert from "node:assert/strict";
+import test from "node:test";
+import { ValidationError, calculateBookingPrice, roundHalfUpDiv } from "../src/index.ts";
+
+test("integer division rounds ties up and rejects invalid operands", () => {
+  for (const [numerator, denominator, expected] of [[0, 2, 0], [14, 10, 1], [15, 10, 2], [16, 10, 2], [8, 3, 3]]) {
+    assert.equal(roundHalfUpDiv(numerator, denominator), expected);
+  }
+  for (const [numerator, denominator] of [[-1, 2], [1.5, 2], [1, 0], [1, -2], [1, 2.5]]) {
+    assert.throws(() => roundHalfUpDiv(numerator, denominator), ValidationError);
+  }
+});
+
+test("one minute at 90 cents per hour rounds to two cents before tax and deposit", () => {
+  const room = { roomId: "A", name: "Room A", hourlyRateCents: 90, taxBps: 2500 };
+  assert.deepEqual(calculateBookingPrice(room, 1, { legacyDepositMode: true }), {
+    subtotalCents: 2, taxCents: 1, depositCents: 1, totalCents: 3, discountCents: 0,
+  });
+  for (const duration of [0, -1, 1.5]) {
+    assert.throws(() => calculateBookingPrice(room, duration), ValidationError);
+  }
+});
