+import assert from "node:assert/strict";
+import test from "node:test";
+import { BookingService, ConflictError, createGroupBooking } from "../src/index.ts";
+import type { BookingNotification } from "../src/index.ts";
+
+const slot = { customerId: "client", roomId: "A", startMinute: 60, endMinute: 120 };
+const group = { ...slot, roomIds: ["A", "B"], discountBps: 5000 };
+
+function setup(notifyHook: (event: BookingNotification) => void) {
+  const service = new BookingService({
+    notifyHook,
+    env: {
+      BOOKING_CANCEL_FEE_TIERS_JSON: JSON.stringify({ cutoffMinutes: 30, earlyFeeBps: 2500, lateFeeBps: 5000 }),
+    },
+  });
+  for (const [roomId, rate] of [["A", 100], ["B", 200]] as const) {
+    service.registerRoom({ roomId, name: roomId, hourlyRateCents: rate, taxBps: 1000 });
+  }
+  return service;
+}
+
+test("notifications carry the billed room total on creation and the refund on cancellation", () => {
+  const events: BookingNotification[] = [];
+  const service = setup(event => events.push(event));
+  const held = service.createBooking({ ...slot, holdMinutes: 10 });
+  service.confirmHold(held.bookingId, 1);
+  service.cancelBooking(held.bookingId, 1);
+  const { bookings: [a, b] } = createGroupBooking(service, group);
+
+  assert.deepEqual(events, [
+    { event: "booking_created", bookingId: held.bookingId, roomId: "A", customerId: "client", amountCents: 110 },
+    { event: "booking_cancelled", bookingId: held.bookingId, roomId: "A", customerId: "client", amountCents: 82 },
+    { event: "booking_created", bookingId: a.bookingId, roomId: "A", customerId: "client", amountCents: 55 },
+    { event: "booking_created", bookingId: b.bookingId, roomId: "B", customerId: "client", amountCents: 110 },
+  ]);
+});
+
+test("a rejected creation leaves its slot available for retry", () => {
+  const failure = new Error("delivery failed");
+  let reject = true;
+  const service = setup(() => { if (reject) throw failure; });
+  assert.throws(() => service.createBooking(slot), error => error === failure);
+  assert.deepEqual(service.listRoomBookings("A"), []);
+  reject = false;
+  assert.equal(service.createBooking(slot).status, "confirmed");
+});
+
+test("failure on the second room leaves the entire group uncommitted", () => {
+  const failure = new Error("second delivery failed");
+  const attempted: string[] = [];
+  const service = setup(event => {
+    attempted.push(event.roomId);
+    if (event.roomId === "B") throw failure;
+  });
+  const existing = service.createBooking({ ...slot, startMinute: 0, endMinute: 60 });
+  attempted.length = 0;
+  assert.throws(() => createGroupBooking(service, group), error => error === failure);
+  assert.deepEqual(attempted, ["A", "B"]);
+  assert.deepEqual(service.listRoomBookings("A"), [existing]);
+  assert.deepEqual(service.listRoomBookings("B"), []);
+});
+
+test("a rejected cancellation preserves the booking and its conflict protection", () => {
+  const failure = new Error("refund notification failed");
+  const service = setup(event => {
+    if (event.event === "booking_cancelled") throw failure;
+  });
+  const held = service.createBooking({ ...slot, holdMinutes: 5 });
+  assert.throws(() => service.cancelBooking(held.bookingId, 1), error => error === failure);
+  assert.deepEqual(service.getBooking(held.bookingId), held);
+  assert.throws(() => service.createBooking({ ...slot, nowMinute: 1 }), ConflictError);
+});
+
+test("a hook cannot book a room while the original creation is pending", () => {
+  const service: BookingService = setup(() => service.createBooking(slot));
+  assert.throws(() => service.createBooking(slot), ConflictError);
+  assert.deepEqual(service.listRoomBookings("A"), []);
+});

