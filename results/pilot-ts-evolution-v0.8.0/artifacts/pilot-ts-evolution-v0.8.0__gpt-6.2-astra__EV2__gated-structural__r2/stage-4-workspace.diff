+export interface CancellationFeeConfig {
+  readonly cutoffMinutes: number;
+  readonly earlyFeeBps: number;
+  readonly lateFeeBps: number;
+}
+
+export function loadCancellationFeeConfig(
+  env: Record<string, string | undefined> = process.env,
+): CancellationFeeConfig {
+  const raw = env.BOOKING_CANCEL_FEE_TIERS_JSON;
+  if (typeof raw !== "string" || raw.trim() === "") {
+    throw new ConfigError("BOOKING_CANCEL_FEE_TIERS_JSON is required");
+  }
+
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(raw);
+  } catch {
+    throw new ConfigError("BOOKING_CANCEL_FEE_TIERS_JSON must contain valid JSON");
+  }
+  if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) {
+    throw new ConfigError("BOOKING_CANCEL_FEE_TIERS_JSON must contain an object");
+  }
+
+  const { cutoffMinutes, earlyFeeBps, lateFeeBps } = parsed as Record<string, unknown>;
+  if (typeof cutoffMinutes !== "number" || !Number.isInteger(cutoffMinutes) || cutoffMinutes < 0) {
+    throw new ConfigError("cutoffMinutes must be a non-negative integer");
+  }
+  return {
+    cutoffMinutes,
+    earlyFeeBps: readFeeBps(earlyFeeBps, "earlyFeeBps"),
+    lateFeeBps: readFeeBps(lateFeeBps, "lateFeeBps"),
+  };
+}
+
+function readFeeBps(value: unknown, field: string): number {
+  if (typeof value !== "number" || !Number.isInteger(value) || value < 0 || value > 10000) {
+    throw new ConfigError(`${field} must be an integer between 0 and 10000`);
+  }
+  return value;
+}
+
+export function selectCancellationFeeBps(minutesBeforeStart: number, cfg: CancellationFeeConfig): number {
+  return minutesBeforeStart >= cfg.cutoffMinutes ? cfg.earlyFeeBps : cfg.lateFeeBps;
+}

