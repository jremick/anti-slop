+import assert from "node:assert/strict";
+import test from "node:test";
+import { BookingService, ConflictError, ValidationError, isBookingActiveAt, slotsOverlap } from "../src/index.ts";
+
+const room = { roomId: "A", name: "Room A", hourlyRateCents: 150, taxBps: 0 };
+const slot = { roomId: "A", customerId: "guest", startMinute: 30, endMinute: 40 };
+
+function setup() {
+  const service = new BookingService({ env: { BOOKING_MAX_HOLD_MINUTES: "5" } });
+  service.registerRoom(room);
+  return service;
+}
+
+test("confirmed bookings block every overlapping shape in the same room", () => {
+  const service = setup();
+  service.createBooking(slot);
+  for (const [startMinute, endMinute] of [[25, 31], [39, 42], [32, 37], [29, 41], [30, 40]]) {
+    assert.ok(slotsOverlap(30, 40, startMinute, endMinute));
+    assert.throws(() => service.createBooking({ ...slot, startMinute, endMinute }), ConflictError);
+  }
+  service.createBooking({ ...slot, startMinute: 20, endMinute: 30 });
+  service.createBooking({ ...slot, startMinute: 40, endMinute: 50 });
+  service.registerRoom({ ...room, roomId: "B" });
+  service.createBooking({ ...slot, roomId: "B" });
+  assert.equal(service.listRoomBookings("A").length, 3);
+});
+
+test("a held slot becomes available at the expiration minute", () => {
+  const service = setup();
+  const held = service.createBooking({ ...slot, nowMinute: 7, holdMinutes: 5 });
+  assert.equal(held.status, "held");
+  assert.equal(held.expiresAt, 12);
+  assert.throws(() => service.createBooking({ ...slot, nowMinute: 11 }), ConflictError);
+  assert.throws(() => service.confirmHold(held.bookingId, 12), ValidationError);
+  assert.equal(service.createBooking({ ...slot, nowMinute: 12 }).status, "confirmed");
+  assert.throws(() => service.confirmHold(held.bookingId, 13), ValidationError);
+  assert.equal(isBookingActiveAt({ ...held, expiresAt: undefined }, 0), false);
+  assert.equal(isBookingActiveAt({ ...held, status: "cancelled" }, 0), false);
+});
+
+test("confirmation persists and keeps the slot occupied past the original expiry", () => {
+  const service = setup();
+  const held = service.createBooking({ ...slot, holdMinutes: 5 });
+  assert.equal(held.expiresAt, 5);
+  const confirmed = service.confirmHold(held.bookingId, 4);
+  assert.equal(confirmed.status, "confirmed");
+  assert.equal(confirmed.expiresAt, undefined);
+  assert.deepEqual(service.getBooking(held.bookingId), confirmed);
+  assert.throws(() => service.createBooking({ ...slot, nowMinute: 6 }), ConflictError);
+  assert.throws(() => service.confirmHold(held.bookingId, 4), ValidationError);
+  assert.throws(() => service.confirmHold("missing", 4), ValidationError);
+});
+
+test("invalid hold lengths leave the slot available", () => {
+  const service = setup();
+  for (const holdMinutes of [-1, 0, 1.5, 6]) {
+    assert.throws(() => service.createBooking({ ...slot, holdMinutes }), ValidationError);
+  }
+  assert.equal(service.createBooking(slot).status, "confirmed");
+});

