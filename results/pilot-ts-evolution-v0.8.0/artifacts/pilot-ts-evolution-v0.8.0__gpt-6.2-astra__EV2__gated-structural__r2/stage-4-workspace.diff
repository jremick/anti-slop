+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  BookingService,
+  ConfigError,
+  ConflictError,
+  ValidationError,
+  computeCancellationRefund,
+  loadCancellationFeeConfig,
+  selectCancellationFeeBps,
+} from "../src/index.ts";
+
+const tiers = { cutoffMinutes: 30, earlyFeeBps: 1000, lateFeeBps: 5000 };
+const slot = { roomId: "A", customerId: "guest", startMinute: 60, endMinute: 120 };
+
+function setup(raw: string | undefined) {
+  const service = new BookingService({ env: { BOOKING_CANCEL_FEE_TIERS_JSON: raw } });
+  service.registerRoom({ roomId: "A", name: "Room A", hourlyRateCents: 100, taxBps: 500 });
+  return { service, booking: service.createBooking(slot) };
+}
+
+test("cancellation uses the tax-inclusive total and includes the cutoff in the early tier", () => {
+  for (const [nowMinute, feeBps, feeCents, refundCents] of [
+    [29, 1000, 11, 94], [30, 1000, 11, 94], [31, 5000, 53, 52], [60, 5000, 53, 52],
+  ]) {
+    const { service, booking } = setup(JSON.stringify(tiers));
+    const result = service.cancelBooking(booking.bookingId, nowMinute);
+    const cancelled = { ...booking, status: "cancelled" };
+    assert.deepEqual(result, { booking: cancelled, feeBps, feeCents, refundCents });
+    assert.deepEqual(service.getBooking(booking.bookingId), cancelled);
+    assert.throws(() => service.cancelBooking(booking.bookingId, nowMinute), ValidationError);
+    assert.equal(service.createBooking({ ...slot, nowMinute }).status, "confirmed");
+  }
+});
+
+test("missing or malformed fee tiers leave the original booking occupying its slot", () => {
+  const invalid = [
+    undefined, "", "  ", "{", "null", "[]", "42", "{}", '{"cutoffMinutes":30}',
+    ...[-1, 0.5, "30"].map(cutoffMinutes => JSON.stringify({ ...tiers, cutoffMinutes })),
+  ];
+  for (const field of ["earlyFeeBps", "lateFeeBps"]) {
+    for (const value of [undefined, null, "10", -1, 0.5, 10001]) {
+      invalid.push(JSON.stringify({ ...tiers, [field]: value }));
+    }
+  }
+  for (const raw of invalid) {
+    const { service, booking } = setup(raw);
+    assert.throws(() => service.cancelBooking(booking.bookingId, 30), ConfigError);
+    assert.deepEqual(service.getBooking(booking.bookingId), booking);
+    assert.throws(() => service.createBooking(slot), ConflictError);
+  }
+});
+
+test("unknown bookings and cancellations past the start are rejected before reading tiers", () => {
+  const { service, booking } = setup(undefined);
+  assert.throws(() => service.cancelBooking("missing", 0), ValidationError);
+  assert.throws(() => service.cancelBooking(booking.bookingId, 61), ValidationError);
+  assert.equal(service.getBooking(booking.bookingId).status, "confirmed");
+});
+
+test("fee configuration admits zero cutoff, zero fee and full fee", () => {
+  const cfg = { cutoffMinutes: 0, earlyFeeBps: 0, lateFeeBps: 10000 };
+  assert.deepEqual(loadCancellationFeeConfig({ BOOKING_CANCEL_FEE_TIERS_JSON: JSON.stringify(cfg) }), cfg);
+  assert.equal(selectCancellationFeeBps(0, cfg), 0);
+  assert.deepEqual(computeCancellationRefund(37, 0), { feeCents: 0, refundCents: 37 });
+  assert.deepEqual(computeCancellationRefund(37, 10000), { feeCents: 37, refundCents: 0 });
+  for (const [total, fee] of [[-1, 0], [1.5, 0], [0, -1], [0, 1.5], [0, 10001]]) {
+    assert.throws(() => computeCancellationRefund(total, fee), ValidationError);
+  }
+});

