{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cat > benchmarks/sources/ev2_ts_bookings/tests/notifications.test.ts <<'EOF'\nimport assert from \\\"node:assert/strict\\\";\nimport test from \\\"node:test\\\";\nimport { BookingService, ConflictError, createGroupBooking } from \\\"../src/index.ts\\\";\nimport type { BookingNotification } from \\\"../src/index.ts\\\";\n\nconst slot = { customerId: \\\"client\\\", roomId: \\\"A\\\", startMinute: 60, endMinute: 120 };\nconst group = { ...slot, roomIds: [\\\"A\\\", \\\"B\\\"], discountBps: 5000 };\n\nfunction setup(notifyHook: (event: BookingNotification) => void) {\n  const service = new BookingService({\n    notifyHook,\n    env: {\n      BOOKING_CANCEL_FEE_TIERS_JSON: JSON.stringify({ cutoffMinutes: 30, earlyFeeBps: 2500, lateFeeBps: 5000 }),\n    },\n  });\n  for (const [roomId, rate] of [[\\\"A\\\", 100], [\\\"B\\\", 200]] as const) {\n    service.registerRoom({ roomId, name: roomId, hourlyRateCents: rate, taxBps: 1000 });\n  }\n  return service;\n}\n\ntest(\\\"notifications carry the billed room total on creation and the refund on cancellation\\\", () => {\n  const events: BookingNotification[] = [];\n  const service = setup(event => events.push(event));\n  const held = service.createBooking({ ...slot, holdMinutes: 10 });\n  service.confirmHold(held.bookingId, 1);\n  service.cancelBooking(held.bookingId, 1);\n  const { bookings: [a, b] } = createGroupBooking(service, group);\n\n  assert.deepEqual(events, [\n    { event: \\\"booking_created\\\", bookingId: held.bookingId, roomId: \\\"A\\\", customerId: \\\"client\\\", amountCents: 110 },\n    { event: \\\"booking_cancelled\\\", bookingId: held.bookingId, roomId: \\\"A\\\", customerId: \\\"client\\\", amountCents: 82 },\n    { event: \\\"booking_created\\\", bookingId: a.bookingId, roomId: \\\"A\\\", customerId: \\\"client\\\", amountCents: 55 },\n    { event: \\\"booking_created\\\", bookingId: b.bookingId, roomId: \\\"B\\\", customerId: \\\"client\\\", amountCents: 110 },\n  ]);\n});\n\ntest(\\\"a rejected creation leaves its slot available for retry\\\", () => {\n  const failure = new Error(\\\"delivery failed\\\");\n  let reject = true;\n  const service = setup(() => { if (reject) throw failure; });\n  assert.throws(() => service.createBooking(slot), error => error === failure);\n  assert.deepEqual(service.listRoomBookings(\\\"A\\\"), []);\n  reject = false;\n  assert.equal(service.createBooking(slot).status, \\\"confirmed\\\");\n});\n\ntest(\\\"failure on the second room leaves the entire group uncommitted\\\", () => {\n  const failure = new Error(\\\"second delivery failed\\\");\n  const attempted: string[] = [];\n  const service = setup(event => {\n    attempted.push(event.roomId);\n    if (event.roomId === \\\"B\\\") throw failure;\n  });\n  const existing = service.createBooking({ ...slot, startMinute: 0, endMinute: 60 });\n  attempted.length = 0;\n  assert.throws(() => createGroupBooking(service, group), error => error === failure);\n  assert.deepEqual(attempted, [\\\"A\\\", \\\"B\\\"]);\n  assert.deepEqual(service.listRoomBookings(\\\"A\\\"), [existing]);\n  assert.deepEqual(service.listRoomBookings(\\\"B\\\"), []);\n});\n\ntest(\\\"a rejected cancellation preserves the booking and its conflict protection\\\", () => {\n  const failure = new Error(\\\"refund notification failed\\\");\n  const service = setup(event => {\n    if (event.event === \\\"booking_cancelled\\\") throw failure;\n  });\n  const held = service.createBooking({ ...slot, holdMinutes: 5 });\n  assert.throws(() => service.cancelBooking(held.bookingId, 1), error => error === failure);\n  assert.deepEqual(service.getBooking(held.bookingId), held);\n  assert.throws(() => service.createBooking({ ...slot, nowMinute: 1 }), ConflictError);\n});\n\ntest(\\\"a hook cannot book a room while the original creation is pending\\\", () => {\n  const service: BookingService = setup(() => service.createBooking(slot));\n  assert.throws(() => service.createBooking(slot), ConflictError);\n  assert.deepEqual(service.listRoomBookings(\\\"A\\\"), []);\n});\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
