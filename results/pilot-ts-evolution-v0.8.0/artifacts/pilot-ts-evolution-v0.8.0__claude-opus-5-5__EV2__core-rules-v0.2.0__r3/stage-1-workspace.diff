+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  calculateBookingPrice,
+  isBookingActiveAt,
+  roundHalfUpDiv,
+  slotsOverlap,
+} from "../src/index.ts";
+import type { Booking } from "../src/index.ts";
+
+function makeService(env: Record<string, string | undefined> = {}): BookingService {
+  const svc = new BookingService({ env });
+  svc.registerRoom({ roomId: "r1", name: "Room 1", hourlyRateCents: 10000, taxBps: 825 });
+  svc.registerRoom({ roomId: "r2", name: "Room 2", hourlyRateCents: 6000, taxBps: 0 });
+  return svc;
+}
+
+function slot(roomId: string, startMinute: number, endMinute: number, extra: object = {}) {
+  return { roomId, customerId: "cust", startMinute, endMinute, ...extra };
+}
+
+test("roundHalfUpDiv rounds exact halves up and other values to nearest", () => {
+  assert.equal(roundHalfUpDiv(0, 60), 0);
+  assert.equal(roundHalfUpDiv(29, 60), 0);
+  assert.equal(roundHalfUpDiv(30, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2);
+  assert.equal(roundHalfUpDiv(150, 60), 3); // half-up, not banker's rounding
+  assert.equal(roundHalfUpDiv(149, 60), 2);
+  assert.equal(roundHalfUpDiv(120, 60), 2);
+  assert.equal(roundHalfUpDiv(5, 2), 3);
+  assert.equal(roundHalfUpDiv(7, 1), 7);
+});
+
+test("roundHalfUpDiv rejects invalid operands with ValidationError", () => {
+  for (const [n, d] of [
+    [1.5, 60],
+    [-1, 60],
+    [10, 0],
+    [10, -60],
+    [10, 2.5],
+    [Number.NaN, 60],
+    [Number.MAX_SAFE_INTEGER, 60],
+  ] as const) {
+    assert.throws(() => roundHalfUpDiv(n, d), ValidationError, `(${n}, ${d})`);
+  }
+});
+
+test("calculateBookingPrice supports partial-hour durations with exact rounding", () => {
+  const room = { roomId: "x", name: "X", hourlyRateCents: 10000, taxBps: 825 };
+  const p90 = calculateBookingPrice(room, 90);
+  assert.equal(p90.subtotalCents, 15000);
+  assert.equal(p90.taxCents, 1238); // 1237.5 rounds up
+  assert.equal(p90.totalCents, 16238);
+
+  const odd = { roomId: "y", name: "Y", hourlyRateCents: 1001, taxBps: 0 };
+  assert.equal(calculateBookingPrice(odd, 1).subtotalCents, 17); // 16.683...
+  const half = { roomId: "z", name: "Z", hourlyRateCents: 30, taxBps: 0 };
+  assert.equal(calculateBookingPrice(half, 1).subtotalCents, 1); // exactly 0.5
+  assert.equal(calculateBookingPrice(room, 120).subtotalCents, 20000);
+
+  assert.throws(() => calculateBookingPrice(room, 0), ValidationError);
+  assert.throws(() => calculateBookingPrice(room, 1.5), ValidationError);
+  assert.throws(() => calculateBookingPrice(room, -30), ValidationError);
+});
+
+test("legacy deposit uses the rounded partial-hour subtotal", () => {
+  const room = { roomId: "x", name: "X", hourlyRateCents: 1001, taxBps: 0 };
+  const price = calculateBookingPrice(room, 1, { legacyDepositMode: true });
+  assert.equal(price.subtotalCents, 17);
+  assert.equal(price.depositCents, 4); // 4.25 -> 4
+});
+
+test("createBooking prices a 45-minute booking", () => {
+  const svc = makeService();
+  const b = svc.createBooking(slot("r1", 0, 45));
+  assert.equal(b.subtotalCents, 7500);
+  assert.equal(b.taxCents, 619); // 618.75
+  assert.equal(b.totalCents, 8119);
+});
+
+test("slotsOverlap uses half-open intervals", () => {
+  assert.equal(slotsOverlap(0, 60, 60, 120), false);
+  assert.equal(slotsOverlap(60, 120, 0, 60), false);
+  assert.equal(slotsOverlap(0, 60, 59, 120), true);
+  assert.equal(slotsOverlap(0, 120, 30, 60), true);
+  assert.equal(slotsOverlap(30, 60, 0, 120), true);
+  assert.equal(slotsOverlap(0, 60, 0, 60), true);
+  assert.equal(slotsOverlap(0, 60, 120, 180), false);
+});
+
+test("isBookingActiveAt handles confirmed, held, expired and cancelled", () => {
+  const base: Booking = {
+    bookingId: "b", roomId: "r", customerId: "c", startMinute: 0, endMinute: 60,
+    status: "confirmed", subtotalCents: 0, discountCents: 0, taxCents: 0, totalCents: 0,
+  };
+  assert.equal(isBookingActiveAt(base, 1_000_000), true);
+  const held: Booking = { ...base, status: "held", expiresAt: 15 };
+  assert.equal(isBookingActiveAt(held, 14), true);
+  assert.equal(isBookingActiveAt(held, 15), false);
+  assert.equal(isBookingActiveAt({ ...base, status: "held" }, 0), false);
+  assert.equal(isBookingActiveAt({ ...base, status: "cancelled" }, 0), false);
+});
+
+test("overlapping booking on same room conflicts; back-to-back and other rooms do not", () => {
+  const svc = makeService();
+  svc.createBooking(slot("r1", 60, 120));
+  assert.throws(() => svc.createBooking(slot("r1", 90, 150)), ConflictError);
+  assert.throws(() => svc.createBooking(slot("r1", 30, 61)), ConflictError);
+  assert.throws(() => svc.createBooking(slot("r1", 0, 240)), ConflictError);
+  assert.throws(() => svc.createBooking(slot("r1", 60, 120)), ConflictError);
+  svc.createBooking(slot("r1", 0, 60));
+  svc.createBooking(slot("r1", 120, 180));
+  svc.createBooking(slot("r2", 60, 120));
+  assert.equal(svc.listRoomBookings("r1").length, 3);
+  assert.equal(svc.listRoomBookings("r2").length, 1);
+});
+
+test("conflicting create does not store a booking", () => {
+  const svc = makeService();
+  svc.createBooking(slot("r1", 0, 60));
+  assert.throws(() => svc.createBooking(slot("r1", 0, 60)), ConflictError);
+  assert.equal(svc.listRoomBookings("r1").length, 1);
+});
+
+test("hold creation sets held status and expiresAt", () => {
+  const svc = makeService();
+  const b = svc.createBooking(slot("r1", 100, 160, { nowMinute: 10, holdMinutes: 15 }));
+  assert.equal(b.status, "held");
+  assert.equal(b.expiresAt, 25);
+  const plain = svc.createBooking(slot("r2", 0, 60));
+  assert.equal(plain.status, "confirmed");
+  assert.equal("expiresAt" in plain, false);
+});
+
+test("holdMinutes and nowMinute are validated against config", () => {
+  const svc = makeService();
+  for (const holdMinutes of [0, -5, 1.5, 61]) {
+    assert.throws(
+      () => svc.createBooking(slot("r1", 0, 60, { holdMinutes })),
+      ValidationError,
+      `holdMinutes=${holdMinutes}`,
+    );
+  }
+  assert.equal(svc.createBooking(slot("r1", 0, 60, { holdMinutes: 60 })).expiresAt, 60);
+  assert.throws(() => svc.createBooking(slot("r2", 0, 60, { nowMinute: -1 })), ValidationError);
+  assert.throws(() => svc.createBooking(slot("r2", 0, 60, { nowMinute: 0.5 })), ValidationError);
+
+  const custom = makeService({ BOOKING_MAX_HOLD_MINUTES: "10" });
+  assert.throws(() => custom.createBooking(slot("r1", 0, 60, { holdMinutes: 11 })), ValidationError);
+  assert.equal(custom.createBooking(slot("r1", 0, 60, { holdMinutes: 10 })).status, "held");
+});
+
+test("active hold blocks overlapping slot until it expires", () => {
+  const svc = makeService();
+  svc.createBooking(slot("r1", 100, 160, { nowMinute: 0, holdMinutes: 30 }));
+  assert.throws(() => svc.createBooking(slot("r1", 120, 180, { nowMinute: 29 })), ConflictError);
+  // Default nowMinute = 0 also sees the hold as active.
+  assert.throws(() => svc.createBooking(slot("r1", 120, 180)), ConflictError);
+  // At exactly expiresAt the hold is no longer active.
+  const b = svc.createBooking(slot("r1", 120, 180, { nowMinute: 30 }));
+  assert.equal(b.status, "confirmed");
+});
+
+test("confirmHold confirms a live hold and clears expiresAt", () => {
+  const svc = makeService();
+  const held = svc.createBooking(slot("r1", 100, 160, { nowMinute: 0, holdMinutes: 30 }));
+  const confirmed = svc.confirmHold(held.bookingId, 29);
+  assert.equal(confirmed.status, "confirmed");
+  assert.equal(confirmed.expiresAt, undefined);
+  assert.equal("expiresAt" in confirmed, false);
+  assert.equal(confirmed.totalCents, held.totalCents);
+  assert.deepEqual(svc.getBooking(held.bookingId), confirmed);
+  // Confirmed bookings keep blocking after the original hold window.
+  assert.throws(() => svc.createBooking(slot("r1", 100, 160, { nowMinute: 500 })), ConflictError);
+});
+
+test("confirmHold rejects unknown, non-held and expired bookings", () => {
+  const svc = makeService();
+  assert.throws(() => svc.confirmHold("bkg_9999", 0), ValidationError);
+
+  const plain = svc.createBooking(slot("r1", 0, 60));
+  assert.throws(() => svc.confirmHold(plain.bookingId, 0), ValidationError);
+
+  const held = svc.createBooking(slot("r2", 0, 60, { nowMinute: 0, holdMinutes: 10 }));
+  assert.throws(() => svc.confirmHold(held.bookingId, 10), ValidationError);
+  assert.equal(svc.getBooking(held.bookingId).status, "held");
+
+  const again = svc.createBooking(slot("r2", 100, 160, { holdMinutes: 10 }));
+  svc.confirmHold(again.bookingId, 5);
+  assert.throws(() => svc.confirmHold(again.bookingId, 6), ValidationError);
+});
