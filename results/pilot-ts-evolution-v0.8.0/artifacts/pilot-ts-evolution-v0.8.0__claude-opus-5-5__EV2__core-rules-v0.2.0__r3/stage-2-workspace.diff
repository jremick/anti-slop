+test("holdMinutes and nowMinute are validated against config", () => {
+  const svc = makeService();
+  for (const holdMinutes of [0, -5, 1.5, 61]) {
+    assert.throws(
+      () => svc.createBooking(slot("r1", 0, 60, { holdMinutes })),
+      ValidationError,
+      `holdMinutes=${holdMinutes}`,
