+  const room = { roomId: "x", name: "X", hourlyRateCents: 10000, taxBps: 825 };
+  assert.equal(calculateBookingPrice(room, 60).discountCents, 0);
+  const p = calculateBookingPrice(room, 90, { discountBps: 1250 });
+  assert.equal(p.discountCents, 1875);
+  assert.equal(p.subtotalCents, 13125);
+  assert.equal(p.taxCents, 1083);
