+import { validateBookingWindow } from "./bookings.ts";
+import type { BookingDraft, BookingService } from "./bookings.ts";
+import { ValidationError } from "./models.ts";
+import type { Booking } from "./models.ts";
+import { calculateBookingPrice, validateBps, validateNonNegativeInt } from "./pricing.ts";
+
+export interface GroupBookingInput {
+  readonly customerId: string;
+  readonly roomIds: readonly string[];
+  readonly startMinute: number;
+  readonly endMinute: number;
+  readonly discountBps: number;
+  readonly nowMinute?: number;
+}
+
+export interface GroupBookingResult {
+  readonly groupId: string;
+  readonly bookings: readonly Booking[];
+  readonly subtotalCents: number;
+  readonly discountCents: number;
+  readonly taxCents: number;
+  readonly totalCents: number;
+}
+
+let groupSeq = 0;
+
+/**
+ * Books the same slot in several rooms for one customer, all-or-nothing.
+ * Each room is priced individually (with the group discount); group totals are the sums.
+ */
+export function createGroupBooking(service: BookingService, input: GroupBookingInput): GroupBookingResult {
+  const customerId = validateBookingWindow(input.customerId, input.startMinute, input.endMinute);
+  const nowMinute = validateNonNegativeInt(input.nowMinute ?? 0, "nowMinute");
+  validateBps(input.discountBps, "discountBps");
+  if (!Array.isArray(input.roomIds) || input.roomIds.length < 2) {
+    throw new ValidationError("roomIds must contain at least 2 rooms");
+  }
+  if (new Set(input.roomIds).size !== input.roomIds.length) {
+    throw new ValidationError("roomIds must not contain duplicates");
+  }
+  const rooms = input.roomIds.map((roomId) => service.getRoom(roomId));
+
+  groupSeq += 1;
+  const groupId = `grp_${String(groupSeq).padStart(4, "0")}`;
+  const duration = input.endMinute - input.startMinute;
+  const drafts = rooms.map((room): BookingDraft => {
+    const price = calculateBookingPrice(room, duration, { discountBps: input.discountBps });
+    return {
+      roomId: room.roomId,
+      customerId,
+      startMinute: input.startMinute,
+      endMinute: input.endMinute,
+      status: "confirmed",
+      groupId,
+      subtotalCents: price.subtotalCents,
+      discountCents: price.discountCents,
+      taxCents: price.taxCents,
+      totalCents: price.totalCents,
+      depositCents: price.depositCents,
+    };
+  });
+
+  // Conflicts across every room are checked before anything is stored.
+  const bookings = service.commitBookings(drafts, nowMinute);
+  const sum = (pick: (b: Booking) => number) => bookings.reduce((acc, b) => acc + pick(b), 0);
+  return {
+    groupId,
+    bookings,
+    subtotalCents: sum((b) => b.subtotalCents),
+    discountCents: sum((b) => b.discountCents),
+    taxCents: sum((b) => b.taxCents),
+    totalCents: sum((b) => b.totalCents),
+  };
+}

