+  createGroupBooking,
+} from "../src/index.ts";
+
+function makeService(): BookingService {
+  const svc = new BookingService({ env: {} });
+  svc.registerRoom({ roomId: "a", name: "A", hourlyRateCents: 10000, taxBps: 825 });
+  svc.registerRoom({ roomId: "b", name: "B", hourlyRateCents: 6000, taxBps: 0 });
+  svc.registerRoom({ roomId: "c", name: "C", hourlyRateCents: 3333, taxBps: 1000 });
+  return svc;
+}
+
+function group(extra: object = {}) {
+  return { customerId: "corp", roomIds: ["a", "b", "c"], startMinute: 0, endMinute: 90, discountBps: 1250, ...extra };
+}
+
+function totalBookings(svc: BookingService): number {
+  return ["a", "b", "c"].reduce((n, id) => n + svc.listRoomBookings(id).length, 0);
+}
+
+test("applyDiscountAndTax applies half-up discount then tax on the discounted subtotal", () => {
+  assert.deepEqual(applyDiscountAndTax(15000, 1250, 825), {
+    subtotalCents: 13125, discountCents: 1875, taxCents: 1083, totalCents: 14208,
+  });
+  assert.deepEqual(applyDiscountAndTax(2, 2500, 0), { subtotalCents: 1, discountCents: 1, taxCents: 0, totalCents: 1 });
+  assert.deepEqual(applyDiscountAndTax(1, 4999, 0), { subtotalCents: 1, discountCents: 0, taxCents: 0, totalCents: 1 });
+  assert.deepEqual(applyDiscountAndTax(5000, 0, 0), { subtotalCents: 5000, discountCents: 0, taxCents: 0, totalCents: 5000 });
+  assert.deepEqual(applyDiscountAndTax(5000, 10000, 825), { subtotalCents: 0, discountCents: 5000, taxCents: 0, totalCents: 0 });
+});
+
+test("applyDiscountAndTax validates bounds", () => {
+  for (const [gross, d, t] of [
+    [-1, 0, 0], [1.5, 0, 0], [100, -1, 0], [100, 10001, 0], [100, 0.5, 0], [100, 0, -1], [100, 0, 10001],
+  ] as const) {
+    assert.throws(() => applyDiscountAndTax(gross, d, t), ValidationError, `(${gross}, ${d}, ${t})`);
+  }
+});
+
