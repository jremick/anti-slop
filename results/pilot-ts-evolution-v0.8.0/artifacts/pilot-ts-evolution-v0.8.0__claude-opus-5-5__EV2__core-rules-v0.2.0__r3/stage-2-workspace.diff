+  const graph = new Map<string, string[]>();
+  for (const file of readdirSync(srcDir).filter((f) => f.endsWith(".ts"))) {
+    const text = readFileSync(join(srcDir, file), "utf8");
+    const deps = [...text.matchAll(/from\s+["']\.\/([^"']+)["']/g)].map((m) => m[1]);
+    graph.set(file, deps);
+  }
+  assert.ok(graph.get("corporate.ts")?.includes("bookings.ts"));
+  assert.ok(!graph.get("bookings.ts")?.includes("corporate.ts"));
+  const visiting = new Set<string>();
+  const done = new Set<string>();
+  const visit = (file: string, path: string[]): void => {
+    if (done.has(file)) return;
+    assert.ok(!visiting.has(file), `cycle: ${[...path, file].join(" -> ")}`);
+    visiting.add(file);
+    for (const dep of graph.get(file) ?? []) visit(dep, [...path, file]);
+    visiting.delete(file);
+    done.add(file);
+  };
+  for (const file of graph.keys()) visit(file, []);
