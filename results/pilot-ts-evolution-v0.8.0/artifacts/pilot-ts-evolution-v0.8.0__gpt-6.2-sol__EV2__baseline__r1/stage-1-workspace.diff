+import test from "node:test";
+import assert from "node:assert/strict";
+import { ValidationError, calculateBookingPrice, roundHalfUpDiv } from "../src/index.ts";
+
+test("integer division rounds below, at, and above a half cent", () => {
+  assert.equal(roundHalfUpDiv(0, 60), 0);
+  assert.equal(roundHalfUpDiv(29, 60), 0);
+  assert.equal(roundHalfUpDiv(30, 60), 1);
+  assert.equal(roundHalfUpDiv(31, 60), 1);
+  assert.equal(roundHalfUpDiv(89, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2);
+  assert.equal(roundHalfUpDiv(1, 3), 0);
+  assert.equal(roundHalfUpDiv(2, 3), 1);
+  assert.equal(roundHalfUpDiv(Number.MAX_SAFE_INTEGER, 1), Number.MAX_SAFE_INTEGER);
+});
+
+test("integer division rejects invalid operands", () => {
+  for (const numerator of [-1, 1.5, NaN, Infinity]) {
+    assert.throws(() => roundHalfUpDiv(numerator, 60), ValidationError);
+  }
+  for (const denominator of [-1, 0, 1.5, NaN, Infinity]) {
+    assert.throws(() => roundHalfUpDiv(30, denominator), ValidationError);
+  }
+});
+
+test("minute pricing rounds subtotal before computing tax and legacy deposit", () => {
+  const room = { roomId: "a", name: "Conference A", hourlyRateCents: 1050, taxBps: 1250 };
+  assert.deepEqual(calculateBookingPrice(room, 1, { legacyDepositMode: true }), {
+    subtotalCents: 18,
+    discountCents: 0,
+    taxCents: 2,
+    totalCents: 20,
+    depositCents: 5,
+  });
+  assert.deepEqual(calculateBookingPrice(room, 2), {
+    subtotalCents: 35,
+    discountCents: 0,
+    taxCents: 4,
+    totalCents: 39,
+    depositCents: 0,
+  });
+  assert.equal(calculateBookingPrice(room, 61).subtotalCents, 1068);
+  assert.equal(calculateBookingPrice({ ...room, taxBps: 2500 }, 1).taxCents, 5);
+  for (const durationMinutes of [0, -1, 1.5, Infinity]) {
+    assert.throws(() => calculateBookingPrice(room, durationMinutes), ValidationError);
+  }
+});
