+    subtotalCents: 0,
+    discountCents: 18,
+    taxCents: 0,
+    totalCents: 0,
+  });
+});
+
+test("discount and tax reject invalid rates and gross subtotal must be integer cents", () => {
+  for (const invalid of [-1, 1.5, 10001, NaN, Infinity]) {
+    assert.throws(() => applyDiscountAndTax(18, invalid, 0), ValidationError);
+    assert.throws(() => applyDiscountAndTax(18, 0, invalid), ValidationError);
+  }
+  for (const invalid of [-1, 1.5, NaN, Infinity]) {
+    assert.throws(() => applyDiscountAndTax(invalid, 0, 0), ValidationError);
+  }
+});
+
+test("discounts remain exact when the intermediate product exceeds the safe integer range", () => {
+  assert.deepEqual(applyDiscountAndTax(Number.MAX_SAFE_INTEGER, 116, 0), {
+    subtotalCents: 8902715743385996,
+    discountCents: 104483511354995,
+    taxCents: 0,
+    totalCents: 8902715743385996,
+  });
+});
