+test("cancellation config keeps the cutoff inclusive and accepts both fee bounds", () => {
+  const config = loadCancellationFeeConfig({
+    BOOKING_CANCEL_FEE_TIERS_JSON: JSON.stringify({ cutoffMinutes: 0, earlyFeeBps: 0, lateFeeBps: 10000 }),
