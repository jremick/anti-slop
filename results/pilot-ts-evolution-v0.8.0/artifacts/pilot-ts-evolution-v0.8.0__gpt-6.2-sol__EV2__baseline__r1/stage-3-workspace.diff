+    const result = service.cancelBooking(booking.bookingId, nowMinute);
+    assert.deepEqual(result, {
+      booking: { ...booking, status: "cancelled" },
+      feeBps: early ? 2500 : 5000,
+      feeCents: early ? 275 : 551,
+      refundCents: early ? 826 : 550,
+    });
+    assert.deepEqual(service.getBooking(booking.bookingId), result.booking);
+  }
+});
+
+test("refund pricing handles half-cent ties, fee bounds, and invalid amounts", () => {
+  assert.deepEqual(computeCancellationRefund(3, 5000), { feeCents: 2, refundCents: 1 });
+  assert.deepEqual(computeCancellationRefund(3, 0), { feeCents: 0, refundCents: 3 });
+  assert.deepEqual(computeCancellationRefund(3, 10000), { feeCents: 3, refundCents: 0 });
+  assert.throws(() => computeCancellationRefund(-1, 0), ValidationError);
+  assert.throws(() => computeCancellationRefund(1.5, 0), ValidationError);
+  assert.throws(() => computeCancellationRefund(3, 10001), ValidationError);
+  assert.throws(() => computeCancellationRefund(3, 0.5), ValidationError);
+});
+
+test("missing or invalid fee configuration leaves the booking active and its slot occupied", () => {
+  const invalidConfigs = [
+    undefined,
+    "",
+    "  ",
+    "{",
+    "null",
+    "[]",
+    "true",
+    '"text"',
+    "{}",
+    JSON.stringify({ ...tiers, cutoffMinutes: -1 }),
+    JSON.stringify({ ...tiers, cutoffMinutes: "30" }),
+    '{"cutoffMinutes":1e309,"earlyFeeBps":2500,"lateFeeBps":5000}',
+    JSON.stringify({ ...tiers, earlyFeeBps: -1 }),
+    JSON.stringify({ ...tiers, earlyFeeBps: 1.5 }),
+    JSON.stringify({ ...tiers, lateFeeBps: 10001 }),
+    JSON.stringify({ ...tiers, lateFeeBps: "5000" }),
+  ];
+
+  for (const raw of invalidConfigs) {
+    const { service, input } = setupCancellation(raw);
+    const booking = service.createBooking(input);
+    assert.throws(() => service.cancelBooking(booking.bookingId, 30), ConfigError, String(raw));
+    assert.equal(service.getBooking(booking.bookingId).status, "confirmed");
+    assert.throws(() => service.createBooking(input), ConflictError);
+  }
+});
+
+test("reloading corrected injected tiers permits cancellation and immediate slot reuse", () => {
+  const { env, service, input } = setupCancellation();
+  const held = service.createBooking({ ...input, nowMinute: 20, holdMinutes: 30 });
+  assert.throws(() => service.cancelBooking(held.bookingId, 30), ConfigError);
+  assert.throws(() => service.createBooking({ ...input, nowMinute: 30 }), ConflictError);
+
+  env.BOOKING_CANCEL_FEE_TIERS_JSON = JSON.stringify(tiers);
+  const result = service.cancelBooking(held.bookingId, 30);
+  assert.equal(result.booking.status, "cancelled");
+  assert.throws(() => service.confirmHold(held.bookingId, 30), ValidationError);
+  const replacement = service.createBooking({ ...input, nowMinute: 30 });
+  assert.deepEqual(service.listRoomBookings("a"), [result.booking, replacement]);
+});
+
+test("unknown bookings, repeat cancellations, and cancellations after the start are rejected", () => {
+  const { service, input } = setupCancellation(JSON.stringify(tiers));
+  const booking = service.createBooking(input);
+  assert.throws(() => service.cancelBooking("missing", 30), ValidationError);
+  assert.throws(() => service.cancelBooking(booking.bookingId, 61), ValidationError);
+  assert.equal(service.getBooking(booking.bookingId).status, "confirmed");
+  service.cancelBooking(booking.bookingId, 60);
+  assert.throws(() => service.cancelBooking(booking.bookingId, 60), ValidationError);
+  assert.equal(service.getBooking(booking.bookingId).status, "cancelled");
+});

