+import test from "node:test";
+import assert from "node:assert/strict";
+import { BookingService, ConflictError, ValidationError, createGroupBooking } from "../src/index.ts";
+
+function setupGroupBooking() {
+  const service = new BookingService({ env: {} });
+  service.registerRoom({ roomId: "a", name: "Room A", hourlyRateCents: 1050, taxBps: 1250 });
+  service.registerRoom({ roomId: "b", name: "Room B", hourlyRateCents: 510, taxBps: 5000 });
+  service.registerRoom({ roomId: "c", name: "Room C", hourlyRateCents: 1200, taxBps: 0 });
+
+  const input = { customerId: " team ", roomIds: ["a", "b"], startMinute: 60, endMinute: 61, discountBps: 2500 };
+  return { service, input };
+}
+
+test("the group sums per-room prices with separate discount and tax rounding", () => {
+  const { service, input } = setupGroupBooking();
+  const group = createGroupBooking(service, input);
+  assert.ok(group.groupId);
+  assert.equal(group.bookings.length, 2);
+  const [first, second] = group.bookings;
+  assert.notEqual(first.bookingId, second.bookingId);
+  assert.deepEqual(first, {
+    bookingId: first.bookingId,
+    groupId: group.groupId,
+    roomId: "a",
+    customerId: "team",
+    startMinute: 60,
+    endMinute: 61,
+    status: "confirmed",
+    subtotalCents: 13,
+    discountCents: 5,
+    taxCents: 2,
+    totalCents: 15,
+    depositCents: 0,
+  });
+  assert.deepEqual(second, {
+    ...first,
+    bookingId: second.bookingId,
+    roomId: "b",
+    subtotalCents: 7,
+    discountCents: 2,
+    taxCents: 4,
+    totalCents: 11,
+  });
+  assert.deepEqual(group, {
+    groupId: group.groupId,
+    bookings: [first, second],
+    subtotalCents: 20,
+    discountCents: 7,
+    taxCents: 6,
+    totalCents: 26,
+  });
+  assert.deepEqual(service.listRoomBookings("a"), [first]);
+  assert.deepEqual(service.listRoomBookings("b"), [second]);
+  assert.throws(() => service.createBooking({
+    roomId: "b", customerId: "other", startMinute: 60, endMinute: 61,
+  }), ConflictError);
+  const adjacentGroup = createGroupBooking(service, { ...input, startMinute: 61, endMinute: 62 });
+  assert.notEqual(adjacentGroup.groupId, group.groupId);
+});
+
+test("a conflict in the last room leaves the entire group uncommitted", () => {
+  const { service, input } = setupGroupBooking();
+  const hold = service.createBooking({
+    roomId: "c", customerId: "other", startMinute: 59, endMinute: 62, nowMinute: 10, holdMinutes: 5,
+  });
+  const request = { ...input, roomIds: ["a", "b", "c"] };
+  assert.throws(() => createGroupBooking(service, request), ConflictError);
+  assert.throws(() => createGroupBooking(service, { ...request, nowMinute: 14 }), ConflictError);
+  assert.deepEqual(service.listRoomBookings("a"), []);
+  assert.deepEqual(service.listRoomBookings("b"), []);
+  assert.deepEqual(service.listRoomBookings("c"), [hold]);
+
+  const group = createGroupBooking(service, { ...request, nowMinute: 15 });
+  assert.deepEqual(group.bookings.map((booking) => booking.roomId), request.roomIds);
+  assert.equal(service.listRoomBookings("c").length, 2);
+});
+
+test("invalid group inputs are rejected before any room is booked", () => {
+  const { service, input } = setupGroupBooking();
+  for (const roomIds of [[], ["a"], ["a", "a"], ["a", "b", "missing"]]) {
+    assert.throws(() => createGroupBooking(service, { ...input, roomIds }), ValidationError);
+  }
+  for (const discountBps of [-1, 1.5, 10001, NaN]) {
+    assert.throws(() => createGroupBooking(service, { ...input, discountBps }), ValidationError);
+  }
+  assert.throws(() => createGroupBooking(service, { ...input, customerId: " " }), ValidationError);
+  assert.throws(() => createGroupBooking(service, { ...input, endMinute: 60 }), ValidationError);
+  for (const roomId of ["a", "b", "c"]) {
+    assert.deepEqual(service.listRoomBookings(roomId), []);
+  }
+});

