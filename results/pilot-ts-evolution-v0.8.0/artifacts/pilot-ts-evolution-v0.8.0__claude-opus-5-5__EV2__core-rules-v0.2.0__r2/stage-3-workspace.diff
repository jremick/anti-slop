+import test from "node:test";
+import assert from "node:assert/strict";
+import { readdirSync, readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import {
+  BookingService,
+  CANCEL_FEE_TIERS_ENV,
+  ConfigError,
+  ConflictError,
+  ValidationError,
+  computeCancellationRefund,
+  createGroupBooking,
+  loadCancellationFeeConfig,
+  selectCancellationFeeBps,
+} from "../src/index.ts";
+import type { Booking, CancellationFeeConfig, EnvSource } from "../src/index.ts";
+
+const TIERS = { cutoffMinutes: 120, earlyFeeBps: 1000, lateFeeBps: 5000 };
+const VALID_ENV: EnvSource = { [CANCEL_FEE_TIERS_ENV]: JSON.stringify(TIERS) };
+
+function makeService(env: EnvSource = VALID_ENV): BookingService {
+  const svc = new BookingService({ env });
+  svc.registerRoom({ roomId: "r1", name: "Room 1", hourlyRateCents: 10000, taxBps: 825 });
+  svc.registerRoom({ roomId: "r2", name: "Room 2", hourlyRateCents: 6000, taxBps: 0 });
+  return svc;
+}
+
+/** Room r1, 600..660: subtotal 10000, tax 825, total 10825. */
+function bookR1(svc: BookingService, extra: { holdMinutes?: number; nowMinute?: number } = {}): Booking {
+  return svc.createBooking({
+    roomId: "r1",
+    customerId: "cust",
+    startMinute: 600,
+    endMinute: 660,
+    ...extra,
+  });
+}
+
+// ---------- computeCancellationRefund ----------
+
+test("computeCancellationRefund uses half-up fee rounding and refund = total - fee", () => {
+  assert.deepEqual(computeCancellationRefund(10825, 1000), { feeCents: 1083, refundCents: 9742 }); // 1082.5 -> 1083
+  assert.deepEqual(computeCancellationRefund(10825, 5000), { feeCents: 5413, refundCents: 5412 }); // 5412.5 -> 5413
+  assert.deepEqual(computeCancellationRefund(999, 1234), { feeCents: 123, refundCents: 876 }); // 123.2766 -> 123
+  assert.deepEqual(computeCancellationRefund(10825, 0), { feeCents: 0, refundCents: 10825 });
+  assert.deepEqual(computeCancellationRefund(10825, 10000), { feeCents: 10825, refundCents: 0 });
+  assert.deepEqual(computeCancellationRefund(0, 5000), { feeCents: 0, refundCents: 0 });
+});
+
+test("computeCancellationRefund rejects invalid totals and fee bps", () => {
+  for (const [total, bps] of [
+    [-1, 0],
+    [1.5, 0],
+    [100, -1],
+    [100, 10001],
+    [100, 2.5],
+    [100, Number.NaN],
+  ] as const) {
+    assert.throws(() => computeCancellationRefund(total, bps), ValidationError, `${total},${bps}`);
+  }
+});
+
+// ---------- selectCancellationFeeBps ----------
+
+test("selectCancellationFeeBps: early at/after the cutoff, late before it", () => {
+  const cfg: CancellationFeeConfig = TIERS;
+  assert.equal(selectCancellationFeeBps(10_000, cfg), 1000);
+  assert.equal(selectCancellationFeeBps(121, cfg), 1000);
+  assert.equal(selectCancellationFeeBps(120, cfg), 1000); // boundary is early
+  assert.equal(selectCancellationFeeBps(119, cfg), 5000);
+  assert.equal(selectCancellationFeeBps(0, cfg), 5000);
+  const zeroCutoff = { ...TIERS, cutoffMinutes: 0 };
+  assert.equal(selectCancellationFeeBps(0, zeroCutoff), 1000);
+  for (const bad of [-1, 1.5, Number.NaN]) {
+    assert.throws(() => selectCancellationFeeBps(bad, cfg), ValidationError, String(bad));
+  }
+});
+
+// ---------- loadCancellationFeeConfig ----------
+
+test("loadCancellationFeeConfig parses a valid tier object", () => {
+  assert.deepEqual(loadCancellationFeeConfig(VALID_ENV), TIERS);
+  assert.deepEqual(
+    loadCancellationFeeConfig({
+      [CANCEL_FEE_TIERS_ENV]: '{"cutoffMinutes":0,"earlyFeeBps":0,"lateFeeBps":10000}',
+    }),
+    { cutoffMinutes: 0, earlyFeeBps: 0, lateFeeBps: 10000 },
+  );
+});
+
+const INVALID_CONFIGS: ReadonlyArray<[string, string | undefined]> = [
+  ["missing", undefined],
+  ["empty", ""],
+  ["whitespace", "   "],
+  ["invalid JSON", "{cutoffMinutes: 120"],
+  ["null", "null"],
+  ["array", "[120, 1000, 5000]"],
+  ["number", "42"],
+  ["string", '"tiers"'],
+  ["missing cutoffMinutes", '{"earlyFeeBps":1000,"lateFeeBps":5000}'],
+  ["missing earlyFeeBps", '{"cutoffMinutes":120,"lateFeeBps":5000}'],
+  ["missing lateFeeBps", '{"cutoffMinutes":120,"earlyFeeBps":1000}'],
+  ["negative cutoff", '{"cutoffMinutes":-1,"earlyFeeBps":1000,"lateFeeBps":5000}'],
+  ["fractional cutoff", '{"cutoffMinutes":1.5,"earlyFeeBps":1000,"lateFeeBps":5000}'],
+  ["string cutoff", '{"cutoffMinutes":"120","earlyFeeBps":1000,"lateFeeBps":5000}'],
+  ["early bps > 10000", '{"cutoffMinutes":120,"earlyFeeBps":10001,"lateFeeBps":5000}'],
+  ["negative early bps", '{"cutoffMinutes":120,"earlyFeeBps":-1,"lateFeeBps":5000}'],
+  ["fractional late bps", '{"cutoffMinutes":120,"earlyFeeBps":1000,"lateFeeBps":2.5}'],
+  ["null late bps", '{"cutoffMinutes":120,"earlyFeeBps":1000,"lateFeeBps":null}'],
+  ["late bps > 10000", '{"cutoffMinutes":120,"earlyFeeBps":1000,"lateFeeBps":10001}'],
+];
+
+test("loadCancellationFeeConfig fails closed with ConfigError on every invalid shape", () => {
+  for (const [label, raw] of INVALID_CONFIGS) {
+    assert.throws(() => loadCancellationFeeConfig({ [CANCEL_FEE_TIERS_ENV]: raw }), ConfigError, label);
+  }
+});
+
+// ---------- cancelBooking: tiers ----------
+
+test("cancelBooking applies the early tier at or beyond the cutoff", () => {
+  const svc = makeService();
+  const booking = bookR1(svc);
+  const result = svc.cancelBooking(booking.bookingId, 480); // exactly 120 minutes before start
+  assert.equal(result.feeBps, 1000);
+  assert.equal(result.feeCents, 1083);
+  assert.equal(result.refundCents, 9742);
+  assert.equal(result.feeCents + result.refundCents, booking.totalCents);
+  assert.equal(result.booking.status, "cancelled");
+  assert.equal(result.booking.bookingId, booking.bookingId);
+  assert.deepEqual(svc.getBooking(booking.bookingId), result.booking);
+});
+
+test("cancelBooking applies the late tier one minute inside the cutoff and up to the start", () => {
+  for (const now of [481, 599, 600]) {
+    const svc = makeService();
+    const booking = bookR1(svc);
+    const result = svc.cancelBooking(booking.bookingId, now);
+    assert.equal(result.feeBps, 5000, `now=${now}`);
+    assert.equal(result.feeCents, 5413);
+    assert.equal(result.refundCents, 5412);
+  }
+});
+
+test("cancelBooking refund uses the discounted group booking total", () => {
+  const svc = makeService();
+  const group = createGroupBooking(svc, {
+    customerId: "corp",
+    roomIds: ["r1", "r2"],
+    startMinute: 600,
+    endMinute: 660,
+    discountBps: 2000,
+  });
+  const r1 = group.bookings.find((b) => b.roomId === "r1")!;
+  assert.equal(r1.totalCents, 8660); // sub 8000 + tax 660
+  const result = svc.cancelBooking(r1.bookingId, 0);
+  assert.deepEqual([result.feeBps, result.feeCents, result.refundCents], [1000, 866, 7794]);
+  // Only the cancelled room is affected.
+  const r2 = group.bookings.find((b) => b.roomId === "r2")!;
+  assert.equal(svc.getBooking(r2.bookingId).status, "confirmed");
+});
+
+// ---------- cancelBooking: validation ----------
+
+test("cancelBooking rejects unknown, already-cancelled, started bookings and invalid nowMinute", () => {
+  const svc = makeService();
+  assert.throws(() => svc.cancelBooking("bkg_9999", 0), ValidationError);
+
+  const started = bookR1(svc);
+  assert.throws(() => svc.cancelBooking(started.bookingId, 601), ValidationError);
+  assert.throws(() => svc.cancelBooking(started.bookingId, -1), ValidationError);
+  assert.throws(() => svc.cancelBooking(started.bookingId, 1.5), ValidationError);
+  assert.equal(svc.getBooking(started.bookingId).status, "confirmed");
+
+  svc.cancelBooking(started.bookingId, 0);
+  assert.throws(() => svc.cancelBooking(started.bookingId, 0), ValidationError);
+});
+
+// ---------- cancelBooking: fail-closed config ----------
+
+test("cancelBooking with missing or invalid config throws ConfigError and leaves the booking intact", () => {
+  for (const [label, raw] of INVALID_CONFIGS) {
+    const svc = makeService(raw === undefined ? {} : { [CANCEL_FEE_TIERS_ENV]: raw });
+    const booking = bookR1(svc);
+    assert.throws(() => svc.cancelBooking(booking.bookingId, 0), ConfigError, label);
+    assert.equal(svc.getBooking(booking.bookingId).status, "confirmed", label);
+    // The slot is still occupied.
+    assert.throws(() => bookR1(svc), ConflictError, label);
+  }
+});
+
+test("validation errors are reported before config errors", () => {
+  const svc = makeService({});
+  assert.throws(() => svc.cancelBooking("bkg_9999", 0), ValidationError);
+});
+
+test("an injected env is used exclusively; process.env is the default only when none is injected", () => {
+  const previous = process.env[CANCEL_FEE_TIERS_ENV];
+  try {
+    process.env[CANCEL_FEE_TIERS_ENV] = JSON.stringify({ cutoffMinutes: 0, earlyFeeBps: 2500, lateFeeBps: 2500 });
+
+    // Injected (empty) env must not fall through to process.env.
+    const injected = makeService({});
+    const a = bookR1(injected);
+    assert.throws(() => injected.cancelBooking(a.bookingId, 0), ConfigError);
+
+    // Injected valid env wins over process.env.
+    const overriding = makeService(VALID_ENV);
+    assert.equal(overriding.cancelBooking(bookR1(overriding).bookingId, 0).feeBps, 1000);
+
+    // No env injected -> process.env.
+    const svc = new BookingService();
+    svc.registerRoom({ roomId: "r1", name: "Room 1", hourlyRateCents: 10000, taxBps: 825 });
+    assert.equal(svc.cancelBooking(bookR1(svc).bookingId, 0).feeBps, 2500);
+  } finally {
+    if (previous === undefined) {
+      delete process.env[CANCEL_FEE_TIERS_ENV];
+    } else {
+      process.env[CANCEL_FEE_TIERS_ENV] = previous;
+    }
+  }
+});
+
+test("config is read at cancellation time, so a fixed env lets a previously failed cancel succeed", () => {
+  const env: EnvSource = {};
+  const svc = makeService(env);
+  const booking = bookR1(svc);
+  assert.throws(() => svc.cancelBooking(booking.bookingId, 0), ConfigError);
+  env[CANCEL_FEE_TIERS_ENV] = JSON.stringify(TIERS);
+  assert.equal(svc.cancelBooking(booking.bookingId, 0).booking.status, "cancelled");
+});
+
+// ---------- slot reuse ----------
+
+test("a cancelled booking frees its slot immediately for single and group bookings", () => {
+  const svc = makeService();
+  const first = bookR1(svc);
+  assert.throws(() => bookR1(svc), ConflictError);
+  svc.cancelBooking(first.bookingId, 100);
+
+  const second = bookR1(svc, { nowMinute: 100 });
+  assert.equal(second.status, "confirmed");
+  svc.cancelBooking(second.bookingId, 100);
+
+  const group = createGroupBooking(svc, {
+    customerId: "corp",
+    roomIds: ["r1", "r2"],
+    startMinute: 600,
+    endMinute: 660,
+    discountBps: 0,
+    nowMinute: 100,
+  });
+  assert.equal(group.bookings.length, 2);
+  assert.equal(svc.listRoomBookings("r1").filter((b) => b.status === "cancelled").length, 2);
+});
+
+test("cancelling an active hold frees the slot before the hold would expire", () => {
+  const svc = makeService();
+  const hold = bookR1(svc, { nowMinute: 100, holdMinutes: 30 });
+  svc.cancelBooking(hold.bookingId, 105);
+  assert.equal(bookR1(svc, { nowMinute: 105 }).status, "confirmed");
+  assert.throws(() => svc.confirmHold(hold.bookingId, 106), ValidationError);
+});
+
+// ---------- env centralization ----------
+
+test("process.env is only referenced in src/config.ts", () => {
+  const srcDir = join(dirname(fileURLToPath(import.meta.url)), "..", "src");
+  for (const file of readdirSync(srcDir).filter((f) => f.endsWith(".ts"))) {
+    const text = readFileSync(join(srcDir, file), "utf8");
+    if (file !== "config.ts") {
+      assert.equal(/process\s*\.\s*env/.test(text), false, `${file} reads process.env`);
+    }
+  }
+});
