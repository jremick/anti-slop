+/** Lets other modules default to process.env without reading it themselves. */
+export function resolveEnv(env: EnvSource | undefined): EnvSource {
+  return env === undefined ? process.env : env;
+}
+
+export interface CancellationFeeConfig {
+  readonly cutoffMinutes: number;
+  readonly earlyFeeBps: number;
+  readonly lateFeeBps: number;
+}
+
+export const CANCEL_FEE_TIERS_ENV = "BOOKING_CANCEL_FEE_TIERS_JSON";
+
+function requireConfigInt(
+  obj: Record<string, unknown>,
+  key: string,
+  max: number,
+): number {
+  const value = obj[key];
+  if (typeof value !== "number" || !Number.isInteger(value) || value < 0 || value > max) {
+    const range = max === Number.MAX_SAFE_INTEGER ? "a non-negative integer" : `an integer in 0..${max}`;
+    throw new ConfigError(`${CANCEL_FEE_TIERS_ENV}.${key} must be ${range}`);
+  }
