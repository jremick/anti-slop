+}
+
+/**
+ * Reads cancellation fee tiers from BOOKING_CANCEL_FEE_TIERS_JSON.
+ * Fails closed: there is no default, and any malformed value throws ConfigError.
+ */
+export function loadCancellationFeeConfig(
+  env: EnvSource = process.env,
+): CancellationFeeConfig {
+  const raw = env[CANCEL_FEE_TIERS_ENV];
+  if (raw === undefined || raw.trim() === "") {
+    throw new ConfigError(`${CANCEL_FEE_TIERS_ENV} must be set`);
+  }
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(raw);
+  } catch (err) {
+    throw new ConfigError(`${CANCEL_FEE_TIERS_ENV} is not valid JSON: ${(err as Error).message}`);
+  }
+  if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) {
+    throw new ConfigError(`${CANCEL_FEE_TIERS_ENV} must be a JSON object`);
+  }
+  const obj = parsed as Record<string, unknown>;
+  return {
+    cutoffMinutes: requireConfigInt(obj, "cutoffMinutes", Number.MAX_SAFE_INTEGER),
+    earlyFeeBps: requireConfigInt(obj, "earlyFeeBps", 10000),
+    lateFeeBps: requireConfigInt(obj, "lateFeeBps", 10000),
+  };
+}
+
+/** Early tier applies at or beyond the cutoff; anything closer to the start is late. */
+export function selectCancellationFeeBps(
+  minutesBeforeStart: number,
+  cfg: CancellationFeeConfig,
+): number {
+  if (!Number.isInteger(minutesBeforeStart) || minutesBeforeStart < 0) {
+    throw new ValidationError("minutesBeforeStart must be a non-negative integer");
+  }
+  return minutesBeforeStart >= cfg.cutoffMinutes ? cfg.earlyFeeBps : cfg.lateFeeBps;
+}

