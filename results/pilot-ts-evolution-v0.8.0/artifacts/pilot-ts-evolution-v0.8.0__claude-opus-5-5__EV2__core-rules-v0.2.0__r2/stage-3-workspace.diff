+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  calculateBookingPrice,
+  isBookingActiveAt,
+  roundHalfUpDiv,
+  slotsOverlap,
+} from "../src/index.ts";
+import type { Booking, Room } from "../src/index.ts";
+
+const ROOM: Room = { roomId: "r1", name: "Room 1", hourlyRateCents: 10000, taxBps: 825 };
+
+function makeService(env: Record<string, string | undefined> = {}): BookingService {
+  const svc = new BookingService({ env });
+  svc.registerRoom(ROOM);
+  svc.registerRoom({ ...ROOM, roomId: "r2", name: "Room 2" });
+  return svc;
+}
+
+function book(
+  svc: BookingService,
+  startMinute: number,
+  endMinute: number,
+  extra: { roomId?: string; nowMinute?: number; holdMinutes?: number } = {},
+): Booking {
+  return svc.createBooking({
+    roomId: extra.roomId ?? "r1",
+    customerId: "cust",
+    startMinute,
+    endMinute,
+    nowMinute: extra.nowMinute,
+    holdMinutes: extra.holdMinutes,
+  });
+}
+
+// ---------- roundHalfUpDiv ----------
+
+test("roundHalfUpDiv rounds exact halves up and other fractions to nearest", () => {
+  assert.equal(roundHalfUpDiv(0, 7), 0);
+  assert.equal(roundHalfUpDiv(10, 5), 2);
+  assert.equal(roundHalfUpDiv(1, 2), 1); // 0.5 -> 1
+  assert.equal(roundHalfUpDiv(3, 2), 2); // 1.5 -> 2
+  assert.equal(roundHalfUpDiv(5, 2), 3); // 2.5 -> 3 (not banker's 2)
+  assert.equal(roundHalfUpDiv(29, 60), 0); // 0.483 -> 0
+  assert.equal(roundHalfUpDiv(30, 60), 1); // 0.5 -> 1
+  assert.equal(roundHalfUpDiv(89, 60), 1); // 1.483 -> 1
+  assert.equal(roundHalfUpDiv(90, 60), 2); // 1.5 -> 2
+  assert.equal(roundHalfUpDiv(1, 3), 0);
+  assert.equal(roundHalfUpDiv(2, 3), 1);
+});
+
+test("roundHalfUpDiv rejects non-integers, negative numerators, non-positive denominators, unsafe sizes", () => {
+  for (const [n, d] of [
+    [1.5, 2],
+    [1, 2.5],
+    [-1, 2],
+    [1, 0],
+    [1, -3],
+    [Number.NaN, 2],
+    [1, Number.POSITIVE_INFINITY],
+    [Number.MAX_SAFE_INTEGER, 1],
+  ] as const) {
+    assert.throws(() => roundHalfUpDiv(n, d), ValidationError, `${n}/${d}`);
+  }
+});
+
+// ---------- calculateBookingPrice ----------
+
+test("calculateBookingPrice supports partial-hour durations with half-up cents", () => {
+  const room: Room = { roomId: "x", name: "X", hourlyRateCents: 1001, taxBps: 825 };
+  // 1001 * 30 / 60 = 500.5 -> 501; tax 501 * 0.0825 = 41.3325 -> 41
+  assert.deepEqual(calculateBookingPrice(room, 30), {
+    subtotalCents: 501,
+    discountCents: 0,
+    taxCents: 41,
+    totalCents: 542,
+    depositCents: 0,
+  });
+  // 1001 * 1 / 60 = 16.683 -> 17
+  assert.equal(calculateBookingPrice(room, 1).subtotalCents, 17);
+  // 1001 * 89 / 60 = 1484.816 -> 1485
+  assert.equal(calculateBookingPrice(room, 89).subtotalCents, 1485);
+  // 999 * 45 / 60 = 749.25 -> 749
+  assert.equal(calculateBookingPrice({ ...room, hourlyRateCents: 999 }, 45).subtotalCents, 749);
+});
+
+test("calculateBookingPrice keeps whole-hour results and legacy deposit on rounded subtotal", () => {
+  assert.equal(calculateBookingPrice(ROOM, 120).subtotalCents, 20000);
+  const room: Room = { roomId: "x", name: "X", hourlyRateCents: 1001, taxBps: 0 };
+  const price = calculateBookingPrice(room, 30, { legacyDepositMode: true });
+  assert.equal(price.subtotalCents, 501);
