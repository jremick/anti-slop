@@ -0,0 +1,254 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  calculateBookingPrice,
+  isBookingActiveAt,
+  roundHalfUpDiv,
+  slotsOverlap,
+} from "../src/index.ts";
+import type { Booking, Room } from "../src/index.ts";
+
+const ROOM: Room = { roomId: "r1", name: "Room 1", hourlyRateCents: 10000, taxBps: 825 };
+
+function makeService(env: Record<string, string | undefined> = {}): BookingService {
+  const svc = new BookingService({ env });
+  svc.registerRoom(ROOM);
+  svc.registerRoom({ ...ROOM, roomId: "r2", name: "Room 2" });
+  return svc;
+}
+
+function book(
+  svc: BookingService,
+  startMinute: number,
+  endMinute: number,
+  extra: { roomId?: string; nowMinute?: number; holdMinutes?: number } = {},
+): Booking {
+  return svc.createBooking({
+    roomId: extra.roomId ?? "r1",
+    customerId: "cust",
+    startMinute,
+    endMinute,
+    nowMinute: extra.nowMinute,
+    holdMinutes: extra.holdMinutes,
+  });
+}
+
+// ---------- roundHalfUpDiv ----------
+
+test("roundHalfUpDiv rounds exact halves up and other fractions to nearest", () => {
+  assert.equal(roundHalfUpDiv(0, 7), 0);
+  assert.equal(roundHalfUpDiv(10, 5), 2);
+  assert.equal(roundHalfUpDiv(1, 2), 1); // 0.5 -> 1
+  assert.equal(roundHalfUpDiv(3, 2), 2); // 1.5 -> 2
+  assert.equal(roundHalfUpDiv(5, 2), 3); // 2.5 -> 3 (not banker's 2)
+  assert.equal(roundHalfUpDiv(29, 60), 0); // 0.483 -> 0
+  assert.equal(roundHalfUpDiv(30, 60), 1); // 0.5 -> 1
+  assert.equal(roundHalfUpDiv(89, 60), 1); // 1.483 -> 1
+  assert.equal(roundHalfUpDiv(90, 60), 2); // 1.5 -> 2
+  assert.equal(roundHalfUpDiv(1, 3), 0);
+  assert.equal(roundHalfUpDiv(2, 3), 1);
+});
+
+test("roundHalfUpDiv rejects non-integers, negative numerators, non-positive denominators, unsafe sizes", () => {
+  for (const [n, d] of [
+    [1.5, 2],
+    [1, 2.5],
+    [-1, 2],
+    [1, 0],
+    [1, -3],
+    [Number.NaN, 2],
+    [1, Number.POSITIVE_INFINITY],
+    [Number.MAX_SAFE_INTEGER, 1],
+  ] as const) {
+    assert.throws(() => roundHalfUpDiv(n, d), ValidationError, `${n}/${d}`);
+  }
+});
+
+// ---------- calculateBookingPrice ----------
+
+test("calculateBookingPrice supports partial-hour durations with half-up cents", () => {
+  const room: Room = { roomId: "x", name: "X", hourlyRateCents: 1001, taxBps: 825 };
+  // 1001 * 30 / 60 = 500.5 -> 501; tax 501 * 0.0825 = 41.3325 -> 41
+  assert.deepEqual(calculateBookingPrice(room, 30), {
+    subtotalCents: 501,
+    discountCents: 0,
+    taxCents: 41,
+    totalCents: 542,
+    depositCents: 0,
+  });
+  // 1001 * 1 / 60 = 16.683 -> 17
+  assert.equal(calculateBookingPrice(room, 1).subtotalCents, 17);
+  // 1001 * 89 / 60 = 1484.816 -> 1485
+  assert.equal(calculateBookingPrice(room, 89).subtotalCents, 1485);
+  // 999 * 45 / 60 = 749.25 -> 749
+  assert.equal(calculateBookingPrice({ ...room, hourlyRateCents: 999 }, 45).subtotalCents, 749);
+});
+
+test("calculateBookingPrice keeps whole-hour results and legacy deposit on rounded subtotal", () => {
+  assert.equal(calculateBookingPrice(ROOM, 120).subtotalCents, 20000);
+  const room: Room = { roomId: "x", name: "X", hourlyRateCents: 1001, taxBps: 0 };
+  const price = calculateBookingPrice(room, 30, { legacyDepositMode: true });
+  assert.equal(price.subtotalCents, 501);
+  assert.equal(price.depositCents, 125); // 501 * 0.25 = 125.25 -> 125
+});
+
+test("calculateBookingPrice rejects non-positive or non-integer durations", () => {
+  for (const d of [0, -30, 1.5, Number.NaN]) {
+    assert.throws(() => calculateBookingPrice(ROOM, d), ValidationError, String(d));
+  }
+});
+
+test("createBooking prices a 90-minute booking", () => {
+  const svc = makeService();
+  const b = book(svc, 0, 90);
+  assert.equal(b.subtotalCents, 15000);
+  assert.equal(b.taxCents, 1238); // 1237.5 -> 1238
+  assert.equal(b.totalCents, 16238);
+});
+
+// ---------- slotsOverlap ----------
+
+test("slotsOverlap uses half-open intervals", () => {
+  assert.equal(slotsOverlap(0, 60, 60, 120), false); // back-to-back
+  assert.equal(slotsOverlap(60, 120, 0, 60), false);
+  assert.equal(slotsOverlap(0, 60, 59, 120), true);
+  assert.equal(slotsOverlap(0, 120, 30, 60), true); // containment
+  assert.equal(slotsOverlap(30, 60, 0, 120), true);
+  assert.equal(slotsOverlap(0, 60, 0, 60), true); // identical
+  assert.equal(slotsOverlap(0, 30, 90, 120), false); // disjoint
+});
+
+// ---------- isBookingActiveAt ----------
+
+test("isBookingActiveAt: confirmed always, held only before expiresAt, cancelled never", () => {
+  const base = makeService().createBooking({
+    roomId: "r1",
+    customerId: "c",
+    startMinute: 0,
+    endMinute: 60,
+  });
+  assert.equal(isBookingActiveAt(base, 1_000_000), true);
+  const held: Booking = { ...base, status: "held", expiresAt: 15 };
+  assert.equal(isBookingActiveAt(held, 14), true);
+  assert.equal(isBookingActiveAt(held, 15), false);
+  assert.equal(isBookingActiveAt(held, 16), false);
+  const heldNoExpiry: Booking = { ...base, status: "held" };
+  assert.equal(isBookingActiveAt(heldNoExpiry, 0), false);
+  const cancelled: Booking = { ...base, status: "cancelled" };
+  assert.equal(isBookingActiveAt(cancelled, 0), false);
+});
+
+// ---------- createBooking: conflicts ----------
+
+test("createBooking rejects overlapping confirmed bookings in the same room", () => {
+  const svc = makeService();
+  book(svc, 60, 120);
+  assert.throws(() => book(svc, 90, 150), ConflictError);
+  assert.throws(() => book(svc, 0, 61), ConflictError);
+  assert.throws(() => book(svc, 70, 80), ConflictError);
+  assert.throws(() => book(svc, 0, 200), ConflictError);
+  assert.throws(() => book(svc, 60, 120, { nowMinute: 10_000 }), ConflictError);
+  assert.equal(svc.listRoomBookings("r1").length, 1, "failed attempts are not stored");
+});
+
+test("createBooking allows back-to-back bookings and same slot in another room", () => {
+  const svc = makeService();
+  book(svc, 60, 120);
+  book(svc, 0, 60);
+  book(svc, 120, 180);
+  book(svc, 60, 120, { roomId: "r2" });
+  assert.equal(svc.listRoomBookings("r1").length, 3);
+  assert.equal(svc.listRoomBookings("r2").length, 1);
+});
+
+// ---------- createBooking: holds ----------
+
+test("createBooking with holdMinutes creates a held booking with expiresAt", () => {
+  const svc = makeService();
+  const hold = book(svc, 600, 660, { nowMinute: 100, holdMinutes: 15 });
+  assert.equal(hold.status, "held");
+  assert.equal(hold.expiresAt, 115);
+  assert.equal(hold.subtotalCents, 10000);
+
+  const plain = book(svc, 0, 60);
+  assert.equal(plain.status, "confirmed");
+  assert.equal("expiresAt" in plain, false);
+});
+
+test("active hold blocks overlapping slots until it expires", () => {
+  const svc = makeService();
+  book(svc, 600, 660, { nowMinute: 100, holdMinutes: 15 });
+  assert.throws(() => book(svc, 630, 690, { nowMinute: 100 }), ConflictError);
+  assert.throws(() => book(svc, 630, 690, { nowMinute: 114 }), ConflictError);
+  // also blocks a competing hold
+  assert.throws(() => book(svc, 600, 660, { nowMinute: 110, holdMinutes: 5 }), ConflictError);
+  // back-to-back with a hold is fine
+  book(svc, 660, 720, { nowMinute: 100 });
+  // at expiresAt the hold no longer blocks
+  const after = book(svc, 600, 660, { nowMinute: 115 });
+  assert.equal(after.status, "confirmed");
+});
+
+test("createBooking defaults nowMinute to 0", () => {
+  const svc = makeService();
+  const hold = book(svc, 600, 660, { holdMinutes: 10 });
+  assert.equal(hold.expiresAt, 10);
+  assert.throws(() => book(svc, 600, 660), ConflictError); // now=0 < 10
+});
+
+test("holdMinutes validation respects config.maxHoldMinutes", () => {
+  const svc = makeService();
+  assert.equal(svc.config.maxHoldMinutes, 60);
+  book(svc, 0, 60, { holdMinutes: 60 });
+  for (const h of [61, 0, -5, 1.5, Number.NaN]) {
+    assert.throws(() => book(svc, 200, 260, { holdMinutes: h }), ValidationError, String(h));
+  }
+  const custom = makeService({ BOOKING_MAX_HOLD_MINUTES: "5" });
+  book(custom, 0, 60, { holdMinutes: 5 });
+  assert.throws(() => book(custom, 100, 160, { holdMinutes: 6 }), ValidationError);
+});
+
+test("createBooking rejects invalid nowMinute", () => {
+  const svc = makeService();
+  for (const n of [-1, 1.5, Number.NaN]) {
+    assert.throws(() => book(svc, 0, 60, { nowMinute: n }), ValidationError, String(n));
+  }
+});
+
+// ---------- confirmHold ----------
+
+test("confirmHold confirms a live hold and clears expiresAt", () => {
+  const svc = makeService();
+  const hold = book(svc, 600, 660, { nowMinute: 100, holdMinutes: 15 });
+  const confirmed = svc.confirmHold(hold.bookingId, 114);
+  assert.equal(confirmed.status, "confirmed");
+  assert.equal("expiresAt" in confirmed, false);
+  assert.equal(confirmed.bookingId, hold.bookingId);
+  assert.equal(confirmed.totalCents, hold.totalCents);
+  assert.deepEqual(svc.getBooking(hold.bookingId), confirmed);
+  // once confirmed it blocks the slot indefinitely
+  assert.throws(() => book(svc, 600, 660, { nowMinute: 10_000 }), ConflictError);
+});
+
+test("confirmHold rejects expired holds (at or after expiresAt)", () => {
+  const svc = makeService();
+  const hold = book(svc, 600, 660, { nowMinute: 100, holdMinutes: 15 });
+  assert.throws(() => svc.confirmHold(hold.bookingId, 115), ValidationError);
+  assert.throws(() => svc.confirmHold(hold.bookingId, 500), ValidationError);
+  assert.equal(svc.getBooking(hold.bookingId).status, "held");
+});
+
+test("confirmHold rejects unknown bookings, non-held bookings, and invalid nowMinute", () => {
+  const svc = makeService();
+  assert.throws(() => svc.confirmHold("bkg_9999", 0), ValidationError);
+  const confirmed = book(svc, 0, 60);
+  assert.throws(() => svc.confirmHold(confirmed.bookingId, 0), ValidationError);
+  const hold = book(svc, 100, 160, { holdMinutes: 10 });
+  svc.confirmHold(hold.bookingId, 5);
+  assert.throws(() => svc.confirmHold(hold.bookingId, 5), ValidationError, "double confirm");
+  const hold2 = book(svc, 200, 260, { holdMinutes: 10 });
+  assert.throws(() => svc.confirmHold(hold2.bookingId, -1), ValidationError);
+});
