+/**
+ * Exact integer division rounded half-up: round(numerator / denominator).
+ * Rejects inputs whose intermediate (numerator * 2 + denominator) would exceed
+ * Number.MAX_SAFE_INTEGER, since the result could no longer be exact.
+ */
+export function roundHalfUpDiv(numerator: number, denominator: number): number {
+  validateNonNegativeInt(numerator, "numerator");
+  validatePositiveInt(denominator, "denominator");
+  const doubledPlusDenominator = numerator * 2 + denominator;
+  if (!Number.isSafeInteger(doubledPlusDenominator)) {
+    throw new ValidationError("numerator is too large for exact rounding");
+  }
+  return Math.floor(doubledPlusDenominator / (2 * denominator));
+}
+
 export function calculateLegacyDeposit(subtotalCents: number): number {
