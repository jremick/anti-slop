+// ---------- module structure ----------
+
+test("src modules have no circular imports and bookings.ts does not import corporate.ts", () => {
+  const srcDir = join(dirname(fileURLToPath(import.meta.url)), "..", "src");
+  const graph = new Map<string, string[]>();
+  for (const file of readdirSync(srcDir).filter((f) => f.endsWith(".ts"))) {
+    const text = readFileSync(join(srcDir, file), "utf8");
+    const deps = [...text.matchAll(/from\s+["']\.\/([\w-]+\.ts)["']/g)].map((m) => m[1]!);
+    graph.set(file, deps);
+  }
+  assert.ok(graph.has("corporate.ts"));
+  assert.equal(graph.get("bookings.ts")!.includes("corporate.ts"), false);
+
+  const visiting = new Set<string>();
+  const done = new Set<string>();
+  const visit = (node: string, path: string[]): void => {
+    if (done.has(node)) return;
+    assert.equal(visiting.has(node), false, `cycle: ${[...path, node].join(" -> ")}`);
+    visiting.add(node);
+    for (const dep of graph.get(node) ?? []) visit(dep, [...path, node]);
+    visiting.delete(node);
+    done.add(node);
+  };
+  for (const node of graph.keys()) visit(node, []);
+});
