+import type { GroupBookingInput, Room } from "../src/index.ts";
+
+const ROOMS: readonly Room[] = [
+  { roomId: "r1", name: "Room 1", hourlyRateCents: 10000, taxBps: 825 },
+  { roomId: "r2", name: "Room 2", hourlyRateCents: 6000, taxBps: 0 },
+  { roomId: "r3", name: "Room 3", hourlyRateCents: 1001, taxBps: 825 },
+];
+
+function makeService(): BookingService {
+  const svc = new BookingService({ env: {} });
+  for (const room of ROOMS) {
+    svc.registerRoom(room);
+  }
+  return svc;
+}
+
+function groupInput(overrides: Partial<GroupBookingInput> = {}): GroupBookingInput {
+  return {
+    customerId: "corp_1",
+    roomIds: ["r1", "r2", "r3"],
+    startMinute: 600,
+    endMinute: 690,
+    discountBps: 1250,
+    ...overrides,
+  };
+}
+
+function totalBookings(svc: BookingService): number {
+  return ROOMS.reduce((n, r) => n + svc.listRoomBookings(r.roomId).length, 0);
+}
+
+// ---------- applyDiscountAndTax ----------
+
+test("applyDiscountAndTax discounts with half-up rounding, then taxes the discounted subtotal", () => {
+  // 15000 * 12.5% = 1875; 13125 * 8.25% = 1082.8125 -> 1083
+  assert.deepEqual(applyDiscountAndTax(15000, 1250, 825), {
+    subtotalCents: 13125,
+    discountCents: 1875,
+    taxCents: 1083,
+    totalCents: 14208,
+  });
+  // 1000 * 0.15% = 1.5 -> 2 (half-up)
+  assert.equal(applyDiscountAndTax(1000, 15, 0).discountCents, 2);
+  // 1000 * 0.14% = 1.4 -> 1
+  assert.equal(applyDiscountAndTax(1000, 14, 0).discountCents, 1);
+  assert.deepEqual(applyDiscountAndTax(1234, 0, 0), {
+    subtotalCents: 1234,
+    discountCents: 0,
+    taxCents: 0,
+    totalCents: 1234,
+  });
+  assert.deepEqual(applyDiscountAndTax(1234, 10000, 825), {
+    subtotalCents: 0,
+    discountCents: 1234,
+    taxCents: 0,
+    totalCents: 0,
+  });
+});
+
+test("applyDiscountAndTax rejects out-of-range or non-integer inputs", () => {
+  for (const [gross, disc, tax] of [
+    [-1, 0, 0],
+    [1.5, 0, 0],
+    [100, -1, 0],
+    [100, 10001, 0],
+    [100, 1.5, 0],
+    [100, 0, -1],
+    [100, 0, 10001],
+    [100, 0, Number.NaN],
+  ] as const) {
+    assert.throws(() => applyDiscountAndTax(gross, disc, tax), ValidationError, `${gross},${disc},${tax}`);
+  }
+});
+
+test("calculateBookingPrice applies optional discountBps via the shared helper", () => {
+  const room = ROOMS[2]!;
+  // gross 1001 * 90 / 60 = 1501.5 -> 1502
+  assert.deepEqual(calculateBookingPrice(room, 90), {
+    subtotalCents: 1502,
+    discountCents: 0,
+    taxCents: 124, // 123.915 -> 124
+    totalCents: 1626,
+    depositCents: 0,
+  });
+  // discount 1502 * 12.5% = 187.75 -> 188; sub 1314; tax 108.405 -> 108
+  assert.deepEqual(calculateBookingPrice(room, 90, { discountBps: 1250 }), {
+    subtotalCents: 1314,
+    discountCents: 188,
+    taxCents: 108,
+    totalCents: 1422,
+    depositCents: 0,
+  });
+  assert.throws(() => calculateBookingPrice(room, 90, { discountBps: 10001 }), ValidationError);
+});
+
+// ---------- createGroupBooking: pricing ----------
+
+test("createGroupBooking prices each room canonically and sums the group totals", () => {
+  const svc = makeService();
+  const result = createGroupBooking(svc, groupInput());
+
+  // r1: gross 15000, disc 1875, sub 13125, tax 1083, total 14208
+  // r2: gross  9000, disc 1125, sub  7875, tax    0, total  7875
+  // r3: gross  1502, disc  188, sub  1314, tax  108, total  1422
+  assert.equal(result.bookings.length, 3);
+  assert.deepEqual(
+    result.bookings.map((b) => [b.roomId, b.subtotalCents, b.discountCents, b.taxCents, b.totalCents]),
+    [
+      ["r1", 13125, 1875, 1083, 14208],
+      ["r2", 7875, 1125, 0, 7875],
+      ["r3", 1314, 188, 108, 1422],
+    ],
+  );
+  assert.equal(result.subtotalCents, 22314);
+  assert.equal(result.discountCents, 3188);
+  assert.equal(result.taxCents, 1191);
+  assert.equal(result.totalCents, 23505);
+  assert.equal(result.subtotalCents + result.taxCents, result.totalCents);
+
+  // Each booking matches the canonical single-room price.
+  for (const b of result.bookings) {
+    const room = svc.getRoom(b.roomId);
+    const expected = calculateBookingPrice(room, 90, { discountBps: 1250 });
+    assert.equal(b.totalCents, expected.totalCents, b.roomId);
+  }
+});
