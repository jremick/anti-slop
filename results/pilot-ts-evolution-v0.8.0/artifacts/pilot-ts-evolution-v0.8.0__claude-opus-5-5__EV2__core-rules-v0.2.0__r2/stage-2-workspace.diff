+// ---------- createGroupBooking: atomic conflicts ----------
+
+test("a conflict in any one room rejects the whole group with zero partial bookings", () => {
+  const svc = makeService();
+  // Only the LAST requested room is busy, so a non-atomic implementation would
+  // have already committed r1 and r2 before detecting it.
+  const blocker = svc.createBooking({ roomId: "r3", customerId: "other", startMinute: 660, endMinute: 720 });
+  const before = totalBookings(svc);
+
+  assert.throws(() => createGroupBooking(svc, groupInput()), (err: unknown) => {
+    assert.ok(err instanceof ConflictError);
+    assert.match(err.message, /r3/);
+    assert.match(err.message, new RegExp(blocker.bookingId));
+    return true;
+  });
+  assert.equal(totalBookings(svc), before);
+  assert.equal(svc.listRoomBookings("r1").length, 0);
+  assert.equal(svc.listRoomBookings("r2").length, 0);
