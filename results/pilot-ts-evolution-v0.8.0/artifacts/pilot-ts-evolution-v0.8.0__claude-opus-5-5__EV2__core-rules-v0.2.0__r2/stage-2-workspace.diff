+// Dependency direction: corporate.ts -> bookings.ts -> pricing.ts -> models.ts.
+// bookings.ts must never import this module.
+import { isBookingActiveAt, slotsOverlap, validateSlotRequest } from "./bookings.ts";
+import type { BookingService } from "./bookings.ts";
+import { ConflictError, ValidationError } from "./models.ts";
+import type { Booking, Room } from "./models.ts";
+import { calculateBookingPrice, validateBps } from "./pricing.ts";
+
+export interface GroupBookingInput {
+  readonly customerId: string;
+  readonly roomIds: readonly string[];
+  readonly startMinute: number;
+  readonly endMinute: number;
+  readonly discountBps: number;
+  readonly nowMinute?: number;
+}
+
+export interface GroupBookingResult {
+  readonly groupId: string;
+  readonly bookings: readonly Booking[];
+  readonly subtotalCents: number;
+  readonly discountCents: number;
+  readonly taxCents: number;
+  readonly totalCents: number;
+}
+
+/**
+ * Books the same slot in every requested room, or none of them.
+ * All validation, conflict checks and pricing run before the first booking is committed.
+ */
+export function createGroupBooking(
+  service: BookingService,
+  input: GroupBookingInput,
+): GroupBookingResult {
+  validateSlotRequest(input);
+  validateBps(input.discountBps, "discountBps");
+  if (!Array.isArray(input.roomIds) || input.roomIds.length < 2) {
+    throw new ValidationError("roomIds must contain at least 2 rooms");
+  }
+  if (new Set(input.roomIds).size !== input.roomIds.length) {
+    throw new ValidationError("roomIds must not contain duplicates");
+  }
+  const rooms: Room[] = input.roomIds.map((roomId) => service.getRoom(roomId));
+  const nowMinute = input.nowMinute ?? 0;
+
+  const conflicts: string[] = [];
+  for (const room of rooms) {
+    for (const existing of service.listRoomBookings(room.roomId)) {
+      if (
+        isBookingActiveAt(existing, nowMinute) &&
+        slotsOverlap(input.startMinute, input.endMinute, existing.startMinute, existing.endMinute)
+      ) {
+        conflicts.push(`${room.roomId} (${existing.bookingId})`);
+      }
+    }
+  }
+  if (conflicts.length > 0) {
+    throw new ConflictError(`Group booking conflicts in: ${conflicts.join(", ")}`);
+  }
+
+  // Price every room up front so a pricing error cannot interrupt the commit loop.
+  const duration = input.endMinute - input.startMinute;
+  for (const room of rooms) {
+    calculateBookingPrice(room, duration, { discountBps: input.discountBps });
+  }
+
+  const groupId = service.nextGroupId();
+  const bookings = rooms.map((room) =>
+    service.createBooking({
+      roomId: room.roomId,
+      customerId: input.customerId,
+      startMinute: input.startMinute,
+      endMinute: input.endMinute,
+      nowMinute,
+      discountBps: input.discountBps,
+      groupId,
+    })
+  );
+
+  const sum = (pick: (b: Booking) => number): number =>
+    bookings.reduce((acc, b) => acc + pick(b), 0);
+  return {
+    groupId,
+    bookings,
+    subtotalCents: sum((p) => p.subtotalCents),
+    discountCents: sum((p) => p.discountCents),
+    taxCents: sum((p) => p.taxCents),
+    totalCents: sum((p) => p.totalCents),
+  };
+}

