+  // Back-to-back group booking gets a new distinct groupId and supports 0% or 100% discount
+  const second = createGroupBooking(svc, {
+    customerId: "corp_acme",
+    roomIds: ["alpha", "beta"],
+    startMinute: 105,
+    endMinute: 165,
+    discountBps: 10000,
+  });
+  assert.notEqual(second.groupId, result.groupId);
+  assert.equal(second.subtotalCents, 0);
+  assert.equal(second.taxCents, 0);
+  assert.equal(second.totalCents, 0);
+  assert.equal(second.discountCents, 10001 + 8000);
+});
