+function validateConfigBps(value: unknown, fieldName: string): number {
+  if (
+    typeof value !== "number" ||
+    !Number.isInteger(value) ||
+    value < 0 ||
+    value > 10000
+  ) {
+    throw new ConfigError(`${fieldName} must be an integer between 0 and 10000`);
+  }
+  return value;
+}
+
+function validateCancellationFeeConfig(value: unknown): CancellationFeeConfig {
+  if (value === null || typeof value !== "object" || Array.isArray(value)) {
+    throw new ConfigError("BOOKING_CANCEL_FEE_TIERS_JSON must be a JSON object");
+  }
+  const obj = value as Record<string, unknown>;
+  const cutoffMinutes = obj.cutoffMinutes;
+  if (
+    typeof cutoffMinutes !== "number" ||
+    !Number.isInteger(cutoffMinutes) ||
+    cutoffMinutes < 0
+  ) {
+    throw new ConfigError("cutoffMinutes must be a non-negative integer");
+  }
+  const earlyFeeBps = validateConfigBps(obj.earlyFeeBps, "earlyFeeBps");
+  const lateFeeBps = validateConfigBps(obj.lateFeeBps, "lateFeeBps");
+  return { cutoffMinutes, earlyFeeBps, lateFeeBps };
+}
+
+export function loadCancellationFeeConfig(
+  env: Record<string, string | undefined> = process.env,
+): CancellationFeeConfig {
+  const raw = env.BOOKING_CANCEL_FEE_TIERS_JSON;
+  if (typeof raw !== "string" || raw.trim() === "") {
+    throw new ConfigError("BOOKING_CANCEL_FEE_TIERS_JSON is required");
+  }
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(raw);
+  } catch {
+    throw new ConfigError("BOOKING_CANCEL_FEE_TIERS_JSON must be valid JSON");
+  }
+  return validateCancellationFeeConfig(parsed);
+}
+
+export function selectCancellationFeeBps(
+  minutesBeforeStart: number,
+  cfg: CancellationFeeConfig,
+): number {
+  if (!Number.isInteger(minutesBeforeStart) || minutesBeforeStart < 0) {
+    throw new ValidationError("minutesBeforeStart must be a non-negative integer");
+  }
+  const validated = validateCancellationFeeConfig(cfg);
+  return minutesBeforeStart >= validated.cutoffMinutes
+    ? validated.earlyFeeBps
+    : validated.lateFeeBps;
+}

