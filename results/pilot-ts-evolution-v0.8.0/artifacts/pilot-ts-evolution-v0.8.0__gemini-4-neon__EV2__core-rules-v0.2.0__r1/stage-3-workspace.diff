+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  calculateBookingPrice,
+  createGroupBooking,
+} from "../src/index.ts";
+
+function setupService() {
+  const svc = new BookingService({ env: {} });
+  svc.registerRoom({
+    roomId: "alpha",
+    name: "Alpha Hall",
+    hourlyRateCents: 10001,
+    taxBps: 825,
+  });
+  svc.registerRoom({
+    roomId: "beta",
+    name: "Beta Hall",
+    hourlyRateCents: 8000,
+    taxBps: 1000,
+  });
+  svc.registerRoom({
+    roomId: "gamma",
+    name: "Gamma Hall",
+    hourlyRateCents: 6000,
+    taxBps: 500,
+  });
+  return svc;
+}
+
+test("createGroupBooking prices multiple rooms with canonical helper and shared groupId", () => {
+  const svc = setupService();
+
+  // 45 minutes, 12.5% corporate discount (1250 bps)
+  const result = createGroupBooking(svc, {
+    customerId: "corp_acme",
+    roomIds: ["alpha", "beta"],
+    startMinute: 60,
+    endMinute: 105,
+    discountBps: 1250,
+  });
+
+  assert.ok(result.groupId.length > 0);
+  assert.equal(result.bookings.length, 2);
+
+  // Alpha: gross = roundHalfUpDiv(10001*45, 60) = 7501
+  //   discount = roundHalfUpDiv(7501*1250, 10000) = 938
+  //   subtotal = 6563, tax = roundHalfUpDiv(6563*825, 10000) = 541, total = 7104
+  // Beta: gross = roundHalfUpDiv(8000*45, 60) = 6000
+  //   discount = 750, subtotal = 5250, tax = 525, total = 5775
+  const expectedAlpha = calculateBookingPrice(svc.getRoom("alpha"), 45, {
+    discountBps: 1250,
+  });
+  const expectedBeta = calculateBookingPrice(svc.getRoom("beta"), 45, {
+    discountBps: 1250,
+  });
+
+  const [bAlpha, bBeta] = result.bookings;
+  assert.equal(bAlpha.roomId, "alpha");
+  assert.equal(bAlpha.status, "confirmed");
+  assert.equal(bAlpha.groupId, result.groupId);
+  assert.equal(bAlpha.subtotalCents, expectedAlpha.subtotalCents);
+  assert.equal(bAlpha.discountCents, expectedAlpha.discountCents);
+  assert.equal(bAlpha.taxCents, expectedAlpha.taxCents);
+  assert.equal(bAlpha.totalCents, expectedAlpha.totalCents);
+
+  assert.equal(bBeta.roomId, "beta");
+  assert.equal(bBeta.status, "confirmed");
+  assert.equal(bBeta.groupId, result.groupId);
+  assert.equal(bBeta.subtotalCents, expectedBeta.subtotalCents);
+  assert.equal(bBeta.discountCents, expectedBeta.discountCents);
+  assert.equal(bBeta.taxCents, expectedBeta.taxCents);
+  assert.equal(bBeta.totalCents, expectedBeta.totalCents);
+
+  assert.equal(result.subtotalCents, 6563 + 5250);
+  assert.equal(result.discountCents, 938 + 750);
+  assert.equal(result.taxCents, 541 + 525);
+  assert.equal(result.totalCents, 7104 + 5775);
+  assert.equal(result.totalCents, result.subtotalCents + result.taxCents);
+
+  // Persisted in BookingService with shared groupId
+  assert.equal(svc.getBooking(bAlpha.bookingId).groupId, result.groupId);
+  assert.equal(svc.getBooking(bBeta.bookingId).groupId, result.groupId);
+  assert.equal(svc.listRoomBookings("alpha").length, 1);
+  assert.equal(svc.listRoomBookings("beta").length, 1);
