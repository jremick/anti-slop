+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  ValidationError,
+  applyDiscountAndTax,
+  calculateBookingPrice,
+  computeTaxCents,
+  roundHalfUpDiv,
+} from "../src/index.ts";
+
+test("roundHalfUpDiv performs exact integer half-up rounding", () => {
+  assert.equal(roundHalfUpDiv(0, 1), 0);
+  assert.equal(roundHalfUpDiv(0, 60), 0);
+  assert.equal(roundHalfUpDiv(120, 60), 2);
+
+  // Below half rounds down
+  assert.equal(roundHalfUpDiv(1, 3), 0);
+  assert.equal(roundHalfUpDiv(29, 60), 0);
+  assert.equal(roundHalfUpDiv(89, 60), 1);
+
+  // Exact half always rounds up (both even and odd integer parts)
+  assert.equal(roundHalfUpDiv(1, 2), 1);
+  assert.equal(roundHalfUpDiv(3, 2), 2);
+  assert.equal(roundHalfUpDiv(5, 2), 3);
+  assert.equal(roundHalfUpDiv(30, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2);
+  assert.equal(roundHalfUpDiv(150, 60), 3);
+
+  // Above half rounds up
+  assert.equal(roundHalfUpDiv(2, 3), 1);
+  assert.equal(roundHalfUpDiv(31, 60), 1);
+});
+
+test("roundHalfUpDiv rejects invalid inputs with ValidationError", () => {
+  assert.throws(() => roundHalfUpDiv(-1, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(1.5, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.NaN, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.POSITIVE_INFINITY, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, 0), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, -60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, 2.5), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, Number.NaN), ValidationError);
+});
+
+test("calculateBookingPrice supports fractional durations with half-up subtotal and tax", () => {
+  const room = {
+    roomId: "studio_1",
+    name: "Studio 1",
+    hourlyRateCents: 10001,
+    taxBps: 825,
+  };
+
+  // 10001 * 45 / 60 = 7500.75 -> 7501; tax = 7501 * 825 / 10000 = 618.8325 -> 619
+  const price45 = calculateBookingPrice(room, 45);
+  assert.equal(price45.subtotalCents, 7501);
+  assert.equal(price45.discountCents, 0);
+  assert.equal(price45.taxCents, 619);
+  assert.equal(price45.totalCents, 8120);
+  assert.equal(price45.depositCents, 0);
+
+  // Exact half-cent subtotal cases: 101 * 30 / 60 = 50.5 -> 51, 103 * 30 / 60 = 51.5 -> 52
+  const halfOdd = calculateBookingPrice(
+    { roomId: "r1", name: "R1", hourlyRateCents: 101, taxBps: 0 },
+    30,
+  );
+  assert.equal(halfOdd.subtotalCents, 51);
+  assert.equal(halfOdd.totalCents, 51);
+
+  const halfEven = calculateBookingPrice(
+    { roomId: "r2", name: "R2", hourlyRateCents: 103, taxBps: 0 },
+    30,
+  );
+  assert.equal(halfEven.subtotalCents, 52);
+  assert.equal(halfEven.totalCents, 52);
+
+  // 1/3 and 2/3 hour rounding
+  const thirdRoom = { roomId: "r3", name: "R3", hourlyRateCents: 100, taxBps: 0 };
+  assert.equal(calculateBookingPrice(thirdRoom, 20).subtotalCents, 33);
+  assert.equal(calculateBookingPrice(thirdRoom, 40).subtotalCents, 67);
+
+  // 1-minute duration boundary (30/60 = 0.5 -> 1; 29/60 = 0.483... -> 0)
+  assert.equal(
+    calculateBookingPrice({ roomId: "r4", name: "R4", hourlyRateCents: 30, taxBps: 0 }, 1)
+      .subtotalCents,
+    1,
+  );
+  assert.equal(
+    calculateBookingPrice({ roomId: "r5", name: "R5", hourlyRateCents: 29, taxBps: 0 }, 1)
+      .subtotalCents,
+    0,
+  );
+
+  // Exact half-cent tax (200 * 25 / 10000 = 0.5 -> 1)
+  const taxHalf = calculateBookingPrice(
+    { roomId: "r6", name: "R6", hourlyRateCents: 400, taxBps: 25 },
+    30,
+    { legacyDepositMode: true },
+  );
+  assert.equal(taxHalf.subtotalCents, 200);
+  assert.equal(taxHalf.taxCents, computeTaxCents(200, 25));
+  assert.equal(taxHalf.taxCents, 1);
+  assert.equal(taxHalf.totalCents, 201);
+  assert.equal(taxHalf.depositCents, 50);
+});
+
+test("calculateBookingPrice rejects non-positive or non-integer durationMinutes", () => {
+  const room = { roomId: "r", name: "R", hourlyRateCents: 6000, taxBps: 500 };
+  assert.throws(() => calculateBookingPrice(room, 0), ValidationError);
+  assert.throws(() => calculateBookingPrice(room, -30), ValidationError);
+  assert.throws(() => calculateBookingPrice(room, 45.5), ValidationError);
+});
+
+test("applyDiscountAndTax computes half-up discount, net subtotal, tax, and total", () => {
+  // Exact half-up discount: 100 * 50 / 10000 = 0.5 -> 1; 300 * 50 / 10000 = 1.5 -> 2
+  assert.deepEqual(applyDiscountAndTax(100, 50, 0), {
+    subtotalCents: 99,
+    discountCents: 1,
+    taxCents: 0,
+    totalCents: 99,
+  });
+  assert.deepEqual(applyDiscountAndTax(300, 50, 0), {
+    subtotalCents: 298,
+    discountCents: 2,
+    taxCents: 0,
+    totalCents: 298,
+  });
+
+  // Combined discount + tax: 7501 * 1250 / 10000 = 937.625 -> 938; net = 6563; tax = 6563 * 825 / 10000 = 541.4475 -> 541
+  assert.deepEqual(applyDiscountAndTax(7501, 1250, 825), {
+    subtotalCents: 6563,
+    discountCents: 938,
+    taxCents: 541,
+    totalCents: 7104,
+  });
+
+  // 0% and 100% boundaries
+  assert.deepEqual(applyDiscountAndTax(0, 0, 0), {
+    subtotalCents: 0,
+    discountCents: 0,
+    taxCents: 0,
+    totalCents: 0,
+  });
+  assert.deepEqual(applyDiscountAndTax(5000, 10000, 825), {
+    subtotalCents: 0,
+    discountCents: 5000,
+    taxCents: 0,
+    totalCents: 0,
+  });
+});
+
+test("applyDiscountAndTax and calculateBookingPrice validate discountBps and taxBps bounds", () => {
+  assert.throws(() => applyDiscountAndTax(-1, 500, 500), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100.5, 500, 500), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, -1, 500), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 10001, 500), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 250.5, 500), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 500, -1), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 500, 10001), ValidationError);
+
+  const room = { roomId: "r", name: "R", hourlyRateCents: 10001, taxBps: 825 };
+  const discounted = calculateBookingPrice(room, 45, {
+    discountBps: 1250,
+    legacyDepositMode: true,
+  });
+  assert.equal(discounted.discountCents, 938);
+  assert.equal(discounted.subtotalCents, 6563);
+  assert.equal(discounted.taxCents, 541);
+  assert.equal(discounted.totalCents, 7104);
+  // Deposit is 25% of net subtotal (6563 * 2500 / 10000 = 1640.75 -> 1641)
+  assert.equal(discounted.depositCents, 1641);
+
+  assert.throws(() => calculateBookingPrice(room, 60, { discountBps: -1 }), ValidationError);
+  assert.throws(() => calculateBookingPrice(room, 60, { discountBps: 10001 }), ValidationError);
+});
