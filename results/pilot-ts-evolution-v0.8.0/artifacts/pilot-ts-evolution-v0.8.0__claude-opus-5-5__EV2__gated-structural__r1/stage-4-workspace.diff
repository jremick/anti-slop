+    assert.ok(!stack.includes(node), `import cycle: ${[...stack, node].join(" -> ")}`);
+    if (done.has(node)) return;
+    for (const dep of graph.get(node) ?? []) visit(dep, [...stack, node]);
+    done.add(node);
+  };
+  for (const node of graph.keys()) visit(node, []);
+});

