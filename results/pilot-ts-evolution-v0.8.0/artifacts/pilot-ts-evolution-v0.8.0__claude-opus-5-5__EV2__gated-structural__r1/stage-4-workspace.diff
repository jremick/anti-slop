+    roomId: "r1",
+    customerId: "c",
+    amountCents: 5412,
+  });
+  assert.equal(events.length, 2);
+});
+
+test("notifyHook observes the committed state while it runs", () => {
+  const statuses: string[] = [];
+  const svc: BookingService = new BookingService({
+    env: { [CANCEL_FEE_TIERS_ENV_VAR]: TIERS },
