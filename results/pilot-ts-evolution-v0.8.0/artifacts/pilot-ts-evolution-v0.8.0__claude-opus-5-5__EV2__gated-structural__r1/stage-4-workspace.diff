+ * cancellations fail closed rather than silently refunding in full.
+ */
+export function loadCancellationFeeConfig(env: BookingEnv = resolveEnv()): CancellationFeeConfig {
+  const raw = env[CANCEL_FEE_TIERS_ENV_VAR];
+  if (raw === undefined || raw.trim() === "") {
+    throw new ConfigError(`${CANCEL_FEE_TIERS_ENV_VAR} is required`);
+  }
