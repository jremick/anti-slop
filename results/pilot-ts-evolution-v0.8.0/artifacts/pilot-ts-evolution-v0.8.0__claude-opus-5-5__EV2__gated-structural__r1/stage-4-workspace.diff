+  const cutoffMinutes = record.cutoffMinutes;
+  if (typeof cutoffMinutes !== "number" || !Number.isInteger(cutoffMinutes) || cutoffMinutes < 0) {
+    throw new ConfigError(`${CANCEL_FEE_TIERS_ENV_VAR}.cutoffMinutes must be a non-negative integer`);
+  }
+  return {
+    cutoffMinutes,
+    earlyFeeBps: requireConfigBps(record.earlyFeeBps, "earlyFeeBps"),
+    lateFeeBps: requireConfigBps(record.lateFeeBps, "lateFeeBps"),
+  };
+}
