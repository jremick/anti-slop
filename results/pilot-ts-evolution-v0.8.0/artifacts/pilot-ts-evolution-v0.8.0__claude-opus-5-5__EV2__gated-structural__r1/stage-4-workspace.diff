+  for (const name of ["LEGACY_DEPOSIT_BPS", "calculateLegacyDeposit"]) {
+    assert.equal(name in api, false, `index exports ${name}`);
+    assert.equal(name in pricing, false, `pricing exports ${name}`);
+  }
+});
+
+test("prices and bookings no longer carry depositCents", () => {
+  assert.deepEqual(Object.keys(calculateBookingPrice(ROOM_1, 60)).sort(), [
+    "discountCents",
+    "subtotalCents",
+    "taxCents",
+    "totalCents",
+  ]);
+  const svc = new BookingService({ env: {} });
+  svc.registerRoom(ROOM_1);
+  const booking = svc.createBooking({ roomId: "r1", customerId: "c", startMinute: 0, endMinute: 60 });
+  assert.equal("depositCents" in booking, false);
+});
