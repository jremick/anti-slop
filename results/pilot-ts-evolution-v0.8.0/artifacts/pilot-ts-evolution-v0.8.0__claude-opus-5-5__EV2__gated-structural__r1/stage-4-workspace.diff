+    ConflictError,
+  );
+  assert.throws(
+    () => svc.createBooking({ roomId: "r1", customerId: "c", startMinute: 700, endMinute: 690 }),
+    ValidationError,
+  );
+  assert.throws(
+    () => createGroupBooking(svc, { customerId: "c", roomIds: ["r2", "r1"], startMinute: 600, endMinute: 660, discountBps: 0 }),
+    ConflictError,
+  );
+  svc.confirmHold(hold.bookingId, 5);
+  assert.throws(() => svc.cancelBooking(hold.bookingId, 601), ValidationError);
+  assert.deepEqual(events, []);
+});
