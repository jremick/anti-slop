+function requireConfigBps(value: unknown, field: string): number {
+  if (typeof value !== "number" || !Number.isInteger(value) || value < 0 || value > 10000) {
+    throw new ConfigError(`${CANCEL_FEE_TIERS_ENV_VAR}.${field} must be an integer between 0 and 10000`);
+  }
