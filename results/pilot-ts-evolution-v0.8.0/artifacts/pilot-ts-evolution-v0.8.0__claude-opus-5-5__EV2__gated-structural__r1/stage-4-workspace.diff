+import { fileURLToPath } from "node:url";
+import * as api from "../src/index.ts";
+import * as pricing from "../src/pricing.ts";
+import {
+  BookingService,
+  CANCEL_FEE_TIERS_ENV_VAR,
+  ConflictError,
+  ValidationError,
+  calculateBookingPrice,
+  createGroupBooking,
+} from "../src/index.ts";
+import type { BookingNotification, Room } from "../src/index.ts";
+
+const TIERS = JSON.stringify({ cutoffMinutes: 120, earlyFeeBps: 1000, lateFeeBps: 5000 });
+const ROOM_1: Room = { roomId: "r1", name: "Room 1", hourlyRateCents: 10000, taxBps: 825 };
+const ROOM_2: Room = { roomId: "r2", name: "Room 2", hourlyRateCents: 6000, taxBps: 0 };
+const ROOM_3: Room = { roomId: "r3", name: "Room 3", hourlyRateCents: 5000, taxBps: 500 };
+
+class HookFailure extends Error {}
+
+interface Harness {
+  readonly svc: BookingService;
+  readonly events: BookingNotification[];
+  /** Throw from the hook on the Nth call from now (1-based); `undefined` disables failures. */
+  failOnCall: number | undefined;
+}
+
+function makeHarness(): Harness {
+  const events: BookingNotification[] = [];
+  const harness: Harness = {
+    events,
+    failOnCall: undefined,
+    svc: new BookingService({
+      env: { [CANCEL_FEE_TIERS_ENV_VAR]: TIERS },
+      notifyHook: (event) => {
+        if (harness.failOnCall !== undefined) {
+          harness.failOnCall -= 1;
+          if (harness.failOnCall === 0) {
+            harness.failOnCall = undefined;
+            throw new HookFailure(`hook rejected ${event.event} ${event.bookingId}`);
+          }
+        }
+        events.push(event);
+      },
+    }),
+  };
+  for (const room of [ROOM_1, ROOM_2, ROOM_3]) {
+    harness.svc.registerRoom(room);
+  }
+  return harness;
+}
+
+function allBookings(svc: BookingService) {
+  return [ROOM_1, ROOM_2, ROOM_3].flatMap((room) => svc.listRoomBookings(room.roomId));
+}
+
