+test("BookingService rejects a non-function notifyHook", () => {
+  assert.throws(
+    () => new BookingService({ env: {}, notifyHook: "nope" as unknown as (e: BookingNotification) => void }),
+    ValidationError,
+  );
+});
+
+// --- fail-closed rollback ---
+
+test("a throwing hook on createBooking propagates and persists nothing", () => {
+  const h = makeHarness();
+  h.failOnCall = 1;
+  assert.throws(
+    () => h.svc.createBooking({ roomId: "r1", customerId: "c", startMinute: 600, endMinute: 660 }),
+    HookFailure,
+  );
+  assert.deepEqual(allBookings(h.svc), []);
+  assert.deepEqual(h.events, []);
+
+  // The slot is free; a retry with a healthy hook succeeds.
+  const retry = h.svc.createBooking({ roomId: "r1", customerId: "c", startMinute: 600, endMinute: 660 });
+  assert.equal(allBookings(h.svc).length, 1);
+  assert.equal(h.events.length, 1);
+  assert.equal(h.events[0].bookingId, retry.bookingId);
+});
+
+test("a hook failure mid-group rolls back every room of the group", () => {
+  const h = makeHarness();
+  const existing = h.svc.createBooking({ roomId: "r3", customerId: "x", startMinute: 0, endMinute: 60 });
+  h.events.length = 0;
+
+  for (const failOn of [1, 2, 3]) {
+    h.failOnCall = failOn;
+    assert.throws(
+      () =>
+        createGroupBooking(h.svc, {
+          customerId: "corp",
+          roomIds: ["r1", "r2", "r3"],
+          startMinute: 600,
+          endMinute: 660,
+          discountBps: 0,
+        }),
+      HookFailure,
+      `fail on call ${failOn}`,
+    );
+    assert.deepEqual(allBookings(h.svc), [existing], `fail on call ${failOn}`);
+    assert.equal(h.events.length, failOn - 1); // only events emitted before the failure
+    h.events.length = 0;
+  }
+
+  // Every room's slot is still free afterwards.
+  const group = createGroupBooking(h.svc, {
+    customerId: "corp",
+    roomIds: ["r1", "r2", "r3"],
+    startMinute: 600,
+    endMinute: 660,
+    discountBps: 0,
+  });
+  assert.equal(group.bookings.length, 3);
+  assert.equal(allBookings(h.svc).length, 4);
+});
+
+test("a throwing hook on cancelBooking propagates and restores the booking", () => {
+  const h = makeHarness();
+  const booking = h.svc.createBooking({ roomId: "r1", customerId: "c", startMinute: 600, endMinute: 660 });
+  h.events.length = 0;
+
+  h.failOnCall = 1;
+  assert.throws(() => h.svc.cancelBooking(booking.bookingId, 0), HookFailure);
+  assert.deepEqual(h.svc.getBooking(booking.bookingId), booking);
+  assert.deepEqual(h.events, []);
+  assert.throws(
+    () => h.svc.createBooking({ roomId: "r1", customerId: "x", startMinute: 600, endMinute: 660 }),
+    ConflictError,
+    "slot must remain blocked",
+  );
+
+  const result = h.svc.cancelBooking(booking.bookingId, 0);
+  assert.equal(result.booking.status, "cancelled");
+  assert.deepEqual(h.events.map((e) => [e.event, e.amountCents]), [["booking_cancelled", 9742]]);
+});
