+// --- module structure ---
+
+test("src modules import each other acyclically", () => {
+  const srcDir = join(dirname(fileURLToPath(import.meta.url)), "..", "src");
+  const graph = new Map<string, string[]>();
+  for (const file of readdirSync(srcDir).filter((name) => name.endsWith(".ts"))) {
+    const source = readFileSync(join(srcDir, file), "utf8");
+    const deps = [...source.matchAll(/from\s+"\.\/([^"]+\.ts)"/g)].map((m) => m[1]);
+    graph.set(file, deps);
+  }
+  assert.ok(graph.get("corporate.ts")?.includes("bookings.ts"));
+  assert.ok(!graph.get("bookings.ts")?.includes("corporate.ts"));
+
+  const done = new Set<string>();
+  const visit = (node: string, stack: string[]): void => {
+    assert.ok(!stack.includes(node), `import cycle: ${[...stack, node].join(" -> ")}`);
+    if (done.has(node)) return;
+    for (const dep of graph.get(node) ?? []) visit(dep, [...stack, node]);
+    done.add(node);
+  };
+  for (const node of graph.keys()) visit(node, []);
+});
