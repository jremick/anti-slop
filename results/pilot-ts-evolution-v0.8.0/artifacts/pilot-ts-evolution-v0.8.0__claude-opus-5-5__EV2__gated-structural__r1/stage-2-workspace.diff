+// --- applyDiscountAndTax ---
+
+test("applyDiscountAndTax discounts gross, then taxes the net subtotal, half-up", () => {
+  assert.deepEqual(applyDiscountAndTax(1000, 15, 0), {
+    subtotalCents: 998, // discount 1.5 -> 2
+    discountCents: 2,
+    taxCents: 0,
+    totalCents: 998,
+  });
+  assert.deepEqual(applyDiscountAndTax(999, 5000, 1000), {
+    subtotalCents: 499, // discount 499.5 -> 500
+    discountCents: 500,
+    taxCents: 50, // 49.9 -> 50
+    totalCents: 549,
+  });
+  assert.deepEqual(applyDiscountAndTax(100, 10000, 825), {
+    subtotalCents: 0,
+    discountCents: 100,
+    taxCents: 0,
+    totalCents: 0,
+  });
+  assert.deepEqual(applyDiscountAndTax(20000, 0, 825), {
+    subtotalCents: 20000,
+    discountCents: 0,
+    taxCents: 1650,
+    totalCents: 21650,
+  });
+  assert.deepEqual(applyDiscountAndTax(0, 5000, 5000), {
+    subtotalCents: 0,
+    discountCents: 0,
+    taxCents: 0,
+    totalCents: 0,
+  });
