+
+test("applyDiscountAndTax validates its integer bounds", () => {
+  const bad: Array<[number, number, number]> = [
+    [-1, 0, 0],
+    [1.5, 0, 0],
+    [100, -1, 0],
+    [100, 10001, 0],
+    [100, 12.5, 0],
+    [100, 0, -1],
+    [100, 0, 10001],
+    [100, 0, Number.NaN],
