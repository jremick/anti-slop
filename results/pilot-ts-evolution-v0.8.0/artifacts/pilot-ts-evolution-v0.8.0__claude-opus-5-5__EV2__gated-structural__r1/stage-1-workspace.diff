+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  calculateBookingPrice,
+  computeTaxCents,
+  isBookingActiveAt,
+  roundHalfUpDiv,
+  slotsOverlap,
+} from "../src/index.ts";
+import type { Booking, Room } from "../src/index.ts";
+
+const ROOM: Room = { roomId: "r1", name: "Room 1", hourlyRateCents: 10000, taxBps: 825 };
+
+function makeService(env: Record<string, string | undefined> = {}): BookingService {
+  const svc = new BookingService({ env });
+  svc.registerRoom(ROOM);
+  svc.registerRoom({ roomId: "r2", name: "Room 2", hourlyRateCents: 10000, taxBps: 0 });
+  return svc;
+}
+
+function booking(overrides: Partial<Booking>): Booking {
+  return {
+    bookingId: "b",
+    roomId: "r1",
+    customerId: "c",
+    startMinute: 0,
+    endMinute: 60,
+    status: "confirmed",
+    subtotalCents: 0,
+    discountCents: 0,
+    taxCents: 0,
+    totalCents: 0,
+    ...overrides,
+  };
+}
+
+// --- roundHalfUpDiv ---
+
+test("roundHalfUpDiv rounds exact halves up and other fractions to nearest", () => {
+  assert.equal(roundHalfUpDiv(0, 7), 0);
+  assert.equal(roundHalfUpDiv(120, 60), 2);
+  assert.equal(roundHalfUpDiv(1, 2), 1); // 0.5 -> 1
+  assert.equal(roundHalfUpDiv(3, 2), 2); // 1.5 -> 2
+  assert.equal(roundHalfUpDiv(5, 2), 3); // 2.5 -> 3 (not banker's)
+  assert.equal(roundHalfUpDiv(29, 60), 0); // 0.4833
+  assert.equal(roundHalfUpDiv(30, 60), 1); // 0.5
+  assert.equal(roundHalfUpDiv(89, 60), 1); // 1.4833
+  assert.equal(roundHalfUpDiv(90, 60), 2); // 1.5
+  assert.equal(roundHalfUpDiv(4999, 10000), 0);
+  assert.equal(roundHalfUpDiv(5000, 10000), 1);
+});
+
+test("roundHalfUpDiv rejects invalid operands with ValidationError", () => {
+  for (const [n, d] of [
+    [1.5, 2],
+    [1, 2.5],
+    [-1, 2],
+    [1, 0],
+    [1, -3],
+    [Number.NaN, 2],
+    [1, Number.POSITIVE_INFINITY],
+    [Number.MAX_SAFE_INTEGER, 2],
+  ]) {
+    assert.throws(() => roundHalfUpDiv(n, d), ValidationError, `(${n}, ${d})`);
+  }
+});
+
+test("computeTaxCents keeps half-up behaviour", () => {
+  assert.equal(computeTaxCents(20000, 825), 1650);
+  assert.equal(computeTaxCents(1, 5000), 1); // 0.5 -> 1
+  assert.equal(computeTaxCents(1, 4999), 0);
+});
+
+// --- pricing ---
+
+test("calculateBookingPrice supports partial-hour durations with exact half-up cents", () => {
+  // 10000 * 90 / 60 = 15000 exactly
+  const p90 = calculateBookingPrice(ROOM, 90);
+  assert.equal(p90.subtotalCents, 15000);
+  assert.equal(p90.taxCents, 1238); // 15000 * 0.0825 = 1237.5 -> 1238
+  assert.equal(p90.totalCents, 16238);
+  assert.equal(p90.discountCents, 0);
+  assert.equal(p90.depositCents, 0);
+
+  const odd: Room = { roomId: "x", name: "X", hourlyRateCents: 1001, taxBps: 0 };
+  assert.equal(calculateBookingPrice(odd, 1).subtotalCents, 17); // 16.683 -> 17
+  assert.equal(calculateBookingPrice(odd, 30).subtotalCents, 501); // 500.5 -> 501
+  assert.equal(calculateBookingPrice(odd, 7).subtotalCents, 117); // 116.783 -> 117
+
+  const r1: Room = { roomId: "y", name: "Y", hourlyRateCents: 1, taxBps: 0 };
+  assert.equal(calculateBookingPrice(r1, 29).subtotalCents, 0); // 0.483 -> 0
+  assert.equal(calculateBookingPrice(r1, 30).subtotalCents, 1); // 0.5 -> 1
+});
+
+test("calculateBookingPrice deposit uses the rounded subtotal", () => {
+  const room: Room = { roomId: "z", name: "Z", hourlyRateCents: 4000, taxBps: 0 };
+  const price = calculateBookingPrice(room, 45, { legacyDepositMode: true });
+  assert.equal(price.subtotalCents, 3000);
+  assert.equal(price.depositCents, 750);
+});
+
+test("calculateBookingPrice rejects non-positive or non-integer durations", () => {
+  for (const d of [0, -30, 1.5, Number.NaN]) {
+    assert.throws(() => calculateBookingPrice(ROOM, d), ValidationError, String(d));
+  }
+});
+
+test("createBooking prices partial-hour bookings", () => {
+  const svc = makeService();
+  const b = svc.createBooking({ roomId: "r1", customerId: "c", startMinute: 0, endMinute: 45 });
+  assert.equal(b.subtotalCents, 7500);
+  assert.equal(b.taxCents, 619); // 618.75 -> 619
+  assert.equal(b.totalCents, 8119);
+});
+
+// --- helpers ---
+
+test("slotsOverlap uses half-open intervals", () => {
+  assert.equal(slotsOverlap(0, 60, 60, 120), false); // back-to-back
+  assert.equal(slotsOverlap(60, 120, 0, 60), false);
+  assert.equal(slotsOverlap(0, 60, 59, 120), true);
+  assert.equal(slotsOverlap(0, 120, 30, 60), true); // containment
+  assert.equal(slotsOverlap(30, 60, 0, 120), true);
+  assert.equal(slotsOverlap(0, 60, 0, 60), true); // identical
+  assert.equal(slotsOverlap(0, 30, 90, 120), false); // disjoint
+});
+
+test("isBookingActiveAt covers confirmed, held, expired and cancelled", () => {
+  assert.equal(isBookingActiveAt(booking({ status: "confirmed" }), 1000), true);
+  const held = booking({ status: "held", expiresAt: 30 });
+  assert.equal(isBookingActiveAt(held, 0), true);
+  assert.equal(isBookingActiveAt(held, 29), true);
+  assert.equal(isBookingActiveAt(held, 30), false); // expiry is exclusive
+  assert.equal(isBookingActiveAt(booking({ status: "held" }), 0), false); // no expiresAt
+  assert.equal(isBookingActiveAt(booking({ status: "cancelled" }), 0), false);
+});
+
+// --- conflicts ---
+
+test("createBooking rejects overlapping bookings on the same room", () => {
+  const svc = makeService();
+  const first = svc.createBooking({ roomId: "r1", customerId: "a", startMinute: 60, endMinute: 120 });
+  for (const [s, e] of [
+    [60, 120],
+    [30, 61],
+    [119, 180],
+    [0, 240],
+    [90, 100],
+  ]) {
+    assert.throws(
+      () => svc.createBooking({ roomId: "r1", customerId: "b", startMinute: s, endMinute: e }),
+      (err: unknown) => err instanceof ConflictError && err.message.includes(first.bookingId),
+      `[${s}, ${e})`,
+    );
+  }
+  assert.equal(svc.listRoomBookings("r1").length, 1); // failed attempts not stored
+});
+
+test("createBooking allows back-to-back slots and other rooms", () => {
+  const svc = makeService();
+  svc.createBooking({ roomId: "r1", customerId: "a", startMinute: 60, endMinute: 120 });
+  svc.createBooking({ roomId: "r1", customerId: "b", startMinute: 0, endMinute: 60 });
+  svc.createBooking({ roomId: "r1", customerId: "c", startMinute: 120, endMinute: 180 });
+  svc.createBooking({ roomId: "r2", customerId: "d", startMinute: 60, endMinute: 120 });
+  assert.equal(svc.listRoomBookings("r1").length, 3);
+  assert.equal(svc.listRoomBookings("r2").length, 1);
+});
+
+// --- holds ---
+
+test("createBooking with holdMinutes creates a held booking with expiresAt", () => {
+  const svc = makeService();
+  const b = svc.createBooking({
+    roomId: "r1",
+    customerId: "a",
+    startMinute: 600,
+    endMinute: 660,
+    nowMinute: 100,
+    holdMinutes: 15,
+  });
+  assert.equal(b.status, "held");
+  assert.equal(b.expiresAt, 115);
+  assert.equal(b.subtotalCents, 10000);
+
+  const plain = svc.createBooking({ roomId: "r1", customerId: "a", startMinute: 0, endMinute: 60 });
+  assert.equal(plain.status, "confirmed");
+  assert.equal("expiresAt" in plain, false);
+});
+
+test("holdMinutes defaults nowMinute to 0", () => {
+  const svc = makeService();
+  const b = svc.createBooking({
+    roomId: "r1",
+    customerId: "a",
+    startMinute: 0,
+    endMinute: 60,
+    holdMinutes: 10,
+  });
+  assert.equal(b.expiresAt, 10);
+});
+
+test("holdMinutes is validated against config.maxHoldMinutes", () => {
+  const svc = makeService({ BOOKING_MAX_HOLD_MINUTES: "20" });
+  const ok = svc.createBooking({ roomId: "r1", customerId: "a", startMinute: 0, endMinute: 60, holdMinutes: 20 });
+  assert.equal(ok.expiresAt, 20);
+  for (const holdMinutes of [21, 0, -5, 1.5]) {
+    assert.throws(
+      () => svc.createBooking({ roomId: "r1", customerId: "a", startMinute: 200, endMinute: 260, holdMinutes }),
+      ValidationError,
+      String(holdMinutes),
+    );
+  }
+  const defaults = makeService();
+  assert.throws(
+    () => defaults.createBooking({ roomId: "r1", customerId: "a", startMinute: 0, endMinute: 60, holdMinutes: 61 }),
+    ValidationError,
+  );
+});
+
+test("createBooking rejects invalid nowMinute", () => {
+  const svc = makeService();
+  for (const nowMinute of [-1, 2.5]) {
+    assert.throws(
+      () => svc.createBooking({ roomId: "r1", customerId: "a", startMinute: 0, endMinute: 60, nowMinute }),
+      ValidationError,
+    );
+  }
+});
+
+test("an active hold blocks overlapping bookings until it expires", () => {
+  const svc = makeService();
+  svc.createBooking({ roomId: "r1", customerId: "a", startMinute: 600, endMinute: 660, nowMinute: 0, holdMinutes: 30 });
+  assert.throws(
+    () => svc.createBooking({ roomId: "r1", customerId: "b", startMinute: 630, endMinute: 690, nowMinute: 29 }),
+    ConflictError,
+  );
+  const after = svc.createBooking({ roomId: "r1", customerId: "b", startMinute: 630, endMinute: 690, nowMinute: 30 });
+  assert.equal(after.status, "confirmed");
+});
+
+// --- confirmHold ---
+
+test("confirmHold confirms a live hold and clears expiresAt", () => {
+  const svc = makeService();
+  const held = svc.createBooking({ roomId: "r1", customerId: "a", startMinute: 600, endMinute: 660, nowMinute: 0, holdMinutes: 30 });
+  const confirmed = svc.confirmHold(held.bookingId, 29);
+  assert.equal(confirmed.status, "confirmed");
+  assert.equal(confirmed.expiresAt, undefined);
+  assert.equal("expiresAt" in confirmed, false);
+  assert.equal(confirmed.totalCents, held.totalCents);
+  assert.deepEqual(svc.getBooking(held.bookingId), confirmed);
+  // Once confirmed it blocks the slot permanently.
+  assert.throws(
+    () => svc.createBooking({ roomId: "r1", customerId: "b", startMinute: 600, endMinute: 660, nowMinute: 5000 }),
+    ConflictError,
+  );
+});
+
+test("confirmHold rejects unknown, non-held, expired holds and bad nowMinute", () => {
+  const svc = makeService();
+  assert.throws(() => svc.confirmHold("nope", 0), ValidationError);
+
+  const confirmed = svc.createBooking({ roomId: "r1", customerId: "a", startMinute: 0, endMinute: 60 });
+  assert.throws(() => svc.confirmHold(confirmed.bookingId, 0), ValidationError);
+
+  const held = svc.createBooking({ roomId: "r1", customerId: "a", startMinute: 600, endMinute: 660, nowMinute: 0, holdMinutes: 30 });
+  assert.throws(() => svc.confirmHold(held.bookingId, 30), ValidationError); // expiry is exclusive
+  assert.throws(() => svc.confirmHold(held.bookingId, -1), ValidationError);
+  assert.equal(svc.getBooking(held.bookingId).status, "held"); // unchanged after failures
+
+  svc.confirmHold(held.bookingId, 10);
+  assert.throws(() => svc.confirmHold(held.bookingId, 10), ValidationError); // already confirmed
+});
