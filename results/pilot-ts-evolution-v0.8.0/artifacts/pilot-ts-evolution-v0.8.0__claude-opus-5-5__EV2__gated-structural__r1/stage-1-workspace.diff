+/**
+ * Exact integer division of `numerator / denominator`, rounding halves up.
+ * Both operands must be safe integers so the arithmetic stays exact.
+ */
+export function roundHalfUpDiv(numerator: number, denominator: number): number {
+  if (!Number.isSafeInteger(numerator) || numerator < 0) {
+    throw new ValidationError("numerator must be a non-negative safe integer");
+  }
+  if (!Number.isSafeInteger(denominator) || denominator <= 0) {
+    throw new ValidationError("denominator must be a positive safe integer");
+  }
+  const scaled = numerator * 2 + denominator;
+  if (!Number.isSafeInteger(scaled)) {
+    throw new ValidationError("numerator is too large for exact rounding");
+  }
+  return Math.floor(scaled / (2 * denominator));
+}
