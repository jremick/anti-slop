+// Dependency direction: corporate.ts -> bookings.ts -> pricing.ts -> models.ts.
+// bookings.ts must never import from this module.
+import { isBookingActiveAt, slotsOverlap, validateBookingRequest } from "./bookings.ts";
+import type { BookingService, GroupBookingDraft } from "./bookings.ts";
+import { ConflictError, ValidationError } from "./models.ts";
+import type { Booking } from "./models.ts";
+import { calculateBookingPrice, validateBps, validateNonNegativeInt } from "./pricing.ts";
+
+export interface GroupBookingInput {
+  readonly customerId: string;
+  readonly roomIds: readonly string[];
+  readonly startMinute: number;
+  readonly endMinute: number;
+  readonly discountBps: number;
+  readonly nowMinute?: number;
+}
+
+export interface GroupBookingResult {
+  readonly groupId: string;
+  readonly bookings: readonly Booking[];
+  readonly subtotalCents: number;
+  readonly discountCents: number;
+  readonly taxCents: number;
+  readonly totalCents: number;
+}
+
+/**
+ * Books the same slot in several rooms for one customer. All validation and conflict
+ * checks run across every requested room before any booking is committed.
+ * Each room is priced individually (discount and tax rounded per room); group totals
+ * are the exact sums of the per-room bookings.
+ */
+export function createGroupBooking(
+  service: BookingService,
+  input: GroupBookingInput,
+): GroupBookingResult {
+  const customerId = validateBookingRequest(input.customerId, input.startMinute, input.endMinute);
+  const nowMinute = validateNonNegativeInt(input.nowMinute ?? 0, "nowMinute");
+  validateBps(input.discountBps, "discountBps");
+  if (!Array.isArray(input.roomIds) || input.roomIds.length < 2) {
+    throw new ValidationError("A group booking requires at least 2 roomIds");
+  }
+  if (new Set(input.roomIds).size !== input.roomIds.length) {
+    throw new ValidationError("roomIds must not contain duplicates");
+  }
+  const rooms = input.roomIds.map((roomId) => service.getRoom(roomId));
+
+  const conflicts: string[] = [];
+  for (const room of rooms) {
+    for (const existing of service.listRoomBookings(room.roomId)) {
+      if (
+        isBookingActiveAt(existing, nowMinute) &&
+        slotsOverlap(input.startMinute, input.endMinute, existing.startMinute, existing.endMinute)
+      ) {
+        conflicts.push(`${room.roomId} (booking ${existing.bookingId})`);
+      }
+    }
+  }
+  if (conflicts.length > 0) {
+    throw new ConflictError(
+      `Group slot [${input.startMinute}, ${input.endMinute}) conflicts in: ${conflicts.join(", ")}`,
+    );
+  }
+
+  const duration = input.endMinute - input.startMinute;
+  const drafts: GroupBookingDraft[] = rooms.map((room) => ({
+    roomId: room.roomId,
+    customerId,
+    startMinute: input.startMinute,
+    endMinute: input.endMinute,
+    price: calculateBookingPrice(room, duration, { discountBps: input.discountBps }),
+  }));
+  const { groupId, bookings } = service.commitGroupBookings(drafts, nowMinute);
+
+  let subtotalCents = 0;
+  let discountCents = 0;
+  let taxCents = 0;
+  let totalCents = 0;
+  for (const booking of bookings) {
+    subtotalCents += booking.subtotalCents;
+    discountCents += booking.discountCents;
+    taxCents += booking.taxCents;
+    totalCents += booking.totalCents;
+  }
+  return { groupId, bookings, subtotalCents, discountCents, taxCents, totalCents };
+}

