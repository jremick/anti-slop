+  discountBps: 1250,
+};
+
+// ---------- applyDiscountAndTax ----------
+
+test("applyDiscountAndTax applies half-up discount then tax on discounted subtotal", () => {
+  assert.deepEqual(applyDiscountAndTax(1000, 2500, 1000), {
+    subtotalCents: 750, discountCents: 250, taxCents: 75, totalCents: 825,
+  });
+  assert.equal(applyDiscountAndTax(10, 500, 0).discountCents, 1); // 0.5 -> 1
+  assert.equal(applyDiscountAndTax(9, 500, 0).discountCents, 0); // 0.45 -> 0
+  assert.deepEqual(applyDiscountAndTax(1001, 10000, 825), {
+    subtotalCents: 0, discountCents: 1001, taxCents: 0, totalCents: 0,
+  });
+  assert.deepEqual(applyDiscountAndTax(12345, 0, 0), {
+    subtotalCents: 12345, discountCents: 0, taxCents: 0, totalCents: 12345,
+  });
+  // Tax is computed on the discounted subtotal: 13125 * 8.25% = 1082.81 -> 1083
+  assert.deepEqual(applyDiscountAndTax(15000, 1250, 825), {
+    subtotalCents: 13125, discountCents: 1875, taxCents: 1083, totalCents: 14208,
+  });
+});
+
+test("applyDiscountAndTax validates integer bounds", () => {
+  assert.throws(() => applyDiscountAndTax(-1, 0, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1.5, 0, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, -1, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, 10001, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, 12.5, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, 0, -1), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, 0, 10001), ValidationError);
+});
