+  svc.registerRoom({ roomId: "B", name: "Bravo", hourlyRateCents: 7500, taxBps: 0 });
+  svc.registerRoom({ roomId: "C", name: "Charlie", hourlyRateCents: 3333, taxBps: 1000 });
+  return svc;
+}
