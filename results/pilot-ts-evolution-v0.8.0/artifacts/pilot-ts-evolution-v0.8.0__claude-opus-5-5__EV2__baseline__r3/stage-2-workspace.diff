+test("roundHalfUpDiv rounds exact halves up and other fractions to nearest", () => {
+  assert.equal(roundHalfUpDiv(0, 7), 0);
+  assert.equal(roundHalfUpDiv(7, 7), 1);
+  assert.equal(roundHalfUpDiv(1, 2), 1); // 0.5 -> 1
+  assert.equal(roundHalfUpDiv(3, 2), 2); // 1.5 -> 2
+  assert.equal(roundHalfUpDiv(5, 2), 3); // 2.5 -> 3 (not banker's 2)
+  assert.equal(roundHalfUpDiv(1, 3), 0); // 0.333 -> 0
+  assert.equal(roundHalfUpDiv(2, 3), 1); // 0.667 -> 1
+  assert.equal(roundHalfUpDiv(29, 60), 0); // just below half
+  assert.equal(roundHalfUpDiv(30, 60), 1); // exactly half
+  assert.equal(roundHalfUpDiv(31, 60), 1);
+  assert.equal(roundHalfUpDiv(89, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2);
+});
