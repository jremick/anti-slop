+/**
+ * Exact integer division of `numerator / denominator`, rounding halves up.
+ * Uses only integer arithmetic so results never depend on floating-point error.
+ */
+export function roundHalfUpDiv(numerator: number, denominator: number): number {
+  validateNonNegativeInt(numerator, "numerator");
+  validatePositiveInt(denominator, "denominator");
+  const scaledNumerator = numerator * 2 + denominator;
+  const scaledDenominator = 2 * denominator;
+  if (!Number.isSafeInteger(scaledNumerator) || !Number.isSafeInteger(scaledDenominator)) {
+    throw new ValidationError("roundHalfUpDiv operands exceed safe integer range");
+  }
+  return Math.floor(scaledNumerator / scaledDenominator);
 }
 
