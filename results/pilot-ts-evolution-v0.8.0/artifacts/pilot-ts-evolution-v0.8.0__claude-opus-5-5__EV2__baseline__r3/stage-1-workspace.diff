+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  calculateBookingPrice,
+  isBookingActiveAt,
+  roundHalfUpDiv,
+  slotsOverlap,
+} from "../src/index.ts";
+import type { Booking, Room } from "../src/index.ts";
+
+const ROOM: Room = { roomId: "r1", name: "Room 1", hourlyRateCents: 6000, taxBps: 1000 };
+
+function makeService(env: Record<string, string | undefined> = {}): BookingService {
+  const svc = new BookingService({ env });
+  svc.registerRoom(ROOM);
+  svc.registerRoom({ roomId: "r2", name: "Room 2", hourlyRateCents: 6000, taxBps: 0 });
+  return svc;
+}
+
+// ---------- roundHalfUpDiv ----------
+
+test("roundHalfUpDiv rounds exact halves up and other fractions to nearest", () => {
+  assert.equal(roundHalfUpDiv(0, 7), 0);
+  assert.equal(roundHalfUpDiv(7, 7), 1);
+  assert.equal(roundHalfUpDiv(1, 2), 1); // 0.5 -> 1
+  assert.equal(roundHalfUpDiv(3, 2), 2); // 1.5 -> 2
+  assert.equal(roundHalfUpDiv(5, 2), 3); // 2.5 -> 3 (not banker's 2)
+  assert.equal(roundHalfUpDiv(1, 3), 0); // 0.333 -> 0
+  assert.equal(roundHalfUpDiv(2, 3), 1); // 0.667 -> 1
+  assert.equal(roundHalfUpDiv(29, 60), 0); // just below half
+  assert.equal(roundHalfUpDiv(30, 60), 1); // exactly half
+  assert.equal(roundHalfUpDiv(31, 60), 1);
+  assert.equal(roundHalfUpDiv(89, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2);
+});
+
+test("roundHalfUpDiv rejects non-integers, negatives, and non-positive denominators", () => {
+  assert.throws(() => roundHalfUpDiv(1.5, 2), ValidationError);
+  assert.throws(() => roundHalfUpDiv(1, 2.5), ValidationError);
+  assert.throws(() => roundHalfUpDiv(-1, 2), ValidationError);
+  assert.throws(() => roundHalfUpDiv(1, 0), ValidationError);
+  assert.throws(() => roundHalfUpDiv(1, -3), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.NaN, 2), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.MAX_SAFE_INTEGER, 2), ValidationError);
+});
+
+// ---------- calculateBookingPrice ----------
+
+test("calculateBookingPrice supports arbitrary minute durations with half-up cents", () => {
+  const room: Room = { roomId: "x", name: "X", hourlyRateCents: 1001, taxBps: 825 };
+  // 1001 * 30 / 60 = 500.5 -> 501; tax 501 * 8.25% = 41.33 -> 41
+  assert.deepEqual(calculateBookingPrice(room, 30), {
+    subtotalCents: 501,
+    discountCents: 0,
+    taxCents: 41,
+    totalCents: 542,
+    depositCents: 0,
+  });
+  // 1000 * 1 / 60 = 16.67 -> 17
+  assert.equal(calculateBookingPrice({ ...room, hourlyRateCents: 1000 }, 1).subtotalCents, 17);
+  // 90 * 1 / 60 = 1.5 -> 2 ; 30 * 1 / 60 = 0.5 -> 1 ; 29 * 1 / 60 -> 0
+  assert.equal(calculateBookingPrice({ ...room, hourlyRateCents: 90 }, 1).subtotalCents, 2);
+  assert.equal(calculateBookingPrice({ ...room, hourlyRateCents: 30 }, 1).subtotalCents, 1);
+  assert.equal(calculateBookingPrice({ ...room, hourlyRateCents: 29 }, 1).subtotalCents, 0);
+  // Whole hours still exact
+  assert.equal(calculateBookingPrice({ ...room, hourlyRateCents: 10000 }, 90).subtotalCents, 15000);
+  assert.equal(calculateBookingPrice({ ...room, hourlyRateCents: 10000 }, 120).subtotalCents, 20000);
+});
+
+test("calculateBookingPrice legacy deposit uses rounded fractional subtotal", () => {
+  const room: Room = { roomId: "x", name: "X", hourlyRateCents: 1001, taxBps: 0 };
+  const price = calculateBookingPrice(room, 30, { legacyDepositMode: true });
+  assert.equal(price.subtotalCents, 501);
+  assert.equal(price.depositCents, 125); // 501 * 25% = 125.25 -> 125
+});
+
+test("calculateBookingPrice rejects non-positive or fractional durations", () => {
+  assert.throws(() => calculateBookingPrice(ROOM, 0), ValidationError);
+  assert.throws(() => calculateBookingPrice(ROOM, -60), ValidationError);
+  assert.throws(() => calculateBookingPrice(ROOM, 1.5), ValidationError);
+});
+
+test("createBooking prices a 45-minute booking", () => {
+  const svc = makeService();
+  const b = svc.createBooking({ roomId: "r1", customerId: "c", startMinute: 0, endMinute: 45 });
+  assert.equal(b.subtotalCents, 4500);
+  assert.equal(b.taxCents, 450);
+  assert.equal(b.totalCents, 4950);
+});
+
+// ---------- slotsOverlap ----------
+
+test("slotsOverlap treats intervals as half-open", () => {
+  assert.equal(slotsOverlap(0, 60, 60, 120), false); // back-to-back
+  assert.equal(slotsOverlap(60, 120, 0, 60), false);
+  assert.equal(slotsOverlap(0, 60, 59, 120), true); // one-minute overlap
+  assert.equal(slotsOverlap(0, 60, 0, 60), true); // identical
+  assert.equal(slotsOverlap(0, 120, 30, 60), true); // containment
+  assert.equal(slotsOverlap(30, 60, 0, 120), true);
+  assert.equal(slotsOverlap(0, 30, 90, 120), false); // disjoint
+});
+
+// ---------- isBookingActiveAt ----------
+
+function fakeBooking(overrides: Partial<Booking>): Booking {
+  return {
+    bookingId: "b",
+    roomId: "r1",
+    customerId: "c",
+    startMinute: 0,
+    endMinute: 60,
+    status: "confirmed",
+    subtotalCents: 0,
+    discountCents: 0,
+    taxCents: 0,
+    totalCents: 0,
+    ...overrides,
+  };
+}
+
+test("isBookingActiveAt: confirmed always active, holds only before expiresAt", () => {
+  assert.equal(isBookingActiveAt(fakeBooking({ status: "confirmed" }), 10_000), true);
+  const hold = fakeBooking({ status: "held", expiresAt: 30 });
+  assert.equal(isBookingActiveAt(hold, 0), true);
+  assert.equal(isBookingActiveAt(hold, 29), true);
+  assert.equal(isBookingActiveAt(hold, 30), false); // expires exactly at expiresAt
+  assert.equal(isBookingActiveAt(hold, 31), false);
+  assert.equal(isBookingActiveAt(fakeBooking({ status: "held" }), 0), false); // no expiresAt
+  assert.equal(isBookingActiveAt(fakeBooking({ status: "cancelled" }), 0), false);
+});
+
+// ---------- createBooking: holds & conflicts ----------
+
+test("createBooking with holdMinutes creates a held booking with expiresAt", () => {
+  const svc = makeService();
+  const b = svc.createBooking({
+    roomId: "r1", customerId: "c", startMinute: 100, endMinute: 160, nowMinute: 10, holdMinutes: 15,
+  });
+  assert.equal(b.status, "held");
+  assert.equal(b.expiresAt, 25);
+  assert.deepEqual(svc.getBooking(b.bookingId), b);
+});
+
+test("createBooking without holdMinutes is confirmed with no expiresAt", () => {
+  const svc = makeService();
+  const b = svc.createBooking({ roomId: "r1", customerId: "c", startMinute: 0, endMinute: 60 });
+  assert.equal(b.status, "confirmed");
+  assert.equal(b.expiresAt, undefined);
+  assert.equal("expiresAt" in b, false);
+});
+
+test("createBooking validates holdMinutes against config.maxHoldMinutes", () => {
+  const svc = makeService({ BOOKING_MAX_HOLD_MINUTES: "20" });
+  const base = { roomId: "r1", customerId: "c", startMinute: 0, endMinute: 60 };
+  assert.throws(() => svc.createBooking({ ...base, holdMinutes: 0 }), ValidationError);
+  assert.throws(() => svc.createBooking({ ...base, holdMinutes: -5 }), ValidationError);
+  assert.throws(() => svc.createBooking({ ...base, holdMinutes: 2.5 }), ValidationError);
+  assert.throws(() => svc.createBooking({ ...base, holdMinutes: 21 }), ValidationError);
+  assert.equal(svc.listRoomBookings("r1").length, 0, "rejected holds must not be stored");
+  const b = svc.createBooking({ ...base, holdMinutes: 20 });
+  assert.equal(b.expiresAt, 20);
+});
+
+test("createBooking defaults maxHoldMinutes to 60", () => {
+  const svc = makeService();
+  const base = { roomId: "r1", customerId: "c", startMinute: 0, endMinute: 60 };
+  assert.throws(() => svc.createBooking({ ...base, holdMinutes: 61 }), ValidationError);
+  assert.equal(svc.createBooking({ ...base, holdMinutes: 60 }).expiresAt, 60);
+});
+
+test("createBooking rejects invalid nowMinute", () => {
+  const svc = makeService();
+  const base = { roomId: "r1", customerId: "c", startMinute: 0, endMinute: 60 };
+  assert.throws(() => svc.createBooking({ ...base, nowMinute: -1 }), ValidationError);
+  assert.throws(() => svc.createBooking({ ...base, nowMinute: 1.5 }), ValidationError);
+});
+
+test("createBooking throws ConflictError on overlap with a confirmed booking", () => {
+  const svc = makeService();
+  svc.createBooking({ roomId: "r1", customerId: "a", startMinute: 60, endMinute: 120 });
