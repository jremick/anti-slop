+  }
+  assert.equal(svc.listRoomBookings("r1").length, 1, "conflicting bookings must not be stored");
+});
+
+test("back-to-back bookings on the same room do not conflict", () => {
+  const svc = makeService();
+  svc.createBooking({ roomId: "r1", customerId: "a", startMinute: 60, endMinute: 120 });
+  svc.createBooking({ roomId: "r1", customerId: "b", startMinute: 0, endMinute: 60 });
+  svc.createBooking({ roomId: "r1", customerId: "c", startMinute: 120, endMinute: 180 });
+  assert.equal(svc.listRoomBookings("r1").length, 3);
+});
+
+test("overlapping bookings in different rooms do not conflict", () => {
+  const svc = makeService();
+  svc.createBooking({ roomId: "r1", customerId: "a", startMinute: 0, endMinute: 60 });
