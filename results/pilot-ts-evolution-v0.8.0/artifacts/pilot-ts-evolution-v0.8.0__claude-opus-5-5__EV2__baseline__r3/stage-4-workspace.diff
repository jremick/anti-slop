+  const graph = new Map<string, string[]>();
+  for (const file of readdirSync(srcDir).filter((f) => f.endsWith(".ts"))) {
+    const text = readFileSync(join(srcDir, file), "utf8");
+    const deps = [...text.matchAll(/from\s+["']\.\/([^"']+)["']/g)].map((m) => m[1]);
+    graph.set(file, deps);
+  }
+  assert.ok(!graph.get("bookings.ts")?.includes("corporate.ts"));
+  const state = new Map<string, "visiting" | "done">();
+  const visit = (node: string, path: string[]): void => {
+    if (state.get(node) === "done") return;
+    assert.notEqual(state.get(node), "visiting", `cycle: ${[...path, node].join(" -> ")}`);
+    state.set(node, "visiting");
+    for (const dep of graph.get(node) ?? []) visit(dep, [...path, node]);
+    state.set(node, "done");
+  };
+  for (const node of graph.keys()) visit(node, []);
+});

