+import type { BookingNotification } from "../src/index.ts";
+
+const TIERS = JSON.stringify({ cutoffMinutes: 1440, earlyFeeBps: 1000, lateFeeBps: 5000 });
+
+class HookFailure extends Error {}
+
+/** Service whose hook records events and can be armed to throw on the Nth call. */
+function makeHarness(envOverride?: Record<string, string | undefined>) {
+  const events: BookingNotification[] = [];
+  const control = { failOnCall: 0, calls: 0 };
+  const svc = new BookingService({
+    env: envOverride ?? { [CANCEL_FEE_TIERS_ENV_VAR]: TIERS },
+    notifyHook: (event) => {
+      control.calls += 1;
+      if (control.failOnCall === control.calls) {
+        throw new HookFailure(`hook failed on call ${control.calls}`);
+      }
+      events.push(event);
+    },
+  });
+  // A: 60 min = 10000 + 825 tax = 10825 ; B: 6000 ; C: 3000 + 300 tax = 3300
+  svc.registerRoom({ roomId: "A", name: "Alpha", hourlyRateCents: 10000, taxBps: 825 });
+  svc.registerRoom({ roomId: "B", name: "Bravo", hourlyRateCents: 6000, taxBps: 0 });
+  svc.registerRoom({ roomId: "C", name: "Charlie", hourlyRateCents: 3000, taxBps: 1000 });
+  /** Arms the hook to throw on the k-th call from now (1-based). */
+  const failOnNext = (k = 1) => {
+    control.failOnCall = control.calls + k;
+  };
+  const allBookings = () => ["A", "B", "C"].flatMap((r) => svc.listRoomBookings(r));
+  return { svc, events, failOnNext, allBookings };
+}
