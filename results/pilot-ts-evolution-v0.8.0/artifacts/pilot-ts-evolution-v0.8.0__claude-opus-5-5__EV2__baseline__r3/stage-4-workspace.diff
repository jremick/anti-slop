+    assert.doesNotMatch(key, /deposit/i);
+  }
+});
+
+test("prices and bookings carry no deposit field", () => {
+  const room = { roomId: "x", name: "X", hourlyRateCents: 1001, taxBps: 825 };
+  assert.deepEqual(Object.keys(calculateBookingPrice(room, 30)).sort(), [
+    "discountCents", "subtotalCents", "taxCents", "totalCents",
+  ]);
+  const { svc } = makeHarness();
+  const single = svc.createBooking({ roomId: "A", customerId: "c", ...SLOT });
+  const group = createGroupBooking(svc, {
+    customerId: "g", roomIds: ["B", "C"], ...SLOT, discountBps: 0,
