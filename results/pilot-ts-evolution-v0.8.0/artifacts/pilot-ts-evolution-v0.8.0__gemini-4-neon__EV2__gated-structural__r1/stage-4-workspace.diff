+import type { Room } from "../src/index.ts";
+
+function setupServiceWithRooms(): { service: BookingService; rooms: readonly Room[] } {
+  const service = new BookingService({ env: {} });
+  const rooms: Room[] = [
+    {
+      roomId: "board_a",
+      name: "Boardroom A",
+      hourlyRateCents: 10001,
+      taxBps: 825,
+    },
+    {
+      roomId: "board_b",
+      name: "Boardroom B",
+      hourlyRateCents: 7500,
+      taxBps: 500,
+    },
+    {
+      roomId: "board_c",
+      name: "Boardroom C",
+      hourlyRateCents: 12000,
+      taxBps: 1000,
+    },
+  ];
+  for (const room of rooms) {
+    service.registerRoom(room);
+  }
+  return { service, rooms };
+}
+
+test("createGroupBooking prices multiple rooms with canonical pricing and shared groupId", () => {
+  const { service, rooms } = setupServiceWithRooms();
+  const [roomA, roomB, roomC] = rooms;
+
+  const result = createGroupBooking(service, {
+    customerId: "acme_corp",
+    roomIds: [roomA.roomId, roomB.roomId, roomC.roomId],
+    startMinute: 60,
+    endMinute: 105, // 45 minutes
+    discountBps: 1500, // 15%
+  });
+
+  assert.match(result.groupId, /^grp_\d+$/);
+  assert.equal(result.bookings.length, 3);
+
+  const expectedA = calculateBookingPrice(roomA, 45, { discountBps: 1500 });
+  const expectedB = calculateBookingPrice(roomB, 45, { discountBps: 1500 });
+  const expectedC = calculateBookingPrice(roomC, 45, { discountBps: 1500 });
+
+  const expectedByRoom = new Map([
+    [roomA.roomId, expectedA],
+    [roomB.roomId, expectedB],
+    [roomC.roomId, expectedC],
+  ]);
+
+  for (const booking of result.bookings) {
+    assert.equal(booking.groupId, result.groupId);
+    assert.equal(booking.status, "confirmed");
+    assert.equal(booking.expiresAt, undefined);
+    assert.equal(booking.customerId, "acme_corp");
+    const expected = expectedByRoom.get(booking.roomId);
+    assert.ok(expected !== undefined);
+    assert.equal(booking.subtotalCents, expected.subtotalCents);
+    assert.equal(booking.discountCents, expected.discountCents);
+    assert.equal(booking.taxCents, expected.taxCents);
+    assert.equal(booking.totalCents, expected.totalCents);
+    assert.deepEqual(service.getBooking(booking.bookingId), booking);
+  }
+
+  assert.equal(
+    result.subtotalCents,
+    expectedA.subtotalCents + expectedB.subtotalCents + expectedC.subtotalCents,
+  );
