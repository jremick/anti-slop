+test("notifyHook failure rolls back createBooking, createGroupBooking, and cancelBooking atomically", () => {
+  let failOnCall = 1;
+  let callCount = 0;
+  const svc = new BookingService({
+    env: VALID_CANCEL_ENV,
+    notifyHook: () => {
+      callCount += 1;
+      if (callCount === failOnCall) {
+        throw new Error("notification sink unavailable");
+      }
+    },
+  });
+  svc.registerRoom({
+    roomId: "room_a",
+    name: "Room A",
+    hourlyRateCents: 10000,
+    taxBps: 0,
+  });
+  svc.registerRoom({
+    roomId: "room_b",
+    name: "Room B",
+    hourlyRateCents: 10000,
+    taxBps: 0,
+  });
+  svc.registerRoom({
+    roomId: "room_c",
+    name: "Room C",
+    hourlyRateCents: 10000,
+    taxBps: 0,
+  });
+
+  // 1) Failure during single createBooking persists zero bookings
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "room_a",
+        customerId: "cust_1",
+        startMinute: 60,
+        endMinute: 120,
+      }),
+    /notification sink unavailable/,
+  );
+  assert.equal(svc.listRoomBookings("room_a").length, 0);
+
+  // 2) Failure on 2nd room of 3-room group booking rolls back room_a and persists zero bookings
+  callCount = 0;
+  failOnCall = 2;
+  assert.throws(
+    () =>
+      createGroupBooking(svc, {
+        customerId: "corp_1",
+        roomIds: ["room_a", "room_b", "room_c"],
+        startMinute: 60,
+        endMinute: 120,
+        discountBps: 500,
+      }),
+    /notification sink unavailable/,
+  );
+  assert.equal(svc.listRoomBookings("room_a").length, 0);
+  assert.equal(svc.listRoomBookings("room_b").length, 0);
+  assert.equal(svc.listRoomBookings("room_c").length, 0);
+
+  // 3) Create a held booking and confirmed booking successfully, then fail notifyHook on cancelBooking
+  callCount = 0;
+  failOnCall = -1;
+  const confirmed = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_2",
+    startMinute: 100,
+    endMinute: 160,
+  });
+  const held = svc.createBooking({
+    roomId: "room_b",
+    customerId: "cust_3",
+    startMinute: 100,
+    endMinute: 160,
+    nowMinute: 10,
+    holdMinutes: 30,
+  });
+
+  callCount = 0;
+  failOnCall = 1;
+  assert.throws(() => svc.cancelBooking(confirmed.bookingId, 20), /notification sink unavailable/);
+  assert.equal(svc.getBooking(confirmed.bookingId).status, "confirmed");
+
+  callCount = 0;
+  failOnCall = 1;
+  assert.throws(() => svc.cancelBooking(held.bookingId, 20), /notification sink unavailable/);
+  assert.equal(svc.getBooking(held.bookingId).status, "held");
+  assert.equal(svc.getBooking(held.bookingId).expiresAt, 40);
+
+  // Verify previously rolled-back booking IDs do not exist
+  assert.throws(() => svc.getBooking("bkg_0001"), ValidationError);
+});

