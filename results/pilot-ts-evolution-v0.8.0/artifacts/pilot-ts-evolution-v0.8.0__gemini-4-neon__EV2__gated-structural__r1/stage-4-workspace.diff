+test("applyDiscountAndTax computes exact integer half-up discount and post-discount tax", () => {
+  // Exact half-up discount: 1010 * 500 / 10000 = 50.5 -> 51, subtotal = 959
+  // Tax on 959 at 825 bps: 959 * 825 / 10000 = 79.1175 -> 79
+  assert.deepEqual(applyDiscountAndTax(1010, 500, 825), {
+    subtotalCents: 959,
+    discountCents: 51,
+    taxCents: 79,
+    totalCents: 1038,
+  });
+
+  // Exact half-up tax after discount: 500 * 500 / 10000 = 25, subtotal = 475
+  // Tax on 475 at 1000 bps: 47.5 -> 48
+  assert.deepEqual(applyDiscountAndTax(500, 500, 1000), {
+    subtotalCents: 475,
+    discountCents: 25,
+    taxCents: 48,
+    totalCents: 523,
+  });
+
+  // Boundary cases: 0%, 100%, zero gross
+  assert.deepEqual(applyDiscountAndTax(10000, 0, 825), {
+    subtotalCents: 10000,
+    discountCents: 0,
+    taxCents: 825,
+    totalCents: 10825,
+  });
+  assert.deepEqual(applyDiscountAndTax(10000, 10000, 825), {
+    subtotalCents: 0,
+    discountCents: 10000,
+    taxCents: 0,
+    totalCents: 0,
+  });
+  assert.deepEqual(applyDiscountAndTax(0, 2500, 1000), {
+    subtotalCents: 0,
+    discountCents: 0,
+    taxCents: 0,
+    totalCents: 0,
+  });
+
+  // Invalid bounds
+  assert.throws(() => applyDiscountAndTax(-1, 0, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, -1, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 10001, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 0, -1), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 0, 10001), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 10.5, 0), ValidationError);
+});
+
+test("calculateBookingPrice applies optional discountBps via applyDiscountAndTax", () => {
+  const room: Room = {
+    roomId: "studio_3",
+    name: "Studio 3",
+    hourlyRateCents: 10001,
+    taxBps: 825,
+  };
+  // 30 min -> gross 5001, 10% discount -> 500 (500.1), subtotal 4501, tax 371 (371.3325), total 4872
+  assert.deepEqual(calculateBookingPrice(room, 30, { discountBps: 1000 }), {
+    subtotalCents: 4501,
+    discountCents: 500,
+    taxCents: 371,
+    totalCents: 4872,
+  });
+  assert.throws(
+    () => calculateBookingPrice(room, 30, { discountBps: 10001 }),
+    ValidationError,
+  );
+});
