+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  ValidationError,
+  applyDiscountAndTax,
+  calculateBookingPrice,
+  computeTaxCents,
+  roundHalfUpDiv,
+} from "../src/index.ts";
+import type { Room } from "../src/index.ts";
+
+test("roundHalfUpDiv performs exact integer half-up division", () => {
+  assert.equal(roundHalfUpDiv(0, 60), 0);
+  assert.equal(roundHalfUpDiv(29, 60), 0);
+  assert.equal(roundHalfUpDiv(30, 60), 1);
+  assert.equal(roundHalfUpDiv(31, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2);
+  assert.equal(roundHalfUpDiv(1, 2), 1);
+  assert.equal(roundHalfUpDiv(3, 2), 2);
+  assert.equal(roundHalfUpDiv(5, 2), 3);
+  assert.equal(roundHalfUpDiv(1, 3), 0);
+  assert.equal(roundHalfUpDiv(2, 3), 1);
+  assert.equal(roundHalfUpDiv(10000 * 20, 60), 3333);
+  assert.equal(roundHalfUpDiv(10000 * 40, 60), 6667);
+});
+
+test("roundHalfUpDiv rejects invalid inputs with ValidationError", () => {
+  assert.throws(() => roundHalfUpDiv(-1, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(1.5, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.NaN, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.POSITIVE_INFINITY, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, 0), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, -5), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, 2.5), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, Number.NaN), ValidationError);
+});
+
+test("calculateBookingPrice supports fractional-hour durations with half-up rounding", () => {
+  const room: Room = {
+    roomId: "studio_1",
+    name: "Studio 1",
+    hourlyRateCents: 10001,
+    taxBps: 825,
+  };
+
+  // 30 minutes at 10001 cents/hr = 5000.5 -> half-up to 5001 cents
+  // tax: 5001 * 825 / 10000 = 412.5825 -> half-up to 413 cents
+  const halfHour = calculateBookingPrice(room, 30);
+  assert.deepEqual(halfHour, {
+    subtotalCents: 5001,
+    discountCents: 0,
+    taxCents: 413,
+    totalCents: 5414,
+  });
+
+  // 15 minutes at 10001 cents/hr = 2500.25 -> 2500 cents
+  // tax: 2500 * 825 / 10000 = 206.25 -> 206 cents
+  const quarterHour = calculateBookingPrice(room, 15);
+  assert.deepEqual(quarterHour, {
+    subtotalCents: 2500,
+    discountCents: 0,
+    taxCents: 206,
+    totalCents: 2706,
+  });
+
+  // 1 minute at 10001 cents/hr = 166.6833... -> 167 cents
+  const oneMinute = calculateBookingPrice(room, 1);
+  assert.equal(oneMinute.subtotalCents, 167);
+  assert.equal(oneMinute.taxCents, computeTaxCents(167, 825));
+  assert.equal(oneMinute.totalCents, 167 + oneMinute.taxCents);
+
+  // 75 minutes at 10000 cents/hr = 12500 cents exactly
+  const seventyFiveMin = calculateBookingPrice(
+    { ...room, hourlyRateCents: 10000, taxBps: 500 },
+    75,
+  );
+  assert.equal(seventyFiveMin.subtotalCents, 12500);
+  assert.equal(seventyFiveMin.taxCents, 625);
+  assert.equal(seventyFiveMin.totalCents, 13125);
+});
+
+test("calculateBookingPrice rejects invalid durations and rates", () => {
+  const room: Room = {
+    roomId: "studio_2",
