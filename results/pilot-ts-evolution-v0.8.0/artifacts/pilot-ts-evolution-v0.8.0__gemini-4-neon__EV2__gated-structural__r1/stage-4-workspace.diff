+import {
+  assertNoRoomSlotConflict,
+  validateBookingTimeWindow,
+} from "./bookings.ts";
+import type { BookingService } from "./bookings.ts";
+import { ValidationError } from "./models.ts";
+import type { Booking } from "./models.ts";
+import { validateBps } from "./pricing.ts";
+
+export interface CreateGroupBookingInput {
+  readonly customerId: string;
+  readonly roomIds: readonly string[];
+  readonly startMinute: number;
+  readonly endMinute: number;
+  readonly discountBps: number;
+  readonly nowMinute?: number;
+}
+
+export interface GroupBookingResult {
+  readonly groupId: string;
+  readonly bookings: readonly Booking[];
+  readonly subtotalCents: number;
+  readonly discountCents: number;
+  readonly taxCents: number;
+  readonly totalCents: number;
+}
+
+function validateGroupBookingInput(
+  service: BookingService,
+  input: CreateGroupBookingInput,
+): number {
+  if (typeof input.customerId !== "string" || input.customerId.trim() === "") {
+    throw new ValidationError("customerId must be a non-empty string");
+  }
+  if (!Array.isArray(input.roomIds) || input.roomIds.length < 2) {
+    throw new ValidationError("roomIds must contain at least 2 rooms");
+  }
+  const nowMinute = validateBookingTimeWindow(
+    input.startMinute,
+    input.endMinute,
+    input.nowMinute,
+  );
+  validateBps(input.discountBps, "discountBps");
+
+  const seenRoomIds = new Set<string>();
+  for (const roomId of input.roomIds) {
+    if (typeof roomId !== "string" || roomId.trim() === "") {
+      throw new ValidationError("Each roomId must be a non-empty string");
+    }
+    if (seenRoomIds.has(roomId)) {
+      throw new ValidationError(`Duplicate roomId in group booking: ${roomId}`);
+    }
+    seenRoomIds.add(roomId);
+    service.getRoom(roomId);
+  }
+  return nowMinute;
+}
+
+function assertGroupRoomsAvailable(
+  service: BookingService,
+  roomIds: readonly string[],
+  startMinute: number,
+  endMinute: number,
+  nowMinute: number,
+): void {
+  for (const roomId of roomIds) {
+    assertNoRoomSlotConflict(
+      roomId,
+      service.listRoomBookings(roomId),
+      startMinute,
+      endMinute,
+      nowMinute,
+    );
+  }
+}
+
+export function createGroupBooking(
+  service: BookingService,
+  input: CreateGroupBookingInput,
+): GroupBookingResult {
+  const nowMinute = validateGroupBookingInput(service, input);
+  assertGroupRoomsAvailable(
+    service,
+    input.roomIds,
+    input.startMinute,
+    input.endMinute,
+    nowMinute,
+  );
+
+  const groupId = service.allocateGroupId();
+  const bookingInputs = input.roomIds.map((roomId) => ({
+    roomId,
+    customerId: input.customerId,
+    startMinute: input.startMinute,
+    endMinute: input.endMinute,
+    nowMinute,
+    discountBps: input.discountBps,
+    groupId,
+  }));
+  const bookings = service.createBookingsAtomic(bookingInputs);
+
+  let subtotalCents = 0;
+  let discountCents = 0;
+  let taxCents = 0;
+  let totalCents = 0;
+  for (const booking of bookings) {
+    subtotalCents += booking.subtotalCents;
+    discountCents += booking.discountCents;
+    taxCents += booking.taxCents;
+    totalCents += booking.totalCents;
+  }
+
+  return {
+    groupId,
+    bookings,
+    subtotalCents,
+    discountCents,
+    taxCents,
+    totalCents,
+  };
+}

