+test("confirmHold rejects unknown, non-held, expired, and invalid nowMinute inputs", () => {
+  const svc = setupService();
+
+  // Unknown bookingId
+  assert.throws(() => svc.confirmHold("bkg_9999", 0), ValidationError);
+
+  // Directly confirmed booking
+  const confirmed = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_1",
+    startMinute: 0,
+    endMinute: 60,
+  });
+  assert.throws(() => svc.confirmHold(confirmed.bookingId, 0), ValidationError);
+
+  // Expired hold at exact boundary and after
+  const hold = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_2",
+    startMinute: 60,
+    endMinute: 120,
+    nowMinute: 10,
+    holdMinutes: 15,
+  });
+  assert.throws(() => svc.confirmHold(hold.bookingId, 25), ValidationError);
+  assert.throws(() => svc.confirmHold(hold.bookingId, 30), ValidationError);
+  assert.throws(() => svc.confirmHold(hold.bookingId, -1), ValidationError);
+  assert.throws(() => svc.confirmHold(hold.bookingId, 12.5), ValidationError);
+
+  // Hold remains held (not mutated) after rejected confirmations
+  assert.equal(svc.getBooking(hold.bookingId).status, "held");
+  assert.equal(svc.getBooking(hold.bookingId).expiresAt, 25);
+});

