+test("confirmHold transitions active hold to confirmed and clears expiresAt", () => {
+  const svc = setupService();
+  const hold = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_1",
+    startMinute: 100,
+    endMinute: 145,
+    nowMinute: 20,
+    holdMinutes: 25,
+  });
+  assert.equal(hold.status, "held");
+  assert.equal(hold.expiresAt, 45);
+
+  const confirmed = svc.confirmHold(hold.bookingId, 44);
+  assert.equal(confirmed.bookingId, hold.bookingId);
+  assert.equal(confirmed.status, "confirmed");
+  assert.equal(confirmed.expiresAt, undefined);
+  assert.equal("expiresAt" in confirmed, false);
+  assert.equal(confirmed.subtotalCents, hold.subtotalCents);
+  assert.equal(confirmed.taxCents, hold.taxCents);
+  assert.equal(confirmed.totalCents, hold.totalCents);
+
+  // Persisted state is updated
+  const fetched = svc.getBooking(hold.bookingId);
+  assert.equal(fetched.status, "confirmed");
+  assert.equal(fetched.expiresAt, undefined);
+
+  // Confirmed booking stays active past original expiresAt
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "room_a",
+        customerId: "cust_2",
+        startMinute: 100,
+        endMinute: 145,
+        nowMinute: 100,
