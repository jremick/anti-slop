+import { isBookingActiveAt, slotsOverlap } from "./bookings.ts";
+import type { BookingService } from "./bookings.ts";
+import { ConflictError, ValidationError } from "./models.ts";
+import type { Booking } from "./models.ts";
+import { validateNonNegativeInt, validatePositiveInt } from "./pricing.ts";
+
+export interface CreateGroupBookingInput {
+  readonly customerId: string;
+  readonly roomIds: readonly string[];
+  readonly startMinute: number;
+  readonly endMinute: number;
+  readonly discountBps: number;
+  readonly nowMinute?: number;
+}
+
+export interface GroupBookingResult {
+  readonly groupId: string;
+  readonly bookings: Booking[];
+  readonly subtotalCents: number;
+  readonly discountCents: number;
+  readonly taxCents: number;
+  readonly totalCents: number;
+}
+
+const groupSeqByService = new WeakMap<BookingService, number>();
+
+function nextGroupId(service: BookingService): string {
+  const next = (groupSeqByService.get(service) ?? 0) + 1;
+  groupSeqByService.set(service, next);
+  return `grp_${String(next).padStart(4, "0")}`;
+}
+
+export function createGroupBooking(
+  service: BookingService,
+  input: CreateGroupBookingInput,
+): GroupBookingResult {
+  if (typeof input.customerId !== "string" || input.customerId.trim() === "") {
+    throw new ValidationError("customerId must be a non-empty string");
+  }
+  if (!Array.isArray(input.roomIds) || input.roomIds.length < 2) {
+    throw new ValidationError("roomIds must contain at least 2 rooms");
+  }
+  const seenRoomIds = new Set<string>();
+  for (const roomId of input.roomIds) {
+    if (typeof roomId !== "string" || roomId.trim() === "") {
+      throw new ValidationError("roomIds must contain non-empty strings");
+    }
+    if (seenRoomIds.has(roomId)) {
+      throw new ValidationError(`Duplicate roomId in group booking: ${roomId}`);
+    }
+    seenRoomIds.add(roomId);
+  }
+
+  validateNonNegativeInt(input.startMinute, "startMinute");
+  validatePositiveInt(input.endMinute, "endMinute");
+  if (input.endMinute <= input.startMinute) {
+    throw new ValidationError("endMinute must be strictly greater than startMinute");
+  }
+  validateNonNegativeInt(input.discountBps, "discountBps");
+  if (input.discountBps > 10000) {
+    throw new ValidationError("discountBps cannot exceed 10000");
+  }
+  const nowMinute = input.nowMinute ?? 0;
+  validateNonNegativeInt(nowMinute, "nowMinute");
+
+  // Validate that all rooms exist before checking conflicts or committing.
+  const rooms = input.roomIds.map((roomId) => service.getRoom(roomId));
+
+  // Atomic pre-flight conflict check across all requested rooms.
+  for (const room of rooms) {
+    const existingBookings = service.listRoomBookings(room.roomId);
+    for (const existing of existingBookings) {
+      if (
+        isBookingActiveAt(existing, nowMinute) &&
+        slotsOverlap(existing.startMinute, existing.endMinute, input.startMinute, input.endMinute)
+      ) {
+        throw new ConflictError(
+          `Room ${room.roomId} already has an active booking overlapping [${input.startMinute}, ${input.endMinute})`,
+        );
+      }
+    }
+  }
+
+  const groupId = nextGroupId(service);
+  const bookings: Booking[] = [];
+  let subtotalCents = 0;
+  let discountCents = 0;
+  let taxCents = 0;
+  let totalCents = 0;
+
+  for (const room of rooms) {
+    const booking = service.createBooking({
+      roomId: room.roomId,
+      customerId: input.customerId,
+      startMinute: input.startMinute,
+      endMinute: input.endMinute,
+      nowMinute,
+      discountBps: input.discountBps,
+      groupId,
+    });
+    bookings.push(booking);
+    subtotalCents += booking.subtotalCents;
+    discountCents += booking.discountCents;
+    taxCents += booking.taxCents;
+    totalCents += booking.totalCents;
+  }
+
+  return {
+    groupId,
+    bookings,
+    subtotalCents,
+    discountCents,
+    taxCents,
+    totalCents,
+  };
+}

