+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  isBookingActiveAt,
+  slotsOverlap,
+} from "../src/index.ts";
+import type { Booking } from "../src/index.ts";
+
+function setupService(env: Record<string, string | undefined> = {}): BookingService {
+  const svc = new BookingService({ env });
+  svc.registerRoom({
+    roomId: "room_a",
+    name: "Room A",
+    hourlyRateCents: 6000,
+    taxBps: 1000,
+  });
+  svc.registerRoom({
+    roomId: "room_b",
+    name: "Room B",
+    hourlyRateCents: 6000,
+    taxBps: 1000,
+  });
+  return svc;
+}
+
+test("slotsOverlap treats intervals as half-open [start, end)", () => {
+  // Back-to-back slots do not overlap
+  assert.equal(slotsOverlap(60, 120, 120, 180), false);
+  assert.equal(slotsOverlap(120, 180, 60, 120), false);
+  // Disjoint slots do not overlap
+  assert.equal(slotsOverlap(0, 60, 120, 180), false);
+  assert.equal(slotsOverlap(120, 180, 0, 60), false);
+  // Overlapping slots in various configurations
+  assert.equal(slotsOverlap(60, 120, 119, 180), true);
+  assert.equal(slotsOverlap(119, 180, 60, 120), true);
+  assert.equal(slotsOverlap(60, 120, 60, 120), true);
+  assert.equal(slotsOverlap(60, 180, 90, 120), true);
+  assert.equal(slotsOverlap(90, 120, 60, 180), true);
+  // Empty / inverted intervals do not overlap
+  assert.equal(slotsOverlap(60, 60, 0, 120), false);
+  assert.equal(slotsOverlap(120, 60, 0, 180), false);
+});
+
+test("isBookingActiveAt checks confirmed status and strict hold expiration", () => {
+  const base: Omit<Booking, "status" | "expiresAt"> = {
+    bookingId: "bkg_0001",
+    roomId: "room_a",
+    customerId: "cust_1",
+    startMinute: 60,
+    endMinute: 120,
+    subtotalCents: 6000,
+    discountCents: 0,
+    taxCents: 600,
+    totalCents: 6600,
+    depositCents: 0,
+  };
+
+  const confirmed: Booking = { ...base, status: "confirmed" };
+  assert.equal(isBookingActiveAt(confirmed, 0), true);
+  assert.equal(isBookingActiveAt(confirmed, 10000), true);
+
+  const held: Booking = { ...base, status: "held", expiresAt: 50 };
+  assert.equal(isBookingActiveAt(held, 0), true);
+  assert.equal(isBookingActiveAt(held, 49), true);
+  assert.equal(isBookingActiveAt(held, 50), false);
+  assert.equal(isBookingActiveAt(held, 51), false);
+
+  const heldWithoutExpiry: Booking = { ...base, status: "held" };
+  assert.equal(isBookingActiveAt(heldWithoutExpiry, 0), false);
+
+  const cancelled: Booking = { ...base, status: "cancelled" };
+  assert.equal(isBookingActiveAt(cancelled, 0), false);
+});
+
+test("createBooking prevents overlapping bookings on same room while allowing back-to-back and other rooms", () => {
+  const svc = setupService();
+
+  const first = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_1",
+    startMinute: 60,
+    endMinute: 120,
+  });
+  assert.equal(first.status, "confirmed");
+  assert.equal(first.expiresAt, undefined);
+
+  // Back-to-back before and after succeed
+  const before = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_2",
+    startMinute: 0,
+    endMinute: 60,
+  });
+  const after = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_3",
+    startMinute: 120,
+    endMinute: 165, // fractional 45 minutes also supported
+  });
+  assert.equal(before.status, "confirmed");
+  assert.equal(after.subtotalCents, 4500);
+  assert.equal(after.taxCents, 450);
+
+  // Same slot on different room succeeds
+  const otherRoom = svc.createBooking({
+    roomId: "room_b",
+    customerId: "cust_4",
+    startMinute: 60,
+    endMinute: 120,
+  });
+  assert.equal(otherRoom.roomId, "room_b");
+
+  // Overlapping slots on room_a fail with ConflictError without mutating state
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "room_a",
+        customerId: "cust_5",
+        startMinute: 119,
+        endMinute: 150,
+      }),
