+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  ValidationError,
+  calculateBookingPrice,
+  computeTaxCents,
+  roundHalfUpDiv,
+} from "../src/index.ts";
+import type { Room } from "../src/index.ts";
+
+test("roundHalfUpDiv performs exact integer half-up rounding", () => {
+  assert.equal(roundHalfUpDiv(0, 60), 0);
+  assert.equal(roundHalfUpDiv(120, 60), 2);
+  // Strictly below half rounds down
+  assert.equal(roundHalfUpDiv(29, 60), 0);
+  assert.equal(roundHalfUpDiv(1, 3), 0);
+  assert.equal(roundHalfUpDiv(20000, 60), 333);
+  // Exact half rounds up regardless of even/odd quotient (not banker's rounding)
+  assert.equal(roundHalfUpDiv(1, 2), 1);
+  assert.equal(roundHalfUpDiv(3, 2), 2);
+  assert.equal(roundHalfUpDiv(5, 2), 3);
+  assert.equal(roundHalfUpDiv(30, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2);
+  assert.equal(roundHalfUpDiv(150, 60), 3);
+  // Strictly above half rounds up
+  assert.equal(roundHalfUpDiv(31, 60), 1);
+  assert.equal(roundHalfUpDiv(2, 3), 1);
+  assert.equal(roundHalfUpDiv(40000, 60), 667);
+});
+
+test("roundHalfUpDiv rejects invalid numerators and denominators with ValidationError", () => {
+  assert.throws(() => roundHalfUpDiv(-1, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(1.5, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.NaN, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.POSITIVE_INFINITY, 60), ValidationError);
+
+  assert.throws(() => roundHalfUpDiv(10, 0), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, -2), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, 2.5), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, Number.NaN), ValidationError);
+});
+
+test("calculateBookingPrice supports arbitrary positive integer durations with half-up cents", () => {
+  const room: Room = {
+    roomId: "studio_1",
+    name: "Studio 1",
+    hourlyRateCents: 1000,
+    taxBps: 825,
+  };
+
+  // 20 minutes: 1000 * 20 / 60 = 333.333... -> 333; tax: 333 * 825 / 10000 = 27.4725 -> 27
+  const twentyMin = calculateBookingPrice(room, 20);
+  assert.equal(twentyMin.subtotalCents, 333);
+  assert.equal(twentyMin.discountCents, 0);
+  assert.equal(twentyMin.taxCents, 27);
+  assert.equal(twentyMin.totalCents, 360);
+  assert.equal(twentyMin.depositCents, 0);
+
+  // 40 minutes: 1000 * 40 / 60 = 666.666... -> 667; tax: 667 * 825 / 10000 = 55.0275 -> 55
+  const fortyMin = calculateBookingPrice(room, 40);
+  assert.equal(fortyMin.subtotalCents, 667);
+  assert.equal(fortyMin.taxCents, 55);
+  assert.equal(fortyMin.totalCents, 722);
+
+  // 90 minutes: 1000 * 90 / 60 = 1500; tax: 1500 * 825 / 10000 = 123.75 -> 124
+  const ninetyMin = calculateBookingPrice(room, 90, { legacyDepositMode: true });
+  assert.equal(ninetyMin.subtotalCents, 1500);
+  assert.equal(ninetyMin.taxCents, 124);
+  assert.equal(ninetyMin.totalCents, 1624);
+  assert.equal(ninetyMin.depositCents, 375);
+});
+
+test("calculateBookingPrice rounds exact .5 cent boundaries half-up for subtotal and tax", () => {
+  const oddRateRoom: Room = {
+    roomId: "odd_1",
+    name: "Odd Rate",
+    hourlyRateCents: 101,
+    taxBps: 100, // 1%
+  };
+  // 101 * 30 / 60 = 50.5 -> 51; tax: 51 * 100 / 10000 = 0.51 -> 1
+  const priceOdd = calculateBookingPrice(oddRateRoom, 30);
+  assert.equal(priceOdd.subtotalCents, 51);
+  assert.equal(priceOdd.taxCents, 1);
+  assert.equal(priceOdd.totalCents, 52);
+
+  const evenBoundaryRoom: Room = {
+    roomId: "even_1",
+    name: "Even Boundary",
+    hourlyRateCents: 99,
+    taxBps: 100, // 1%
+  };
+  // 99 * 30 / 60 = 49.5 -> 50; tax: 50 * 100 / 10000 = 0.50 -> 1
+  const priceEven = calculateBookingPrice(evenBoundaryRoom, 30);
+  assert.equal(priceEven.subtotalCents, 50);
+  assert.equal(priceEven.taxCents, computeTaxCents(50, 100));
+  assert.equal(priceEven.taxCents, 1);
+  assert.equal(priceEven.totalCents, 51);
+
+  // 1 minute at 30 cents/hr = 0.5 cents -> 1 cent
+  const oneMinRoom: Room = {
+    roomId: "min_1",
+    name: "One Min",
+    hourlyRateCents: 30,
+    taxBps: 0,
+  };
+  assert.equal(calculateBookingPrice(oneMinRoom, 1).subtotalCents, 1);
+});
+
+test("calculateBookingPrice rejects invalid durations", () => {
