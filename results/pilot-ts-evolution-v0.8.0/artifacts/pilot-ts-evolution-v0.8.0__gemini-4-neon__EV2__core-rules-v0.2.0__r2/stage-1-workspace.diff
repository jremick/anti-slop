+  const held: Booking = { ...base, status: "held", expiresAt: 50 };
+  assert.equal(isBookingActiveAt(held, 0), true);
+  assert.equal(isBookingActiveAt(held, 49), true);
+  assert.equal(isBookingActiveAt(held, 50), false);
+  assert.equal(isBookingActiveAt(held, 51), false);
