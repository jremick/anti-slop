+function parseConfigBps(value: unknown, fieldName: string): number {
+  if (typeof value !== "number" || !Number.isInteger(value) || value < 0 || value > 10000) {
+    throw new ConfigError(`${fieldName} must be an integer between 0 and 10000`);
+  }
+  return value;
+}
+
+export function loadCancellationFeeConfig(
+  env: Record<string, string | undefined> = process.env,
+): CancellationFeeConfig {
+  const raw = env.BOOKING_CANCEL_FEE_TIERS_JSON;
+  if (typeof raw !== "string" || raw.trim() === "") {
+    throw new ConfigError("BOOKING_CANCEL_FEE_TIERS_JSON must be set");
+  }
+
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(raw);
+  } catch {
+    throw new ConfigError("BOOKING_CANCEL_FEE_TIERS_JSON must be valid JSON");
+  }
+
+  if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) {
+    throw new ConfigError("BOOKING_CANCEL_FEE_TIERS_JSON must be a JSON object");
+  }
+
+  const record = parsed as Record<string, unknown>;
+  const cutoffMinutes = record.cutoffMinutes;
+  if (
+    typeof cutoffMinutes !== "number" ||
+    !Number.isInteger(cutoffMinutes) ||
+    cutoffMinutes < 0
+  ) {
+    throw new ConfigError("cutoffMinutes must be a non-negative integer");
+  }
+
+  const earlyFeeBps = parseConfigBps(record.earlyFeeBps, "earlyFeeBps");
+  const lateFeeBps = parseConfigBps(record.lateFeeBps, "lateFeeBps");
+
+  return {
+    cutoffMinutes,
+    earlyFeeBps,
+    lateFeeBps,
+  };
+}
+
+export function selectCancellationFeeBps(
+  minutesBeforeStart: number,
+  cfg: CancellationFeeConfig,
+): number {
+  if (!Number.isInteger(minutesBeforeStart) || minutesBeforeStart < 0) {
+    throw new ValidationError("minutesBeforeStart must be a non-negative integer");
+  }
+  return minutesBeforeStart >= cfg.cutoffMinutes ? cfg.earlyFeeBps : cfg.lateFeeBps;
+}

