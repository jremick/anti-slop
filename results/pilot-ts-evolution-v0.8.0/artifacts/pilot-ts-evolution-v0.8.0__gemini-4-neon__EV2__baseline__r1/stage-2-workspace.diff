+  assert.equal(hold.status, "held");
+  assert.equal(hold.expiresAt, 40);
+
+  // Overlapping confirmed booking and hold are blocked while nowMinute < 40
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "room_a",
+        customerId: "cust_2",
+        startMinute: 150,
