+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  calculateBookingPrice,
+  createGroupBooking,
+} from "../src/index.ts";
+
+function makeCorporateService(): BookingService {
+  const svc = new BookingService({ env: {} });
+  svc.registerRoom({
+    roomId: "hall_a",
+    name: "Hall A",
+    hourlyRateCents: 10000,
+    taxBps: 825,
+  });
+  svc.registerRoom({
+    roomId: "hall_b",
+    name: "Hall B",
+    hourlyRateCents: 6501,
+    taxBps: 500,
+  });
+  svc.registerRoom({
+    roomId: "hall_c",
+    name: "Hall C",
+    hourlyRateCents: 4000,
+    taxBps: 1000,
+  });
+  return svc;
+}
+
+test("createGroupBooking prices multiple rooms with canonical pricing and shared groupId", () => {
+  const svc = makeCorporateService();
+
+  const result = createGroupBooking(svc, {
+    customerId: "acme_corp",
+    roomIds: ["hall_a", "hall_b", "hall_c"],
+    startMinute: 60,
+    endMinute: 150, // 90 minutes
+    discountBps: 1250, // 12.5%
+  });
+
+  assert.ok(result.groupId.length > 0);
+  assert.equal(result.bookings.length, 3);
+
+  const expectedA = calculateBookingPrice(svc.getRoom("hall_a"), 90, { discountBps: 1250 });
+  const expectedB = calculateBookingPrice(svc.getRoom("hall_b"), 90, { discountBps: 1250 });
+  const expectedC = calculateBookingPrice(svc.getRoom("hall_c"), 90, { discountBps: 1250 });
+
+  const expectedList = [expectedA, expectedB, expectedC];
+  const expectedRooms = ["hall_a", "hall_b", "hall_c"];
+
+  for (let i = 0; i < 3; i += 1) {
+    const booking = result.bookings[i];
+    const expected = expectedList[i];
+    assert.equal(booking.roomId, expectedRooms[i]);
+    assert.equal(booking.groupId, result.groupId);
+    assert.equal(booking.status, "confirmed");
+    assert.equal(booking.customerId, "acme_corp");
+    assert.equal(booking.startMinute, 60);
+    assert.equal(booking.endMinute, 150);
+    assert.equal(booking.subtotalCents, expected.subtotalCents);
+    assert.equal(booking.discountCents, expected.discountCents);
+    assert.equal(booking.taxCents, expected.taxCents);
+    assert.equal(booking.totalCents, expected.totalCents);
+    assert.deepEqual(svc.getBooking(booking.bookingId), booking);
+  }
+
+  assert.equal(
+    result.subtotalCents,
+    expectedA.subtotalCents + expectedB.subtotalCents + expectedC.subtotalCents,
+  );
+  assert.equal(
+    result.discountCents,
+    expectedA.discountCents + expectedB.discountCents + expectedC.discountCents,
+  );
+  assert.equal(
+    result.taxCents,
+    expectedA.taxCents + expectedB.taxCents + expectedC.taxCents,
+  );
+  assert.equal(
+    result.totalCents,
+    expectedA.totalCents + expectedB.totalCents + expectedC.totalCents,
+  );
+  assert.equal(result.totalCents, result.subtotalCents + result.taxCents);
+
+  // Subsequent single booking overlapping any room in the group conflicts
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "hall_b",
+        customerId: "other_cust",
+        startMinute: 120,
+        endMinute: 180,
+      }),
+    ConflictError,
+  );
+
+  // Back-to-back group booking immediately following [60, 150) succeeds with distinct groupId
+  const nextGroup = createGroupBooking(svc, {
+    customerId: "acme_corp",
+    roomIds: ["hall_a", "hall_b"],
+    startMinute: 150,
+    endMinute: 210,
+    discountBps: 0,
+  });
+  assert.notEqual(nextGroup.groupId, result.groupId);
+  assert.equal(nextGroup.bookings.length, 2);
+});
+
+test("createGroupBooking checks conflicts atomically with zero partial bookings on conflict", () => {
+  const svc = makeCorporateService();
+
+  // Occupy hall_b (the 2nd room) with a confirmed booking
+  const blocker = svc.createBooking({
+    roomId: "hall_b",
+    customerId: "existing_cust",
+    startMinute: 90,
+    endMinute: 120,
+  });
+
+  // Attempting to book [hall_a, hall_b, hall_c] overlapping [90, 120) must fail with ConflictError
+  // and commit ZERO bookings on hall_a or hall_c
+  assert.throws(
+    () =>
+      createGroupBooking(svc, {
+        customerId: "corp_1",
+        roomIds: ["hall_a", "hall_b", "hall_c"],
+        startMinute: 60,
+        endMinute: 150,
+        discountBps: 1000,
+      }),
+    ConflictError,
+  );
+
+  assert.equal(svc.listRoomBookings("hall_a").length, 0);
+  assert.deepEqual(svc.listRoomBookings("hall_b"), [blocker]);
+  assert.equal(svc.listRoomBookings("hall_c").length, 0);
+
+  // Active hold on hall_c blocks atomically while active, then succeeds once expired
+  svc.createBooking({
+    roomId: "hall_c",
+    customerId: "hold_cust",
+    startMinute: 200,
+    endMinute: 260,
+    nowMinute: 10,
+    holdMinutes: 20, // expiresAt = 30
+  });
+
+  assert.throws(
+    () =>
+      createGroupBooking(svc, {
+        customerId: "corp_2",
+        roomIds: ["hall_a", "hall_c"],
+        startMinute: 200,
+        endMinute: 260,
+        discountBps: 500,
+        nowMinute: 29,
+      }),
+    ConflictError,
+  );
+  assert.equal(svc.listRoomBookings("hall_a").length, 0);
+
+  // At nowMinute === 30, hold on hall_c is expired, so the group booking succeeds
+  const afterExpiry = createGroupBooking(svc, {
+    customerId: "corp_2",
+    roomIds: ["hall_a", "hall_c"],
+    startMinute: 200,
+    endMinute: 260,
+    discountBps: 500,
+    nowMinute: 30,
+  });
+  assert.equal(afterExpiry.bookings.length, 2);
+  assert.equal(svc.listRoomBookings("hall_a").length, 1);
+  assert.equal(svc.listRoomBookings("hall_c").length, 2);
