+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  ValidationError,
+  applyDiscountAndTax,
+  calculateBookingPrice,
+  computeTaxCents,
+  roundHalfUpDiv,
+} from "../src/index.ts";
+import type { Room } from "../src/index.ts";
+
+test("roundHalfUpDiv rounds exact halves up and sub-halves down", () => {
+  assert.equal(roundHalfUpDiv(0, 60), 0);
+  assert.equal(roundHalfUpDiv(120, 60), 2);
+  assert.equal(roundHalfUpDiv(1, 2), 1);
+  assert.equal(roundHalfUpDiv(3, 2), 2);
+  assert.equal(roundHalfUpDiv(5, 2), 3);
+  assert.equal(roundHalfUpDiv(1, 3), 0);
+  assert.equal(roundHalfUpDiv(2, 3), 1);
+  assert.equal(roundHalfUpDiv(29, 60), 0);
+  assert.equal(roundHalfUpDiv(30, 60), 1);
+  assert.equal(roundHalfUpDiv(31, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2);
+  assert.equal(roundHalfUpDiv(150, 100), 2);
+  assert.equal(roundHalfUpDiv(250, 100), 3);
+});
+
+test("roundHalfUpDiv rejects invalid numerators and denominators with ValidationError", () => {
+  assert.throws(() => roundHalfUpDiv(-1, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(1.5, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.NaN, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.POSITIVE_INFINITY, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, 0), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, -60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, 2.5), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, Number.NaN), ValidationError);
+});
+
+test("calculateBookingPrice supports arbitrary positive integer durations with half-up cents", () => {
+  const room: Room = {
+    roomId: "studio_1",
+    name: "Studio 1",
+    hourlyRateCents: 1001,
+    taxBps: 825,
+  };
+
+  // 1001 * 30 / 60 = 500.5 -> 501 cents; tax = roundHalfUp(501 * 825 / 10000) = roundHalfUp(41.3325) = 41
+  const halfHour = calculateBookingPrice(room, 30);
+  assert.equal(halfHour.subtotalCents, 501);
+  assert.equal(halfHour.discountCents, 0);
+  assert.equal(halfHour.taxCents, computeTaxCents(501, 825));
+  assert.equal(halfHour.taxCents, 41);
+  assert.equal(halfHour.totalCents, 542);
+  assert.equal(halfHour.depositCents, 0);
+
+  // 1000 * 20 / 60 = 333.333... -> 333; 1000 * 40 / 60 = 666.666... -> 667
+  const thirdRoom: Room = {
+    roomId: "studio_2",
+    name: "Studio 2",
+    hourlyRateCents: 1000,
+    taxBps: 1000,
+  };
+  const twentyMin = calculateBookingPrice(thirdRoom, 20);
+  assert.equal(twentyMin.subtotalCents, 333);
+  assert.equal(twentyMin.taxCents, 33);
+  assert.equal(twentyMin.totalCents, 366);
+
+  const fortyMin = calculateBookingPrice(thirdRoom, 40, { legacyDepositMode: true });
+  assert.equal(fortyMin.subtotalCents, 667);
+  assert.equal(fortyMin.taxCents, 67);
+  assert.equal(fortyMin.totalCents, 734);
+  // 667 * 2500 / 10000 = 166.75 -> 167
+  assert.equal(fortyMin.depositCents, 167);
+
+  // 1-minute edge cases around half cent
+  const lowRateDown: Room = { roomId: "r1", name: "R1", hourlyRateCents: 29, taxBps: 0 };
+  const lowRateHalf: Room = { roomId: "r2", name: "R2", hourlyRateCents: 30, taxBps: 0 };
+  assert.equal(calculateBookingPrice(lowRateDown, 1).subtotalCents, 0);
+  assert.equal(calculateBookingPrice(lowRateHalf, 1).subtotalCents, 1);
+
+  // 90-minute booking with odd rate: 3333 * 90 / 60 = 4999.5 -> 5000
+  const ninetyMin = calculateBookingPrice(
+    { roomId: "r3", name: "R3", hourlyRateCents: 3333, taxBps: 500 },
+    90,
+  );
+  assert.equal(ninetyMin.subtotalCents, 5000);
+  assert.equal(ninetyMin.taxCents, 250);
+  assert.equal(ninetyMin.totalCents, 5250);
+});
+
+test("calculateBookingPrice rejects invalid durationMinutes", () => {
+  const room: Room = {
+    roomId: "studio_1",
+    name: "Studio 1",
+    hourlyRateCents: 5000,
+    taxBps: 500,
+  };
+
+  assert.throws(() => calculateBookingPrice(room, 0), ValidationError);
+  assert.throws(() => calculateBookingPrice(room, -15), ValidationError);
+  assert.throws(() => calculateBookingPrice(room, 45.5), ValidationError);
+  assert.throws(() => calculateBookingPrice(room, Number.NaN), ValidationError);
+});
+
+test("applyDiscountAndTax computes exact half-up discount, net subtotal, tax, and total", () => {
+  // 1001 * 1500 / 10000 = 150.15 -> 150; net subtotal = 851; tax = roundHalfUp(851 * 825 / 10000) = roundHalfUp(70.2075) = 70
+  const standard = applyDiscountAndTax(1001, 1500, 825);
+  assert.deepEqual(standard, {
+    subtotalCents: 851,
+    discountCents: 150,
+    taxCents: 70,
+    totalCents: 921,
+  });
+
+  // Exact half-up on discount: 100 * 50 / 10000 = 0.5 -> 1; net subtotal = 99; tax = roundHalfUp(99 * 500 / 10000) = roundHalfUp(4.95) = 5
+  const halfUpDiscount = applyDiscountAndTax(100, 50, 500);
+  assert.deepEqual(halfUpDiscount, {
+    subtotalCents: 99,
+    discountCents: 1,
+    taxCents: 5,
+    totalCents: 104,
+  });
+
+  // 0% and 100% boundary discounts
+  assert.deepEqual(applyDiscountAndTax(5000, 0, 1000), {
+    subtotalCents: 5000,
+    discountCents: 0,
+    taxCents: 500,
+    totalCents: 5500,
+  });
+  assert.deepEqual(applyDiscountAndTax(5000, 10000, 1000), {
+    subtotalCents: 0,
+    discountCents: 5000,
+    taxCents: 0,
+    totalCents: 0,
+  });
+  assert.deepEqual(applyDiscountAndTax(0, 2500, 1000), {
+    subtotalCents: 0,
+    discountCents: 0,
+    taxCents: 0,
+    totalCents: 0,
+  });
+
+  // Validation bounds
+  assert.throws(() => applyDiscountAndTax(-1, 0, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100.5, 0, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, -1, 500), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 10001, 500), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 12.5, 500), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 500, -1), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 500, 10001), ValidationError);
+});
+
+test("calculateBookingPrice applies optional discountBps via applyDiscountAndTax", () => {
+  const room: Room = {
+    roomId: "exec_1",
+    name: "Executive 1",
+    hourlyRateCents: 10000,
+    taxBps: 825,
+  };
+
+  // 90 minutes -> gross = 15000; 15% discount = 2250; subtotal = 12750; tax = roundHalfUp(12750 * 825 / 10000) = roundHalfUp(1051.875) = 1052
+  const discounted = calculateBookingPrice(room, 90, { discountBps: 1500 });
+  assert.deepEqual(discounted, {
+    subtotalCents: 12750,
+    discountCents: 2250,
+    taxCents: 1052,
+    totalCents: 13802,
+    depositCents: 0,
+  });
+
+  // Invalid discountBps throws ValidationError
+  assert.throws(() => calculateBookingPrice(room, 60, { discountBps: -10 }), ValidationError);
+  assert.throws(() => calculateBookingPrice(room, 60, { discountBps: 10001 }), ValidationError);
+});
