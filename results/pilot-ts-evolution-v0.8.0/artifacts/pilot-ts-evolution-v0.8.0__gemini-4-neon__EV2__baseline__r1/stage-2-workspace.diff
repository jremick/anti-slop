+test("holds validate holdMinutes against config, block while active, and stop blocking upon expiration", () => {
+  const svc = makeService({ BOOKING_MAX_HOLD_MINUTES: "30" });
+
+  // Invalid holdMinutes or nowMinute rejected with ValidationError
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "room_a",
+        customerId: "cust_1",
+        startMinute: 120,
+        endMinute: 180,
