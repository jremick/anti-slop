+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "room_a",
+        customerId: "cust_1",
+        startMinute: 120,
+        endMinute: 180,
+        nowMinute: -1,
+        holdMinutes: 10,
+      }),
+    ValidationError,
+  );
+
+  // Hold at maxHoldMinutes succeeds with expiresAt = nowMinute + holdMinutes
+  const hold = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_1",
+    startMinute: 120,
+    endMinute: 180,
