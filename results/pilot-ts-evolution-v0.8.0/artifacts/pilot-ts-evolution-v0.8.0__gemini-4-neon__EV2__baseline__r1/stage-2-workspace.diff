+test("isBookingActiveAt distinguishes confirmed, held, expired, and cancelled bookings", () => {
+  const base: Omit<Booking, "status" | "expiresAt"> = {
+    bookingId: "bkg_0001",
+    roomId: "room_a",
+    customerId: "cust_1",
+    startMinute: 60,
+    endMinute: 120,
+    subtotalCents: 6000,
+    discountCents: 0,
+    taxCents: 600,
+    totalCents: 6600,
+    depositCents: 0,
+  };
+
+  const confirmed: Booking = { ...base, status: "confirmed" };
+  assert.equal(isBookingActiveAt(confirmed, 0), true);
+  assert.equal(isBookingActiveAt(confirmed, 10000), true);
+
+  const held: Booking = { ...base, status: "held", expiresAt: 30 };
+  assert.equal(isBookingActiveAt(held, 0), true);
+  assert.equal(isBookingActiveAt(held, 29), true);
+  assert.equal(isBookingActiveAt(held, 30), false);
+  assert.equal(isBookingActiveAt(held, 31), false);
