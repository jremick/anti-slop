+test("confirmHold transitions active hold to confirmed, clears expiresAt, and rejects invalid transitions", () => {
+  const svc = makeService();
+
+  // Hold using default nowMinute = 0
+  const hold = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_1",
+    startMinute: 200,
+    endMinute: 245,
+    holdMinutes: 20,
+  });
+  assert.equal(hold.status, "held");
+  assert.equal(hold.expiresAt, 20);
+
+  // Confirm right before expiry
+  const confirmed = svc.confirmHold(hold.bookingId, 19);
+  assert.equal(confirmed.bookingId, hold.bookingId);
+  assert.equal(confirmed.status, "confirmed");
+  assert.equal(confirmed.expiresAt, undefined);
+  assert.equal(Object.hasOwn(confirmed, "expiresAt"), false);
+  assert.equal(confirmed.subtotalCents, hold.subtotalCents);
+  assert.equal(confirmed.totalCents, hold.totalCents);
+
+  // Persisted booking reflects confirmed state
+  const fetched = svc.getBooking(hold.bookingId);
+  assert.equal(fetched.status, "confirmed");
+  assert.equal(fetched.expiresAt, undefined);
+
+  // Confirmed booking continues blocking even after old expiresAt
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "room_a",
+        customerId: "cust_2",
+        startMinute: 200,
+        endMinute: 245,
+        nowMinute: 500,
+      }),
+    ConflictError,
+  );
+
+  // Re-confirming an already confirmed booking fails with ValidationError
+  assert.throws(() => svc.confirmHold(hold.bookingId, 19), ValidationError);
+
+  // Confirming an unknown booking fails with ValidationError
+  assert.throws(() => svc.confirmHold("bkg_9999", 0), ValidationError);
+
+  // Confirming an expired hold at exact expiresAt or later fails with ValidationError
+  const expiringHold = svc.createBooking({
+    roomId: "room_b",
+    customerId: "cust_3",
+    startMinute: 60,
+    endMinute: 90,
+    nowMinute: 100,
+    holdMinutes: 15,
+  });
+  assert.equal(expiringHold.expiresAt, 115);
+  assert.throws(() => svc.confirmHold(expiringHold.bookingId, 115), ValidationError);
+  assert.throws(() => svc.confirmHold(expiringHold.bookingId, 120), ValidationError);
+  assert.throws(() => svc.confirmHold(expiringHold.bookingId, -1), ValidationError);
+
+  // Original hold remains held (unconfirmed) after failed confirmHold
+  assert.equal(svc.getBooking(expiringHold.bookingId).status, "held");
+});
+
+test("confirmHold refuses to double-book if another booking took the slot after expiration", () => {
+  const svc = makeService();
+
+  const hold = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_1",
+    startMinute: 60,
+    endMinute: 120,
+    nowMinute: 10,
+    holdMinutes: 10,
+  });
+  // After hold expires at 20, another customer confirms the slot
+  svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_2",
+    startMinute: 60,
+    endMinute: 120,
+    nowMinute: 25,
+  });
+
+  // Out-of-order confirmHold at nowMinute = 15 must not double-book
+  assert.throws(() => svc.confirmHold(hold.bookingId, 15), ConflictError);
+  assert.equal(svc.getBooking(hold.bookingId).status, "held");
+});

