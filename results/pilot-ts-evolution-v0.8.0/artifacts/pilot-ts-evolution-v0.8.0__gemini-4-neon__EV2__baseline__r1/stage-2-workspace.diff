+      svc.createBooking({
+        roomId: "room_a",
+        customerId: "cust_2",
+        startMinute: 120,
+        endMinute: 180,
+        nowMinute: 39,
+        holdMinutes: 15,
+      }),
+    ConflictError,
+  );
+
+  // At exact expiration boundary nowMinute === 40, the hold is no longer active and slot can be booked
+  const replacement = svc.createBooking({
+    roomId: "room_a",
+    customerId: "cust_2",
+    startMinute: 120,
+    endMinute: 180,
+    nowMinute: 40,
