+function readCancellationTierInteger(value: unknown, field: string, max = Infinity): number {
+  if (typeof value !== "number" || !Number.isInteger(value) || value < 0 || value > max) {
+    throw new ConfigError(`Invalid ${field} in BOOKING_CANCEL_FEE_TIERS_JSON`);
+  }
+  return value;
+}
+
+export function loadCancellationFeeConfig(
+  env: BookingEnvironment = getBookingEnvironment(),
+): CancellationFeeConfig {
+  const raw = env.BOOKING_CANCEL_FEE_TIERS_JSON;
+  if (raw === undefined || raw.trim() === "") {
+    throw new ConfigError("BOOKING_CANCEL_FEE_TIERS_JSON is required");
+  }
+
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(raw);
+  } catch {
+    throw new ConfigError("BOOKING_CANCEL_FEE_TIERS_JSON must contain valid JSON");
+  }
+  if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) {
+    throw new ConfigError("BOOKING_CANCEL_FEE_TIERS_JSON must contain a JSON object");
+  }
+
+  const { cutoffMinutes, earlyFeeBps, lateFeeBps } = parsed as Record<string, unknown>;
+  return {
+    cutoffMinutes: readCancellationTierInteger(cutoffMinutes, "cutoffMinutes"),
+    earlyFeeBps: readCancellationTierInteger(earlyFeeBps, "earlyFeeBps", 10000),
+    lateFeeBps: readCancellationTierInteger(lateFeeBps, "lateFeeBps", 10000),
+  };
+}
+
+export function selectCancellationFeeBps(minutesBeforeStart: number, cfg: CancellationFeeConfig): number {
+  return minutesBeforeStart >= cfg.cutoffMinutes ? cfg.earlyFeeBps : cfg.lateFeeBps;
+}

