+import test from "node:test";
+import assert from "node:assert/strict";
+import { ValidationError, applyDiscountAndTax, calculateBookingPrice, roundHalfUpDiv } from "../src/index.ts";
+import * as publicApi from "../src/index.ts";
+import * as pricing from "../src/pricing.ts";
+
+const room = { roomId: "a", name: "Room A", hourlyRateCents: 89, taxBps: 5000 };
+
+test("pricing and public entry points expose no deposit exports", () => {
+  assert.deepEqual(Object.keys(pricing).filter((name) => /deposit/i.test(name)), []);
+  assert.deepEqual(Object.keys(publicApi).filter((name) => /deposit/i.test(name)), []);
+});
+
+test("half-up division rounds down below a tie and up at and above it", () => {
+  assert.equal(roundHalfUpDiv(0, 60), 0);
+  assert.equal(roundHalfUpDiv(89, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2);
+  assert.equal(roundHalfUpDiv(91, 60), 2);
+  assert.equal(roundHalfUpDiv(7, 3), 2);
+  assert.equal(roundHalfUpDiv(8, 3), 3);
+  assert.equal(roundHalfUpDiv(9, 3), 3);
+});
+
+test("half-up division rejects invalid numerators and denominators", () => {
+  for (const numerator of [-1, 1.5, NaN, Infinity]) {
+    assert.throws(() => roundHalfUpDiv(numerator, 60), ValidationError);
+  }
+  for (const denominator of [0, -1, 1.5, NaN, Infinity]) {
+    assert.throws(() => roundHalfUpDiv(60, denominator), ValidationError);
+  }
+});
+
+test("pricing prorates whole minutes and computes tax on the rounded subtotal", () => {
+  assert.deepEqual(calculateBookingPrice(room, 1), {
+    subtotalCents: 1,
+    discountCents: 0,
+    taxCents: 1,
+    totalCents: 2,
+  });
+  assert.deepEqual(calculateBookingPrice({ ...room, hourlyRateCents: 90 }, 1), {
+    subtotalCents: 2,
+    discountCents: 0,
+    taxCents: 1,
+    totalCents: 3,
+  });
+  assert.equal(calculateBookingPrice(room, 75).subtotalCents, 111);
+  assert.equal(calculateBookingPrice({ ...room, hourlyRateCents: 1 }, 1).totalCents, 0);
+});
+
+test("pricing requires positive integer durations", () => {
+  for (const durationMinutes of [0, -1, 1.5, NaN, Infinity]) {
+    assert.throws(() => calculateBookingPrice(room, durationMinutes), ValidationError);
+  }
+});
+
+test("discount and tax round half up, with tax calculated on the net subtotal", () => {
+  assert.deepEqual(applyDiscountAndTax(5, 5000, 5000), {
+    subtotalCents: 2, discountCents: 3, taxCents: 1, totalCents: 3,
+  });
+  assert.deepEqual(applyDiscountAndTax(5, 0, 5000), {
+    subtotalCents: 5, discountCents: 0, taxCents: 3, totalCents: 8,
+  });
+  assert.deepEqual(applyDiscountAndTax(5, 10000, 10000), {
+    subtotalCents: 0, discountCents: 5, taxCents: 0, totalCents: 0,
+  });
+  assert.deepEqual(calculateBookingPrice(room, 2, { discountBps: 5000 }), {
+    subtotalCents: 1, discountCents: 2, taxCents: 1, totalCents: 2,
+  });
+});
+
+test("discounted pricing validates the gross subtotal and both basis-point rates", () => {
+  for (const bps of [-1, 10001, 0.5, NaN, Infinity]) {
+    assert.throws(() => applyDiscountAndTax(5, bps, 0), ValidationError);
+    assert.throws(() => applyDiscountAndTax(5, 0, bps), ValidationError);
+  }
+  for (const grossSubtotalCents of [-1, 0.5, NaN, Infinity]) {
+    assert.throws(() => applyDiscountAndTax(grossSubtotalCents, 0, 0), ValidationError);
+  }
+});
