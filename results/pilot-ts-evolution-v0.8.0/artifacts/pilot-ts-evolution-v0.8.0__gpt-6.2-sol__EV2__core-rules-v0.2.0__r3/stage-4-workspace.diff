+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConfigError,
+  ConflictError,
+  ValidationError,
+  computeCancellationRefund,
+  loadCancellationFeeConfig,
+  selectCancellationFeeBps,
+} from "../src/index.ts";
+
+const tiers = { cutoffMinutes: 30, earlyFeeBps: 2500, lateFeeBps: 7500 };
+const tierJson = JSON.stringify(tiers);
+const slot = { roomId: "a", customerId: "customer", startMinute: 100, endMinute: 160 };
+
+function createService(env: Record<string, string | undefined>): BookingService {
+  const service = new BookingService({ env });
+  service.registerRoom({ roomId: "a", name: "Room A", hourlyRateCents: 1005, taxBps: 1000 });
+  return service;
+}
+
+test("cancellation config selects the early fee at and above the cutoff", () => {
+  const config = loadCancellationFeeConfig({ BOOKING_CANCEL_FEE_TIERS_JSON: tierJson });
+  assert.deepEqual(config, tiers);
+  assert.equal(selectCancellationFeeBps(31, config), 2500);
+  assert.equal(selectCancellationFeeBps(30, config), 2500);
+  assert.equal(selectCancellationFeeBps(29, config), 7500);
+
+  const bounds = { cutoffMinutes: 0, earlyFeeBps: 0, lateFeeBps: 10000 };
+  assert.deepEqual(loadCancellationFeeConfig({ BOOKING_CANCEL_FEE_TIERS_JSON: JSON.stringify(bounds) }), bounds);
+});
+
+test("cancellation refunds round fees half up and validate both inputs", () => {
+  assert.deepEqual(computeCancellationRefund(5, 5000), { feeCents: 3, refundCents: 2 });
+  assert.deepEqual(computeCancellationRefund(5, 0), { feeCents: 0, refundCents: 5 });
+  assert.deepEqual(computeCancellationRefund(5, 10000), { feeCents: 5, refundCents: 0 });
+  for (const amount of [-1, 0.5, Infinity, NaN]) {
+    assert.throws(() => computeCancellationRefund(amount, 0), ValidationError);
+  }
+  for (const rate of [-1, 0.5, 10001, Infinity, NaN]) {
+    assert.throws(() => computeCancellationRefund(5, rate), ValidationError);
+  }
+});
+
+test("booking cancellation charges the selected tier on the stored total", () => {
+  for (const [nowMinute, feeBps, feeCents, refundCents] of [
+    [69, 2500, 277, 829],
+    [70, 2500, 277, 829],
+    [71, 7500, 830, 276],
+    [100, 7500, 830, 276],
+  ]) {
+    const service = createService({ BOOKING_CANCEL_FEE_TIERS_JSON: tierJson });
+    const original = service.createBooking(slot);
+    assert.equal(original.totalCents, 1106);
+    const result = service.cancelBooking(original.bookingId, nowMinute);
+    const cancelled = { ...original, status: "cancelled" };
+    assert.deepEqual(result, { booking: cancelled, feeBps, feeCents, refundCents });
+    assert.deepEqual(service.getBooking(original.bookingId), cancelled);
+  }
+});
+
+test("missing or invalid tiers fail closed and leave the original slot blocked", () => {
+  const invalidConfigs = [
+    undefined,
+    "",
+    "  ",
+    "{",
+    "null",
+    "[]",
+    "42",
+    '"tiers"',
+    "{}",
+    JSON.stringify({ ...tiers, cutoffMinutes: -1 }),
+    JSON.stringify({ ...tiers, cutoffMinutes: 1.5 }),
+    JSON.stringify({ ...tiers, cutoffMinutes: "30" }),
+    JSON.stringify({ ...tiers, earlyFeeBps: -1 }),
+    JSON.stringify({ ...tiers, earlyFeeBps: 10001 }),
+    JSON.stringify({ ...tiers, lateFeeBps: 0.5 }),
