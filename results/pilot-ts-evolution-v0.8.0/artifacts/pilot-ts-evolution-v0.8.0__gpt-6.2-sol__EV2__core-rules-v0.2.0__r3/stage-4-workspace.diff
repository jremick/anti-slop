+import test from "node:test";
+import assert from "node:assert/strict";
+import { BookingService, ConflictError, ValidationError, createGroupBooking } from "../src/index.ts";
+import type { BookingNotification } from "../src/index.ts";
+
+const slot = { roomId: "a", customerId: "customer", startMinute: 100, endMinute: 160 };
+const group = {
+  customerId: "corporate",
+  roomIds: ["a", "b"],
+  startMinute: 100,
+  endMinute: 160,
+  discountBps: 2500,
+};
+
+function createService(notifyHook: (event: BookingNotification) => void): BookingService {
+  const service = new BookingService({
+    env: {
+      BOOKING_CANCEL_FEE_TIERS_JSON: '{"cutoffMinutes":30,"earlyFeeBps":2500,"lateFeeBps":7500}',
+    },
+    notifyHook,
+  });
+  service.registerRoom({ roomId: "a", name: "Room A", hourlyRateCents: 1000, taxBps: 1000 });
+  service.registerRoom({ roomId: "b", name: "Room B", hourlyRateCents: 2000, taxBps: 1000 });
+  return service;
+}
+
+test("creation and cancellation notify with exact identifiers and amounts", () => {
+  const events: BookingNotification[] = [];
+  const service = createService((event) => events.push(event));
+  const held = service.createBooking({ ...slot, customerId: " customer ", nowMinute: 50, holdMinutes: 20 });
+  service.confirmHold(held.bookingId, 55);
+  const result = service.cancelBooking(held.bookingId, 60);
+
+  assert.equal(result.refundCents, 825);
+  assert.deepEqual(events, [
+    { event: "booking_created", bookingId: held.bookingId, roomId: "a", customerId: "customer", amountCents: 1100 },
+    { event: "booking_cancelled", bookingId: held.bookingId, roomId: "a", customerId: "customer", amountCents: 825 },
+  ]);
+});
+
+test("group creation notifies once per room using its discounted total", () => {
+  const events: BookingNotification[] = [];
+  const service = createService((event) => events.push(event));
+  const result = createGroupBooking(service, group);
+
+  assert.deepEqual(events, [
+    { event: "booking_created", bookingId: result.bookings[0].bookingId, roomId: "a", customerId: "corporate", amountCents: 825 },
+    { event: "booking_created", bookingId: result.bookings[1].bookingId, roomId: "b", customerId: "corporate", amountCents: 1650 },
+  ]);
+});
+
+test("a creation hook failure propagates unchanged and leaves the slot available for retry", () => {
+  const failure = new Error("creation notification failed");
+  let fail = true;
+  let attemptedId: string | undefined;
+  const service = createService((event) => {
+    if (fail) {
+      attemptedId = event.bookingId;
+      throw failure;
+    }
+  });
+
+  assert.throws(() => service.createBooking(slot), (error) => error === failure);
+  assert.deepEqual(service.listRoomBookings("a"), []);
+  assert.ok(attemptedId);
+  assert.throws(() => service.getBooking(attemptedId), ValidationError);
+
+  fail = false;
+  const retried = service.createBooking(slot);
+  assert.notEqual(retried.bookingId, attemptedId);
+  assert.deepEqual(service.listRoomBookings("a"), [retried]);
+});
+
+test("failure during the second group notification leaves no partial bookings", () => {
+  const failure = new Error("second room notification failed");
+  const events: BookingNotification[] = [];
+  let fail = true;
+  const service = createService((event) => {
+    events.push(event);
+    assert.deepEqual(service.listRoomBookings("a"), []);
+    assert.deepEqual(service.listRoomBookings("b"), []);
+    if (fail && event.roomId === "b") {
+      throw failure;
+    }
+  });
+
+  assert.throws(() => createGroupBooking(service, group), (error) => error === failure);
+  assert.deepEqual(events.map((event) => event.roomId), ["a", "b"]);
+  for (const event of events) {
+    assert.throws(() => service.getBooking(event.bookingId), ValidationError);
+  }
+  assert.deepEqual(service.listRoomBookings("a"), []);
+  assert.deepEqual(service.listRoomBookings("b"), []);
+
+  fail = false;
+  const retried = createGroupBooking(service, group);
+  for (const booking of retried.bookings) {
+    assert.deepEqual(service.listRoomBookings(booking.roomId), [booking]);
+  }
+});
+
+test("a cancellation hook failure preserves the original booking and its conflict", () => {
+  const failure = new Error("cancellation notification failed");
+  let fail = true;
+  const service = createService((event) => {
+    if (event.event === "booking_cancelled") {
+      assert.equal(service.getBooking(event.bookingId).status, "confirmed");
+      if (fail) {
+        throw failure;
+      }
+    }
+  });
+  const booking = service.createBooking(slot);
+
+  assert.throws(() => service.cancelBooking(booking.bookingId, 60), (error) => error === failure);
+  assert.deepEqual(service.getBooking(booking.bookingId), booking);
+  assert.throws(() => service.createBooking(slot), ConflictError);
+
+  fail = false;
+  assert.equal(service.cancelBooking(booking.bookingId, 60).booking.status, "cancelled");
+  assert.equal(service.createBooking(slot).status, "confirmed");
+});
+
+test("notifications cannot write bookings through the same service while a commit is pending", () => {
+  let reenter = true;
+  const service = createService(() => {
+    if (reenter) {
+      service.createBooking({ ...slot, roomId: "b" });
+    }
+  });
+
+  assert.throws(() => service.createBooking(slot), ValidationError);
+  assert.deepEqual(service.listRoomBookings("a"), []);
+  assert.deepEqual(service.listRoomBookings("b"), []);
+  reenter = false;
+  assert.equal(service.createBooking(slot).status, "confirmed");
+});

