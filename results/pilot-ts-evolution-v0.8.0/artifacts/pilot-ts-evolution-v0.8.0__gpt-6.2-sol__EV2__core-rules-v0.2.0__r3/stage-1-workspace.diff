+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  isBookingActiveAt,
+  slotsOverlap,
+} from "../src/index.ts";
+
+const slot = { roomId: "a", customerId: "customer", startMinute: 60, endMinute: 90 };
+
+function createService(): BookingService {
+  const service = new BookingService({ env: { BOOKING_MAX_HOLD_MINUTES: "15" } });
+  service.registerRoom({ roomId: "a", name: "Room A", hourlyRateCents: 3451, taxBps: 800 });
+  service.registerRoom({ roomId: "b", name: "Room B", hourlyRateCents: 3451, taxBps: 800 });
+  return service;
+}
+
+test("half-open slots overlap only when they share time", () => {
+  assert.equal(slotsOverlap(60, 90, 90, 100), false);
+  assert.equal(slotsOverlap(60, 90, 30, 60), false);
+  assert.equal(slotsOverlap(60, 90, 91, 100), false);
+  assert.equal(slotsOverlap(60, 90, 89, 100), true);
+  assert.equal(slotsOverlap(60, 90, 30, 61), true);
+  assert.equal(slotsOverlap(60, 90, 61, 89), true);
+  assert.equal(slotsOverlap(60, 90, 60, 90), true);
+});
+
+test("booking activity depends on status and the strict expiration boundary", () => {
+  const service = createService();
+  const confirmed = service.createBooking(slot);
+  const held = service.createBooking({ ...slot, roomId: "b", holdMinutes: 15, nowMinute: 10 });
+
+  assert.equal(isBookingActiveAt(confirmed, 100), true);
+  assert.equal(isBookingActiveAt({ ...confirmed, status: "held" }, 0), false);
+  assert.equal(isBookingActiveAt({ ...held, status: "cancelled" }, 24), false);
+  assert.equal(isBookingActiveAt(held, 24), true);
+  assert.equal(isBookingActiveAt(held, 25), false);
+  assert.equal(isBookingActiveAt(held, 26), false);
+});
+
+test("confirmed bookings block overlap in their room and allow adjacent slots", () => {
+  const service = createService();
+  service.createBooking(slot);
+
+  for (const [startMinute, endMinute] of [[30, 61], [89, 100], [61, 89], [30, 100], [60, 90]]) {
+    assert.throws(() => service.createBooking({ ...slot, startMinute, endMinute }), ConflictError);
+  }
+  assert.throws(() => service.createBooking({ ...slot, holdMinutes: 5 }), ConflictError);
+  assert.equal(service.listRoomBookings(slot.roomId).length, 1);
+
+  assert.equal(service.createBooking({ ...slot, startMinute: 30, endMinute: 60 }).status, "confirmed");
+  assert.equal(service.createBooking({ ...slot, startMinute: 90, endMinute: 100 }).status, "confirmed");
+  assert.equal(service.createBooking({ ...slot, roomId: "b" }).status, "confirmed");
+});
+
+test("held bookings block until expiration and release the slot at expiration", () => {
+  const service = createService();
+  const held = service.createBooking({ ...slot, nowMinute: 10, holdMinutes: 15 });
+  assert.equal(held.status, "held");
+  assert.equal(held.expiresAt, 25);
+  assert.throws(() => service.createBooking({ ...slot, nowMinute: 24 }), ConflictError);
+  assert.equal(service.createBooking({ ...slot, nowMinute: 25 }).status, "confirmed");
+  assert.throws(() => service.confirmHold(held.bookingId, 25), ValidationError);
+  assert.equal(service.getBooking(held.bookingId).status, "held");
+});
+
+test("holds validate duration against the configured limit and default to minute zero", () => {
+  const service = createService();
+  for (const holdMinutes of [0, -1, 1.5, 16, Infinity, NaN]) {
+    assert.throws(() => service.createBooking({ ...slot, holdMinutes }), ValidationError);
+  }
+  const held = service.createBooking({ ...slot, holdMinutes: 15 });
+  assert.equal(held.expiresAt, 15);
+  assert.throws(() => service.createBooking(slot), ConflictError);
+});
+
+test("confirmation persists an unexpired hold with its original details and price", () => {
+  const service = createService();
+  const held = service.createBooking({ ...slot, holdMinutes: 1, legacyDepositMode: true });
+  assert.throws(() => service.confirmHold("unknown", 0), ValidationError);
+
+  const confirmed = service.confirmHold(held.bookingId, 0);
+  assert.equal(confirmed.status, "confirmed");
+  assert.equal(Object.hasOwn(confirmed, "expiresAt"), false);
+  const { status, expiresAt, ...expectedDetails } = held;
+  const { status: confirmedStatus, ...confirmedDetails } = confirmed;
+  assert.deepEqual(confirmedDetails, expectedDetails);
+  assert.deepEqual(service.getBooking(held.bookingId), confirmed);
+  assert.deepEqual(service.listRoomBookings(slot.roomId), [confirmed]);
+  assert.throws(() => service.confirmHold(held.bookingId, 0), ValidationError);
+  assert.throws(() => service.createBooking({ ...slot, nowMinute: 1 }), ConflictError);
+});

