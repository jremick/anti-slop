+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  calculateBookingPrice,
+  isBookingActiveAt,
+  roundHalfUpDiv,
+  slotsOverlap,
+} from "../src/index.ts";
+import type { Booking, Room } from "../src/index.ts";
+
+const ROOM: Room = { roomId: "r1", name: "Room 1", hourlyRateCents: 10000, taxBps: 825 };
+
+function makeService(env: Record<string, string | undefined> = {}): BookingService {
+  const svc = new BookingService({ env });
+  svc.registerRoom(ROOM);
+  svc.registerRoom({ roomId: "r2", name: "Room 2", hourlyRateCents: 5000, taxBps: 0 });
+  return svc;
+}
+
+function baseBooking(overrides: Partial<Booking>): Booking {
+  return {
+    bookingId: "b",
+    roomId: "r1",
+    customerId: "c",
+    startMinute: 0,
+    endMinute: 60,
+    status: "confirmed",
+    subtotalCents: 0,
+    discountCents: 0,
+    taxCents: 0,
+    totalCents: 0,
+    ...overrides,
+  };
+}
+
+// ---------- roundHalfUpDiv ----------
+
+test("roundHalfUpDiv rounds exact, below-half, half, and above-half cases", () => {
+  assert.equal(roundHalfUpDiv(0, 7), 0);
+  assert.equal(roundHalfUpDiv(120, 60), 2);
+  assert.equal(roundHalfUpDiv(89, 60), 1); // 1.483
+  assert.equal(roundHalfUpDiv(90, 60), 2); // exactly 1.5 -> up
+  assert.equal(roundHalfUpDiv(91, 60), 2);
+  assert.equal(roundHalfUpDiv(1, 2), 1); // 0.5 -> 1
+  assert.equal(roundHalfUpDiv(5, 2), 3); // 2.5 -> 3 (not banker's)
+  assert.equal(roundHalfUpDiv(1, 3), 0);
+  assert.equal(roundHalfUpDiv(2, 3), 1);
+  assert.equal(roundHalfUpDiv(7, 1), 7);
+});
+
+test("roundHalfUpDiv matches a brute-force reference across many inputs", () => {
+  for (let d = 1; d <= 25; d += 1) {
+    for (let n = 0; n <= 200; n += 1) {
+      const q = Math.floor(n / d);
+      const r = n - q * d;
+      const expected = 2 * r >= d ? q + 1 : q;
+      assert.equal(roundHalfUpDiv(n, d), expected, `n=${n} d=${d}`);
+    }
+  }
+});
+
+test("roundHalfUpDiv rejects non-integers, negative numerators, and non-positive denominators", () => {
+  const bad: Array<[number, number]> = [
+    [1.5, 2], [-1, 2], [1, 0], [1, -3], [1, 2.5], [Number.NaN, 1], [1, Number.NaN],
+    [Number.POSITIVE_INFINITY, 1], [Number.MAX_SAFE_INTEGER, 60],
+  ];
+  for (const [n, d] of bad) {
+    assert.throws(() => roundHalfUpDiv(n, d), ValidationError, `n=${n} d=${d}`);
+  }
+});
+
+// ---------- calculateBookingPrice ----------
+
+test("calculateBookingPrice supports fractional-hour durations with half-up cents", () => {
+  // 10000 * 90 / 60 = 15000 exactly
+  const p90 = calculateBookingPrice(ROOM, 90);
+  assert.equal(p90.subtotalCents, 15000);
+  assert.equal(p90.taxCents, 1238); // 15000 * 0.0825 = 1237.5 -> 1238
+  assert.equal(p90.totalCents, 16238);
+  assert.equal(p90.discountCents, 0);
+  assert.equal(p90.depositCents, 0);
+
+  // 999 cents/hour for 1 minute: 16.65 -> 17
+  const odd: Room = { roomId: "o", name: "Odd", hourlyRateCents: 999, taxBps: 0 };
+  assert.equal(calculateBookingPrice(odd, 1).subtotalCents, 17);
+  // 1 cent/hour * 30 minutes = 0.5 -> 1 (tie rounds up)
+  const penny: Room = { roomId: "p", name: "Penny", hourlyRateCents: 1, taxBps: 0 };
+  assert.equal(calculateBookingPrice(penny, 30).subtotalCents, 1);
+  assert.equal(calculateBookingPrice(penny, 29).subtotalCents, 0);
+  // 1001 * 45 / 60 = 750.75 -> 751
+  const r1001: Room = { roomId: "q", name: "Q", hourlyRateCents: 1001, taxBps: 1000 };
+  const p45 = calculateBookingPrice(r1001, 45);
+  assert.equal(p45.subtotalCents, 751);
+  assert.equal(p45.taxCents, 75); // 75.1 -> 75
+  assert.equal(p45.totalCents, 826);
+});
+
+test("calculateBookingPrice keeps whole-hour results and legacy deposit on the rounded subtotal", () => {
+  assert.equal(calculateBookingPrice(ROOM, 120).subtotalCents, 20000);
+  const r: Room = { roomId: "d", name: "D", hourlyRateCents: 1001, taxBps: 0 };
+  const p = calculateBookingPrice(r, 45, { legacyDepositMode: true });
+  assert.equal(p.subtotalCents, 751);
+  assert.equal(p.depositCents, 188); // 187.75 -> 188
+});
+
+test("calculateBookingPrice rejects non-positive or non-integer durations", () => {
+  for (const d of [0, -30, 1.5, Number.NaN]) {
+    assert.throws(() => calculateBookingPrice(ROOM, d), ValidationError, `d=${d}`);
+  }
+});
+
+test("createBooking prices odd-minute bookings", () => {
+  const svc = makeService();
+  const b = svc.createBooking({ roomId: "r1", customerId: "c", startMinute: 10, endMinute: 55 });
+  assert.equal(b.subtotalCents, 7500);
+  assert.equal(b.taxCents, 619); // 618.75 -> 619
+  assert.equal(b.totalCents, 8119);
+});
+
+// ---------- slotsOverlap / isBookingActiveAt ----------
+
+test("slotsOverlap uses half-open intervals", () => {
+  assert.equal(slotsOverlap(0, 60, 60, 120), false); // back-to-back
+  assert.equal(slotsOverlap(60, 120, 0, 60), false);
+  assert.equal(slotsOverlap(0, 60, 59, 120), true);
+  assert.equal(slotsOverlap(0, 120, 30, 60), true); // containment
+  assert.equal(slotsOverlap(30, 60, 0, 120), true);
+  assert.equal(slotsOverlap(0, 60, 0, 60), true); // identical
+  assert.equal(slotsOverlap(0, 30, 90, 120), false); // disjoint
+});
+
+test("isBookingActiveAt handles confirmed, held, expired, and cancelled", () => {
+  assert.equal(isBookingActiveAt(baseBooking({ status: "confirmed" }), 1_000_000), true);
+  const held = baseBooking({ status: "held", expiresAt: 15 });
+  assert.equal(isBookingActiveAt(held, 0), true);
+  assert.equal(isBookingActiveAt(held, 14), true);
+  assert.equal(isBookingActiveAt(held, 15), false); // expiry instant is exclusive
+  assert.equal(isBookingActiveAt(held, 16), false);
+  assert.equal(isBookingActiveAt(baseBooking({ status: "held" }), 0), false); // no expiresAt
+  assert.equal(isBookingActiveAt(baseBooking({ status: "cancelled" }), 0), false);
+});
