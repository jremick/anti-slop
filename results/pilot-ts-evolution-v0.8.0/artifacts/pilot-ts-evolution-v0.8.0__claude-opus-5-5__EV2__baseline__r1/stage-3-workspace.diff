+/**
+ * Exact integer division rounded half-up: round(numerator / denominator) with
+ * ties rounding toward +infinity. Inputs must be integers, numerator >= 0 and
+ * denominator > 0, and the intermediate value must stay within safe-integer range.
+ */
+export function roundHalfUpDiv(numerator: number, denominator: number): number {
+  if (!Number.isInteger(numerator) || numerator < 0) {
+    throw new ValidationError("numerator must be a non-negative integer");
+  }
+  if (!Number.isInteger(denominator) || denominator <= 0) {
+    throw new ValidationError("denominator must be a positive integer");
+  }
+  const scaled = numerator * 2 + denominator;
+  if (!Number.isSafeInteger(scaled) || !Number.isSafeInteger(2 * denominator)) {
+    throw new ValidationError("roundHalfUpDiv operands exceed safe integer range");
+  }
+  return Math.floor(scaled / (2 * denominator));
+}
