+// ---------- roundHalfUpDiv ----------
+
+test("roundHalfUpDiv rounds exact, below-half, half, and above-half cases", () => {
+  assert.equal(roundHalfUpDiv(0, 7), 0);
+  assert.equal(roundHalfUpDiv(120, 60), 2);
+  assert.equal(roundHalfUpDiv(89, 60), 1); // 1.483
+  assert.equal(roundHalfUpDiv(90, 60), 2); // exactly 1.5 -> up
+  assert.equal(roundHalfUpDiv(91, 60), 2);
+  assert.equal(roundHalfUpDiv(1, 2), 1); // 0.5 -> 1
+  assert.equal(roundHalfUpDiv(5, 2), 3); // 2.5 -> 3 (not banker's)
+  assert.equal(roundHalfUpDiv(1, 3), 0);
+  assert.equal(roundHalfUpDiv(2, 3), 1);
+  assert.equal(roundHalfUpDiv(7, 1), 7);
+});
+
+test("roundHalfUpDiv matches a brute-force reference across many inputs", () => {
+  for (let d = 1; d <= 25; d += 1) {
+    for (let n = 0; n <= 200; n += 1) {
+      const q = Math.floor(n / d);
+      const r = n - q * d;
+      const expected = 2 * r >= d ? q + 1 : q;
+      assert.equal(roundHalfUpDiv(n, d), expected, `n=${n} d=${d}`);
+    }
+  }
+});
+
+test("roundHalfUpDiv rejects non-integers, negative numerators, and non-positive denominators", () => {
+  const bad: Array<[number, number]> = [
+    [1.5, 2], [-1, 2], [1, 0], [1, -3], [1, 2.5], [Number.NaN, 1], [1, Number.NaN],
+    [Number.POSITIVE_INFINITY, 1], [Number.MAX_SAFE_INTEGER, 60],
+  ];
+  for (const [n, d] of bad) {
+    assert.throws(() => roundHalfUpDiv(n, d), ValidationError, `n=${n} d=${d}`);
+  }
+});
