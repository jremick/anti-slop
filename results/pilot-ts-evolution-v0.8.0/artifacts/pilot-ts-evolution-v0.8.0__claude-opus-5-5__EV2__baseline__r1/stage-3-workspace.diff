+// Dependency direction: corporate.ts -> bookings.ts -> pricing.ts.
+// bookings.ts must never import this module.
+import { isBookingActiveAt, slotsOverlap, validateBookingWindow } from "./bookings.ts";
+import type { BookingDraft, BookingService } from "./bookings.ts";
+import { ConflictError, ValidationError } from "./models.ts";
+import type { Booking, Room } from "./models.ts";
+import { calculateBookingPrice, validateBps, validateNonNegativeInt } from "./pricing.ts";
+
+export interface GroupBookingInput {
+  readonly customerId: string;
+  readonly roomIds: readonly string[];
+  readonly startMinute: number;
+  readonly endMinute: number;
+  readonly discountBps: number;
+  readonly nowMinute?: number;
+}
+
+export interface GroupBookingResult {
+  readonly groupId: string;
+  readonly bookings: readonly Booking[];
+  readonly subtotalCents: number;
+  readonly discountCents: number;
+  readonly taxCents: number;
+  readonly totalCents: number;
+}
+
+/**
+ * Books the same [startMinute, endMinute) slot in several rooms atomically.
+ * All validation and conflict checks complete before anything is committed,
+ * so a failure leaves the service unchanged. Each room is priced with the
+ * canonical calculateBookingPrice; group totals are the per-room sums.
+ */
+export function createGroupBooking(
+  service: BookingService,
+  input: GroupBookingInput,
+): GroupBookingResult {
+  const customerId = validateBookingWindow(
+    input.customerId,
+    input.startMinute,
+    input.endMinute,
+  );
+  const nowMinute = input.nowMinute ?? 0;
+  validateNonNegativeInt(nowMinute, "nowMinute");
+  validateBps(input.discountBps, "discountBps");
+  if (!Array.isArray(input.roomIds) || input.roomIds.length < 2) {
+    throw new ValidationError("A group booking requires at least 2 roomIds");
+  }
+  if (new Set(input.roomIds).size !== input.roomIds.length) {
+    throw new ValidationError("roomIds must not contain duplicates");
+  }
+  const rooms: Room[] = input.roomIds.map((roomId) => service.getRoom(roomId));
+
+  // Phase 1: check every room before committing anything.
+  for (const room of rooms) {
+    const conflict = service
+      .listRoomBookings(room.roomId)
+      .find(
+        (existing) =>
+          isBookingActiveAt(existing, nowMinute) &&
+          slotsOverlap(input.startMinute, input.endMinute, existing.startMinute, existing.endMinute),
+      );
+    if (conflict !== undefined) {
+      throw new ConflictError(
+        `Room ${room.roomId} slot [${input.startMinute}, ${input.endMinute}) conflicts with booking ${conflict.bookingId}`,
+      );
+    }
+  }
+
+  // Phase 2: price every room (may still throw; nothing committed yet).
+  const durationMinutes = input.endMinute - input.startMinute;
+  const prices = rooms.map((room) =>
+    calculateBookingPrice(room, durationMinutes, { discountBps: input.discountBps }),
+  );
+  const groupId = service.allocateGroupId();
+  const drafts: BookingDraft[] = rooms.map((room, i) => {
+    const price = prices[i]!;
+    return {
+      roomId: room.roomId,
+      customerId,
+      startMinute: input.startMinute,
+      endMinute: input.endMinute,
+      status: "confirmed",
+      subtotalCents: price.subtotalCents,
+      discountCents: price.discountCents,
+      taxCents: price.taxCents,
+      totalCents: price.totalCents,
+      depositCents: price.depositCents,
+      groupId,
+    };
+  });
+
+  // Phase 3: commit all-or-nothing.
+  const bookings = service.commitBookings(drafts);
+  let subtotalCents = 0;
+  let discountCents = 0;
+  let taxCents = 0;
+  let totalCents = 0;
+  for (const booking of bookings) {
+    subtotalCents += booking.subtotalCents;
+    discountCents += booking.discountCents;
+    taxCents += booking.taxCents;
+    totalCents += booking.totalCents;
+  }
+  return { groupId, bookings, subtotalCents, discountCents, taxCents, totalCents };
+}

