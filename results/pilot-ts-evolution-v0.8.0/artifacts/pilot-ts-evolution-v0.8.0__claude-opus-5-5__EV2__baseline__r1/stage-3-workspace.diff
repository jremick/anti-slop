+  assert.deepEqual(applyDiscountAndTax(15000, 1500, 825), {
+    subtotalCents: 12750, discountCents: 2250, taxCents: 1052, totalCents: 13802,
+  });
+  // 1 * 50% = 0.5 -> 1 (tie rounds up)
+  assert.deepEqual(applyDiscountAndTax(1, 5000, 0), {
+    subtotalCents: 0, discountCents: 1, taxCents: 0, totalCents: 0,
+  });
+  // 3 * 1/6 ≈ 0.4999 -> 0
+  assert.equal(applyDiscountAndTax(3, 1666, 0).discountCents, 0);
