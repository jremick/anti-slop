+test("applyDiscountAndTax invariants hold across a range of inputs", () => {
+  for (const gross of [0, 1, 7, 99, 1001, 123457]) {
+    for (const d of [0, 1, 333, 5000, 9999, 10000]) {
+      for (const t of [0, 1, 825, 10000]) {
+        const r = applyDiscountAndTax(gross, d, t);
+        assert.equal(r.subtotalCents + r.discountCents, gross);
+        assert.equal(r.totalCents, r.subtotalCents + r.taxCents);
+        assert.ok(r.discountCents >= 0 && r.subtotalCents >= 0 && r.taxCents >= 0);
