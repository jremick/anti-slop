+  assert.throws(() => calculateBookingPrice(room, 30, { discountBps: -1 }), ValidationError);
+  assert.throws(() => calculateBookingPrice(room, 30, { discountBps: 10001 }), ValidationError);
+});
+
+test("applyDiscountAndTax computes exact half-up discount, net subtotal, tax, and total", () => {
+  // Tie case for discount: 101 * 500 / 10000 = 5.05 -> 5; 100 * 50 / 10000 = 0.5 -> 1
+  const tieDiscount = applyDiscountAndTax(100, 50, 1000);
+  assert.deepEqual(tieDiscount, {
+    discountCents: 1,
+    subtotalCents: 99,
+    taxCents: 10, // 99 * 1000 / 10000 = 9.9 -> 10
+    totalCents: 109,
+  });
+
+  // Exact half-up tax tie: subtotal = 200, taxBps = 25 -> 200 * 25 / 10000 = 0.5 -> 1
