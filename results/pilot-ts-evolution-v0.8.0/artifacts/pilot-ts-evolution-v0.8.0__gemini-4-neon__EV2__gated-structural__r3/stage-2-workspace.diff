+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  ValidationError,
+  applyDiscountAndTax,
+  calculateBookingPrice,
+  computeTaxCents,
+  roundHalfUpDiv,
+} from "../src/index.ts";
+import type { Room } from "../src/index.ts";
+
+test("roundHalfUpDiv computes exact integer half-up rounding across tie and non-tie cases", () => {
+  assert.equal(roundHalfUpDiv(0, 60), 0);
+  assert.equal(roundHalfUpDiv(29, 60), 0);
+  assert.equal(roundHalfUpDiv(30, 60), 1);
+  assert.equal(roundHalfUpDiv(31, 60), 1);
+  assert.equal(roundHalfUpDiv(1, 2), 1);
+  assert.equal(roundHalfUpDiv(3, 2), 2);
+  assert.equal(roundHalfUpDiv(5, 2), 3);
+  assert.equal(roundHalfUpDiv(100, 3), 33);
+  assert.equal(roundHalfUpDiv(200, 3), 67);
+  assert.equal(roundHalfUpDiv(1, 3), 0);
+  assert.equal(roundHalfUpDiv(2, 3), 1);
+});
+
+test("roundHalfUpDiv rejects non-integers, negative numerators, and non-positive denominators", () => {
+  assert.throws(() => roundHalfUpDiv(-1, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(1.5, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.NaN, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.POSITIVE_INFINITY, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, 0), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, -60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, 2.5), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, Number.NaN), ValidationError);
+});
+
+test("calculateBookingPrice supports arbitrary positive integer durations with half-up subtotal and tax", () => {
+  const room: Room = {
+    roomId: "studio_1",
+    name: "Studio 1",
+    hourlyRateCents: 101,
+    taxBps: 875,
+  };
+
+  // 101 * 30 / 60 = 50.5 -> 51 cents; tax = 51 * 875 / 10000 = 4.4625 -> 4 cents
+  const halfHour = calculateBookingPrice(room, 30);
+  assert.equal(halfHour.subtotalCents, 51);
+  assert.equal(halfHour.discountCents, 0);
+  assert.equal(halfHour.taxCents, computeTaxCents(51, 875));
+  assert.equal(halfHour.taxCents, 4);
+  assert.equal(halfHour.totalCents, 55);
+  assert.equal(halfHour.depositCents, 0);
+
+  // 101 * 90 / 60 = 151.5 -> 152 cents; tax = 152 * 875 / 10000 = 13.3 -> 13 cents
+  const ninetyMin = calculateBookingPrice(room, 90, { legacyDepositMode: true });
+  assert.equal(ninetyMin.subtotalCents, 152);
+  assert.equal(ninetyMin.taxCents, 13);
+  assert.equal(ninetyMin.totalCents, 165);
+  assert.equal(ninetyMin.depositCents, 38);
+
+  // 100 * 1 / 60 = 1.666... -> 2 cents; 100 * 20 / 60 = 33.333... -> 33 cents
+  const rate100Room: Room = {
+    roomId: "studio_2",
+    name: "Studio 2",
+    hourlyRateCents: 100,
+    taxBps: 1500,
+  };
+  const oneMin = calculateBookingPrice(rate100Room, 1);
+  assert.equal(oneMin.subtotalCents, 2);
+  assert.equal(oneMin.taxCents, 0);
+  assert.equal(oneMin.totalCents, 2);
+
+  const twentyMin = calculateBookingPrice(rate100Room, 20);
+  assert.equal(twentyMin.subtotalCents, 33);
+  // 33 * 1500 / 10000 = 4.95 -> 5 cents
+  assert.equal(twentyMin.taxCents, 5);
+  assert.equal(twentyMin.totalCents, 38);
+});
+
+test("calculateBookingPrice rejects invalid durations and rates", () => {
+  const room: Room = {
+    roomId: "studio_3",
+    name: "Studio 3",
+    hourlyRateCents: 5000,
+    taxBps: 500,
+  };
+  assert.throws(() => calculateBookingPrice(room, 0), ValidationError);
+  assert.throws(() => calculateBookingPrice(room, -15), ValidationError);
+  assert.throws(() => calculateBookingPrice(room, 45.5), ValidationError);
