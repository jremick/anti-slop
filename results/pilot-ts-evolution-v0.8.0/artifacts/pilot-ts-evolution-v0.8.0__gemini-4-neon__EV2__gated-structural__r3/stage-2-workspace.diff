+import { ConflictError, ValidationError } from "./models.ts";
+import type { Booking } from "./models.ts";
+import { validateBps } from "./pricing.ts";
+import {
+  isBookingActiveAt,
+  slotsOverlap,
+  validateBookingRequestWindow,
+} from "./bookings.ts";
+import type { BookingService, ValidatedBookingWindow } from "./bookings.ts";
+
+export interface CreateGroupBookingInput {
+  readonly customerId: string;
+  readonly roomIds: readonly string[];
+  readonly startMinute: number;
+  readonly endMinute: number;
+  readonly discountBps: number;
+  readonly nowMinute?: number;
+}
+
+export interface GroupBookingResult {
+  readonly groupId: string;
+  readonly bookings: Booking[];
+  readonly subtotalCents: number;
+  readonly discountCents: number;
+  readonly taxCents: number;
+  readonly totalCents: number;
+}
+
+function validateGroupRoomIds(
+  service: BookingService,
+  roomIds: readonly string[],
+): void {
+  if (!Array.isArray(roomIds) || roomIds.length < 2) {
+    throw new ValidationError("roomIds must contain at least 2 rooms");
+  }
+  const seenRoomIds = new Set<string>();
+  for (const roomId of roomIds) {
+    if (typeof roomId !== "string" || roomId.trim() === "") {
+      throw new ValidationError("roomIds must contain non-empty roomId strings");
+    }
+    if (seenRoomIds.has(roomId)) {
+      throw new ValidationError(`Duplicate roomId in group booking: ${roomId}`);
+    }
+    seenRoomIds.add(roomId);
+  }
+  for (const roomId of roomIds) {
+    service.getRoom(roomId);
+  }
+}
+
+function assertNoGroupConflicts(
+  service: BookingService,
+  roomIds: readonly string[],
+  window: ValidatedBookingWindow,
+): void {
+  for (const roomId of roomIds) {
+    for (const existing of service.listRoomBookings(roomId)) {
+      if (
+        isBookingActiveAt(existing, window.nowMinute) &&
+        slotsOverlap(
+          existing.startMinute,
+          existing.endMinute,
+          window.startMinute,
+          window.endMinute,
+        )
+      ) {
+        throw new ConflictError(
+          `Room ${roomId} already has an active booking (${existing.bookingId}) overlapping [${window.startMinute}, ${window.endMinute})`,
+        );
+      }
+    }
+  }
+}
+
+function commitGroupBookings(
+  service: BookingService,
+  roomIds: readonly string[],
+  window: ValidatedBookingWindow,
+  discountBps: number,
+  groupId: string,
+): GroupBookingResult {
+  const bookings: Booking[] = [];
+  let subtotalCents = 0;
+  let discountCents = 0;
+  let taxCents = 0;
+  let totalCents = 0;
+
+  for (const roomId of roomIds) {
+    const booking = service.createBooking({
+      roomId,
+      customerId: window.customerId,
+      startMinute: window.startMinute,
+      endMinute: window.endMinute,
+      nowMinute: window.nowMinute,
+      discountBps,
+      groupId,
+    });
+    bookings.push(booking);
+    subtotalCents += booking.subtotalCents;
+    discountCents += booking.discountCents;
+    taxCents += booking.taxCents;
+    totalCents += booking.totalCents;
+  }
+
+  return {
+    groupId,
+    bookings,
+    subtotalCents,
+    discountCents,
+    taxCents,
+    totalCents,
+  };
+}
+
+export function createGroupBooking(
+  service: BookingService,
+  input: CreateGroupBookingInput,
+): GroupBookingResult {
+  const window = validateBookingRequestWindow(input);
+  validateBps(input.discountBps, "discountBps");
+  validateGroupRoomIds(service, input.roomIds);
+  assertNoGroupConflicts(service, input.roomIds, window);
+
+  const groupId = service.allocateGroupId();
+  return commitGroupBookings(
+    service,
+    input.roomIds,
+    window,
+    input.discountBps,
+    groupId,
+  );
+}

