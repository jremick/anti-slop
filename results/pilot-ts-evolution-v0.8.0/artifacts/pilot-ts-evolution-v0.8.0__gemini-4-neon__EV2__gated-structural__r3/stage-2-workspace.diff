+    discountCents: 12345,
+    subtotalCents: 0,
+    taxCents: 0,
+    totalCents: 0,
+  });
+
+  // Bounds validation
+  assert.throws(() => applyDiscountAndTax(-1, 0, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, -1, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, 10001, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, 0, -1), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, 0, 10001), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100, 10.5, 0), ValidationError);
+});
+
+test("calculateBookingPrice applies optional discountBps via applyDiscountAndTax", () => {
+  const room: Room = {
+    roomId: "studio_d",
+    name: "Studio D",
+    hourlyRateCents: 10000,
+    taxBps: 825,
+  };
+  const priced = calculateBookingPrice(room, 90, {
+    discountBps: 1500,
+    legacyDepositMode: true,
+  });
+  // gross = 15000, discount = 2250, subtotal = 12750, tax = 1052, total = 13802
+  // legacy deposit = roundHalfUpDiv(12750 * 2500, 10000) = 3187.5 -> 3188
+  assert.deepEqual(priced, {
+    subtotalCents: 12750,
+    discountCents: 2250,
+    taxCents: 1052,
+    totalCents: 13802,
+    depositCents: 3188,
+  });
+});
