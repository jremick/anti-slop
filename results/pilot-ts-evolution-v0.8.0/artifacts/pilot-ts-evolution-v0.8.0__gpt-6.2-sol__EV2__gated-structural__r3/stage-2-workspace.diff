+import test from "node:test";
+import assert from "node:assert/strict";
+import { BookingService, ConflictError, ValidationError, createGroupBooking } from "../src/index.ts";
+
+const groupInput = {
+  customerId: "corp_1",
+  roomIds: ["studio", "conference"],
+  startMinute: 60,
+  endMinute: 90,
+  discountBps: 5000,
+};
+
+function makeService(): BookingService {
+  const service = new BookingService({ env: {} });
+  service.registerRoom({ roomId: "studio", name: "Studio", hourlyRateCents: 201, taxBps: 5000 });
+  service.registerRoom({
+    roomId: "conference",
+    name: "Conference",
+    hourlyRateCents: 205,
+    taxBps: 2500,
+  });
+  return service;
+}
+
+test("a group stores confirmed bookings with a shared ID and sums each room's rounded price", () => {
+  const service = makeService();
+  const { groupId, bookings, ...totals } = createGroupBooking(service, groupInput);
+
+  assert.ok(groupId);
+  assert.deepEqual(totals, {
+    subtotalCents: 101,
+    discountCents: 103,
+    taxCents: 38,
+    totalCents: 139,
+  });
+  assert.deepEqual(
+    bookings.map(({ roomId, subtotalCents, discountCents, taxCents, totalCents }) => ({
+      roomId, subtotalCents, discountCents, taxCents, totalCents,
+    })),
+    [
+      { roomId: "studio", subtotalCents: 50, discountCents: 51, taxCents: 25, totalCents: 75 },
+      { roomId: "conference", subtotalCents: 51, discountCents: 52, taxCents: 13, totalCents: 64 },
+    ],
+  );
+  for (const booking of bookings) {
+    assert.equal(booking.groupId, groupId);
+    assert.equal(booking.customerId, groupInput.customerId);
+    assert.equal(booking.startMinute, groupInput.startMinute);
+    assert.equal(booking.endMinute, groupInput.endMinute);
+    assert.equal(booking.status, "confirmed");
+    assert.deepEqual(service.getBooking(booking.bookingId), booking);
+    assert.deepEqual(service.listRoomBookings(booking.roomId), [booking]);
+  }
+  const adjacent = createGroupBooking(service, { ...groupInput, startMinute: 90, endMinute: 91 });
+  assert.notEqual(adjacent.groupId, groupId);
+});
+
+test("a conflict in the second room leaves both rooms untouched and can be retried at expiry", () => {
+  const service = makeService();
+  const hold = service.createBooking({
+    roomId: "conference",
+    customerId: "cust_1",
+    startMinute: 89,
+    endMinute: 100,
+    holdMinutes: 5,
+  });
+
+  assert.throws(() => createGroupBooking(service, groupInput), ConflictError);
+  assert.throws(() => createGroupBooking(service, { ...groupInput, nowMinute: 4 }), ConflictError);
+  assert.deepEqual(service.listRoomBookings("studio"), []);
+  assert.deepEqual(service.listRoomBookings("conference"), [hold]);
+
+  const group = createGroupBooking(service, { ...groupInput, nowMinute: 5 });
+  assert.equal(group.bookings.length, 2);
+  assert.throws(() => service.createBooking({
+    roomId: "studio",
+    customerId: "cust_1",
+    startMinute: 60,
+    endMinute: 90,
+    nowMinute: 5,
+  }), ConflictError);
+});
+
+test("invalid group room lists, discounts, customers and slots leave no bookings", () => {
+  const service = makeService();
+  for (const roomIds of [[], ["studio"], ["studio", "studio"], ["studio", "missing"]]) {
+    assert.throws(() => createGroupBooking(service, { ...groupInput, roomIds }), ValidationError);
+  }
+  for (const discountBps of [-1, 0.5, 10001, Infinity, NaN]) {
+    assert.throws(() => createGroupBooking(service, { ...groupInput, discountBps }), ValidationError);
+  }
+  assert.throws(() => createGroupBooking(service, { ...groupInput, customerId: " " }), ValidationError);
+  assert.throws(() => createGroupBooking(service, { ...groupInput, endMinute: 60 }), ValidationError);
+  assert.deepEqual(service.listRoomBookings("studio"), []);
+  assert.deepEqual(service.listRoomBookings("conference"), []);
+});

