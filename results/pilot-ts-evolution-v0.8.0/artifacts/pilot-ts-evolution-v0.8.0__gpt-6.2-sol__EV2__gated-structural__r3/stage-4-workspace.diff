+  assert.deepEqual(service.listRoomBookings("conference"), [hold]);
+
+  const group = createGroupBooking(service, { ...groupInput, nowMinute: 5 });
+  assert.equal(group.bookings.length, 2);
+  assert.throws(() => service.createBooking({
+    roomId: "studio",
+    customerId: "cust_1",
+    startMinute: 60,
+    endMinute: 90,
+    nowMinute: 5,
+  }), ConflictError);
+});
