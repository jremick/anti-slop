+  assert.throws(() => createGroupBooking(service, { ...groupInput, customerId: " " }), ValidationError);
+  assert.throws(() => createGroupBooking(service, { ...groupInput, endMinute: 60 }), ValidationError);
+  assert.deepEqual(service.listRoomBookings("studio"), []);
+  assert.deepEqual(service.listRoomBookings("conference"), []);
+});

