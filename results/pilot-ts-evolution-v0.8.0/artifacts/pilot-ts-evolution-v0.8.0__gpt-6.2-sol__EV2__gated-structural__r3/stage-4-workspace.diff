+
+function readCancellationInteger(value: unknown, field: keyof CancellationFeeConfig): number {
+  if (typeof value !== "number" || !Number.isInteger(value) || value < 0) {
+    throw new ConfigError(`${CANCELLATION_FEE_ENV}.${field} must be a non-negative integer`);
+  }
+  return value;
+}
+
+export function loadCancellationFeeConfig(
+  env: BookingEnvironment = getBookingEnvironment(),
+): CancellationFeeConfig {
+  const raw = env[CANCELLATION_FEE_ENV];
+  if (raw === undefined || raw.trim() === "") {
+    throw new ConfigError(`${CANCELLATION_FEE_ENV} is required`);
+  }
+
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(raw);
+  } catch {
+    throw new ConfigError(`${CANCELLATION_FEE_ENV} must be valid JSON`);
+  }
+  if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) {
+    throw new ConfigError(`${CANCELLATION_FEE_ENV} must be a JSON object`);
+  }
+
+  const fields = parsed as Partial<Record<keyof CancellationFeeConfig, unknown>>;
+  const cutoffMinutes = readCancellationInteger(fields.cutoffMinutes, "cutoffMinutes");
+  const earlyFeeBps = readCancellationInteger(fields.earlyFeeBps, "earlyFeeBps");
+  const lateFeeBps = readCancellationInteger(fields.lateFeeBps, "lateFeeBps");
+  if (earlyFeeBps > 10000 || lateFeeBps > 10000) {
+    throw new ConfigError(`${CANCELLATION_FEE_ENV} fee rates cannot exceed 10000 basis points`);
+  }
+  return { cutoffMinutes, earlyFeeBps, lateFeeBps };
+}
+
+export function selectCancellationFeeBps(
+  minutesBeforeStart: number,
+  cfg: CancellationFeeConfig,
+): number {
+  return minutesBeforeStart >= cfg.cutoffMinutes ? cfg.earlyFeeBps : cfg.lateFeeBps;
+}

