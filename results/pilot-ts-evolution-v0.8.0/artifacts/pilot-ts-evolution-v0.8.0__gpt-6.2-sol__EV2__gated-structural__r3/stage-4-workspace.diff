+test("cancellation tiers use the early fee at the cutoff and accept zero and full rates", () => {
+  const config = loadCancellationFeeConfig({ [feeKey]: JSON.stringify(tiers) });
+  assert.deepEqual(config, tiers);
+  assert.equal(selectCancellationFeeBps(31, config), 1000);
+  assert.equal(selectCancellationFeeBps(30, config), 1000);
+  assert.equal(selectCancellationFeeBps(29, config), 5000);
+
+  const boundaryConfig = loadCancellationFeeConfig({
+    [feeKey]: '{"cutoffMinutes":0,"earlyFeeBps":0,"lateFeeBps":10000}',
+  });
+  assert.equal(selectCancellationFeeBps(0, boundaryConfig), 0);
+});
+
+test("cancellation refunds round the fee half up and support zero and full fees", () => {
+  assert.deepEqual(computeCancellationRefund(105, 5000), { feeCents: 53, refundCents: 52 });
+  assert.deepEqual(computeCancellationRefund(105, 0), { feeCents: 0, refundCents: 105 });
+  assert.deepEqual(computeCancellationRefund(105, 10000), { feeCents: 105, refundCents: 0 });
+  for (const feeBps of [-1, 0.5, 10001]) {
+    assert.throws(() => computeCancellationRefund(105, feeBps), ValidationError);
+  }
+  assert.throws(() => computeCancellationRefund(-1, 0), ValidationError);
+});
+
+test("cancellation selects the fee by time and immediately releases the room", () => {
+  for (const [nowMinute, feeBps, feeCents, refundCents] of [
+    [29, 1000, 11, 94],
+    [30, 1000, 11, 94],
+    [31, 5000, 53, 52],
+    [60, 5000, 53, 52],
+  ]) {
+    const service = makeService({ [feeKey]: JSON.stringify(tiers) });
+    const booking = service.createBooking(slot);
+    assert.throws(() => service.createBooking({ ...slot, nowMinute }), ConflictError);
+
+    const result = service.cancelBooking(booking.bookingId, nowMinute);
+    assert.deepEqual(result, {
+      booking: { ...booking, status: "cancelled" },
+      feeBps,
+      feeCents,
+      refundCents,
+    });
+    assert.deepEqual(service.getBooking(booking.bookingId), result.booking);
+    assert.equal(isBookingActiveAt(result.booking, nowMinute), false);
+    const replacement = service.createBooking({ ...slot, nowMinute });
+    assert.equal(replacement.status, "confirmed");
+    assert.notEqual(replacement.bookingId, booking.bookingId);
+  }
+});
+
+test("missing or invalid cancellation configuration leaves a booking active", () => {
+  const invalidValues = [
+    undefined,
+    "",
+    "   ",
+    "{",
+    "null",
+    "[]",
+    "42",
+    "{}",
