+    JSON.stringify({ ...tiers, cutoffMinutes: 0.5 }),
+    JSON.stringify({ ...tiers, earlyFeeBps: -1 }),
+    JSON.stringify({ ...tiers, earlyFeeBps: 10001 }),
+    JSON.stringify({ ...tiers, lateFeeBps: 0.5 }),
+    JSON.stringify({ ...tiers, lateFeeBps: 10001 }),
+    JSON.stringify({ ...tiers, lateFeeBps: "5000" }),
+    JSON.stringify({ cutoffMinutes: 30, earlyFeeBps: 1000 }),
+  ];
+  for (const raw of invalidValues) {
+    const env = raw === undefined ? {} : { [feeKey]: raw };
+    const service = makeService(env);
+    const booking = service.createBooking(slot);
+
+    assert.throws(() => loadCancellationFeeConfig(env), ConfigError);
+    assert.throws(() => service.cancelBooking(booking.bookingId, 30), ConfigError);
+    assert.deepEqual(service.getBooking(booking.bookingId), booking);
+    assert.throws(() => service.createBooking({ ...slot, nowMinute: 30 }), ConflictError);
+
+    env[feeKey] = JSON.stringify(tiers);
+    assert.equal(service.cancelBooking(booking.bookingId, 30).booking.status, "cancelled");
+  }
+});
+
+test("unknown, started, and already cancelled bookings reject cancellation", () => {
+  const service = makeService({ [feeKey]: JSON.stringify(tiers) });
+  const booking = service.createBooking(slot);
+  assert.throws(() => service.cancelBooking("missing", 30), ValidationError);
+  assert.throws(() => service.cancelBooking(booking.bookingId, 61), ValidationError);
+  assert.deepEqual(service.getBooking(booking.bookingId), booking);
+
+  const { booking: cancelled } = service.cancelBooking(booking.bookingId, 60);
+  assert.throws(() => service.cancelBooking(booking.bookingId, 60), ValidationError);
+  assert.deepEqual(service.getBooking(booking.bookingId), cancelled);
+});

