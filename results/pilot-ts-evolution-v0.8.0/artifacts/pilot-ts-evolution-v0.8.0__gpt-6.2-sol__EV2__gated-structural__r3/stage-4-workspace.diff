+import test from "node:test";
+import assert from "node:assert/strict";
+import * as api from "../src/index.ts";
+import * as pricing from "../src/pricing.ts";
+import {
+  ValidationError,
+  applyDiscountAndTax,
+  calculateBookingPrice,
+  roundHalfUpDiv,
+} from "../src/index.ts";
+
+test("pricing and the public API have no deposit exports", () => {
+  for (const exports of [api, pricing]) {
+    assert.deepEqual(Object.keys(exports).filter((name) => /deposit/i.test(name)), []);
+  }
+});
+
+test("integer division rounds below, at, and above a half up at the tie", () => {
+  assert.equal(roundHalfUpDiv(0, 60), 0);
+  assert.equal(roundHalfUpDiv(89, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2);
+  assert.equal(roundHalfUpDiv(91, 60), 2);
+  assert.equal(roundHalfUpDiv(4, 3), 1);
+  assert.equal(roundHalfUpDiv(5, 3), 2);
+  assert.equal(roundHalfUpDiv(5, 1), 5);
+});
+
+test("integer division rejects invalid numerators and denominators", () => {
+  for (const numerator of [-1, 0.5, Infinity, NaN]) {
+    assert.throws(() => roundHalfUpDiv(numerator, 60), ValidationError);
+  }
+  for (const denominator of [0, -1, 0.5, Infinity, NaN]) {
+    assert.throws(() => roundHalfUpDiv(1, denominator), ValidationError);
+  }
+});
+
+test("minute pricing rounds the gross subtotal before discount and tax", () => {
+  const room = {
+    roomId: "studio",
+    name: "Studio",
+    hourlyRateCents: 201,
+    taxBps: 5000,
+  };
+
+  assert.deepEqual(calculateBookingPrice(room, 30), {
+    subtotalCents: 101,
+    discountCents: 0,
+    taxCents: 51,
+    totalCents: 152,
+  });
+  assert.deepEqual(calculateBookingPrice(room, 1), {
+    subtotalCents: 3,
+    discountCents: 0,
+    taxCents: 2,
+    totalCents: 5,
+  });
+  assert.deepEqual(calculateBookingPrice(room, 30, { discountBps: 5000 }), {
+    subtotalCents: 50,
+    discountCents: 51,
+    taxCents: 25,
+    totalCents: 75,
+  });
+  for (const durationMinutes of [0, -1, 1.5]) {
+    assert.throws(() => calculateBookingPrice(room, durationMinutes), ValidationError);
+  }
+});
+
+test("discount rounds half up before tax is applied to the net subtotal", () => {
+  assert.deepEqual(applyDiscountAndTax(101, 5000, 2500), {
+    subtotalCents: 50,
+    discountCents: 51,
+    taxCents: 13,
+    totalCents: 63,
+  });
+  assert.deepEqual(applyDiscountAndTax(101, 10000, 10000), {
+    subtotalCents: 0,
+    discountCents: 101,
+    taxCents: 0,
+    totalCents: 0,
+  });
+  assert.deepEqual(applyDiscountAndTax(101, 0, 0), {
+    subtotalCents: 101,
+    discountCents: 0,
+    taxCents: 0,
+    totalCents: 101,
+  });
+});
+
+test("discount and tax reject invalid rates and gross subtotals", () => {
+  for (const bps of [-1, 1.5, 10001, Infinity, NaN]) {
+    assert.throws(() => applyDiscountAndTax(101, bps, 0), ValidationError);
+    assert.throws(() => applyDiscountAndTax(101, 0, bps), ValidationError);
+  }
+  for (const grossCents of [-1, 1.5, Infinity, NaN]) {
+    assert.throws(() => applyDiscountAndTax(grossCents, 0, 0), ValidationError);
+  }
+});
