+import test from "node:test";
+import assert from "node:assert/strict";
+import { BookingService, ConflictError, ValidationError, createGroupBooking } from "../src/index.ts";
+import type { BookingNotification } from "../src/index.ts";
+
+const slot = { roomId: "studio", customerId: "cust_1", startMinute: 60, endMinute: 90 };
+const group = {
+  roomIds: ["studio", "conference"],
+  customerId: "corp_1",
+  startMinute: 60,
+  endMinute: 90,
+  discountBps: 5000,
+};
+
+function makeService(notifyHook: (event: BookingNotification) => void): BookingService {
+  const service = new BookingService({
+    env: {
+      BOOKING_CANCEL_FEE_TIERS_JSON: '{"cutoffMinutes":30,"earlyFeeBps":1000,"lateFeeBps":5000}',
+    },
+    notifyHook,
+  });
+  service.registerRoom({ roomId: "studio", name: "Studio", hourlyRateCents: 200, taxBps: 500 });
+  service.registerRoom({
+    roomId: "conference",
+    name: "Conference",
+    hourlyRateCents: 400,
+    taxBps: 1000,
+  });
+  return service;
+}
+
+test("notifications contain exact creation totals and cancellation refunds", () => {
+  const events: BookingNotification[] = [];
+  const service = makeService((event) => events.push(event));
+  const hold = service.createBooking({ ...slot, holdMinutes: 5 });
+  service.confirmHold(hold.bookingId, 4);
+  service.cancelBooking(hold.bookingId, 30);
+  const { bookings } = createGroupBooking(service, group);
+
+  assert.deepEqual(events, [
+    {
+      event: "booking_created",
+      bookingId: hold.bookingId,
+      roomId: "studio",
+      customerId: "cust_1",
+      amountCents: 105,
+    },
+    {
+      event: "booking_cancelled",
+      bookingId: hold.bookingId,
+      roomId: "studio",
+      customerId: "cust_1",
+      amountCents: 94,
+    },
+    {
+      event: "booking_created",
+      bookingId: bookings[0].bookingId,
+      roomId: "studio",
+      customerId: "corp_1",
+      amountCents: 53,
+    },
+    {
+      event: "booking_created",
+      bookingId: bookings[1].bookingId,
+      roomId: "conference",
+      customerId: "corp_1",
+      amountCents: 110,
+    },
+  ]);
+});
+
+test("a failed single creation propagates the hook error and permits retry", () => {
+  const failure = new Error("creation notification failed");
+  let rejectCreation = true;
+  const service = makeService(() => {
+    if (rejectCreation) {
+      throw failure;
+    }
+  });
+
+  assert.throws(() => service.createBooking(slot), (error) => error === failure);
+  assert.deepEqual(service.listRoomBookings("studio"), []);
+
+  rejectCreation = false;
+  const booking = service.createBooking(slot);
+  assert.deepEqual(service.listRoomBookings("studio"), [booking]);
+});
+
+test("failure on a later group notification leaves every proposed booking uncommitted", () => {
+  const failure = new Error("second room notification failed");
+  const events: BookingNotification[] = [];
+  let rejectConference = true;
+  const service = makeService((event) => {
+    events.push(event);
+    if (rejectConference && event.roomId === "conference") {
+      assert.deepEqual(service.listRoomBookings("studio"), [existing]);
+      throw failure;
+    }
+  });
+  const existing = service.createBooking({ ...slot, startMinute: 30, endMinute: 60 });
+  events.length = 0;
+
+  assert.throws(() => createGroupBooking(service, group), (error) => error === failure);
+  assert.deepEqual(events.map((event) => event.roomId), group.roomIds);
+  for (const event of events) {
+    assert.throws(() => service.getBooking(event.bookingId), ValidationError);
+  }
+  assert.deepEqual(service.listRoomBookings("studio"), [existing]);
+  assert.deepEqual(service.listRoomBookings("conference"), []);
+
+  rejectConference = false;
+  const { bookings } = createGroupBooking(service, group);
+  assert.deepEqual(service.listRoomBookings("studio"), [existing, bookings[0]]);
+  assert.deepEqual(service.listRoomBookings("conference"), [bookings[1]]);
+});
+
+test("a failed cancellation preserves the booking and its conflict until a successful retry", () => {
+  const failure = new Error("cancellation notification failed");
+  let rejectCancellation = true;
+  const service = makeService((event) => {
+    if (rejectCancellation && event.event === "booking_cancelled") {
+      throw failure;
+    }
+  });
+  const booking = service.createBooking(slot);
+
+  assert.throws(() => service.cancelBooking(booking.bookingId, 30), (error) => error === failure);
+  assert.deepEqual(service.getBooking(booking.bookingId), booking);
+  assert.throws(() => service.createBooking(slot), ConflictError);
+
+  rejectCancellation = false;
+  const result = service.cancelBooking(booking.bookingId, 30);
+  assert.equal(result.booking.status, "cancelled");
+  assert.equal(result.refundCents, 94);
+  assert.equal(service.createBooking(slot).status, "confirmed");
+});
+
+test("a notification cannot re-enter the service to mutate bookings", () => {
+  const service = makeService(() => {
+    service.createBooking({ ...slot, roomId: "conference" });
+  });
+  assert.throws(() => service.createBooking(slot), ValidationError);
+  assert.deepEqual(service.listRoomBookings("studio"), []);
+  assert.deepEqual(service.listRoomBookings("conference"), []);
+});

