+import type { BookingService } from "./bookings.ts";
+import type { Booking, CreateGroupBookingInput, PriceBreakdown } from "./models.ts";
+
+export interface GroupBookingResult extends PriceBreakdown {
+  readonly groupId: string;
+  readonly bookings: Booking[];
+}
+
+export function createGroupBooking(
+  service: BookingService,
+  input: CreateGroupBookingInput,
+): GroupBookingResult {
+  const { groupId, bookings } = service.createGroupedBookings(input);
+  let subtotalCents = 0;
+  let discountCents = 0;
+  let taxCents = 0;
+  let totalCents = 0;
+
+  for (const booking of bookings) {
+    subtotalCents += booking.subtotalCents;
+    discountCents += booking.discountCents;
+    taxCents += booking.taxCents;
+    totalCents += booking.totalCents;
+  }
+  return { groupId, bookings, subtotalCents, discountCents, taxCents, totalCents };
+}

