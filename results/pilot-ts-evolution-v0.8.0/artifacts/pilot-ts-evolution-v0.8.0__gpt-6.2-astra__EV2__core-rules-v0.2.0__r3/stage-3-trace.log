{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cd benchmarks/sources/ev2_ts_bookings && cat > tests/cancellation.test.ts <<'EOF'\nimport test from \\\"node:test\\\";\nimport assert from \\\"node:assert/strict\\\";\nimport {\n  BookingService, ConfigError, ConflictError, ValidationError, computeCancellationRefund,\n  loadCancellationFeeConfig, selectCancellationFeeBps,\n} from \\\"../src/index.ts\\\";\n\nconst tiers = { cutoffMinutes: 30, earlyFeeBps: 2500, lateFeeBps: 5000 };\nconst slot = { roomId: \\\"hall\\\", customerId: \\\"guest\\\", startMinute: 60, endMinute: 120 };\n\nfunction setup(raw: string | undefined) {\n  const env = { BOOKING_CANCEL_FEE_TIERS_JSON: raw };\n  const service = new BookingService({ env });\n  service.registerRoom({ roomId: \\\"hall\\\", name: \\\"Hall\\\", hourlyRateCents: 100, taxBps: 100 });\n  const booking = service.createBooking(slot);\n  return { service, booking, env };\n}\n\ntest(\\\"cancellation uses the tax-inclusive total and switches tiers strictly below the cutoff\\\", () => {\n  for (const [nowMinute, feeBps, feeCents, refundCents] of [\n    [29, 2500, 25, 76], [30, 2500, 25, 76], [31, 5000, 51, 50], [60, 5000, 51, 50],\n  ]) {\n    const { service, booking } = setup(JSON.stringify(tiers));\n    const result = service.cancelBooking(booking.bookingId, nowMinute);\n    assert.deepEqual(result, { booking: { ...booking, status: \\\"cancelled\\\" }, feeBps, feeCents, refundCents });\n    assert.deepEqual(service.getBooking(booking.bookingId), result.booking);\n    assert.throws(() => service.cancelBooking(booking.bookingId, nowMinute), ValidationError);\n    assert.equal(service.createBooking({ ...slot, nowMinute }).status, \\\"confirmed\\\");\n  }\n});\n\ntest(\\\"invalid or missing cancellation settings keep the slot reserved until a valid retry\\\", () => {\n  const invalid = [\n    undefined, \\\"\\\", \\\"  \\\", \\\"{\\\", \\\"null\\\", \\\"[]\\\", \\\"42\\\", '\\\"tiers\\\"', \\\"{}\\\",\n    ...[\\\"cutoffMinutes\\\", \\\"earlyFeeBps\\\", \\\"lateFeeBps\\\"].flatMap(field =>\n      [undefined, null, \\\"1\\\", -1, 0.5].map(value => JSON.stringify({ ...tiers, [field]: value }))\n    ),\n    JSON.stringify({ ...tiers, earlyFeeBps: 10001 }), JSON.stringify({ ...tiers, lateFeeBps: 10001 }),\n  ];\n  for (const raw of invalid) {\n    const { service, booking, env } = setup(raw);\n    assert.throws(() => service.cancelBooking(booking.bookingId, 0), ConfigError);\n    assert.equal(service.getBooking(booking.bookingId).status, \\\"confirmed\\\");\n    assert.throws(() => service.createBooking(slot), ConflictError);\n    env.BOOKING_CANCEL_FEE_TIERS_JSON = JSON.stringify(tiers);\n    assert.equal(service.cancelBooking(booking.bookingId, 0).refundCents, 76);\n  }\n});\n\ntest(\\\"unknown bookings and cancellations after start fail before fee configuration is needed\\\", () => {\n  const { service, booking } = setup(undefined);\n  assert.throws(() => service.cancelBooking(\\\"missing\\\", 0), ValidationError);\n  assert.throws(() => service.cancelBooking(booking.bookingId, slot.startMinute + 1), ValidationError);\n  assert.equal(service.getBooking(booking.bookingId).status, \\\"confirmed\\\");\n});\n\ntest(\\\"zero cutoff and both fee bounds are valid, and refund arithmetic rejects invalid inputs\\\", () => {\n  const cfg = { cutoffMinutes: 0, earlyFeeBps: 0, lateFeeBps: 10000 };\n  assert.deepEqual(loadCancellationFeeConfig({ BOOKING_CANCEL_FEE_TIERS_JSON: JSON.stringify(cfg) }), cfg);\n  assert.equal(selectCancellationFeeBps(0, cfg), 0);\n  assert.deepEqual(computeCancellationRefund(101, 0), { feeCents: 0, refundCents: 101 });\n  assert.deepEqual(computeCancellationRefund(101, 10000), { feeCents: 101, refundCents: 0 });\n  for (const [total, fee] of [[-1, 0], [0.5, 0], [100, -1], [100, 10001], [100, 0.5]]) {\n    assert.throws(() => computeCancellationRefund(total, fee), ValidationError);\n  }\n});\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
