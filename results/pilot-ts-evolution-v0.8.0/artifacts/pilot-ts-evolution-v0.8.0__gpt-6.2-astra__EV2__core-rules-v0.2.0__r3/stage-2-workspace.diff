+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService, ConflictError, ValidationError, applyDiscountAndTax, createGroupBooking,
+} from "../src/index.ts";
+
+const input = {
+  customerId: "company", roomIds: ["a", "b"], startMinute: 60, endMinute: 90, discountBps: 5000,
+};
+
+function setup(): BookingService {
+  const service = new BookingService({ env: {} });
+  service.registerRoom({ roomId: "a", name: "Studio", hourlyRateCents: 202, taxBps: 1000 });
+  service.registerRoom({ roomId: "b", name: "Hall", hourlyRateCents: 206, taxBps: 5000 });
+  return service;
+}
+
+test("group totals sum each room's separately rounded discount and tax", () => {
+  const service = setup();
+  const { groupId, bookings, ...totals } = createGroupBooking(service, input);
+  assert.ok(groupId);
+  assert.deepEqual(totals, { subtotalCents: 101, discountCents: 103, taxCents: 31, totalCents: 132 });
+  assert.deepEqual(bookings.map(b => [b.roomId, b.subtotalCents, b.discountCents, b.taxCents, b.totalCents]), [
+    ["a", 50, 51, 5, 55],
+    ["b", 51, 52, 26, 77],
+  ]);
+  for (const booking of bookings) {
+    assert.equal(booking.status, "confirmed");
+    assert.equal(booking.groupId, groupId);
+    assert.deepEqual(service.listRoomBookings(booking.roomId), [booking]);
+  }
+  const next = createGroupBooking(service, { ...input, startMinute: 90, endMinute: 120, discountBps: 10000 });
+  assert.notEqual(next.groupId, groupId);
+  assert.equal(next.totalCents, 0);
+});
+
+test("a hold in the last requested room blocks the entire group until exact expiry", () => {
+  const service = setup();
+  const hold = service.createBooking({
+    customerId: "other", roomId: "b", startMinute: 89, endMinute: 100, nowMinute: 8, holdMinutes: 2,
+  });
+  assert.throws(() => createGroupBooking(service, { ...input, nowMinute: 9 }), ConflictError);
+  assert.deepEqual(service.listRoomBookings("a"), []);
+  assert.deepEqual(service.listRoomBookings("b"), [hold]);
+  assert.equal(createGroupBooking(service, { ...input, nowMinute: 10 }).bookings.length, 2);
+});
+
+test("invalid group requests leave all rooms free", () => {
+  const service = setup();
+  for (const changes of [
+    { roomIds: [] }, { roomIds: ["a"] }, { roomIds: ["a", "a"] }, { roomIds: ["a", "missing"] },
+    { discountBps: -1 }, { discountBps: 1.5 }, { discountBps: 10001 },
+    { customerId: " " }, { nowMinute: -1 }, { endMinute: input.startMinute },
+  ]) {
+    assert.throws(() => createGroupBooking(service, { ...input, ...changes }), ValidationError);
+    assert.deepEqual(service.listRoomBookings("a"), []);
+    assert.deepEqual(service.listRoomBookings("b"), []);
+  }
+});
+
+test("discount and tax validate their inputs and accept both basis-point limits", () => {
+  for (const bad of [-1, 10001, 0.5, NaN]) {
+    assert.throws(() => applyDiscountAndTax(100, bad, 0), ValidationError);
+    assert.throws(() => applyDiscountAndTax(100, 0, bad), ValidationError);
+  }
+  for (const bad of [-1, 0.5]) {
+    assert.throws(() => applyDiscountAndTax(bad, 0, 0), ValidationError);
+  }
+  assert.deepEqual(applyDiscountAndTax(100, 0, 10000), {
+    subtotalCents: 100, discountCents: 0, taxCents: 100, totalCents: 200,
+  });
+  assert.deepEqual(applyDiscountAndTax(100, 10000, 0), {
+    subtotalCents: 0, discountCents: 100, taxCents: 0, totalCents: 0,
+  });
+});

