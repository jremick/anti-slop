{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cd benchmarks/sources/ev2_ts_bookings && cat > tests/notifications.test.ts <<'EOF'\nimport assert from \\\"node:assert/strict\\\";\nimport test from \\\"node:test\\\";\nimport * as api from \\\"../src/index.ts\\\";\nimport * as pricing from \\\"../src/pricing.ts\\\";\nimport type { BookingNotification } from \\\"../src/index.ts\\\";\n\nconst slot = { customerId: \\\"guest\\\", startMinute: 60, endMinute: 120 };\nconst group = { ...slot, roomIds: [\\\"A\\\", \\\"B\\\"], discountBps: 5000 };\n\nfunction setup(notifyHook: (event: BookingNotification) => void) {\n  const service = new api.BookingService({\n    notifyHook,\n    env: { BOOKING_CANCEL_FEE_TIERS_JSON: '{\\\"cutoffMinutes\\\":0,\\\"earlyFeeBps\\\":2500,\\\"lateFeeBps\\\":5000}' },\n  });\n  service.registerRoom({ roomId: \\\"A\\\", name: \\\"Studio\\\", hourlyRateCents: 200, taxBps: 1000 });\n  service.registerRoom({ roomId: \\\"B\\\", name: \\\"Hall\\\", hourlyRateCents: 300, taxBps: 0 });\n  return service;\n}\n\ntest(\\\"pricing and the public entry point expose no deposit API\\\", () => {\n  for (const module of [api, pricing]) {\n    assert.deepEqual(Object.keys(module).filter(name => /deposit/i.test(name)), []);\n  }\n});\n\ntest(\\\"held, cancelled, and group bookings emit the exact per-booking amounts\\\", () => {\n  const events: BookingNotification[] = [];\n  const service = setup(event => events.push(event));\n  const held = service.createBooking({ ...slot, roomId: \\\"A\\\", holdMinutes: 2 });\n  service.confirmHold(held.bookingId, 1);\n  service.cancelBooking(held.bookingId, 2);\n  const [first, second] = api.createGroupBooking(service, group).bookings;\n  assert.deepEqual(events, [\n    { event: \\\"booking_created\\\", bookingId: held.bookingId, roomId: \\\"A\\\", customerId: \\\"guest\\\", amountCents: 220 },\n    { event: \\\"booking_cancelled\\\", bookingId: held.bookingId, roomId: \\\"A\\\", customerId: \\\"guest\\\", amountCents: 165 },\n    { event: \\\"booking_created\\\", bookingId: first.bookingId, roomId: \\\"A\\\", customerId: \\\"guest\\\", amountCents: 110 },\n    { event: \\\"booking_created\\\", bookingId: second.bookingId, roomId: \\\"B\\\", customerId: \\\"guest\\\", amountCents: 150 },\n  ]);\n});\n\ntest(\\\"a rejected single creation or second group notification leaves all requested slots free\\\", () => {\n  const failure = new Error(\\\"notification rejected\\\");\n  let rejectRoom: string | undefined = \\\"A\\\";\n  const seen: string[] = [];\n  const service = setup(event => {\n    seen.push(event.roomId);\n    if (event.roomId === rejectRoom) throw failure;\n  });\n  assert.throws(() => service.createBooking({ ...slot, roomId: \\\"A\\\" }), err => err === failure);\n  assert.deepEqual(service.listRoomBookings(\\\"A\\\"), []);\n  rejectRoom = \\\"B\\\";\n  assert.throws(() => api.createGroupBooking(service, group), err => err === failure);\n  assert.deepEqual(seen, [\\\"A\\\", \\\"A\\\", \\\"B\\\"]);\n  assert.deepEqual(service.listRoomBookings(\\\"A\\\"), []);\n  assert.deepEqual(service.listRoomBookings(\\\"B\\\"), []);\n  rejectRoom = undefined;\n  assert.equal(api.createGroupBooking(service, group).bookings.length, 2);\n});\n\ntest(\\\"a rejected cancellation preserves the reservation and can be retried\\\", () => {\n  const failure = new Error(\\\"refund notification rejected\\\");\n  let reject = true;\n  const service = setup(event => {\n    if (reject && event.event === \\\"booking_cancelled\\\") throw failure;\n  });\n  const input = { ...slot, roomId: \\\"A\\\" };\n  const original = service.createBooking(input);\n  assert.throws(() => service.cancelBooking(original.bookingId, 0), err => err === failure);\n  assert.equal(service.getBooking(original.bookingId).status, \\\"confirmed\\\");\n  assert.throws(() => service.createBooking(input), api.ConflictError);\n  reject = false;\n  assert.equal(service.cancelBooking(original.bookingId, 0).refundCents, 165);\n  assert.equal(service.createBooking(input).status, \\\"confirmed\\\");\n});\n\ntest(\\\"a hook cannot reserve the same slot while creation is pending\\\", () => {\n  const input = { ...slot, roomId: \\\"A\\\" };\n  let calls = 0;\n  const service = setup(() => {\n    if (++calls === 1) service.createBooking(input);\n  });\n  assert.throws(() => service.createBooking(input), api.ValidationError);\n  assert.deepEqual(service.listRoomBookings(\\\"A\\\"), []);\n});\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
