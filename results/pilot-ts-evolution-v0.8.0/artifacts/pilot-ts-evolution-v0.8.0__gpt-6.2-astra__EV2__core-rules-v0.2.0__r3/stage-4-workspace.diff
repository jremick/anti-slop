+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  calculateBookingPrice,
+  isBookingActiveAt,
+  roundHalfUpDiv,
+  slotsOverlap,
+} from "../src/index.ts";
+
+const room = { roomId: "A", name: "Studio", hourlyRateCents: 101, taxBps: 5000 };
+const slot = { roomId: "A", customerId: "guest", startMinute: 100, endMinute: 130 };
+
+function setup(): BookingService {
+  const service = new BookingService({ env: { BOOKING_MAX_HOLD_MINUTES: "5" } });
+  service.registerRoom(room);
+  return service;
+}
+
+test("division rounds below, at and above a half and rejects invalid operands", () => {
+  assert.equal(roundHalfUpDiv(0, 4), 0);
+  assert.equal(roundHalfUpDiv(9, 4), 2);
+  assert.equal(roundHalfUpDiv(10, 4), 3);
+  assert.equal(roundHalfUpDiv(11, 4), 3);
+  for (const [n, d] of [[-1, 2], [1.5, 2], [1, 0], [1, -2], [1, 1.5]]) {
+    assert.throws(() => roundHalfUpDiv(n, d), ValidationError);
+  }
+});
+
+test("pricing rounds the subtotal before computing tax", () => {
+  assert.deepEqual(calculateBookingPrice(room, 30), {
+    subtotalCents: 51, discountCents: 0, taxCents: 26, totalCents: 77,
+  });
+  assert.equal(calculateBookingPrice(room, 61).subtotalCents, 103);
+  for (const duration of [0, -1, 1.5]) {
+    assert.throws(() => calculateBookingPrice(room, duration), ValidationError);
+  }
+});
+
+test("room conflicts include containment, identical slots and one-minute intersections", () => {
+  const svc = setup();
+  svc.createBooking(slot);
+  for (const [start, end] of [[100, 130], [105, 110], [90, 140], [80, 101], [129, 150]]) {
+    assert.equal(slotsOverlap(start, end, 100, 130), true);
+    assert.throws(() => svc.createBooking({ ...slot, startMinute: start, endMinute: end }), ConflictError);
+  }
+  for (const [start, end] of [[80, 100], [130, 150]]) {
+    assert.equal(slotsOverlap(start, end, 100, 130), false);
+    svc.createBooking({ ...slot, startMinute: start, endMinute: end });
+  }
+  svc.registerRoom({ ...room, roomId: "B" });
+  svc.createBooking({ ...slot, roomId: "B" });
+  assert.equal(svc.listRoomBookings("A").length, 3);
+});
+
+test("a hold blocks through the minute before expiry and releases its slot at expiry", () => {
+  const svc = setup();
+  const held = svc.createBooking({ ...slot, holdMinutes: 5, nowMinute: 20 });
+  assert.equal(held.status, "held");
+  assert.equal(held.expiresAt, 25);
+  assert.equal(isBookingActiveAt(held, 24), true);
+  assert.equal(isBookingActiveAt(held, 25), false);
+  assert.equal(isBookingActiveAt({ ...held, expiresAt: undefined }, 24), false);
+  assert.equal(isBookingActiveAt({ ...held, status: "cancelled" }, 24), false);
+  assert.throws(() => svc.createBooking({ ...slot, nowMinute: 24 }), ConflictError);
+  assert.throws(() => svc.confirmHold(held.bookingId, 25), ValidationError);
+  assert.equal(svc.createBooking({ ...slot, nowMinute: 25 }).status, "confirmed");
+});
+
+test("confirming an active hold preserves its booking and keeps the slot reserved", () => {
+  const svc = setup();
+  const held = svc.createBooking({ ...slot, holdMinutes: 5 });
+  assert.equal(held.expiresAt, 5);
+  const confirmed = svc.confirmHold(held.bookingId, 4);
+  assert.equal(confirmed.expiresAt, undefined);
+  assert.deepEqual({ ...confirmed, expiresAt: undefined }, { ...held, status: "confirmed", expiresAt: undefined });
+  assert.deepEqual(svc.listRoomBookings("A"), [confirmed]);
+  assert.equal(isBookingActiveAt(confirmed, 1000), true);
+  assert.throws(() => svc.createBooking({ ...slot, nowMinute: 1000 }), ConflictError);
+  assert.throws(() => svc.confirmHold(confirmed.bookingId, 4), ValidationError);
+  assert.throws(() => svc.confirmHold("missing", 4), ValidationError);
+});
+
+test("hold duration must be a positive integer within the configured limit", () => {
+  const svc = setup();
+  for (const holdMinutes of [0, -1, 1.5, 6]) {
+    assert.throws(() => svc.createBooking({ ...slot, holdMinutes }), ValidationError);
+  }
+  assert.deepEqual(svc.listRoomBookings("A"), []);
+});
