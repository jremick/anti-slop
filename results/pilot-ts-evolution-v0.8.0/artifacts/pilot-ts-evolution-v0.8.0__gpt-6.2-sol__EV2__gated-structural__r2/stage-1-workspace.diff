+import assert from "node:assert/strict";
+import test from "node:test";
+import { calculateBookingPrice, roundHalfUpDiv, ValidationError } from "../src/index.ts";
+
+test("integer division rounds halves up and rounds either side correctly", () => {
+  assert.equal(roundHalfUpDiv(0, 60), 0);
+  assert.equal(roundHalfUpDiv(89, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2);
+  assert.equal(roundHalfUpDiv(91, 60), 2);
+  assert.equal(roundHalfUpDiv(120, 60), 2);
+  assert.equal(roundHalfUpDiv(4, 3), 1);
+  assert.equal(roundHalfUpDiv(5, 3), 2);
+});
+
+test("integer division rejects invalid numerators and denominators", () => {
+  for (const numerator of [-1, 0.5, Infinity, NaN]) {
+    assert.throws(() => roundHalfUpDiv(numerator, 60), ValidationError);
+  }
+  for (const denominator of [0, -1, 1.5, Infinity, NaN]) {
+    assert.throws(() => roundHalfUpDiv(60, denominator), ValidationError);
+  }
+});
+
+test("partial-hour pricing rounds subtotal before calculating tax and legacy deposit", () => {
+  const room = {
+    roomId: "conf_a",
+    name: "Conference A",
+    hourlyRateCents: 90,
+    taxBps: 2500,
+  };
+
+  assert.deepEqual(calculateBookingPrice(room, 1, { legacyDepositMode: true }), {
+    subtotalCents: 2,
+    discountCents: 0,
+    taxCents: 1,
+    totalCents: 3,
+    depositCents: 1,
+  });
+  assert.equal(calculateBookingPrice(room, 61).subtotalCents, 92);
+  for (const durationMinutes of [-1, 0, 1.5, Infinity, NaN]) {
+    assert.throws(() => calculateBookingPrice(room, durationMinutes), ValidationError);
+  }
+});
