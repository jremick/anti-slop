{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"cat benchmarks/sources/ev2_ts_bookings/src/{bookings,corporate,pricing}.ts && rg -n '\"'^import|from \"'\"\\\\./' benchmarks/sources/ev2_ts_bookings/src\"","aggregated_output":"import { loadBookingConfig } from \"./config.ts\";\nimport type { BookingConfig } from \"./config.ts\";\nimport { ConflictError, ValidationError } from \"./models.ts\";\nimport type {\n  Booking,\n  BookingSlot,\n  CreateBookingInput,\n  CreateGroupBookingInput,\n  Room,\n} from \"./models.ts\";\nimport {\n  calculateBookingPrice,\n  validateBasisPoints,\n  validateNonNegativeInt,\n  validatePositiveInt,\n} from \"./pricing.ts\";\n\nexport function slotsOverlap(\n  startA: number,\n  endA: number,\n  startB: number,\n  endB: number,\n): boolean {\n  return startA < endB && startB < endA;\n}\n\nexport function isBookingActiveAt(booking: Booking, nowMinute: number): boolean {\n  return booking.status === \"confirmed\"\n    || (booking.status === \"held\" && booking.expiresAt !== undefined && nowMinute < booking.expiresAt);\n}\n\nexport interface BookingServiceOptions {\n  readonly env?: Record<string, string | undefined>;\n}\n\ntype BookingDetails = Omit<Booking, \"bookingId\" | \"groupId\">;\n\nexport class BookingService {\n  readonly config: BookingConfig;\n  private readonly rooms: Map<string, Room> = new Map();\n  private readonly bookings: Map<string, Booking> = new Map();\n  private seq = 0;\n\n  constructor(options: BookingServiceOptions = {}) {\n    this.config = loadBookingConfig(options.env);\n  }\n\n  private nextId(prefix: string): string {\n    this.seq += 1;\n    return `${prefix}_${String(this.seq).padStart(4, \"0\")}`;\n  }\n\n  registerRoom(room: Room): void {\n    if (typeof room.roomId !== \"string\" || room.roomId.trim() === \"\") {\n      throw new ValidationError(\"roomId must be a non-empty string\");\n    }\n    if (typeof room.name !== \"string\" || room.name.trim() === \"\") {\n      throw new ValidationError(\"name must be a non-empty string\");\n    }\n    validatePositiveInt(room.hourlyRateCents, \"hourlyRateCents\");\n    validateBasisPoints(room.taxBps, \"taxBps\");\n    this.rooms.set(room.roomId, room);\n  }\n\n  getRoom(roomId: string): Room {\n    const room = this.rooms.get(roomId);\n    if (room === undefined) {\n      throw new ValidationError(`Unknown roomId: ${roomId}`);\n    }\n    return room;\n  }\n\n  getBooking(bookingId: string): Booking {\n    const booking = this.bookings.get(bookingId);\n    if (booking === undefined) {\n      throw new ValidationError(`Unknown bookingId: ${bookingId}`);\n    }\n    return booking;\n  }\n\n  listRoomBookings(roomId: string): Booking[] {\n    this.getRoom(roomId);\n    const matches: Booking[] = [];\n    for (const booking of this.bookings.values()) {\n      if (booking.roomId === roomId) {\n        matches.push(booking);\n      }\n    }\n    return matches;\n  }\n\n  createBooking(input: CreateBookingInput): Booking {\n    const [details] = this.prepareBookings(input, new Set([input.roomId]), {\n      holdMinutes: input.holdMinutes,\n      legacyDepositMode: input.legacyDepositMode === true,\n    });\n    return this.commitBooking(details);\n  }\n\n  createGroupBookings(input: CreateGroupBookingInput): { groupId: string; bookings: Booking[] } {\n    if (!Array.isArray(input.roomIds) || input.roomIds.length < 2) {\n      throw new ValidationError(\"roomIds must contain at least two rooms\");\n    }\n    const roomIds = new Set(input.roomIds);\n    if (roomIds.size !== input.roomIds.length) {\n      throw new ValidationError(\"roomIds cannot contain duplicates\");\n    }\n    validateBasisPoints(input.discountBps, \"discountBps\");\n\n    const details = this.prepareBookings(input, roomIds, { discountBps: input.discountBps });\n    const groupId = this.nextId(\"grp\");\n    const bookings = details.map((booking) => this.commitBooking(booking, groupId));\n    return { groupId, bookings };\n  }\n\n  private prepareBookings(\n    input: BookingSlot,\n    roomIds: ReadonlySet<string>,\n    options: {\n      readonly holdMinutes?: number | undefined;\n      readonly legacyDepositMode?: boolean;\n      readonly discountBps?: number;\n    },\n  ): BookingDetails[] {\n    const { customerId, startMinute, endMinute, nowMinute = 0 } = input;\n    const { holdMinutes, legacyDepositMode = false, discountBps = 0 } = options;\n    if (typeof customerId !== \"string\" || customerId.trim() === \"\") {\n      throw new ValidationError(\"customerId must be a non-empty string\");\n    }\n    validateNonNegativeInt(startMinute, \"startMinute\");\n    validatePositiveInt(endMinute, \"endMinute\");\n    if (endMinute <= startMinute) {\n      throw new ValidationError(\"endMinute must be strictly greater than startMinute\");\n    }\n    if (holdMinutes !== undefined) {\n      validatePositiveInt(holdMinutes, \"holdMinutes\");\n      if (holdMinutes > this.config.maxHoldMinutes) {\n        throw new ValidationError(\"holdMinutes cannot exceed maxHoldMinutes\");\n      }\n    }\n    const rooms = Array.from(roomIds, (roomId) => this.getRoom(roomId));\n    for (const booking of this.bookings.values()) {\n      if (\n        roomIds.has(booking.roomId)\n        && isBookingActiveAt(booking, nowMinute)\n        && slotsOverlap(startMinute, endMinute, booking.startMinute, booking.endMinute)\n      ) {\n        throw new ConflictError(`Room ${booking.roomId} is already booked for the requested slot`);\n      }\n    }\n    const duration = endMinute - startMinute;\n    return rooms.map((room) => ({\n      roomId: room.roomId,\n      customerId: customerId.trim(),\n      startMinute,\n      endMinute,\n      status: holdMinutes === undefined ? \"confirmed\" : \"held\",\n      ...(holdMinutes === undefined ? {} : { expiresAt: nowMinute + holdMinutes }),\n      ...calculateBookingPrice(room, duration, { legacyDepositMode, discountBps }),\n    }));\n  }\n\n  private commitBooking(details: BookingDetails, groupId?: string): Booking {\n    const booking: Booking = {\n      ...details,\n      bookingId: this.nextId(\"bkg\"),\n      ...(groupId === undefined ? {} : { groupId }),\n    };\n    this.bookings.set(booking.bookingId, booking);\n    return booking;\n  }\n\n  confirmHold(bookingId: string, nowMinute: number): Booking {\n    const booking = this.getBooking(bookingId);\n    if (booking.status !== \"held\" || !isBookingActiveAt(booking, nowMinute)) {\n      throw new ValidationError(`Booking ${bookingId} must be an unexpired hold`);\n    }\n    const { expiresAt, ...details } = booking;\n    const confirmed: Booking = { ...details, status: \"confirmed\" };\n    this.bookings.set(bookingId, confirmed);\n    return confirmed;\n  }\n}\nimport type { BookingService } from \"./bookings.ts\";\nimport type { Booking, CreateGroupBookingInput, PriceBreakdown } from \"./models.ts\";\n\nexport interface GroupBookingResult extends Omit<PriceBreakdown, \"depositCents\"> {\n  readonly groupId: string;\n  readonly bookings: readonly Booking[];\n}\n\nexport function createGroupBooking(\n  service: BookingService,\n  input: CreateGroupBookingInput,\n): GroupBookingResult {\n  const { groupId, bookings } = service.createGroupBookings(input);\n  let subtotalCents = 0;\n  let discountCents = 0;\n  let taxCents = 0;\n  let totalCents = 0;\n  for (const booking of bookings) {\n    subtotalCents += booking.subtotalCents;\n    discountCents += booking.discountCents;\n    taxCents += booking.taxCents;\n    totalCents += booking.totalCents;\n  }\n  return { groupId, bookings, subtotalCents, discountCents, taxCents, totalCents };\n}\nimport { ValidationError } from \"./models.ts\";\nimport type { PriceBreakdown, Room } from \"./models.ts\";\n\nexport const LEGACY_DEPOSIT_BPS = 2500;\n\nexport function validateNonNegativeInt(value: number, fieldName: string): number {\n  if (!Number.isInteger(value) || value < 0) {\n    throw new ValidationError(`${fieldName} must be a non-negative integer`);\n  }\n  return value;\n}\n\nexport function validatePositiveInt(value: number, fieldName: string): number {\n  if (!Number.isInteger(value) || value <= 0) {\n    throw new ValidationError(`${fieldName} must be a positive integer`);\n  }\n  return value;\n}\n\nexport function roundHalfUpDiv(numerator: number, denominator: number): number {\n  validateNonNegativeInt(numerator, \"numerator\");\n  validatePositiveInt(denominator, \"denominator\");\n  return Math.floor((numerator * 2 + denominator) / (2 * denominator));\n}\n\nexport function validateBasisPoints(value: number, fieldName: string): void {\n  validateNonNegativeInt(value, fieldName);\n  if (value > 10000) {\n    throw new ValidationError(`${fieldName} cannot exceed 10000`);\n  }\n}\n\nexport function computeTaxCents(taxableCents: number, taxBps: number): number {\n  validateNonNegativeInt(taxableCents, \"taxableCents\");\n  validateBasisPoints(taxBps, \"taxBps\");\n  return roundHalfUpDiv(taxableCents * taxBps, 10000);\n}\n\nexport function calculateLegacyDeposit(subtotalCents: number): number {\n  validateNonNegativeInt(subtotalCents, \"subtotalCents\");\n  return roundHalfUpDiv(subtotalCents * LEGACY_DEPOSIT_BPS, 10000);\n}\n\nexport function applyDiscountAndTax(\n  grossSubtotalCents: number,\n  discountBps: number,\n  taxBps: number,\n): Omit<PriceBreakdown, \"depositCents\"> {\n  validateNonNegativeInt(grossSubtotalCents, \"grossSubtotalCents\");\n  validateBasisPoints(discountBps, \"discountBps\");\n  const discountCents = roundHalfUpDiv(grossSubtotalCents * discountBps, 10000);\n  const subtotalCents = grossSubtotalCents - discountCents;\n  const taxCents = computeTaxCents(subtotalCents, taxBps);\n  return { subtotalCents, discountCents, taxCents, totalCents: subtotalCents + taxCents };\n}\n\nexport function calculateBookingPrice(\n  room: Room,\n  durationMinutes: number,\n  options?: { readonly legacyDepositMode?: boolean; readonly discountBps?: number },\n): PriceBreakdown {\n  validatePositiveInt(room.hourlyRateCents, \"hourlyRateCents\");\n  validatePositiveInt(durationMinutes, \"durationMinutes\");\n  const { discountBps = 0 } = options ?? {};\n  const grossSubtotalCents = roundHalfUpDiv(room.hourlyRateCents * durationMinutes, 60);\n  const price = applyDiscountAndTax(grossSubtotalCents, discountBps, room.taxBps);\n  const depositCents = options?.legacyDepositMode === true\n    ? calculateLegacyDeposit(price.subtotalCents)\n    : 0;\n  return { ...price, depositCents };\n}\nbenchmarks/sources/ev2_ts_bookings/src/config.ts:1:import { ConfigError } from \"./models.ts\";\nbenchmarks/sources/ev2_ts_bookings/src/pricing.ts:1:import { ValidationError } from \"./models.ts\";\nbenchmarks/sources/ev2_ts_bookings/src/pricing.ts:2:import type { PriceBreakdown, Room } from \"./models.ts\";\nbenchmarks/sources/ev2_ts_bookings/src/corporate.ts:1:import type { BookingService } from \"./bookings.ts\";\nbenchmarks/sources/ev2_ts_bookings/src/corporate.ts:2:import type { Booking, CreateGroupBookingInput, PriceBreakdown } from \"./models.ts\";\nbenchmarks/sources/ev2_ts_bookings/src/bookings.ts:1:import { loadBookingConfig } from \"./config.ts\";\nbenchmarks/sources/ev2_ts_bookings/src/bookings.ts:2:import type { BookingConfig } from \"./config.ts\";\nbenchmarks/sources/ev2_ts_bookings/src/bookings.ts:3:import { ConflictError, ValidationError } from \"./models.ts\";\nbenchmarks/sources/ev2_ts_bookings/src/bookings.ts:4:import type {\nbenchmarks/sources/ev2_ts_bookings/src/bookings.ts:10:} from \"./models.ts\";\nbenchmarks/sources/ev2_ts_bookings/src/bookings.ts:11:import {\nbenchmarks/sources/ev2_ts_bookings/src/bookings.ts:16:} from \"./pricing.ts\";\nbenchmarks/sources/ev2_ts_bookings/src/index.ts:6:} from \"./models.ts\";\nbenchmarks/sources/ev2_ts_bookings/src/index.ts:14:} from \"./models.ts\";\nbenchmarks/sources/ev2_ts_bookings/src/index.ts:18:} from \"./config.ts\";\nbenchmarks/sources/ev2_ts_bookings/src/index.ts:19:export type { 