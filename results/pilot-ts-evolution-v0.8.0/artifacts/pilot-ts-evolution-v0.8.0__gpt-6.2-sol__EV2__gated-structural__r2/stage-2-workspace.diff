+import assert from "node:assert/strict";
+import test from "node:test";
+import { BookingService, ConflictError, ValidationError, createGroupBooking } from "../src/index.ts";
+import type { CreateGroupBookingInput } from "../src/index.ts";
+
+const input: CreateGroupBookingInput = {
+  customerId: " company_1 ",
+  roomIds: ["a", "b"],
+  startMinute: 60,
+  endMinute: 90,
+  discountBps: 5000,
+};
+
+function setupService(): BookingService {
+  const service = new BookingService({ env: {} });
+  service.registerRoom({ roomId: "a", name: "Room A", hourlyRateCents: 301, taxBps: 1000 });
+  service.registerRoom({ roomId: "b", name: "Room B", hourlyRateCents: 101, taxBps: 2000 });
+  return service;
+}
+
+test("group pricing rounds each room independently and returns the sum", () => {
+  const service = setupService();
+  const { groupId, bookings, ...totals } = createGroupBooking(service, input);
+  assert.ok(groupId);
+  assert.deepEqual(totals, {
+    subtotalCents: 100,
+    discountCents: 102,
+    taxCents: 13,
+    totalCents: 113,
+  });
+  assert.deepEqual(
+    bookings.map(({ roomId, subtotalCents, discountCents, taxCents, totalCents }) => (
+      { roomId, subtotalCents, discountCents, taxCents, totalCents }
+    )),
+    [
+      { roomId: "a", subtotalCents: 75, discountCents: 76, taxCents: 8, totalCents: 83 },
+      { roomId: "b", subtotalCents: 25, discountCents: 26, taxCents: 5, totalCents: 30 },
+    ],
+  );
+  assert.equal(new Set(bookings.map((booking) => booking.bookingId)).size, 2);
+  for (const booking of bookings) {
+    assert.equal(booking.groupId, groupId);
+    assert.equal(booking.customerId, "company_1");
+    assert.equal(booking.status, "confirmed");
+    assert.equal(booking.startMinute, 60);
+    assert.equal(booking.endMinute, 90);
+    assert.deepEqual(service.listRoomBookings(booking.roomId), [booking]);
+    assert.deepEqual(service.getBooking(booking.bookingId), booking);
+  }
+  const adjacent = createGroupBooking(service, { ...input, startMinute: 90, endMinute: 120 });
+  assert.notEqual(adjacent.groupId, groupId);
+  assert.throws(() => service.createBooking({
+    roomId: "b", customerId: "cust_2", startMinute: 89, endMinute: 90,
+  }), ConflictError);
+});
+
+test("a live hold in the last room blocks the entire group until expiration", () => {
+  const service = setupService();
+  const held = service.createBooking({
+    roomId: "b",
+    customerId: "cust_2",
+    startMinute: 89,
+    endMinute: 120,
+    holdMinutes: 10,
+  });
+
+  assert.throws(() => createGroupBooking(service, input), ConflictError);
+  assert.throws(() => createGroupBooking(service, { ...input, nowMinute: 9 }), ConflictError);
+  assert.deepEqual(service.listRoomBookings("a"), []);
+  assert.deepEqual(service.listRoomBookings("b"), [held]);
+
+  const { bookings } = createGroupBooking(service, { ...input, nowMinute: 10 });
+  assert.equal(bookings.length, 2);
+  assert.deepEqual(service.listRoomBookings("a"), [bookings[0]]);
+  assert.deepEqual(service.listRoomBookings("b"), [held, bookings[1]]);
+});
+
+test("invalid groups fail without creating bookings", () => {
+  const service = setupService();
+  const invalidInputs: Partial<CreateGroupBookingInput>[] = [
+    { roomIds: [] },
+    { roomIds: ["a"] },
+    { roomIds: ["a", "b", "a"] },
+    { roomIds: ["a", "missing"] },
+    { discountBps: -1 },
+    { discountBps: 10001 },
+    { discountBps: 1.5 },
+    { discountBps: NaN },
+    { customerId: " " },
+    { endMinute: 60 },
+  ];
+  for (const invalidInput of invalidInputs) {
+    assert.throws(() => createGroupBooking(service, { ...input, ...invalidInput }), ValidationError);
+  }
+  assert.deepEqual(service.listRoomBookings("a"), []);
+  assert.deepEqual(service.listRoomBookings("b"), []);
+});

