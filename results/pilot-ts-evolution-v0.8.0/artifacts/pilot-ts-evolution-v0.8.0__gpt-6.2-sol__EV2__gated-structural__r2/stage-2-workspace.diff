+  assert.deepEqual(calculateBookingPrice(room, 30, { discountBps: 5000, legacyDepositMode: true }), {
+    subtotalCents: 75,
+    discountCents: 76,
+    taxCents: 8,
+    totalCents: 83,
+    depositCents: 19,
+  });
+});
+
+test("discount and tax require integer basis points from zero to 10000", () => {
+  for (const invalidBps of [-1, 1.5, 10001, Infinity, NaN]) {
+    assert.throws(() => applyDiscountAndTax(100, invalidBps, 0), ValidationError);
