+
+// ---------- slotsOverlap ----------
+
+test("slotsOverlap uses half-open intervals", () => {
+  assert.equal(slotsOverlap(0, 60, 60, 120), false); // back-to-back
+  assert.equal(slotsOverlap(60, 120, 0, 60), false);
+  assert.equal(slotsOverlap(0, 60, 59, 120), true);
