+    bookingId: "b",
+    roomId: "r1",
+    customerId: "c",
+    startMinute: 0,
+    endMinute: 60,
+    status: "confirmed",
+    subtotalCents: 0,
+    discountCents: 0,
+    taxCents: 0,
+    totalCents: 0,
+    ...overrides,
+  };
+}
+
+// ---------- roundHalfUpDiv ----------
+
+test("roundHalfUpDiv rounds exact halves up and other fractions to nearest", () => {
+  assert.equal(roundHalfUpDiv(0, 7), 0);
+  assert.equal(roundHalfUpDiv(120, 60), 2);
+  assert.equal(roundHalfUpDiv(29, 60), 0);
+  assert.equal(roundHalfUpDiv(30, 60), 1); // exactly 0.5 -> 1
+  assert.equal(roundHalfUpDiv(89, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2); // exactly 1.5 -> 2
+  assert.equal(roundHalfUpDiv(5, 2), 3); // 2.5 -> 3
+  assert.equal(roundHalfUpDiv(7, 2), 4); // 3.5 -> 4
+  assert.equal(roundHalfUpDiv(1, 3), 0);
+  assert.equal(roundHalfUpDiv(2, 3), 1);
+  assert.equal(roundHalfUpDiv(17, 1), 17);
+});
+
+test("roundHalfUpDiv rejects invalid inputs with ValidationError", () => {
+  assert.throws(() => roundHalfUpDiv(-1, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(1.5, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, 0), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, -60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, 2.5), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.NaN, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.MAX_SAFE_INTEGER, 60), ValidationError);
+});
+
+// ---------- calculateBookingPrice ----------
+
+test("calculateBookingPrice supports partial-hour durations with half-up cents", () => {
+  // 1001 * 30 / 60 = 500.5 -> 501
+  const half = calculateBookingPrice(
+    { roomId: "x", name: "X", hourlyRateCents: 1001, taxBps: 1000 },
+    30,
+  );
+  assert.equal(half.subtotalCents, 501);
+  assert.equal(half.taxCents, 50); // 50.1 -> 50
+  assert.equal(half.totalCents, 551);
+  assert.equal(half.discountCents, 0);
+  assert.equal(half.depositCents, 0);
+
+  // 10000 * 1 / 60 = 166.67 -> 167; tax 167 * 825 / 10000 = 13.78 -> 14
+  const oneMinute = calculateBookingPrice(ROOM, 1);
+  assert.equal(oneMinute.subtotalCents, 167);
+  assert.equal(oneMinute.taxCents, 14);
+  assert.equal(oneMinute.totalCents, 181);
+
+  // 999 * 45 / 60 = 749.25 -> 749
+  const p45 = calculateBookingPrice({ roomId: "y", name: "Y", hourlyRateCents: 999, taxBps: 0 }, 45);
+  assert.equal(p45.subtotalCents, 749);
+  assert.equal(p45.totalCents, 749);
+});
+
+test("calculateBookingPrice keeps whole-hour results and legacy deposit", () => {
+  const price = calculateBookingPrice(ROOM, 90, { legacyDepositMode: true });
+  assert.equal(price.subtotalCents, 15000);
+  assert.equal(price.taxCents, 1238); // 1237.5 -> 1238
+  assert.equal(price.totalCents, 16238);
+  assert.equal(price.depositCents, 3750);
+});
+
+test("calculateBookingPrice rejects non-positive or fractional durations", () => {
+  assert.throws(() => calculateBookingPrice(ROOM, 0), ValidationError);
+  assert.throws(() => calculateBookingPrice(ROOM, -30), ValidationError);
+  assert.throws(() => calculateBookingPrice(ROOM, 30.5), ValidationError);
+});
+
+test("createBooking prices a 45-minute slot", () => {
+  const svc = makeService();
+  const b = svc.createBooking({ roomId: "r1", customerId: "c", startMinute: 0, endMinute: 45 });
+  assert.equal(b.subtotalCents, 7500);
+  assert.equal(b.taxCents, 619); // 618.75 -> 619
+  assert.equal(b.totalCents, 8119);
