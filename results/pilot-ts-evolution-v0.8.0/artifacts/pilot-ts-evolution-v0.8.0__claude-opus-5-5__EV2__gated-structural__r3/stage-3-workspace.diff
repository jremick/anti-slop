+
+// ---------- isBookingActiveAt ----------
+
+test("isBookingActiveAt handles confirmed, held, expired and cancelled", () => {
+  assert.equal(isBookingActiveAt(booking({ status: "confirmed" }), 10_000), true);
+  const held = booking({ status: "held", expiresAt: 30 });
+  assert.equal(isBookingActiveAt(held, 0), true);
+  assert.equal(isBookingActiveAt(held, 29), true);
+  assert.equal(isBookingActiveAt(held, 30), false); // expiry is exclusive
+  assert.equal(isBookingActiveAt(held, 31), false);
