+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  calculateBookingPrice,
+  isBookingActiveAt,
+  roundHalfUpDiv,
+  slotsOverlap,
+} from "../src/index.ts";
+import type { Booking, Room } from "../src/index.ts";
+
+const ROOM: Room = { roomId: "r1", name: "Room 1", hourlyRateCents: 10000, taxBps: 825 };
+
+function makeService(env: Record<string, string | undefined> = {}): BookingService {
+  const svc = new BookingService({ env });
+  svc.registerRoom(ROOM);
+  svc.registerRoom({ roomId: "r2", name: "Room 2", hourlyRateCents: 10000, taxBps: 0 });
+  return svc;
+}
+
+function booking(overrides: Partial<Booking>): Booking {
+  return {
+    bookingId: "b",
+    roomId: "r1",
+    customerId: "c",
+    startMinute: 0,
+    endMinute: 60,
+    status: "confirmed",
+    subtotalCents: 0,
+    discountCents: 0,
+    taxCents: 0,
+    totalCents: 0,
+    ...overrides,
+  };
+}
+
+// ---------- roundHalfUpDiv ----------
+
+test("roundHalfUpDiv rounds exact halves up and other fractions to nearest", () => {
+  assert.equal(roundHalfUpDiv(0, 7), 0);
+  assert.equal(roundHalfUpDiv(120, 60), 2);
+  assert.equal(roundHalfUpDiv(29, 60), 0);
+  assert.equal(roundHalfUpDiv(30, 60), 1); // exactly 0.5 -> 1
+  assert.equal(roundHalfUpDiv(89, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2); // exactly 1.5 -> 2
+  assert.equal(roundHalfUpDiv(5, 2), 3); // 2.5 -> 3
+  assert.equal(roundHalfUpDiv(7, 2), 4); // 3.5 -> 4
+  assert.equal(roundHalfUpDiv(1, 3), 0);
+  assert.equal(roundHalfUpDiv(2, 3), 1);
+  assert.equal(roundHalfUpDiv(17, 1), 17);
+});
+
+test("roundHalfUpDiv rejects invalid inputs with ValidationError", () => {
+  assert.throws(() => roundHalfUpDiv(-1, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(1.5, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, 0), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, -60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, 2.5), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.NaN, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.MAX_SAFE_INTEGER, 60), ValidationError);
+});
+
+// ---------- calculateBookingPrice ----------
+
+test("calculateBookingPrice supports partial-hour durations with half-up cents", () => {
+  // 1001 * 30 / 60 = 500.5 -> 501
+  const half = calculateBookingPrice(
+    { roomId: "x", name: "X", hourlyRateCents: 1001, taxBps: 1000 },
+    30,
+  );
+  assert.equal(half.subtotalCents, 501);
+  assert.equal(half.taxCents, 50); // 50.1 -> 50
+  assert.equal(half.totalCents, 551);
+  assert.equal(half.discountCents, 0);
+  assert.equal(half.depositCents, 0);
+
+  // 10000 * 1 / 60 = 166.67 -> 167; tax 167 * 825 / 10000 = 13.78 -> 14
+  const oneMinute = calculateBookingPrice(ROOM, 1);
+  assert.equal(oneMinute.subtotalCents, 167);
+  assert.equal(oneMinute.taxCents, 14);
+  assert.equal(oneMinute.totalCents, 181);
+
+  // 999 * 45 / 60 = 749.25 -> 749
+  const p45 = calculateBookingPrice({ roomId: "y", name: "Y", hourlyRateCents: 999, taxBps: 0 }, 45);
+  assert.equal(p45.subtotalCents, 749);
+  assert.equal(p45.totalCents, 749);
+});
+
+test("calculateBookingPrice keeps whole-hour results and legacy deposit", () => {
+  const price = calculateBookingPrice(ROOM, 90, { legacyDepositMode: true });
+  assert.equal(price.subtotalCents, 15000);
+  assert.equal(price.taxCents, 1238); // 1237.5 -> 1238
+  assert.equal(price.totalCents, 16238);
+  assert.equal(price.depositCents, 3750);
+});
+
+test("calculateBookingPrice rejects non-positive or fractional durations", () => {
+  assert.throws(() => calculateBookingPrice(ROOM, 0), ValidationError);
+  assert.throws(() => calculateBookingPrice(ROOM, -30), ValidationError);
+  assert.throws(() => calculateBookingPrice(ROOM, 30.5), ValidationError);
+});
+
+test("createBooking prices a 45-minute slot", () => {
+  const svc = makeService();
+  const b = svc.createBooking({ roomId: "r1", customerId: "c", startMinute: 0, endMinute: 45 });
+  assert.equal(b.subtotalCents, 7500);
+  assert.equal(b.taxCents, 619); // 618.75 -> 619
+  assert.equal(b.totalCents, 8119);
+});
+
+// ---------- slotsOverlap ----------
+
+test("slotsOverlap uses half-open intervals", () => {
+  assert.equal(slotsOverlap(0, 60, 60, 120), false); // back-to-back
+  assert.equal(slotsOverlap(60, 120, 0, 60), false);
+  assert.equal(slotsOverlap(0, 60, 59, 120), true);
+  assert.equal(slotsOverlap(0, 120, 30, 60), true); // containment
+  assert.equal(slotsOverlap(30, 60, 0, 120), true);
+  assert.equal(slotsOverlap(0, 60, 0, 60), true); // identical
+  assert.equal(slotsOverlap(0, 30, 90, 120), false); // disjoint
+});
+
+// ---------- isBookingActiveAt ----------
+
+test("isBookingActiveAt handles confirmed, held, expired and cancelled", () => {
+  assert.equal(isBookingActiveAt(booking({ status: "confirmed" }), 10_000), true);
+  const held = booking({ status: "held", expiresAt: 30 });
+  assert.equal(isBookingActiveAt(held, 0), true);
+  assert.equal(isBookingActiveAt(held, 29), true);
+  assert.equal(isBookingActiveAt(held, 30), false); // expiry is exclusive
+  assert.equal(isBookingActiveAt(held, 31), false);
+  assert.equal(isBookingActiveAt(booking({ status: "held" }), 0), false); // no expiresAt
+  assert.equal(isBookingActiveAt(booking({ status: "cancelled" }), 0), false);
+});
+
+// ---------- createBooking conflicts ----------
+
+test("createBooking rejects overlapping confirmed bookings on the same room", () => {
+  const svc = makeService();
+  svc.createBooking({ roomId: "r1", customerId: "a", startMinute: 60, endMinute: 120 });
+  assert.throws(
+    () => svc.createBooking({ roomId: "r1", customerId: "b", startMinute: 90, endMinute: 150 }),
+    ConflictError,
+  );
+  assert.throws(
+    () => svc.createBooking({ roomId: "r1", customerId: "b", startMinute: 0, endMinute: 61 }),
+    ConflictError,
+  );
+  assert.throws(
+    () => svc.createBooking({ roomId: "r1", customerId: "b", startMinute: 70, endMinute: 80 }),
+    ConflictError,
+  );
+  assert.equal(svc.listRoomBookings("r1").length, 1);
+});
+
+test("createBooking allows back-to-back bookings and other rooms", () => {
+  const svc = makeService();
+  svc.createBooking({ roomId: "r1", customerId: "a", startMinute: 60, endMinute: 120 });
+  svc.createBooking({ roomId: "r1", customerId: "b", startMinute: 0, endMinute: 60 });
+  svc.createBooking({ roomId: "r1", customerId: "c", startMinute: 120, endMinute: 180 });
+  svc.createBooking({ roomId: "r2", customerId: "d", startMinute: 60, endMinute: 120 });
+  assert.equal(svc.listRoomBookings("r1").length, 3);
+  assert.equal(svc.listRoomBookings("r2").length, 1);
+});
+
+// ---------- holds ----------
+
+test("createBooking with holdMinutes creates a held booking with expiresAt", () => {
+  const svc = makeService();
+  const b = svc.createBooking({
+    roomId: "r1",
+    customerId: "a",
+    startMinute: 600,
+    endMinute: 660,
+    nowMinute: 100,
+    holdMinutes: 15,
+  });
+  assert.equal(b.status, "held");
+  assert.equal(b.expiresAt, 115);
+  assert.equal(b.subtotalCents, 10000);
+});
+
+test("confirmed booking has no expiresAt", () => {
+  const svc = makeService();
+  const b = svc.createBooking({ roomId: "r1", customerId: "a", startMinute: 0, endMinute: 60 });
+  assert.equal(b.status, "confirmed");
+  assert.equal("expiresAt" in b, false);
+});
+
+test("active hold blocks overlapping bookings until it expires", () => {
+  const svc = makeService();
+  svc.createBooking({
+    roomId: "r1",
+    customerId: "a",
+    startMinute: 600,
+    endMinute: 660,
+    nowMinute: 0,
+    holdMinutes: 30,
+  });
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "r1",
+        customerId: "b",
