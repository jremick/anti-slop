+
+test("default maxHoldMinutes is 60", () => {
+  const svc = makeService();
+  const base = { roomId: "r1", customerId: "a", startMinute: 0, endMinute: 60 };
+  assert.throws(() => svc.createBooking({ ...base, holdMinutes: 61 }), ValidationError);
+  assert.equal(svc.createBooking({ ...base, holdMinutes: 60 }).expiresAt, 60);
+});
+
+// ---------- confirmHold ----------
+
+test("confirmHold confirms a live hold and clears expiresAt", () => {
+  const svc = makeService();
+  const held = svc.createBooking({
+    roomId: "r1",
+    customerId: "a",
+    startMinute: 0,
+    endMinute: 60,
+    nowMinute: 10,
+    holdMinutes: 10,
+  });
