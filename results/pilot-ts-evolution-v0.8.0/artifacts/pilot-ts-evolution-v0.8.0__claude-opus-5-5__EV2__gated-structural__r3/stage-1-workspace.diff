+/**
+ * Half-open interval overlap: `[startA, endA)` and `[startB, endB)` overlap
+ * iff each starts before the other ends. Back-to-back slots do not overlap.
+ */
+export function slotsOverlap(
+  startA: number,
+  endA: number,
+  startB: number,
+  endB: number,
+): boolean {
+  return startA < endB && startB < endA;
+}
+
+/**
+ * A booking blocks its slot when confirmed, or when held and the hold has not
+ * yet expired at `nowMinute` (expiry is exclusive: at `expiresAt` it is inactive).
+ */
+export function isBookingActiveAt(booking: Booking, nowMinute: number): boolean {
+  if (booking.status === "confirmed") {
+    return true;
+  }
+  return booking.status === "held" &&
+    booking.expiresAt !== undefined &&
+    nowMinute < booking.expiresAt;
+}
 
