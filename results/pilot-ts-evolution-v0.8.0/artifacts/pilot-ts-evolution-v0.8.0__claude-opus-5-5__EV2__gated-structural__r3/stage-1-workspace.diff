+        endMinute: 690,
+        nowMinute: 29,
+      }),
+    ConflictError,
+  );
+  // At minute 30 the hold has expired, so the slot is free.
+  const b = svc.createBooking({
+    roomId: "r1",
+    customerId: "b",
+    startMinute: 630,
+    endMinute: 690,
+    nowMinute: 30,
+  });
+  assert.equal(b.status, "confirmed");
+});
+
+test("nowMinute defaults to 0 for conflict checks", () => {
+  const svc = makeService();
+  svc.createBooking({
+    roomId: "r1",
+    customerId: "a",
+    startMinute: 0,
+    endMinute: 60,
+    holdMinutes: 1,
+  });
+  assert.throws(
+    () => svc.createBooking({ roomId: "r1", customerId: "b", startMinute: 0, endMinute: 60 }),
+    ConflictError,
+  );
+});
+
+test("holdMinutes is validated against config.maxHoldMinutes", () => {
+  const svc = makeService({ BOOKING_MAX_HOLD_MINUTES: "20" });
+  const base = { roomId: "r1", customerId: "a", startMinute: 0, endMinute: 60 };
+  assert.throws(() => svc.createBooking({ ...base, holdMinutes: 21 }), ValidationError);
+  assert.throws(() => svc.createBooking({ ...base, holdMinutes: 0 }), ValidationError);
+  assert.throws(() => svc.createBooking({ ...base, holdMinutes: -5 }), ValidationError);
+  assert.throws(() => svc.createBooking({ ...base, holdMinutes: 1.5 }), ValidationError);
+  assert.throws(() => svc.createBooking({ ...base, nowMinute: -1 }), ValidationError);
+  assert.throws(() => svc.createBooking({ ...base, nowMinute: 2.5 }), ValidationError);
+  assert.equal(svc.listRoomBookings("r1").length, 0);
+  const ok = svc.createBooking({ ...base, holdMinutes: 20 });
+  assert.equal(ok.expiresAt, 20);
