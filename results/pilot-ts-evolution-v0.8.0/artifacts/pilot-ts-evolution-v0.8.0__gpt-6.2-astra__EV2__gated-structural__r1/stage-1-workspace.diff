+import test from "node:test";
+import assert from "node:assert/strict";
+import { calculateBookingPrice, roundHalfUpDiv, ValidationError } from "../src/index.ts";
+
+test("integer division rounds ties up and rejects invalid operands", () => {
+  assert.equal(roundHalfUpDiv(0, 60), 0);
+  assert.equal(roundHalfUpDiv(89, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2);
+  assert.equal(roundHalfUpDiv(91, 60), 2);
+  for (const [n, d] of [[-1, 2], [1.5, 2], [1, 0], [1, -1], [1, 1.5]]) {
+    assert.throws(() => roundHalfUpDiv(n, d), ValidationError);
+  }
+});
+
+test("partial hours round subtotal before computing tax and deposit", () => {
+  const room = { roomId: "a", name: "A", hourlyRateCents: 90, taxBps: 2500 };
+  assert.deepEqual(calculateBookingPrice(room, 1, { legacyDepositMode: true }), {
+    subtotalCents: 2, discountCents: 0, taxCents: 1, totalCents: 3, depositCents: 1,
+  });
+  assert.equal(calculateBookingPrice(room, 61).subtotalCents, 92);
+  for (const duration of [0, -1, 0.5]) {
+    assert.throws(() => calculateBookingPrice(room, duration), ValidationError);
+  }
+});
