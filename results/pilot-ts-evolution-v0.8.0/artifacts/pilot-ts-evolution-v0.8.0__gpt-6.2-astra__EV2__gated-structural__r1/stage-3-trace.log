{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/config.ts')\ns=p.read_text().replace('export function loadBookingConfig(','''export function getBookingEnvironment(): Record<string, string | undefined> {\n  return process.env;\n}\n\nexport function loadBookingConfig(''').replace(' = process.env,',' = getBookingEnvironment(),')\np.write_text(s)\np=Path('src/bookings.ts')\np.write_text(p.read_text().replace('import { loadBookingConfig,','import { getBookingEnvironment, loadBookingConfig,').replace('private readonly env: BookingServiceOptions[\\\"env\\\"];','private readonly env: Record<string, string | undefined>;').replace('constructor(options: BookingServiceOptions = {}) {\\\\n    this.env = options.env;', 'constructor({ env = getBookingEnvironment() }: BookingServiceOptions = {}) {\\\\n    this.env = env;'))\nPY\ncat > tests/cancellation.test.ts <<'EOF'\nimport test from \\\"node:test\\\";\nimport assert from \\\"node:assert/strict\\\";\nimport {\n  BookingService, ConfigError, ConflictError, ValidationError, computeCancellationRefund,\n} from \\\"../src/index.ts\\\";\n\nconst tiers = { cutoffMinutes: 30, earlyFeeBps: 2500, lateFeeBps: 5000 };\nconst slot = { roomId: \\\"a\\\", customerId: \\\"guest\\\", startMinute: 100, endMinute: 160 };\n\nfunction setup(raw: string | undefined) {\n  const env = { BOOKING_CANCEL_FEE_TIERS_JSON: raw };\n  const service = new BookingService({ env });\n  service.registerRoom({ roomId: \\\"a\\\", name: \\\"A\\\", hourlyRateCents: 100, taxBps: 100 });\n  return { env, service, booking: service.createBooking(slot) };\n}\n\ntest(\\\"cancellation charges the selected tier on the tax-inclusive total and releases the slot\\\", () => {\n  for (const [nowMinute, feeBps, feeCents, refundCents] of [\n    [69, 2500, 25, 76], [70, 2500, 25, 76], [71, 5000, 51, 50], [100, 5000, 51, 50],\n  ]) {\n    const { service, booking } = setup(JSON.stringify(tiers));\n    const result = service.cancelBooking(booking.bookingId, nowMinute);\n    assert.deepEqual(result, { booking: { ...booking, status: \\\"cancelled\\\" }, feeBps, feeCents, refundCents });\n    assert.deepEqual(service.getBooking(booking.bookingId), result.booking);\n    assert.throws(() => service.cancelBooking(booking.bookingId, nowMinute), ValidationError);\n    assert.equal(service.createBooking({ ...slot, nowMinute }).status, \\\"confirmed\\\");\n  }\n});\n\ntest(\\\"invalid tiers keep the slot reserved until configuration is corrected\\\", () => {\n  for (const raw of [\n    undefined, \\\"\\\", \\\"  \\\", \\\"{\\\", \\\"null\\\", \\\"[]\\\", \\\"true\\\", '\\\"invalid\\\"', \\\"{}\\\",\n    ...[\n      { cutoffMinutes: -1 }, { cutoffMinutes: 1.5 }, { earlyFeeBps: undefined },\n      { lateFeeBps: -1 }, { earlyFeeBps: 10001 }, { lateFeeBps: 0.1 }, { lateFeeBps: \\\"0\\\" },\n    ].map(fields => JSON.stringify({ ...tiers, ...fields })),\n  ]) {\n    const { service, booking, env } = setup(raw);\n    assert.throws(() => service.cancelBooking(booking.bookingId, 0), ConfigError);\n    assert.deepEqual(service.getBooking(booking.bookingId), booking);\n    assert.throws(() => service.createBooking(slot), ConflictError);\n    env.BOOKING_CANCEL_FEE_TIERS_JSON = JSON.stringify(tiers);\n    assert.equal(service.cancelBooking(booking.bookingId, 0).refundCents, 76);\n  }\n});\n\ntest(\\\"unknown bookings and cancellations after the start are rejected\\\", () => {\n  const { service, booking } = setup(JSON.stringify(tiers));\n  assert.throws(() => service.cancelBooking(\\\"missing\\\", 0), ValidationError);\n  assert.throws(() => service.cancelBooking(booking.bookingId, 101), ValidationError);\n  assert.deepEqual(service.getBooking(booking.bookingId), booking);\n});\n\ntest(\\\"refunds support zero and full fees and reject invalid amounts and rates\\\", () => {\n  assert.deepEqual(computeCancellationRefund(101, 0), { feeCents: 0, refundCents: 101 });\n  assert.deepEqual(computeCancellationRefund(101, 10000), { feeCents: 101, refundCents: 0 });\n  for (const [total, rate] of [[-1, 0], [0.5, 200], [100, -1], [100, 0.5], [100, 10001]]) {\n    assert.throws(() => computeCancellationRefund(total, rate), ValidationError);\n  }\n});\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
