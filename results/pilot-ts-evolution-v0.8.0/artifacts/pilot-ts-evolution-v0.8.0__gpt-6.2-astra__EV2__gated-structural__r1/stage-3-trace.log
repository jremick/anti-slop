{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc 'cat src/{config,bookings,pricing,index}.ts'","aggregated_output":"import { ConfigError } from \"./models.ts\";\n\nexport interface BookingConfig {\n  readonly maxHoldMinutes: number;\n}\n\nexport const DEFAULT_MAX_HOLD_MINUTES = 60;\n\nexport function loadBookingConfig(\n  env: Record<string, string | undefined> = process.env,\n): BookingConfig {\n  const rawHold = env.BOOKING_MAX_HOLD_MINUTES;\n  if (rawHold === undefined || rawHold.trim() === \"\") {\n    return { maxHoldMinutes: DEFAULT_MAX_HOLD_MINUTES };\n  }\n  const parsed = Number(rawHold);\n  if (!Number.isInteger(parsed) || parsed <= 0) {\n    throw new ConfigError(\"BOOKING_MAX_HOLD_MINUTES must be a positive integer\");\n  }\n  return { maxHoldMinutes: parsed };\n}\nimport { loadBookingConfig } from \"./config.ts\";\nimport type { BookingConfig } from \"./config.ts\";\nimport { ConflictError, ValidationError } from \"./models.ts\";\nimport type { Booking, CreateBookingInput, CreateGroupBookingInput, Room } from \"./models.ts\";\nimport { calculateBookingPrice, validateBasisPoints, validateNonNegativeInt, validatePositiveInt } from \"./pricing.ts\";\n\nexport interface BookingServiceOptions {\n  readonly env?: Record<string, string | undefined>;\n}\n\nexport function slotsOverlap(startA: number, endA: number, startB: number, endB: number): boolean {\n  return startA < endB && startB < endA;\n}\n\nexport function isBookingActiveAt(booking: Booking, nowMinute: number): boolean {\n  return booking.status === \"confirmed\" ||\n    (booking.status === \"held\" && booking.expiresAt !== undefined && nowMinute < booking.expiresAt);\n}\n\nexport class BookingService {\n  readonly config: BookingConfig;\n  private readonly rooms: Map<string, Room> = new Map();\n  private readonly bookings: Map<string, Booking> = new Map();\n  private seq = 0;\n\n  constructor(options: BookingServiceOptions = {}) {\n    this.config = loadBookingConfig(options.env);\n  }\n\n  private nextId(prefix: string): string {\n    this.seq += 1;\n    return `${prefix}_${String(this.seq).padStart(4, \"0\")}`;\n  }\n\n  registerRoom(room: Room): void {\n    if (typeof room.roomId !== \"string\" || room.roomId.trim() === \"\") {\n      throw new ValidationError(\"roomId must be a non-empty string\");\n    }\n    if (typeof room.name !== \"string\" || room.name.trim() === \"\") {\n      throw new ValidationError(\"name must be a non-empty string\");\n    }\n    validatePositiveInt(room.hourlyRateCents, \"hourlyRateCents\");\n    validateBasisPoints(room.taxBps, \"taxBps\");\n    this.rooms.set(room.roomId, room);\n  }\n\n  getRoom(roomId: string): Room {\n    const room = this.rooms.get(roomId);\n    if (room === undefined) {\n      throw new ValidationError(`Unknown roomId: ${roomId}`);\n    }\n    return room;\n  }\n\n  getBooking(bookingId: string): Booking {\n    const booking = this.bookings.get(bookingId);\n    if (booking === undefined) {\n      throw new ValidationError(`Unknown bookingId: ${bookingId}`);\n    }\n    return booking;\n  }\n\n  listRoomBookings(roomId: string): Booking[] {\n    this.getRoom(roomId);\n    const matches: Booking[] = [];\n    for (const booking of this.bookings.values()) {\n      if (booking.roomId === roomId) {\n        matches.push(booking);\n      }\n    }\n    return matches;\n  }\n\n  private prepareBooking(input: CreateBookingInput, discountBps: number): Omit<Booking, \"bookingId\"> {\n    if (typeof input.customerId !== \"string\" || input.customerId.trim() === \"\") {\n      throw new ValidationError(\"customerId must be a non-empty string\");\n    }\n    validateNonNegativeInt(input.startMinute, \"startMinute\");\n    validatePositiveInt(input.endMinute, \"endMinute\");\n    if (input.endMinute <= input.startMinute) {\n      throw new ValidationError(\"endMinute must be strictly greater than startMinute\");\n    }\n    const room = this.getRoom(input.roomId);\n    const { nowMinute = 0, holdMinutes } = input;\n    validateNonNegativeInt(nowMinute, \"nowMinute\");\n    if (holdMinutes !== undefined) {\n      validatePositiveInt(holdMinutes, \"holdMinutes\");\n      if (holdMinutes > this.config.maxHoldMinutes) {\n        throw new ValidationError(\"holdMinutes exceeds the configured maximum\");\n      }\n    }\n\n    for (const booking of this.bookings.values()) {\n      if (\n        booking.roomId === room.roomId &&\n        isBookingActiveAt(booking, nowMinute) &&\n        slotsOverlap(input.startMinute, input.endMinute, booking.startMinute, booking.endMinute)\n      ) {\n        throw new ConflictError(`Room ${room.roomId} already has a booking in this slot`);\n      }\n    }\n\n    const duration = input.endMinute - input.startMinute;\n    const price = calculateBookingPrice(room, duration, {\n      legacyDepositMode: input.legacyDepositMode,\n      discountBps,\n    });\n    return {\n      roomId: room.roomId,\n      customerId: input.customerId.trim(),\n      startMinute: input.startMinute,\n      endMinute: input.endMinute,\n      status: holdMinutes === undefined ? \"confirmed\" : \"held\",\n      ...(holdMinutes === undefined ? {} : { expiresAt: nowMinute + holdMinutes }),\n      ...price,\n    };\n  }\n\n  private storeBooking(details: Omit<Booking, \"bookingId\">): Booking {\n    const booking = { ...details, bookingId: this.nextId(\"bkg\") };\n    this.bookings.set(booking.bookingId, booking);\n    return booking;\n  }\n\n  createBooking(input: CreateBookingInput): Booking {\n    return this.storeBooking(this.prepareBooking(input, 0));\n  }\n\n  reserveGroup(input: CreateGroupBookingInput): { groupId: string; bookings: Booking[] } {\n    const { roomIds, discountBps, customerId, startMinute, endMinute, nowMinute } = input;\n    if (!Array.isArray(roomIds) || roomIds.length < 2 || new Set(roomIds).size !== roomIds.length) {\n      throw new ValidationError(\"Group bookings require at least two distinct room IDs\");\n    }\n    validateBasisPoints(discountBps, \"discountBps\");\n    const pending = Array.from(roomIds, (roomId) =>\n      this.prepareBooking({ roomId, customerId, startMinute, endMinute, nowMinute }, discountBps)\n    );\n    const groupId = this.nextId(\"grp\");\n    const bookings = pending.map((details) => this.storeBooking({ ...details, groupId }));\n    return { groupId, bookings };\n  }\n\n  confirmHold(bookingId: string, nowMinute: number): Booking {\n    validateNonNegativeInt(nowMinute, \"nowMinute\");\n    const booking = this.getBooking(bookingId);\n    if (booking.status !== \"held\" || !isBookingActiveAt(booking, nowMinute)) {\n      throw new ValidationError(`Booking ${bookingId} is not an active hold`);\n    }\n    const { expiresAt, ...details } = booking;\n    const confirmed: Booking = { ...details, status: \"confirmed\" };\n    this.bookings.set(bookingId, confirmed);\n    return confirmed;\n  }\n}\nimport { ValidationError } from \"./models.ts\";\nimport type { PriceBreakdown, Room } from \"./models.ts\";\n\nexport const LEGACY_DEPOSIT_BPS = 2500;\n\nexport function validateNonNegativeInt(value: number, fieldName: string): number {\n  if (!Number.isInteger(value) || value < 0) {\n    throw new ValidationError(`${fieldName} must be a non-negative integer`);\n  }\n  return value;\n}\n\nexport function validatePositiveInt(value: number, fieldName: string): number {\n  if (!Number.isInteger(value) || value <= 0) {\n    throw new ValidationError(`${fieldName} must be a positive integer`);\n  }\n  return value;\n}\n\nexport function roundHalfUpDiv(numerator: number, denominator: number): number {\n  validateNonNegativeInt(numerator, \"numerator\");\n  validatePositiveInt(denominator, \"denominator\");\n  return Math.floor((numerator * 2 + denominator) / (2 * denominator));\n}\n\nexport function validateBasisPoints(value: number, fieldName: string): void {\n  validateNonNegativeInt(value, fieldName);\n  if (value > 10000) {\n    throw new ValidationError(`${fieldName} cannot exceed 10000`);\n  }\n}\n\nexport function computeTaxCents(taxableCents: number, taxBps: number): number {\n  validateNonNegativeInt(taxableCents, \"taxableCents\");\n  validateBasisPoints(taxBps, \"taxBps\");\n  return roundHalfUpDiv(taxableCents * taxBps, 10000);\n}\n\nexport function applyDiscountAndTax(\n  grossSubtotalCents: number,\n  discountBps: number,\n  taxBps: number,\n): Omit<PriceBreakdown, \"depositCents\"> {\n  validateNonNegativeInt(grossSubtotalCents, \"grossSubtotalCents\");\n  validateBasisPoints(discountBps, \"discountBps\");\n  const discountCents = roundHalfUpDiv(grossSubtotalCents * discountBps, 10000);\n  const subtotalCents = grossSubtotalCents - discountCents;\n  const taxCents = computeTaxCents(subtotalCents, taxBps);\n  return { subtotalCents, discountCents, taxCents, totalCents: subtotalCents + taxCents };\n}\n\nexport function calculateLegacyDeposit(subtotalCents: number): number {\n  validateNonNegativeInt(subtotalCents, \"subtotalCents\");\n  return Math.floor((subtotalCents * LEGACY_DEPOSIT_BPS + 5000) / 10000);\n}\n\nexport function calculateBookingPrice(\n  room: Room,\n  durationMinutes: number,\n  options?: { readonly legacyDepositMode?: boolean; readonly discountBps?: number },\n): PriceBreakdown {\n  validatePositiveInt(room.hourlyRateCents, \"hourlyRateCents\");\n  validatePositiveInt(durationMinutes, \"durationMinutes\");\n  const grossSubtotalCents = roundHalfUpDiv(room.hourlyRateCents * durationMinutes, 60);\n  const price = applyDiscountAndTax(grossSubtotalCents, options?.discountBps ?? 0, room.taxBps);\n  const depositCents = options?.legacyDepositMode === true\n    ? calculateLegacyDeposit(price.subtotalCents)\n    : 0;\n  return { ...price, depositCents };\n}\nexport {\n  BookingError,\n  ConfigError,\n  ConflictError,\n  ValidationError,\n} from \"./models.ts\";\nexport type {\n  Booking,\n  BookingStatus,\n  CreateBookingInput,\n  CreateGroupBookingInput,\n  PriceBreakdown,\n  Room,\n} from \"./models.ts\";\nexport {\n  DEFAULT_MAX_HOLD_MINUTES,\n  loadBookingConfig,\n} from \"./config.ts\";\nexport type { BookingConfig } from \"./config.ts\";\nexport {\n  LEGACY_DEPOSIT_BPS,\n  applyDiscountAndTax,\n  calculateBookingPrice,\n  calculateLegacyDeposit,\n  computeTaxCents,\n  roundHalfUpDiv,\n  validateNonNegativeInt,\n  validatePositiveInt,\n} from \"./pricing.ts\";\nexport { BookingService, isBookingActiveAt, slotsOverlap } from \"./bookings.ts\";\nexport type { BookingServiceOptions } from \"./bookings.ts\";\nexport { createGroupBooking } from \"./corporate.ts\";\n","exit_code":0,"status":"completed"}}
