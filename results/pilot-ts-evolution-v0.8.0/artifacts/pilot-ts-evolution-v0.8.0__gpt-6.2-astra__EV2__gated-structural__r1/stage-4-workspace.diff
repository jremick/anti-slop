+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService, ConflictError, ValidationError, applyDiscountAndTax, createGroupBooking,
+} from "../src/index.ts";
+
+const input = {
+  customerId: "Acme", roomIds: ["a", "b"], startMinute: 60, endMinute: 90, discountBps: 5000,
+};
+
+function createService(): BookingService {
+  const service = new BookingService({ env: {} });
+  service.registerRoom({ roomId: "a", name: "A", hourlyRateCents: 401, taxBps: 1250 });
+  service.registerRoom({ roomId: "b", name: "B", hourlyRateCents: 205, taxBps: 5000 });
+  return service;
+}
+
+test("group totals sum each room's rounded discount and tax", () => {
+  const service = createService();
+  const { bookings, groupId, ...totals } = createGroupBooking(service, input);
+  assert.deepEqual(totals, { subtotalCents: 151, discountCents: 153, taxCents: 39, totalCents: 190 });
+  assert.deepEqual(bookings.map(b => [b.roomId, b.subtotalCents, b.discountCents, b.taxCents, b.totalCents]), [
+    ["a", 100, 101, 13, 113],
+    ["b", 51, 52, 26, 77],
+  ]);
+  assert.ok(groupId);
+  for (const booking of bookings) {
+    assert.deepEqual(service.getBooking(booking.bookingId), booking);
+    assert.equal(booking.groupId, groupId);
+    assert.equal(booking.status, "confirmed");
+    assert.equal(booking.customerId, input.customerId);
+    assert.equal(booking.startMinute, input.startMinute);
+    assert.equal(booking.endMinute, input.endMinute);
+  }
+  const next = createGroupBooking(service, { ...input, startMinute: 90, endMinute: 120 });
+  assert.notEqual(next.groupId, groupId);
+});
+
+test("a conflicting hold in the last room blocks the entire group until expiration", () => {
+  const service = createService();
+  const hold = service.createBooking({
+    customerId: "Guest", roomId: "b", startMinute: 89, endMinute: 91, holdMinutes: 3,
+  });
+  assert.throws(() => createGroupBooking(service, { ...input, nowMinute: 2 }), ConflictError);
+  assert.deepEqual(service.listRoomBookings("a"), []);
+  assert.deepEqual(service.listRoomBookings("b"), [hold]);
+  assert.equal(createGroupBooking(service, { ...input, nowMinute: 3 }).bookings.length, 2);
+});
+
+test("invalid groups leave every room available", () => {
+  const service = createService();
+  for (const invalid of [
+    { roomIds: [] }, { roomIds: ["a"] }, { roomIds: ["a", "b", "a"] }, { roomIds: ["a", "unknown"] },
+    { discountBps: -1 }, { discountBps: 10001 }, { discountBps: 1.5 }, { customerId: " " },
+    { endMinute: input.startMinute }, { nowMinute: -1 },
+  ]) {
+    assert.throws(() => createGroupBooking(service, { ...input, ...invalid }), ValidationError);
+    for (const roomId of input.roomIds) assert.deepEqual(service.listRoomBookings(roomId), []);
+  }
+});
+
+test("discount and tax accept both rate boundaries and reject invalid amounts and rates", () => {
+  assert.deepEqual(applyDiscountAndTax(501, 0, 10000), {
+    subtotalCents: 501, discountCents: 0, taxCents: 501, totalCents: 1002,
+  });
+  assert.deepEqual(applyDiscountAndTax(501, 10000, 0), {
+    subtotalCents: 0, discountCents: 501, taxCents: 0, totalCents: 0,
+  });
+  for (const invalid of [-1, 1.5, 10001]) {
+    assert.throws(() => applyDiscountAndTax(100, invalid, 0), ValidationError);
+    assert.throws(() => applyDiscountAndTax(100, 0, invalid), ValidationError);
+  }
+  for (const gross of [-1, 1.5]) {
+    assert.throws(() => applyDiscountAndTax(gross, 0, 0), ValidationError);
+  }
+});

