+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService, ConflictError, ValidationError, isBookingActiveAt, slotsOverlap,
+} from "../src/index.ts";
+
+const room = { roomId: "a", name: "A", hourlyRateCents: 999, taxBps: 500 };
+const slot = { roomId: room.roomId, customerId: "guest", startMinute: 60, endMinute: 90 };
+
+function createService(): BookingService {
+  const service = new BookingService({ env: { BOOKING_MAX_HOLD_MINUTES: "5" } });
+  service.registerRoom(room);
+  return service;
+}
+
+test("only overlapping slots in the same room conflict", () => {
+  const service = createService();
+  service.createBooking(slot);
+  for (const [startMinute, endMinute] of [[59, 61], [89, 91], [60, 90], [59, 91], [61, 89]]) {
+    assert.ok(slotsOverlap(60, 90, startMinute, endMinute));
+    assert.throws(() => service.createBooking({ ...slot, startMinute, endMinute }), ConflictError);
+  }
+  service.createBooking({ ...slot, startMinute: 55, endMinute: 60 });
+  service.createBooking({ ...slot, startMinute: 90, endMinute: 95 });
+  assert.equal(service.listRoomBookings(room.roomId).length, 3);
+  service.registerRoom({ ...room, roomId: "b" });
+  assert.equal(service.createBooking({ ...slot, roomId: "b" }).status, "confirmed");
+});
+
+test("a hold releases its slot at the expiration minute", () => {
+  const service = createService();
+  const hold = service.createBooking({ ...slot, nowMinute: 10, holdMinutes: 5 });
+  assert.equal(hold.status, "held");
+  assert.equal(hold.expiresAt, 15);
+  assert.throws(() => service.createBooking({ ...slot, nowMinute: 14 }), ConflictError);
+  assert.throws(() => service.confirmHold(hold.bookingId, 15), ValidationError);
+  assert.equal(service.getBooking(hold.bookingId).status, "held");
+  assert.equal(service.createBooking({ ...slot, nowMinute: 15 }).status, "confirmed");
+});
+
+test("confirming a hold preserves its slot and price beyond the original expiration", () => {
+  const service = createService();
+  const hold = service.createBooking({ ...slot, holdMinutes: 5 });
+  assert.equal(hold.expiresAt, 5);
+  const confirmed = service.confirmHold(hold.bookingId, 4);
+  assert.equal(confirmed.expiresAt, undefined);
+  assert.deepEqual(confirmed, service.getBooking(hold.bookingId));
+  assert.deepEqual({ ...confirmed, expiresAt: undefined }, { ...hold, status: "confirmed", expiresAt: undefined });
+  assert.throws(() => service.createBooking({ ...slot, holdMinutes: 1, nowMinute: 6 }), ConflictError);
+  assert.throws(() => service.confirmHold(confirmed.bookingId, 6), ValidationError);
+  assert.throws(() => service.confirmHold("missing", 6), ValidationError);
+  assert.equal(isBookingActiveAt({ ...confirmed, status: "held" }, 0), false);
+  assert.equal(isBookingActiveAt({ ...hold, status: "cancelled" }, 0), false);
+});
+
+test("invalid hold durations leave the slot available", () => {
+  const service = createService();
+  for (const holdMinutes of [0, -1, 1.5, 6]) {
+    assert.throws(() => service.createBooking({ ...slot, holdMinutes }), ValidationError);
+  }
+  assert.deepEqual(service.listRoomBookings(room.roomId), []);
+});

