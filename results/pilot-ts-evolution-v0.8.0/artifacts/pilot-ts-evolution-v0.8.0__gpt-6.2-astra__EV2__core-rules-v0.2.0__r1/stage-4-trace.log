\\\", bookingId: b.bookingId, roomId: \\\"b\\\", amountCents: 100 },\n  ]);\n});\n\ntest(\\\"a failed single creation or cancellation propagates the hook error and permits retry\\\", () => {\n  const failure = new Error(\\\"notification unavailable\\\");\n  let reject = true;\n  const service = setup(() => { if (reject) throw failure; });\n  assert.throws(() => service.createBooking(slot), error => error === failure);\n  assert.deepEqual(service.listRoomBookings(\\\"a\\\"), []);\n  reject = false;\n  const booking = service.createBooking(slot);\n  reject = true;\n  assert.throws(() => service.cancelBooking(booking.bookingId, 1), error => error === failure);\n  assert.equal(service.getBooking(booking.bookingId).status, \\\"confirmed\\\");\n  assert.throws(() => service.createBooking(slot), ConflictError);\n  reject = false;\n  assert.equal(service.cancelBooking(booking.bookingId, 2).booking.status, \\\"cancelled\\\");\n});\n\ntest(\\\"failure notifying the second group room leaves both slots available\\\", () => {\n  const events: BookingNotification[] = [];\n  const failure = new Error(\\\"second notification failed\\\");\n  const service = setup(event => {\n    events.push(event);\n    if (events.length === 2) throw failure;\n  });\n  assert.throws(() => createGroupBooking(service, group), error => error === failure);\n  assert.deepEqual(events.map(event => event.roomId), [\\\"a\\\", \\\"b\\\"]);\n  for (const event of events) {\n    assert.deepEqual(service.listRoomBookings(event.roomId), []);\n    assert.throws(() => service.getBooking(event.bookingId), ValidationError);\n  }\n  assert.equal(createGroupBooking(service, group).bookings.length, 2);\n});\n\ntest(\\\"a hook cannot create a conflicting booking during notification\\\", () => {\n  const service = setup(() => {\n    assert.throws(() => service.createBooking(slot), ValidationError);\n  });\n  const booking = service.createBooking(slot);\n  assert.deepEqual(service.listRoomBookings(\\\"a\\\"), [booking]);\n});\nEOF\nnode run_checks.mjs\"","aggregated_output":"✔ pricing and public entry points expose no deposit API (1.490167ms)\n✔ baseline whole-hour booking computes exact subtotal and tax (3.817167ms)\n✔ baseline rejects invalid room or inverted time range (0.5155ms)\n✔ cancellation uses the taxed total, includes the early cutoff, and releases the slot (2.018959ms)\n✔ missing or malformed tiers keep the hold active until a valid cancellation (0.725625ms)\n✔ unknown bookings and invalid cancellation times fail before loading tiers (0.276375ms)\n✔ fee helpers accept explicit zero and full fees and reject invalid amounts (0.331625ms)\n✔ group totals sum each room's rounded discount and tax (0.833458ms)\n✔ a conflict in the last room leaves all rooms intact and a retry succeeds at expiry (5.731417ms)\n✔ invalid group inputs never create bookings (0.174375ms)\n✔ pricing accepts both basis-point boundaries and validates each operand (0.150458ms)\n✔ half-up division rounds at the midpoint and rejects invalid operands (0.639709ms)\n✔ one minute at 3030 cents per hour rounds to 51 cents before tax (0.30425ms)\n✔ same-room conflicts include containment, identical slots and partial overlaps (0.30875ms)\n✔ a hold blocks overlaps until its exact expiration minute (0.179666ms)\n✔ confirming a live hold preserves its details and keeps the slot occupied past expiry (0.144459ms)\n✔ invalid hold durations and clock values leave the slot available (0.103791ms)\n✔ hold, cancellation and group notifications contain exact customer and room amounts (2.086375ms)\n✔ a failed single creation or cancellation propagates the hook error and permits retry (0.297666ms)\n✔ failure notifying the second group room leaves both slots available (0.129291ms)\n✔ a hook cannot create a conflicting booking during notification (0.067334ms)\nℹ tests 21\nℹ suites 0\nℹ pass 21\nℹ fail 0\nℹ cancelled 0\nℹ skipped 0\nℹ todo 0\nℹ duration_ms 197.105209\n","exit_code":0,"status":"completed"}}
