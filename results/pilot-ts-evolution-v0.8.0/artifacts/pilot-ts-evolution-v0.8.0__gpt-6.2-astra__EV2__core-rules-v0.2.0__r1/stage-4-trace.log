{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cd benchmarks/sources/ev2_ts_bookings && cat > tests/notifications.test.ts <<'EOF'\nimport assert from \\\"node:assert/strict\\\";\nimport test from \\\"node:test\\\";\nimport { BookingService, ConflictError, ValidationError, createGroupBooking } from \\\"../src/index.ts\\\";\nimport type { BookingNotification } from \\\"../src/index.ts\\\";\n\nconst slot = { roomId: \\\"a\\\", customerId: \\\"customer\\\", startMinute: 20, endMinute: 80 };\nconst group = { ...slot, roomIds: [\\\"a\\\", \\\"b\\\"], discountBps: 5000 };\n\nfunction setup(notifyHook: (event: BookingNotification) => void) {\n  const service = new BookingService({\n    env: { BOOKING_CANCEL_FEE_TIERS_JSON: '{\\\"cutoffMinutes\\\":0,\\\"earlyFeeBps\\\":2500,\\\"lateFeeBps\\\":5000}' },\n    notifyHook,\n  });\n  service.registerRoom({ roomId: \\\"a\\\", name: \\\"A\\\", hourlyRateCents: 100, taxBps: 1000 });\n  service.registerRoom({ roomId: \\\"b\\\", name: \\\"B\\\", hourlyRateCents: 200, taxBps: 0 });\n  return service;\n}\n\ntest(\\\"hold, cancellation and group notifications contain exact customer and room amounts\\\", () => {\n  const events: BookingNotification[] = [];\n  const service = setup(event => events.push(event));\n  const hold = service.createBooking({ ...slot, customerId: \\\" customer \\\", holdMinutes: 5 });\n  service.confirmHold(hold.bookingId, 1);\n  service.cancelBooking(hold.bookingId, 2);\n  const { bookings: [a, b] } = createGroupBooking(service, group);\n  const common = { customerId: \\\"customer\\\", roomId: \\\"a\\\" };\n  assert.deepEqual(events, [\n    { ...common, event: \\\"booking_created\\\", bookingId: hold.bookingId, amountCents: 110 },\n    { ...common, event: \\\"booking_cancelled\\\", bookingId: hold.bookingId, amountCents: 82 },\n    { ...common, event: \\\"booking_created\\\", bookingId: a.bookingId, amountCents: 55 },\n    { ...common, event: \\\"booking_created\\\", bookingId: b.bookingId, roomId: \\\"b\\\", amountCents: 100 },\n  ]);\n});\n\ntest(\\\"a failed single creation or cancellation propagates the hook error and permits retry\\\", () => {\n  const failure = new Error(\\\"notification unavailable\\\");\n  let reject = true;\n  const service = setup(() => { if (reject) throw failure; });\n  assert.throws(() => service.createBooking(slot), error => error === failure);\n  assert.deepEqual(service.listRoomBookings(\\\"a\\\"), []);\n  reject = false;\n  const booking = service.createBooking(slot);\n  reject = true;\n  assert.throws(() => service.cancelBooking(booking.bookingId, 1), error => error === failure);\n  assert.equal(service.getBooking(booking.bookingId).status, \\\"confirmed\\\");\n  assert.throws(() => service.createBooking(slot), ConflictError);\n  reject = false;\n  assert.equal(service.cancelBooking(booking.bookingId, 2).booking.status, \\\"cancelled\\\");\n});\n\ntest(\\\"failure notifying the second group room leaves both slots available\\\", () => {\n  const events: BookingNotification[] = [];\n  const failure = new Error(\\\"second notification failed\\\");\n  const service = setup(event => {\n    events.push(event);\n    if (events.length === 2) throw failure;\n  });\n  assert.throws(() => createGroupBooking(service, group), error => error === failure);\n  assert.deepEqual(events.map(event => event.roomId), [\\\"a\\\", \\\"b\\\"]);\n  for (const event of events) {\n    assert.deepEqual(service.listRoomBookings(event.roomId), []);\n    assert.throws(() => service.getBooking(event.bookingId), ValidationError);\n  }\n  assert.equal(createGroupBooking(service, group).bookings.length, 2);\n});\n\ntest(\\\"a hook cannot create a conflicting booking during notification\\\", () => {\n  const service = setup(() => {\n    assert.throws(() => service.createBooking(slot), ValidationError);\n  });\n  const booking = service.createBooking(slot);\n  assert.deepEqual(service.listRoomBookings(\\\"a\\\"), [booking]);\n});\nEOF\nnode run_checks.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
