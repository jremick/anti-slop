{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cat > benchmarks/sources/ev2_ts_bookings/tests/corporate.test.ts <<'EOF'\nimport assert from \\\"node:assert/strict\\\";\nimport test from \\\"node:test\\\";\nimport {\n  BookingService, ConflictError, ValidationError, applyDiscountAndTax, createGroupBooking,\n} from \\\"../src/index.ts\\\";\n\nconst input = {\n  roomIds: [\\\"a\\\", \\\"b\\\"], customerId: \\\"company\\\", startMinute: 40, endMinute: 70, discountBps: 5000,\n};\n\nfunction setup() {\n  const service = new BookingService({ env: {} });\n  service.registerRoom({ roomId: \\\"a\\\", name: \\\"A\\\", hourlyRateCents: 202, taxBps: 1250 });\n  service.registerRoom({ roomId: \\\"b\\\", name: \\\"B\\\", hourlyRateCents: 206, taxBps: 5000 });\n  return service;\n}\n\ntest(\\\"group totals sum each room's rounded discount and tax\\\", () => {\n  const service = setup();\n  const { groupId, bookings, ...totals } = createGroupBooking(service, input);\n  assert.ok(groupId);\n  assert.deepEqual(totals, { subtotalCents: 101, discountCents: 103, taxCents: 32, totalCents: 133 });\n  assert.deepEqual(bookings.map(b => [b.roomId, b.subtotalCents, b.discountCents, b.taxCents, b.totalCents]), [\n    [\\\"a\\\", 50, 51, 6, 56],\n    [\\\"b\\\", 51, 52, 26, 77],\n  ]);\n  for (const booking of bookings) {\n    assert.equal(booking.status, \\\"confirmed\\\");\n    assert.equal(booking.groupId, groupId);\n    assert.deepEqual(service.listRoomBookings(booking.roomId), [booking]);\n  }\n  const next = createGroupBooking(service, { ...input, startMinute: 70, endMinute: 100 });\n  assert.notEqual(next.groupId, groupId);\n});\n\ntest(\\\"a conflict in the last room leaves all rooms intact and a retry succeeds at expiry\\\", () => {\n  const service = setup();\n  const hold = service.createBooking({ ...input, roomId: \\\"b\\\", holdMinutes: 5 });\n  assert.throws(() => createGroupBooking(service, { ...input, nowMinute: 4 }), ConflictError);\n  assert.deepEqual(service.listRoomBookings(\\\"a\\\"), []);\n  assert.deepEqual(service.listRoomBookings(\\\"b\\\"), [hold]);\n  const group = createGroupBooking(service, { ...input, nowMinute: 5 });\n  assert.equal(group.bookings.length, 2);\n  assert.throws(() => createGroupBooking(service, { ...input, nowMinute: 6 }), ConflictError);\n});\n\ntest(\\\"invalid group inputs never create bookings\\\", () => {\n  const service = setup();\n  for (const overrides of [\n    { roomIds: [] }, { roomIds: [\\\"a\\\"] }, { roomIds: [\\\"a\\\", \\\"a\\\"] }, { roomIds: [\\\"a\\\", \\\"missing\\\"] },\n    { discountBps: -1 }, { discountBps: 10001 }, { discountBps: 0.5 },\n    { customerId: \\\" \\\" }, { endMinute: 40 }, { nowMinute: -1 },\n  ]) {\n    assert.throws(() => createGroupBooking(service, { ...input, ...overrides }), ValidationError);\n  }\n  assert.deepEqual(service.listRoomBookings(\\\"a\\\"), []);\n  assert.deepEqual(service.listRoomBookings(\\\"b\\\"), []);\n});\n\ntest(\\\"pricing accepts both basis-point boundaries and validates each operand\\\", () => {\n  assert.deepEqual(applyDiscountAndTax(5, 10000, 10000), {\n    subtotalCents: 0, discountCents: 5, taxCents: 0, totalCents: 0,\n  });\n  assert.deepEqual(applyDiscountAndTax(5, 0, 10000), {\n    subtotalCents: 5, discountCents: 0, taxCents: 5, totalCents: 10,\n  });\n  for (const invalid of [-1, 0.5, 10001, NaN]) {\n    assert.throws(() => applyDiscountAndTax(10, invalid, 0), ValidationError);\n    assert.throws(() => applyDiscountAndTax(10, 0, invalid), ValidationError);\n  }\n  assert.throws(() => applyDiscountAndTax(-1, 0, 0), ValidationError);\n  assert.throws(() => applyDiscountAndTax(1.5, 0, 0), ValidationError);\n});\nEOF\nnode benchmarks/sources/ev2_ts_bookings/run_checks.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
