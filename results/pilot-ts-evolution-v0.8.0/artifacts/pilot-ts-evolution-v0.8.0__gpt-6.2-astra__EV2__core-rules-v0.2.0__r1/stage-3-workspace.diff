+};
+
+function setup() {
+  const service = new BookingService({ env: {} });
+  service.registerRoom({ roomId: "a", name: "A", hourlyRateCents: 202, taxBps: 1250 });
+  service.registerRoom({ roomId: "b", name: "B", hourlyRateCents: 206, taxBps: 5000 });
+  return service;
+}
+
+test("group totals sum each room's rounded discount and tax", () => {
+  const service = setup();
+  const { groupId, bookings, ...totals } = createGroupBooking(service, input);
+  assert.ok(groupId);
+  assert.deepEqual(totals, { subtotalCents: 101, discountCents: 103, taxCents: 32, totalCents: 133 });
+  assert.deepEqual(bookings.map(b => [b.roomId, b.subtotalCents, b.discountCents, b.taxCents, b.totalCents]), [
+    ["a", 50, 51, 6, 56],
+    ["b", 51, 52, 26, 77],
+  ]);
+  for (const booking of bookings) {
+    assert.equal(booking.status, "confirmed");
+    assert.equal(booking.groupId, groupId);
+    assert.deepEqual(service.listRoomBookings(booking.roomId), [booking]);
+  }
+  const next = createGroupBooking(service, { ...input, startMinute: 70, endMinute: 100 });
+  assert.notEqual(next.groupId, groupId);
+});
+
