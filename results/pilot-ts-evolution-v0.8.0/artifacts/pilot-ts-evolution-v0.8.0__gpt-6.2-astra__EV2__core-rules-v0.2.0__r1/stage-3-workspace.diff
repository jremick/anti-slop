+
+function readTierInteger(value: unknown, field: string, maximum = Infinity): number {
+  if (typeof value !== "number" || !Number.isInteger(value) || value < 0 || value > maximum) {
+    throw new ConfigError(`Invalid ${field} in BOOKING_CANCEL_FEE_TIERS_JSON`);
