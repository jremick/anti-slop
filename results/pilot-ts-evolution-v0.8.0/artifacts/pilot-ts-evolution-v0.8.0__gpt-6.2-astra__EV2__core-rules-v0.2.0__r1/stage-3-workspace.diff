+import type { BookingService } from "./bookings.ts";
+import type { GroupBookingInput } from "./models.ts";
+
+export function createGroupBooking(service: BookingService, input: GroupBookingInput) {
+  const group = service.reserveGroup(input);
+  const totals = { subtotalCents: 0, discountCents: 0, taxCents: 0, totalCents: 0 };
+  for (const booking of group.bookings) {
+    totals.subtotalCents += booking.subtotalCents;
+    totals.discountCents += booking.discountCents;
+    totals.taxCents += booking.taxCents;
+    totals.totalCents += booking.totalCents;
+  }
+  return { ...group, ...totals };
+}

