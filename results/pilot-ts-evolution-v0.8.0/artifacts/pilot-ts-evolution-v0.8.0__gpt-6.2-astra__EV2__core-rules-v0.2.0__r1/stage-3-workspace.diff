+    assert.throws(() => roundHalfUpDiv(n, d), ValidationError);
+  }
+});
+
+test("one minute at 3030 cents per hour rounds to 51 cents before tax and deposit", () => {
+  assert.deepEqual(calculateBookingPrice(room, 1, { legacyDepositMode: true }), {
+    subtotalCents: 51, discountCents: 0, taxCents: 26, totalCents: 77, depositCents: 13,
+  });
+  for (const minutes of [0, -1, 1.5]) {
+    assert.throws(() => calculateBookingPrice(room, minutes), ValidationError);
+  }
+});
+
+test("same-room conflicts include containment, identical slots and partial overlaps", () => {
+  const service = setup();
+  service.createBooking(slot);
+  for (const [startMinute, endMinute] of [[19, 21], [29, 31], [20, 30], [22, 28], [10, 40]]) {
+    assert.equal(slotsOverlap(20, 30, startMinute, endMinute), true);
+    assert.throws(() => service.createBooking({ ...slot, startMinute, endMinute }), ConflictError);
+  }
+  for (const [startMinute, endMinute] of [[10, 20], [30, 40]]) {
+    assert.equal(slotsOverlap(20, 30, startMinute, endMinute), false);
+    service.createBooking({ ...slot, startMinute, endMinute });
+  }
+  service.registerRoom({ ...room, roomId: "b" });
+  service.createBooking({ ...slot, roomId: "b" });
+});
+
+test("a hold blocks overlaps until its exact expiration minute", () => {
+  const service = setup();
+  const hold = service.createBooking({ ...slot, holdMinutes: 5, nowMinute: 7 });
+  assert.equal(hold.status, "held");
+  assert.equal(hold.expiresAt, 12);
+  assert.equal(isBookingActiveAt(hold, 11), true);
+  assert.equal(isBookingActiveAt(hold, 12), false);
+  assert.equal(isBookingActiveAt({ ...hold, expiresAt: undefined }, 0), false);
+  assert.equal(isBookingActiveAt({ ...hold, status: "cancelled" }, 0), false);
+  assert.throws(() => service.createBooking({ ...slot, nowMinute: 11 }), ConflictError);
+  assert.throws(() => service.confirmHold(hold.bookingId, 12), ValidationError);
+  assert.equal(service.createBooking({ ...slot, nowMinute: 12 }).status, "confirmed");
+});
+
+test("confirming a live hold preserves its details and keeps the slot occupied past expiry", () => {
+  const service = setup();
+  const hold = service.createBooking({ ...slot, holdMinutes: 3 });
+  assert.equal(hold.expiresAt, 3);
+  const confirmed = service.confirmHold(hold.bookingId, 2);
+  assert.equal(confirmed.expiresAt, undefined);
+  const { expiresAt, ...originalDetails } = hold;
+  assert.deepEqual(confirmed, { ...originalDetails, status: "confirmed" });
+  assert.deepEqual(service.getBooking(hold.bookingId), confirmed);
+  assert.throws(() => service.confirmHold(hold.bookingId, 2), ValidationError);
+  assert.throws(() => service.confirmHold("missing", 2), ValidationError);
+  assert.throws(() => service.createBooking({ ...slot, nowMinute: 4 }), ConflictError);
+});
+
+test("invalid hold durations and clock values leave the slot available", () => {
+  const service = setup();
+  for (const holdMinutes of [0, -1, 1.5, 6]) {
+    assert.throws(() => service.createBooking({ ...slot, holdMinutes }), ValidationError);
+  }
+  for (const nowMinute of [-1, 0.5]) {
+    assert.throws(() => service.createBooking({ ...slot, nowMinute }), ValidationError);
+  }
+  assert.equal(service.listRoomBookings(slot.roomId).length, 0);
+});
