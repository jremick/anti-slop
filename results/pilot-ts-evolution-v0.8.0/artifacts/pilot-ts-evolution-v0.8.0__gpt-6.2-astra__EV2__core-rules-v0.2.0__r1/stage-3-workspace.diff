+  }
+  if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) {
+    throw new ConfigError("BOOKING_CANCEL_FEE_TIERS_JSON must contain an object");
+  }
+  const tiers = parsed as Record<string, unknown>;
+  return {
+    cutoffMinutes: readTierInteger(tiers.cutoffMinutes, "cutoffMinutes"),
+    earlyFeeBps: readTierInteger(tiers.earlyFeeBps, "earlyFeeBps", 10000),
+    lateFeeBps: readTierInteger(tiers.lateFeeBps, "lateFeeBps", 10000),
+  };
