{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cd benchmarks/sources/ev2_ts_bookings && cat > tests/cancellation.test.ts <<'EOF'\nimport assert from \\\"node:assert/strict\\\";\nimport test from \\\"node:test\\\";\nimport {\n  BookingService, ConfigError, ConflictError, ValidationError, computeCancellationRefund,\n  loadCancellationFeeConfig, selectCancellationFeeBps,\n} from \\\"../src/index.ts\\\";\n\nconst tiers = { cutoffMinutes: 30, earlyFeeBps: 2500, lateFeeBps: 5000 };\nconst slot = { customerId: \\\"customer\\\", roomId: \\\"a\\\", startMinute: 100, endMinute: 160 };\n\nfunction setup(env: Record<string, string | undefined>) {\n  const service = new BookingService({ env });\n  service.registerRoom({ roomId: \\\"a\\\", name: \\\"A\\\", hourlyRateCents: 100, taxBps: 100 });\n  return service;\n}\n\ntest(\\\"cancellation uses the taxed total, includes the early cutoff, and releases the slot\\\", () => {\n  for (const [nowMinute, feeBps, feeCents, refundCents] of [\n    [69, 2500, 25, 76], [70, 2500, 25, 76], [71, 5000, 51, 50], [100, 5000, 51, 50],\n  ]) {\n    const service = setup({ BOOKING_CANCEL_FEE_TIERS_JSON: JSON.stringify(tiers) });\n    const booking = service.createBooking(slot);\n    const result = service.cancelBooking(booking.bookingId, nowMinute);\n    assert.deepEqual(result, { booking: { ...booking, status: \\\"cancelled\\\" }, feeBps, feeCents, refundCents });\n    assert.deepEqual(service.getBooking(booking.bookingId), result.booking);\n    assert.throws(() => service.cancelBooking(booking.bookingId, nowMinute), ValidationError);\n    assert.equal(service.createBooking({ ...slot, nowMinute }).status, \\\"confirmed\\\");\n  }\n});\n\ntest(\\\"missing or malformed tiers keep the hold active until a valid cancellation\\\", () => {\n  const env: Record<string, string | undefined> = {};\n  const service = setup(env);\n  const hold = service.createBooking({ ...slot, holdMinutes: 10 });\n  for (const raw of [\n    undefined, \\\"\\\", \\\"  \\\", \\\"{\\\", \\\"null\\\", \\\"false\\\", \\\"2\\\", \\\"[]\\\", \\\"{}\\\",\n    ...[\n      { ...tiers, cutoffMinutes: -1 }, { ...tiers, cutoffMinutes: 0.5 },\n      { ...tiers, cutoffMinutes: undefined }, { ...tiers, earlyFeeBps: -1 },\n      { ...tiers, earlyFeeBps: 10001 }, { ...tiers, earlyFeeBps: \\\"0\\\" },\n      { ...tiers, lateFeeBps: undefined }, { ...tiers, lateFeeBps: 1.5 },\n      { ...tiers, lateFeeBps: 10001 },\n    ].map(cfg => JSON.stringify(cfg)),\n  ]) {\n    env.BOOKING_CANCEL_FEE_TIERS_JSON = raw;\n    assert.throws(() => service.cancelBooking(hold.bookingId, 1), ConfigError);\n    assert.equal(service.getBooking(hold.bookingId).status, \\\"held\\\");\n    assert.throws(() => service.createBooking({ ...slot, nowMinute: 1 }), ConflictError);\n  }\n  env.BOOKING_CANCEL_FEE_TIERS_JSON = JSON.stringify(tiers);\n  assert.equal(service.cancelBooking(hold.bookingId, 1).booking.status, \\\"cancelled\\\");\n  assert.equal(service.createBooking({ ...slot, nowMinute: 1 }).status, \\\"confirmed\\\");\n});\n\ntest(\\\"unknown bookings and invalid cancellation times fail before loading tiers\\\", () => {\n  const service = setup({});\n  const booking = service.createBooking(slot);\n  assert.throws(() => service.cancelBooking(\\\"missing\\\", 0), ValidationError);\n  for (const nowMinute of [101, -1, 0.5]) {\n    assert.throws(() => service.cancelBooking(booking.bookingId, nowMinute), ValidationError);\n  }\n  assert.equal(service.getBooking(booking.bookingId).status, \\\"confirmed\\\");\n});\n\ntest(\\\"fee helpers accept explicit zero and full fees and reject invalid amounts\\\", () => {\n  const cfg = { cutoffMinutes: 0, earlyFeeBps: 0, lateFeeBps: 10000 };\n  assert.deepEqual(loadCancellationFeeConfig({ BOOKING_CANCEL_FEE_TIERS_JSON: JSON.stringify(cfg) }), cfg);\n  assert.equal(selectCancellationFeeBps(0, cfg), 0);\n  assert.deepEqual(computeCancellationRefund(101, 0), { feeCents: 0, refundCents: 101 });\n  assert.deepEqual(computeCancellationRefund(101, 10000), { feeCents: 101, refundCents: 0 });\n  for (const [total, fee] of [[-1, 100], [1.5, 0], [0, -1], [20, 10001], [10, 3.5]]) {\n    assert.throws(() => computeCancellationRefund(total, fee), ValidationError);\n  }\n});\nEOF\nnode run_checks.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
