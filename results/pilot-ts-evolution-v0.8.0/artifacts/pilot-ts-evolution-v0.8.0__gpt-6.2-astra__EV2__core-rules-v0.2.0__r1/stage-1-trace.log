{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"cd benchmarks/sources/ev2_ts_bookings && cat > tests/holds-and-pricing.test.ts <<'EOF'\nimport assert from \\\"node:assert/strict\\\";\nimport test from \\\"node:test\\\";\nimport {\n  BookingService,\n  ConflictError,\n  ValidationError,\n  calculateBookingPrice,\n  isBookingActiveAt,\n  roundHalfUpDiv,\n  slotsOverlap,\n} from \\\"../src/index.ts\\\";\n\nconst room = { roomId: \\\"a\\\", name: \\\"Room A\\\", hourlyRateCents: 3030, taxBps: 5000 };\nconst slot = { roomId: \\\"a\\\", customerId: \\\"customer\\\", startMinute: 20, endMinute: 30 };\n\nfunction setup() {\n  const service = new BookingService({ env: { BOOKING_MAX_HOLD_MINUTES: \\\"5\\\" } });\n  service.registerRoom(room);\n  return service;\n}\n\ntest(\\\"half-up division rounds at the midpoint and rejects invalid operands\\\", () => {\n  for (const [n, d, expected] of [[0, 3, 0], [14, 10, 1], [15, 10, 2], [16, 10, 2], [5, 3, 2]]) {\n    assert.equal(roundHalfUpDiv(n, d), expected);\n  }\n  for (const [n, d] of [[-1, 2], [1.5, 2], [1, 0], [1, -2], [1, 2.5], [NaN, 2], [1, Infinity]]) {\n    assert.throws(() => roundHalfUpDiv(n, d), ValidationError);\n  }\n});\n\ntest(\\\"one minute at 3030 cents per hour rounds to 51 cents before tax and deposit\\\", () => {\n  assert.deepEqual(calculateBookingPrice(room, 1, { legacyDepositMode: true }), {\n    subtotalCents: 51, discountCents: 0, taxCents: 26, totalCents: 77, depositCents: 13,\n  });\n  for (const minutes of [0, -1, 1.5]) {\n    assert.throws(() => calculateBookingPrice(room, minutes), ValidationError);\n  }\n});\n\ntest(\\\"same-room conflicts include containment, identical slots and partial overlaps\\\", () => {\n  const service = setup();\n  service.createBooking(slot);\n  for (const [startMinute, endMinute] of [[19, 21], [29, 31], [20, 30], [22, 28], [10, 40]]) {\n    assert.equal(slotsOverlap(20, 30, startMinute, endMinute), true);\n    assert.throws(() => service.createBooking({ ...slot, startMinute, endMinute }), ConflictError);\n  }\n  for (const [startMinute, endMinute] of [[10, 20], [30, 40]]) {\n    assert.equal(slotsOverlap(20, 30, startMinute, endMinute), false);\n    service.createBooking({ ...slot, startMinute, endMinute });\n  }\n  service.registerRoom({ ...room, roomId: \\\"b\\\" });\n  service.createBooking({ ...slot, roomId: \\\"b\\\" });\n});\n\ntest(\\\"a hold blocks overlaps until its exact expiration minute\\\", () => {\n  const service = setup();\n  const hold = service.createBooking({ ...slot, holdMinutes: 5, nowMinute: 7 });\n  assert.equal(hold.status, \\\"held\\\");\n  assert.equal(hold.expiresAt, 12);\n  assert.equal(isBookingActiveAt(hold, 11), true);\n  assert.equal(isBookingActiveAt(hold, 12), false);\n  assert.equal(isBookingActiveAt({ ...hold, expiresAt: undefined }, 0), false);\n  assert.equal(isBookingActiveAt({ ...hold, status: \\\"cancelled\\\" }, 0), false);\n  assert.throws(() => service.createBooking({ ...slot, nowMinute: 11 }), ConflictError);\n  assert.throws(() => service.confirmHold(hold.bookingId, 12), ValidationError);\n  assert.equal(service.createBooking({ ...slot, nowMinute: 12 }).status, \\\"confirmed\\\");\n});\n\ntest(\\\"confirming a live hold preserves its details and keeps the slot occupied past expiry\\\", () => {\n  const service = setup();\n  const hold = service.createBooking({ ...slot, holdMinutes: 3 });\n  assert.equal(hold.expiresAt, 3);\n  const confirmed = service.confirmHold(hold.bookingId, 2);\n  assert.deepEqual(confirmed, { ...hold, status: \\\"confirmed\\\", ...{ expiresAt: undefined } });\n  assert.deepEqual(service.getBooking(hold.bookingId), confirmed);\n  assert.throws(() => service.confirmHold(hold.bookingId, 2), ValidationError);\n  assert.throws(() => service.confirmHold(\\\"missing\\\", 2), ValidationError);\n  assert.throws(() => service.createBooking({ ...slot, nowMinute: 4 }), ConflictError);\n});\n\ntest(\\\"invalid hold durations and clock values leave the slot available\\\", () => {\n  const service = setup();\n  for (const holdMinutes of [0, -1, 1.5, 6]) {\n    assert.throws(() => service.createBooking({ ...slot, holdMinutes }), ValidationError);\n  }\n  for (const nowMinute of [-1, 0.5]) {\n    assert.throws(() => service.createBooking({ ...slot, nowMinute }), ValidationError);\n  }\n  assert.equal(service.listRoomBookings(slot.roomId).length, 0);\n});\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('tests/holds-and-pricing.test.ts')\np.write_text(p.read_text().replace('  assert.deepEqual(confirmed, { ...hold, status: \\\"confirmed\\\", ...{ expiresAt: undefined } });','  assert.equal(confirmed.expiresAt, undefined);\\\\n  const { expiresAt, ...originalDetails } = hold;\\\\n  assert.deepEqual(confirmed, { ...originalDetails, status: \\\"confirmed\\\" });'))\nPY\nnode run_checks.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
