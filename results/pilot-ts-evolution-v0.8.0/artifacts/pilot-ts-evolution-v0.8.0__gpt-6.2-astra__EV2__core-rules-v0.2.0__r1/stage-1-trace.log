ing.status \"'!== \"held\" || !isBookingActiveAt(booking, nowMinute)) {\n      throw new ValidationError(`Booking ${bookingId} is not an active hold`);\n    }\n    const { expiresAt, ...details } = booking;\n    const confirmed: Booking = { ...details, status: \"confirmed\" };\n    this.bookings.set(bookingId, confirmed);\n    return confirmed;\n  }\n}\n'\"''')\np=Path('src/models.ts')\np.write_text(p.read_text().replace('  readonly legacyDepositMode?', '  readonly nowMinute?: number;\\\\n  readonly holdMinutes?: number;\\\\n  readonly legacyDepositMode?'))\np=Path('src/pricing.ts')\ns=p.read_text().replace('export function computeTaxCents','''export function roundHalfUpDiv(numerator: number, denominator: number): number {\n  validateNonNegativeInt(numerator, \\\"numerator\\\");\n  validatePositiveInt(denominator, \\\"denominator\\\");\n  return Math.floor((numerator * 2 + denominator) / (2 * denominator));\n}\n\nexport function computeTaxCents''')\np.write_text(s[:s.index('  if (durationMinutes')]+'  const subtotalCents = roundHalfUpDiv(room.hourlyRateCents * durationMinutes, 60);\\\\n'+s[s.index('  const taxCents'):])\np=Path('src/index.ts')\np.write_text(p.read_text().replace('  computeTaxCents,','  computeTaxCents,\\\\n  roundHalfUpDiv,').replace('{ BookingService }','{ BookingService, isBookingActiveAt, slotsOverlap }'))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
