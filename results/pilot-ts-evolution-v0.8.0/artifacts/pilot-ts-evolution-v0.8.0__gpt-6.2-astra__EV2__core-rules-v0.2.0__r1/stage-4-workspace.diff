+  assert.deepEqual(bookings.map(b => [b.roomId, b.subtotalCents, b.discountCents, b.taxCents, b.totalCents]), [
+    ["a", 50, 51, 6, 56],
+    ["b", 51, 52, 26, 77],
+  ]);
+  for (const booking of bookings) {
+    assert.equal(booking.status, "confirmed");
+    assert.equal(booking.groupId, groupId);
+    assert.deepEqual(service.listRoomBookings(booking.roomId), [booking]);
+  }
+  const next = createGroupBooking(service, { ...input, startMinute: 70, endMinute: 100 });
+  assert.notEqual(next.groupId, groupId);
+});
+
+test("a conflict in the last room leaves all rooms intact and a retry succeeds at expiry", () => {
+  const service = setup();
+  const hold = service.createBooking({ ...input, roomId: "b", holdMinutes: 5 });
+  assert.throws(() => createGroupBooking(service, { ...input, nowMinute: 4 }), ConflictError);
+  assert.deepEqual(service.listRoomBookings("a"), []);
+  assert.deepEqual(service.listRoomBookings("b"), [hold]);
+  const group = createGroupBooking(service, { ...input, nowMinute: 5 });
+  assert.equal(group.bookings.length, 2);
+  assert.throws(() => createGroupBooking(service, { ...input, nowMinute: 6 }), ConflictError);
+});
+
+test("invalid group inputs never create bookings", () => {
+  const service = setup();
+  for (const overrides of [
+    { roomIds: [] }, { roomIds: ["a"] }, { roomIds: ["a", "a"] }, { roomIds: ["a", "missing"] },
+    { discountBps: -1 }, { discountBps: 10001 }, { discountBps: 0.5 },
+    { customerId: " " }, { endMinute: 40 }, { nowMinute: -1 },
+  ]) {
+    assert.throws(() => createGroupBooking(service, { ...input, ...overrides }), ValidationError);
+  }
+  assert.deepEqual(service.listRoomBookings("a"), []);
+  assert.deepEqual(service.listRoomBookings("b"), []);
+});
+
+test("pricing accepts both basis-point boundaries and validates each operand", () => {
+  assert.deepEqual(applyDiscountAndTax(5, 10000, 10000), {
+    subtotalCents: 0, discountCents: 5, taxCents: 0, totalCents: 0,
+  });
+  assert.deepEqual(applyDiscountAndTax(5, 0, 10000), {
+    subtotalCents: 5, discountCents: 0, taxCents: 5, totalCents: 10,
+  });
+  for (const invalid of [-1, 0.5, 10001, NaN]) {
+    assert.throws(() => applyDiscountAndTax(10, invalid, 0), ValidationError);
+    assert.throws(() => applyDiscountAndTax(10, 0, invalid), ValidationError);
+  }
+  assert.throws(() => applyDiscountAndTax(-1, 0, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1.5, 0, 0), ValidationError);
+});

