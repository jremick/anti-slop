+import assert from "node:assert/strict";
+import test from "node:test";
+import { BookingService, ConflictError, createGroupBooking } from "../src/index.ts";
+import type { BookingNotification } from "../src/index.ts";
+
+const slot = { customerId: "client", startMinute: 100, endMinute: 160 };
+const group = { ...slot, roomIds: ["a", "b"], discountBps: 5000 };
+
+function setup(notifyHook: (event: BookingNotification) => void) {
+  const service = new BookingService({
+    notifyHook,
+    env: { BOOKING_CANCEL_FEE_TIERS_JSON: '{"cutoffMinutes":0,"earlyFeeBps":5000,"lateFeeBps":0}' },
+  });
+  service.registerRoom({ roomId: "a", name: "Studio", hourlyRateCents: 100, taxBps: 100 });
+  service.registerRoom({ roomId: "b", name: "Hall", hourlyRateCents: 200, taxBps: 0 });
+  return service;
+}
+
+test("creation reports each booking total and cancellation reports the refund", () => {
+  const events: BookingNotification[] = [];
+  const service = setup(event => events.push(event));
+  const held = service.createBooking({ ...slot, customerId: " client ", roomId: "a", holdMinutes: 5 });
+  service.confirmHold(held.bookingId, 1);
+  service.cancelBooking(held.bookingId, 2);
+  const { bookings: [studio, hall] } = createGroupBooking(service, group);
+  assert.deepEqual(events, [
+    { event: "booking_created", bookingId: held.bookingId, roomId: "a", customerId: "client", amountCents: 101 },
+    { event: "booking_cancelled", bookingId: held.bookingId, roomId: "a", customerId: "client", amountCents: 50 },
+    { event: "booking_created", bookingId: studio.bookingId, roomId: "a", customerId: "client", amountCents: 51 },
+    { event: "booking_created", bookingId: hall.bookingId, roomId: "b", customerId: "client", amountCents: 100 },
+  ]);
+});
+
+test("a throwing creation hook leaves the slot available for retry", () => {
+  const failure = new Error("delivery failed");
+  let reject = true;
+  const service = setup(() => { if (reject) throw failure; });
+  const create = () => service.createBooking({ ...slot, roomId: "a" });
+  assert.throws(create, error => error === failure);
+  assert.deepEqual(service.listRoomBookings("a"), []);
+  reject = false;
+  assert.equal(create().status, "confirmed");
+});
+
+test("failure on the second group notification leaves neither room booked", () => {
+  const failure = new Error("hall notification failed");
+  const rooms: string[] = [];
+  const service = setup(event => {
+    rooms.push(event.roomId);
+    if (event.roomId === "b") throw failure;
+  });
+  const earlier = service.createBooking({ ...slot, roomId: "a", startMinute: 0, endMinute: 60 });
+  assert.throws(() => createGroupBooking(service, group), error => error === failure);
+  assert.deepEqual(rooms, ["a", "a", "b"]);
+  assert.deepEqual(service.listRoomBookings("a"), [earlier]);
+  assert.deepEqual(service.listRoomBookings("b"), []);
+});
+
+test("a throwing cancellation hook preserves the active hold and its expiry", () => {
+  const failure = new Error("refund notification failed");
+  const service = setup(event => {
+    if (event.event === "booking_cancelled") throw failure;
+  });
+  const booking = service.createBooking({ ...slot, roomId: "a", holdMinutes: 5 });
+  assert.throws(() => service.cancelBooking(booking.bookingId, 1), error => error === failure);
+  assert.deepEqual(service.getBooking(booking.bookingId), booking);
+  assert.throws(() => service.createBooking({ ...slot, roomId: "a", nowMinute: 1 }), ConflictError);
+  assert.equal(service.getBooking(booking.bookingId).expiresAt, 5);
+});

