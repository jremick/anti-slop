+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  BookingService, ConflictError, ValidationError, applyDiscountAndTax, createGroupBooking,
+} from "../src/index.ts";
+
+const input = {
+  customerId: "team", roomIds: ["a", "b"], startMinute: 20, endMinute: 50, discountBps: 5000,
+};
+
+function setup() {
+  const service = new BookingService({ env: {} });
+  service.registerRoom({ roomId: "a", name: "Studio", hourlyRateCents: 201, taxBps: 2500 });
+  service.registerRoom({ roomId: "b", name: "Hall", hourlyRateCents: 205, taxBps: 5000 });
+  return service;
+}
+
+test("group totals sum each room's rounded discount and tax", () => {
+  const service = setup();
+  const { groupId, bookings, ...totals } = createGroupBooking(service, input);
+  assert.deepEqual(totals, { subtotalCents: 101, discountCents: 103, taxCents: 39, totalCents: 140 });
+  assert.deepEqual(bookings.map(({ roomId, subtotalCents, discountCents, taxCents, totalCents }) =>
+    [roomId, subtotalCents, discountCents, taxCents, totalCents]), [
+    ["a", 50, 51, 13, 63],
+    ["b", 51, 52, 26, 77],
+  ]);
+  for (const booking of bookings) {
+    assert.equal(booking.groupId, groupId);
+    assert.equal(booking.status, "confirmed");
+    assert.deepEqual(service.listRoomBookings(booking.roomId), [booking]);
+    assert.throws(() => service.createBooking({ ...input, roomId: booking.roomId }), ConflictError);
+  }
+  const adjacent = createGroupBooking(service, { ...input, startMinute: 50, endMinute: 60 });
+  assert.notEqual(adjacent.groupId, groupId);
+});
+
+test("an active hold in the last room blocks the entire group until expiry", () => {
+  const service = setup();
+  const hold = service.createBooking({ ...input, roomId: "b", holdMinutes: 5 });
+  assert.throws(() => createGroupBooking(service, { ...input, nowMinute: 4 }), ConflictError);
+  assert.deepEqual(service.listRoomBookings("a"), []);
+  assert.deepEqual(service.listRoomBookings("b"), [hold]);
+  assert.equal(createGroupBooking(service, { ...input, nowMinute: 5 }).bookings.length, 2);
+});
+
+test("invalid group input leaves all rooms available", () => {
+  const service = setup();
+  for (const fields of [
