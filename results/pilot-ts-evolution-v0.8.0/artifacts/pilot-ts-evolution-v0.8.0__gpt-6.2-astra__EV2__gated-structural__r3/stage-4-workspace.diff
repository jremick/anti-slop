+import assert from "node:assert/strict";
+import test from "node:test";
+import { ValidationError, calculateBookingPrice, roundHalfUpDiv } from "../src/index.ts";
+
+test("half-up division handles zero and values around a tie", () => {
+  assert.equal(roundHalfUpDiv(0, 3), 0);
+  assert.equal(roundHalfUpDiv(149, 100), 1);
+  assert.equal(roundHalfUpDiv(150, 100), 2);
+  assert.equal(roundHalfUpDiv(151, 100), 2);
+  for (const [n, d] of [[-1, 2], [1.5, 2], [1, 0], [1, -2], [1, 2.5]]) {
+    assert.throws(() => roundHalfUpDiv(n, d), ValidationError);
+  }
+});
+
+test("fractional hours round to cents before tax", () => {
+  const room = { roomId: "a", name: "Studio", hourlyRateCents: 30, taxBps: 5000 };
+  assert.deepEqual(calculateBookingPrice(room, 61), {
+    subtotalCents: 31, taxCents: 16, totalCents: 47, discountCents: 0,
+  });
+  for (const duration of [0, -1, 0.5]) {
+    assert.throws(() => calculateBookingPrice(room, duration), ValidationError);
+  }
+});
+
+test("public API and pricing module expose no deposit exports", async () => {
+  for (const api of [await import("../src/index.ts"), await import("../src/pricing.ts")]) {
+    assert.deepEqual(Object.keys(api).filter(name => /deposit/i.test(name)), []);
+  }
+});
