+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  BookingService, ConfigError, ConflictError, ValidationError, computeCancellationRefund,
+  loadCancellationFeeConfig, selectCancellationFeeBps,
+} from "../src/index.ts";
+
+const tiers = { cutoffMinutes: 30, earlyFeeBps: 0, lateFeeBps: 5000 };
+const slot = { roomId: "hall", customerId: "guest", startMinute: 100, endMinute: 160 };
+
+function setup(env: Record<string, string | undefined>) {
+  const service = new BookingService({ env });
+  service.registerRoom({ roomId: "hall", name: "Hall", hourlyRateCents: 100, taxBps: 100 });
+  return service;
+}
+
+test("cancellation selects the tier at the cutoff and rounds fees on the tax-inclusive total", () => {
+  for (const [nowMinute, feeBps, feeCents, refundCents] of [
+    [69, 0, 0, 101],
+    [70, 0, 0, 101],
+    [71, 5000, 51, 50],
+    [100, 5000, 51, 50],
+  ]) {
+    const service = setup({ BOOKING_CANCEL_FEE_TIERS_JSON: JSON.stringify(tiers) });
+    const booking = service.createBooking(slot);
+    const result = service.cancelBooking(booking.bookingId, nowMinute);
+    assert.deepEqual(result, {
+      booking: { ...booking, status: "cancelled" }, feeBps, feeCents, refundCents,
+    });
+    assert.deepEqual(service.getBooking(booking.bookingId), result.booking);
+    assert.throws(() => service.cancelBooking(booking.bookingId, nowMinute), ValidationError);
+    assert.equal(service.createBooking({ ...slot, nowMinute }).status, "confirmed");
+  }
+});
+
+test("missing or malformed tiers preserve the booking and its slot until config is corrected", () => {
+  const env: Record<string, string | undefined> = {};
+  const service = setup(env);
+  const booking = service.createBooking(slot);
+  for (const raw of [
+    undefined, "", "  ", "{", "null", "false", "[]", "{}",
+    JSON.stringify({ cutoffMinutes: 30, earlyFeeBps: 0 }),
+    ...[
+      { cutoffMinutes: -1 }, { cutoffMinutes: 1.5 }, { earlyFeeBps: "0" },
+      { earlyFeeBps: -1 }, { lateFeeBps: 10001 }, { lateFeeBps: 0.5 },
+    ].map(fields => JSON.stringify({ ...tiers, ...fields })),
+  ]) {
+    env.BOOKING_CANCEL_FEE_TIERS_JSON = raw;
+    assert.throws(() => service.cancelBooking(booking.bookingId, 0), ConfigError);
+    assert.equal(service.getBooking(booking.bookingId).status, "confirmed");
+    assert.throws(() => service.createBooking(slot), ConflictError);
+  }
+
+  env.BOOKING_CANCEL_FEE_TIERS_JSON = JSON.stringify(tiers);
+  assert.equal(service.cancelBooking(booking.bookingId, 0).refundCents, 101);
+});
+
+test("invalid cancellation requests are rejected before reading the fee config", () => {
+  const service = setup({});
+  const booking = service.createBooking(slot);
+  assert.throws(() => service.cancelBooking("unknown", 0), ValidationError);
+  assert.throws(() => service.cancelBooking(booking.bookingId, 101), ValidationError);
+  assert.equal(service.getBooking(booking.bookingId).status, "confirmed");
+});
+
+test("zero cutoff and full fees are valid, and refund inputs must be in range", () => {
+  const cfg = { cutoffMinutes: 0, earlyFeeBps: 10000, lateFeeBps: 0 };
+  const loaded = loadCancellationFeeConfig({ BOOKING_CANCEL_FEE_TIERS_JSON: JSON.stringify(cfg) });
+  assert.deepEqual(loaded, cfg);
+  assert.deepEqual(computeCancellationRefund(101, selectCancellationFeeBps(0, loaded)), {
+    feeCents: 101, refundCents: 0,
+  });
+  for (const [total, rate] of [[-1, 0], [0.1, 0], [100, -1], [100, 1.5], [100, 10001]]) {
+    assert.throws(() => computeCancellationRefund(total, rate), ValidationError);
+  }
+});

