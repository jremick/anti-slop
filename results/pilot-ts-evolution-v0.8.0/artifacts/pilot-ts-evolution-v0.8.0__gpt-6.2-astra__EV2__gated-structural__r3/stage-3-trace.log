yDeposit', '''export function computeCancellationRefund(totalCents: number, feeBps: number) {\n  validateNonNegativeInt(totalCents, \\\"totalCents\\\");\n  validateBasisPoints(feeBps, \\\"feeBps\\\");\n  const feeCents = roundHalfUpDiv(totalCents * feeBps, 10000);\n  return { feeCents, refundCents: totalCents - feeCents };\n}\n\nexport function calculateLegacyDeposit''')\np.write_text(s)\np=Path('bookings.ts')\ns=p.read_text().replace('{ loadBookingConfig }','{ loadBookingConfig, loadCancellationFeeConfig, selectCancellationFeeBps }').replace('calculateBookingPrice, validateBasisPoints','calculateBookingPrice, computeCancellationRefund, validateBasisPoints').replace('  readonly config: BookingConfig;', '  readonly config: BookingConfig;\\\\n  private readonly env: BookingServiceOptions[\\\"env\\\"];').replace('    this.config = loadBookingConfig(options.env);','    this.env = options.env;\\\\n    this.config = loadBookingConfig(this.env);')\ns=s.replace('  confirmHold(','''  cancelBooking(bookingId: string, nowMinute: number) {\n    validateNonNegativeInt(nowMinute, \\\"nowMinute\\\");\n    const booking = this.getBooking(bookingId);\n    if (booking.status === \\\"cancelled\\\") {\n      throw new ValidationError(\"'`Booking ${bookingId} is already cancelled`);\n    }\n    if (nowMinute > booking.startMinute) {\n      throw new ValidationError(\"Cannot cancel after the booking start minute\");\n    }\n    const tiers = loadCancellationFeeConfig(this.env);\n    const feeBps = selectCancellationFeeBps(booking.startMinute - nowMinute, tiers);\n    const refund = computeCancellationRefund(booking.totalCents, feeBps);\n    const cancelled: Booking = { ...booking, status: \"cancelled\", expiresAt: undefined };\n    this.bookings.set(bookingId, cancelled);\n    return { booking: cancelled, feeBps, ...refund };\n  }\n\n  confirmHold('\"''')\np.write_text(s)\np=Path('index.ts')\np.write_text(p.read_text().replace('  loadBookingConfig,','  loadBookingConfig,\\\\n  loadCancel