ing_created\\\", bookingId: hall.bookingId, roomId: \\\"b\\\", customerId: \\\"client\\\", amountCents: 100 },\n  ]);\n});\n\ntest(\\\"a throwing creation hook leaves the slot available for retry\\\", () => {\n  const failure = new Error(\\\"delivery failed\\\");\n  let reject = true;\n  const service = setup(() => { if (reject) throw failure; });\n  const create = () => service.createBooking({ ...slot, roomId: \\\"a\\\" });\n  assert.throws(create, error => error === failure);\n  assert.deepEqual(service.listRoomBookings(\\\"a\\\"), []);\n  reject = false;\n  assert.equal(create().status, \\\"confirmed\\\");\n});\n\ntest(\\\"failure on the second group notification leaves neither room booked\\\", () => {\n  const failure = new Error(\\\"hall notification failed\\\");\n  const rooms: string[] = [];\n  const service = setup(event => {\n    rooms.push(event.roomId);\n    if (event.roomId === \\\"b\\\") throw failure;\n  });\n  const earlier = service.createBooking({ ...slot, roomId: \\\"a\\\", startMinute: 0, endMinute: 60 });\n  assert.throws(() => createGroupBooking(service, group), error => error === failure);\n  assert.deepEqual(rooms, [\\\"a\\\", \\\"a\\\", \\\"b\\\"]);\n  assert.deepEqual(service.listRoomBookings(\\\"a\\\"), [earlier]);\n  assert.deepEqual(service.listRoomBookings(\\\"b\\\"), []);\n});\n\ntest(\\\"a throwing cancellation hook preserves the active hold and its expiry\\\", () => {\n  const failure = new Error(\\\"refund notification failed\\\");\n  const service = setup(event => {\n    if (event.event === \\\"booking_cancelled\\\") throw failure;\n  });\n  const booking = service.createBooking({ ...slot, roomId: \\\"a\\\", holdMinutes: 5 });\n  assert.throws(() => service.cancelBooking(booking.bookingId, 1), error => error === failure);\n  assert.deepEqual(service.getBooking(booking.bookingId), booking);\n  assert.throws(() => service.createBooking({ ...slot, roomId: \\\"a\\\", nowMinute: 1 }), ConflictError);\n  assert.equal(service.getBooking(booking.bookingId).expiresAt, 5);\n});\nEOF\ncd ../../..\nnode benchmarks/sources/ev2_ts_bookings/run_checks.mjs\"","aggregated_output":"✔ baseline whole-hour booking computes exact subtotal and tax (1.126ms)\n✔ baseline rejects invalid room or inverted time range (0.392291ms)\n✔ cancellation selects the tier at the cutoff and rounds fees on the tax-inclusive total (1.562958ms)\n✔ missing or malformed tiers preserve the booking and its slot until config is corrected (0.341708ms)\n✔ invalid cancellation requests are rejected before reading the fee config (0.106292ms)\n✔ zero cutoff and full fees are valid, and refund inputs must be in range (0.123042ms)\n✔ group totals sum each room's rounded discount and tax (2.543709ms)\n✔ an active hold in the last room blocks the entire group until expiry (0.287833ms)\n✔ invalid group input leaves all rooms available (0.292334ms)\n✔ pricing accepts inclusive rate bounds and rejects invalid cents and rates (0.187334ms)\n✔ confirmed bookings conflict for every overlap shape and allow adjacent slots (1.351417ms)\n✔ a hold releases its slot at the exact expiration minute (0.178125ms)\n✔ confirmation preserves the booking and keeps the slot past the original expiry (0.4175ms)\n✔ invalid hold lengths leave the room available (0.108583ms)\n✔ creation reports each booking total and cancellation reports the refund (3.515875ms)\n✔ a throwing creation hook leaves the slot available for retry (0.538ms)\n✔ failure on the second group notification leaves neither room booked (0.270125ms)\n✔ a throwing cancellation hook preserves the active hold and its expiry (0.334ms)\n✔ half-up division handles zero and values around a tie (0.758917ms)\n✔ fractional hours round to cents before tax (0.41175ms)\n✔ public API and pricing module expose no deposit exports (0.422ms)\nℹ tests 21\nℹ suites 0\nℹ pass 21\nℹ fail 0\nℹ cancelled 0\nℹ skipped 0\nℹ todo 0\nℹ duration_ms 249.812709\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"agent_message","text":"Removed the legacy deposit option, calculation, fields, and exports. The optional `notifyHook` now receives each booking’s total on creation and the refund amount on cancellation.\n\nBooking changes commit only after all required hooks succeed. If a hook throws, its error propagates, a failed group creates zero bookings, and a failed cancellation preserves the original booking. The service rejects nested notifications. For groups, an earlier hook may already have run when a later hook fails.\n\n`node benchmarks/sources/ev2_ts_bookings/run_checks.mjs` exited 0. All 21 tests passed."}}
