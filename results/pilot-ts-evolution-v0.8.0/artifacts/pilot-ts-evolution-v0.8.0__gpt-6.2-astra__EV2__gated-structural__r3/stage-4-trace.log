\"string\" || room.name.trim() === \"\") {\n      throw new ValidationError(\"name must be a non-empty string\");\n    }\n    validatePositiveInt(room.hourlyRateCents, \"hourlyRateCents\");\n    validateBasisPoints(room.taxBps, \"taxBps\");\n    this.rooms.set(room.roomId, room);\n  }\n\n  getRoom(roomId: string): Room {\n    const room = this.rooms.get(roomId);\n    if (room === undefined) {\n      throw new ValidationError(`Unknown roomId: ${roomId}`);\n    }\n    return room;\n  }\n\n  getBooking(bookingId: string): Booking {\n    const booking = this.bookings.get(bookingId);\n    if (booking === undefined) {\n      throw new ValidationError(`Unknown bookingId: ${bookingId}`);\n    }\n    return booking;\n  }\n\n  listRoomBookings(roomId: string): Booking[] {\n    this.getRoom(roomId);\n    const matches: Booking[] = [];\n    for (const booking of this.bookings.values()) {\n      if (booking.roomId === roomId) {\n        matches.push(booking);\n      }\n    }\n    return matches;\n  }\n\n  private prepareBooking(input: CreateBookingInput, discountBps: number): Omit<Booking, \"bookingId\"> {\n    if (typeof input.customerId !== \"string\" || input.customerId.trim() === \"\") {\n      throw new ValidationError(\"customerId must be a non-empty string\");\n    }\n    validateNonNegativeInt(input.startMinute, \"startMinute\");\n    validatePositiveInt(input.endMinute, \"endMinute\");\n    if (input.endMinute <= input.startMinute) {\n      throw new ValidationError(\"endMinute must be strictly greater than startMinute\");\n    }\n    const room = this.getRoom(input.roomId);\n    const { nowMinute = 0, holdMinutes } = input;\n    validateNonNegativeInt(nowMinute, \"nowMinute\");\n    if (holdMinutes !== undefined) {\n      validatePositiveInt(holdMinutes, \"holdMinutes\");\n      if (holdMinutes > this.config.maxHoldMinutes) {\n        throw new ValidationError(\"holdMinutes exceeds the configured maximum\");\n      }\n    }\n    for (const booking of this.bookings.values()) {\n      if (booking.roomId === room.roomId && isBookingActiveAt(booking, nowMinute) &&\n          slotsOverlap(input.startMinute, input.endMinute, booking.startMinute, booking.endMinute)) {\n        throw new ConflictError(`Room ${room.roomId} already has an active booking for this slot`);\n      }\n    }\n    const duration = input.endMinute - input.startMinute;\n    const price = calculateBookingPrice(room, duration, {\n      discountBps,\n      legacyDepositMode: input.legacyDepositMode,\n    });\n    return {\n      ...price,\n      roomId: room.roomId,\n      customerId: input.customerId.trim(),\n      startMinute: input.startMinute,\n      endMinute: input.endMinute,\n      status: holdMinutes === undefined ? \"confirmed\" : \"held\",\n      expiresAt: holdMinutes === undefined ? undefined : nowMinute + holdMinutes,\n    };\n  }\n\n  private storeBooking(draft: Omit<Booking, \"bookingId\">): Booking {\n    const booking = { ...draft, bookingId: this.nextId(\"bkg\") };\n    this.bookings.set(booking.bookingId, booking);\n    return booking;\n  }\n\n  createBooking(input: CreateBookingInput): Booking {\n    return this.storeBooking(this.prepareBooking(input, 0));\n  }\n\n  reserveGroupRooms(input: CreateGroupBookingInput) {\n    const { roomIds, discountBps, customerId, startMinute, endMinute, nowMinute } = input;\n    if (!Array.isArray(roomIds) || roomIds.length < 2) {\n      throw new ValidationError(\"A group booking requires at least two rooms\");\n    }\n    if (new Set(roomIds).size !== roomIds.length) {\n      throw new ValidationError(\"A group booking requires distinct rooms\");\n    }\n    validateBasisPoints(discountBps, \"discountBps\");\n    const drafts = Array.from(roomIds, roomId =>\n      this.prepareBooking({ roomId, customerId, startMinute, endMinute, nowMinute }, discountBps)\n    );\n    const groupId = this.nextId(\"grp\");\n    const bookings = drafts.map(draft => this.storeBooking({ ...draft, groupId }));\n    return { groupId, bookings };\n  }\n\n  cancelBooking(bookingId: string, nowMinute: number) {\n    validateNonNegativeInt(nowMinute, \"nowMinute\");\n    const booking = this.getBooking(bookingId);\n    if (booking.status === \"cancelled\") {\n      throw new ValidationError(`Booking ${bookingId} is already cancelled`);\n    }\n    if (nowMinute > booking.startMinute) {\n      throw new ValidationError(\"Cannot cancel after the booking start minute\");\n    }\n    const tiers = loadCancellationFeeConfig(this.env);\n    const feeBps = selectCancellationFeeBps(booking.startMinute - nowMinute, tiers);\n    const refund = computeCancellationRefund(booking.totalCents, feeBps);\n    const cancelled: Booking = { ...booking, status: \"cancelled\", expiresAt: undefined };\n    this.bookings.set(bookingId, cancelled);\n    return { booking: cancelled, feeBps, ...refund };\n  }\n\n  confirmHold(bookingId: string, nowMinute: number): Booking {\n    validateNonNegativeInt(nowMinute, \"nowMinute\");\n    const booking = this.getBooking(bookingId);\n    if (booking.status !== \"held\" || !isBookingActiveAt(booking, nowMinute)) {\n      throw new ValidationError(`Booking ${bookingId} is not an active hold`);\n    }\n    const confirmed: Booking = { ...booking, status: \"confirmed\", expiresAt: undefined };\n    this.bookings.set(bookingId, confirmed);\n    return confirmed;\n  }\n}\nimport { ValidationError } from \"./models.ts\";\nimport type { PriceBreakdown, Room } from \"./models.ts\";\n\nexport const LEGACY_DEPOSIT_BPS = 2500;\n\nexport function validateNonNegativeInt(value: number, fieldName: string): number {\n  if (!Number.isInteger(value) || value < 0) {\n    throw new ValidationError(`${fieldName} must be a non-negative integer`);\n  }\n  return value;\n}\n\nexport function validatePositiveInt(value: number, fieldName: string): number {\n  if (!Number.isInteger(value) || value <= 0) {\n    throw new ValidationError(`${fieldName} must be a positive integer`);\n  }\n  return value;\n}\n\nexport function roundHalfUpDiv(numerator: number, denominator: number): number {\n  validateNonNegativeInt(numerator, \"numerator\");\n  validatePositiveInt(denominator, \"denominator\");\n  return Math.floor((numerator * 2 + denominator) / (2 * denominator));\n}\n\nexport function validateBasisPoints(value: number, fieldName: string): void {\n  validateNonNegativeInt(value, fieldName);\n  if (value > 10000) {\n    throw new ValidationError(`${fieldName} cannot exceed 10000`);\n  }\n}\n\nexport function computeTaxCents(taxableCents: number, taxBps: number): number {\n  validateNonNegativeInt(taxableCents, \"taxableCents\");\n  validateBasisPoints(taxBps, \"taxBps\");\n  return roundHalfUpDiv(taxableCents * taxBps, 10000);\n}\n\nexport function applyDiscountAndTax(grossSubtotalCents: number, discountBps: number, taxBps: number) {\n  validateNonNegativeInt(grossSubtotalCents, \"grossSubtotalCents\");\n  validateBasisPoints(discountBps, \"discountBps\");\n  const discountCents = roundHalfUpDiv(grossSubtotalCents * discountBps, 10000);\n  const subtotalCents = grossSubtotalCents - discountCents;\n  const taxCents = computeTaxCents(subtotalCents, taxBps);\n  return { subtotalCents, discountCents, taxCents, totalCents: subtotalCents + taxCents };\n}\n\nexport function computeCancellationRefund(totalCents: number, feeBps: number) {\n  validateNonNegativeInt(totalCents, \"totalCents\");\n  validateBasisPoints(feeBps, \"feeBps\");\n  const feeCents = roundHalfUpDiv(totalCents * feeBps, 10000);\n  return { feeCents, refundCents: totalCents - feeCents };\n}\n\nexport function calculateLegacyDeposit(subtotalCents: number): number {\n  validateNonNegativeInt(subtotalCents, \"subtotalCents\");\n  return Math.floor((subtotalCents * LEGACY_DEPOSIT_BPS + 5000) / 10000);\n}\n\nexport function calculateBookingPrice(\n  room: Room,\n  durationMinutes: number,\n  options?: { readonly legacyDepositMode?: boolean; readonly discountBps?: number },\n): PriceBreakdown {\n  validatePositiveInt(room.hourlyRateCents, \"hourlyRateCents\");\n  validatePositiveInt(durationMinutes, \"durationMinutes\");\n  const grossSubtotalCents = roundHalfUpDiv(room.hourlyRateCents * durationMinutes, 60);\n  const { discountBps = 0 } = options ?? {};\n  const price = applyDiscountAndTax(grossSubtotalCents, discountBps, room.taxBps);\n  const depositCents = options?.legacyDepositMode === true\n    ? calculateLegacyDeposit(price.subtotalCents)\n    : 0;\n  return { ...price, depositCents };\n}\nexport {\n  BookingError,\n  ConfigError,\n  ConflictError,\n  ValidationError,\n} from \"./models.ts\";\nexport type {\n  Booking,\n  BookingStatus,\n  CreateBookingInput,\n  CreateGroupBookingInput,\n  PriceBreakdown,\n  Room,\n} from \"./models.ts\";\nexport {\n  DEFAULT_MAX_HOLD_MINUTES,\n  loadBookingConfig,\n  loadCancellationFeeConfig,\n  selectCancellationFeeBps,\n} from \"./config.ts\";\nexport type { BookingConfig, CancellationFeeConfig } from \"./config.ts\";\nexport {\n  LEGACY_DEPOSIT_BPS,\n  applyDiscountAndTax,\n  calculateBookingPrice,\n  calculateLegacyDeposit,\n  computeCancellationRefund,\n  computeTaxCents,\n  roundHalfUpDiv,\n  validateNonNegativeInt,\n  validatePositiveInt,\n} from \"./pricing.ts\";\nexport { BookingService, isBookingActiveAt, slotsOverlap } from \"./bookings.ts\";\nexport type { BookingServiceOptions } from \"./bookings.ts\";\nexport { createGroupBooking } from \"./corporate.ts\";\nexport class BookingError extends Error {\n  constructor(message: string) {\n    super(message);\n    this.name = \"BookingError\";\n  }\n}\n\nexport class ValidationError extends BookingError {\n  constructor(message: string) {\n    super(message);\n    this.name = \"ValidationError\";\n  }\n}\n\nexport class ConflictError extends BookingError {\n  constructor(message: string) {\n    super(message);\n    this.name = \"ConflictError\";\n  }\n}\n\nexport class ConfigError extends BookingError {\n  constructor(message: string) {\n    super(message);\n    this.name = \"ConfigError\";\n  }\n}\n\nexport type BookingStatus = \"confirmed\" | \"held\" | \"cancelled\";\n\nexport interface Room {\n  readonly roomId: string;\n  readonly name: string;\n  readonly hourlyRateCents: number;\n  readonly taxBps: number;\n}\n\nexport interface PriceBreakdown {\n  readonly subtotalCents: number;\n  readonly discountCents: number;\n  readonly taxCents: number;\n  readonly totalCents: number;\n  readonly depositCents: number;\n}\n\nexport interface Booking {\n  readonly bookingId: string;\n  readonly roomId: string;\n  readonly customerId: string;\n  readonly startMinute: number;\n  readonly endMinute: number;\n  readonly status: BookingStatus;\n  readonly subtotalCents: number;\n  readonly discountCents: number;\n  readonly taxCents: number;\n  readonly totalCents: number;\n  readonly expiresAt?: number;\n  readonly groupId?: string;\n  readonly depositCents?: number;\n}\n\nexport interface CreateBookingInput {\n  readonly roomId: string;\n  readonly customerId: string;\n  readonly startMinute: number;\n  readonly endMinute: number;\n  readonly nowMinute?: number;\n  readonly holdMinutes?: number;\n  readonly legacyDepositMode?: boolean;\n}\n\nexport interface CreateGroupBookingInput {\n  readonly customerId: string;\n  readonly roomIds: readonly string[];\n  readonly startMinute: number;\n  readonly endMinute: number;\n  readonly discountBps: number;\n  readonly nowMinute?: number;\n}\nimport type { BookingService } from \"./bookings.ts\";\nimport type { CreateGroupBookingInput } from \"./models.ts\";\n\nexport function createGroupBooking(service: BookingService, input: CreateGroupBookingInput) {\n  const { groupId, bookings } = service.reserveGroupRooms(input);\n  const totals = { subtotalCents: 0, discountCents: 0, taxCents: 0, totalCents: 0 };\n  for (const booking of bookings) {\n    totals.subtotalCents += booking.subtotalCents;\n    totals.discountCents += booking.discountCents;\n    totals.taxCents += booking.taxCents;\n    totals.totalCents += booking.totalCents;\n  }\n  return { groupId, bookings, ...totals };\n}\nimport test from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport {\n  BookingService,\n  ValidationError,\n  calculateLegacyDeposit,\n} from \"../src/index.ts\";\n\ntest(\"baseline whole-hour booking computes exact subtotal and tax\", () => {\n  const svc = new BookingService({ env: {} });\n  svc.registerRoom({\n    roomId: \"conf_a\",\n    name: \"Conference A\",\n    hourlyRateCents: 10000,\n    taxBps: 825,\n  });\n\n  const booking = svc.createBooking({\n    roomId: \"conf_a\",\n    customerId: \"cust_1\",\n    startMinute: 60,\n    endMinute: 180,\n  });\n\n  assert.equal(booking.status, \"confirmed\");\n  assert.equal(booking.subtotalCents, 20000);\n  assert.equal(booking.taxCents, 1650);\n  assert.equal(booking.totalCents, 21650);\n  assert.equal(booking.depositCents, 0);\n  assert.equal(svc.listRoomBookings(\"conf_a\").length, 1);\n});\n\ntest(\"baseline legacy deposit mode calculates 25 percent deposit\", () => {\n  const svc = new BookingService({ env: {} });\n  svc.registerRoom({\n    roomId: \"conf_b\",\n    name: \"Conference B\",\n    hourlyRateCents: 4000,\n    taxBps: 0,\n  });\n\n  const booking = svc.createBooking({\n    roomId: \"conf_b\",\n    customerId: \"cust_2\",\n    startMinute: 0,\n    endMinute: 60,\n    legacyDepositMode: true,\n  });\n\n  assert.equal(calculateLegacyDeposit(4000), 1000);\n  assert.equal(booking.depositCents, 1000);\n});\n\ntest(\"baseline rejects invalid room or inverted time range\", () => {\n  const svc = new BookingService({ env: {} });\n  svc.registerRoom({\n    roomId: \"conf_c\",\n    name: \"Conference C\",\n    hourlyRateCents: 5000,\n    taxBps: 500,\n  });\n\n  assert.throws(\n    () =>\n      svc.createBooking({\n        roomId: \"missing\",\n        customerId: \"cust_1\",\n        startMinute: 0,\n        endMinute: 60,\n      }),\n    ValidationError,\n  );\n  assert.throws(\n    () =>\n      svc.createBooking({\n  