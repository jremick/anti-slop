{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cd benchmarks/sources/ev2_ts_bookings\ncat > tests/corporate.test.ts <<'EOF'\nimport assert from \\\"node:assert/strict\\\";\nimport test from \\\"node:test\\\";\nimport {\n  BookingService, ConflictError, ValidationError, applyDiscountAndTax, createGroupBooking,\n} from \\\"../src/index.ts\\\";\n\nconst input = {\n  customerId: \\\"team\\\", roomIds: [\\\"a\\\", \\\"b\\\"], startMinute: 20, endMinute: 50, discountBps: 5000,\n};\n\nfunction setup() {\n  const service = new BookingService({ env: {} });\n  service.registerRoom({ roomId: \\\"a\\\", name: \\\"Studio\\\", hourlyRateCents: 201, taxBps: 2500 });\n  service.registerRoom({ roomId: \\\"b\\\", name: \\\"Hall\\\", hourlyRateCents: 205, taxBps: 5000 });\n  return service;\n}\n\ntest(\\\"group totals sum each room's rounded discount and tax\\\", () => {\n  const service = setup();\n  const { groupId, bookings, ...totals } = createGroupBooking(service, input);\n  assert.deepEqual(totals, { subtotalCents: 101, discountCents: 103, taxCents: 39, totalCents: 140 });\n  assert.deepEqual(bookings.map(({ roomId, subtotalCents, discountCents, taxCents, totalCents }) =>\n    [roomId, subtotalCents, discountCents, taxCents, totalCents]), [\n    [\\\"a\\\", 50, 51, 13, 63],\n    [\\\"b\\\", 51, 52, 26, 77],\n  ]);\n  for (const booking of bookings) {\n    assert.equal(booking.groupId, groupId);\n    assert.equal(booking.status, \\\"confirmed\\\");\n    assert.deepEqual(service.listRoomBookings(booking.roomId), [booking]);\n    assert.throws(() => service.createBooking({ ...input, roomId: booking.roomId }), ConflictError);\n  }\n  const adjacent = createGroupBooking(service, { ...input, startMinute: 50, endMinute: 60 });\n  assert.notEqual(adjacent.groupId, groupId);\n});\n\ntest(\\\"an active hold in the last room blocks the entire group until expiry\\\", () => {\n  const service = setup();\n  const hold = service.createBooking({ ...input, roomId: \\\"b\\\", holdMinutes: 5 });\n  assert.throws(() => createGroupBooking(service, { ...input, nowMinute: 4 }), ConflictError);\n  assert.deepEqual(service.listRoomBookings(\\\"a\\\"), []);\n  assert.deepEqual(service.listRoomBookings(\\\"b\\\"), [hold]);\n  assert.equal(createGroupBooking(service, { ...input, nowMinute: 5 }).bookings.length, 2);\n});\n\ntest(\\\"invalid group input leaves all rooms available\\\", () => {\n  const service = setup();\n  for (const fields of [\n    { roomIds: [] }, { roomIds: [\\\"a\\\"] }, { roomIds: [\\\"a\\\", \\\"a\\\"] }, { roomIds: [\\\"a\\\", \\\"missing\\\"] },\n    { discountBps: -1 }, { discountBps: 10001 }, { discountBps: 0.5 }, { customerId: \\\" \\\" },\n    { endMinute: input.startMinute }, { nowMinute: -1 },\n  ]) {\n    assert.throws(() => createGroupBooking(service, { ...input, ...fields }), ValidationError);\n    assert.deepEqual(service.listRoomBookings(\\\"a\\\"), []);\n    assert.deepEqual(service.listRoomBookings(\\\"b\\\"), []);\n  }\n});\n\ntest(\\\"pricing accepts inclusive rate bounds and rejects invalid cents and rates\\\", () => {\n  assert.deepEqual(applyDiscountAndTax(51, 0, 10000), {\n    subtotalCents: 51, discountCents: 0, taxCents: 51, totalCents: 102,\n  });\n  assert.deepEqual(applyDiscountAndTax(51, 10000, 0), {\n    subtotalCents: 0, discountCents: 51, taxCents: 0, totalCents: 0,\n  });\n  for (const invalid of [-1, 0.5, 10001]) {\n    assert.throws(() => applyDiscountAndTax(100, invalid, 0), ValidationError);\n    assert.throws(() => applyDiscountAndTax(100, 0, invalid), ValidationError);\n  }\n  for (const invalid of [-1, 0.5]) {\n    assert.throws(() => applyDiscountAndTax(invalid, 0, 0), ValidationError);\n  }\n});\nEOF\nnode run_checks.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
