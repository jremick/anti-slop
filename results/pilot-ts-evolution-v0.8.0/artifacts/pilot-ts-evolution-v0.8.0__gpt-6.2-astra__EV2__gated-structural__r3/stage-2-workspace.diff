+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  BookingService, ConflictError, ValidationError, isBookingActiveAt, slotsOverlap,
+} from "../src/index.ts";
+
+const slot = { roomId: "a", customerId: "guest", startMinute: 10, endMinute: 20 };
+
+function bookingService(): BookingService {
+  const service = new BookingService({ env: { BOOKING_MAX_HOLD_MINUTES: "5" } });
+  service.registerRoom({ roomId: "a", name: "Studio", hourlyRateCents: 90, taxBps: 0 });
+  return service;
+}
+
+test("confirmed bookings conflict for every overlap shape and allow adjacent slots", () => {
+  const service = bookingService();
+  service.createBooking(slot);
+  for (const [start, end] of [[10, 20], [9, 21], [11, 19], [1, 11], [19, 21]]) {
+    assert.equal(slotsOverlap(start, end, 10, 20), true);
+    assert.throws(() => service.createBooking({ ...slot, startMinute: start, endMinute: end }), ConflictError);
+  }
+  for (const [start, end] of [[0, 10], [20, 21]]) {
+    assert.equal(slotsOverlap(start, end, 10, 20), false);
+    service.createBooking({ ...slot, startMinute: start, endMinute: end });
+  }
+  service.registerRoom({ ...service.getRoom("a"), roomId: "b" });
+  service.createBooking({ ...slot, roomId: "b" });
+  assert.equal(service.listRoomBookings("a").length, 3);
+});
+
+test("a hold releases its slot at the exact expiration minute", () => {
+  const service = bookingService();
+  const hold = service.createBooking({ ...slot, nowMinute: 3, holdMinutes: 5 });
+  assert.equal(hold.status, "held");
+  assert.equal(hold.expiresAt, 8);
+  assert.equal(isBookingActiveAt(hold, 7), true);
+  assert.equal(isBookingActiveAt(hold, 8), false);
+  assert.equal(isBookingActiveAt({ ...hold, expiresAt: undefined }, 7), false);
+  assert.equal(isBookingActiveAt({ ...hold, status: "cancelled" }, 7), false);
+  assert.throws(() => service.createBooking({ ...slot, nowMinute: 7 }), ConflictError);
+  assert.throws(() => service.confirmHold(hold.bookingId, 8), ValidationError);
+  assert.equal(service.createBooking({ ...slot, nowMinute: 8 }).status, "confirmed");
+});
+
+test("confirmation preserves the booking and keeps the slot past the original expiry", () => {
+  const service = bookingService();
+  const hold = service.createBooking({ ...slot, holdMinutes: 1 });
+  assert.equal(hold.expiresAt, 1);
+  const confirmed = service.confirmHold(hold.bookingId, 0);
+  assert.deepEqual(confirmed, { ...hold, status: "confirmed", expiresAt: undefined });
+  assert.deepEqual(service.getBooking(hold.bookingId), confirmed);
+  assert.throws(() => service.confirmHold(hold.bookingId, 0), ValidationError);
+  assert.throws(() => service.confirmHold("unknown", 0), ValidationError);
+  assert.throws(() => service.createBooking({ ...slot, nowMinute: 1 }), ConflictError);
+});
+
+test("invalid hold lengths leave the room available", () => {
+  const service = bookingService();
+  for (const holdMinutes of [0, -1, 1.5, 6]) {
+    assert.throws(() => service.createBooking({ ...slot, holdMinutes }), ValidationError);
+  }
+  assert.deepEqual(service.listRoomBookings("a"), []);
+});

