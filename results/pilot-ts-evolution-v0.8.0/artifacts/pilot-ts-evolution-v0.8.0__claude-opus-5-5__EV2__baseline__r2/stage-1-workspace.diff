+/**
+ * Half-open interval overlap: [startA, endA) and [startB, endB) overlap iff each
+ * starts before the other ends. Back-to-back slots (endA === startB) do not overlap.
+ */
+export function slotsOverlap(
+  startA: number,
+  endA: number,
+  startB: number,
+  endB: number,
+): boolean {
+  return startA < endB && startB < endA;
+}
+
+/**
+ * A booking blocks its slot when it is confirmed, or when it is a hold that has
+ * not yet expired (a hold expires at exactly `expiresAt`).
+ */
+export function isBookingActiveAt(booking: Booking, nowMinute: number): boolean {
+  if (booking.status === "confirmed") {
+    return true;
+  }
+  return booking.status === "held" &&
+    booking.expiresAt !== undefined &&
+    nowMinute < booking.expiresAt;
+}
 
