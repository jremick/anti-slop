+// ---- slot reuse ----
+
+test("a cancelled booking frees its slot immediately", () => {
+  const svc = makeService();
+  const b = book(svc, 3000, 3060);
+  assert.throws(() => book(svc, 3030, 3090), ConflictError);
+  svc.cancelBooking(b.bookingId, 100);
+  const replacement = svc.createBooking({
+    roomId: "r1", customerId: "c2", startMinute: 3000, endMinute: 3060, nowMinute: 100,
+  });
+  assert.equal(replacement.status, "confirmed");
+});
+
+test("cancelling a held booking frees its slot before the hold expires", () => {
+  const svc = makeService();
+  const held = svc.createBooking({
+    roomId: "r1", customerId: "c", startMinute: 3000, endMinute: 3060, nowMinute: 0, holdMinutes: 30,
+  });
+  svc.cancelBooking(held.bookingId, 10);
+  const next = svc.createBooking({ roomId: "r1", customerId: "c2", startMinute: 3000, endMinute: 3060, nowMinute: 10 });
+  assert.equal(next.status, "confirmed");
+  assert.throws(() => svc.confirmHold(held.bookingId, 10), ValidationError);
+});
+
+test("cancelling one room of a group frees only that room", () => {
+  const svc = makeService();
+  const grp = createGroupBooking(svc, {
+    customerId: "corp", roomIds: ["r1", "r2"], startMinute: 3000, endMinute: 3060, discountBps: 0,
+  });
+  const res = svc.cancelBooking(grp.bookings[0]!.bookingId, 0);
+  assert.equal(res.booking.groupId, grp.groupId);
+  assert.equal(book(svc, 3000, 3060, "r1").status, "confirmed");
+  assert.throws(() => book(svc, 3000, 3060, "r2"), ConflictError);
+});
