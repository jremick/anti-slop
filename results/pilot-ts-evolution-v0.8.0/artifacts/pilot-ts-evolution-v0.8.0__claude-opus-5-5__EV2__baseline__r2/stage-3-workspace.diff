+test("selectCancellationFeeBps picks early tier at or beyond the cutoff", () => {
+  const cfg: CancellationFeeConfig = { cutoffMinutes: 1440, earlyFeeBps: 1000, lateFeeBps: 5000 };
+  assert.equal(selectCancellationFeeBps(1441, cfg), 1000);
+  assert.equal(selectCancellationFeeBps(1440, cfg), 1000); // boundary is early
+  assert.equal(selectCancellationFeeBps(1439, cfg), 5000);
+  assert.equal(selectCancellationFeeBps(0, cfg), 5000);
+  const zero: CancellationFeeConfig = { cutoffMinutes: 0, earlyFeeBps: 7, lateFeeBps: 9 };
+  assert.equal(selectCancellationFeeBps(0, zero), 7);
+  assert.throws(() => selectCancellationFeeBps(-1, cfg), ValidationError);
+  assert.throws(() => selectCancellationFeeBps(1.5, cfg), ValidationError);
+});
+
+test("computeCancellationRefund rounds the fee half-up and refunds the rest", () => {
+  assert.deepEqual(computeCancellationRefund(10825, 1000), { feeCents: 1083, refundCents: 9742 }); // 1082.5
+  assert.deepEqual(computeCancellationRefund(10825, 5000), { feeCents: 5413, refundCents: 5412 }); // 5412.5
+  assert.deepEqual(computeCancellationRefund(10825, 0), { feeCents: 0, refundCents: 10825 });
+  assert.deepEqual(computeCancellationRefund(10825, 10000), { feeCents: 10825, refundCents: 0 });
+  assert.deepEqual(computeCancellationRefund(0, 5000), { feeCents: 0, refundCents: 0 });
+  assert.deepEqual(computeCancellationRefund(3, 3333), { feeCents: 1, refundCents: 2 }); // 0.9999
+  for (const [t, f] of [[-1, 0], [1.5, 0], [100, -1], [100, 10001], [100, 0.5]] as const) {
+    assert.throws(() => computeCancellationRefund(t, f), ValidationError, `(${t}, ${f})`);
+  }
+});
