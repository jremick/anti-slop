+  assert.deepEqual(loadCancellationFeeConfig({ [CANCEL_FEE_TIERS_ENV]: TIERS }), {
+    cutoffMinutes: 1440, earlyFeeBps: 1000, lateFeeBps: 5000,
+  });
+  assert.deepEqual(
+    loadCancellationFeeConfig({
+      [CANCEL_FEE_TIERS_ENV]: '{"cutoffMinutes":0,"earlyFeeBps":0,"lateFeeBps":10000}',
+    }),
+    { cutoffMinutes: 0, earlyFeeBps: 0, lateFeeBps: 10000 },
+  );
+});
+
+test("loadCancellationFeeConfig fails closed with ConfigError on bad config", () => {
+  const bad: Array<[string, string | undefined]> = [
+    ["missing", undefined],
+    ["empty", ""],
+    ["whitespace", "   "],
+    ["invalid JSON", "{cutoffMinutes:1"],
+    ["null", "null"],
+    ["array", "[1440, 1000, 5000]"],
+    ["number", "42"],
+    ["string", '"tiers"'],
+    ["empty object", "{}"],
+    ["missing lateFeeBps", '{"cutoffMinutes":60,"earlyFeeBps":0}'],
+    ["missing cutoff", '{"earlyFeeBps":0,"lateFeeBps":0}'],
+    ["negative cutoff", '{"cutoffMinutes":-1,"earlyFeeBps":0,"lateFeeBps":0}'],
+    ["fractional cutoff", '{"cutoffMinutes":1.5,"earlyFeeBps":0,"lateFeeBps":0}'],
+    ["string cutoff", '{"cutoffMinutes":"60","earlyFeeBps":0,"lateFeeBps":0}'],
+    ["null cutoff", '{"cutoffMinutes":null,"earlyFeeBps":0,"lateFeeBps":0}'],
+    ["early > 10000", '{"cutoffMinutes":60,"earlyFeeBps":10001,"lateFeeBps":0}'],
+    ["late negative", '{"cutoffMinutes":60,"earlyFeeBps":0,"lateFeeBps":-5}'],
+    ["late fractional", '{"cutoffMinutes":60,"earlyFeeBps":0,"lateFeeBps":12.5}'],
+    ["early string", '{"cutoffMinutes":60,"earlyFeeBps":"100","lateFeeBps":0}'],
+    ["late boolean", '{"cutoffMinutes":60,"earlyFeeBps":0,"lateFeeBps":true}'],
+  ];
+  for (const [label, raw] of bad) {
+    assert.throws(() => loadCancellationFeeConfig({ [CANCEL_FEE_TIERS_ENV]: raw }), ConfigError, label);
+  }
+});
+
+test("loadCancellationFeeConfig reads process.env by default", () => {
+  const prev = process.env[CANCEL_FEE_TIERS_ENV];
+  try {
+    process.env[CANCEL_FEE_TIERS_ENV] = TIERS;
+    assert.equal(loadCancellationFeeConfig().lateFeeBps, 5000);
+    delete process.env[CANCEL_FEE_TIERS_ENV];
+    assert.throws(() => loadCancellationFeeConfig(), ConfigError);
+  } finally {
+    if (prev === undefined) delete process.env[CANCEL_FEE_TIERS_ENV];
+    else process.env[CANCEL_FEE_TIERS_ENV] = prev;
+  }
+});
