+// ---- BookingService.cancelBooking ----
+
+test("early cancellation charges the early tier", () => {
+  const svc = makeService();
+  const b = book(svc, 3000, 3060);
+  assert.equal(b.totalCents, 10825);
+  const res = svc.cancelBooking(b.bookingId, 0); // 3000 minutes before start
+  assert.equal(res.feeBps, 1000);
+  assert.equal(res.feeCents, 1083);
+  assert.equal(res.refundCents, 9742);
+  assert.equal(res.feeCents + res.refundCents, b.totalCents);
+  assert.equal(res.booking.status, "cancelled");
+  assert.equal(res.booking.bookingId, b.bookingId);
+  assert.equal(res.booking.totalCents, b.totalCents);
+  assert.deepEqual(svc.getBooking(b.bookingId), res.booking);
+});
+
+test("late cancellation charges the late tier, including at start time", () => {
+  const svc = makeService();
+  const b = book(svc, 3000, 3060);
+  const res = svc.cancelBooking(b.bookingId, 3000); // 0 minutes before start
+  assert.equal(res.feeBps, 5000);
+  assert.equal(res.feeCents, 5413);
+  assert.equal(res.refundCents, 5412);
+});
+
+test("cutoff boundary: exactly cutoffMinutes before start is early, one minute later is late", () => {
+  const svc = makeService();
+  const atCutoff = book(svc, 3000, 3060);
+  assert.equal(svc.cancelBooking(atCutoff.bookingId, 3000 - 1440).feeBps, 1000);
+  const pastCutoff = book(svc, 3000, 3060);
+  assert.equal(svc.cancelBooking(pastCutoff.bookingId, 3000 - 1439).feeBps, 5000);
+});
+
+test("cancelBooking rejects unknown, already cancelled, started, and bad nowMinute", () => {
+  const svc = makeService();
+  assert.throws(() => svc.cancelBooking("bkg_9999", 0), ValidationError);
+  const b = book(svc, 3000, 3060);
+  assert.throws(() => svc.cancelBooking(b.bookingId, 3001), ValidationError);
+  assert.equal(svc.getBooking(b.bookingId).status, "confirmed");
+  assert.throws(() => svc.cancelBooking(b.bookingId, -1), ValidationError);
+  assert.throws(() => svc.cancelBooking(b.bookingId, 1.5), ValidationError);
+  svc.cancelBooking(b.bookingId, 0);
+  assert.throws(() => svc.cancelBooking(b.bookingId, 0), ValidationError);
+});
+
+test("missing or invalid fee config fails closed and leaves the booking intact", () => {
+  for (const raw of [undefined, "", "not json", '{"cutoffMinutes":60,"earlyFeeBps":0,"lateFeeBps":20000}']) {
+    const svc = makeService({ [CANCEL_FEE_TIERS_ENV]: raw });
+    const b = book(svc, 3000, 3060);
