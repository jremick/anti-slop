{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cat > benchmarks/sources/ev2_ts_bookings/tests/corporate.test.ts <<'EOF'\nimport assert from \\\"node:assert/strict\\\";\nimport test from \\\"node:test\\\";\nimport {\n  applyDiscountAndTax,\n  BookingService,\n  ConflictError,\n  createGroupBooking,\n  ValidationError,\n} from \\\"../src/index.ts\\\";\n\nconst input = {\n  customerId: \\\"team\\\",\n  roomIds: [\\\"a\\\", \\\"b\\\"],\n  startMinute: 100,\n  endMinute: 130,\n  discountBps: 5000,\n};\n\nfunction setup() {\n  const service = new BookingService({ env: {} });\n  service.registerRoom({ roomId: \\\"a\\\", name: \\\"A\\\", hourlyRateCents: 201, taxBps: 2500 });\n  service.registerRoom({ roomId: \\\"b\\\", name: \\\"B\\\", hourlyRateCents: 205, taxBps: 5000 });\n  return service;\n}\n\ntest(\\\"group totals sum each room's rounded discount and tax on its net subtotal\\\", () => {\n  const service = setup();\n  const { bookings, groupId, ...totals } = createGroupBooking(service, input);\n  assert.ok(groupId);\n  assert.deepEqual(bookings.map(b => [\n    b.roomId, b.subtotalCents, b.discountCents, b.taxCents, b.totalCents,\n  ]), [[\\\"a\\\", 50, 51, 13, 63], [\\\"b\\\", 51, 52, 26, 77]]);\n  assert.deepEqual(totals, { subtotalCents: 101, discountCents: 103, taxCents: 39, totalCents: 140 });\n  for (const booking of bookings) {\n    assert.equal(booking.groupId, groupId);\n    assert.equal(booking.status, \\\"confirmed\\\");\n    assert.equal(booking.customerId, \\\"team\\\");\n    assert.deepEqual(service.listRoomBookings(booking.roomId), [booking]);\n  }\n  const next = createGroupBooking(service, { ...input, startMinute: 130, endMinute: 160 });\n  assert.notEqual(next.groupId, groupId);\n});\n\ntest(\\\"a live hold in the last room blocks the whole group until the expiration minute\\\", () => {\n  const service = setup();\n  const hold = service.createBooking({\n    customerId: \\\"other\\\", roomId: \\\"b\\\", startMinute: 129, endMinute: 140, holdMinutes: 5,\n  });\n  assert.throws(() => createGroupBooking(service, { ...input, nowMinute: 4 }), ConflictError);\n  assert.deepEqual(service.listRoomBookings(\\\"a\\\"), []);\n  assert.deepEqual(service.listRoomBookings(\\\"b\\\"), [hold]);\n  assert.equal(createGroupBooking(service, { ...input, nowMinute: 5 }).bookings.length, 2);\n});\n\ntest(\\\"invalid group inputs leave every registered room available\\\", () => {\n  const service = setup();\n  for (const overrides of [\n    { roomIds: [] }, { roomIds: [\\\"a\\\"] }, { roomIds: [\\\"a\\\", \\\"a\\\"] }, { roomIds: [\\\"a\\\", \\\"unknown\\\"] },\n    { discountBps: -1 }, { discountBps: 10001 }, { discountBps: 0.5 },\n    { customerId: \\\" \\\" }, { endMinute: 100 }, { nowMinute: -1 },\n  ]) {\n    assert.throws(() => createGroupBooking(service, { ...input, ...overrides }), ValidationError);\n    assert.deepEqual(service.listRoomBookings(\\\"a\\\"), []);\n    assert.deepEqual(service.listRoomBookings(\\\"b\\\"), []);\n  }\n});\n\ntest(\\\"discount and tax accept boundary rates and reject invalid amounts and rates\\\", () => {\n  assert.deepEqual(applyDiscountAndTax(137, 10000, 10000), {\n    subtotalCents: 0, discountCents: 137, taxCents: 0, totalCents: 0,\n  });\n  assert.deepEqual(applyDiscountAndTax(137, 0, 10000), {\n    subtotalCents: 137, discountCents: 0, taxCents: 137, totalCents: 274,\n  });\n  for (const invalid of [-1, 0.1, 10001, NaN]) {\n    assert.throws(() => applyDiscountAndTax(100, invalid, 0), ValidationError);\n    assert.throws(() => applyDiscountAndTax(100, 0, invalid), ValidationError);\n  }\n  for (const invalid of [-1, 1.5]) {\n    assert.throws(() => applyDiscountAndTax(invalid, 0, 0), ValidationError);\n  }\n});\nEOF\nnode benchmarks/sources/ev2_ts_bookings/run_checks.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
