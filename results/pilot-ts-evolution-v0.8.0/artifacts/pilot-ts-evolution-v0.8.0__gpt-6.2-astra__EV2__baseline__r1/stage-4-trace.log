{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cat > benchmarks/sources/ev2_ts_bookings/tests/notifications.test.ts <<'EOF'\nimport test from \\\"node:test\\\";\nimport assert from \\\"node:assert/strict\\\";\nimport { BookingService, ConflictError, createGroupBooking } from \\\"../src/index.ts\\\";\nimport type { BookingNotification } from \\\"../src/index.ts\\\";\n\nconst slot = { roomId: \\\"a\\\", customerId: \\\"guest\\\", startMinute: 100, endMinute: 160 };\nconst group = { ...slot, roomIds: [\\\"a\\\", \\\"b\\\"], discountBps: 5000 };\n\nfunction setup(notifyHook: (event: BookingNotification) => void) {\n  const service = new BookingService({\n    notifyHook,\n    env: { BOOKING_CANCEL_FEE_TIERS_JSON: '{\\\"cutoffMinutes\\\":0,\\\"earlyFeeBps\\\":2500,\\\"lateFeeBps\\\":0}' },\n  });\n  service.registerRoom({ roomId: \\\"a\\\", name: \\\"A\\\", hourlyRateCents: 100, taxBps: 0 });\n  service.registerRoom({ roomId: \\\"b\\\", name: \\\"B\\\", hourlyRateCents: 200, taxBps: 1000 });\n  return service;\n}\n\ntest(\\\"notifications include each booking's total on creation and its refund on cancellation\\\", () => {\n  const events: BookingNotification[] = [];\n  const service = setup(event => events.push(event));\n  const hold = service.createBooking({ ...slot, customerId: \\\" guest \\\", holdMinutes: 5 });\n  service.confirmHold(hold.bookingId, 1);\n  service.cancelBooking(hold.bookingId, 1);\n  const { bookings: [a, b] } = createGroupBooking(service, group);\n  assert.deepEqual(events, [\n    { event: \\\"booking_created\\\", bookingId: hold.bookingId, roomId: \\\"a\\\", customerId: \\\"guest\\\", amountCents: 100 },\n    { event: \\\"booking_cancelled\\\", bookingId: hold.bookingId, roomId: \\\"a\\\", customerId: \\\"guest\\\", amountCents: 75 },\n    { event: \\\"booking_created\\\", bookingId: a.bookingId, roomId: \\\"a\\\", customerId: \\\"guest\\\", amountCents: 50 },\n    { event: \\\"booking_created\\\", bookingId: b.bookingId, roomId: \\\"b\\\", customerId: \\\"guest\\\", amountCents: 110 },\n  ]);\n});\n\ntest(\\\"a rejected creation or cancellation preserves the slot's previous state\\\", () => {\n  const failure = new Error(\\\"notification rejected\\\");\n  let reject = true;\n  const service = setup(() => { if (reject) throw failure; });\n  assert.throws(() => service.createBooking(slot), error => error === failure);\n  assert.deepEqual(service.listRoomBookings(\\\"a\\\"), []);\n\n  reject = false;\n  const booking = service.createBooking(slot);\n  reject = true;\n  assert.throws(() => service.cancelBooking(booking.bookingId, 1), error => error === failure);\n  assert.equal(service.getBooking(booking.bookingId).status, \\\"confirmed\\\");\n  assert.throws(() => service.createBooking(slot), ConflictError);\n  reject = false;\n  assert.equal(service.cancelBooking(booking.bookingId, 1).booking.status, \\\"cancelled\\\");\n});\n\ntest(\\\"a failure on the second group notification leaves both rooms available for retry\\\", () => {\n  const failure = new Error(\\\"second notification rejected\\\");\n  const rooms: string[] = [];\n  let reject = true;\n  const service = setup(event => {\n    rooms.push(event.roomId);\n    if (event.roomId === \\\"b\\\" && reject) throw failure;\n  });\n  assert.throws(() => createGroupBooking(service, group), error => error === failure);\n  assert.deepEqual(rooms, [\\\"a\\\", \\\"b\\\"]);\n  assert.deepEqual(service.listRoomBookings(\\\"a\\\"), []);\n  assert.deepEqual(service.listRoomBookings(\\\"b\\\"), []);\n  reject = false;\n  assert.equal(createGroupBooking(service, group).bookings.length, 2);\n});\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
