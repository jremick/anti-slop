+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  calculateBookingPrice,
+  isBookingActiveAt,
+  roundHalfUpDiv,
+  slotsOverlap,
+} from "../src/index.ts";
+
+const room = { roomId: "a", name: "Room A", hourlyRateCents: 90, taxBps: 2500 };
+const slot = { roomId: "a", customerId: "one", startMinute: 20, endMinute: 40 };
+
+function setup() {
+  const service = new BookingService({ env: { BOOKING_MAX_HOLD_MINUTES: "5" } });
+  service.registerRoom(room);
+  return service;
+}
+
+test("half-up division distinguishes below, at, and above half a cent", () => {
+  for (const [n, d, expected] of [[0, 2, 0], [89, 60, 1], [90, 60, 2], [91, 60, 2], [5, 3, 2]]) {
+    assert.equal(roundHalfUpDiv(n, d), expected);
+  }
+  for (const [n, d] of [[-1, 2], [1.5, 2], [1, 0], [1, -2], [1, 2.5]]) {
+    assert.throws(() => roundHalfUpDiv(n, d), ValidationError);
+  }
+});
+
+test("one minute rounds to two cents before tax and legacy deposit are calculated", () => {
+  assert.deepEqual(calculateBookingPrice(room, 1, { legacyDepositMode: true }), {
+    subtotalCents: 2, discountCents: 0, taxCents: 1, totalCents: 3, depositCents: 1,
+  });
+  for (const duration of [0, -1, 1.5]) {
+    assert.throws(() => calculateBookingPrice(room, duration), ValidationError);
+  }
+});
+
+test("conflicts include partial overlap, containment, and identical slots in one room", () => {
+  const service = setup();
+  service.createBooking(slot);
+  for (const [startMinute, endMinute] of [[19, 21], [39, 41], [25, 30], [10, 50], [20, 40]]) {
+    assert.equal(slotsOverlap(20, 40, startMinute, endMinute), true);
+    assert.throws(() => service.createBooking({ ...slot, startMinute, endMinute }), ConflictError);
+  }
+  for (const [startMinute, endMinute] of [[10, 20], [40, 50]]) {
+    assert.equal(slotsOverlap(20, 40, startMinute, endMinute), false);
+    service.createBooking({ ...slot, startMinute, endMinute });
+  }
+  service.registerRoom({ ...room, roomId: "b" });
+  service.createBooking({ ...slot, roomId: "b" });
+  assert.equal(service.listRoomBookings("a").length, 3);
+});
+
+test("a hold releases its slot at the exact expiration minute", () => {
+  const service = setup();
+  const hold = service.createBooking({ ...slot, holdMinutes: 5, nowMinute: 8 });
+  assert.equal(hold.status, "held");
+  assert.equal(hold.expiresAt, 13);
+  assert.throws(() => service.createBooking({ ...slot, nowMinute: 12 }), ConflictError);
+  assert.throws(() => service.confirmHold(hold.bookingId, 13), ValidationError);
+  assert.equal(service.createBooking({ ...slot, nowMinute: 13 }).status, "confirmed");
+  assert.equal(isBookingActiveAt(hold, 14), false);
+  assert.equal(isBookingActiveAt({ ...hold, status: "cancelled" }, 12), false);
+  assert.equal(isBookingActiveAt({ ...hold, expiresAt: undefined }, 12), false);
+});
+
+test("confirming a live hold persists the booking beyond its original expiration", () => {
+  const service = setup();
+  const hold = service.createBooking({ ...slot, holdMinutes: 5 });
+  assert.equal(hold.expiresAt, 5);
+  const confirmed = service.confirmHold(hold.bookingId, 4);
+  assert.equal(confirmed.bookingId, hold.bookingId);
+  assert.equal(confirmed.status, "confirmed");
+  assert.equal(confirmed.expiresAt, undefined);
+  assert.deepEqual(service.getBooking(hold.bookingId), confirmed);
+  assert.throws(() => service.createBooking({ ...slot, nowMinute: 5, holdMinutes: 1 }), ConflictError);
+  assert.throws(() => service.confirmHold(hold.bookingId, 4), ValidationError);
+  assert.throws(() => service.confirmHold("missing", 4), ValidationError);
+});
+
+test("invalid holds leave the room available", () => {
+  const service = setup();
+  for (const holdMinutes of [0, -1, 1.5, 6]) {
+    assert.throws(() => service.createBooking({ ...slot, holdMinutes }), ValidationError);
+  }
+  assert.equal(service.listRoomBookings(room.roomId).length, 0);
+});
