+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConfigError,
+  ConflictError,
+  ValidationError,
+  computeCancellationRefund,
+  loadCancellationFeeConfig,
+  selectCancellationFeeBps,
+} from "../src/index.ts";
+
+const tiers = { cutoffMinutes: 20, earlyFeeBps: 1000, lateFeeBps: 5000 };
+const slot = { customerId: "guest", roomId: "a", startMinute: 60, endMinute: 120 };
+
+function setup(raw: string | undefined) {
+  const env = { BOOKING_CANCEL_FEE_TIERS_JSON: raw };
+  const service = new BookingService({ env });
+  service.registerRoom({ roomId: "a", name: "A", hourlyRateCents: 100, taxBps: 100 });
+  const booking = service.createBooking(slot);
+  return { service, booking, env };
+}
+
+test("cancellation uses the tax-inclusive total and includes the cutoff in the early tier", () => {
+  for (const [now, feeBps, feeCents] of [[39, 1000, 10], [40, 1000, 10], [41, 5000, 51], [60, 5000, 51]]) {
+    const { service, booking } = setup(JSON.stringify(tiers));
+    const result = service.cancelBooking(booking.bookingId, now);
+    assert.deepEqual(result, {
+      booking: { ...booking, status: "cancelled" }, feeBps, feeCents, refundCents: 101 - feeCents,
+    });
+    assert.deepEqual(service.getBooking(booking.bookingId), result.booking);
+    assert.throws(() => service.cancelBooking(booking.bookingId, now), ValidationError);
+    assert.equal(service.createBooking({ ...slot, nowMinute: now }).status, "confirmed");
+  }
+});
+
+test("invalid tiers preserve the booking and its slot until configuration is repaired", () => {
+  const malformed = [
+    undefined, "", "  ", "{", "null", "[]", "2", "{}",
+    ...[
+      { cutoffMinutes: -1 }, { cutoffMinutes: 0.5 }, { cutoffMinutes: undefined },
+      { earlyFeeBps: undefined }, { earlyFeeBps: 10001 }, { earlyFeeBps: "100" },
+      { lateFeeBps: undefined }, { lateFeeBps: -1 }, { lateFeeBps: 2.5 },
+    ].map(fields => JSON.stringify({ ...tiers, ...fields })),
+  ];
+  for (const raw of malformed) {
+    const { service, booking, env } = setup(raw);
+    assert.throws(() => service.cancelBooking(booking.bookingId, 0), ConfigError);
+    assert.deepEqual(service.getBooking(booking.bookingId), booking);
+    assert.throws(() => service.createBooking(slot), ConflictError);
+    env.BOOKING_CANCEL_FEE_TIERS_JSON = JSON.stringify(tiers);
+    assert.equal(service.cancelBooking(booking.bookingId, 0).refundCents, 91);
+  }
+});
+
+test("unknown bookings and cancellations after the start are rejected before fee calculation", () => {
+  const { service, booking } = setup(undefined);
+  assert.throws(() => service.cancelBooking("missing", 0), ValidationError);
+  assert.throws(() => service.cancelBooking(booking.bookingId, 61), ValidationError);
+  assert.deepEqual(service.getBooking(booking.bookingId), booking);
+});
+
+test("fee config and refund helpers support zero and full fees", () => {
+  const cfg = loadCancellationFeeConfig({
+    BOOKING_CANCEL_FEE_TIERS_JSON: '{"cutoffMinutes":1,"earlyFeeBps":0,"lateFeeBps":10000}',
+  });
+  assert.equal(selectCancellationFeeBps(1, cfg), 0);
+  assert.equal(selectCancellationFeeBps(0, cfg), 10000);
+  assert.deepEqual(computeCancellationRefund(101, 0), { feeCents: 0, refundCents: 101 });
+  assert.deepEqual(computeCancellationRefund(101, 10000), { feeCents: 101, refundCents: 0 });
+  for (const [total, bps] of [[-1, 0], [1.5, 0], [10, -1], [10, 10001], [10, 0.5]]) {
+    assert.throws(() => computeCancellationRefund(total, bps), ValidationError);
+  }
+});

