+  assert.deepEqual(totals, { subtotalCents: 5, discountCents: 3, taxCents: 2, totalCents: 7 });
+  assert.deepEqual(bookings.map((booking) => [
+    booking.roomId, booking.subtotalCents, booking.discountCents, booking.taxCents, booking.totalCents,
+  ]), [
+    ["a", 1, 1, 1, 2],
+    ["b", 4, 2, 1, 5],
+  ]);
+  assert.ok(groupId);
+  assert.equal(new Set(bookings.map((booking) => booking.bookingId)).size, 2);
+  for (const booking of bookings) {
+    assert.equal(booking.groupId, groupId);
+    assert.equal(booking.status, "confirmed");
+    assert.equal(booking.customerId, "corporate");
+    assert.equal(booking.startMinute, input.startMinute);
+    assert.equal(booking.endMinute, input.endMinute);
+    assert.deepEqual(service.listRoomBookings(booking.roomId), [booking]);
+    assert.equal(service.getBooking(booking.bookingId), booking);
