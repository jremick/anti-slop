{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,80p' benchmarks/sources/ev2_ts_bookings/tests/bookings.test.ts && cat benchmarks/sources/ev2_ts_bookings/tests/pricing.test.ts\"","aggregated_output":"import test from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport {\n  BookingService,\n  ConflictError,\n  ValidationError,\n  calculateLegacyDeposit,\n  isBookingActiveAt,\n  slotsOverlap,\n} from \"../src/index.ts\";\n\ntest(\"baseline whole-hour booking computes exact subtotal and tax\", () => {\n  const svc = new BookingService({ env: {} });\n  svc.registerRoom({\n    roomId: \"conf_a\",\n    name: \"Conference A\",\n    hourlyRateCents: 10000,\n    taxBps: 825,\n  });\n\n  const booking = svc.createBooking({\n    roomId: \"conf_a\",\n    customerId: \"cust_1\",\n    startMinute: 60,\n    endMinute: 180,\n  });\n\n  assert.equal(booking.status, \"confirmed\");\n  assert.equal(booking.subtotalCents, 20000);\n  assert.equal(booking.taxCents, 1650);\n  assert.equal(booking.totalCents, 21650);\n  assert.equal(booking.depositCents, 0);\n  assert.equal(svc.listRoomBookings(\"conf_a\").length, 1);\n});\n\ntest(\"baseline legacy deposit mode calculates 25 percent deposit\", () => {\n  const svc = new BookingService({ env: {} });\n  svc.registerRoom({\n    roomId: \"conf_b\",\n    name: \"Conference B\",\n    hourlyRateCents: 4000,\n    taxBps: 0,\n  });\n\n  const booking = svc.createBooking({\n    roomId: \"conf_b\",\n    customerId: \"cust_2\",\n    startMinute: 0,\n    endMinute: 60,\n    legacyDepositMode: true,\n  });\n\n  assert.equal(calculateLegacyDeposit(4000), 1000);\n  assert.equal(booking.depositCents, 1000);\n});\n\ntest(\"baseline rejects invalid room or inverted time range\", () => {\n  const svc = new BookingService({ env: {} });\n  svc.registerRoom({\n    roomId: \"conf_c\",\n    name: \"Conference C\",\n    hourlyRateCents: 5000,\n    taxBps: 500,\n  });\n\n  assert.throws(\n    () =>\n      svc.createBooking({\n        roomId: \"missing\",\n        customerId: \"cust_1\",\n        startMinute: 0,\n        endMinute: 60,\n      }),\n    ValidationError,\n  );\n  assert.throws(\n    () =>\n      svc.createBooking({\n        roomId: \"conf_c\",\n        customerId: \"cust_1\",\nimport test from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport {\n  ValidationError,\n  applyDiscountAndTax,\n  calculateBookingPrice,\n  roundHalfUpDiv,\n} from \"../src/index.ts\";\n\ntest(\"roundHalfUpDiv rounds below, at, and above a half\", () => {\n  assert.equal(roundHalfUpDiv(0, 60), 0);\n  assert.equal(roundHalfUpDiv(89, 60), 1);\n  assert.equal(roundHalfUpDiv(90, 60), 2);\n  assert.equal(roundHalfUpDiv(91, 60), 2);\n  assert.equal(roundHalfUpDiv(4, 3), 1);\n  assert.equal(roundHalfUpDiv(5, 3), 2);\n  assert.equal(roundHalfUpDiv(Number.MAX_SAFE_INTEGER, 1), Number.MAX_SAFE_INTEGER);\n});\n\ntest(\"roundHalfUpDiv rejects invalid integer operands\", () => {\n  for (const numerator of [-1, 1.5, NaN, Infinity]) {\n    assert.throws(() => roundHalfUpDiv(numerator, 60), ValidationError);\n  }\n  for (const denominator of [0, -1, 1.5, NaN, Infinity]) {\n    assert.throws(() => roundHalfUpDiv(60, denominator), ValidationError);\n  }\n});\n\ntest(\"minute pricing rounds the subtotal before calculating tax and legacy deposit\", () => {\n  const room = { roomId: \"a\", name: \"Room A\", hourlyRateCents: 90, taxBps: 2500 };\n  assert.deepEqual(calculateBookingPrice(room, 1, { legacyDepositMode: true }), {\n    subtotalCents: 2,\n    discountCents: 0,\n    taxCents: 1,\n    totalCents: 3,\n    depositCents: 1,\n  });\n  assert.equal(calculateBookingPrice(room, 61).subtotalCents, 92);\n  assert.equal(calculateBookingPrice({ ...room, hourlyRateCents: 1 }, 1).totalCents, 0);\n  for (const duration of [0, -1, 1.5, NaN, Infinity]) {\n    assert.throws(() => calculateBookingPrice(room, duration), ValidationError);\n  }\n});\n\ntest(\"discount and tax round half up in order, including large integer products\", () => {\n  assert.deepEqual(applyDiscountAndTax(6, 2500, 1250), {\n    subtotalCents: 4,\n    discountCents: 2,\n    taxCents: 1,\n    totalCents: 5,\n  });\n  assert.deepEqual(applyDiscountAndTax(6, 10000, 10000), {\n    subtotalCents: 0,\n    discountCents: 6,\n    taxCents: 0,\n    totalCents: 0,\n  });\n  const gross = Number.MAX_SAFE_INTEGER;\n  assert.equal(applyDiscountAndTax(gross, 5000, 0).discountCents, 4503599627370496);\n  assert.equal(applyDiscountAndTax(gross, 0, 10000).taxCents, gross);\n\n  const room = { roomId: \"a\", name: \"Room A\", hourlyRateCents: 6, taxBps: 1250 };\n  assert.deepEqual(calculateBookingPrice(room, 60, { discountBps: 2500, legacyDepositMode: true }), {\n    subtotalCents: 4,\n    discountCents: 2,\n    taxCents: 1,\n    totalCents: 5,\n    depositCents: 1,\n  });\n});\n\ntest(\"discount and tax reject invalid cents and basis points\", () => {\n  const room = { roomId: \"a\", name: \"Room A\", hourlyRateCents: 6, taxBps: 1250 };\n  for (const value of [-1, 0.5, 10001, NaN, Infinity]) {\n    assert.throws(() => applyDiscountAndTax(6, value, 0), ValidationError);\n    assert.throws(() => applyDiscountAndTax(6, 0, value), ValidationError);\n    assert.throws(() => calculateBookingPrice(room, 60, { discountBps: value }), ValidationError);\n  }\n  for (const gross of [-1, 0.5, NaN, Infinity]) {\n    assert.throws(() => applyDiscountAndTax(gross, 0, 0), ValidationError);\n  }\n});\n","exit_code":0,"status":"completed"}}
