+} from "../src/index.ts";
+
+const roomA = { roomId: "a", name: "Room A", hourlyRateCents: 90, taxBps: 2500 };
+const roomB = { roomId: "b", name: "Room B", hourlyRateCents: 330, taxBps: 3750 };
+const groupInput = {
+  roomIds: [roomA.roomId, roomB.roomId],
+  customerId: " corporate ",
+  startMinute: 10,
+  endMinute: 11,
+  discountBps: 2500,
+};
+
+function setup(): BookingService {
+  const service = new BookingService({ env: {} });
+  service.registerRoom(roomA);
+  service.registerRoom(roomB);
+  return service;
+}
+
+test("discounts round half-up before tax and validate cents and basis points", () => {
+  assert.deepEqual(applyDiscountAndTax(6, 2500, 3750), {
+    subtotalCents: 4,
+    discountCents: 2,
+    taxCents: 2,
+    totalCents: 6,
+  });
+  assert.deepEqual(applyDiscountAndTax(10001, 0, 10000), {
+    subtotalCents: 10001,
+    discountCents: 0,
+    taxCents: 10001,
+    totalCents: 20002,
+  });
+  assert.deepEqual(applyDiscountAndTax(6, 10000, 10000), {
+    subtotalCents: 0,
+    discountCents: 6,
+    taxCents: 0,
+    totalCents: 0,
+  });
+  for (const value of [-1, 0.5, 10001, NaN, Infinity]) {
+    assert.throws(() => applyDiscountAndTax(6, value, 0), ValidationError);
+    assert.throws(() => applyDiscountAndTax(6, 0, value), ValidationError);
+  }
+  for (const gross of [-1, 0.5, NaN, Infinity]) {
+    assert.throws(() => applyDiscountAndTax(gross, 0, 0), ValidationError);
+  }
+  assert.deepEqual(calculateBookingPrice(roomB, 1, { discountBps: 2500, legacyDepositMode: true }), {
+    subtotalCents: 4,
+    discountCents: 2,
+    taxCents: 2,
+    totalCents: 6,
+    depositCents: 1,
+  });
+});
+
+test("group bookings price each room before summing and persist a shared group ID", () => {
+  const service = setup();
+  const group = createGroupBooking(service, groupInput);
+  const { groupId, bookings, ...totals } = group;
+  assert.ok(groupId);
+  assert.deepEqual(totals, { subtotalCents: 5, discountCents: 3, taxCents: 2, totalCents: 7 });
+  assert.deepEqual(bookings.map((booking) => booking.roomId), groupInput.roomIds);
+  assert.notEqual(bookings[0].bookingId, bookings[1].bookingId);
+
+  for (const [index, room] of [roomA, roomB].entries()) {
+    const booking = bookings[index];
+    assert.deepEqual(booking, {
+      bookingId: booking.bookingId,
+      groupId,
+      roomId: room.roomId,
+      customerId: "corporate",
+      startMinute: 10,
+      endMinute: 11,
+      status: "confirmed",
