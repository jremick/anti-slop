+import assert from "node:assert/strict";
+import test from "node:test";
+import { BookingService, ConflictError, ValidationError, createGroupBooking } from "../src/index.ts";
+import type { BookingNotification } from "../src/index.ts";
+
+const slot = { roomId: "a", customerId: " customer ", startMinute: 60, endMinute: 120 };
+const groupInput = {
+  roomIds: ["a", "b"], customerId: " corporate ", startMinute: 120, endMinute: 180, discountBps: 2500,
+};
+
+function setup(notifyHook: (event: BookingNotification) => void): BookingService {
+  const service = new BookingService({
+    env: { BOOKING_CANCEL_FEE_TIERS_JSON: '{"cutoffMinutes":20,"earlyFeeBps":5000,"lateFeeBps":7500}' },
+    notifyHook,
+  });
+  service.registerRoom({ roomId: "a", name: "Room A", hourlyRateCents: 100, taxBps: 2500 });
+  service.registerRoom({ roomId: "b", name: "Room B", hourlyRateCents: 200, taxBps: 0 });
+  return service;
+}
+
+test("hooks emit exact creation events for single and group bookings and a refund event on cancellation", () => {
+  const events: BookingNotification[] = [];
+  const service = setup((event) => events.push(event));
+  const hold = service.createBooking({ ...slot, holdMinutes: 10 });
+  service.confirmHold(hold.bookingId, 5);
+  const group = createGroupBooking(service, groupInput);
+  const cancellation = service.cancelBooking(hold.bookingId, 10);
+
+  assert.equal(cancellation.refundCents, 62);
+  assert.deepEqual(events, [
+    { event: "booking_created", bookingId: hold.bookingId, roomId: "a", customerId: "customer", amountCents: 125 },
+    { event: "booking_created", bookingId: group.bookings[0].bookingId, roomId: "a", customerId: "corporate", amountCents: 94 },
+    { event: "booking_created", bookingId: group.bookings[1].bookingId, roomId: "b", customerId: "corporate", amountCents: 150 },
+    { event: "booking_cancelled", bookingId: hold.bookingId, roomId: "a", customerId: "customer", amountCents: 62 },
+  ]);
+});
+
+test("a throwing creation hook leaves no booking and allows a retry", () => {
+  const failure = new Error("notification failed");
+  let shouldThrow = true;
+  let attemptedBookingId = "";
+  const service = setup((event) => {
+    attemptedBookingId = event.bookingId;
+    if (shouldThrow) {
+      throw failure;
+    }
+  });
+
+  assert.throws(() => service.createBooking(slot), (error) => error === failure);
+  assert.ok(attemptedBookingId);
+  assert.throws(() => service.getBooking(attemptedBookingId), ValidationError);
+  assert.deepEqual(service.listRoomBookings(slot.roomId), []);
+
+  shouldThrow = false;
+  const booking = service.createBooking(slot);
+  assert.deepEqual(service.listRoomBookings(slot.roomId), [booking]);
+});
+
+test("a failure on the second group notification leaves every group booking uncommitted", () => {
+  const failure = new Error("second room notification failed");
+  const attempted: BookingNotification[] = [];
+  let shouldThrow = true;
+  const service = setup((event) => {
+    attempted.push(event);
+    if (shouldThrow && event.roomId === "b") {
+      assert.deepEqual(service.listRoomBookings("a"), []);
+      throw failure;
+    }
+  });
+
+  assert.throws(() => createGroupBooking(service, groupInput), (error) => error === failure);
+  assert.deepEqual(attempted.map((event) => event.roomId), ["a", "b"]);
+  for (const { bookingId, roomId } of attempted) {
+    assert.throws(() => service.getBooking(bookingId), ValidationError);
+    assert.deepEqual(service.listRoomBookings(roomId), []);
+  }
+
+  shouldThrow = false;
+  const group = createGroupBooking(service, groupInput);
+  assert.equal(group.bookings.length, 2);
+  for (const booking of group.bookings) {
+    assert.deepEqual(service.listRoomBookings(booking.roomId), [booking]);
+  }
+});
+
+test("a throwing cancellation hook preserves the booking and keeps its slot reserved", () => {
+  const failure = new Error("cancellation notification failed");
+  let shouldThrow = true;
+  const service = setup((event) => {
+    if (shouldThrow && event.event === "booking_cancelled") {
+      assert.equal(service.getBooking(event.bookingId).status, "confirmed");
+      throw failure;
+    }
+  });
+  const booking = service.createBooking(slot);
+
+  assert.throws(() => service.cancelBooking(booking.bookingId, 40), (error) => error === failure);
+  assert.deepEqual(service.getBooking(booking.bookingId), booking);
+  assert.throws(() => service.createBooking(slot), ConflictError);
+
+  shouldThrow = false;
+  assert.equal(service.cancelBooking(booking.bookingId, 40).booking.status, "cancelled");
+  assert.equal(service.createBooking(slot).status, "confirmed");
+});
+
+test("a notification hook cannot write bookings while changes are pending", () => {
+  const service = setup(() => {
+    service.createBooking({ ...slot, roomId: "b" });
+  });
+
+  assert.throws(() => service.createBooking(slot), ValidationError);
+  assert.deepEqual(service.listRoomBookings("a"), []);
+  assert.deepEqual(service.listRoomBookings("b"), []);
+});
