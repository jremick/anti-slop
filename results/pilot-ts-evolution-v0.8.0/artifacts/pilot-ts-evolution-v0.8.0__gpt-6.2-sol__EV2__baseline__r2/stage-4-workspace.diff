+
+function isNonNegativeInteger(value: unknown): value is number {
+  return typeof value === "number" && Number.isInteger(value) && value >= 0;
+}
+
+export function loadCancellationFeeConfig(env: BookingEnv = resolveBookingEnv()): CancellationFeeConfig {
+  const key = "BOOKING_CANCEL_FEE_TIERS_JSON";
+  const raw = env[key];
+  if (raw === undefined || raw.trim() === "") {
+    throw new ConfigError(`${key} is required`);
+  }
+
+  let tiers: unknown;
+  try {
+    tiers = JSON.parse(raw);
+  } catch {
+    throw new ConfigError(`${key} must contain valid JSON`);
+  }
+  if (typeof tiers !== "object" || tiers === null || Array.isArray(tiers)) {
+    throw new ConfigError(`${key} must contain a JSON object`);
+  }
+
+  const { cutoffMinutes, earlyFeeBps, lateFeeBps } = tiers as Record<string, unknown>;
+  if (!isNonNegativeInteger(cutoffMinutes)) {
+    throw new ConfigError(`${key}.cutoffMinutes must be a non-negative integer`);
+  }
+  if (!isNonNegativeInteger(earlyFeeBps) || earlyFeeBps > 10000) {
+    throw new ConfigError(`${key}.earlyFeeBps must be an integer from 0 to 10000`);
+  }
+  if (!isNonNegativeInteger(lateFeeBps) || lateFeeBps > 10000) {
+    throw new ConfigError(`${key}.lateFeeBps must be an integer from 0 to 10000`);
+  }
+  return { cutoffMinutes, earlyFeeBps, lateFeeBps };
+}
+
+export function selectCancellationFeeBps(minutesBeforeStart: number, cfg: CancellationFeeConfig): number {
+  return minutesBeforeStart >= cfg.cutoffMinutes ? cfg.earlyFeeBps : cfg.lateFeeBps;
+}

