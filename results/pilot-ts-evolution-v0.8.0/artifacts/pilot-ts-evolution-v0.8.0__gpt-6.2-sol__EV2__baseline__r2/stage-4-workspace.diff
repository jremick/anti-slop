+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  BookingService,
+  ConfigError,
+  ConflictError,
+  ValidationError,
+  computeCancellationRefund,
+  loadCancellationFeeConfig,
+  selectCancellationFeeBps,
+} from "../src/index.ts";
+
+const configKey = "BOOKING_CANCEL_FEE_TIERS_JSON";
+const tiers = { cutoffMinutes: 20, earlyFeeBps: 5000, lateFeeBps: 7500 };
+const configuredEnv = { [configKey]: JSON.stringify(tiers) };
+const slot = { roomId: "a", customerId: "customer", startMinute: 60, endMinute: 120 };
+
+function setup(env: Record<string, string | undefined>): BookingService {
+  const service = new BookingService({ env });
+  service.registerRoom({ roomId: slot.roomId, name: "Room A", hourlyRateCents: 81, taxBps: 2500 });
+  return service;
+}
+
+test("cancellation config accepts boundary values and selects the early tier at the cutoff", () => {
+  const config = loadCancellationFeeConfig(configuredEnv);
+  assert.deepEqual(config, tiers);
+  assert.equal(selectCancellationFeeBps(21, config), 5000);
+  assert.equal(selectCancellationFeeBps(20, config), 5000);
+  assert.equal(selectCancellationFeeBps(19, config), 7500);
+
+  const zeroCutoff = { cutoffMinutes: 0, earlyFeeBps: 0, lateFeeBps: 10000 };
+  assert.deepEqual(loadCancellationFeeConfig({ [configKey]: JSON.stringify(zeroCutoff) }), zeroCutoff);
+  assert.equal(selectCancellationFeeBps(0, zeroCutoff), 0);
+});
+
+test("cancellation fees round half-up and refunds use the remaining cents", () => {
+  assert.deepEqual(computeCancellationRefund(101, 4999), { feeCents: 50, refundCents: 51 });
+  assert.deepEqual(computeCancellationRefund(101, 5000), { feeCents: 51, refundCents: 50 });
+  assert.deepEqual(computeCancellationRefund(101, 0), { feeCents: 0, refundCents: 101 });
+  assert.deepEqual(computeCancellationRefund(101, 10000), { feeCents: 101, refundCents: 0 });
+  assert.throws(() => computeCancellationRefund(-1, 0), ValidationError);
+  assert.throws(() => computeCancellationRefund(101, 10001), ValidationError);
+});
+
+test("cancelBooking uses the taxed total and allows cancellation at the start minute", () => {
+  for (const [nowMinute, feeBps, feeCents] of [
+    [39, 5000, 51],
+    [40, 5000, 51],
+    [41, 7500, 76],
+    [60, 7500, 76],
+  ]) {
+    const service = setup(configuredEnv);
+    const booking = service.createBooking(slot);
+    assert.equal(booking.totalCents, 101);
+    const result = service.cancelBooking(booking.bookingId, nowMinute);
+
+    assert.deepEqual(result, {
+      booking: { ...booking, status: "cancelled" },
+      feeBps,
+      feeCents,
+      refundCents: 101 - feeCents,
+    });
+    assert.deepEqual(service.getBooking(booking.bookingId), result.booking);
+    assert.throws(() => service.cancelBooking(booking.bookingId, nowMinute), ValidationError);
+    const replacement = service.createBooking({ ...slot, nowMinute });
+    assert.deepEqual(service.listRoomBookings(slot.roomId), [result.booking, replacement]);
+  }
+});
+
+test("missing and malformed fee tiers leave the booking and slot intact", () => {
+  const invalidFields = [
+    { cutoffMinutes: -1 },
+    { cutoffMinutes: 0.5 },
+    { cutoffMinutes: "20" },
+    { earlyFeeBps: -1 },
+    { earlyFeeBps: 10001 },
+    { earlyFeeBps: "5000" },
+    { lateFeeBps: null },
+    { lateFeeBps: 0.5 },
+    { lateFeeBps: 10001 },
+    { lateFeeBps: undefined },
+  ];
+  const invalidConfigs = [
+    undefined, "", " \t", "{", "null", "[]", "42", "true", "{}",
+    ...invalidFields.map((override) => JSON.stringify({ ...tiers, ...override })),
+  ];
+  for (const raw of invalidConfigs) {
+    const env = { [configKey]: raw };
+    const service = setup(env);
+    const booking = service.createBooking(slot);
+    assert.throws(() => loadCancellationFeeConfig(env), ConfigError);
+    assert.throws(() => service.cancelBooking(booking.bookingId, 40), ConfigError);
+    assert.deepEqual(service.getBooking(booking.bookingId), booking);
+    assert.throws(() => service.createBooking(slot), ConflictError);
+  }
+});
+
+test("cancelBooking rejects unknown bookings and cancellations after the start", () => {
+  const service = setup({});
+  const booking = service.createBooking(slot);
+  assert.throws(() => service.cancelBooking("missing", 40), ValidationError);
+  assert.throws(() => service.cancelBooking(booking.bookingId, 61), ValidationError);
+  assert.deepEqual(service.getBooking(booking.bookingId), booking);
+});
+
+test("cancellation reads the injected environment at call time and releases active holds", () => {
+  const env: Record<string, string | undefined> = {};
+  const service = setup(env);
+  const hold = service.createBooking({ ...slot, nowMinute: 40, holdMinutes: 10 });
+  assert.throws(() => service.cancelBooking(hold.bookingId, 40), ConfigError);
+  assert.throws(() => service.createBooking({ ...slot, nowMinute: 40 }), ConflictError);
+
+  env[configKey] = configuredEnv[configKey];
+  const { booking } = service.cancelBooking(hold.bookingId, 40);
+  assert.equal(booking.status, "cancelled");
+  assert.throws(() => service.confirmHold(hold.bookingId, 40), ValidationError);
+  assert.equal(service.createBooking({ ...slot, nowMinute: 40 }).status, "confirmed");
+});

