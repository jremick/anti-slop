+const roomA = { roomId: "a", name: "Room A", hourlyRateCents: 90, taxBps: 2500 };
+const roomB = { roomId: "b", name: "Room B", hourlyRateCents: 330, taxBps: 3750 };
+const groupInput = {
+  roomIds: [roomA.roomId, roomB.roomId],
+  customerId: " corporate ",
+  startMinute: 10,
+  endMinute: 11,
+  discountBps: 2500,
+};
+
+function setup(): BookingService {
+  const service = new BookingService({ env: {} });
+  service.registerRoom(roomA);
+  service.registerRoom(roomB);
+  return service;
+}
+
+test("discounts round half-up before tax and validate cents and basis points", () => {
+  assert.deepEqual(applyDiscountAndTax(6, 2500, 3750), {
+    subtotalCents: 4,
+    discountCents: 2,
+    taxCents: 2,
+    totalCents: 6,
+  });
+  assert.deepEqual(applyDiscountAndTax(10001, 0, 10000), {
+    subtotalCents: 10001,
+    discountCents: 0,
+    taxCents: 10001,
+    totalCents: 20002,
+  });
+  assert.deepEqual(applyDiscountAndTax(6, 10000, 10000), {
+    subtotalCents: 0,
+    discountCents: 6,
+    taxCents: 0,
+    totalCents: 0,
+  });
+  for (const value of [-1, 0.5, 10001, NaN, Infinity]) {
+    assert.throws(() => applyDiscountAndTax(6, value, 0), ValidationError);
+    assert.throws(() => applyDiscountAndTax(6, 0, value), ValidationError);
+  }
+  for (const gross of [-1, 0.5, NaN, Infinity]) {
+    assert.throws(() => applyDiscountAndTax(gross, 0, 0), ValidationError);
+  }
+  assert.deepEqual(calculateBookingPrice(roomB, 1, { discountBps: 2500 }), {
+    subtotalCents: 4,
+    discountCents: 2,
+    taxCents: 2,
+    totalCents: 6,
+  });
+});
+
+test("group bookings price each room before summing and persist a shared group ID", () => {
+  const service = setup();
+  const group = createGroupBooking(service, groupInput);
+  const { groupId, bookings, ...totals } = group;
+  assert.ok(groupId);
+  assert.deepEqual(totals, { subtotalCents: 5, discountCents: 3, taxCents: 2, totalCents: 7 });
+  assert.deepEqual(bookings.map((booking) => booking.roomId), groupInput.roomIds);
+  assert.notEqual(bookings[0].bookingId, bookings[1].bookingId);
+
+  for (const [index, room] of [roomA, roomB].entries()) {
+    const booking = bookings[index];
+    assert.deepEqual(booking, {
+      bookingId: booking.bookingId,
+      groupId,
+      roomId: room.roomId,
+      customerId: "corporate",
+      startMinute: 10,
+      endMinute: 11,
+      status: "confirmed",
+      ...calculateBookingPrice(room, 1, { discountBps: 2500 }),
+    });
+    assert.deepEqual(service.getBooking(booking.bookingId), booking);
+    assert.deepEqual(service.listRoomBookings(room.roomId), [booking]);
+  }
+
+  const nextGroup = createGroupBooking(service, { ...groupInput, startMinute: 11, endMinute: 12 });
+  assert.notEqual(nextGroup.groupId, groupId);
+  assert.throws(() => service.createBooking({ ...groupInput, roomId: roomA.roomId }), ConflictError);
+});
+
+test("an active hold in the last requested room prevents every group booking until expiry", () => {
+  const service = setup();
+  const adjacent = service.createBooking({
+    roomId: roomA.roomId, customerId: "adjacent", startMinute: 9, endMinute: 10,
+  });
+  const held = service.createBooking({
+    roomId: roomB.roomId, customerId: "held", startMinute: 10, endMinute: 12, holdMinutes: 5,
+  });
+
+  assert.throws(() => createGroupBooking(service, groupInput), ConflictError);
+  assert.throws(() => createGroupBooking(service, { ...groupInput, nowMinute: 4 }), ConflictError);
+  assert.deepEqual(service.listRoomBookings(roomA.roomId), [adjacent]);
+  assert.deepEqual(service.listRoomBookings(roomB.roomId), [held]);
+
+  assert.equal(createGroupBooking(service, { ...groupInput, nowMinute: 5 }).bookings.length, 2);
+  assert.equal(service.listRoomBookings(roomA.roomId).length, 2);
+  assert.equal(service.listRoomBookings(roomB.roomId).length, 2);
+});
+
+test("invalid group requests fail before creating any bookings", () => {
+  const service = setup();
+  for (const overrides of [
+    { roomIds: [] },
+    { roomIds: [roomA.roomId] },
+    { roomIds: [roomA.roomId, roomB.roomId, roomA.roomId] },
+    { roomIds: [roomA.roomId, "unknown"] },
+    { discountBps: -1 },
+    { discountBps: 0.5 },
+    { discountBps: 10001 },
+    { discountBps: NaN },
+    { customerId: " " },
+    { startMinute: -1 },
+    { endMinute: groupInput.startMinute },
+  ]) {
+    assert.throws(() => createGroupBooking(service, { ...groupInput, ...overrides }), ValidationError);
+    assert.deepEqual(service.listRoomBookings(roomA.roomId), []);
+    assert.deepEqual(service.listRoomBookings(roomB.roomId), []);
+  }
+});

