+const room = {
+  roomId: "meeting",
+  name: "Meeting Room",
+  hourlyRateCents: 90,
+  taxBps: 2500,
+};
+
+const slot = {
+  roomId: room.roomId,
+  customerId: "cust_1",
+  startMinute: 100,
+  endMinute: 130,
+};
+
+test("roundHalfUpDiv rounds below, at, and above half and rejects invalid inputs", () => {
+  assert.equal(roundHalfUpDiv(0, 60), 0);
+  assert.equal(roundHalfUpDiv(89, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2);
+  assert.equal(roundHalfUpDiv(91, 60), 2);
+  assert.equal(roundHalfUpDiv(4, 3), 1);
+  assert.equal(roundHalfUpDiv(5, 3), 2);
+  for (const numerator of [-1, 1.5, NaN, Infinity]) {
+    assert.throws(() => roundHalfUpDiv(numerator, 60), ValidationError);
+  }
+  for (const denominator of [0, -1, 1.5, NaN, Infinity]) {
+    assert.throws(() => roundHalfUpDiv(90, denominator), ValidationError);
+  }
+});
+
+test("prorated pricing rounds subtotal before tax and legacy deposit", () => {
+  assert.deepEqual(calculateBookingPrice(room, 1, { legacyDepositMode: true }), {
+    subtotalCents: 2,
+    discountCents: 0,
+    taxCents: 1,
+    totalCents: 3,
+    depositCents: 1,
+  });
+  assert.equal(calculateBookingPrice(room, 61).subtotalCents, 92);
+  assert.equal(calculateBookingPrice({ ...room, hourlyRateCents: 1 }, 1).totalCents, 0);
+  for (const duration of [0, -1, 1.5]) {
+    assert.throws(() => calculateBookingPrice(room, duration), ValidationError);
+  }
+});
+
+test("slotsOverlap uses half-open intervals", () => {
