+  assert.equal(slotsOverlap(100, 130, 130, 150), false);
+  assert.equal(slotsOverlap(100, 130, 99, 101), true);
+  assert.equal(slotsOverlap(100, 130, 129, 131), true);
+  assert.equal(slotsOverlap(100, 130, 110, 120), true);
+});
