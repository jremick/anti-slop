{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,145p' benchmarks/sources/ev2_ts_bookings/tests/bookings.test.ts && sed -n '35,105p' benchmarks/sources/ev2_ts_bookings/src/models.ts\"","aggregated_output":"import test from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport {\n  BookingService,\n  ConflictError,\n  ValidationError,\n  calculateBookingPrice,\n  calculateLegacyDeposit,\n  isBookingActiveAt,\n  roundHalfUpDiv,\n  slotsOverlap,\n} from \"../src/index.ts\";\n\ntest(\"baseline whole-hour booking computes exact subtotal and tax\", () => {\n  const svc = new BookingService({ env: {} });\n  svc.registerRoom({\n    roomId: \"conf_a\",\n    name: \"Conference A\",\n    hourlyRateCents: 10000,\n    taxBps: 825,\n  });\n\n  const booking = svc.createBooking({\n    roomId: \"conf_a\",\n    customerId: \"cust_1\",\n    startMinute: 60,\n    endMinute: 180,\n  });\n\n  assert.equal(booking.status, \"confirmed\");\n  assert.equal(booking.subtotalCents, 20000);\n  assert.equal(booking.taxCents, 1650);\n  assert.equal(booking.totalCents, 21650);\n  assert.equal(booking.depositCents, 0);\n  assert.equal(svc.listRoomBookings(\"conf_a\").length, 1);\n});\n\ntest(\"baseline legacy deposit mode calculates 25 percent deposit\", () => {\n  const svc = new BookingService({ env: {} });\n  svc.registerRoom({\n    roomId: \"conf_b\",\n    name: \"Conference B\",\n    hourlyRateCents: 4000,\n    taxBps: 0,\n  });\n\n  const booking = svc.createBooking({\n    roomId: \"conf_b\",\n    customerId: \"cust_2\",\n    startMinute: 0,\n    endMinute: 60,\n    legacyDepositMode: true,\n  });\n\n  assert.equal(calculateLegacyDeposit(4000), 1000);\n  assert.equal(booking.depositCents, 1000);\n});\n\ntest(\"baseline rejects invalid room or inverted time range\", () => {\n  const svc = new BookingService({ env: {} });\n  svc.registerRoom({\n    roomId: \"conf_c\",\n    name: \"Conference C\",\n    hourlyRateCents: 5000,\n    taxBps: 500,\n  });\n\n  assert.throws(\n    () =>\n      svc.createBooking({\n        roomId: \"missing\",\n        customerId: \"cust_1\",\n        startMinute: 0,\n        endMinute: 60,\n      }),\n    ValidationError,\n  );\n  assert.throws(\n    () =>\n      svc.createBooking({\n        roomId: \"conf_c\",\n        customerId: \"cust_1\",\n        startMinute: 120,\n        endMinute: 60,\n      }),\n    ValidationError,\n  );\n});\n\nconst room = {\n  roomId: \"meeting\",\n  name: \"Meeting Room\",\n  hourlyRateCents: 90,\n  taxBps: 2500,\n};\n\nconst slot = {\n  roomId: room.roomId,\n  customerId: \"cust_1\",\n  startMinute: 100,\n  endMinute: 130,\n};\n\ntest(\"roundHalfUpDiv rounds below, at, and above half and rejects invalid inputs\", () => {\n  assert.equal(roundHalfUpDiv(0, 60), 0);\n  assert.equal(roundHalfUpDiv(89, 60), 1);\n  assert.equal(roundHalfUpDiv(90, 60), 2);\n  assert.equal(roundHalfUpDiv(91, 60), 2);\n  assert.equal(roundHalfUpDiv(4, 3), 1);\n  assert.equal(roundHalfUpDiv(5, 3), 2);\n  for (const numerator of [-1, 1.5, NaN, Infinity]) {\n    assert.throws(() => roundHalfUpDiv(numerator, 60), ValidationError);\n  }\n  for (const denominator of [0, -1, 1.5, NaN, Infinity]) {\n    assert.throws(() => roundHalfUpDiv(90, denominator), ValidationError);\n  }\n});\n\ntest(\"prorated pricing rounds subtotal before tax and legacy deposit\", () => {\n  assert.deepEqual(calculateBookingPrice(room, 1, { legacyDepositMode: true }), {\n    subtotalCents: 2,\n    discountCents: 0,\n    taxCents: 1,\n    totalCents: 3,\n    depositCents: 1,\n  });\n  assert.equal(calculateBookingPrice(room, 61).subtotalCents, 92);\n  assert.equal(calculateBookingPrice({ ...room, hourlyRateCents: 1 }, 1).totalCents, 0);\n  for (const duration of [0, -1, 1.5]) {\n    assert.throws(() => calculateBookingPrice(room, duration), ValidationError);\n  }\n});\n\ntest(\"slotsOverlap uses half-open intervals\", () => {\n  assert.equal(slotsOverlap(100, 130, 70, 100), false);\n  assert.equal(slotsOverlap(100, 130, 130, 150), false);\n  assert.equal(slotsOverlap(100, 130, 99, 101), true);\n  assert.equal(slotsOverlap(100, 130, 129, 131), true);\n  assert.equal(slotsOverlap(100, 130, 110, 120), true);\n});\n\ntest(\"confirmed bookings conflict only on overlapping slots in the same room\", () => {\n  const svc = new BookingService({ env: {} });\n  svc.registerRoom(room);\n  svc.registerRoom({ ...room, roomId: \"other\" });\n  readonly taxBps: number;\n}\n\nexport interface PriceBreakdown {\n  readonly subtotalCents: number;\n  readonly discountCents: number;\n  readonly taxCents: number;\n  readonly totalCents: number;\n}\n\nexport interface Booking {\n  readonly bookingId: string;\n  readonly roomId: string;\n  readonly customerId: string;\n  readonly startMinute: number;\n  readonly endMinute: number;\n  readonly status: BookingStatus;\n  readonly subtotalCents: number;\n  readonly discountCents: number;\n  readonly taxCents: number;\n  readonly totalCents: number;\n  readonly expiresAt?: number;\n  readonly groupId?: string;\n}\n\nexport interface BookingNotification {\n  readonly event: \"booking_created\" | \"booking_cancelled\";\n  readonly bookingId: string;\n  readonly roomId: string;\n  readonly customerId: string;\n  readonly amountCents: number;\n}\n\nexport interface CreateBookingInput {\n  readonly roomId: string;\n  readonly customerId: string;\n  readonly startMinute: number;\n  readonly endMinute: number;\n  readonly nowMinute?: number;\n  readonly holdMinutes?: number;\n}\n\nexport interface CreateGroupBookingInput {\n  readonly customerId: string;\n  readonly roomIds: readonly string[];\n  readonly startMinute: number;\n  readonly endMinute: number;\n  readonly discountBps: number;\n  readonly nowMinute?: number;\n}\n\nexport interface GroupBookingResult extends PriceBreakdown {\n  readonly groupId: string;\n  readonly bookings: readonly Booking[];\n}\n\nexport interface CancelBookingResult {\n  readonly booking: Booking;\n  readonly feeBps: number;\n  readonly feeCents: number;\n  readonly refundCents: number;\n}\n","exit_code":0,"status":"completed"}}
