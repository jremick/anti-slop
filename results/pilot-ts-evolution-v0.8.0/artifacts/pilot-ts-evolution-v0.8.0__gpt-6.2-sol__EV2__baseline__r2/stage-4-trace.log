{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc 'cat benchmarks/sources/ev2_ts_bookings/src/{bookings,models}.ts'","aggregated_output":"import {\n  loadBookingConfig,\n  loadCancellationFeeConfig,\n  resolveBookingEnv,\n  selectCancellationFeeBps,\n} from \"./config.ts\";\nimport type { BookingConfig, BookingEnv } from \"./config.ts\";\nimport { ConflictError, ValidationError } from \"./models.ts\";\nimport type {\n  Booking,\n  CancelBookingResult,\n  CreateBookingInput,\n  CreateGroupBookingInput,\n  GroupBookingResult,\n  Room,\n} from \"./models.ts\";\nimport {\n  calculateBookingPrice,\n  computeCancellationRefund,\n  validateBasisPoints,\n  validateNonNegativeInt,\n  validatePositiveInt,\n} from \"./pricing.ts\";\nimport type { BookingPriceOptions } from \"./pricing.ts\";\n\ntype BookingDraft = Omit<Booking, \"bookingId\">;\ntype BookingSlot = Pick<CreateBookingInput, \"customerId\" | \"startMinute\" | \"endMinute\" | \"nowMinute\">;\n\nexport interface BookingServiceOptions {\n  readonly env?: BookingEnv;\n}\n\nexport function slotsOverlap(startA: number, endA: number, startB: number, endB: number): boolean {\n  return startA < endB && startB < endA;\n}\n\nexport function isBookingActiveAt(booking: Booking, nowMinute: number): boolean {\n  return booking.status === \"confirmed\"\n    || (booking.status === \"held\" && booking.expiresAt !== undefined && nowMinute < booking.expiresAt);\n}\n\nexport class BookingService {\n  readonly config: BookingConfig;\n  private readonly env: BookingEnv;\n  private readonly rooms: Map<string, Room> = new Map();\n  private readonly bookings: Map<string, Booking> = new Map();\n  private seq = 0;\n\n  constructor(options: BookingServiceOptions = {}) {\n    this.env = resolveBookingEnv(options.env);\n    this.config = loadBookingConfig(this.env);\n  }\n\n  private nextId(prefix: string): string {\n    this.seq += 1;\n    return `${prefix}_${String(this.seq).padStart(4, \"0\")}`;\n  }\n\n  registerRoom(room: Room): void {\n    if (typeof room.roomId !== \"string\" || room.roomId.trim() === \"\") {\n      throw new ValidationError(\"roomId must be a non-empty string\");\n    }\n    if (typeof room.name !== \"string\" || room.name.trim() === \"\") {\n      throw new ValidationError(\"name must be a non-empty string\");\n    }\n    validatePositiveInt(room.hourlyRateCents, \"hourlyRateCents\");\n    validateBasisPoints(room.taxBps, \"taxBps\");\n    this.rooms.set(room.roomId, room);\n  }\n\n  getRoom(roomId: string): Room {\n    const room = this.rooms.get(roomId);\n    if (room === undefined) {\n      throw new ValidationError(`Unknown roomId: ${roomId}`);\n    }\n    return room;\n  }\n\n  getBooking(bookingId: string): Booking {\n    const booking = this.bookings.get(bookingId);\n    if (booking === undefined) {\n      throw new ValidationError(`Unknown bookingId: ${bookingId}`);\n    }\n    return booking;\n  }\n\n  listRoomBookings(roomId: string): Booking[] {\n    this.getRoom(roomId);\n    const matches: Booking[] = [];\n    for (const booking of this.bookings.values()) {\n      if (booking.roomId === roomId) {\n        matches.push(booking);\n      }\n    }\n    return matches;\n  }\n\n  createBooking(input: CreateBookingInput): Booking {\n    const { nowMinute = 0, holdMinutes } = input;\n    if (holdMinutes !== undefined) {\n      validatePositiveInt(holdMinutes, \"holdMinutes\");\n      if (holdMinutes > this.config.maxHoldMinutes) {\n        throw new ValidationError(`holdMinutes cannot exceed ${this.config.maxHoldMinutes}`);\n      }\n    }\n\n    const [draft] = this.prepareBookings(input, new Set([input.roomId]), {\n      legacyDepositMode: input.legacyDepositMode === true,\n    });\n    return this.storeBooking(holdMinutes === undefined\n      ? draft\n      : { ...draft, status: \"held\", expiresAt: nowMinute + holdMinutes });\n  }\n\n  createGroupBooking(input: CreateGroupBookingInput): GroupBookingResult {\n    if (!Array.isArray(input.roomIds) || input.roomIds.length < 2) {\n      throw new ValidationError(\"A group booking requires at least two room IDs\");\n    }\n    const roomIds = new Set(input.roomIds);\n    if (roomIds.size !== input.roomIds.length) {\n      throw new ValidationError(\"roomIds cannot contain duplicates\");\n    }\n    validateBasisPoints(input.discountBps, \"discountBps\");\n\n    const drafts = this.prepareBookings(input, roomIds, { discountBps: input.discountBps });\n    const groupId = this.nextId(\"grp\");\n    const bookings = drafts.map((draft) => this.storeBooking({ ...draft, groupId }));\n\n    let subtotalCents = 0;\n    let discountCents = 0;\n    let taxCents = 0;\n    let totalCents = 0;\n    for (const booking of bookings) {\n      subtotalCents += booking.subtotalCents;\n      discountCents += booking.discountCents;\n      taxCents += booking.taxCents;\n      totalCents += booking.totalCents;\n    }\n    return { groupId, bookings, subtotalCents, discountCents, taxCents, totalCents };\n  }\n\n  private prepareBookings(\n    { customerId, startMinute, endMinute, nowMinute = 0 }: BookingSlot,\n    roomIds: ReadonlySet<string>,\n    pricingOptions: BookingPriceOptions,\n  ): BookingDraft[] {\n    if (typeof customerId !== \"string\" || customerId.trim() === \"\") {\n      throw new ValidationError(\"customerId must be a non-empty string\");\n    }\n    validateNonNegativeInt(startMinute, \"startMinute\");\n    validatePositiveInt(endMinute, \"endMinute\");\n    if (endMinute <= startMinute) {\n      throw new ValidationError(\"endMinute must be strictly greater than startMinute\");\n    }\n\n    const rooms = Array.from(roomIds, (roomId) => this.getRoom(roomId));\n    for (const booking of this.bookings.values()) {\n      if (roomIds.has(booking.roomId)\n        && isBookingActiveAt(booking, nowMinute)\n        && slotsOverlap(booking.startMinute, booking.endMinute, startMinute, endMinute)) {\n        throw new ConflictError(`Booking overlaps an active booking for room ${booking.roomId}`);\n      }\n    }\n\n    const duration = endMinute - startMinute;\n    const normalizedCustomerId = customerId.trim();\n    return rooms.map((room) => ({\n      roomId: room.roomId,\n      customerId: normalizedCustomerId,\n      startMinute,\n      endMinute,\n      status: \"confirmed\",\n      ...calculateBookingPrice(room, duration, pricingOptions),\n    }));\n  }\n\n  private storeBooking(draft: BookingDraft): Booking {\n    const booking: Booking = { bookingId: this.nextId(\"bkg\"), ...draft };\n    this.bookings.set(booking.bookingId, booking);\n    return booking;\n  }\n\n  confirmHold(bookingId: string, nowMinute: number): Booking {\n    const booking = this.getBooking(bookingId);\n    if (booking.status !== \"held\" || !isBookingActiveAt(booking, nowMinute)) {\n      throw new ValidationError(`Booking ${bookingId} is not an active hold`);\n    }\n\n    const { expiresAt, ...details } = booking;\n    const confirmed: Booking = { ...details, status: \"confirmed\" };\n    this.bookings.set(bookingId, confirmed);\n    return confirmed;\n  }\n\n  cancelBooking(bookingId: string, nowMinute: number): CancelBookingResult {\n    const booking = this.getBooking(bookingId);\n    if (booking.status === \"cancelled\") {\n      throw new ValidationError(`Booking ${bookingId} is already cancelled`);\n    }\n    if (nowMinute > booking.startMinute) {\n      throw new ValidationError(`Booking ${bookingId} has already started`);\n    }\n\n    const config = loadCancellationFeeConfig(this.env);\n    const feeBps = selectCancellationFeeBps(booking.startMinute - nowMinute, config);\n    const refund = computeCancellationRefund(booking.totalCents, feeBps);\n    const cancelled: Booking = { ...booking, status: \"cancelled\" };\n    this.bookings.set(bookingId, cancelled);\n    return { booking: cancelled, feeBps, ...refund };\n  }\n}\nexport class BookingError extends Error {\n  constructor(message: string) {\n    super(message);\n    this.name = \"BookingError\";\n  }\n}\n\nexport class ValidationError extends BookingError {\n  constructor(message: string) {\n    super(message);\n    this.name = \"ValidationError\";\n  }\n}\n\nexport class ConflictError extends BookingError {\n  constructor(message: string) {\n    super(message);\n    this.name = \"ConflictError\";\n  }\n}\n\nexport class ConfigError extends BookingError {\n  constructor(message: string) {\n    super(message);\n    this.name = \"ConfigError\";\n  }\n}\n\nexport type BookingStatus = \"confirmed\" | \"held\" | \"cancelled\";\n\nexport interface Room {\n  readonly roomId: string;\n  readonly name: string;\n  readonly hourlyRateCents: number;\n  readonly taxBps: number;\n}\n\nexport interface PriceBreakdown {\n  readonly subtotalCents: number;\n  readonly discountCents: number;\n  readonly taxCents: number;\n  readonly totalCents: number;\n  readonly depositCents: number;\n}\n\nexport interface Booking {\n  readonly bookingId: string;\n  readonly roomId: string;\n  readonly customerId: string;\n  readonly startMinute: number;\n  readonly endMinute: number;\n  readonly status: BookingStatus;\n  readonly subtotalCents: number;\n  readonly discountCents: number;\n  readonly taxCents: number;\n  readonly totalCents: number;\n  readonly expiresAt?: number;\n  readonly groupId?: string;\n  readonly depositCents?: number;\n}\n\nexport interface CreateBookingInput {\n  readonly roomId: string;\n  readonly customerId: string;\n  readonly startMinute: number;\n  readonly endMinute: number;\n  readonly legacyDepositMode?: boolean;\n  readonly nowMinute?: number;\n  readonly holdMinutes?: number;\n}\n\nexport interface CreateGroupBookingInput {\n  readonly customerId: string;\n  readonly roomIds: readonly string[];\n  readonly startMinute: number;\n  readonly endMinute: number;\n  readonly discountBps: number;\n  readonly nowMinute?: number;\n}\n\nexport interface GroupBookingResult extends Omit<PriceBreakdown, \"depositCents\"> {\n  readonly groupId: string;\n  readonly bookings: readonly Booking[];\n}\n\nexport interface CancelBookingResult {\n  readonly booking: Booking;\n  readonly feeBps: number;\n  readonly feeCents: number;\n  readonly refundCents: number;\n}\n","exit_code":0,"status":"completed"}}
