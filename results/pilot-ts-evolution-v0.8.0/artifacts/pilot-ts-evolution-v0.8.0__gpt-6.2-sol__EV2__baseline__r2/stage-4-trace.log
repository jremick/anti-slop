{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"cat benchmarks/sources/ev2_ts_bookings/src/{pricing,index,corporate}.ts; rg -n -i 'deposit|notify' benchmarks/sources/ev2_ts_bookings\"","aggregated_output":"import { ValidationError } from \"./models.ts\";\nimport type { PriceBreakdown, Room } from \"./models.ts\";\n\nexport const LEGACY_DEPOSIT_BPS = 2500;\n\nexport interface BookingPriceOptions {\n  readonly legacyDepositMode?: boolean;\n  readonly discountBps?: number;\n}\n\nexport function validateNonNegativeInt(value: number, fieldName: string): number {\n  if (!Number.isInteger(value) || value < 0) {\n    throw new ValidationError(`${fieldName} must be a non-negative integer`);\n  }\n  return value;\n}\n\nexport function validatePositiveInt(value: number, fieldName: string): number {\n  if (!Number.isInteger(value) || value <= 0) {\n    throw new ValidationError(`${fieldName} must be a positive integer`);\n  }\n  return value;\n}\n\nexport function roundHalfUpDiv(numerator: number, denominator: number): number {\n  validateNonNegativeInt(numerator, \"numerator\");\n  validatePositiveInt(denominator, \"denominator\");\n  return Math.floor((numerator * 2 + denominator) / (2 * denominator));\n}\n\nexport function validateBasisPoints(value: number, fieldName: string): void {\n  validateNonNegativeInt(value, fieldName);\n  if (value > 10000) {\n    throw new ValidationError(`${fieldName} cannot exceed 10000`);\n  }\n}\n\nexport function computeTaxCents(taxableCents: number, taxBps: number): number {\n  validateNonNegativeInt(taxableCents, \"taxableCents\");\n  validateBasisPoints(taxBps, \"taxBps\");\n  return roundHalfUpDiv(taxableCents * taxBps, 10000);\n}\n\nexport function applyDiscountAndTax(\n  grossSubtotalCents: number,\n  discountBps: number,\n  taxBps: number,\n): Omit<PriceBreakdown, \"depositCents\"> {\n  validateNonNegativeInt(grossSubtotalCents, \"grossSubtotalCents\");\n  validateBasisPoints(discountBps, \"discountBps\");\n  const discountCents = roundHalfUpDiv(grossSubtotalCents * discountBps, 10000);\n  const subtotalCents = grossSubtotalCents - discountCents;\n  const taxCents = computeTaxCents(subtotalCents, taxBps);\n  return { subtotalCents, discountCents, taxCents, totalCents: subtotalCents + taxCents };\n}\n\nexport function calculateLegacyDeposit(subtotalCents: number): number {\n  validateNonNegativeInt(subtotalCents, \"subtotalCents\");\n  return roundHalfUpDiv(subtotalCents * LEGACY_DEPOSIT_BPS, 10000);\n}\n\nexport function computeCancellationRefund(totalCents: number, feeBps: number): { feeCents: number; refundCents: number } {\n  validateNonNegativeInt(totalCents, \"totalCents\");\n  validateBasisPoints(feeBps, \"feeBps\");\n  const feeCents = roundHalfUpDiv(totalCents * feeBps, 10000);\n  return { feeCents, refundCents: totalCents - feeCents };\n}\n\nexport function calculateBookingPrice(\n  room: Room,\n  durationMinutes: number,\n  { discountBps = 0, legacyDepositMode }: BookingPriceOptions = {},\n): PriceBreakdown {\n  validatePositiveInt(room.hourlyRateCents, \"hourlyRateCents\");\n  validatePositiveInt(durationMinutes, \"durationMinutes\");\n  const grossSubtotalCents = roundHalfUpDiv(room.hourlyRateCents * durationMinutes, 60);\n  const price = applyDiscountAndTax(grossSubtotalCents, discountBps, room.taxBps);\n  const depositCents = legacyDepositMode === true\n    ? calculateLegacyDeposit(price.subtotalCents)\n    : 0;\n  return { ...price, depositCents };\n}\nexport {\n  BookingError,\n  ConfigError,\n  ConflictError,\n  ValidationError,\n} from \"./models.ts\";\nexport type {\n  Booking,\n  BookingStatus,\n  CancelBookingResult,\n  CreateBookingInput,\n  CreateGroupBookingInput,\n  GroupBookingResult,\n  PriceBreakdown,\n  Room,\n} from \"./models.ts\";\nexport {\n  DEFAULT_MAX_HOLD_MINUTES,\n  loadBookingConfig,\n  loadCancellationFeeConfig,\n  selectCancellationFeeBps,\n} from \"./config.ts\";\nexport type { BookingConfig, CancellationFeeConfig } from \"./config.ts\";\nexport {\n  LEGACY_DEPOSIT_BPS,\n  applyDiscountAndTax,\n  calculateBookingPrice,\n  calculateLegacyDeposit,\n  computeCancellationRefund,\n  computeTaxCents,\n  roundHalfUpDiv,\n  validateNonNegativeInt,\n  validatePositiveInt,\n} from \"./pricing.ts\";\nexport type { BookingPriceOptions } from \"./pricing.ts\";\nexport { BookingService, isBookingActiveAt, slotsOverlap } from \"./bookings.ts\";\nexport type { BookingServiceOptions } from \"./bookings.ts\";\nexport { createGroupBooking } from \"./corporate.ts\";\nimport type { BookingService } from \"./bookings.ts\";\nimport type { CreateGroupBookingInput, GroupBookingResult } from \"./models.ts\";\n\nexport function createGroupBooking(service: BookingService, input: CreateGroupBookingInput): GroupBookingResult {\n  return service.createGroupBooking(input);\n}\nbenchmarks/sources/ev2_ts_bookings/src/models.ts:43:  readonly depositCents: number;\nbenchmarks/sources/ev2_ts_bookings/src/models.ts:59:  readonly depositCents?: number;\nbenchmarks/sources/ev2_ts_bookings/src/models.ts:67:  readonly legacyDepositMode?: boolean;\nbenchmarks/sources/ev2_ts_bookings/src/models.ts:81:export interface GroupBookingResult extends Omit<PriceBreakdown, \"depositCents\"> {\nbenchmarks/sources/ev2_ts_bookings/src/index.ts:25:  LEGACY_DEPOSIT_BPS,\nbenchmarks/sources/ev2_ts_bookings/src/index.ts:28:  calculateLegacyDeposit,\nbenchmarks/sources/ev2_ts_bookings/src/bookings.ts:108:      legacyDepositMode: input.legacyDepositMode === true,\nbenchmarks/sources/ev2_ts_bookings/src/pricing.ts:4:export const LEGACY_DEPOSIT_BPS = 2500;\nbenchmarks/sources/ev2_ts_bookings/src/pricing.ts:7:  readonly legacyDepositMode?: boolean;\nbenchmarks/sources/ev2_ts_bookings/src/pricing.ts:48:): Omit<PriceBreakdown, \"depositCents\"> {\nbenchmarks/sources/ev2_ts_bookings/src/pricing.ts:57:export function calculateLegacyDeposit(subtotalCents: number): number {\nbenchmarks/sources/ev2_ts_bookings/src/pricing.ts:59:  return roundHalfUpDiv(subtotalCents * LEGACY_DEPOSIT_BPS, 10000);\nbenchmarks/sources/ev2_ts_bookings/src/pricing.ts:72:  { discountBps = 0, legacyDepositMode }: BookingPriceOptions = {},\nbenchmarks/sources/ev2_ts_bookings/src/pricing.ts:78:  const depositCents = legacyDepositMode === true\nbenchmarks/sources/ev2_ts_bookings/src/pricing.ts:79:    ? calculateLegacyDeposit(price.subtotalCents)\nbenchmarks/sources/ev2_ts_bookings/src/pricing.ts:81:  return { ...price, depositCents };\nbenchmarks/sources/ev2_ts_bookings/tests/corporate.test.ts:55:  assert.deepEqual(calculateBookingPrice(roomB, 1, { discountBps: 2500, legacyDepositMode: true }), {\nbenchmarks/sources/ev2_ts_bookings/tests/corporate.test.ts:60:    depositCents: 1,\nbenchmarks/sources/ev2_ts_bookings/tests/bookings.test.ts:8:  calculateLegacyDeposit,\nbenchmarks/sources/ev2_ts_bookings/tests/bookings.test.ts:34:  assert.equal(booking.depositCents, 0);\nbenchmarks/sources/ev2_ts_bookings/tests/bookings.test.ts:38:test(\"baseline legacy deposit mode calculates 25 percent deposit\", () => {\nbenchmarks/sources/ev2_ts_bookings/tests/bookings.test.ts:52:    legacyDepositMode: true,\nbenchmarks/sources/ev2_ts_bookings/tests/bookings.test.ts:55:  assert.equal(calculateLegacyDeposit(4000), 1000);\nbenchmarks/sources/ev2_ts_bookings/tests/bookings.test.ts:56:  assert.equal(booking.depositCents, 1000);\nbenchmarks/sources/ev2_ts_bookings/tests/bookings.test.ts:119:test(\"prorated pricing rounds subtotal before tax and legacy deposit\", () => {\nbenchmarks/sources/ev2_ts_bookings/tests/bookings.test.ts:120:  assert.deepEqual(calculateBookingPrice(room, 1, { legacyDepositMode: true }), {\nbenchmarks/sources/ev2_ts_bookings/tests/bookings.test.ts:125:    depositCents: 1,\n","exit_code":0,"status":"completed"}}
