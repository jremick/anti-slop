+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConfigError,
+  ConflictError,
+  ValidationError,
+  computeCancellationRefund,
+  isBookingActiveAt,
+  loadCancellationFeeConfig,
+  selectCancellationFeeBps,
+} from "../src/index.ts";
+
+const VALID_TIERS_JSON = JSON.stringify({
+  cutoffMinutes: 120,
+  earlyFeeBps: 1000, // 10%
+  lateFeeBps: 5000, // 50%
+});
+
+function setupService(env?: Record<string, string | undefined>): BookingService {
+  const svc = new BookingService(env === undefined ? {} : { env });
+  svc.registerRoom({
+    roomId: "conf_a",
+    name: "Conference A",
+    hourlyRateCents: 10001,
+    taxBps: 0,
+  });
+  return svc;
+}
+
+test("loadCancellationFeeConfig fails closed with ConfigError on missing or invalid values", () => {
+  const valid = loadCancellationFeeConfig({
+    BOOKING_CANCEL_FEE_TIERS_JSON: VALID_TIERS_JSON,
+  });
+  assert.deepEqual(valid, {
+    cutoffMinutes: 120,
+    earlyFeeBps: 1000,
+    lateFeeBps: 5000,
+  });
+
+  // Zero boundary values are valid
+  assert.deepEqual(
+    loadCancellationFeeConfig({
+      BOOKING_CANCEL_FEE_TIERS_JSON: JSON.stringify({
+        cutoffMinutes: 0,
+        earlyFeeBps: 0,
+        lateFeeBps: 10000,
+      }),
+    }),
+    { cutoffMinutes: 0, earlyFeeBps: 0, lateFeeBps: 10000 },
+  );
+
+  // Missing, empty, whitespace
+  assert.throws(() => loadCancellationFeeConfig({}), ConfigError);
+  assert.throws(
+    () => loadCancellationFeeConfig({ BOOKING_CANCEL_FEE_TIERS_JSON: "" }),
+    ConfigError,
+  );
+  assert.throws(
+    () => loadCancellationFeeConfig({ BOOKING_CANCEL_FEE_TIERS_JSON: "   " }),
+    ConfigError,
+  );
+
+  // Invalid JSON
+  assert.throws(
+    () => loadCancellationFeeConfig({ BOOKING_CANCEL_FEE_TIERS_JSON: "{bad json" }),
+    ConfigError,
+  );
+
+  // Non-object JSON values
+  for (const raw of ["null", "[]", "123", '"hello"', "true"]) {
+    assert.throws(
+      () => loadCancellationFeeConfig({ BOOKING_CANCEL_FEE_TIERS_JSON: raw }),
+      ConfigError,
+    );
+  }
+
+  // Negative or non-integer cutoffMinutes
+  assert.throws(
+    () =>
+      loadCancellationFeeConfig({
