+test("confirmHold transitions a non-expired hold to confirmed and clears expiresAt", () => {
+  const svc = setupService();
+
+  const hold = svc.createBooking({
+    roomId: "conf_a",
+    customerId: "cust_1",
+    startMinute: 120,
+    endMinute: 165,
+    nowMinute: 5,
+    holdMinutes: 15,
+  });
+  assert.equal(hold.status, "held");
+  assert.equal(hold.expiresAt, 20);
+
+  // Confirm just before expiry (nowMinute=19)
+  const confirmed = svc.confirmHold(hold.bookingId, 19);
+  assert.equal(confirmed.bookingId, hold.bookingId);
+  assert.equal(confirmed.status, "confirmed");
+  assert.equal(confirmed.expiresAt, undefined);
+  assert.equal("expiresAt" in confirmed, false);
+  assert.equal(confirmed.subtotalCents, hold.subtotalCents);
+  assert.equal(confirmed.taxCents, hold.taxCents);
+  assert.equal(confirmed.totalCents, hold.totalCents);
+
+  // Persisted state reflects confirmation
+  const fetched = svc.getBooking(hold.bookingId);
+  assert.equal(fetched.status, "confirmed");
+  assert.equal(fetched.expiresAt, undefined);
+
+  // Confirmed booking still blocks overlapping bookings after original expiresAt
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "conf_a",
+        customerId: "cust_2",
+        startMinute: 150,
+        endMinute: 200,
+        nowMinute: 25,
+      }),
+    ConflictError,
+  );
+
+  // Re-confirming an already confirmed booking throws ValidationError
+  assert.throws(() => svc.confirmHold(hold.bookingId, 19), ValidationError);
+});
+
+test("confirmHold rejects unknown, non-held, or expired holds with ValidationError", () => {
+  const svc = setupService();
+
+  // Unknown booking
+  assert.throws(() => svc.confirmHold("bkg_9999", 0), ValidationError);
+
+  // Already confirmed booking
+  const direct = svc.createBooking({
+    roomId: "conf_a",
+    customerId: "cust_1",
+    startMinute: 0,
+    endMinute: 60,
+  });
+  assert.throws(() => svc.confirmHold(direct.bookingId, 0), ValidationError);
+
+  // Expired hold at exact boundary and past expiry
+  const hold = svc.createBooking({
+    roomId: "conf_b",
+    customerId: "cust_2",
+    startMinute: 0,
+    endMinute: 60,
+    nowMinute: 10,
+    holdMinutes: 15,
+  });
+  assert.throws(() => svc.confirmHold(hold.bookingId, 25), ValidationError);
+  assert.throws(() => svc.confirmHold(hold.bookingId, 30), ValidationError);
+
+  // Invalid nowMinute
+  assert.throws(() => svc.confirmHold(hold.bookingId, -1), ValidationError);
+  assert.throws(() => svc.confirmHold(hold.bookingId, 12.5), ValidationError);
+});

