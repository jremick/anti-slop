+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  ValidationError,
+  applyDiscountAndTax,
+  calculateBookingPrice,
+  computeTaxCents,
+  roundHalfUpDiv,
+} from "../src/index.ts";
+import type { Room } from "../src/index.ts";
+
+test("roundHalfUpDiv performs exact integer half-up division", () => {
+  assert.equal(roundHalfUpDiv(0, 60), 0);
+  assert.equal(roundHalfUpDiv(120, 60), 2);
+  assert.equal(roundHalfUpDiv(29, 60), 0);
+  assert.equal(roundHalfUpDiv(30, 60), 1);
+  assert.equal(roundHalfUpDiv(31, 60), 1);
+  assert.equal(roundHalfUpDiv(89, 60), 1);
+  assert.equal(roundHalfUpDiv(90, 60), 2);
+  assert.equal(roundHalfUpDiv(1, 2), 1);
+  assert.equal(roundHalfUpDiv(3, 2), 2);
+  assert.equal(roundHalfUpDiv(1, 3), 0);
+  assert.equal(roundHalfUpDiv(2, 3), 1);
+  assert.equal(roundHalfUpDiv(5, 10), 1);
+  assert.equal(roundHalfUpDiv(4, 10), 0);
+});
+
+test("roundHalfUpDiv rejects invalid numerators and denominators", () => {
+  assert.throws(() => roundHalfUpDiv(-1, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(1.5, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.NaN, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(Number.POSITIVE_INFINITY, 60), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, 0), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, -5), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, 2.5), ValidationError);
+  assert.throws(() => roundHalfUpDiv(10, Number.NaN), ValidationError);
+});
+
+test("calculateBookingPrice supports fractional-hour durations with half-up cents", () => {
+  const room: Room = {
+    roomId: "r1",
+    name: "Studio 1",
+    hourlyRateCents: 101,
+    taxBps: 825,
+  };
+
+  // 101 * 30 / 60 = 50.5 -> 51 cents; tax = 51 * 825 / 10000 = 4.2075 -> 4
+  const thirtyMin = calculateBookingPrice(room, 30);
+  assert.equal(thirtyMin.subtotalCents, 51);
+  assert.equal(thirtyMin.discountCents, 0);
+  assert.equal(thirtyMin.taxCents, computeTaxCents(51, 825));
+  assert.equal(thirtyMin.taxCents, 4);
+  assert.equal(thirtyMin.totalCents, 55);
+  assert.equal(thirtyMin.depositCents, 0);
+
+  // 100 * 1 / 60 = 1.666... -> 2 cents; 100 * 2 / 60 = 3.333... -> 3 cents
+  const room100: Room = {
+    roomId: "r2",
+    name: "Studio 2",
+    hourlyRateCents: 100,
+    taxBps: 500,
+  };
+  assert.equal(calculateBookingPrice(room100, 1).subtotalCents, 2);
+  assert.equal(calculateBookingPrice(room100, 2).subtotalCents, 3);
+
+  // 90 minutes with legacy deposit mode: 100 * 90 / 60 = 150 -> deposit 25% = 37.5 -> 38
+  const ninetyMin = calculateBookingPrice(room100, 90, { legacyDepositMode: true });
+  assert.equal(ninetyMin.subtotalCents, 150);
+  assert.equal(ninetyMin.taxCents, 8); // 150 * 500 / 10000 = 7.5 -> 8
+  assert.equal(ninetyMin.totalCents, 158);
+  assert.equal(ninetyMin.depositCents, 38);
+});
+
+test("calculateBookingPrice rejects invalid durations", () => {
+  const room: Room = {
+    roomId: "r1",
+    name: "Studio 1",
+    hourlyRateCents: 5000,
+    taxBps: 500,
+  };
+  assert.throws(() => calculateBookingPrice(room, 0), ValidationError);
+  assert.throws(() => calculateBookingPrice(room, -15), ValidationError);
+  assert.throws(() => calculateBookingPrice(room, 15.5), ValidationError);
+});
+
+test("applyDiscountAndTax computes exact half-up discount, net subtotal, tax, and total", () => {
+  // 10000 * 1500 / 10000 = 1500; net = 8500; tax = 8500 * 825 / 10000 = 701.25 -> 701
+  assert.deepEqual(applyDiscountAndTax(10000, 1500, 825), {
+    subtotalCents: 8500,
+    discountCents: 1500,
+    taxCents: 701,
+    totalCents: 9201,
+  });
+
+  // Half-cent tie on discount: 100 * 50 / 10000 = 0.5 -> 1; net = 99; tax = 99 * 1000 / 10000 = 9.9 -> 10
+  assert.deepEqual(applyDiscountAndTax(100, 50, 1000), {
+    subtotalCents: 99,
+    discountCents: 1,
+    taxCents: 10,
+    totalCents: 109,
+  });
+
+  // 0% and 100% discount boundaries
+  assert.deepEqual(applyDiscountAndTax(2500, 0, 500), {
+    subtotalCents: 2500,
+    discountCents: 0,
+    taxCents: 125,
+    totalCents: 2625,
+  });
+  assert.deepEqual(applyDiscountAndTax(2500, 10000, 825), {
+    subtotalCents: 0,
+    discountCents: 2500,
+    taxCents: 0,
+    totalCents: 0,
+  });
+});
+
+test("applyDiscountAndTax and calculateBookingPrice validate discountBps and taxBps bounds", () => {
+  assert.throws(() => applyDiscountAndTax(-1, 0, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(100.5, 0, 0), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, -1, 500), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 10001, 500), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 12.5, 500), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 500, -1), ValidationError);
+  assert.throws(() => applyDiscountAndTax(1000, 500, 10001), ValidationError);
+
+  const room: Room = {
+    roomId: "r_disc",
+    name: "Discounted Room",
+    hourlyRateCents: 10001,
+    taxBps: 825,
+  };
+  // gross = roundHalfUpDiv(10001 * 45, 60) = roundHalfUpDiv(450045, 60) = 7501
+  const gross = roundHalfUpDiv(10001 * 45, 60);
+  const expected = applyDiscountAndTax(gross, 1500, 825);
+  const actual = calculateBookingPrice(room, 45, { discountBps: 1500 });
+  assert.equal(actual.subtotalCents, expected.subtotalCents);
+  assert.equal(actual.discountCents, expected.discountCents);
+  assert.equal(actual.taxCents, expected.taxCents);
+  assert.equal(actual.totalCents, expected.totalCents);
+  assert.throws(() => calculateBookingPrice(room, 45, { discountBps: 10001 }), ValidationError);
+});
