+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  BookingService,
+  ConflictError,
+  ValidationError,
+  isBookingActiveAt,
+  slotsOverlap,
+} from "../src/index.ts";
+import type { Booking } from "../src/index.ts";
+
+function setupService(env: Record<string, string | undefined> = {}): BookingService {
+  const svc = new BookingService({ env });
+  svc.registerRoom({
+    roomId: "conf_a",
+    name: "Conference A",
+    hourlyRateCents: 10000,
+    taxBps: 1000,
+  });
+  svc.registerRoom({
+    roomId: "conf_b",
+    name: "Conference B",
+    hourlyRateCents: 6000,
+    taxBps: 0,
+  });
+  return svc;
+}
+
+test("slotsOverlap treats intervals as half-open [start, end)", () => {
+  // Back-to-back intervals do not overlap
+  assert.equal(slotsOverlap(0, 60, 60, 120), false);
+  assert.equal(slotsOverlap(60, 120, 0, 60), false);
+  // Disjoint intervals
+  assert.equal(slotsOverlap(0, 30, 60, 90), false);
+  // Partial, identical, and nested overlaps
+  assert.equal(slotsOverlap(0, 60, 59, 120), true);
+  assert.equal(slotsOverlap(59, 120, 0, 60), true);
+  assert.equal(slotsOverlap(60, 120, 60, 120), true);
+  assert.equal(slotsOverlap(0, 120, 30, 90), true);
+  assert.equal(slotsOverlap(30, 90, 0, 120), true);
+  // Empty interval never overlaps
+  assert.equal(slotsOverlap(60, 60, 0, 120), false);
+});
+
+test("isBookingActiveAt handles confirmed, held, and cancelled bookings", () => {
+  const base: Omit<Booking, "status" | "expiresAt"> = {
+    bookingId: "bkg_0001",
+    roomId: "conf_a",
+    customerId: "cust_1",
+    startMinute: 60,
+    endMinute: 120,
+    subtotalCents: 10000,
+    discountCents: 0,
+    taxCents: 1000,
+    totalCents: 11000,
+    depositCents: 0,
+  };
+
+  const confirmed: Booking = { ...base, status: "confirmed" };
+  assert.equal(isBookingActiveAt(confirmed, 0), true);
+  assert.equal(isBookingActiveAt(confirmed, 9999), true);
+
+  const cancelled: Booking = { ...base, status: "cancelled" };
+  assert.equal(isBookingActiveAt(cancelled, 0), false);
+
+  const held: Booking = { ...base, status: "held", expiresAt: 45 };
+  assert.equal(isBookingActiveAt(held, 0), true);
+  assert.equal(isBookingActiveAt(held, 44), true);
+  assert.equal(isBookingActiveAt(held, 45), false);
+  assert.equal(isBookingActiveAt(held, 46), false);
+
+  const heldNoExpiry: Booking = { ...base, status: "held" };
+  assert.equal(isBookingActiveAt(heldNoExpiry, 0), false);
+
+  assert.throws(() => isBookingActiveAt(confirmed, -1), ValidationError);
+  assert.throws(() => isBookingActiveAt(confirmed, 1.5), ValidationError);
+});
+
+test("createBooking rejects overlapping confirmed slots and allows back-to-back and other rooms", () => {
+  const svc = setupService();
+
+  const first = svc.createBooking({
+    roomId: "conf_a",
+    customerId: "cust_1",
+    startMinute: 60,
+    endMinute: 105, // 45-minute booking
+  });
+  assert.equal(first.status, "confirmed");
+  assert.equal(first.expiresAt, undefined);
+  assert.equal(first.subtotalCents, 7500);
+  assert.equal(first.taxCents, 750);
+  assert.equal(first.totalCents, 8250);
+
+  // Overlapping on same room throws ConflictError
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "conf_a",
+        customerId: "cust_2",
+        startMinute: 104,
+        endMinute: 150,
+      }),
+    ConflictError,
+  );
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "conf_a",
+        customerId: "cust_2",
+        startMinute: 30,
+        endMinute: 61,
+      }),
+    ConflictError,
+  );
+
+  // Back-to-back on same room succeeds
+  const after = svc.createBooking({
+    roomId: "conf_a",
+    customerId: "cust_2",
+    startMinute: 105,
+    endMinute: 150,
+  });
+  assert.equal(after.status, "confirmed");
+
+  const before = svc.createBooking({
+    roomId: "conf_a",
+    customerId: "cust_3",
+    startMinute: 15,
+    endMinute: 60,
+  });
+  assert.equal(before.status, "confirmed");
+
+  // Same slot on different room succeeds
+  const otherRoom = svc.createBooking({
+    roomId: "conf_b",
+    customerId: "cust_2",
+    startMinute: 60,
+    endMinute: 105,
+  });
+  assert.equal(otherRoom.status, "confirmed");
+  assert.equal(svc.listRoomBookings("conf_a").length, 3);
+});
+
+test("createBooking hold lifecycle: active holds block, expired holds do not", () => {
+  const svc = setupService({ BOOKING_MAX_HOLD_MINUTES: "30" });
+
+  // Hold created at nowMinute=10 for 20 minutes -> expiresAt=30
+  const hold = svc.createBooking({
+    roomId: "conf_a",
+    customerId: "cust_1",
+    startMinute: 100,
+    endMinute: 160,
+    nowMinute: 10,
+    holdMinutes: 20,
+  });
+  assert.equal(hold.status, "held");
+  assert.equal(hold.expiresAt, 30);
+
+  // Overlapping booking while hold is active (nowMinute=29) fails with ConflictError
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "conf_a",
+        customerId: "cust_2",
+        startMinute: 120,
+        endMinute: 180,
+        nowMinute: 29,
+      }),
+    ConflictError,
+  );
+
+  // Overlapping hold while hold is active also fails with ConflictError
+  assert.throws(
+    () =>
+      svc.createBooking({
+        roomId: "conf_a",
+        customerId: "cust_2",
+        startMinute: 120,
+        endMinute: 180,
+        nowMinute: 29,
+        holdMinutes: 10,
+      }),
+    ConflictError,
+  );
+
+  // At exact expiry boundary (nowMinute=30), hold is expired so new booking succeeds
+  const replacement = svc.createBooking({
+    roomId: "conf_a",
+    customerId: "cust_2",
+    startMinute: 120,
+    endMinute: 180,
+    nowMinute: 30,
+  });
+  assert.equal(replacement.status, "confirmed");
+  assert.equal(replacement.expiresAt, undefined);
+});
+
+test("createBooking validates holdMinutes and nowMinute", () => {
+  const svc = setupService({ BOOKING_MAX_HOLD_MINUTES: "30" });
+
+  // Default nowMinute = 0, holdMinutes = maxHoldMinutes (boundary allowed)
