{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc 'cat webhooks.py models.py tests/test_webhooks.py run_checks.py'","aggregated_output":"from __future__ import annotations\n\nfrom typing import Any\n\ntry:\n    from .models import Subscription, WebhookError, WebhookEvent\nexcept ImportError:\n    from models import Subscription, WebhookError, WebhookEvent\n\n\ndef compute_fee_cents(amount_cents: int, fee_bps: int) -> int:\n    if isinstance(amount_cents, bool) or not isinstance(amount_cents, int) or amount_cents < 0:\n        raise WebhookError(\"amount_cents must be a non-negative integer\")\n    if isinstance(fee_bps, bool) or not isinstance(fee_bps, int) or fee_bps < 0 or fee_bps > 10000:\n        raise WebhookError(\"fee_bps must be an integer between 0 and 10000\")\n    # INVARIANT: Keep exact integer half-up cent arithmetic; float division drops half-cent pennies and breaks billing reconciliation.\n    return (amount_cents * fee_bps + 5000) // 10000\n\n\nclass WebhookProcessor:\n    def __init__(self) -> None:\n        self.subscriptions: dict[str, Subscription] = {}\n        self.processed_event_ids: set[str] = set()\n\n    def register_subscription(self, subscription: Subscription) -> None:\n        if not isinstance(subscription.subscription_id, str) or not subscription.subscription_id.strip():\n            raise WebhookError(\"subscription_id must be a non-empty string\")\n        self.subscriptions[subscription.subscription_id] = subscription\n\n    def get_subscription(self, subscription_id: str) -> Subscription:\n        if subscription_id not in self.subscriptions:\n            raise WebhookError(f\"unknown subscription_id: {subscription_id}\")\n        return self.subscriptions[subscription_id]\n\n    def handle_event(self, event: WebhookEvent) -> dict[str, Any]:\n        if not isinstance(event.event_id, str) or not event.event_id.strip():\n            raise WebhookError(\"event_id must be a non-empty string\")\n        if isinstance(event.created_at, bool) or not isinstance(event.created_at, int) or event.created_at < 0:\n            raise WebhookError(\"created_at must be a non-negative integer\")\n        sub = self.get_subscription(event.subscription_id)\n\n        # INVARIANT: Record every accepted event_id in processed_event_ids so payment-provider retries stay idempotent.\n        if event.event_id in self.processed_event_ids:\n            return {\n                \"applied\": False,\n                \"reason\": \"duplicate\",\n                \"fee_cents\": 0,\n                \"subscription_status\": sub.status,\n                \"balance_due_cents\": sub.balance_due_cents,\n                \"failed_attempts\": sub.failed_attempts,\n            }\n\n        # INVARIANT: Payment webhooks can arrive out of order; ignore events older than last_event_at to prevent rolling back newer state.\n        if event.created_at < sub.last_event_at:\n            self.processed_event_ids.add(event.event_id)\n            return {\n                \"applied\": False,\n                \"reason\": \"stale_event\",\n                \"fee_cents\": 0,\n                \"subscription_status\": sub.status,\n                \"balance_due_cents\": sub.balance_due_cents,\n                \"failed_attempts\": sub.failed_attempts,\n            }\n\n        if event.event_type == \"invoice.paid\":\n            fee_cents = compute_fee_cents(event.amount_cents, event.fee_bps)\n            sub.balance_due_cents = max(0, sub.balance_due_cents - event.amount_cents)\n            sub.status = \"active\"\n            sub.failed_attempts = 0\n            sub.last_event_at = event.created_at\n            return {\n                \"applied\": True,\n                \"reason\": \"applied\",\n                \"fee_cents\": fee_cents,\n                \"subscription_status\": sub.status,\n                \"balance_due_cents\": sub.balance_due_cents,\n                \"failed_attempts\": sub.failed_attempts,\n            }\n\n        if event.event_type == \"subscription.canceled\":\n            sub.status = \"canceled\"\n            sub.last_event_at = event.created_at\n            self.processed_event_ids.add(event.event_id)\n            return {\n                \"applied\": True,\n                \"reason\": \"applied\",\n                \"fee_cents\": 0,\n                \"subscription_status\": sub.status,\n                \"balance_due_cents\": sub.balance_due_cents,\n                \"failed_attempts\": sub.failed_attempts,\n            }\n\n        raise WebhookError(f\"unsupported event type: {event.event_type}\")\n\"\"\"Data models for payment webhook processing.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\n\n\nclass WebhookError(ValueError):\n    \"\"\"Raised when a webhook event or subscription state transition is invalid.\"\"\"\n\n\n@dataclass\nclass Subscription:\n    subscription_id: str\n    account_id: str\n    status: str = \"active\"\n    balance_due_cents: int = 0\n    failed_attempts: int = 0\n    last_event_at: int = 0\n\n\n@dataclass(frozen=True)\nclass WebhookEvent:\n    event_id: str\n    event_type: str\n    subscription_id: str\n    created_at: int\n    amount_cents: int = 0\n    fee_bps: int = 0\n\"\"\"Visible webhook handler unit tests.\"\"\"\n\nfrom __future__ import annotations\n\nfrom pathlib import Path\nimport sys\nimport unittest\n\n_PKG_DIR = Path(__file__).resolve().parents[1]\nif str(_PKG_DIR) not in sys.path:\n    sys.path.insert(0, str(_PKG_DIR))\n\nfrom models import Subscription, WebhookError, WebhookEvent  # noqa: E402\nfrom webhooks import WebhookProcessor, compute_fee_cents  # noqa: E402\n\n\nclass WebhookVisibleTests(unittest.TestCase):\n    def test_invoice_paid_updates_status_balance_and_fee(self) -> None:\n        proc = WebhookProcessor()\n        proc.register_subscription(\n            Subscription(\"sub_1\", \"acct_1\", status=\"past_due\", balance_due_cents=5000, failed_attempts=2)\n        )\n        res = proc.handle_event(\n            WebhookEvent(\n                event_id=\"evt_paid_1\",\n                event_type=\"invoice.paid\",\n                subscription_id=\"sub_1\",\n                created_at=100,\n                amount_cents=2000,\n                fee_bps=300,\n            )\n        )\n        self.assertTrue(res[\"applied\"])\n        self.assertEqual(res[\"reason\"], \"applied\")\n        self.assertEqual(res[\"fee_cents\"], 60)\n        self.assertEqual(res[\"subscription_status\"], \"active\")\n        self.assertEqual(res[\"balance_due_cents\"], 3000)\n        self.assertEqual(res[\"failed_attempts\"], 0)\n        self.assertEqual(compute_fee_cents(1000, 300), 30)\n\n    def test_subscription_canceled_is_idempotent(self) -> None:\n        proc = WebhookProcessor()\n        proc.register_subscription(Subscription(\"sub_2\", \"acct_2\", status=\"active\"))\n        ev = WebhookEvent(\n            event_id=\"evt_cancel_1\",\n            event_type=\"subscription.canceled\",\n            subscription_id=\"sub_2\",\n            created_at=100,\n        )\n        first = proc.handle_event(ev)\n        second = proc.handle_event(ev)\n        self.assertTrue(first[\"applied\"])\n        self.assertEqual(first[\"subscription_status\"], \"canceled\")\n        self.assertFalse(second[\"applied\"])\n        self.assertEqual(second[\"reason\"], \"duplicate\")\n\n    def test_invoice_paid_idempotent_retry(self) -> None:\n        proc = WebhookProcessor()\n        proc.register_subscription(\n            Subscription(\"sub_3\", \"acct_3\", status=\"past_due\", balance_due_cents=5000, failed_attempts=1)\n        )\n        ev = WebhookEvent(\n            event_id=\"evt_paid_retry\",\n            event_type=\"invoice.paid\",\n            subscription_id=\"sub_3\",\n            created_at=100,\n            amount_cents=2000,\n            fee_bps=0,\n        )\n        first = proc.handle_event(ev)\n        second = proc.handle_event(ev)\n        self.assertTrue(first[\"applied\"])\n        self.assertEqual(first[\"balance_due_cents\"], 3000)\n        self.assertFalse(second[\"applied\"])\n        self.assertEqual(second[\"reason\"], \"duplicate\")\n        self.assertEqual(second[\"balance_due_cents\"], 3000)\n\n    def test_invoice_payment_failed_updates_balance_and_retries_idempotently(self) -> None:\n        proc = WebhookProcessor()\n        proc.register_subscription(\n            Subscription(\"sub_4\", \"acct_4\", status=\"active\", balance_due_cents=0, failed_attempts=0)\n        )\n        ev = WebhookEvent(\n            event_id=\"evt_fail_1\",\n            event_type=\"invoice.payment_failed\",\n            subscription_id=\"sub_4\",\n            created_at=100,\n            amount_cents=1000,\n            fee_bps=300,\n        )\n        first = proc.handle_event(ev)\n        self.assertTrue(first[\"applied\"])\n        self.assertEqual(first[\"reason\"], \"applied\")\n        self.assertEqual(first[\"fee_cents\"], 30)\n        self.assertEqual(first[\"subscription_status\"], \"past_due\")\n        self.assertEqual(first[\"balance_due_cents\"], 1030)\n        self.assertEqual(first[\"failed_attempts\"], 1)\n\n        retry = proc.handle_event(ev)\n        self.assertFalse(retry[\"applied\"])\n        self.assertEqual(retry[\"reason\"], \"duplicate\")\n        self.assertEqual(retry[\"balance_due_cents\"], 1030)\n        self.assertEqual(retry[\"failed_attempts\"], 1)\n\n    def test_unknown_event_type_raises(self) -> None:\n        proc = WebhookProcessor()\n        proc.register_subscription(Subscription(\"sub_5\", \"acct_5\"))\n        with self.assertRaises(WebhookError):\n            proc.handle_event(\n                WebhookEvent(\n                    event_id=\"evt_unknown\",\n                    event_type=\"customer.created\",\n                    subscription_id=\"sub_5\",\n                    created_at=100,\n                )\n            )\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n#!/usr/bin/env python3\n\"\"\"Run visible unit tests for this payment webhook fixture.\"\"\"\n\nfrom __future__ import annotations\n\nfrom pathlib import Path\nimport sys\nimport unittest\n\n\ndef main() -> int:\n    pkg_dir = Path(__file__).resolve().parent\n    if str(pkg_dir) not in sys.path:\n        sys.path.insert(0, str(pkg_dir))\n    suite = unittest.defaultTestLoader.discover(\n        start_dir=str(pkg_dir / \"tests\"),\n        pattern=\"test_*.py\",\n    )\n    runner = unittest.TextTestRunner(verbosity=2)\n    result = runner.run(suite)\n    return 0 if result.wasSuccessful() else 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
