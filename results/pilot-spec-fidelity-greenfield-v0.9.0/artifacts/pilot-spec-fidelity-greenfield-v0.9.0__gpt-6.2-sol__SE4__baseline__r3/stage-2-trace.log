{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"PYTHONPATH=benchmarks/sources python3 -B - <<'PY'\nfrom collections.abc import Sequence\nfrom tracemalloc import get_traced_memory, start, stop\nfrom se4_greenfield_spec import (\n    PreferenceClause, WrittenPreference, compile_preference_rules, prepare_inference_batch\n)\n\ndef expect_error(call, message):\n    try:\n        call()\n    except ValueError as error:\n        assert str(error) == message, str(error)\n    else:\n        raise AssertionError(f\\\"expected ValueError: {message}\\\")\n\nitems = {\n    1: WrittenPreference(\\\"important\\\", \\\"User's own stated preferences\\\"),\n    2: WrittenPreference(\\\"optional\\\", \\\"Speaks French\\\"),\n}\nclauses = [\n    PreferenceClause(\\\"02\\\", \\\"languages\\\", (\\\"French\\\",), \\\"French\\\"),\n    PreferenceClause(\\\"1\\\", \\\"skin_tone\\\", (\\\"a\\\",), \\\"stated\\\"),\n    PreferenceClause(\\\"invalid\\\", \\\"height\\\", (\\\"a\\\",), \\\"stated\\\"),\n    PreferenceClause(\\\"1\\\", \\\"ethnicity\\\", (\\\"b\\\",), \\\"preferences\\\"),\n    PreferenceClause(\\\"1\\\", \\\"religion\\\", (\\\"c\\\",), \\\"preferences\\\"),\n]\ncompiled = compile_preference_rules(items, clauses)\nassert [(s.source_id, s.fields) for s in compiled.sources] == [\n    (\\\"02\\\", (\\\"languages\\\",)), (\\\"1\\\", (\\\"skin_tone\\\", \\\"ethnicity\\\", \\\"religion\\\"))\n]\nassert compile_preference_rules(items, clauses, excluded_fields=[\\\"skin_tone\\\"]).sources[1].fields == (\n    \\\"ethnicity\\\", \\\"religion\\\"\n)\nassert [s.source_id for s in compile_preference_rules(\n    items, clauses, excluded_fields={\\\"religion\\\"}, drop_whole_item=True\n).sources] == [\\\"02\\\"]\nfor excerpt in (\\\"stale\\\", None, \\\"\\\", 7):\n    stale = [*clauses, PreferenceClause(\\\"1\\\", \\\"location\\\", (), excerpt)]\n    assert [s.source_id for s in compile_preference_rules(\n        items, stale, excluded_fields={\\\"location\\\"}\n    ).sources] == [\\\"02\\\"]\nexpect_error(lambda: compile_preference_rules(items, [None]),\n             \\\"clauses must contain PreferenceClause instances\\\")\nexpect_error(lambda: compile_preference_rules({2: WrittenPreference(\\\"optional\\\", None)}, clauses),\n             \\\"referenced items must be WrittenPreference instances with string statements\\\")\nexpect_error(lambda: compile_preference_rules(items, [PreferenceClause(\\\"1\\\", [], (), \\\"stated\\\")]),\n             \\\"clause fields must be non-empty strings\\\")\n\nclass OversizedRegistry(Sequence):\n    def __len__(self):\n        return 10_000_000\n\n    def __getitem__(self, index):\n        raise AssertionError(\\\"oversized registry was traversed\\\")\n\nexpect_error(lambda: prepare_inference_batch(\\\"sample\\\", OversizedRegistry(), max_tools=500),\n             \\\"tool count exceeds max_tools\\\")\nfor name, value, message in (\n    (\\\"max_tools\\\", False, \\\"max_tools must be a non-negative integer\\\"),\n    (\\\"max_tools\\\", -1, \\\"max_tools must be a non-negative integer\\\"),\n    (\\\"max_prompt_bytes\\\", True, \\\"max_prompt_bytes must be a positive integer\\\"),\n    (\\\"max_prompt_bytes\\\", 0, \\\"max_prompt_bytes must be a positive integer\\\"),\n    (\\\"force_mode\\\", \\\"auto\\\", \\\"force_mode must be fast_tensor or chunked_prefill\\\"),\n):\n    expect_error(lambda: prepare_inference_batch(\\\"text\\\", [], **{name: value}), message)\nexpect_error(lambda: prepare_inference_batch(\\\"text\\\", [\\\"\\\\u2003\\\"]),\n             \\\"tools must be a sequence of non-blank strings\\\")\nexpect_error(lambda: prepare_inference_batch(\\\"\\\\u2003\\\", []),\n             \\\"prompt_text must contain a non-whitespace character\\\")\nexpect_error(lambda: prepare_inference_batch(\\\"sample\\\\ud800\\\", []),\n             \\\"prompt_text must be encodable as UTF-8\\\")\nfor prompt in (\\\"abc\\\", \\\"é\\\", \\\"🙂\\\", \\\"a\\\" * 65535 + \\\"é🙂\\\"):\n    encoded_size = len(prompt.encode(\\\"utf-8\\\"))\n    batch = prepare_inference_batch(\n        prompt, [], max_prompt_bytes=encoded_size, max_tools=0, force_mode=\\\"chunked_prefill\\\"\n    )\n    assert (batch.prompt_bytes, batch.tool_count, batch.execution_mode, batch.truncated) == (\n        encoded_size, 0, \\\"chunked_prefill\\\", False\n    )\n    expect_error(lambda: prepare_inference_batch(prompt, [], max_prompt_bytes=encoded_size - 1),\n                 \\\"prompt exceeds max_prompt_bytes\\\")\n\nprompt = \\\"🙂\\\" * 2_000_000\ntools = [\\\"tool\\\"] * 500\nstart()\nbatch = prepare_inference_batch(prompt, tools)\n_, peak = get_traced_memory()\nstop()\nassert (batch.prompt_bytes, batch.tool_count, batch.execution_mode, batch.truncated) == (\n    8_000_000, 500, \\\"fast_tensor\\\", False\n)\nassert peak < 1024 * 1024, peak\nprint(f\\\"Additional contract checks passed. Peak traced temporary memory: {peak:,} bytes.\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
