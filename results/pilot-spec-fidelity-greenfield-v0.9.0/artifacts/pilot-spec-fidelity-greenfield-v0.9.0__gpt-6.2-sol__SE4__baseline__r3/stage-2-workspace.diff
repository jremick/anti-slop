+def _count_utf8_bytes(text: str, limit: int | None) -> int:
+    character_count = len(text)
+    if limit is not None and character_count > limit:
+        raise ValueError("prompt exceeds max_prompt_bytes")
+    if text.isascii():
+        return character_count
+
+    # Bound temporary allocations independently of the caller's size limit.
+    chunk_size = 64 * 1024
+    byte_count = 0
+    for start in range(0, character_count, chunk_size):
+        try:
+            byte_count += len(text[start : start + chunk_size].encode("utf-8"))
+        except UnicodeEncodeError:
+            raise ValueError("prompt_text must be encodable as UTF-8") from None
+        if limit is not None and byte_count > limit:
+            raise ValueError("prompt exceeds max_prompt_bytes")
+    return byte_count
 
 
