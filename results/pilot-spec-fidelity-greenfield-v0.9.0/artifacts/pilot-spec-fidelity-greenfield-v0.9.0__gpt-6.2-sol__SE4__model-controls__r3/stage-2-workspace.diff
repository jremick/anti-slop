+_PROMPT_CHUNK_CHARS = 16_384
+
+
+def _measure_prompt_bytes(prompt_text: str, limit: int | None) -> int:
+    """Measure strict UTF-8 with bounded temporary encoding allocations."""
+    char_count = len(prompt_text)
+    if limit is not None and char_count > limit:
+        raise ValueError("prompt exceeds max_prompt_bytes")
+    if prompt_text.isascii():
+        return char_count
+
+    total = 0
+    for start in range(0, char_count, _PROMPT_CHUNK_CHARS):
+        chunk = prompt_text[start : start + _PROMPT_CHUNK_CHARS]
+        try:
+            total += len(chunk.encode("utf-8"))
+        except UnicodeEncodeError:
+            raise ValueError("prompt_text must be valid UTF-8 text") from None
+        if limit is not None and total > limit:
+            raise ValueError("prompt exceeds max_prompt_bytes")
+    return total
 
 
