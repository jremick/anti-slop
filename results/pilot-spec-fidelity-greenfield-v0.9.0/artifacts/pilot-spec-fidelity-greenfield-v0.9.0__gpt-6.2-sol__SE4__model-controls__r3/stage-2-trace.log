urces[1:]\nassert not compile_rules(items, clauses[:1], excluded_fields=excluded).sources\nfor bad_clause in (\n    clause(\\\"1\\\", \\\"religion\\\", excerpt=\\\"stale\\\"), clause(\\\"1\\\", \\\"religion\\\", excerpt=None),\n    clause(\\\"1\\\", \\\"religion\\\", excerpt=\\\"\\\"), clause(\\\"1\\\", \\\"religion\\\", excerpt=4),\n    clause(\\\"1\\\", None), clause(\\\"1\\\", \\\"\\\"), clause(\\\"1\\\", \\\"religion\\\", values=[1]),\n    clause(\\\"1\\\", \\\"religion\\\", values=(1,)),\n):\n    assert compile_rules(items, (clauses[1], bad_clause, clauses[0]), excluded_fields=excluded).sources == sources[:1].__class__((compile_rules(items, clauses[:1]).sources[0],))\nfor bad_item in (None, WrittenPreference(\\\"important\\\", 1), WrittenPreference(None, \\\"Match\\\")):\n    assert not compile_rules({1: bad_item}, clauses[1:2]).sources\nfor malformed in (None, object(), {\\\"source_id\\\": \\\"1\\\"}):\n    expect_error(compile_rules, items, [malformed])\nfor opt in (\\\"religion\\\", [\\\"\\\"], [1], iter(())):\n    expect_error(compile_rules, items, clauses, excluded_fields=opt)\nexpect_error(compile_rules, [], [])\nexpect_error(compile_rules, items, b\\\"\\\")\nexpect_error(compile_rules, items, clauses, drop_whole_item=1)\n\nclass SizedOnly(Sequence):\n    def __len__(self):\n        return 100_000_000\n    def __getitem__(self, index):\n        raise AssertionError(\\\"oversized tool list was scanned\\\")\n\nexpect_error(prepare, \\\"x\\\", SizedOnly(), max_tools=99, message=\\\"tool count exceeds max_tools\\\")\nexpect_error(prepare, \\\"x\\\", range(10**100))\nexpect_error(prepare, \\\"secret\\\\ud800text\\\", (), message=\\\"prompt_text must be valid UTF-8 text\\\")\nexpect_error(prepare, \\\"𐍈\\\" * 20_000, (), max_prompt_bytes=20_000, message=\\\"prompt exceeds max_prompt_bytes\\\")\nexpect_error(prepare, \\\"x\\\" * 20_000, (), max_prompt_bytes=19_999, message=\\\"prompt exceeds max_prompt_bytes\\\")\nassert prepare(\\\"é\\\", (), max_prompt_bytes=2