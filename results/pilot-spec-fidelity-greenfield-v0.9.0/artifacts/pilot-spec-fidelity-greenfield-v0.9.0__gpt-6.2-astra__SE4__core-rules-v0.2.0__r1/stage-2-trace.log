{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"PYTHONPATH=benchmarks/sources python3.14 -B - <<'PY'\nfrom se4_greenfield_spec import *\nfrom collections.abc import Sequence\nimport tracemalloc\ndef reject(fn,*a,**kw):\n    try: fn(*a,**kw)\n    except ValueError: return\n    raise AssertionError(\\\"missing ValueError\\\")\nr=prepare_inference_batch\ntext=\\\"🚀\\\"*2000000\ntracemalloc.start()\nresult=r(text,[\\\"ok\\\"]*501)\nassert result==PreparedBatch(8000000,501,\\\"fast_tensor\\\",False)\nassert tracemalloc.get_traced_memory()[1]<1024**2\nfor t in [\\\"x\\\",\\\"a\\\"*65535+\\\"é🚀\\\",\\\"🚀\\\"*65537]:\n    n=len(t.encode())\n    assert r(t,[],max_prompt_bytes=n,max_tools=0,force_mode=\\\"chunked_prefill\\\").prompt_bytes==n\n    reject(r,t,[],max_prompt_bytes=n-1)\nfor t in [\\\"\\\",\\\"\\\\u2003\\\",\\\"private\\\\udfff\\\"]: reject(r,t,[])\nclass Oversized(Sequence):\n    def __len__(self): return 5000\n    def __getitem__(self,i): raise AssertionError(\\\"unexpected scan\\\")\nreject(r,\\\"ok\\\",Oversized(),max_tools=4999)\nreject(r,\\\"ok\\\",range(10**30))\nm=compile_preference_rules\nitems={1:WrittenPreference(\\\"high\\\",\\\"private\\\")}\ndef c(f,e=\\\"private\\\",v=()): return PreferenceClause(\\\"1\\\",f,v,e)\ncs=[c(f) for f in (\\\"skin_tone\\\",\\\"ethnicity\\\",\\\"religion\\\")]\nassert m(items,cs).sources[0].clauses==tuple(cs)\nassert m(items,cs,excluded_fields={\\\"skin_tone\\\"}).sources[0].clauses==tuple(cs[1:])\nassert not m(items,cs,excluded_fields={\\\"skin_tone\\\"},drop_whole_item=True).sources\nassert not m(items,cs+[c(\\\"skin_tone\\\",\\\"stale\\\")],excluded_fields={\\\"skin_tone\\\"}).sources\nfor obj in [None,c([],v=()),c(\\\"height\\\",v=(3,))]: reject(m,items,[obj])\nfor obj in [None,WrittenPreference(\\\"high\\\",1),WrittenPreference(1,\\\"private\\\")]: reject(m,{1:obj},cs)\nprint(\\\"Targeted checks passed\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_pr