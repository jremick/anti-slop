+_MODES = ("fast_tensor", "chunked_prefill")
+# Encode in bounded slices so measuring a multi-megabyte prompt never allocates
+# a full second copy of it. Python str slices are whole code points, so slicing
+# cannot split a character.
+_MEASURE_CHUNK_CHARS = 1 << 20
+
+
+def _has_text(value: object) -> bool:
+    # isspace() avoids the full-copy allocation of strip(); "" is not text.
+    return isinstance(value, str) and value != "" and not value.isspace()
+
+
+def _check_limit(name: str, value: object, minimum: int) -> None:
+    if isinstance(value, bool) or not isinstance(value, int) or value < minimum:
+        raise ValueError(f"{name} must be an int >= {minimum}")
+
+
+def _utf8_len(text: str, limit: int | None) -> int:
+    """UTF-8 byte length, computed chunkwise; stops early once over ``limit``."""
+    total = 0
+    for start in range(0, len(text), _MEASURE_CHUNK_CHARS):
+        chunk = text[start : start + _MEASURE_CHUNK_CHARS]
+        try:
+            total += len(chunk.encode("utf-8"))
+        except UnicodeEncodeError:
+            raise ValueError("prompt_text is not valid UTF-8 (lone surrogate)") from None
+        if limit is not None and total > limit:
+            break
+    return total
 
 
