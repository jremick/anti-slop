 from .models import PreparedBatch
+
+_VALID_EXECUTION_MODES = frozenset({"fast_tensor", "chunked_prefill"})
+_UTF8_COUNT_CHUNK_CHARS = 65_536
+
+
+def _count_utf8_bytes(text: str, *, max_bytes: int | None) -> int:
+    """Measure UTF-8 byte length with O(1) peak scratch memory."""
+    if max_bytes is not None and len(text) > max_bytes:
+        raise ValueError(f"prompt_bytes exceeds max_prompt_bytes ({max_bytes})")
+
+    total_bytes = 0
+    for start in range(0, len(text), _UTF8_COUNT_CHUNK_CHARS):
+        chunk = text[start : start + _UTF8_COUNT_CHUNK_CHARS]
+        try:
+            total_bytes += len(chunk.encode("utf-8"))
+        except UnicodeEncodeError as exc:
+            raise ValueError("prompt_text must be valid UTF-8") from exc
+        if max_bytes is not None and total_bytes > max_bytes:
+            raise ValueError(
+                f"prompt_bytes ({total_bytes}+) exceeds max_prompt_bytes ({max_bytes})"
+            )
+    return total_bytes
 
 
