n\\\", (), excerpt)\n    assert [s.source_id for s in compile_preference_rules(items, clauses + [stale], excluded_fields=fields).sources] == [\\\"1\\\"]\nrejects(\\\"clauses must contain PreferenceClause records\\\", compile_preference_rules, items, [None])\nrejects(\\\"referenced items must be WrittenPreference records with string statements\\\", compile_preference_rules, {1: WrittenPreference(\\\"important\\\", None)}, [clauses[1]])\nrejects(\\\"item importance must be a string\\\", compile_preference_rules, {1: WrittenPreference(42, item.statement)}, [clauses[1]])\nfor field in (None, \\\"\\\", []):\n    rejects(\\\"clause fields must be non-empty strings\\\", compile_preference_rules, items, [PreferenceClause(\\\"1\\\", field, (), \\\"Greek\\\")])\n\nclass LargeRegistry(Sequence):\n    def __len__(self):\n        return 1_000_000\n    def __getitem__(self, index):\n        raise AssertionError(\\\"oversized registry must be rejected before traversal\\\")\n\nprep = prepare_inference_batch\nrejects(\\\"tool count exceeds max_tools\\\", prep, \\\"x\\\", LargeRegistry(), max_tools=50)\nrejects(\\\"prompt exceeds max_prompt_bytes\\\", prep, \\\"x\\\" * 10_000, LargeRegistry(), max_prompt_bytes=50)\nrejects(\\\"prompt exceeds max_prompt_bytes\\\", prep, \\\"é\\\", [], max_prompt_bytes=1)\nrejects(\\\"prompt_text must be valid UTF-8 text\\\", prep, \\\"x\\\" * 16_384 + \\\"\\\\ud800\\\", [])\nrejects(\\\"prompt_text must contain a non-whitespace character\\\", prep, \\\"\\\\u2003\\\", [])\nrejects(\\\"tools must be a sequence of non-blank strings\\\", prep, \\\"x\\\", [\\\"\\\\u2003\\\"])\nrejects(\\\"max_prompt_bytes must be a positive integer\\\", prep, \\\"x\\\", [], max_prompt_bytes=True)\nrejects(\\\"max_tools must be a non-negative integer\\\", prep, \\\"x\\\", [], max_tools=False)\nassert prep(\\\" x \\\", [], max_prompt_bytes=3, max_tools=0) == PreparedBatch(3, 0, \\\"fast_tensor\\\", False)\nassert prep(\\\"é🙂\\\", [\\\"tool\\\"], max_prompt_bytes=6, max_tools=1, force_mode=\\\"chunked_prefill\\\") == PreparedBatch(6, 1, \\\"chunked_prefill\\\", False)\nprompt = \\\"aé界🙂\\\" * 1_000_000\ntools = [\\\"tool\\\"] * 1_000\nstart()\ntry:\n    assert prep(prompt, tools) == PreparedBatch(10_000_000, 1_000, \\\"fast_tensor\\\", False)\n    _, peak = get_traced_memory()\n    assert peak < 250_000, peak\nfinally:\n    stop()\nprint(f\\\"Supplemental contract checks passed. Peak traced allocation for a prebuilt 10 MB UTF-8 prompt: {peak:,} bytes.\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
