ls=1, force_mode=\\\"chunked_prefill\\\") == PreparedBatch(6, 1, \\\"chunked_prefill\\\", False)\nprompt = \\\"aé界🙂\\\" * 1_000_000\ntools = [\\\"tool\\\"] * 1_000\nstart()\ntry:\n    assert prep(prompt, tools) == PreparedBatch(10_000_000, 1_000, \\\"fast_tensor\\\", False)\n    _, peak = get_traced_memory()\n    assert peak < 250_000, peak\nfinally:\n    stop()\nprint(f\\\"Supplemental contract checks passed. Peak traced allocation for a prebuilt 10 MB UTF-8 prompt: {peak:,} bytes.\\\")\nPY\"","aggregated_output":"Supplemental contract checks passed. Peak traced allocation for a prebuilt 10 MB UTF-8 prompt: 131,192 bytes.\n","exit_code":0,"status":"completed"}}
