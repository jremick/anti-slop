+_UTF8_CHUNK_CHARS = 16_384
+
+
+def _count_utf8_bytes(text: str, max_bytes: int | None) -> int:
+    if text.isascii():
+        return len(text)
+
+    byte_count = 0
+    for start in range(0, len(text), _UTF8_CHUNK_CHARS):
+        # Bound transient allocations independently of the total prompt size.
+        chunk = text[start:start + _UTF8_CHUNK_CHARS]
+        try:
+            byte_count += len(chunk.encode("utf-8"))
+        except UnicodeEncodeError:
+            raise ValueError("prompt_text must be valid UTF-8 text") from None
+        if max_bytes is not None and byte_count > max_bytes:
+            raise ValueError("prompt exceeds max_prompt_bytes")
+    return byte_count
 
 
