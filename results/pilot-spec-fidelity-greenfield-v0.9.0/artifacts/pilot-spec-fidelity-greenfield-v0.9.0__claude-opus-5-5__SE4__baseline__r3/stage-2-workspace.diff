+from .models import CompiledRules, PreferenceClause, RuleSource, WrittenPreference
+
+_BASE10_INT = re.compile(r"[+-]?[0-9]+")
+_TEXT_TYPES = (str, bytes, bytearray)
+
+
+def _parse_source_id(source_id: object) -> int | None:
+    """Parse a base-10 integer string; return None for anything else."""
+    if not isinstance(source_id, str) or not _BASE10_INT.fullmatch(source_id):
+        return None
+    try:
+        return int(source_id, 10)
+    except ValueError:
+        # Python 3.11+ caps int() string conversion (sys.int_max_str_digits);
+        # an absurdly long digit string is treated as non-numeric, not a crash.
+        return None
+
+
+def _is_excluded(clause: PreferenceClause, excluded: frozenset[str]) -> bool:
+    field = getattr(clause, "field", None)
+    return isinstance(field, str) and field in excluded
+
+
+def _excerpt_ok(clause: PreferenceClause, statement: object) -> bool:
+    excerpt = getattr(clause, "source_excerpt", None)
+    return (
+        isinstance(excerpt, str)
+        and excerpt != ""
+        and isinstance(statement, str)
+        and excerpt in statement
+    )
 
 
