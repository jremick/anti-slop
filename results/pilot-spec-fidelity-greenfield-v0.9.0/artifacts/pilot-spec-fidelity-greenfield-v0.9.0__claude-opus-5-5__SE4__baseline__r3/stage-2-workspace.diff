 from __future__ import annotations
 
-from typing import Sequence
+from collections.abc import Sequence
 
 from .models import PreparedBatch
+
+_VALID_MODES = ("fast_tensor", "chunked_prefill")
+# Encode in bounded slices so measuring a multi-megabyte prompt never allocates
+# a second full-size bytes copy (peak extra memory is ~4 * _CHUNK_CHARS bytes).
+_CHUNK_CHARS = 1 << 20
+
+
+def _is_nonblank_str(value: object) -> bool:
+    # str.isspace() avoids the full-size copy that value.strip() would allocate.
+    return isinstance(value, str) and len(value) > 0 and not value.isspace()
+
+
+def _is_int(value: object) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _utf8_len(text: str, limit: int | None) -> int:
+    """Return len(text.encode("utf-8")), computed chunk-wise.
+
+    Stops early once ``limit`` is exceeded. Raises ValueError for text that is
+    not UTF-8 encodable (e.g. lone surrogates) without echoing the content.
+    """
+    total = 0
+    for start in range(0, len(text), _CHUNK_CHARS):
+        chunk = text[start : start + _CHUNK_CHARS]
+        try:
+            total += len(chunk.encode("utf-8"))
+        except UnicodeEncodeError:
+            raise ValueError("prompt_text is not valid UTF-8 (contains lone surrogates)") from None
+        if limit is not None and total > limit:
+            break
+    # Python str slices split on code points, never mid-character, so the
+    # chunked total equals the whole-string encoding length.
+    return total
 
 
