+from .models import CompiledRules, PreferenceClause, RuleSource, WrittenPreference
+
+_INT_RE = re.compile(r"-?[0-9]+")
+
+
+def _parse_source_id(source_id: object) -> int | None:
+    """Parse a strict base-10 integer string; return None if not numeric."""
+    if isinstance(source_id, str) and _INT_RE.fullmatch(source_id):
+        try:
+            return int(source_id)
+        except ValueError:  # e.g. exceeds sys.get_int_max_str_digits()
+            return None
+    return None
+
+
+def _excerpt_ok(clause: PreferenceClause, statement: str) -> bool:
+    excerpt = clause.source_excerpt
+    return (
+        isinstance(excerpt, str)
+        and excerpt != ""
+        and isinstance(statement, str)
+        and excerpt in statement
+    )
 
 
