{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"python3 -B - <<'PY'\nfrom collections.abc import Sequence\nfrom random import Random\nimport tracemalloc\n\nfrom benchmarks.sources.se4_greenfield_spec import (\n    PreferenceClause, WrittenPreference, compile_preference_rules, prepare_inference_batch,\n)\n\ndef rejects(call, *args, **kwargs):\n    try:\n        call(*args, **kwargs)\n    except ValueError as exc:\n        return str(exc)\n    raise AssertionError(\\\"expected ValueError\\\")\n\nclass OversizedTools(Sequence):\n    def __len__(self):\n        return 1_000_000_000\n\n    def __getitem__(self, index):\n        raise AssertionError(\\\"over-limit tool sequences must not be inspected\\\")\n\nassert rejects(prepare_inference_batch, \\\"x\\\", OversizedTools(), max_tools=2) == \\\"tool count exceeds max_tools\\\"\nassert rejects(prepare_inference_batch, \\\"é\\\", [], max_prompt_bytes=1) == \\\"prompt exceeds max_prompt_bytes\\\"\nassert rejects(prepare_inference_batch, \\\"above limit\\\", [], max_prompt_bytes=1) == \\\"prompt exceeds max_prompt_bytes\\\"\nfor value in (\\\"\\\", \\\"\\\\u2003\\\", \\\"\\\\t\\\\n\\\"):\n    rejects(prepare_inference_batch, value, [])\n    rejects(prepare_inference_batch, \\\"x\\\", [value])\nassert rejects(prepare_inference_batch, \\\"private\\\\ud800\\\", []) == \\\"prompt_text must be valid UTF-8 text\\\"\nfor kwargs in ({\\\"max_tools\\\": False}, {\\\"max_tools\\\": -1}, {\\\"max_prompt_bytes\\\": True}, {\\\"max_prompt_bytes\\\": 0}, {\\\"force_mode\\\": []}):\n    rejects(prepare_inference_batch, \\\"x\\\", [], **kwargs)\n\nrng = Random(42)\nalphabet = \\\"aé語😀\\\\u2003\\\"\nfor length in (1, 10, 65_535, 65_536, 65_537, 140_000):\n    prompt = \\\"x\\\" + \\\"\\\".join(rng.choices(alphabet, k=length))\n    expected = len(prompt.encode(\\\"utf-8\\\"))\n    batch = prepare_inference_batch(prompt, [\\\"tool\\\"], max_prompt_bytes=expected, max_tools=1, force_mode=\\\"chunked_prefill\\\")\n    assert (batch.prompt_bytes, batch.tool_count, batch.execution_mode, batch.truncated) == (expected, 1, \\\"chunked_prefill\\\", False)\n    rejects(prepare_inference_batch, prompt, [\\\"tool\\\"], max_prompt_bytes=expected - 1)\n\nprompt = \\\"😀\\\" * 3_000_000\ntools = [\\\"local-tool\\\"] * 1_000\ntracemalloc.start()\nbatch = prepare_inference_batch(prompt, tools)\n_, peak = tracemalloc.get_traced_memory()\ntracemalloc.stop()\nassert (batch.prompt_bytes, batch.tool_count, batch.execution_mode, batch.truncated) == (12_000_000, 1_000, \\\"fast_tensor\\\", False)\nassert peak < 750_000, peak\n\nstatement = \\\"Tall and Buddhist\\\"\nitems = {1: WrittenPreference(\\\"optional\\\", statement), 2: WrittenPreference(\\\"important\\\", \\\"Runner\\\")}\nheight = PreferenceClause(\\\"01\\\", \\\"height\\\", (\\\"tall\\\",), statement)\nfaith = PreferenceClause(\\\"01\\\", \\\"religion\\\", (\\\"Buddhist\\\",), \\\"Buddhist\\\")\nfitness = PreferenceClause(\\\"2\\\", \\\"fitness_level\\\", (\\\"active\\\",), \\\"Runner\\\")\nclauses = [height, fitness, faith]\ncompiled = compile_preference_rules(items, clauses)\nassert [source.source_id for source in compiled.sources] == [\\\"01\\\", \\\"2\\\"]\nassert compiled.sources[0].clauses == (height, faith)\nassert compile_preference_rules(items, clauses, excluded_fields={\\\"religion\\\"}).sources[0].clauses == (height,)\nassert compile_preference_rules(items, clauses, excluded_fields={\\\"religion\\\"}, drop_whole_item=True).sources == compiled.sources[1:]\nfor malformed in (\n    PreferenceClause(\\\"01\\\", \\\"religion\\\", (), \\\"wrong\\\"),\n    PreferenceClause(\\\"01\\\", \\\"religion\\\", (), None),\n    PreferenceClause(\\\"01\\\", [], (), \\\"Buddhist\\\"),\n    PreferenceClause(\\\"01\\\", \\\"religion\\\", [1], \\\"Buddhist\\\"),\n):\n    assert compile_preference_rules(items, [height, malformed, fitness], excluded_fields={\\\"religion\\\"}).sources == compiled.sources[1:]\nassert compile_preference_rules({1: WrittenPreference(\\\"optional\\\", None)}, [height]).sources == ()\nrejects(compile_preference_rules, items, [None])\nprint(f\\\"Hardening assertions passed. Peak traced allocation for the 12 MB prompt was {peak} bytes.\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
