+        if not all(isinstance(f, str) and f for f in excluded_fields):
+            raise ValueError("excluded_fields elements must be non-empty strings")
+        excluded = frozenset(excluded_fields)
+    if not isinstance(drop_whole_item, bool):
+        raise ValueError("drop_whole_item must be a bool")
+
+    # Group by source_id, preserving first-seen order (dicts keep insertion order).
+    groups: dict[str, list[PreferenceClause]] = {}
+    for clause in clauses:
+        groups.setdefault(clause.source_id, []).append(clause)
+
+    sources: list[RuleSource] = []
+    for source_id, group in groups.items():
+        item_id = _parse_source_id(source_id)
+        if item_id is None or item_id not in items:
+            continue
+        item = items[item_id]
+
+        # Excerpt verification runs on every clause before exclusion filtering.
+        if not all(_excerpt_verified(c, item.statement) for c in group):
