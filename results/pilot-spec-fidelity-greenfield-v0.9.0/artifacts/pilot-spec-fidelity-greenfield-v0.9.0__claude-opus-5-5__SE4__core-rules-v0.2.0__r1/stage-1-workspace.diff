+from .models import CompiledRules, PreferenceClause, RuleSource, WrittenPreference
+
+_BYTES_LIKE = (str, bytes, bytearray)
+_BASE10_INT = re.compile(r"-?[0-9]+")
+
+
+def _parse_source_id(source_id: object) -> int | None:
+    """Return the integer for a strict base-10 integer string, else None."""
+    if not isinstance(source_id, str) or not _BASE10_INT.fullmatch(source_id):
+        return None
+    return int(source_id)
+
+
+def _excerpt_verified(clause: PreferenceClause, statement: object) -> bool:
+    excerpt = clause.source_excerpt
+    return (
+        isinstance(excerpt, str)
+        and excerpt != ""
+        and isinstance(statement, str)
+        and excerpt in statement
+    )
 
 
