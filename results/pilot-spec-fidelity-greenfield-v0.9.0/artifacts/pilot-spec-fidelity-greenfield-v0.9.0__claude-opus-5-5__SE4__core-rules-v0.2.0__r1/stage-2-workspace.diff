+_MODES = ("fast_tensor", "chunked_prefill")
+# Encode in bounded slices so measuring a multi-megabyte prompt never allocates
+# a full UTF-8 copy (each slice encodes to at most 4 * _CHUNK_CHARS bytes).
+_CHUNK_CHARS = 1 << 20
+
+
+def _is_nonblank_str(value: object) -> bool:
+    # isspace() avoids the full-string copy that strip() would allocate.
+    return isinstance(value, str) and value != "" and not value.isspace()
+
+
+def _utf8_len(text: str, limit: int | None) -> int:
+    """Return len(text.encode("utf-8")), stopping early once `limit` is exceeded."""
+    total = 0
+    try:
+        for start in range(0, len(text), _CHUNK_CHARS):
+            total += len(text[start : start + _CHUNK_CHARS].encode("utf-8"))
+            if limit is not None and total > limit:
+                break
+    except UnicodeEncodeError as exc:  # lone surrogates
+        raise ValueError(
+            f"prompt_text is not UTF-8 encodable (position {start + exc.start})"
+        ) from None
+    return total
+
+
+def _check_limit(name: str, value: object, minimum: int) -> None:
+    if not isinstance(value, int) or isinstance(value, bool) or value < minimum:
+        raise ValueError(f"{name} must be an int >= {minimum}")
 
 
