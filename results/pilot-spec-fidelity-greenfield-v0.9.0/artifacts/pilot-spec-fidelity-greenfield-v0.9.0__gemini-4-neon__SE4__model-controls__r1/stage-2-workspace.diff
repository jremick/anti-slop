+from collections.abc import Sequence
 
 from .models import PreparedBatch
+
+_VALID_MODES = frozenset({"fast_tensor", "chunked_prefill"})
+_UTF8_CHUNK_CHARS = 65_536
+
+
+def _measure_utf8_bytes(text: str) -> int:
+    """Measure exact UTF-8 byte length with O(1) extra memory."""
+    if text.isascii():
+        return len(text)
+    total = 0
+    for start in range(0, len(text), _UTF8_CHUNK_CHARS):
+        chunk = text[start : start + _UTF8_CHUNK_CHARS]
+        try:
+            total += len(chunk.encode("utf-8"))
+        except UnicodeEncodeError as exc:
+            raise ValueError("prompt_text contains invalid Unicode surrogates") from exc
+    return total
 
 
