+
+_BASE10_INT_RE = re.compile(r"[+-]?[0-9]+")
+
+
+def _parse_source_id(source_id: object) -> int | None:
+    """Parse a base-10 integer source_id string, returning None if invalid."""
+    if not isinstance(source_id, str) or _BASE10_INT_RE.fullmatch(source_id) is None:
+        return None
+    try:
+        return int(source_id, 10)
+    except ValueError:
+        # Guard against Python's int_max_str_digits DoS limit on oversized digit strings.
+        return None
 
 
