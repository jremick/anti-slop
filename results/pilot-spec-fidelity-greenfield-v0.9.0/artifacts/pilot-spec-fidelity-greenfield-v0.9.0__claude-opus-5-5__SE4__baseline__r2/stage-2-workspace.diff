+    """Validate and prepare a local inference batch per SPEC.md.
+
+    Size and tool-count limits are opt-in; by default both are unbounded for
+    single-user local workstation use. Nothing is ever truncated.
+    """
+    if not _has_content(prompt_text):
+        raise ValueError("prompt_text must be a str with non-whitespace content")
+    if not isinstance(tools, Sequence) or isinstance(tools, _TEXT_TYPES):
+        raise ValueError("tools must be a non-string Sequence")
+    if force_mode is not None and force_mode not in _MODES:
+        raise ValueError(f"force_mode must be None or one of {_MODES}")
+    if max_prompt_bytes is not None:
+        _check_limit(max_prompt_bytes, "max_prompt_bytes", 1)
+    if max_tools is not None:
+        _check_limit(max_tools, "max_tools", 0)
+
+    tool_count = len(tools)
+    # Cheap rejections before any O(n) work on oversized inputs.
+    if max_tools is not None and tool_count > max_tools:
+        raise ValueError(f"tool count {tool_count} exceeds max_tools={max_tools}")
+    if max_prompt_bytes is not None and len(prompt_text) > max_prompt_bytes:
+        # Every code point is at least one UTF-8 byte.
+        raise ValueError(f"prompt_text exceeds max_prompt_bytes={max_prompt_bytes}")
+
+    for index, tool in enumerate(tools):
+        if not _has_content(tool):
+            raise ValueError(f"tools[{index}] must be a str with non-whitespace content")
+
+    prompt_bytes = _utf8_length(prompt_text, max_prompt_bytes)
+    if max_prompt_bytes is not None and prompt_bytes > max_prompt_bytes:
+        raise ValueError(f"prompt_text exceeds max_prompt_bytes={max_prompt_bytes}")
+
+    execution_mode = force_mode if force_mode is not None else "fast_tensor"
+    return PreparedBatch(
+        prompt_bytes=prompt_bytes,
+        tool_count=tool_count,
+        execution_mode=execution_mode,
+        truncated=False,
+    )
