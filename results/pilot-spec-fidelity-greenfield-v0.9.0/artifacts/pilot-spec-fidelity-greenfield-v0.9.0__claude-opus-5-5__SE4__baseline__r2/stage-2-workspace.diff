+from .models import CompiledRules, PreferenceClause, RuleSource, WrittenPreference
+
+_TEXT_TYPES = (str, bytes, bytearray)
+_BASE10_INT = re.compile(r"[0-9]+")
+
+
+def _parse_source_id(source_id: str) -> int | None:
+    """Parse a base-10 integer string; return None for anything else.
+
+    On Python 3.11+, ``int()`` raises ``ValueError`` for strings longer than
+    ``sys.get_int_max_str_digits()``; such IDs are treated as unparseable
+    rather than crashing the whole compile.
+    """
+    if not _BASE10_INT.fullmatch(source_id):
+        return None
+    try:
+        return int(source_id, 10)
+    except ValueError:
+        return None
+
+
+def _clause_is_valid(clause: PreferenceClause, statement: str) -> bool:
+    """Excerpt verification plus a guard against malformed field values."""
+    excerpt = clause.source_excerpt
+    return (
+        isinstance(clause.field, str)
+        and isinstance(excerpt, str)
+        and excerpt != ""
+        and excerpt in statement
+    )
 
 
