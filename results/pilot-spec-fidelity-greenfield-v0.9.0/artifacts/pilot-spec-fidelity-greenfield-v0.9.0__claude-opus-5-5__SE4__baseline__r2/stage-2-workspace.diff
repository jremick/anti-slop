 from __future__ import annotations
 
-from typing import Sequence
+from collections.abc import Sequence
 
 from .models import PreparedBatch
+
+_TEXT_TYPES = (str, bytes, bytearray)
+_MODES = ("fast_tensor", "chunked_prefill")
+# Characters encoded per step when measuring non-ASCII prompts, so peak extra
+# memory stays bounded (~4 MiB) instead of duplicating a huge prompt in bytes.
+_ENCODE_CHUNK_CHARS = 1 << 20
+
+
+def _has_content(value: object) -> bool:
+    # isspace() avoids the full-copy allocation that strip() would make.
+    return isinstance(value, str) and bool(value) and not value.isspace()
+
+
+def _check_limit(value: object, name: str, minimum: int) -> None:
+    if not isinstance(value, int) or isinstance(value, bool) or value < minimum:
+        qualifier = "positive" if minimum > 0 else "non-negative"
+        raise ValueError(f"{name} must be a {qualifier} int")
+
+
+def _utf8_length(text: str, limit: int | None) -> int:
+    """Return the UTF-8 byte length of ``text`` without a full-size copy.
+
+    Stops early once ``limit`` is exceeded. Raises ``ValueError`` for text
+    that cannot be encoded as UTF-8 (e.g. lone surrogates).
+    """
+    if text.isascii():
+        return len(text)
+    total = 0
+    for start in range(0, len(text), _ENCODE_CHUNK_CHARS):
+        chunk = text[start : start + _ENCODE_CHUNK_CHARS]
+        try:
+            total += len(chunk.encode("utf-8"))
+        except UnicodeEncodeError as exc:
+            raise ValueError(
+                f"prompt_text is not valid UTF-8 at index {start + exc.start}"
+            ) from None
+        if limit is not None and total > limit:
+            break
+    return total
 
 
