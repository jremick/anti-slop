+        raise ValueError("clauses must be a non-string Sequence")
+    excluded: frozenset[str] | None = None
+    if excluded_fields is not None:
+        if not isinstance(excluded_fields, Collection) or isinstance(
+            excluded_fields, _TEXT_TYPES
+        ):
+            raise ValueError("excluded_fields must be a non-string Collection")
+        if not all(isinstance(f, str) and f for f in excluded_fields):
+            raise ValueError("excluded_fields elements must be non-empty strings")
+        # Snapshot: O(1) lookups and immune to caller mutation mid-compile.
+        excluded = frozenset(excluded_fields)
+    if not isinstance(drop_whole_item, bool):
+        raise ValueError("drop_whole_item must be a bool")
+
+    # Group by source_id, preserving first-seen source order and clause order.
+    groups: dict[str, list[PreferenceClause]] = {}
+    for index, clause in enumerate(clauses):
+        if not isinstance(clause, PreferenceClause):
+            raise ValueError(f"clauses[{index}] is not a PreferenceClause")
+        if not isinstance(clause.source_id, str):
+            raise ValueError(f"clauses[{index}].source_id must be a str")
+        groups.setdefault(clause.source_id, []).append(clause)
