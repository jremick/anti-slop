{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=benchmarks/sources /opt/homebrew/bin/python3.14 - <<'PY'\nfrom collections.abc import Sequence\nimport tracemalloc\nfrom se4_greenfield_spec import (\n    PreferenceClause, PreparedBatch, WrittenPreference, compile_preference_rules,\n    prepare_inference_batch,\n)\n\ndef rejects(message, function, *args, **kwargs):\n    try:\n        function(*args, **kwargs)\n    except ValueError as error:\n        assert str(error) == message, str(error)\n        return error\n    raise AssertionError('expected ValueError')\n\ncompile_rules = compile_preference_rules\nprepare = prepare_inference_batch\n\nitems = {1: WrittenPreference('high', 'declared choice'), 10: WrittenPreference('low', 'declared choice')}\nsensitive = tuple(PreferenceClause('01', field, ('choice',), 'declared') for field in\n                  ('skin_tone', 'ethnicity', 'religion'))\nother = PreferenceClause('1', 'languages', ('choice',), 'choice')\nbad_ids = [PreferenceClause(source_id, 'height', (), 'choice')\n           for source_id in (['1'], b'1', 1, '1_0', '0x1', 'missing', '11')]\nclauses = (*sensitive, other, *bad_ids)\nassert [row.fields for row in compile_rules(items, clauses).sources] == [\n    ('skin_tone', 'ethnicity', 'religion'), ('languages',)]\nassert [row.source_id for row in compile_rules(items, clauses).sources] == ['01', '1']\nassert [row.fields for row in compile_rules(items, clauses, excluded_fields=['ethnicity']).sources] == [\n    ('skin_tone', 'religion'), ('languages',)]\nassert [row.fields for row in compile_rules(\n    items, clauses, excluded_fields=['ethnicity'], drop_whole_item=True).sources] == [('languages',)]\nstale = PreferenceClause('01', 'ethnicity', ('choice',), None)\nassert [row.source_id for row in compile_rules(items, (*clauses, stale), excluded_fields=['ethnicity']).sources] == ['1']\nrejects('clauses must contain PreferenceClause instances', compile_rules, items, [object()])\nrejects('referenced items must be WrittenPreference instances with text statements', compile_rules, {1: None}, [other])\nrejects('referenced items must be WrittenPreference instances with text statements', compile_rules,\n        {1: WrittenPreference('high', 123)}, [other])\nrejects('item importance must be a string', compile_rules,\n        {1: WrittenPreference(None, 'choice')}, [other])\nrejects('clause fields must be non-empty strings', compile_rules, items,\n        [PreferenceClause('1', [], ('choice',), 'choice')])\nrejects('compiled clause values must be tuples of strings', compile_rules, items,\n        [PreferenceClause('1', 'languages', ('choice', None), 'choice')])\nassert not compile_rules(items, [PreferenceClause('1', 'languages', [], 'choice')],\n                         excluded_fields=['languages']).sources\n\nclass UnscannableTools(Sequence):\n    def __len__(self):\n        return 1_000_000\n\n    def __getitem__(self, index):\n        raise AssertionError('oversized tools should be rejected without traversal')\n\nclass MismatchedTools(Sequence):\n    def __init__(self, reported_length):\n        self.reported_length = reported_length\n\n    def __len__(self):\n        return self.reported_length\n\n    def __getitem__(self, index):\n        return ('search', 'calc')[index]\n\nrejects('tool count exceeds max_tools', prepare, 'prompt', UnscannableTools(), max_tools=3)\nrejects('tool count is too large', prepare, 'prompt', range(10**24))\nfor count in (1, 3):\n    rejects('tools length does not match its contents', prepare, 'prompt', MismatchedTools(count))\nrejects('tools must be a sequence of non-blank strings', prepare, 'prompt', ['\\\\u2003'])\nrejects('max_tools must be a non-negative integer', prepare, 'prompt', [], max_tools=False)\nrejects('max_prompt_bytes must be a positive integer', prepare, 'prompt', [], max_prompt_bytes=True)\nrejects('prompt_text must contain a non-whitespace character', prepare, '\\\\u2003', [])\nrejects('prompt exceeds max_prompt_bytes', prepare, 'a' * 200_000, [], max_prompt_bytes=100)\nrejects('prompt exceeds max_prompt_bytes', prepare, 'é🙂', [], max_prompt_bytes=5)\nsurrogate_error = rejects('prompt_text must be valid UTF-8 text', prepare, 'private\\\\ud800', [])\nassert surrogate_error.__suppress_context__\nassert prepare('é🙂', ['calc'], max_prompt_bytes=6, max_tools=1, force_mode='chunked_prefill') == PreparedBatch(\n    6, 1, 'chunked_prefill', False)\nassert prepare('x', [], max_tools=0) == PreparedBatch(1, 0, 'fast_tensor', False)\nprompt = ' ' + ('é🙂' * 2_000_000) + ' '\nregistry = ['calc'] * 10_000\nexpected_bytes = len(prompt.encode('utf-8'))\ntracemalloc.start()\nresult = prepare(prompt, registry)\n_, peak = tracemalloc.get_traced_memory()\ntracemalloc.stop()\nassert result == PreparedBatch(expected_bytes, len(registry), 'fast_tensor', False)\nassert peak < 1_000_000, f'peak temporary allocations: {peak:,} bytes'\nprint(f'Hardening assertions passed. Peak traced allocation: {peak:,} bytes for a {expected_bytes:,}-byte prompt.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
