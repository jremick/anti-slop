{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'\nimport tracemalloc\nfrom collections.abc import Sequence\nfrom benchmarks.sources.se4_greenfield_spec import (\n    PreferenceClause, PreparedBatch, WrittenPreference,\n    compile_preference_rules, prepare_inference_batch,\n)\n\ndef rejects(message, call, *args, **kwargs):\n    try:\n        call(*args, **kwargs)\n    except ValueError as exc:\n        assert str(exc) == message, str(exc)\n    else:\n        raise AssertionError(\\\"expected ValueError\\\")\n\nstatement = \\\"Brown skin, Armenian, Christian, speaks French\\\"\nitems = {1: WrittenPreference(\\\"high\\\", statement), 2: WrittenPreference(\\\"low\\\", \\\"French\\\")}\nsensitive = (\n    PreferenceClause(\\\"01\\\", \\\"skin_tone\\\", (\\\"Brown\\\",), \\\"Brown skin\\\"),\n    PreferenceClause(\\\"01\\\", \\\"ethnicity\\\", (\\\"Armenian\\\",), \\\"Armenian\\\"),\n    PreferenceClause(\\\"01\\\", \\\"religion\\\", (\\\"Christian\\\",), \\\"Christian\\\"),\n)\nlanguage = PreferenceClause(\\\"01\\\", \\\"languages\\\", (\\\"French\\\",), \\\"speaks French\\\")\nother = PreferenceClause(\\\"2\\\", \\\"languages\\\", (\\\"French\\\",), \\\"French\\\")\nunknown = PreferenceClause(\\\"01\\\", \\\"custom_field\\\", (), \\\"speaks\\\")\nclauses = [sensitive[0], other, *sensitive[1:], language, unknown]\nfirst, second = compile_preference_rules(items, clauses).sources\nassert first.source_id == \\\"01\\\" and first.clauses == (*sensitive, language, unknown)\nassert second.clauses == (other,)\nexclusions = {clause.field for clause in sensitive}\nassert compile_preference_rules(items, clauses, excluded_fields=exclusions).sources[0].clauses == (language, unknown)\nassert compile_preference_rules(items, clauses, excluded_fields=exclusions, drop_whole_item=True).sources == (second,)\nfor malformed in (\n    PreferenceClause(\\\"01\\\", \\\"ethnicity\\\", (), \\\"Absent\\\"),\n    PreferenceClause(\\\"01\\\", \\\"ethnicity\\\", (), None),\n    PreferenceClause(\\\"01\\\", [\\\"ethnicity\\\"], (), \\\"Armenian\\\"),\n    PreferenceClause(\\\"01\\\", \\\"ethnicity\\\", (None,), \\\"Armenian\\\"),\n):\n    assert compile_preference_rules(items, [language, malformed, other], excluded_fields=exclusions).sources == (second,)\nfor malformed_item in (None, WrittenPreference(\\\"high\\\", None), WrittenPreference(None, statement)):\n    assert compile_preference_rules({**items, 1: malformed_item}, clauses).sources == (second,)\nfor invalid_id in (\\\"abc\\\", \\\"1.0\\\", b\\\"01\\\", \\\"3\\\"):\n    invalid = PreferenceClause(invalid_id, \\\"languages\\\", (), \\\"French\\\")\n    assert compile_preference_rules(items, [invalid, other]).sources == (second,)\nrejects(\\\"clauses must contain only PreferenceClause instances\\\", compile_preference_rules, items, [None])\n\nclass OversizedTools(Sequence):\n    def __len__(self):\n        return 1_000_000\n    def __getitem__(self, index):\n        raise AssertionError(\\\"tool list was scanned before rejecting the size\\\")\n\nrejects(\\\"tool count exceeds max_tools\\\", prepare_inference_batch, \\\"x\\\", OversizedTools(), max_tools=100)\nrejects(\\\"prompt exceeds max_prompt_bytes\\\", prepare_inference_batch, \\\"😃\\\" * 100_000, [], max_prompt_bytes=100)\nrejects(\\\"prompt exceeds max_prompt_bytes\\\", prepare_inference_batch, \\\"é\\\", [], max_prompt_bytes=1)\nrejects(\\\"prompt_text must be valid UTF-8 text\\\", prepare_inference_batch, \\\"secret\\\\ud800\\\", [])\nrejects(\\\"prompt_text must be valid UTF-8 text\\\", prepare_inference_batch, \\\"x\\\" * 16_384 + \\\"\\\\ud800\\\", [])\nrejects(\\\"prompt_text must be a non-blank string\\\", prepare_inference_batch, \\\"\\\\u2003\\\\n\\\", [])\nrejects(\\\"tools must contain only non-blank strings\\\", prepare_inference_batch, \\\"x\\\", [\\\"\\\\u2003\\\"])\nrejects(\\\"max_prompt_bytes must be a positive integer\\\", prepare_inference_batch, \\\"x\\\", [], max_prompt_bytes=True)\nrejects(\\\"max_tools must be a non-negative integer\\\", prepare_inference_batch, \\\"x\\\", [], max_tools=False)\nassert prepare_inference_batch(\\\"é\\\", [], max_prompt_bytes=2, max_tools=0, force_mode=\\\"chunked_prefill\\\") == PreparedBatch(2, 0, \\\"chunked_prefill\\\", False)\nfor text in (\\\"ascii\\\", \\\"é\\\", \\\"€\\\", \\\"😃\\\", \\\"x\\\" * 16_383 + \\\"😃\\\\x00€\\\"):\n    assert prepare_inference_batch(text, ()).prompt_bytes == len(text.encode(\\\"utf-8\\\"))\n\nprompt = \\\"é€😃\\\" * 1_000_000\ntools = [\\\"tool\\\"] * 100_000\ntracemalloc.start()\nbatch = prepare_inference_batch(prompt, tools)\n_, peak = tracemalloc.get_traced_memory()\ntracemalloc.stop()\nassert batch == PreparedBatch(9_000_000, 100_000, \\\"fast_tensor\\\", False)\nassert peak < 512 * 1024, peak\nprint(f\\\"Hardening assertions passed. Peak traced allocation for the 9 MB prompt and 100,000 tools: {peak:,} bytes.\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
