-from typing import Sequence
+from collections.abc import Sequence
 
 from .models import PreparedBatch
+
+_VALID_EXECUTION_MODES = frozenset({"fast_tensor", "chunked_prefill"})
+_UTF8_CHUNK_CHARS = 65536
+
+
+def _measure_utf8_bytes(text: str, limit: int | None = None) -> int:
+    """Measure exact UTF-8 byte length in O(1) extra memory."""
+    if text.isascii():
+        byte_len = len(text)
+        if limit is not None and byte_len > limit:
+            raise ValueError(
+                f"prompt_bytes ({byte_len}) exceeds max_prompt_bytes ({limit})"
+            )
+        return byte_len
+
+    total = 0
+    for offset in range(0, len(text), _UTF8_CHUNK_CHARS):
+        chunk = text[offset : offset + _UTF8_CHUNK_CHARS]
+        try:
+            total += len(chunk.encode("utf-8"))
+        except UnicodeEncodeError as exc:
+            raise ValueError(
+                "prompt_text contains invalid UTF-8 surrogate code points"
+            ) from exc
+        if limit is not None and total > limit:
+            raise ValueError(
+                f"prompt_bytes ({total}+) exceeds max_prompt_bytes ({limit})"
+            )
+    return total
 
 
