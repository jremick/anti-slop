@@ -0,0 +1,89 @@
+"""Regression tests for spec defaults and malformed-input hardening."""
+
+from __future__ import annotations
+
+import unittest
+
+from se4_greenfield_spec import (
+    PreferenceClause as P,
+    WrittenPreference as W,
+    compile_preference_rules,
+    prepare_inference_batch,
+)
+
+ITEMS = {1: W("high", "tall, Catholic"), 2: W("low", "no smoking")}
+CLAUSES = [
+    P("2", "smoking", ("No",), "no smoking"),
+    P("1", "height", ("tall",), "tall"),
+    P("1", "religion", ("Catholic",), "Catholic"),
+]
+
+
+class MatcherTests(unittest.TestCase):
+    def fields(self, **kw):
+        return [s.fields for s in compile_preference_rules(ITEMS, CLAUSES, **kw).sources]
+
+    def test_no_default_exclusions(self) -> None:
+        self.assertEqual(self.fields(), [("smoking",), ("height", "religion")])
+
+    def test_opt_in_exclusion_modes(self) -> None:
+        self.assertEqual(self.fields(excluded_fields={"religion"}), [("smoking",), ("height",)])
+        self.assertEqual(
+            self.fields(excluded_fields=["religion"], drop_whole_item=True), [("smoking",)]
+        )
+
+    def test_stale_excerpt_checked_before_exclusion(self) -> None:
+        clauses = [P("1", "height", (), "tall"), P("1", "religion", (), "absent")]
+        out = compile_preference_rules(ITEMS, clauses, excluded_fields=["religion"])
+        self.assertEqual(out.sources, ())
+
+    def test_malformed_ids_and_fields_do_not_crash(self) -> None:
+        clauses = [
+            P(["1"], "height", (), "tall"),  # unhashable, non-str id
+            P("1" * 10_000, "height", (), "tall"),  # beyond int-conversion limits
+            P("abc", "height", (), "tall"),
+            P("1", ["height"], (), "tall"),  # unhashable field
+        ]
+        out = compile_preference_rules(ITEMS, clauses, excluded_fields=["height"])
+        self.assertEqual([s.source_id for s in out.sources], ["1"])
+
+    def test_wrong_element_types_raise_value_error(self) -> None:
+        for args in [(ITEMS, [object()]), ({1: "tall"}, [CLAUSES[1]])]:
+            with self.assertRaises(ValueError):
+                compile_preference_rules(*args)
+
+
+class RunnerTests(unittest.TestCase):
+    def test_large_payload_unbounded_by_default(self) -> None:
+        batch = prepare_inference_batch("é" * 3_000_000, ["t"] * 1_000)
+        self.assertEqual(
+            (batch.prompt_bytes, batch.tool_count, batch.execution_mode, batch.truncated),
+            (6_000_000, 1_000, "fast_tensor", False),
+        )
+
+    def test_bounds_and_modes(self) -> None:
+        self.assertEqual(prepare_inference_batch("é", [], max_prompt_bytes=2).prompt_bytes, 2)
+        self.assertEqual(
+            prepare_inference_batch("x", [], force_mode="chunked_prefill").execution_mode,
+            "chunked_prefill",
+        )
+        bad = [
+            dict(max_prompt_bytes=1, prompt="é"),
+            dict(max_prompt_bytes=True),
+            dict(max_prompt_bytes=0),
+            dict(max_tools=0, tools=["a"]),
+            dict(max_tools=-1),
+            dict(max_tools=False),
+            dict(force_mode="auto"),
+            dict(tools="ab"),
+            dict(tools=[" "]),
+            dict(prompt="\ud800"),  # lone surrogate: not UTF-8 encodable
+        ]
+        for kw in bad:
+            prompt, tools = kw.pop("prompt", "x"), kw.pop("tools", [])
+            with self.subTest(kw=kw, prompt=prompt, tools=tools), self.assertRaises(ValueError):
+                prepare_inference_batch(prompt, tools, **kw)
+
+
+if __name__ == "__main__":
+    unittest.main()
