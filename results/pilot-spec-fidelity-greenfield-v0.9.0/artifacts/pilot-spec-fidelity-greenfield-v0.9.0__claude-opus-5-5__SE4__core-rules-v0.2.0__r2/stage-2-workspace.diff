+_MODES = ("fast_tensor", "chunked_prefill")
+# Characters encoded per step when measuring UTF-8 size, so measurement never
+# holds a full encoded copy of a multi-megabyte prompt in memory.
+_ENCODE_CHUNK_CHARS = 1 << 20
+
+
+def _is_nonblank_str(value: object) -> bool:
+    # isspace() scans in place and stops at the first non-space character,
+    # unlike strip(), which copies the whole string.
+    return isinstance(value, str) and bool(value) and not value.isspace()
+
+
+def _is_int(value: object) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _utf8_len(text: str) -> int:
+    """Return len(text.encode("utf-8")) with bounded extra memory."""
+    total = 0
+    try:
+        for start in range(0, len(text), _ENCODE_CHUNK_CHARS):
+            total += len(text[start : start + _ENCODE_CHUNK_CHARS].encode("utf-8"))
+    except UnicodeEncodeError:
+        raise ValueError("prompt_text is not encodable as UTF-8 (lone surrogate)") from None
+    return total
 
 
