+from .models import CompiledRules, PreferenceClause, RuleSource, WrittenPreference
+
+_INT_RE = re.compile(r"[+-]?[0-9]+")
+_TEXT_TYPES = (str, bytes, bytearray)
+
+
+def _parse_source_id(source_id: object) -> int | None:
+    """Parse a strict ASCII base-10 integer string; return None if invalid."""
+    if not isinstance(source_id, str) or not _INT_RE.fullmatch(source_id):
+        return None
+    return int(source_id, 10)
+
+
+def _excerpt_ok(clause: PreferenceClause, statement: object) -> bool:
+    excerpt = clause.source_excerpt
+    return (
+        isinstance(excerpt, str)
+        and excerpt != ""
+        and isinstance(statement, str)
+        and excerpt in statement
+    )
 
 
