+_CHUNK_CHARS = 64 * 1024
+
+
+def _prompt_size(text: str, limit: int | None) -> int:
+    # Every UTF-8 code point needs at least one byte.
+    if limit is not None and len(text) > limit:
+        raise ValueError("prompt exceeds max_prompt_bytes")
+    if not text or text.isspace():
+        raise ValueError("prompt_text must contain non-whitespace text")
+    if text.isascii():
+        return len(text)
+
+    total = 0
+    for start in range(0, len(text), _CHUNK_CHARS):
+        try:
+            total += len(text[start:start + _CHUNK_CHARS].encode("utf-8"))
+        except UnicodeEncodeError:
+            raise ValueError("prompt_text must be UTF-8 encodable") from None
+        if limit is not None and total > limit:
+            raise ValueError("prompt exceeds max_prompt_bytes")
+    return total
 
 
