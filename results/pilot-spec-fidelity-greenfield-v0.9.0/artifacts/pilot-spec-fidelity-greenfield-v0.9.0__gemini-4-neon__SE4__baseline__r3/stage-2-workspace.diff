+_BASE10_INT_RE = re.compile(r"[+-]?[0-9]+")
+
+
+def _parse_base10_source_id(source_id: object) -> int | None:
+    """Parse a base-10 integer string, returning None for non-numeric or oversized inputs."""
+    if not isinstance(source_id, str) or not _BASE10_INT_RE.fullmatch(source_id):
+        return None
+    try:
+        return int(source_id, 10)
+    except ValueError:
+        return None
 
 
