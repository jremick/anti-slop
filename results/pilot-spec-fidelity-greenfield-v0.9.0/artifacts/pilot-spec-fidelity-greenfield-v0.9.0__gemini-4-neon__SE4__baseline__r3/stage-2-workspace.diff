 from .models import PreparedBatch
+
+_VALID_FORCE_MODES = frozenset({"fast_tensor", "chunked_prefill"})
+_UTF8_COUNT_CHUNK_CHARS = 1 << 20  # 1 MiB chars per chunk for bounded peak memory
+
+
+def _utf8_byte_length(text: str, *, limit: int | None = None) -> int:
+    """Measure UTF-8 byte length without doubling peak memory on large prompts."""
+    if text.isascii():
+        byte_len = len(text)
+        if limit is not None and byte_len > limit:
+            raise ValueError("prompt_bytes exceeds max_prompt_bytes")
+        return byte_len
+
+    total = 0
+    for start in range(0, len(text), _UTF8_COUNT_CHUNK_CHARS):
+        chunk = text[start : start + _UTF8_COUNT_CHUNK_CHARS]
+        try:
+            total += len(chunk.encode("utf-8"))
+        except UnicodeEncodeError as exc:
+            raise ValueError("prompt_text must be valid UTF-8") from exc
+        if limit is not None and total > limit:
+            raise ValueError("prompt_bytes exceeds max_prompt_bytes")
+    return total
 
 
