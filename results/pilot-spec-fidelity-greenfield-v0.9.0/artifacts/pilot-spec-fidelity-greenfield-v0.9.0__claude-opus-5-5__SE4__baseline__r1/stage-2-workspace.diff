 from .models import PreparedBatch
+
+_TEXT_TYPES = (str, bytes, bytearray)
+_MODES = ("fast_tensor", "chunked_prefill")
+
+
+_ENCODE_CHUNK_CHARS = 1 << 20  # bound transient memory while measuring bytes
+
+
+def _is_nonblank_str(value: object) -> bool:
+    # isspace() avoids the full copy that strip() makes on very large strings.
+    return isinstance(value, str) and value != "" and not value.isspace()
+
+
+def _utf8_len(text: str, limit: int | None) -> int:
+    """Count UTF-8 bytes in bounded chunks, stopping early once over ``limit``."""
+    total = 0
+    for start in range(0, len(text), _ENCODE_CHUNK_CHARS):
+        chunk = text[start : start + _ENCODE_CHUNK_CHARS]
+        try:
+            total += len(chunk.encode("utf-8"))
+        except UnicodeEncodeError as exc:
+            raise ValueError("prompt_text is not encodable as UTF-8") from exc
+        if limit is not None and total > limit:
+            break
+    return total
 
 
