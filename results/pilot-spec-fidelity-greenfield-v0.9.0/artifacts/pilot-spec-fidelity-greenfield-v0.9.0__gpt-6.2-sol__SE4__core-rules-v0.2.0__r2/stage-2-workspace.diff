+_PROMPT_CHUNK_CHARS = 64 * 1024
+
+
+def _count_prompt_bytes(prompt_text: str, max_prompt_bytes: int | None) -> int:
+    if prompt_text.isascii():
+        return len(prompt_text)
+
+    prompt_bytes = 0
+    # Bound temporary allocations independently of the caller's prompt limit.
+    for start in range(0, len(prompt_text), _PROMPT_CHUNK_CHARS):
+        chunk = prompt_text[start : start + _PROMPT_CHUNK_CHARS]
+        try:
+            chunk_bytes = len(chunk.encode("utf-8"))
+        except UnicodeEncodeError:
+            chunk_bytes = None
+        if chunk_bytes is None:
+            raise ValueError("prompt_text must be valid UTF-8 text")
+        prompt_bytes += chunk_bytes
+        if max_prompt_bytes is not None and prompt_bytes > max_prompt_bytes:
+            raise ValueError("prompt exceeds max_prompt_bytes")
+    return prompt_bytes
 
 
