{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=benchmarks/sources python3.14 - <<'PY'\nfrom collections.abc import Sequence\nimport tracemalloc\n\nfrom se4_greenfield_spec import (\n    PreferenceClause, PreparedBatch, WrittenPreference,\n    compile_preference_rules, prepare_inference_batch,\n)\n\ndef rejects(function, *args, message, **kwargs):\n    try:\n        function(*args, **kwargs)\n    except ValueError as error:\n        assert str(error) == message, str(error)\n        assert error.__context__ is None\n    else:\n        raise AssertionError(\\\"Expected ValueError\\\")\n\nstatement = \\\"My preferences include these attributes\\\"\nitems = {1: WrittenPreference(\\\"important\\\", statement)}\nclauses = tuple(\n    PreferenceClause(\\\"1\\\", field, (\\\"private value\\\",), statement)\n    for field in (\\\"skin_tone\\\", \\\"ethnicity\\\", \\\"religion\\\", \\\"languages\\\")\n)\nassert compile_preference_rules(items, clauses).sources[0].clauses == clauses\nexcluded = {\\\"skin_tone\\\", \\\"ethnicity\\\", \\\"religion\\\"}\nassert compile_preference_rules(items, clauses, excluded_fields=excluded).sources[0].clauses == clauses[-1:]\nassert not compile_preference_rules(items, clauses, excluded_fields=excluded, drop_whole_item=True).sources\nstale = PreferenceClause(\\\"1\\\", \\\"religion\\\", (), \\\"missing excerpt\\\")\nassert not compile_preference_rules(items, (clauses[-1], stale), excluded_fields=excluded).sources\nassert not compile_preference_rules(items, (PreferenceClause(\\\"bogus\\\", \\\"religion\\\", (), statement),)).sources\nrejects(compile_preference_rules, items, (object(),), message=\\\"clauses must contain PreferenceClause instances\\\")\nrejects(compile_preference_rules, {1: WrittenPreference(\\\"important\\\", 7)}, clauses,\n        message=\\\"referenced preferences must have string statements\\\")\nrejects(compile_preference_rules, {1: WrittenP