+_VALID_MODES = frozenset({"fast_tensor", "chunked_prefill"})
+_UTF8_MEASURE_CHUNK_CHARS = 65_536
+
+
+def _measure_utf8_bytes(text: str, max_bytes: int | None) -> int:
+    """Measure UTF-8 byte length in bounded chunks to avoid duplicating huge prompts."""
+    total = 0
+    for offset in range(0, len(text), _UTF8_MEASURE_CHUNK_CHARS):
+        chunk = text[offset : offset + _UTF8_MEASURE_CHUNK_CHARS]
+        try:
+            total += len(chunk.encode("utf-8"))
+        except UnicodeEncodeError as exc:
+            raise ValueError("prompt_text contains invalid UTF-8 surrogate code points") from exc
+        if max_bytes is not None and total > max_bytes:
+            raise ValueError(f"prompt_bytes exceeds max_prompt_bytes ({max_bytes})")
+    return total
 
 
