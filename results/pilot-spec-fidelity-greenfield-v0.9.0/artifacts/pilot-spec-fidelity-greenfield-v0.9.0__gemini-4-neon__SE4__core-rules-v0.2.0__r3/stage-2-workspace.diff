+from collections.abc import Sequence
 
 from .models import PreparedBatch
+
+_VALID_MODES = frozenset({"fast_tensor", "chunked_prefill"})
+_UTF8_MEASURE_CHUNK_CHARS = 65_536
+
+
+def _has_non_whitespace(value: object) -> bool:
+    return isinstance(value, str) and bool(value) and not value.isspace()
+
+
+def _measure_utf8_bytes(text: str, max_bytes: int | None) -> int:
+    """Measure UTF-8 byte length in bounded chunks without copying the whole prompt."""
+    total = 0
+    try:
+        for start in range(0, len(text), _UTF8_MEASURE_CHUNK_CHARS):
+            total += len(text[start : start + _UTF8_MEASURE_CHUNK_CHARS].encode("utf-8"))
+            if max_bytes is not None and total > max_bytes:
+                raise ValueError(
+                    f"prompt_bytes (>{max_bytes}) exceeds max_prompt_bytes ({max_bytes})"
+                )
+    except UnicodeEncodeError as exc:
+        raise ValueError("prompt_text contains invalid Unicode code points") from exc
+    return total
 
 
