+_BASE10_INT_RE = re.compile(r"[+-]?[0-9]+", re.ASCII)
+
+
+def _is_non_empty_str(value: object) -> bool:
+    return isinstance(value, str) and bool(value) and not value.isspace()
+
+
+def _parse_source_id(source_id: object) -> int | None:
+    if not isinstance(source_id, str):
+        return None
+    if not _BASE10_INT_RE.fullmatch(source_id):
+        return None
+    try:
+        return int(source_id, 10)
+    except ValueError:
+        return None
+
+
+def _excerpt_matches(excerpt: object, statement: object) -> bool:
+    return (
+        _is_non_empty_str(excerpt)
+        and isinstance(statement, str)
+        and excerpt in statement
+    )
 
 
