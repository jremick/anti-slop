{"type":"item.completed","item":{"id":"item_0","type":"command_execution","command":"/bin/zsh -lc 'cat benchmarks/sources/se4_greenfield_spec/{matcher.py,runner.py}'","aggregated_output":"\"\"\"User preference rule compiler. See SPEC.md for full requirements.\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections import defaultdict\nfrom collections.abc import Collection, Mapping, Sequence\n\nfrom .models import CompiledRules, PreferenceClause, RuleSource, WrittenPreference\n\n\ndef compile_preference_rules(\n    items: Mapping[int, WrittenPreference],\n    clauses: Sequence[PreferenceClause],\n    *,\n    excluded_fields: Collection[str] | None = None,\n    drop_whole_item: bool = False,\n) -> CompiledRules:\n    \"\"\"Compile validated preference rule sources per SPEC.md.\"\"\"\n    if not isinstance(items, Mapping):\n        raise ValueError(\"items must be a mapping\")\n    if not isinstance(clauses, Sequence) or isinstance(clauses, (str, bytes, bytearray)):\n        raise ValueError(\"clauses must be a sequence of preference clauses\")\n    if not isinstance(drop_whole_item, bool):\n        raise ValueError(\"drop_whole_item must be a bool\")\n\n    exclusions: set[str] = set()\n    if excluded_fields is not None:\n        if not isinstance(excluded_fields, Collection) or isinstance(\n            excluded_fields, (str, bytes, bytearray)\n        ):\n            raise ValueError(\"excluded_fields must be a collection of field names\")\n        for field in excluded_fields:\n            if not isinstance(field, str) or not field:\n                raise ValueError(\"excluded field names must be non-empty strings\")\n            exclusions.add(field)\n\n    groups: defaultdict[str, list[PreferenceClause]] = defaultdict(list)\n    for clause in clauses:\n        if isinstance(clause.source_id, str):\n            groups[clause.source_id].append(clause)\n\n    sources = []\n    for source_id, group in groups.items():\n        try:\n            item_id = int(source_id, 10)\n        except ValueError:\n            continue\n        item = items.get(item_id)\n        if item is None:\n            continue\n        if any(\n            not isinstance(c.source_excerpt, str)\n            or not c.source_excerpt\n            or c.source_excerpt not in item.statement\n            for c in group\n        ):\n            continue\n\n        kept = tuple(c for c in group if c.field not in exclusions)\n        if not kept or (drop_whole_item and len(kept) != len(group)):\n            continue\n        sources.append(RuleSource(\n            source_id=source_id,\n            importance=item.importance,\n            fields=tuple(c.field for c in kept),\n            clauses=kept,\n        ))\n\n    return CompiledRules(sources=tuple(sources))\n\"\"\"Local workstation inference request preparer. See SPEC.md for full requirements.\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections.abc import Sequence\n\nfrom .models import PreparedBatch\n\n\ndef prepare_inference_batch(\n    prompt_text: str,\n    tools: Sequence[str],\n    *,\n    max_prompt_bytes: int | None = None,\n    max_tools: int | None = None,\n    force_mode: str | None = None,\n) -> PreparedBatch:\n    \"\"\"Validate and prepare a local inference batch per SPEC.md.\"\"\"\n    if not isinstance(prompt_text, str) or not prompt_text.strip():\n        raise ValueError(\"prompt_text must contain non-whitespace text\")\n    if not isinstance(tools, Sequence) or isinstance(tools, (str, bytes, bytearray)):\n        raise ValueError(\"tools must be a sequence of tool names\")\n    if any(not isinstance(tool, str) or not tool.strip() for tool in tools):\n        raise ValueError(\"tool names must contain non-whitespace text\")\n    if force_mode not in (None, \"fast_tensor\", \"chunked_prefill\"):\n        raise ValueError(\"unsupported force_mode\")\n\n    prompt_bytes = len(prompt_text.encode(\"utf-8\"))\n    tool_count = len(tools)\n    if max_prompt_bytes is not None:\n        if (not isinstance(max_prompt_bytes, int)\n                or isinstance(max_prompt_bytes, bool) or max_prompt_bytes <= 0):\n            raise ValueError(\"max_prompt_bytes must be a positive integer\")\n        if prompt_bytes > max_prompt_bytes:\n            raise ValueError(\"prompt exceeds max_prompt_bytes\")\n    if max_tools is not None:\n        if not isinstance(max_tools, int) or isinstance(max_tools, bool) or max_tools < 0:\n            raise ValueError(\"max_tools must be a non-negative integer\")\n        if tool_count > max_tools:\n            raise ValueError(\"tool count exceeds max_tools\")\n\n    return PreparedBatch(\n        prompt_bytes=prompt_bytes,\n        tool_count=tool_count,\n        execution_mode=\"fast_tensor\" if force_mode is None else force_mode,\n        truncated=False,\n    )\n","exit_code":0,"status":"completed"}}
