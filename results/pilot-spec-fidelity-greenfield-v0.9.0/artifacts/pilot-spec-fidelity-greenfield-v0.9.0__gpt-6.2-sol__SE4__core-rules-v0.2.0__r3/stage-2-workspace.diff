+_PROMPT_CHUNK_CHARS = 64 * 1024
+
+
+def _utf8_size(text: str, byte_limit: int | None) -> int:
+    if text.isascii():
+        return len(text)
+
+    # Encode bounded slices so measuring a large prompt needs no full byte copy.
+    size = 0
+    for start in range(0, len(text), _PROMPT_CHUNK_CHARS):
+        try:
+            size += len(text[start : start + _PROMPT_CHUNK_CHARS].encode("utf-8"))
+        except UnicodeEncodeError:
+            raise ValueError("prompt_text must be encodable as UTF-8") from None
+        if byte_limit is not None and size > byte_limit:
+            raise ValueError("prompt exceeds max_prompt_bytes")
+    return size
 
 
