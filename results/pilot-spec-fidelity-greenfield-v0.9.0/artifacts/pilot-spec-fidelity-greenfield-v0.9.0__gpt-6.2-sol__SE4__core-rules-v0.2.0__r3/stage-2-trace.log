cluded_fields=(*fields, \\\"languages\\\")) == CompiledRules(())\nfor excerpt in (None, \\\"\\\", 1, \\\"Verbatim source\\\"):\n    assert compile_rules(items, (*clauses, clause(\\\"ethnicity\\\", excerpt=excerpt)), excluded_fields=fields[:3]).sources == result.sources[1:]\nfor source in ([], 2, \\\"bad-id\\\", \\\"0x02\\\", \\\"3\\\"):\n    assert compile_rules(items, (*clauses, clause(\\\"ethnicity\\\", source=source))) == result\nassert compile_rules(items, (*clauses, clause(\\\"02\\\", source=\\\"2\\\"))).sources[-1].source_id == \\\"2\\\"\nfor failure_items, failure_clauses in (\n    (items, [object()]),\n    ({2: object()}, primary),\n    ({2: WrittenPreference(\\\"important\\\", None)}, primary),\n    ({2: WrittenPreference(None, quoted)}, primary),\n    (items, [clause(None)]),\n    (items, [clause(\\\"location\\\", values=[\\\"test\\\"])]),\n    (items, [clause(\\\"location\\\", values=(42,))]),\n):\n    rejects(compile_rules, failure_items, failure_clauses)\nfor invalid in (\\\"ethnicity\\\", [\\\"\\\"], [1], iter(())):\n    rejects(compile_rules, items, clauses, excluded_fields=invalid)\nrejects(compile_rules, items, clauses, drop_whole_item=1)\n\nrng = random.Random(4)\nprompts = [\\\"abc\\\", \\\" é🚀 \\\", \\\"x\\\" * 65535 + \\\"🚀é中\\\", \\\"é\\\" * 65536 + \\\"🚀\\\", \\\"é\\\" * 200000]\nprompts += [\\\"\\\".join(rng.choices(\\\"a b\\\\né🚀中\\\\u0080\\\", k=n)) for n in (20, 999, 70001)]\nfor prompt in prompts:\n    size = len(prompt.encode(\\\"utf-8\\\"))\n    assert prepare(prompt, [\\\"search\\\"], max_prompt_bytes=size, max_tools=1) == PreparedBatch(size, 1, \\\"fast_tensor\\\", False)\n    assert prepare(prompt, (), max_tools=0, force_mode=\\\"chunked_prefill\\\") == PreparedBatch(size, 0, \\\"chunked_prefill\\\", False)\n    rejects(prepare, prompt, [], max_prompt_bytes=size - 1, message=\\\"prompt exceeds max_prompt_bytes\\\")\nfor prompt in (None, b\\\"prompt\\\", \\\"\\\", \\\"\\\\u2003\\\\n\\\"):\n    rejects(prepare, prompt, [])\nfor tools i