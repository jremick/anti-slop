{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"PYTHONPATH=benchmarks/sources/rw3_urllib3/src /opt/homebrew/bin/python3 - <<'PY'\nimport gzip, zlib\nfrom io import BytesIO\nfrom urllib3.response import HTTPResponse, HAS_ZSTD\ndef response(data, encoding):\n    return HTTPResponse(BytesIO(data), headers={'Content-Encoding':encoding}, preload_content=False)\ndef raw(data):\n    obj=zlib.compressobj(wbits=-15)\n    return obj.compress(data)+obj.flush()\nparts=[b'', b'x'*1024,b'',b'y'*1024,b'z'*523]\nmsg=b''.join(parts)\nfor encoding,packed in [('gzip',b''.join(map(gzip.compress,parts))),('deflate',raw(msg)),('deflate, gzip',gzip.compress(raw(msg)))]:\n    for n in (1,63,64,1024,4096):\n        for method in ('read','read1','stream'):\n            r=response(packed,encoding)\n            chunks=list(r.stream(n)) if method=='stream' else list(iter(lambda:getattr(r,method)(n),b''))\n            assert b''.join(chunks)==msg and all(len(chunk)<=n for chunk in chunks)\n            assert r.read()==r.read1()==b''\n    r=response(packed,encoding)\n    assert r.read(cache_content=True)==msg and r.read(cache_content=True)==b'' and r.data==msg\nprint('Supplemental stream, size, EOF and cache checks passed. HAS_ZSTD =',HAS_ZSTD)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
