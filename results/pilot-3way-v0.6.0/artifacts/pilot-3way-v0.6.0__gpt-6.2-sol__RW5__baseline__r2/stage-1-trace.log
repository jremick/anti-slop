  156\t    (r'[A-ZÀ-Ü]\\w*(?=\\s*\\.(?!\\d))', tokens.Name),  # 'Name'.\n   157\t    # FIXME(atronah): never match,\n   158\t    # because `re.match` doesn't work with look-behind regexp feature\n   159\t    (r'(?<=\\.)[A-ZÀ-Ü]\\w*', tokens.Name),  # .'Name'\n   160\t    (r'[A-ZÀ-Ü]\\w*(?=\\()', tokens.Name),  # side effect: change kw to func\n   161\t    (r'-?0x[\\dA-F]+', tokens.Number.Hexadecimal),\n   162\t    (r'-?\\d+(\\.\\d+)?E-?\\d+', tokens.Number.Float),\n   163\t    (r'(?![_A-ZÀ-Ü])-?(\\d+(\\.\\d*)|\\.\\d+)(?![_A-ZÀ-Ü])',\n   164\t     tokens.Number.Float),\n   165\t    (r'(?![_A-ZÀ-Ü])-?\\d+(?![_A-ZÀ-Ü])', tokens.Number.Integer),\nbenchmarks/sources/rw5_sqlparse/sqlparse/sql.py:72:    def __str__(self):\nbenchmarks/sources/rw5_sqlparse/sqlparse/sql.py:173:    def __str__(self):\nbenchmarks/sources/rw5_sqlparse/sqlparse/engine/statement_splitter.py:162:                yield sql.Statement(self.tokens)\nbenchmarks/sources/rw5_sqlparse/sqlparse/engine/statement_splitter.py:196:            yield sql.Statement(self.tokens)\nbenchmarks/sources/rw5_sqlparse/sqlparse/filters/others.py:170:class SerializerUnicode:\n","exit_code":0,"status":"completed"}}
