{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'nl -ba lexer.py | tail -65'","aggregated_output":"   110\t        is bypassed even if filters are defined.\n   111\t\n   112\t        Also preprocess the text, i.e. expand tabs and strip it if\n   113\t        wanted and applies registered filters.\n   114\t\n   115\t        Split ``text`` into (tokentype, text) pairs.\n   116\t\n   117\t        ``stack`` is the initial stack (default: ``['root']``)\n   118\t        \"\"\"\n   119\t        if isinstance(text, TextIOBase):\n   120\t            text = text.read()\n   121\t\n   122\t        if isinstance(text, str):\n   123\t            pass\n   124\t        elif isinstance(text, bytes):\n   125\t            if encoding:\n   126\t                text = text.decode(encoding)\n   127\t            else:\n   128\t                try:\n   129\t                    text = text.decode('utf-8')\n   130\t                except UnicodeDecodeError:\n   131\t                    text = text.decode('unicode-escape')\n   132\t        else:\n   133\t            raise TypeError(f\"Expected text or file-like object, got {type(text)!r}\")\n   134\t\n   135\t        delimited_spans = keywords.find_delimited_spans(text)\n   136\t        span_openers = delimited_spans.openers\n   137\t\n   138\t        iterable = enumerate(text)\n   139\t        for pos, char in iterable:\n   140\t            # Only positions the lexer actually reaches may open a\n   141\t            # dollar-quoted literal or a multiline comment; a delimiter\n   142\t            # inside a string literal or behind a \"--\" comment is skipped\n   143\t            # along with its surrounding token and never resolved.\n   144\t            if pos in span_openers:\n   145\t                resolved = delimited_spans.resolve(pos)\n   146\t                if resolved is not None:\n   147\t                    end, ttype = resolved\n   148\t                    yield ttype, text[pos:end