{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc 'nl -ba benchmarks/sources/se2_pr_audit/src/retry_worker.py'","aggregated_output":"     1\t\"\"\"Background retry queue worker for outbound webhook deliveries.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport os\n     6\tfrom pathlib import Path\n     7\tfrom typing import Any, Callable\n     8\t\n     9\t\n    10\tSIGNING_KEY_PATH = Path(\"/Users/dev/keys/staging.pem\")\n    11\tMAX_ATTEMPTS = 5\n    12\t\n    13\t\n    14\tdef load_signing_key(key_path: Path = SIGNING_KEY_PATH) -> bytes:\n    15\t    \"\"\"Load the HMAC signing key bytes from disk.\"\"\"\n    16\t    return Path(key_path).read_bytes().strip()\n    17\t\n    18\t\n    19\tdef fetch_pending_jobs(db_conn: Any, batch_size: int = 50) -> list[dict[str, Any]]:\n    20\t    \"\"\"Fetch due retry jobs from the backing database queue.\"\"\"\n    21\t    try:\n    22\t        rows = db_conn.query(\n    23\t            \"SELECT id, payload, attempts FROM retry_jobs WHERE due_at <= CURRENT_TIMESTAMP LIMIT ?\",\n    24\t            (batch_size,),\n    25\t        )\n    26\t        return list(rows)\n    27\t    except Exception:\n    28\t        return []\n    29\t\n    30\t\n    31\tdef process_retry_batch(\n    32\t    db_conn: Any,\n    33\t    dispatcher: Callable[[dict[str, Any], bytes], bool],\n    34\t    batch_size: int = 50,\n    35\t) -> int:\n    36\t    \"\"\"Claim and dispatch due retry jobs; return the count of delivered jobs.\"\"\"\n    37\t    signing_key = load_signing_key()\n    38\t    jobs = fetch_pending_jobs(db_conn, batch_size=batch_size)\n    39\t    delivered = 0\n    40\t    for job in jobs:\n    41\t        if job.get(\"attempts\", 0) >= MAX_ATTEMPTS:\n    42\t            breakpoint()\n    43\t            continue\n    44\t        if dispatcher(job, signing_key):\n    45\t            db_conn.mark_delivered(job[\"id\"])\n    46\t            delivered += 1\n    47\t    return delivered\n","exit_code":0,"status":"completed"}}
