+def validate_promo_code(code: object) -> str:
+    """Return ``code`` if it is exactly one well-formed promo code, else raise.
+
+    Multi-code strings such as ``"A,B"`` or ``"A B"`` are rejected explicitly:
+    stacking is not supported and must never degrade to a silent partial match.
+    """
+    if not isinstance(code, str) or not code:
+        raise ValidationError("promo_code must be a non-empty string")
+    if _PROMO_SEPARATOR_RE.search(code):
+        raise ValidationError(f"only one promo code may be applied: {code!r}")
+    if not _PROMO_CODE_RE.fullmatch(code):
+        raise ValidationError(f"malformed promo code: {code!r}")
+    return code
+
+
+def parse_iso_date(value: object, field_name: str) -> date:
+    """Parse a strict ``YYYY-MM-DD`` string."""
+    if not isinstance(value, str) or not _ISO_DATE_RE.fullmatch(value):
+        raise ValidationError(f"{field_name} must be a YYYY-MM-DD string")
+    try:
+        return date.fromisoformat(value)
+    except ValueError as exc:
+        raise ValidationError(f"{field_name} is not a valid date: {value!r}") from exc
+
+
+def build_promo(
+    code: object,
