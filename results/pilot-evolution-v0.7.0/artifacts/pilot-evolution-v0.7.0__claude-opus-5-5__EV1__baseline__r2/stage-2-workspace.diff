+def compute_discount_cents(gross_subtotal_cents: int, promo: Promo, as_of: Optional[str]) -> int:
+    """Discount for ``promo`` against a pre-tax subtotal, clamped to the subtotal.
+
+    Raises (never returns 0 as a fallback) when the promo is not applicable.
+    """
+    validate_non_negative_int(gross_subtotal_cents, "subtotal_cents")
+    if promo.expires_on is not None:
+        if as_of is None:
+            raise ValidationError(f"as_of is required to apply expiring promo {promo.code}")
+        if parse_iso_date(as_of, "as_of") > parse_iso_date(promo.expires_on, "expires_on"):
+            raise ValidationError(f"promo {promo.code} expired on {promo.expires_on}")
+    if gross_subtotal_cents < promo.min_subtotal_cents:
+        raise ValidationError(
+            f"subtotal {gross_subtotal_cents} is below promo {promo.code} minimum {promo.min_subtotal_cents}"
+        )
+    if promo.percent_off is not None:
+        discount = round_half_up_div(gross_subtotal_cents * promo.percent_off, 100)
+    else:
