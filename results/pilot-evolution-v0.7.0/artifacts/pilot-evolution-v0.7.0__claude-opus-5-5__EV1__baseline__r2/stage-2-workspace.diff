+        # 10000 - 25% = 7500 ; tax 7500 * 825 / 10000 = 618.75 -> 619
+        p = price_charge(10000, tax_bps=825, promo=Promo(code="Q", percent_off=25))
+        self.assertEqual((p.gross_subtotal_cents, p.discount_cents, p.subtotal_cents), (10000, 2500, 7500))
+        self.assertEqual((p.tax_cents, p.total_cents), (619, 8119))
