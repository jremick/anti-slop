+    def test_percent_discount_rounds_half_up(self) -> None:
+        # 15% of 1010 = 151.5 -> 152 ; 15% of 1009 = 151.35 -> 151
+        promo = Promo(code="P15", percent_off=15)
+        self.assertEqual(price_charge(1010, tax_bps=0, promo=promo).discount_cents, 152)
+        self.assertEqual(price_charge(1009, tax_bps=0, promo=promo).discount_cents, 151)
