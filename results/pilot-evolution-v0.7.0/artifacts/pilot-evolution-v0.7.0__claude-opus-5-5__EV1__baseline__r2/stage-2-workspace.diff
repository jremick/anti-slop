+    def test_no_promo_is_plain_tax(self) -> None:
+        p = price_charge(3998, tax_bps=825)
+        self.assertEqual((p.discount_cents, p.subtotal_cents, p.tax_cents, p.total_cents), (0, 3998, 330, 4328))
+        self.assertIsNone(p.promo_code)
