+def compute_upgrade_proration_cents(
+    old_monthly_cents: int,
+    new_monthly_cents: int,
+    days_remaining: int,
+    cycle_days: int,
+) -> int:
+    """Prorated charge for moving to a more expensive plan mid-cycle.
+
+    Returns round_half_up_div((new - old) * days_remaining, cycle_days) in exact
+    integer cents. Rejects non-upgrades and out-of-range cycle bounds.
+    """
+    validate_non_negative_int(old_monthly_cents, "old_monthly_cents")
+    validate_non_negative_int(new_monthly_cents, "new_monthly_cents")
+    validate_positive_int(cycle_days, "cycle_days")
+    validate_non_negative_int(days_remaining, "days_remaining")
+    if days_remaining > cycle_days:
+        raise ValidationError("days_remaining cannot exceed cycle_days")
+    if new_monthly_cents <= old_monthly_cents:
+        raise ValidationError("new plan must cost more than the current plan")
+    return round_half_up_div((new_monthly_cents - old_monthly_cents) * days_remaining, cycle_days)
+
+
+def calculate_upgrade_totals(
+    old_monthly_cents: int,
+    new_monthly_cents: int,
+    days_remaining: int,
+    cycle_days: int,
+    *,
+    tax_bps: int,
+) -> Tuple[int, int, int]:
+    """Return (subtotal_cents, tax_cents, total_cents) for a prorated upgrade."""
+    subtotal = compute_upgrade_proration_cents(
+        old_monthly_cents, new_monthly_cents, days_remaining, cycle_days
+    )
+    tax = compute_tax_cents(subtotal, tax_bps)
+    return subtotal, tax, subtotal + tax
