+    def upgrade_subscription(
+        self,
+        subscription_id: str,
+        new_plan_id: str,
+        days_remaining: int,
+        cycle_days: int,
+        *,
+        idempotency_key: str,
+    ) -> LedgerEntry:
+        """Move a subscription to a pricier plan, charging the prorated difference.
+
+        Replaying the same ``idempotency_key`` with identical arguments returns the
+        original entry without side effects; reusing it with different arguments
+        raises ValidationError.
+        """
+        for value, name in ((subscription_id, "subscription_id"), (new_plan_id, "new_plan_id")):
+            if not isinstance(value, str):
+                raise ValidationError(f"{name} must be a string")
+        if not isinstance(idempotency_key, str) or not idempotency_key.strip():
+            raise ValidationError("idempotency_key must be a non-empty string")
+        for value, name in ((days_remaining, "days_remaining"), (cycle_days, "cycle_days")):
+            if isinstance(value, bool) or not isinstance(value, int):
+                raise ValidationError(f"{name} must be an integer")
+
+        # Check idempotency before business rules: after a successful upgrade the
+        # subscription is already on new_plan_id, so a replay would otherwise be
+        # rejected as a non-upgrade.
+        fingerprint = ("plan_upgrade", subscription_id, new_plan_id, days_remaining, cycle_days)
+        existing = self.ledger.lookup_idempotent_entry(idempotency_key, fingerprint)
+        if existing is not None:
+            return existing
+
+        sub = self.ledger.get_subscription(subscription_id)
+        old_plan = self.ledger.get_plan(sub.plan_id)
+        new_plan = self.ledger.get_plan(new_plan_id)
+        subtotal, tax, total = calculate_upgrade_totals(
+            old_plan.monthly_cents,
+            new_plan.monthly_cents,
+            days_remaining,
+            cycle_days,
+            tax_bps=new_plan.tax_bps,
+        )
+
+        entry = LedgerEntry(
+            entry_id=self.ledger.next_id("ent"),
+            account_id=sub.account_id,
+            kind="plan_upgrade",
+            subtotal_cents=subtotal,
+            tax_cents=tax,
+            total_cents=total,
+            reference_id=subscription_id,
+            metadata={
+                "old_plan_id": old_plan.plan_id,
+                "new_plan_id": new_plan.plan_id,
+                "days_remaining": days_remaining,
+                "cycle_days": cycle_days,
+                "idempotency_key": idempotency_key,
+            },
+        )
+        # All validation is done; mutate state only now so failures leave no trace.
+        self.ledger.record_idempotent_entry(idempotency_key, fingerprint, entry)
+        sub.plan_id = new_plan.plan_id
+        return entry
