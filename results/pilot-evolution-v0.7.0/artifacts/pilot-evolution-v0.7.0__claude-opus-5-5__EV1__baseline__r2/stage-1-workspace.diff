+    def lookup_idempotent_entry(self, idempotency_key: str, fingerprint: Hashable) -> Optional[LedgerEntry]:
+        """Return the entry previously recorded under ``idempotency_key``.
+
+        Returns None if the key is unused. Raises ValidationError if the key was
+        used for a request with a different fingerprint.
+        """
+        stored = self._idempotency.get(idempotency_key)
+        if stored is None:
+            return None
+        stored_fingerprint, entry_id = stored
+        if stored_fingerprint != fingerprint:
+            raise ValidationError(
+                f"idempotency_key {idempotency_key!r} was already used with different arguments"
+            )
+        return self._entries[entry_id]
+
+    def record_idempotent_entry(self, idempotency_key: str, fingerprint: Hashable, entry: LedgerEntry) -> None:
+        """Record ``entry`` and bind it to ``idempotency_key`` in one step."""
+        if idempotency_key in self._idempotency:
+            raise ValidationError(f"idempotency_key {idempotency_key!r} already recorded")
+        self.record_entry(entry)
+        self._idempotency[idempotency_key] = (fingerprint, entry.entry_id)

