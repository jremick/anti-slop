+"""Turn 1: mid-cycle prorated plan upgrades with idempotency."""
+
+from __future__ import annotations
+
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LedgerEntry, Plan, ValidationError
+from ev1_order_ledger.pricing import (
+    calculate_upgrade_totals,
+    compute_upgrade_proration_cents,
+    round_half_up_div,
+)
+
+
+class ProrationPricingTests(unittest.TestCase):
+    def test_exact_division(self) -> None:
+        # (3000 - 1000) * 15 / 30 = 1000 exactly
+        self.assertEqual(compute_upgrade_proration_cents(1000, 3000, 15, 30), 1000)
+
+    def test_half_rounds_up(self) -> None:
+        # 1 * 1 / 2 = 0.5 -> 1 ; 3 * 1 / 2 = 1.5 -> 2 ; 5 * 1 / 2 = 2.5 -> 3
+        self.assertEqual(compute_upgrade_proration_cents(0, 1, 1, 2), 1)
+        self.assertEqual(compute_upgrade_proration_cents(0, 3, 1, 2), 2)
+        self.assertEqual(compute_upgrade_proration_cents(0, 5, 1, 2), 3)
+
+    def test_below_half_rounds_down_and_above_half_rounds_up(self) -> None:
+        # 1000 * 1 / 3 = 333.33 -> 333 ; 1000 * 2 / 3 = 666.67 -> 667
+        self.assertEqual(compute_upgrade_proration_cents(1000, 2000, 1, 3), 333)
+        self.assertEqual(compute_upgrade_proration_cents(1000, 2000, 2, 3), 667)
+
+    def test_not_bankers_rounding(self) -> None:
+        # 2.5 -> 3 (banker's would give 2); Python round() would also give 2.
+        self.assertEqual(compute_upgrade_proration_cents(0, 5, 1, 2), 3)
+        self.assertNotEqual(round(5 / 2), compute_upgrade_proration_cents(0, 5, 1, 2))
+
+    def test_endpoints(self) -> None:
+        self.assertEqual(compute_upgrade_proration_cents(1000, 3000, 0, 30), 0)
+        self.assertEqual(compute_upgrade_proration_cents(1000, 3000, 30, 30), 2000)
+
+    def test_matches_canonical_formula_exhaustively(self) -> None:
+        for old, new in ((0, 1), (999, 1000), (1000, 2999), (1234, 98765)):
+            for cycle in (1, 7, 28, 30, 31):
+                for days in range(cycle + 1):
+                    expected = round_half_up_div((new - old) * days, cycle)
+                    # Independent check: floor(x + 1/2) computed with exact ints.
+                    num = (new - old) * days
+                    q, r = divmod(num, cycle)
+                    independent = q + (1 if 2 * r >= cycle else 0)
+                    self.assertEqual(expected, independent)
+                    self.assertEqual(compute_upgrade_proration_cents(old, new, days, cycle), expected)
+
+    def test_large_values_stay_exact(self) -> None:
+        # Exceeds float precision; integer path must be exact.
+        old, new = 0, 10**17 + 1
+        self.assertEqual(compute_upgrade_proration_cents(old, new, 1, 2), (10**17 + 2) // 2)
+
+    def test_totals_apply_tax_half_up_on_prorated_subtotal(self) -> None:
+        # subtotal 667; tax 667 * 825 / 10000 = 55.0275 -> 55
+        self.assertEqual(calculate_upgrade_totals(1000, 2000, 2, 3, tax_bps=825), (667, 55, 722))
+        # subtotal 1000; tax 1000 * 5 / 10000 = 0.5 -> 1
+        self.assertEqual(calculate_upgrade_totals(0, 1000, 1, 1, tax_bps=5), (1000, 1, 1001))
+
+    def test_pricing_rejects_invalid_inputs(self) -> None:
+        bad = [
+            (1000, 1000, 1, 30),   # same price
+            (2000, 1000, 1, 30),   # downgrade
+            (1000, 2000, -1, 30),  # negative days
+            (1000, 2000, 31, 30),  # days > cycle
+            (1000, 2000, 0, 0),    # zero cycle
+            (1000, 2000, 1, -30),  # negative cycle
+            (1000, 2000, True, 30),
+            (1000, 2000, 1, True),
+            (1000, 2000, 1.0, 30),
+        ]
+        for args in bad:
+            with self.subTest(args=args), self.assertRaises(ValidationError):
+                compute_upgrade_proration_cents(*args)
+
+
+class UpgradeSubscriptionTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="biz", name="Biz", monthly_cents=4999, tax_bps=1000))
+        self.svc.register_plan(Plan(plan_id="cheap", name="Cheap", monthly_cents=500))
+        self.svc.register_plan(Plan(plan_id="starter_twin", name="Twin", monthly_cents=1000))
+        self.sub = self.svc.start_subscription("acct_1", "starter")
+        self.sid = self.sub.subscription_id
+
+    def _entries(self):
+        return self.svc.ledger.entries_for_account("acct_1")
+
+    def _assert_no_side_effects(self, fn) -> None:
+        before_entries = list(self._entries())
+        before_plan = self.svc.ledger.get_subscription(self.sid).plan_id
+        before_seq = self.svc.ledger._seq
+        with self.assertRaises(ValidationError):
+            fn()
+        self.assertEqual(self._entries(), before_entries)
+        self.assertEqual(self.svc.ledger.get_subscription(self.sid).plan_id, before_plan)
+        self.assertEqual(self.svc.ledger._seq, before_seq)
+
+    # -- happy path --------------------------------------------------------
+
+    def test_upgrade_records_entry_and_switches_plan(self) -> None:
+        # (3000 - 1000) * 10 / 30 = 666.67 -> 667 ; tax 667 * 825 / 10000 = 55.03 -> 55
+        entry = self.svc.upgrade_subscription(self.sid, "pro", 10, 30, idempotency_key="k1")
+        self.assertIsInstance(entry, LedgerEntry)
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.sid)
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (667, 55, 722))
+        self.assertEqual(self.svc.ledger.get_subscription(self.sid).plan_id, "pro")
+        self.assertIs(self.svc.ledger.get_entry(entry.entry_id), entry)
+        self.assertEqual(self._entries(), [entry])
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 722)
+
+    def test_tax_uses_new_plan_rate(self) -> None:
+        # (4999 - 1000) * 15 / 30 = 1999.5 -> 2000 ; tax at new plan 1000 bps = 200
+        entry = self.svc.upgrade_subscription(self.sid, "biz", 15, 30, idempotency_key="k1")
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (2000, 200, 2200))
+
+    def test_half_cent_boundary_rounds_up_through_service(self) -> None:
+        # (4999 - 1000) * 1 / 2 = 1999.5 -> 2000
+        entry = self.svc.upgrade_subscription(self.sid, "biz", 1, 2, idempotency_key="k1")
+        self.assertEqual(entry.subtotal_cents, 2000)
+
+    def test_zero_days_remaining_is_valid_and_free(self) -> None:
+        entry = self.svc.upgrade_subscription(self.sid, "pro", 0, 30, idempotency_key="k1")
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (0, 0, 0))
+        self.assertEqual(self.svc.ledger.get_subscription(self.sid).plan_id, "pro")
+
+    def test_full_cycle_charges_full_difference(self) -> None:
+        entry = self.svc.upgrade_subscription(self.sid, "pro", 30, 30, idempotency_key="k1")
+        self.assertEqual(entry.subtotal_cents, 2000)
+
+    def test_chained_upgrades_use_current_plan_as_old(self) -> None:
+        self.svc.upgrade_subscription(self.sid, "pro", 30, 30, idempotency_key="k1")
+        # Now on pro (3000); biz 4999 -> diff 1999 * 30/30
+        entry = self.svc.upgrade_subscription(self.sid, "biz", 30, 30, idempotency_key="k2")
+        self.assertEqual(entry.subtotal_cents, 1999)
+        self.assertEqual(len(self._entries()), 2)
+
+    # -- validation --------------------------------------------------------
+
+    def test_unknown_ids_rejected(self) -> None:
+        self._assert_no_side_effects(
+            lambda: self.svc.upgrade_subscription("sub_nope", "pro", 1, 30, idempotency_key="k1"))
+        self._assert_no_side_effects(
+            lambda: self.svc.upgrade_subscription(self.sid, "nope", 1, 30, idempotency_key="k1"))
+
+    def test_non_upgrades_rejected(self) -> None:
+        for plan_id in ("starter", "starter_twin", "cheap"):
+            with self.subTest(plan_id=plan_id):
+                self._assert_no_side_effects(
+                    lambda: self.svc.upgrade_subscription(self.sid, plan_id, 1, 30, idempotency_key="k1"))
+
+    def test_bounds_rejected(self) -> None:
+        for days, cycle in ((1, 0), (0, 0), (1, -30), (-1, 30), (31, 30), (2, 1)):
+            with self.subTest(days=days, cycle=cycle):
+                self._assert_no_side_effects(
+                    lambda: self.svc.upgrade_subscription(self.sid, "pro", days, cycle, idempotency_key="k1"))
+
+    def test_booleans_and_non_ints_rejected(self) -> None:
