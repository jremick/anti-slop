+            raise ValidationError(f"as_of is required to apply expiring promo {promo.code}")
+        if parse_iso_date(as_of, "as_of") > parse_iso_date(promo.expires_on, "expires_on"):
+            raise ValidationError(f"promo {promo.code} expired on {promo.expires_on}")
