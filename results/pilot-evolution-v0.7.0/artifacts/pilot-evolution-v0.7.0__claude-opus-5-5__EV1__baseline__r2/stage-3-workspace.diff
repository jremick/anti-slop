+def compute_discount_cents(gross_subtotal_cents: int, promo: Promo, as_of: Optional[str]) -> int:
+    """Discount for ``promo`` against a pre-tax subtotal, clamped to the subtotal.
+
+    Raises (never returns 0 as a fallback) when the promo is not applicable.
+    """
+    validate_non_negative_int(gross_subtotal_cents, "subtotal_cents")
