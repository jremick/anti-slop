+    # -- idempotency -------------------------------------------------------
+
+    def test_replay_returns_original_entry_without_duplicate(self) -> None:
+        first = self.svc.upgrade_subscription(self.sid, "pro", 10, 30, idempotency_key="k1")
+        seq_after_first = self.svc.ledger._seq
+        # Subscription is now on "pro", so a naive replay would be a non-upgrade.
+        second = self.svc.upgrade_subscription(self.sid, "pro", 10, 30, idempotency_key="k1")
+        third = self.svc.upgrade_subscription(self.sid, "pro", 10, 30, idempotency_key="k1")
+        self.assertIs(second, first)
+        self.assertIs(third, first)
+        self.assertEqual(self._entries(), [first])
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 722)
+        self.assertEqual(self.svc.ledger._seq, seq_after_first)
+
+    def test_replay_after_later_upgrade_still_returns_original(self) -> None:
+        first = self.svc.upgrade_subscription(self.sid, "pro", 10, 30, idempotency_key="k1")
+        self.svc.upgrade_subscription(self.sid, "biz", 10, 30, idempotency_key="k2")
+        replay = self.svc.upgrade_subscription(self.sid, "pro", 10, 30, idempotency_key="k1")
+        self.assertIs(replay, first)
+        self.assertEqual(self.svc.ledger.get_subscription(self.sid).plan_id, "biz")
+        self.assertEqual(len(self._entries()), 2)
+
+    def test_key_reuse_with_different_arguments_conflicts(self) -> None:
+        self.svc.register_plan(Plan(plan_id="pro2", name="Pro2", monthly_cents=3000))
+        other = self.svc.start_subscription("acct_1", "starter")
+        first = self.svc.upgrade_subscription(self.sid, "pro", 10, 30, idempotency_key="k1")
+        variants = [
+            (other.subscription_id, "pro", 10, 30),
+            (self.sid, "biz", 10, 30),
+            (self.sid, "pro2", 10, 30),
+            (self.sid, "pro", 11, 30),
+            (self.sid, "pro", 10, 31),
+        ]
+        for args in variants:
+            with self.subTest(args=args):
+                self._assert_no_side_effects(
+                    lambda: self.svc.upgrade_subscription(*args, idempotency_key="k1"))
+        self.assertEqual(self.svc.ledger.get_subscription(other.subscription_id).plan_id, "starter")
+        self.assertIs(self.svc.upgrade_subscription(self.sid, "pro", 10, 30, idempotency_key="k1"), first)
+
+    def test_distinct_keys_are_independent(self) -> None:
+        other = self.svc.start_subscription("acct_2", "starter")
+        a = self.svc.upgrade_subscription(self.sid, "pro", 10, 30, idempotency_key="k1")
+        b = self.svc.upgrade_subscription(other.subscription_id, "pro", 10, 30, idempotency_key="k2")
+        self.assertNotEqual(a.entry_id, b.entry_id)
+        self.assertEqual(b.account_id, "acct_2")
+        self.assertEqual(b.reference_id, other.subscription_id)
