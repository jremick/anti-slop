+"""Turn 3: partial refunds with exact penny conservation, and credit notes."""
+
+from __future__ import annotations
+
+import random
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, ValidationError
+from ev1_order_ledger.pricing import compute_refund_split
+
+
+def _items(unit_cents: int, quantity: int = 1):
+    return [LineItem(sku="seat", unit_cents=unit_cents, quantity=quantity)]
+
+
+class RefundSplitTests(unittest.TestCase):
+    """The pure cumulative-split helper."""
+
+    def _run_chunks(self, subtotal: int, tax: int, chunks):
+        total = subtotal + tax
+        refunded = sub_sum = tax_sum = 0
+        for amount in chunks:
+            rs, rt = compute_refund_split(subtotal, tax, total, refunded, amount)
+            self.assertEqual(rs + rt, amount)
+            self.assertGreaterEqual(rs, 0)
+            self.assertGreaterEqual(rt, 0)
+            refunded += amount
+            sub_sum += rs
+            tax_sum += rt
+            self.assertLessEqual(tax_sum, tax)
+            self.assertLessEqual(sub_sum, subtotal)
+        return sub_sum, tax_sum
+
+    def test_worked_three_chunk_example(self) -> None:
+        # Order: 1999 + tax 165 = 2164.
+        # cum tax @1000 = 165*1000/2164 = 76.247 -> 76   => refund tax 76
+        # cum tax @2000 = 165*2000/2164 = 152.495 -> 152 => refund tax 76
+        # cum tax @2164 = 165                            => refund tax 13
+        self.assertEqual(compute_refund_split(1999, 165, 2164, 0, 1000), (924, 76))
+        self.assertEqual(compute_refund_split(1999, 165, 2164, 1000, 1000), (924, 76))
+        self.assertEqual(compute_refund_split(1999, 165, 2164, 2000, 164), (151, 13))
+
+    def test_penny_by_penny_refund_reverses_all_tax(self) -> None:
+        # Naive per-refund rounding would give round(8/107) = 0 tax every time,
+        # reversing 0 of 8 cents of tax. Cumulative rounding must get exactly 8.
+        self.assertEqual(self._run_chunks(99, 8, [1] * 107), (99, 8))
+
+    def test_random_chunkings_conserve_pennies(self) -> None:
+        rng = random.Random(20261127)
+        for _ in range(300):
+            subtotal = rng.randint(0, 50_000)
+            tax = rng.randint(0, subtotal)  # tax_bps <= 10000
+            total = subtotal + tax
+            if total == 0:
+                continue
+            remaining, chunks = total, []
+            while remaining:
+                c = rng.randint(1, max(1, min(remaining, rng.choice([1, 7, 100, remaining]))))
+                chunks.append(c)
+                remaining -= c
+            with self.subTest(subtotal=subtotal, tax=tax, n=len(chunks)):
+                self.assertEqual(self._run_chunks(subtotal, tax, chunks), (subtotal, tax))
+
+    def test_exhaustive_two_chunk_splits_small_order(self) -> None:
+        subtotal, tax = 37, 3
+        for first in range(1, 40):
+            with self.subTest(first=first):
+                self.assertEqual(self._run_chunks(subtotal, tax, [first, 40 - first]), (subtotal, tax))
+
+    def test_all_tax_order(self) -> None:
+        # Degenerate: 100% tax (tax_bps=10000) on a 1-cent subtotal.
+        self.assertEqual(self._run_chunks(1, 1, [1, 1]), (1, 1))
+
+    def test_invalid_inputs(self) -> None:
+        bad = [
+            (1999, 165, 2164, 0, 2165),     # over-refund in one go
+            (1999, 165, 2164, 2000, 165),   # over-refund cumulatively
+            (1999, 165, 2164, 2164, 1),     # already fully refunded
+            (1999, 165, 2164, 0, 0),        # zero amount
+            (1999, 165, 2164, 0, -1),
