+def compute_refund_split(
+    order_subtotal_cents: int,
+    order_tax_cents: int,
+    already_refunded_cents: int,
+    amount_cents: int,
+) -> Tuple[int, int]:
+    """Return (refund_subtotal_cents, refund_tax_cents) for one partial refund.
+
+    Tax is reversed cumulatively: the tax refunded so far is always
+    round_half_up(order_tax * refunded_so_far / order_total), and each refund takes the
+    difference. Every refund therefore splits exactly into amount_cents, and once the
+    full total is refunded exactly order_tax_cents and order_subtotal_cents are reversed.
+    """
+    validate_non_negative_int(order_subtotal_cents, "order_subtotal_cents")
+    validate_non_negative_int(order_tax_cents, "order_tax_cents")
+    validate_non_negative_int(already_refunded_cents, "already_refunded_cents")
+    validate_positive_int(amount_cents, "amount_cents")
+    order_total = order_subtotal_cents + order_tax_cents
+    refunded_after = already_refunded_cents + amount_cents
+    if refunded_after > order_total:
+        raise ValidationError(
+            f"refund of {amount_cents} exceeds refundable balance "
+            f"{order_total - already_refunded_cents}"
+        )
+    tax_before = round_half_up_div(order_tax_cents * already_refunded_cents, order_total)
+    tax_after = round_half_up_div(order_tax_cents * refunded_after, order_total)
+    refund_tax = tax_after - tax_before
+    return amount_cents - refund_tax, refund_tax

