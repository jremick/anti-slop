+class ComputeRefundSplitTests(unittest.TestCase):
+    def test_three_equal_chunks_conserve_pennies(self) -> None:
+        # order: subtotal 1000, tax 83 (82.5 -> 83), total 1083
+        # cumulative tax: 83*361/1083=27.67->28, 83*722/1083=55.33->55, 83
+        self.assertEqual(compute_refund_split(1000, 83, 0, 361), (333, 28))
+        self.assertEqual(compute_refund_split(1000, 83, 361, 361), (334, 27))
+        self.assertEqual(compute_refund_split(1000, 83, 722, 361), (333, 28))
+
+    def test_penny_refunds_conserve_pennies(self) -> None:
+        refunded = sub_sum = tax_sum = 0
+        for _ in range(1083):
+            sub, tax = compute_refund_split(1000, 83, refunded, 1)
+            self.assertIn((sub, tax), [(1, 0), (0, 1)])
+            refunded += 1
+            sub_sum += sub
+            tax_sum += tax
+        self.assertEqual((sub_sum, tax_sum), (1000, 83))
+
+    def test_randomized_sequences_conserve_pennies(self) -> None:
+        rng = random.Random(20261127)
+        for _ in range(500):
+            subtotal = rng.randint(0, 50_000)
+            tax = rng.randint(0, subtotal) if rng.random() < 0.9 else rng.randint(0, 50)
+            total = subtotal + tax
+            if total == 0:
+                continue
+            refunded = sub_sum = tax_sum = 0
+            while refunded < total:
+                amount = rng.randint(1, total - refunded)
+                sub, tx = compute_refund_split(subtotal, tax, refunded, amount)
+                self.assertEqual(sub + tx, amount)
+                self.assertGreaterEqual(sub, 0)
+                self.assertGreaterEqual(tx, 0)
+                refunded += amount
+                sub_sum += sub
+                tax_sum += tx
+            self.assertEqual((sub_sum, tax_sum), (subtotal, tax), (subtotal, tax))
+
+    def test_over_refund_and_bad_amounts_rejected(self) -> None:
+        for args in [(1000, 83, 1000, 84), (1000, 83, 0, 1084), (1000, 83, 0, 0), (1000, 83, 0, -1),
+                     (1000, 83, 0, True), (1000, 83, 0, 1.0), (0, 0, 0, 1)]:
+            with self.subTest(args=args), self.assertRaises(ValidationError):
+                compute_refund_split(*args)
