+def validate_promo_code(code: str) -> str:
+    """Require exactly one non-empty code; separator characters indicate stacking."""
+    if not isinstance(code, str) or not code:
+        raise ValidationError("promo code must be a non-empty string")
+    if _PROMO_SEPARATOR_RE.search(code):
+        raise ValidationError(f"promo code must be a single code without separators: {code!r}")
+    return code
