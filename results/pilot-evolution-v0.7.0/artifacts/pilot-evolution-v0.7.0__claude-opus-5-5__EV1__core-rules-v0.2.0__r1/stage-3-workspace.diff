+def apply_promo_and_tax(
+    subtotal_cents: int,
+    tax_bps: int,
+    *,
+    promo: Optional[Promo] = None,
+    as_of: Optional[date] = None,
+) -> PricedTotals:
+    """Canonical discount + tax step shared by orders and upgrades.
+
+    The discount comes off the pre-tax subtotal (clamped at 0) and tax is computed on
+    the discounted subtotal. Any promo that cannot be honoured raises ValidationError.
+    """
+    validate_non_negative_int(subtotal_cents, "subtotal_cents")
+    discount = 0
+    if promo is not None:
+        validate_promo(promo)
+        if promo.expires_on is not None:
+            if as_of is None:
+                raise ValidationError(f"as_of is required for expiring promo {promo.code}")
+            if as_of > promo.expires_on:
+                raise ValidationError(f"promo {promo.code} expired on {promo.expires_on.isoformat()}")
+        if subtotal_cents < promo.min_subtotal_cents:
+            raise ValidationError(
+                f"subtotal {subtotal_cents} is below promo minimum {promo.min_subtotal_cents}"
+            )
+        if promo.percent_off is not None:
+            discount = round_half_up_div(subtotal_cents * promo.percent_off, 100)
+        else:
