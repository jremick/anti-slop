+"""Tests for mid-cycle prorated plan upgrades and idempotency (Turn 1)."""
+
+from __future__ import annotations
+
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import Plan, ValidationError
+from ev1_order_ledger.pricing import calculate_upgrade_totals, compute_proration_cents
+
+
+class ProrationPricingTests(unittest.TestCase):
+    def test_exact_division(self) -> None:
+        # (3000 - 1000) * 15 / 30 = 1000
+        self.assertEqual(compute_proration_cents(1000, 3000, 15, 30), 1000)
+
+    def test_half_rounds_up(self) -> None:
+        # 1 * 1 / 2 = 0.5 -> 1 ; 3 * 1 / 2 = 1.5 -> 2
+        self.assertEqual(compute_proration_cents(0, 1, 1, 2), 1)
+        self.assertEqual(compute_proration_cents(0, 3, 1, 2), 2)
+
+    def test_below_half_rounds_down_above_half_rounds_up(self) -> None:
+        # 100 * 1 / 3 = 33.33 -> 33 ; 100 * 2 / 3 = 66.67 -> 67
+        self.assertEqual(compute_proration_cents(0, 100, 1, 3), 33)
+        self.assertEqual(compute_proration_cents(0, 100, 2, 3), 67)
+
+    def test_boundary_days(self) -> None:
+        self.assertEqual(compute_proration_cents(1000, 2999, 0, 30), 0)
+        self.assertEqual(compute_proration_cents(1000, 2999, 30, 30), 1999)
+
+    def test_upgrade_totals_use_new_plan_tax(self) -> None:
+        old = Plan("a", "A", 1000, tax_bps=0)
+        new = Plan("b", "B", 2999, tax_bps=825)
+        # 1999 * 10 / 30 = 666.33 -> 666 ; 666 * 0.0825 = 54.945 -> 55
+        self.assertEqual(calculate_upgrade_totals(old, new, 10, 30), (666, 0, 55, 721))
+
+
+class UpgradeSubscriptionTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="odd", name="Odd", monthly_cents=1001, tax_bps=1000))
+        self.svc.register_plan(Plan(plan_id="cheap", name="Cheap", monthly_cents=500))
+        self.svc.register_plan(Plan(plan_id="same", name="Same", monthly_cents=1000))
+        self.sub = self.svc.start_subscription("acct_1", "starter")
+
+    def entries(self):
+        return self.svc.ledger.entries_for_account("acct_1")
+
+    def test_upgrade_records_prorated_entry_and_switches_plan(self) -> None:
+        # 2000 * 10 / 30 = 666.67 -> 667 ; tax 667 * 825 / 10000 = 55.03 -> 55
+        entry = self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 10, 30, idempotency_key="k1")
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.sub.subscription_id)
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (667, 55, 722))
+        self.assertEqual(entry.metadata["old_plan_id"], "starter")
+        self.assertEqual(entry.metadata["new_plan_id"], "pro")
+        self.assertEqual(self.svc.ledger.get_subscription(self.sub.subscription_id).plan_id, "pro")
+        self.assertEqual(self.entries(), [entry])
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 722)
+
+    def test_upgrade_exact_half_rounds_up_through_service(self) -> None:
+        # 1 * 1 / 2 = 0.5 -> 1 ; tax 1 * 1000 / 10000 = 0.1 -> 0
+        entry = self.svc.upgrade_subscription(self.sub.subscription_id, "odd", 1, 2, idempotency_key="k1")
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (1, 0, 1))
+
+    def test_zero_days_remaining_records_zero_charge(self) -> None:
+        entry = self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 0, 30, idempotency_key="k1")
+        self.assertEqual(entry.total_cents, 0)
+        self.assertEqual(self.svc.ledger.get_subscription(self.sub.subscription_id).plan_id, "pro")
+
+    def assert_rejected(self, *args, idempotency_key="k_bad") -> None:
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(*args, idempotency_key=idempotency_key)
+        self.assertEqual(self.entries(), [])
+        self.assertEqual(self.svc.ledger.get_subscription(self.sub.subscription_id).plan_id, "starter")
+
+    def test_unknown_ids_rejected(self) -> None:
+        self.assert_rejected("sub_missing", "pro", 10, 30)
+        self.assert_rejected(self.sub.subscription_id, "missing", 10, 30)
+
+    def test_non_upgrades_rejected(self) -> None:
+        self.assert_rejected(self.sub.subscription_id, "cheap", 10, 30)
+        self.assert_rejected(self.sub.subscription_id, "same", 10, 30)
+        self.assert_rejected(self.sub.subscription_id, "starter", 10, 30)
+
+    def test_invalid_bounds_rejected(self) -> None:
+        sid = self.sub.subscription_id
+        self.assert_rejected(sid, "pro", 0, 0)
+        self.assert_rejected(sid, "pro", 0, -30)
+        self.assert_rejected(sid, "pro", -1, 30)
+        self.assert_rejected(sid, "pro", 31, 30)
+
+    def test_booleans_and_non_integers_rejected(self) -> None:
+        sid = self.sub.subscription_id
+        self.assert_rejected(sid, "pro", True, 30)
+        self.assert_rejected(sid, "pro", 1, True)
+        self.assert_rejected(sid, "pro", False, 30)
+        self.assert_rejected(sid, "pro", 1.0, 30)
+        self.assert_rejected(sid, "pro", 1, 30.0)
+
+    def test_empty_or_non_string_idempotency_key_rejected(self) -> None:
+        sid = self.sub.subscription_id
+        self.assert_rejected(sid, "pro", 10, 30, idempotency_key="")
+        self.assert_rejected(sid, "pro", 10, 30, idempotency_key="   ")
+        self.assert_rejected(sid, "pro", 10, 30, idempotency_key=None)
+
+    def test_idempotency_key_is_keyword_only(self) -> None:
+        with self.assertRaises(TypeError):
+            self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 10, 30, "k1")
+
+    def test_replay_returns_original_entry_without_duplicate(self) -> None:
+        first = self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 10, 30, idempotency_key="k1")
+        replay = self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 10, 30, idempotency_key="k1")
+        self.assertIs(replay, first)
+        self.assertEqual(self.entries(), [first])
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], first.total_cents)
+        self.assertEqual(self.svc.ledger.get_subscription(self.sub.subscription_id).plan_id, "pro")
+
+    def test_key_reuse_with_different_arguments_conflicts(self) -> None:
+        first = self.svc.upgrade_subscription(self.sub.subscription_id, "odd", 10, 30, idempotency_key="k1")
+        for args in [
+            (self.sub.subscription_id, "pro", 10, 30),
+            (self.sub.subscription_id, "odd", 11, 30),
+            (self.sub.subscription_id, "odd", 10, 31),
+        ]:
+            with self.subTest(args=args), self.assertRaises(ValidationError):
+                self.svc.upgrade_subscription(*args, idempotency_key="k1")
+        other = self.svc.start_subscription("acct_1", "starter")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(other.subscription_id, "odd", 10, 30, idempotency_key="k1")
+        self.assertEqual(self.entries(), [first])
+        self.assertEqual(self.svc.ledger.get_subscription(self.sub.subscription_id).plan_id, "odd")
+        self.assertEqual(other.plan_id, "starter")
+
+    def test_failed_call_does_not_consume_key(self) -> None:
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(self.sub.subscription_id, "cheap", 10, 30, idempotency_key="k1")
+        entry = self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 10, 30, idempotency_key="k1")
+        self.assertEqual(entry.total_cents, 722)
+
+    def test_new_key_after_upgrade_enforces_current_plan(self) -> None:
+        self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 10, 30, idempotency_key="k1")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 10, 30, idempotency_key="k2")
+        self.assertEqual(len(self.entries()), 1)
