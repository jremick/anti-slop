+class ApplyPromoAndTaxTests(unittest.TestCase):
+    def test_no_promo_is_plain_tax(self) -> None:
+        self.assertEqual(apply_promo_and_tax(3998, 825), (3998, 0, 330, 4328))
+
+    def test_percent_discount_rounds_half_up(self) -> None:
+        # 15% of 1010 = 151.5 -> 152 off ; 858 * 10% = 85.8 -> 86
+        promo = Promo(code="P15", percent_off=15)
+        self.assertEqual(apply_promo_and_tax(1010, 1000, promo=promo), (858, 152, 86, 944))
+
+    def test_fixed_discount_clamps_at_zero(self) -> None:
+        promo = Promo(code="BIG", amount_off_cents=5000)
+        self.assertEqual(apply_promo_and_tax(1200, 825, promo=promo), (0, 1200, 0, 0))
+
+    def test_expiry_boundary_is_inclusive(self) -> None:
+        promo = Promo(code="E", amount_off_cents=100, expires_on=date(2026, 12, 31))
+        self.assertEqual(apply_promo_and_tax(1000, 0, promo=promo, as_of=date(2026, 12, 31)).discount_cents, 100)
+        with self.assertRaises(ValidationError):
+            apply_promo_and_tax(1000, 0, promo=promo, as_of=date(2027, 1, 1))
+        with self.assertRaises(ValidationError):
+            apply_promo_and_tax(1000, 0, promo=promo)
+
+    def test_rejects_malformed_promo_objects(self) -> None:
+        for promo in [
+            Promo(code="X"),
+            Promo(code="X", percent_off=10, amount_off_cents=100),
+            Promo(code="X", percent_off=0),
+            Promo(code="X", percent_off=101),
+            Promo(code="X", percent_off=True),
+            Promo(code="X", amount_off_cents=0),
+            Promo(code="X", amount_off_cents=1, min_subtotal_cents=-1),
+            Promo(code="X", amount_off_cents=1, expires_on="2026-01-01"),
+            Promo(code="A,B", amount_off_cents=1),
+        ]:
+            with self.subTest(promo=promo), self.assertRaises(ValidationError):
+                apply_promo_and_tax(1000, 0, promo=promo)
