+    def get_idempotent_entry(self, idempotency_key: str, fingerprint: Hashable) -> Optional[LedgerEntry]:
+        """Return the entry recorded under idempotency_key, or None if the key is unused.
+
+        Raises ValidationError if the key was used with a different request fingerprint.
+        """
+        stored = self._idempotency.get(idempotency_key)
+        if stored is None:
+            return None
+        stored_fingerprint, entry = stored
+        if stored_fingerprint != fingerprint:
+            raise ValidationError(
+                f"idempotency_key {idempotency_key!r} was already used with different arguments"
+            )
+        return entry
+
+    def record_idempotent_entry(
+        self, idempotency_key: str, fingerprint: Hashable, entry: LedgerEntry
+    ) -> None:
+        if idempotency_key in self._idempotency:
+            raise ValidationError(f"idempotency_key {idempotency_key!r} already recorded")
+        self.record_entry(entry)
+        self._idempotency[idempotency_key] = (fingerprint, entry)

