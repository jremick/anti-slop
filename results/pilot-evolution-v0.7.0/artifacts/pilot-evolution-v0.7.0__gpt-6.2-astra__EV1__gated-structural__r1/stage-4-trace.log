{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cat > benchmarks/sources/ev1_order_ledger/tests/test_audit.py <<'PY'\nimport unittest\nfrom unittest.mock import Mock, patch\n\nfrom ev1_order_ledger import LineItem, OrderService, Plan\n\n\nclass AuditTests(unittest.TestCase):\n    def setUp(self):\n        self.sink = Mock()\n        self.service = OrderService(audit_sink=self.sink)\n        self.items = [LineItem(\\\"seat\\\", 75, 2)]\n        self.service.register_plan(Plan(\\\"base\\\", \\\"Base\\\", 100))\n        self.service.register_plan(Plan(\\\"plus\\\", \\\"Plus\\\", 200))\n        self.sub = self.service.start_subscription(\\\"acct\\\", \\\"base\\\")\n\n    def upgrade(self):\n        return self.service.upgrade_subscription(\n            self.sub.subscription_id, \\\"plus\\\", 1, 2, idempotency_key=\\\"upgrade\\\",\n        )\n\n    def refund(self, order):\n        return self.service.refund_order(\n            order.order_id, order.total_cents, reason=\\\"returned\\\", idempotency_key=\\\"refund\\\",\n        )\n\n    def test_audits_each_new_entry_once_with_signed_total(self):\n        order = self.service.place_order(\\\"acct\\\", self.items, tax_bps=1000)\n        charge, = self.service.ledger.entries_for_account(\\\"acct\\\")\n        upgrade = self.upgrade()\n        refund = self.refund(order)\n        self.assertIs(self.upgrade(), upgrade)\n        self.assertIs(self.refund(order), refund)\n        self.assertEqual([call.args[0] for call in self.sink.call_args_list], [\n            {\\\"action\\\": \\\"order_charge\\\", \\\"account_id\\\": \\\"acct\\\", \\\"amount_cents\\\": 165, \\\"entry_id\\\": charge.entry_id},\n            {\\\"action\\\": \\\"plan_upgrade\\\", \\\"account_id\\\": \\\"acct\\\", \\\"amount_cents\\\": 50, \\\"entry_id\\\": upgrade.entry_id},\n            {\\\"action\\\": \\\"order_refund\\\", \\\"account_id\\\": \\\"acct\\\", \\\"amount_cents\\\": -165, \\\"entry_id\\\": refund.entry_id},\n        ])\n\n    def test_order_audit_failure_prevents_order_and_entry_writes(self):\n        self.sink.side_effect = RuntimeError(\\\"audit unavailable\\\")\n        ledger = self.service.ledger\n        with patch.object(ledger, \\\"save_order\\\", wraps=ledger.save_order) as save:\n            with self.assertRaisesRegex(RuntimeError, \\\"audit unavailable\\\"):\n                self.service.place_order(\\\"acct\\\", self.items)\n            save.assert_not_called()\n        self.assertEqual(ledger.entries_for_account(\\\"acct\\\"), [])\n        self.assertIsNone(ledger.get_entry(self.sink.call_args.args[0][\\\"entry_id\\\"]))\n\n    def test_upgrade_audit_failure_preserves_plan_and_allows_retry(self):\n        self.sink.side_effect = RuntimeError(\\\"audit unavailable\\\")\n        with self.assertRaisesRegex(RuntimeError, \\\"audit unavailable\\\"):\n            self.upgrade()\n        self.assertEqual(self.sub.plan_id, \\\"base\\\")\n        self.assertEqual(self.service.ledger.entries_for_account(\\\"acct\\\"), [])\n        self.sink.side_effect = None\n        entry = self.upgrade()\n        self.assertEqual(self.sub.plan_id, \\\"plus\\\")\n        self.assertEqual(self.service.ledger.entries_for_account(\\\"acct\\\"), [entry])\n        self.assertEqual(self.sink.call_count, 2)\n\n    def test_refund_audit_failure_preserves_refundable_balance_and_allows_retry(self):\n        order = self.service.place_order(\\\"acct\\\", self.items)\n        charge, = self.service.ledger.entries_for_account(\\\"acct\\\")\n        self.sink.side_effect = RuntimeError(\\\"audit unavailable\\\")\n        with self.assertRaisesRegex(RuntimeError, \\\"audit unavailable\\\"):\n            self.refund(order)\n        self.assertEqual(self.service.ledger.entries_for_account(\\\"acct\\\"), [charge])\n        self.sink.side_effect = None\n        refund = self.refund(order)\n        self.assertEqual(self.service.ledger.entries_for_account(\\\"acct\\\"), [charge, refund])\n        self.assertEqual(self.service.get_statement(\\\"acct\\\")[\\\"balance_cents\\\"], 0)\n        self.assertEqual(self.sink.call_count, 3)\nPY\npython3 benchmarks/sources/ev1_order_ledger/run_checks.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
