{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc 'cd benchmarks/sources/ev1_order_ledger && cat api.py ledger.py pricing.py tests/test_orders.py tests/test_promos.py'","aggregated_output":"\"\"\"Service facade coordinating pricing and ledger persistence for EV1.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Dict, Sequence\n\nfrom .ledger import OrderLedger\nfrom .models import LedgerEntry, LineItem, Order, Plan, Promo, Subscription, ValidationError\nfrom .pricing import LEGACY_FLAT_FEE_CENTS, calculate_charge_totals, compute_subtotal_cents\n\n\nclass OrderService:\n    def __init__(self, ledger: OrderLedger | None = None) -> None:\n        self.ledger = ledger if ledger is not None else OrderLedger()\n\n    def register_plan(self, plan: Plan) -> None:\n        self.ledger.add_plan(plan)\n\n    def register_promo(\n        self,\n        code: str,\n        *,\n        percent_off: int | None = None,\n        amount_off_cents: int | None = None,\n        expires_on: str | None = None,\n        min_subtotal_cents: int = 0,\n    ) -> None:\n        self.ledger.add_promo(Promo(code, percent_off, amount_off_cents, expires_on, min_subtotal_cents))\n\n    def place_order(\n        self,\n        account_id: str,\n        items: Sequence[LineItem],\n        *,\n        tax_bps: int = 0,\n        legacy_flat_fee: bool = False,\n        promo_code: str | None = None,\n        as_of: str | None = None,\n    ) -> Order:\n        if not account_id.strip():\n            raise ValidationError(\"account_id must be non-empty\")\n        gross = compute_subtotal_cents(items)\n        if legacy_flat_fee:\n            gross += LEGACY_FLAT_FEE_CENTS\n        subtotal, tax, total = calculate_charge_totals(\n            gross, tax_bps, self.ledger.get_promo(promo_code), as_of,\n        )\n        order_id = self.ledger.next_id(\"ord\")\n        order = Order(\n            order_id=order_id,\n            account_id=account_id,\n            items=tuple(items),\n            discount_cents=gross - subtotal,\n            promo_code=promo_code,\n            subtotal_cents=subtotal,\n            tax_cents=tax,\n            total_cents=total,\n        )\n        self.ledger.save_order(order)\n        entry = LedgerEntry(\n            entry_id=self.ledger.next_id(\"ent\"),\n            account_id=account_id,\n            kind=\"order_charge\",\n            subtotal_cents=subtotal,\n            tax_cents=tax,\n            total_cents=total,\n            reference_id=order_id,\n        )\n        self.ledger.record_entry(entry)\n        return order\n\n    def refund_order(\n        self, order_id: str, amount_cents: int, *, reason: str, idempotency_key: str,\n    ) -> LedgerEntry:\n        return self.ledger.refund_order(order_id, amount_cents, reason=reason, idempotency_key=idempotency_key)\n\n    def export_credit_note(self, refund_entry_id: str) -> Dict[str, str | int]:\n        if not isinstance(refund_entry_id, str):\n            raise ValidationError(\"refund_entry_id must be a string\")\n        entry = self.ledger.get_entry(refund_entry_id)\n        if entry is None or entry.kind != \"order_refund\":\n            raise ValidationError(\"credit note requires a known refund entry\")\n        return {\n            \"entry_id\": entry.entry_id,\n            \"order_id\": entry.reference_id,\n            \"account_id\": entry.account_id,\n            \"subtotal_cents\": -entry.subtotal_cents,\n            \"tax_cents\": -entry.tax_cents,\n            \"total_cents\": -entry.total_cents,\n            \"reason\": entry.reason,\n        }\n\n    def start_subscription(self, account_id: str, plan_id: str) -> Subscription:\n        if not account_id.strip():\n            raise ValidationError(\"account_id must be non-empty\")\n        self.ledger.get_plan(plan_id)\n        sub = Subscription(\n            subscription_id=self.ledger.next_id(\"sub\"),\n            account_id=account_id,\n            plan_id=plan_id,\n        )\n        self.ledger.save_subscription(sub)\n        return sub\n\n    def upgrade_subscription(\n        self,\n        subscription_id: str,\n        new_plan_id: str,\n        days_remaining: int,\n        cycle_days: int,\n        *,\n        idempotency_key: str,\n        promo_code: str | None = None,\n        as_of: str | None = None,\n    ) -> LedgerEntry:\n        return self.ledger.upgrade_subscription(\n            subscription_id, new_plan_id, days_remaining, cycle_days,\n            idempotency_key=idempotency_key, promo_code=promo_code, as_of=as_of,\n        )\n\n    def get_statement(self, account_id: str) -> Dict[str, object]:\n        entries = self.ledger.entries_for_account(account_id)\n        return {\n            \"account_id\": account_id,\n            \"balance_cents\": self.ledger.account_balance_cents(account_id),\n            \"entry_count\": len(entries),\n        }\n\"\"\"In-memory order, subscription, and ledger store for EV1.\"\"\"\n\nfrom __future__ import annotations\n\nfrom threading import Lock\nfrom typing import Dict, List, Optional\n\nfrom .models import LedgerEntry, Order, Plan, Promo, Subscription, ValidationError\nfrom .pricing import (\n    calculate_refund_split, calculate_upgrade_totals, validate_non_negative_int,\n    validate_positive_int, validate_promo,\n)\n\n\nclass OrderLedger:\n    def __init__(self) -> None:\n        self._plans: Dict[str, Plan] = {}\n        self._promos: Dict[str, Promo] = {}\n        self._orders: Dict[str, Order] = {}\n        self._subscriptions: Dict[str, Subscription] = {}\n        self._entries: Dict[str, LedgerEntry] = {}\n        self._entry_order: List[str] = []\n        self._idempotent_entries: Dict[str, tuple[tuple[object, ...], LedgerEntry]] = {}\n        self._refunded_cents: Dict[str, int] = {}\n        self._billing_lock = Lock()\n        self._seq = 0\n\n    def next_id(self, prefix: str) -> str:\n        self._seq += 1\n        return f\"{prefix}_{self._seq:04d}\"\n\n    def add_plan(self, plan: Plan) -> None:\n        if not plan.plan_id.strip():\n            raise ValidationError(\"plan_id must be non-empty\")\n        if isinstance(plan.monthly_cents, bool) or not isinstance(plan.monthly_cents, int) or plan.monthly_cents < 0:\n            raise ValidationError(\"monthly_cents must be a non-negative integer\")\n        self._plans[plan.plan_id] = plan\n\n    def add_promo(self, promo: Promo) -> None:\n        validate_promo(promo)\n        self._promos[promo.code] = promo\n\n    def get_promo(self, code: str | None) -> Promo | None:\n        if code is None:\n            return None\n        if not isinstance(code, str) or code not in self._promos:\n            raise ValidationError(f\"Unknown promo code: {code}\")\n        return self._promos[code]\n\n    def get_plan(self, plan_id: str) -> Plan:\n        plan = self._plans.get(plan_id)\n        if plan is None:\n            raise ValidationError(f\"Unknown plan_id: {plan_id}\")\n        return plan\n\n    def save_order(self, order: Order) -> None:\n        self._orders[order.order_id] = order\n\n    def get_order(self, order_id: str) -> Order:\n        order = self._orders.get(order_id)\n        if order is None:\n            raise ValidationError(f\"Unknown order_id: {order_id}\")\n        return order\n\n    def save_subscription(self, sub: Subscription) -> None:\n        self._subscriptions[sub.subscription_id] = sub\n\n    def get_subscription(self, subscription_id: str) -> Subscription:\n        sub = self._subscriptions.get(subscription_id)\n        if sub is None:\n            raise ValidationError(f\"Unknown subscription_id: {subscription_id}\")\n        return sub\n\n    def _replay_entry(self, idempotency_key: str, arguments: tuple[object, ...]) -> LedgerEntry | None:\n        if not isinstance(idempotency_key, str) or not idempotency_key.strip():\n            raise ValidationError(\"idempotency_key must be a non-empty string\")\n        prior = self._idempotent_entries.get(idempotency_key)\n        if prior is None:\n            return None\n        prior_arguments, entry = prior\n        if arguments != prior_arguments:\n            raise ValidationError(\"idempotency_key already used for a different request\")\n        return entry\n\n    def upgrade_subscription(\n        self,\n        subscription_id: str,\n        new_plan_id: str,\n        days_remaining: int,\n        cycle_days: int,\n        *,\n        idempotency_key: str,\n        promo_code: str | None = None,\n        as_of: str | None = None,\n    ) -> LedgerEntry:\n        if not isinstance(subscription_id, str) or not isinstance(new_plan_id, str):\n            raise ValidationError(\"subscription_id and new_plan_id must be strings\")\n        validate_non_negative_int(days_remaining, \"days_remaining\")\n        validate_positive_int(cycle_days, \"cycle_days\")\n        if days_remaining > cycle_days:\n            raise ValidationError(\"days_remaining cannot exceed cycle_days\")\n\n        arguments = (\"plan_upgrade\", subscription_id, new_plan_id, days_remaining, cycle_days, promo_code, as_of)\n        with self._billing_lock:\n            prior = self._replay_entry(idempotency_key, arguments)\n            if prior is not None:\n                return prior\n\n            sub = self.get_subscription(subscription_id)\n            subtotal, tax, total = calculate_upgrade_totals(\n                self.get_plan(sub.plan_id), self.get_plan(new_plan_id), days_remaining, cycle_days,\n                promo=self.get_promo(promo_code), as_of=as_of,\n            )\n            entry = LedgerEntry(\n                entry_id=self.next_id(\"ent\"),\n                account_id=sub.account_id,\n                kind=\"plan_upgrade\",\n                subtotal_cents=subtotal,\n                tax_cents=tax,\n                total_cents=total,\n                reference_id=subscription_id,\n            )\n            self.record_entry(entry)\n            sub.plan_id = new_plan_id\n            self._idempotent_entries[idempotency_key] = (arguments, entry)\n            return entry\n\n    def refund_order(\n        self, order_id: str, amount_cents: int, *, reason: str, idempotency_key: str,\n    ) -> LedgerEntry:\n        validate_positive_int(amount_cents, \"amount_cents\")\n        if not isinstance(reason, str) or not reason.strip():\n            raise ValidationError(\"reason must be a non-empty string\")\n        if not isinstance(order_id, str):\n            raise ValidationError(\"order_id must be a string\")\n\n        arguments = (\"order_refund\", order_id, amount_cents, reason)\n        with self._billing_lock:\n            prior = self._replay_entry(idempotency_key, arguments)\n            if prior is not None:\n                return prior\n\n            order = self.get_order(order_id)\n            subtotal, tax = calculate_refund_split(\n                order, self._refunded_cents.get(order_id, 0), amount_cents,\n            )\n            entry = LedgerEntry(\n                entry_id=self.next_id(\"ent\"),\n                account_id=order.account_id,\n                kind=\"order_refund\",\n                subtotal_cents=-subtotal,\n                tax_cents=-tax,\n                total_cents=-amount_cents,\n                reference_id=order_id,\n                reason=reason,\n            )\n            self.record_entry(entry)\n            self._idempotent_entries[idempotency_key] = (arguments, entry)\n            return entry\n\n    def record_entry(self, entry: LedgerEntry) -> None:\n        self._entries[entry.entry_id] = entry\n        self._entry_order.append(entry.entry_id)\n        if entry.kind == \"order_refund\":\n            order_id = entry.reference_id\n            self._refunded_cents[order_id] = self._refunded_cents.get(order_id, 0) - entry.total_cents\n\n    def get_entry(self, entry_id: str) -> Optional[LedgerEntry]:\n        return self._entries.get(entry_id)\n\n    def entries_for_account(self, account_id: str) -> List[LedgerEntry]:\n        return [\n            self._entries[eid]\n            for eid in self._entry_order\n            if self._entries[eid].account_id == account_id\n        ]\n\n    def account_balance_cents(self, account_id: str) -> int:\n        return sum(e.total_cents for e in self.entries_for_account(account_id))\n\"\"\"Canonical integer-cent pricing calculations for EV1 order ledger.\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import date\nfrom typing import Sequence, Tuple\n\nfrom .models import LineItem, Order, Plan, Promo, ValidationError\n\n\nLEGACY_FLAT_FEE_CENTS = 500\n\n\ndef validate_non_negative_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value < 0:\n        raise ValidationError(f\"{field_name} must be a non-negative integer\")\n    return value\n\n\ndef validate_positive_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:\n        raise ValidationError(f\"{field_name} must be a positive integer\")\n    return value\n\n\ndef round_half_up_div(numerator: int, denominator: int) -> int:\n    \"\"\"Exact integer half-up division for non-negative numerator and positive denominator.\"\"\"\n    validate_non_negative_int(numerator, \"numerator\")\n    validate_positive_int(denominator, \"denominator\")\n    return (numerator * 2 + denominator) // (2 * denominator)\n\n\ndef compute_subtotal_cents(items: Sequence[LineItem]) -> int:\n    if not items:\n        raise ValidationError(\"items must be non-empty\")\n    subtotal = 0\n    for item in items:\n        validate_positive_int(item.unit_cents, \"unit_cents\")\n        validate_positive_int(item.quantity, \"quantity\")\n        subtotal += item.unit_cents * item.quantity\n    return subtotal\n\n\ndef compute_tax_cents(taxable_cents: int, tax_bps: int) -> int:\n    validate_non_negative_int(taxable_cents, \"taxable_cents\")\n    validate_non_negative_int(tax_bps, \"tax_bps\")\n    if tax_bps > 10_000:\n        raise ValidationError(\"tax_bps cannot exceed 10000\")\n    return round_half_up_div(taxable_cents * tax_bps, 10_000)\n\n\ndef validate_date(value: str) -> None:\n    try:\n        parsed = date.fromisoformat(value)\n    except (TypeError, ValueError) as exc:\n        raise ValidationError(\"expected a YYYY-MM-DD date\") from exc\n    if parsed.isoformat() != value:\n        raise ValidationError(\"expected a YYYY-MM-DD date\")\n\n\ndef validate_promo(promo: Promo) -> None:\n    if not isinstance(promo.code, str) or not promo.code.strip() or \",\" in promo.code:\n        raise ValidationError(\"expected one non-empty promo code\")\n    if (promo.percent_off is None) == (promo.amount_off_cents is None):\n        raise ValidationError(\"provide exactly one discount\")\n    if promo.percent_off is not None:\n        validate_positive_int(promo.percent_off, \"percent_off\")\n        if promo.percent_off > 100:\n            raise ValidationError(\"percent_off cannot exceed 100\")\n    else:\n        validate_positive_int(promo.amount_off_cents, \"amount_off_cents\")\n    validate_non_negative_int(promo.min_subtotal_cents, \"min_subtotal_cents\")\n    if promo.expires_on is not None:\n        validate_date(promo.expires_on)\n\n\ndef calculate_charge_totals(\n    subtotal: int, tax_bps: int, promo: Promo | None, as_of: str | None,\n) -> Tuple[int, int, int]:\n    \"\"\"Return discounted subtotal, tax, and total in cents.\"\"\"\n    if as_of is not None:\n        validate_date(as_of)\n    if promo is not None:\n        if subtotal < promo.min_subtotal_cents:\n            raise ValidationError(\"subtotal is below the promo minimum\")\n        if promo.expires_on is not None and (as_of is None or as_of > promo.expires_on):\n            raise ValidationError(\"expiring promo requires as_of on or before its expiry\")\n        if promo.percent_off is not None:\n            discount = round_half_up_div(subtotal * promo.percent_off, 100)\n        else:\n            discount = promo.amount_off_cents\n        subtotal = max(0, subtotal - discount)\n    tax = compute_tax_cents(subtotal, tax_bps)\n    return subtotal, tax, subtotal + tax\n\n\ndef calculate_upgrade_totals(\n    old_plan: Plan, new_plan: Plan, days_remaining: int, cycle_days: int,\n    *, promo: Promo | None = None, as_of: str | None = None,\n) -> Tuple[int, int, int]:\n    difference = new_plan.monthly_cents - old_plan.monthly_cents\n    if difference <= 0:\n        raise ValidationError(\"new plan must have a higher monthly price\")\n    subtotal = round_half_up_div(difference * days_remaining, cycle_days)\n    return calculate_charge_totals(subtotal, new_plan.tax_bps, promo, as_of)\n\n\ndef calculate_refund_split(order: Order, already_refunded: int, amount: int) -> Tuple[int, int]:\n    \"\"\"Allocate this refund as the change in cumulative rounded tax.\"\"\"\n    cumulative = already_refunded + amount\n    if cumulative > order.total_cents:\n        raise ValidationError(\"refund exceeds the remaining order balance\")\n    previous_tax = round_half_up_div(already_refunded * order.tax_cents, order.total_cents)\n    cumulative_tax = round_half_up_div(cumulative * order.tax_cents, order.total_cents)\n    tax = cumulative_tax - previous_tax\n    return amount - tax, tax\n\"\"\"Baseline unit tests for the initial EV1 order ledger fixture.\"\"\"\n\nfrom __future__ import annotations\n\nimport unittest\n\nfrom ev1_order_ledger.api import OrderService\nfrom ev1_order_ledger.models import LineItem, Plan, ValidationError\n\n\nclass BaselineOrderLedgerTests(unittest.TestCase):\n    def setUp(self) -> None:\n        self.svc = OrderService()\n        self.svc.register_plan(Plan(plan_id=\"starter\", name=\"Starter\", monthly_cents=1000, tax_bps=825))\n        self.svc.register_plan(Plan(plan_id=\"pro\", name=\"Pro\", monthly_cents=3000, tax_bps=825))\n\n    def test_place_order_computes_exact_integer_tax_and_records_entry(self) -> None:\n        order = self.svc.place_order(\n            \"acct_1\",\n            [LineItem(sku=\"seat\", unit_cents=1999, quantity=2)],\n            tax_bps=825,\n        )\n        self.assertEqual(order.subtotal_cents, 3998)\n        self.assertEqual(order.tax_cents, 330)  # 3998 * 825 / 10000 = 329.835 -> 330\n        self.assertEqual(order.total_cents, 4328)\n        stmt = self.svc.get_statement(\"acct_1\")\n        self.assertEqual(stmt[\"balance_cents\"], 4328)\n        self.assertEqual(stmt[\"entry_count\"], 1)\n\n    def test_legacy_flat_fee_adds_500_cents_before_tax(self) -> None:\n        order = self.svc.place_order(\n            \"acct_1\",\n            [LineItem(sku=\"seat\", unit_cents=1000, quantity=1)],\n            tax_bps=1000,\n            legacy_flat_fee=True,\n        )\n        self.assertEqual(order.subtotal_cents, 1500)\n        self.assertEqual(order.tax_cents, 150)\n        self.assertEqual(order.total_cents, 1650)\n\n    def test_invalid_order_inputs_fail_closed(self) -> None:\n        with self.assertRaises(ValidationError):\n            self.svc.place_order(\"\", [LineItem(sku=\"x\", unit_cents=100, quantity=1)])\n        with self.assertRaises(ValidationError):\n            self.svc.place_order(\"acct_1\", [])\n        with self.assertRaises(ValidationError):\n            self.svc.place_order(\"acct_1\", [LineItem(sku=\"x\", unit_cents=0, quantity=1)])\n\n    def test_start_subscription_validates_plan(self) -> None:\n        sub = self.svc.start_subscription(\"acct_1\", \"starter\")\n        self.assertEqual(sub.plan_id, \"starter\")\n        with self.assertRaises(ValidationError):\n            self.svc.start_subscription(\"acct_1\", \"nonexistent\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\nimport unittest\n\nfrom ev1_order_ledger import LineItem, OrderService, Plan, ValidationError\n\n\nclass PromoTests(unittest.TestCase):\n    def setUp(self):\n        self.service = OrderService()\n        self.items = [LineItem(\"item\", 105, 1)]\n\n    def test_percentage_rounds_half_up_before_tax(self):\n        self.service.register_promo(\"TEN\", percent_off=10)\n        order = self.service.place_order(\"acct\", self.items, tax_bps=1000, promo_code=\"TEN\")\n        self.assertEqual(order.promo_code, \"TEN\")\n        self.assertEqual(order.discount_cents, 11)\n        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (94, 9, 103))\n        self.assertEqual(self.service.ledger.account_balance_cents(\"acct\"), 103)\n\n    def test_fixed_discount_clamped_after_fee_at_minimum(self):\n        self.service.register_promo(\"FIX\", amount_off_cents=700, min_subtotal_cents=605)\n        with self.assertRaises(ValidationError):\n            self.service.place_order(\"acct\", self.items, promo_code=\"FIX\")\n        order = self.service.place_order(\n            \"acct\", self.items, legacy_flat_fee=True, promo_code=\"FIX\", tax_bps=1000,\n        )\n        self.assertEqual(order.discount_cents, 605)\n        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (0, 0, 0))\n\n    def test_invalid_promo_registration(self):\n        for options in [\n            {}, {\"percent_off\": 10, \"amount_off_cents\": 1}, {\"percent_off\": 0},\n            {\"percent_off\": 101}, {\"percent_off\": True}, {\"amount_off_cents\": 0},\n            {\"amount_off_cents\": 1.5}, {\"percent_off\": 1, \"min_subtotal_cents\": -1},\n            {\"percent_off\": 1, \"expires_on\": \"2025-02-29\"},\n        ]:\n            with self.subTest(options=options), self.assertRaises(ValidationError):\n                self.service.register_promo(\"BAD\", **options)\n        for code in [\"\", \"  \", \"A,B\"]:\n            with self.subTest(code=code), self.assertRaises(ValidationError):\n                self.service.register_promo(code, percent_off=1)\n\n    def test_unknown_stacked_and_expired_promos_fail_closed(self):\n        self.service.register_promo(\"A\", percent_off=100, expires_on=\"2028-02-29\")\n        self.service.register_promo(\"B\", amount_off_cents=1)\n        for code, as_of in [\n            (\"unknown\", None), (\"A,B\", \"2028-02-29\"), (\"A\", None), (\"A\", \"2028-03-01\"),\n            (\"A\", \"20280229\"), (\"A\", \"2028-02-30\"),\n        ]:\n            with self.subTest(code=code, as_of=as_of), self.assertRaises(ValidationError):\n                self.service.place_order(\"acct\", self.items, promo_code=code, as_of=as_of)\n        self.assertEqual(self.service.ledger.entries_for_account(\"acct\"), [])\n        order = self.service.place_order(\"acct\", self.items, promo_code=\"A\", as_of=\"2028-02-29\")\n        self.assertEqual(order.discount_cents, 105)\n\n    def test_upgrade_discounts_prorated_subtotal_and_replays_original(self):\n        self.service.register_plan(Plan(\"basic\", \"Basic\", 100))\n        self.service.register_plan(Plan(\"pro\", \"Pro\", 501, tax_bps=1000))\n        self.service.register_promo(\"FIX\", amount_off_cents=51, min_subtotal_cents=201)\n        sub = self.service.start_subscription(\"acct\", \"basic\")\n        upgrade = OrderService(self.service.ledger).upgrade_subscription\n        args = (sub.subscription_id, \"pro\", 1, 2)\n        options = dict(idempotency_key=\"upgrade\", promo_code=\"FIX\", as_of=\"2026-03-01\")\n        with self.assertRaises(ValidationError):\n            upgrade(sub.subscription_id, \"pro\", 1, 3, **options)\n        self.assertEqual(sub.plan_id, \"basic\")\n        entry = upgrade(*args, **options)\n        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (150, 15, 165))\n        self.assertIs(upgrade(*args, **options), entry)\n        for change in [{\"promo_code\": None}, {\"as_of\": \"2026-03-02\"}]:\n            with self.subTest(change=change), self.assertRaises(ValidationError):\n                upgrade(*args, **{**options, **change})\n        self.assertEqual(self.service.ledger.entries_for_account(\"acct\"), [entry])\n","exit_code":0,"status":"completed"}}
