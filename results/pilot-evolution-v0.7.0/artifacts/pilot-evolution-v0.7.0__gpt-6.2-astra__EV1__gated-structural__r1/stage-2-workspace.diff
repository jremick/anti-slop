+import unittest
+
+from ev1_order_ledger import LineItem, OrderService, Plan, ValidationError
+
+
+class PromoTests(unittest.TestCase):
+    def setUp(self):
+        self.service = OrderService()
+        self.items = [LineItem("item", 105, 1)]
+
+    def test_percentage_rounds_half_up_before_tax(self):
+        self.service.register_promo("TEN", percent_off=10)
+        order = self.service.place_order("acct", self.items, tax_bps=1000, promo_code="TEN")
+        self.assertEqual(order.promo_code, "TEN")
+        self.assertEqual(order.discount_cents, 11)
+        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (94, 9, 103))
+        self.assertEqual(self.service.ledger.account_balance_cents("acct"), 103)
+
+    def test_fixed_discount_clamped_after_fee_at_minimum(self):
+        self.service.register_promo("FIX", amount_off_cents=700, min_subtotal_cents=605)
+        with self.assertRaises(ValidationError):
+            self.service.place_order("acct", self.items, promo_code="FIX")
+        order = self.service.place_order(
+            "acct", self.items, legacy_flat_fee=True, promo_code="FIX", tax_bps=1000,
+        )
+        self.assertEqual(order.discount_cents, 605)
+        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (0, 0, 0))
+
+    def test_invalid_promo_registration(self):
+        for options in [
+            {}, {"percent_off": 10, "amount_off_cents": 1}, {"percent_off": 0},
+            {"percent_off": 101}, {"percent_off": True}, {"amount_off_cents": 0},
+            {"amount_off_cents": 1.5}, {"percent_off": 1, "min_subtotal_cents": -1},
+            {"percent_off": 1, "expires_on": "2025-02-29"},
+        ]:
+            with self.subTest(options=options), self.assertRaises(ValidationError):
+                self.service.register_promo("BAD", **options)
+        for code in ["", "  ", "A,B"]:
+            with self.subTest(code=code), self.assertRaises(ValidationError):
+                self.service.register_promo(code, percent_off=1)
+
+    def test_unknown_stacked_and_expired_promos_fail_closed(self):
+        self.service.register_promo("A", percent_off=100, expires_on="2028-02-29")
+        self.service.register_promo("B", amount_off_cents=1)
+        for code, as_of in [
+            ("unknown", None), ("A,B", "2028-02-29"), ("A", None), ("A", "2028-03-01"),
+            ("A", "20280229"), ("A", "2028-02-30"),
+        ]:
+            with self.subTest(code=code, as_of=as_of), self.assertRaises(ValidationError):
+                self.service.place_order("acct", self.items, promo_code=code, as_of=as_of)
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [])
+        order = self.service.place_order("acct", self.items, promo_code="A", as_of="2028-02-29")
+        self.assertEqual(order.discount_cents, 105)
+
+    def test_upgrade_discounts_prorated_subtotal_and_replays_original(self):
+        self.service.register_plan(Plan("basic", "Basic", 100))
+        self.service.register_plan(Plan("pro", "Pro", 501, tax_bps=1000))
+        self.service.register_promo("FIX", amount_off_cents=51, min_subtotal_cents=201)
+        sub = self.service.start_subscription("acct", "basic")
+        upgrade = OrderService(self.service.ledger).upgrade_subscription
+        args = (sub.subscription_id, "pro", 1, 2)
+        options = dict(idempotency_key="upgrade", promo_code="FIX", as_of="2026-03-01")
+        with self.assertRaises(ValidationError):
+            upgrade(sub.subscription_id, "pro", 1, 3, **options)
+        self.assertEqual(sub.plan_id, "basic")
+        entry = upgrade(*args, **options)
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (150, 15, 165))
+        self.assertIs(upgrade(*args, **options), entry)
+        for change in [{"promo_code": None}, {"as_of": "2026-03-02"}]:
+            with self.subTest(change=change), self.assertRaises(ValidationError):
+                upgrade(*args, **{**options, **change})
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [entry])

