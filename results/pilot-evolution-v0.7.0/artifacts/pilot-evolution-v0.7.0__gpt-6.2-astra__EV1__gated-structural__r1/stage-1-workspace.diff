+import unittest
+
+from ev1_order_ledger import OrderService, Plan, ValidationError
+
+
+class SubscriptionUpgradeTests(unittest.TestCase):
+    def setUp(self):
+        self.service = OrderService()
+        self.service.register_plan(Plan("basic", "Basic", 100))
+        self.service.register_plan(Plan("plus", "Plus", 109, tax_bps=1000))
+        self.service.register_plan(Plan("pro", "Pro", 200))
+        self.sub = self.service.start_subscription("account", "basic")
+        self.sub_id = self.sub.subscription_id
+
+    def test_half_up_proration_then_tax(self):
+        entry = self.service.upgrade_subscription(self.sub_id, "plus", 1, 2, idempotency_key="first")
+        # Half of the 9-cent difference rounds to 5. Tax on 5 cents rounds to 1.
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (5, 1, 6))
+        self.assertEqual((entry.kind, entry.reference_id, entry.account_id),
+                         ("plan_upgrade", self.sub_id, "account"))
+        self.assertEqual(self.sub.plan_id, "plus")
+        self.assertEqual(self.service.get_statement("account"),
+                         {"account_id": "account", "entry_count": 1, "balance_cents": 6})
+
+    def test_cycle_endpoints(self):
+        zero = self.service.upgrade_subscription(self.sub_id, "plus", 0, 31, idempotency_key="zero")
+        full = self.service.upgrade_subscription(self.sub_id, "pro", 31, 31, idempotency_key="full")
+        self.assertEqual(zero.total_cents, 0)
+        self.assertEqual(full.subtotal_cents, 91)
+
+    def test_proration_above_float_precision(self):
+        difference = 2**55 + 1
+        self.service.register_plan(Plan("large", "Large", 100 + difference))
+        entry = self.service.upgrade_subscription(self.sub_id, "large", 1, 2, idempotency_key="large")
+        self.assertEqual(entry.subtotal_cents, 2**54 + 1)
+
+    def test_validation_preserves_state_and_key(self):
+        self.service.register_plan(Plan("peer", "Peer", 100))
+        self.service.register_plan(Plan("free", "Free", 0))
+        for sub_id, plan_id, days, cycle, key in [
+            ("missing", "plus", 1, 2, "key"),
+            (self.sub_id, "missing", 1, 2, "key"),
+            (self.sub_id, "peer", 1, 2, "key"),
+            (self.sub_id, "free", 1, 2, "key"),
+            (self.sub_id, "plus", 0, 0, "key"),
+            (self.sub_id, "plus", 0, -1, "key"),
+            (self.sub_id, "plus", -1, 2, "key"),
+            (self.sub_id, "plus", 3, 2, "key"),
+            (self.sub_id, "plus", 1, 2, ""),
+            (self.sub_id, "plus", 1, 2, "  "),
+            (self.sub_id, "plus", 1, 2, True),
+        ]:
+            with self.subTest(args=(sub_id, plan_id, days, cycle, key)):
+                with self.assertRaises(ValidationError):
+                    self.service.upgrade_subscription(sub_id, plan_id, days, cycle, idempotency_key=key)
+                self.assertEqual(self.sub.plan_id, "basic")
+                self.assertEqual(self.service.ledger.entries_for_account("account"), [])
+        self.service.upgrade_subscription(self.sub_id, "plus", 1, 2, idempotency_key="key")
+
+    def test_replay_after_later_upgrade_through_shared_ledger(self):
+        original = self.service.upgrade_subscription(self.sub_id, "plus", 1, 2, idempotency_key="first")
+        later = self.service.upgrade_subscription(self.sub_id, "pro", 1, 2, idempotency_key="second")
+        retry = OrderService(self.service.ledger)
+        self.assertIs(retry.upgrade_subscription(self.sub_id, "plus", 1, 2, idempotency_key="first"),
+                      original)
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertEqual(retry.ledger.entries_for_account("account"), [original, later])
+
+    def test_key_conflicts_and_boolean_replays(self):
+        other = self.service.start_subscription("other", "basic")
+        original = self.service.upgrade_subscription(self.sub_id, "plus", 1, 1, idempotency_key="key")
+        for args in [
+            (other.subscription_id, "plus", 1, 1),
+            (self.sub_id, "pro", 1, 1),
+            (self.sub_id, "plus", 0, 1),
+            (self.sub_id, "plus", 1, 2),
+            (self.sub_id, "plus", True, 1),
+            (self.sub_id, "plus", 1, True),
+        ]:
+            with self.subTest(args=args), self.assertRaises(ValidationError):
+                self.service.upgrade_subscription(*args, idempotency_key="key")
+        self.assertEqual(self.sub.plan_id, "plus")
+        self.assertEqual(other.plan_id, "basic")
+        self.assertEqual(self.service.ledger.entries_for_account("account"), [original])
+        self.assertEqual(self.service.ledger.entries_for_account("other"), [])
