t_off_cents, \"amount_off_cents\")\n    validate_non_negative_int(promo.min_subtotal_cents, \"min_subtotal_cents\")\n    if promo.expires_on is not None:\n        validate_date(promo.expires_on)\n\n\ndef calculate_charge_totals(\n    subtotal: int, tax_bps: int, promo: Promo | None, as_of: str | None,\n) -> Tuple[int, int, int]:\n    \"\"\"Return discounted subtotal, tax, and total in cents.\"\"\"\n    if as_of is not None:\n        validate_date(as_of)\n    if promo is not None:\n        if subtotal < promo.min_subtotal_cents:\n            raise ValidationError(\"subtotal is below the promo minimum\")\n        if promo.expires_on is not None and (as_of is None or as_of > promo.expires_on):\n            raise ValidationError(\"expiring promo requires as_of on or before its expiry\")\n        if promo.percent_off is not None:\n            discount = round_half_up_div(subtotal * promo.percent_off, 100)\n        else:\n            discount = promo.amount_off_cents\n        subtotal = max(0, subtotal - discount)\n    tax = compute_tax_cents(subtotal, tax_bps)\n    return subtotal, tax, subtotal + tax\n\n\ndef compute_upgrade_subtotal_cents(\n    old_plan: Plan, new_plan: Plan, days_remaining: int, cycle_days: int,\n) -> int:\n'\"'''+s[b:]\ns=s[:s.index('    subtotal = round_half_up_div(difference')]+'    return round_half_up_div(difference * days_remaining, cycle_days)\\\\n'\np.write_text(s)\np=Path('api.py')\ns=p.read_text().replace('Order, Plan, Subscription','Order, Plan, Promo, Subscription').replace('import calculate_order_totals','import calculate_charge_totals, compute_subtotal_cents')\ns=s.replace('    def place_order(','''    def register_promo(\n        self,\n        code: str,\n        *,\n        percent_off: int | None = None,\n        amount_off_cents: int | None = None,\n        expires_on: str | None = None,\n        min_subtotal_cents: int = 0,\n    ) -> None:\n        self.ledger.add_promo(Promo(code, percent_off, amount_off_cents, expires_on, min_subtotal_cents))\n\n    def place_order(''')\nparams='        promo_code: str | None = None,\\\\n        as_of: str | None = None,\\\\n'\ns=s.replace('    ) -> Order:',params+'    ) -> Order:').replace('    ) -> LedgerEntry:',params+'    ) -> LedgerEntry:').replace('            idempotency_key=idempotency_key,','            idempotency_key=idempotency_key, promo_code=promo_code, as_of=as_of,')\ns=s.replace('''        subtotal, tax, total = calculate_order_totals(\n            items,\n            tax_bps=tax_bps,\n            legacy_flat_fee=legacy_flat_fee,''','''        gross = compute_subtotal_cents(items, legacy_flat_fee=legacy_flat_fee)\n        subtotal, tax, total = calculate_charge_totals(\n            gross, tax_bps, self.ledger.get_promo(promo_code), as_of,''').replace('            items=tuple(items),','            items=tuple(items),\\\\n            discount_cents=gross - subtotal,\\\\n            promo_code=promo_code,')\np.write_text(s)\np=Path('ledger.py')\ns=p.read_text().replace('Order, Plan, Subscription','Order, Plan, Promo, Subscription').replace('from .pricing import calculate_upgrade_totals, validate_non_negative_int, validate_positive_int','''from .pricing import (\n    calculate_charge_totals, compute_upgrade_subtotal_cents, validate_non_negative_int,\n    validate_positive_int, validate_promo,\n)''')\ns=s.replace('        self._orders:', '        self._promos: Dict[str, Promo] = {}\\\\n        self._orders:').replace('tuple[str, str, int, int]', 'tuple[str, str, int, int, str | None, str | None]')\ns=s.replace('    def get_plan(','''    def add_promo(self, promo: Promo) -> None:\n        validate_promo(promo)\n        self._promos[promo.code] = promo\n\n    def get_promo(self, code: str | None) -> Promo | None:\n        if code is None:\n            return None\n        if not isinstance(code, str) or code not in self._promos:\n            raise ValidationError(f\\\"Unknown promo code: {code}\\\")\n        return self._promos[code]\n\n    def get