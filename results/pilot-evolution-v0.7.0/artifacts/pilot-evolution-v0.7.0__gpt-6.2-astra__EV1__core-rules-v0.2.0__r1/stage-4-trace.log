ALF\\\", legacy_flat_fee=True)','self.order(601, \\\"HALF\\\")'))\nPY\ncat > tests/test_audit.py <<'PY'\nimport unittest\nfrom unittest.mock import Mock\n\nfrom ev1_order_ledger import LineItem, OrderService, Plan, ValidationError\n\n\nclass AuditTests(unittest.TestCase):\n    def setUp(self):\n        self.events = []\n        self.sink = Mock(side_effect=self.events.append)\n        self.service = OrderService(audit_sink=self.sink)\n        self.service.register_plan(Plan(\\\"base\\\", \\\"Base\\\", 100))\n        self.service.register_plan(Plan(\\\"pro\\\", \\\"Pro\\\", 300))\n        self.sub = self.service.start_subscription(\\\"acct\\\", \\\"base\\\")\n\n    def order(self):\n        return self.service.place_order(\\\"acct\\\", [LineItem(\\\"item\\\", 200, 1)], tax_bps=1000)\n\n    def upgrade(self):\n        return self.service.upgrade_subscription(\n            self.sub.subscription_id, \\\"pro\\\", 1, 2, idempotency_key=\\\"upgrade\\\"\n        )\n\n    def refund(self, order):\n        return self.service.refund_order(order.order_id, 220, reason=\\\"return\\\", idempotency_key=\\\"refund\\\")\n\n    def test_audits_each_new_entry_once_with_signed_amount(self):\n        order = self.order()\n        charge, = self.service.ledger.entries_for_account(\\\"acct\\\")\n        upgrade = self.upgrade()\n        refund = self.refund(order)\n        self.assertIs(self.upgrade(), upgrade)\n        self.assertIs(self.refund(order), refund)\n        self.assertEqual(self.events, [\n            {\\\"action\\\": \\\"order_charge\\\", \\\"account_id\\\": \\\"acct\\\", \\\"amount_cents\\\": 220, \\\"entry_id\\\": charge.entry_id},\n            {\\\"action\\\": \\\"plan_upgrade\\\", \\\"account_id\\\": \\\"acct\\\", \\\"amount_cents\\\": 100, \\\"entry_id\\\": upgrade.entry_id},\n            {\\\"action\\\": \\\"order_refund\\\", \\\"account_id\\\": \\\"acct\\\", \\\"amount_cents\\\": -220, \\\"entry_id\\\": refund.entry_id},\n        ])\n\n    def test_sink_error_prevents