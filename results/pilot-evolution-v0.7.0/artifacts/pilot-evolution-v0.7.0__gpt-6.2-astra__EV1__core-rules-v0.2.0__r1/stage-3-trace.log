{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cat > benchmarks/sources/ev1_order_ledger/tests/test_refunds.py <<'PY'\nimport unittest\n\nfrom ev1_order_ledger import LineItem, OrderService, ValidationError\n\n\nclass RefundTests(unittest.TestCase):\n    def setUp(self):\n        self.service = OrderService()\n        self.order = self.service.place_order(\\\"acct\\\", [LineItem(\\\"item\\\", 6, 1)], tax_bps=3333)\n\n    def refund(self, amount, key=\\\"key\\\", reason=\\\"returned\\\"):\n        return self.service.refund_order(\n            self.order.order_id, amount, reason=reason, idempotency_key=key\n        )\n\n    def test_every_partition_reverses_discounted_charge_exactly(self):\n        # Every subset of the seven internal penny boundaries partitions an 8-cent order.\n        for cuts in range(128):\n            with self.subTest(cuts=cuts):\n                service = OrderService()\n                service.register_promo(\\\"OFF\\\", amount_off_cents=4)\n                order = service.place_order(\\\"acct\\\", [LineItem(\\\"item\\\", 10, 1)],\n                                            tax_bps=3333, promo_code=\\\"OFF\\\")\n                refunded = tax = subtotal = 0\n                for end in range(1, 9):\n                    if end \"'!= 8 and not cuts & (1 << (end - 1)):\n                        continue\n                    amount = end - refunded\n                    entry = service.refund_order(order.order_id, amount, reason=\"return\",\n                                                 idempotency_key=str(end))\n                    self.assertEqual(entry.total_cents, -amount)\n                    self.assertEqual(entry.subtotal_cents + entry.tax_cents, -amount)\n                    tax -= entry.tax_cents\n                    subtotal -= entry.subtotal_cents\n                    refunded = end\n                    # The order has one cent of tax per four cents charged, half-up.\n                    self.assertEqual(tax, (end + 2) // 4)\n                self.assertEqual((subtotal, tax), (order.subtotal_cents, order.tax_cents))\n                self.assertEqual(service.get_statement(\"acct\")[\"balance_cents\"], 0)\n\n    def test_over_refund_does_not_consume_key_or_remaining_balance(self):\n        self.refund(3)\n        with self.assertRaises(ValidationError):\n            self.refund(6, \"last\")\n        self.refund(5, \"last\")\n        with self.assertRaises(ValidationError):\n            self.refund(1, \"extra\")\n        self.assertEqual(self.service.get_statement(\"acct\")[\"entry_count\"], 3)\n\n    def test_replay_and_conflicts_across_services(self):\n        original = self.refund(1)\n        self.refund(7, \"last\")\n        shared = OrderService(self.service.ledger)\n        other = shared.place_order(\"acct\", [LineItem(\"other\", 1, 1)])\n        for order_id, amount, reason in (\n            (other.order_id, 1, \"returned\"), (self.order.order_id, 2, \"returned\"),\n            (self.order.order_id, 1, \"other\"), (self.order.order_id, True, \"returned\"),\n        ):\n            with self.subTest(order_id=order_id, amount=amount, reason=reason):\n                with self.assertRaises(ValidationError):\n                    shared.refund_order(order_id, amount, reason=reason, idempotency_key=\"key\")\n        self.assertIs(shared.refund_order(self.order.order_id, 1, reason=\"returned\",\n                                          idempotency_key=\"key\"), original)\n        self.assertEqual(shared.get_statement(\"acct\")[\"entry_count\"], 4)\n        # Refunding the first order did not use up this second order'\"'s balance.\n        shared.refund_order(other.order_id, 1, reason=\\\"other\\\", idempotency_key=\\\"other\\\")\n        self.assertEqual(shared.get_statement(\\\"acct\\\")[\\\"balance_cents\\\"], 0)\n\n    def test_credit_note_uses_the_individual_refund(self):\n        charge, = self.service.ledger.entries_for_account(\\\"acct\\\")\n        self.refund(1)\n        entry = self.refund(3, \\\"second\\\", \\\"damaged\\\")\n        self.assertEqual(entry.kind, \\\"order_refund\\\")\n        self.assertEqual(self.service.export_credit_note(entry.entry_id), {\n            \\\"entry_id\\\": entry.entry_id, \\\"order_id\\\": self.order.order_id, \\\"account_id\\\": \\\"acct\\\",\n            \\\"subtotal_cents\\\": 2, \\\"tax_cents\\\": 1, \\\"total_cents\\\": 3, \\\"reason\\\": \\\"damaged\\\",\n        })\n        for entry_id in (\\\"missing\\\", charge.entry_id):\n            with self.subTest(entry_id=entry_id), self.assertRaises(ValidationError):\n                self.service.export_credit_note(entry_id)\n\n    def test_invalid_requests_leave_charge_intact(self):\n        for amount in (True, 0, -1, 1.5):\n            with self.subTest(amount=amount), self.assertRaises(ValidationError):\n                self.refund(amount)\n        for reason, key in ((\\\"\\\", \\\"k\\\"), (\\\" \\\", \\\"k\\\"), (None, \\\"k\\\"), (\\\"return\\\", \\\" \\\"), (\\\"return\\\", None)):\n            with self.subTest(reason=reason, key=key), self.assertRaises(ValidationError):\n                self.refund(1, key, reason)\n        with self.assertRaises(ValidationError):\n            self.service.refund_order(\\\"missing\\\", 1, reason=\\\"return\\\", idempotency_key=\\\"key\\\")\n        self.assertEqual(self.service.get_statement(\\\"acct\\\")[\\\"entry_count\\\"], 1)\n        self.refund(self.order.total_cents)\nPY\npython3 benchmarks/sources/ev1_order_ledger/run_checks.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
