lan, Promo, Subscription').replace('from .pricing import calculate_upgrade_totals, validate_non_negative_int, validate_positive_int','''from .pricing import (\n    calculate_upgrade_totals, validate_non_negative_int, validate_positive_int,\n    validate_promo, validate_promo_code,\n)''').replace('        self._plans:', '        self._promos: dict[str, Promo] = {}\\\\n        self._plans:').replace('tuple[str, str, int, int]', 'tuple[str, str, int, int, str | None, str | None]').replace('    def add_plan(', '''    def add_promo(self, promo: Promo) -> None:\n        validate_promo(promo)\n        self._promos[promo.code] = promo\n\n    def get_promo(self, code: str | None) -> Promo | None:\n        if code is None:\n            return None\n        validate_promo_code(code)\n        if code not in self._promos:\n            raise ValidationError(f\\\"Unknown promo code: {code}\\\")\n        return self._promos[code]\n\n    def add_plan(''')\ns=s.replace('        idempotency_key: str,','        idempotency_key: str,\\\\n        promo_code: str | None = None,\\\\n        as_of: str | None = None,').replace('new_plan_id, days_remaining, cycle_days)','new_plan_id, days_remaining, cycle_days, promo_code, as_of)').replace('days_remaining, cycle_days\\\\n            )','days_remaining, cycle_days,\\\\n                promo=self.get_promo(promo_code), as_of=as_of,\\\\n            )')\np.write_text(s)\np=Path('api.py')\ns=p.read_text().replace('Order, Plan, Subscription','Order, Plan, Promo, Subscription').replace('from .pricing import calculate_order_totals','from .pricing import calculate_charge, compute_subtotal_cents').replace('    def place_order(', '''    def register_promo(\n        self,\n        code: str,\n        *,\n        percent_off: int | None = None,\n        amount_off_cents: int | None = None,\n        expires_on: str | None = None,\n        min_subtotal_cents: int = 0,\n    ) -> None:\n        self.ledger.add_promo(Promo(code, percent_off, amount_off_cents, expires_on, min_subtotal_cents))\n\n    def place_order(''')\nfor marker in ['legacy_flat_fee: bool = False,', 'idempotency_key: str,']:\n    s=s.replace('        '+marker,'        '+marker+'\\\\n        promo_code: str | None = None,\\\\n        as_of: str | None = None,')\ns=s.replace('subtotal, tax, total = calculate_order_totals(\\\\n            items,\\\\n            tax_bps=tax_bps,\\\\n            legacy_flat_fee=legacy_flat_fee,','gross = compute_subtotal_cents(items, legacy_flat_fee=legacy_flat_fee)\\\\n        subtotal, tax, total = calculate_charge(\\\\n            gross, tax_bps, self.ledger.get_promo(promo_code), as_of,').replace('            items=tuple(items),','            items=tuple(items),\\\\n            discount_cents=gross - subtotal,\\\\n            promo_code=promo_code,').replace('            idempotency_key=idempotency_key,','            idempotency_key=idempotency_key, promo_code=promo_code, as_of=as_of,')\np.write_text(s)\nPY\ncat pricing.py\"","aggregated_output":"\"\"\"Canonical integer-cent pricing calculations for EV1 order ledger.\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import date\nfrom typing import Sequence, Tuple\n\nfrom .models import LineItem, Plan, Promo, ValidationError\n\n\nLEGACY_FLAT_FEE_CENTS = 500\n\n\ndef validate_non_negative_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value < 0:\n        raise ValidationError(f\"{field_name} must be a non-negative integer\")\n    return value\n\n\ndef validate_positive_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:\n        raise ValidationError(f\"{field_name} must be a positive integer\")\n    return value\n\n\ndef round_half_up_div(numerator: int, denominator: int) -> int:\n    \"\"\"Exact integer half-up division for non-negative numerator and positive denominator.\"\"\"\n    validate_non_negative_int(numerator, \"numerator\")\n    validate_positive_int(denominator, \"denominator\")\n    return (numerator * 2 + denominator) // (2 * denominator)\n\n\ndef compute_subtotal_cents(items: Sequence[LineItem], *, legacy_flat_fee: bool = False) -> int:\n    if not items:\n        raise ValidationError(\"items must be non-empty\")\n    subtotal = LEGACY_FLAT_FEE_CENTS if legacy_flat_fee else 0\n    for item in items:\n        validate_positive_int(item.unit_cents, \"unit_cents\")\n        validate_positive_int(item.quantity, \"quantity\")\n        subtotal += item.unit_cents * item.quantity\n    return subtotal\n\n\ndef compute_tax_cents(taxable_cents: int, tax_bps: int) -> int:\n    validate_non_negative_int(taxable_cents, \"taxable_cents\")\n    validate_non_negative_int(tax_bps, \"tax_bps\")\n    if tax_bps > 10_000:\n        raise ValidationError(\"tax_bps cannot exceed 10000\")\n    return round_half_up_div(taxable_cents * tax_bps, 10_000)\n\n\ndef validate_date(value: str | None, field_name: str) -> None:\n    if value is None:\n        return\n    if isinstance(value, str):\n        try:\n            if date.fromisoformat(value).isoformat() == value:\n                return\n        except ValueError:\n            pass\n    raise ValidationError(f\"{field_name} must be a YYYY-MM-DD date\")\n\n\ndef validate_promo_code(code: str) -> None:\n    if not isinstance(code, str) or not code.strip() or \",\" in code:\n        raise ValidationError(\"expected a single non-empty promo code\")\n\n\ndef validate_promo(promo: Promo) -> None:\n    validate_promo_code(promo.code)\n    validate_date(promo.expires_on, \"expires_on\")\n    validate_non_negative_int(promo.min_subtotal_cents, \"min_subtotal_cents\")\n    if (promo.percent_off is None) == (promo.amount_off_cents is None):\n        raise ValidationError(\"specify exactly one discount\")\n    if promo.percent_off is not None:\n        validate_positive_int(promo.percent_off, \"percent_off\")\n        if promo.percent_off > 100:\n            raise ValidationError(\"percent_off cannot exceed 100\")\n    else:\n        validate_positive_int(promo.amount_off_cents, \"amount_off_cents\")\n\n\ndef calculate_charge(\n    subtotal: int, tax_bps: int, promo: Promo | None = None, as_of: str | None = None\n) -> Tuple[int, int, int]:\n    \"\"\"Return the discounted subtotal, tax, and total in cents.\"\"\"\n    validate_date(as_of, \"as_of\")\n    if promo is not None:\n        if subtotal < promo.min_subtotal_cents:\n            raise ValidationError(\"subtotal is below the promo minimum\")\n        if promo.expires_on is not None and (as_of is None or as_of > promo.expires_on):\n            raise ValidationError(\"promo requires an as_of date on or before expiry\")\n        if promo.percent_off is not None:\n            discount = round_half_up_div(subtotal * promo.percent_off, 100)\n        else:\n            discount = promo.amount_off_cents\n        subtotal = max(0, subtotal - discount)\n    tax = compute_tax_cents(subtotal, tax_bps)\n    return subtotal, tax, subtotal + tax\n\n\ndef calculate_order_totals(\n    items: Sequence[LineItem],\n    *,\n    tax_bps: int = 0,\n    legacy_flat_fee: bool = False,\n) -> Tuple[int, int, int]:\n    \"\"\"Return (subtotal_cents, tax_cents, total_cents) using exact integer cents.\"\"\"\n    subtotal = compute_subtotal_cents(items, legacy_flat_fee=legacy_flat_fee)\n    return calculate_charge(subtotal, tax_bps)\n\n\ndef calculate_upgrade_totals(\n    old_plan: Plan, new_plan: Plan, days_remaining: int, cycle_days: int,\n    *, promo: Promo | None = None, as_of: str | None = None,\n) -> Tuple[int, int, int]:\n    difference = new_plan.monthly_cents - old_plan.monthly_cents\n    if difference <= 0:\n        raise ValidationError(\"new plan must have a higher monthly price\")\n    subtotal = round_half_up_div(difference * days_remaining, cycle_days)\n    return calculate_charge(subtotal, new_plan.tax_bps, promo, as_of)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cat > benchmarks/sources/ev1_order_ledger/tests/test_promos.py <<'PY'\nimport unittest\n\nfrom ev1_order_ledger import LineItem, OrderService, Plan, ValidationError\n\n\nclass PromoTests(unittest.TestCase):\n    def setUp(self):\n        self.service = OrderService()\n\n    def order(self, cents, code, **kwargs):\n        return self.service.place_order(\n            \\\"acct\\\", [LineItem(\\\"item\\\", cents, 1)], tax_bps=1000, promo_code=code, **kwargs\n        )\n\n    def test_percentage_discount_includes_fee_and_rounds_half_up(self):\n        self.service.register_promo(\\\"HALF\\\", percent_off=50, min_subtotal_cents=601)\n        order = self.order(101, \\\"HALF\\\", legacy_flat_fee=True)\n        self.assertEqual(order.promo_code, \\\"HALF\\\")\n        self.assertEqual(order.discount_cents, 301)\n        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (300, 30, 330))\n        entry, = self.service.ledger.entries_for_account(\\\"acct\\\")\n        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (300, 30, 330))\n\n    def test_fixed_discount_is_capped_at_subtotal(self):\n        self.service.register_promo(\\\"FIXED\\\", amount_off_cents=120)\n        order = self.order(100, \\\"FIXED\\\")\n        self.assertEqual(order.discount_cents, 100)\n        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (0, 0, 0))\n\n    def test_registration_validation(self):\n        for kwargs in (\n            {}, {\\\"percent_off\\\": 10, \\\"amount_off_cents\\\": 1}, {\\\"percent_off\\\": 0},\n            {\\\"percent_off\\\": 101}, {\\\"percent_off\\\": True}, {\\\"percent_off\\\": 2.5},\n            {\\\"amount_off_cents\\\": 0}, {\\\"amount_off_cents\\\": False},\n            {\\\"percent_off\\\": 1, \\\"min_subtotal_cents\\\": -1},\n            {\\\"percent_off\\\": 1, \\\"min_subtotal_cents\\\": True},\n            {\\\"percent_off\\\": 1, \\\"expires_on\\\": \\\"2025-02-29\\\"},\n        ):\n            with self.subTest(kwargs=kwargs), self.assertRaises(ValidationError):\n                self.service.register_promo(\\\"BAD\\\", **kwargs)\n        for code in (\\\"\\\", \\\" \\\", None, \\\"A,B\\\"):\n            with self.subTest(code=code), self.assertRaises(ValidationError):\n                self.service.register_promo(code, percent_off=100)\n        with self.assertRaises(ValidationError):\n            self.order(100, \\\"BAD\\\")\n\n    def test_expiry_stacking_and_minimum_fail_closed(self):\n        self.service.register_promo(\\\"A\\\", percent_off=100, expires_on=\\\"2024-02-29\\\", min_subtotal_cents=100)\n        self.service.register_promo(\\\"B\\\", amount_off_cents=1)\n        for cents, code, as_of in (\n            (100, \\\"A\\\", None), (100, \\\"A\\\", \\\"2024-03-01\\\"), (100, \\\"A\\\", \\\"20240228\\\"),\n            (100, \\\"A\\\", \\\"2024-02-30\\\"), (99, \\\"A\\\", \\\"2024-02-28\\\"),\n            (100, \\\"UNKNOWN\\\", None), (100, \\\"A,B\\\", \\\"2024-02-28\\\"), (100, \\\"\\\", None),\n        ):\n            with self.subTest(cents=cents, code=code, as_of=as_of), self.assertRaises(ValidationError):\n                self.order(cents, code, as_of=as_of)\n        self.assertEqual(self.service.ledger.entries_for_account(\\\"acct\\\"), [])\n        self.assertEqual(self.order(100, \\\"A\\\", as_of=\\\"2024-02-29\\\").discount_cents, 100)\n\n    def test_upgrade_prorates_before_discount_and_replays_with_promo_arguments(self):\n        self.service.register_plan(Plan(\\\"base\\\", \\\"Base\\\", 100))\n        self.service.register_plan(Plan(\\\"pro\\\", \\\"Pro\\\", 301, tax_bps=1000))\n        sub = self.service.start_subscription(\\\"acct\\\", \\\"base\\\")\n        self.service.register_promo(\\\"SAVE\\\", amount_off_cents=25, min_subtotal_cents=101,\n                                    expires_on=\\\"2024-05-01\\\")\n        shared = OrderService(self.service.ledger)\n\n        def upgrade(code, as_of, days=1):\n            return shared.upgrade_subscription(\n                sub.subscription_id, \\\"pro\\\", days, 2, idempotency_key=\\\"key\\\",\n                promo_code=code, as_of=as_of,\n            )\n\n        for code, as_of, days in (\n            (\\\"SAVE\\\", \\\"2024-05-02\\\", 1), (\\\"SAVE\\\", None, 1), (\\\"SAVE\\\", \\\"2024-05-01\\\", 0),\n            (\\\"UNKNOWN\\\", None, 1), (\\\"SAVE,SAVE\\\", \\\"2024-05-01\\\", 1),\n        ):\n            with self.subTest(code=code, as_of=as_of, days=days), self.assertRaises(ValidationError):\n                upgrade(code, as_of, days)\n        self.assertEqual(sub.plan_id, \\\"base\\\")\n        self.assertEqual(shared.ledger.entries_for_account(\\\"acct\\\"), [])\n        entry = upgrade(\\\"SAVE\\\", \\\"2024-05-01\\\")\n        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (76, 8, 84))\n        self.assertEqual(sub.plan_id, \\\"pro\\\")\n        self.assertIs(upgrade(\\\"SAVE\\\", \\\"2024-05-01\\\"), entry)\n        for code, as_of in ((None, \\\"2024-05-01\\\"), (\\\"SAVE\\\", \\\"2024-04-30\\\")):\n            with self.subTest(code=code, as_of=as_of), self.assertRaises(ValidationError):\n                upgrade(code, as_of)\n        self.assertEqual(shared.ledger.entries_for_account(\\\"acct\\\"), [entry])\nPY\npython3 benchmarks/sources/ev1_order_ledger/run_checks.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
