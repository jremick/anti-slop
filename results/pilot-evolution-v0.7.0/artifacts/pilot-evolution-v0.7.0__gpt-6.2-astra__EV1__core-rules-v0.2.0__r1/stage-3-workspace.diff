+import unittest
+
+from ev1_order_ledger import OrderService, Plan, ValidationError
+
+
+class UpgradeTests(unittest.TestCase):
+    def setUp(self):
+        self.service = OrderService()
+        self.service.register_plan(Plan("base", "Base", 100))
+        self.service.register_plan(Plan("pro", "Pro", 105, tax_bps=5000))
+        self.service.register_plan(Plan("max", "Max", 200))
+        self.sub = self.service.start_subscription("acct", "base")
+
+    def upgrade(self, days=1, cycle=2, plan="pro", key="key"):
+        return self.service.upgrade_subscription(
+            self.sub.subscription_id, plan, days, cycle, idempotency_key=key
+        )
+
+    def test_half_up_proration_then_half_up_tax(self):
+        entry = self.upgrade()
+        # Half of the 5-cent difference rounds to 3, then 50% tax rounds to 2.
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (3, 2, 5))
+        self.assertEqual((entry.kind, entry.reference_id), ("plan_upgrade", self.sub.subscription_id))
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [entry])
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], 5)
+
+    def test_zero_and_full_cycle(self):
+        entry = self.upgrade(days=0)
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (0, 0, 0))
+        self.assertEqual(self.sub.plan_id, "pro")
+        full = self.upgrade(days=2, plan="max", key="full")
+        self.assertEqual(full.subtotal_cents, 95)
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [entry, full])
+
+    def test_proration_is_exact_above_float_precision(self):
+        delta = 2**55 + 1
+        self.service.register_plan(Plan("large", "Large", 100 + delta))
+        self.assertEqual(self.upgrade(plan="large").subtotal_cents, 2**54 + 1)
+
+    def test_invalid_inputs_leave_subscription_ledger_and_key_available(self):
+        self.service.register_plan(Plan("equal", "Equal", 100))
+        self.service.register_plan(Plan("lower", "Lower", 99))
+        self.service.register_plan(Plan("bad_tax", "Bad tax", 110, tax_bps=True))
+        for kwargs in (
+            {"days": -1}, {"cycle": 0}, {"cycle": -1}, {"days": 3},
+            {"days": True}, {"cycle": False}, {"days": 1.0}, {"cycle": 2.0},
+            {"plan": "base"}, {"plan": "equal"}, {"plan": "lower"},
+            {"plan": "missing"}, {"plan": True}, {"plan": "bad_tax"},
+            {"key": ""}, {"key": "  "}, {"key": False},
+        ):
+            with self.subTest(kwargs=kwargs), self.assertRaises(ValidationError):
+                self.upgrade(**kwargs)
+        for unknown in ("missing", True):
+            with self.subTest(subscription=unknown), self.assertRaises(ValidationError):
+                self.service.upgrade_subscription(unknown, "pro", 1, 2, idempotency_key="key")
+        self.assertEqual(self.sub.plan_id, "base")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [])
+        self.assertEqual(self.upgrade().total_cents, 5)
+
+    def test_replay_returns_original_entry_after_later_upgrade(self):
+        original = self.upgrade()
+        later = self.upgrade(plan="max", key="next")
+        shared = OrderService(self.service.ledger)
+        replay = shared.upgrade_subscription(
+            self.sub.subscription_id, "pro", 1, 2, idempotency_key="key"
+        )
+        self.assertIs(replay, original)
+        self.assertEqual(self.sub.plan_id, "max")
+        self.assertEqual(shared.ledger.entries_for_account("acct"), [original, later])
+
+    def test_key_conflicts_check_every_argument_and_preserve_original(self):
+        other = self.service.start_subscription("other", "base")
+        original = self.upgrade(cycle=1)
+        sid = self.sub.subscription_id
+        for args in (
+            (other.subscription_id, "pro", 1, 1), (sid, "max", 1, 1),
+            (sid, "pro", 0, 1), (sid, "pro", 1, 2),
+            (sid, "pro", True, 1), (sid, "pro", 1, True),
+        ):
+            with self.subTest(args=args), self.assertRaises(ValidationError):
+                self.service.upgrade_subscription(*args, idempotency_key="key")
+        self.assertIs(self.upgrade(cycle=1), original)
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertEqual(other.plan_id, "base")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [original])
+        self.assertEqual(self.service.ledger.entries_for_account("other"), [])
