+    def test_every_partition_reverses_discounted_charge_exactly(self):
+        # Every subset of the seven internal penny boundaries partitions an 8-cent order.
+        for cuts in range(128):
+            with self.subTest(cuts=cuts):
+                service = OrderService()
+                service.register_promo("OFF", amount_off_cents=4)
+                order = service.place_order("acct", [LineItem("item", 10, 1)],
+                                            tax_bps=3333, promo_code="OFF")
+                refunded = tax = subtotal = 0
+                for end in range(1, 9):
+                    if end != 8 and not cuts & (1 << (end - 1)):
+                        continue
+                    amount = end - refunded
+                    entry = service.refund_order(order.order_id, amount, reason="return",
+                                                 idempotency_key=str(end))
+                    self.assertEqual(entry.total_cents, -amount)
+                    self.assertEqual(entry.subtotal_cents + entry.tax_cents, -amount)
+                    tax -= entry.tax_cents
+                    subtotal -= entry.subtotal_cents
+                    refunded = end
+                    # The order has one cent of tax per four cents charged, half-up.
+                    self.assertEqual(tax, (end + 2) // 4)
+                self.assertEqual((subtotal, tax), (order.subtotal_cents, order.tax_cents))
+                self.assertEqual(service.get_statement("acct")["balance_cents"], 0)
+
+    def test_over_refund_does_not_consume_key_or_remaining_balance(self):
