+        other = shared.place_order("acct", [LineItem("other", 1, 1)])
+        for order_id, amount, reason in (
+            (other.order_id, 1, "returned"), (self.order.order_id, 2, "returned"),
+            (self.order.order_id, 1, "other"), (self.order.order_id, True, "returned"),
+        ):
+            with self.subTest(order_id=order_id, amount=amount, reason=reason):
+                with self.assertRaises(ValidationError):
