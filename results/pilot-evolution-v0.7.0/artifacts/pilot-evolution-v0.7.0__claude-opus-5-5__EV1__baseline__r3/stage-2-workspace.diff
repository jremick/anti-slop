+
+    def test_rejects_non_upgrades(self) -> None:
+        self.assert_rejected(self.sub.subscription_id, "starter", 10, 30)  # same plan
+        self.svc.register_plan(Plan(plan_id="free", name="Free", monthly_cents=0))
+        self.assert_rejected(self.sub.subscription_id, "free", 10, 30)  # downgrade
+        self.svc.register_plan(Plan(plan_id="starter_alt", name="Alt", monthly_cents=1000))
+        self.assert_rejected(self.sub.subscription_id, "starter_alt", 10, 30)  # equal price
+
+    def test_rejects_invalid_bounds(self) -> None:
+        sid = self.sub.subscription_id
+        self.assert_rejected(sid, "pro", 10, 0)
+        self.assert_rejected(sid, "pro", 0, -30)
+        self.assert_rejected(sid, "pro", -1, 30)
+        self.assert_rejected(sid, "pro", 31, 30)
+
+    def test_rejects_booleans_and_non_ints(self) -> None:
+        sid = self.sub.subscription_id
+        self.assert_rejected(sid, "pro", True, 30)
+        self.assert_rejected(sid, "pro", 1, True)
+        self.assert_rejected(sid, "pro", 10.0, 30)
+        self.assert_rejected(sid, "pro", 10, "30")
+
+    def test_rejects_empty_or_invalid_idempotency_key(self) -> None:
+        sid = self.sub.subscription_id
+        self.assert_rejected(sid, "pro", 10, 30, idempotency_key="")
