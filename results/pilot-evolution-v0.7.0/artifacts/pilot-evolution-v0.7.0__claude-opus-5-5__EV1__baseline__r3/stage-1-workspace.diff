+"""Turn 1: mid-cycle prorated plan upgrades with idempotency."""
+
+from __future__ import annotations
+
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import Plan, ValidationError
+from ev1_order_ledger.pricing import compute_upgrade_proration
+
+
+STARTER = Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=825)
+PRO = Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825)
+# 1001 - 1000 = 1 cent difference: lets us hit exact .5 boundaries.
+STARTER_PLUS = Plan(plan_id="starter_plus", name="Starter+", monthly_cents=1001, tax_bps=0)
+ENTERPRISE = Plan(plan_id="enterprise", name="Enterprise", monthly_cents=10000, tax_bps=1000)
+
+
+class ProrationPricingTests(unittest.TestCase):
+    def test_exact_division(self) -> None:
+        # 2000 * 15 / 30 = 1000; tax 1000 * 825 / 10000 = 82.5 -> 83
+        self.assertEqual(compute_upgrade_proration(STARTER, PRO, 15, 30), (1000, 83, 1083))
+
+    def test_half_rounds_up(self) -> None:
+        # 1 * 1 / 2 = 0.5 -> 1
+        self.assertEqual(compute_upgrade_proration(STARTER, STARTER_PLUS, 1, 2), (1, 0, 1))
+        # 2000 * 1 / 32 = 62.5 -> 63
+        self.assertEqual(compute_upgrade_proration(STARTER, PRO, 1, 32)[0], 63)
+
+    def test_below_half_rounds_down_above_half_rounds_up(self) -> None:
+        # 2000 * 10 / 30 = 666.67 -> 667
+        self.assertEqual(compute_upgrade_proration(STARTER, PRO, 10, 30)[0], 667)
+        # 2000 * 1 / 31 = 64.516 -> 65
+        self.assertEqual(compute_upgrade_proration(STARTER, PRO, 1, 31)[0], 65)
+        # 9000 * 1 / 7 = 1285.714 -> 1286 ; 9000 * 2 / 7 = 2571.43 -> 2571
+        self.assertEqual(compute_upgrade_proration(STARTER, ENTERPRISE, 1, 7)[0], 1286)
+        self.assertEqual(compute_upgrade_proration(STARTER, ENTERPRISE, 2, 7)[0], 2571)
+
+    def test_tax_uses_new_plan_rate_with_half_up(self) -> None:
+        # 9000 * 1 / 2 = 4500; tax at enterprise 10% = 450
+        self.assertEqual(compute_upgrade_proration(STARTER, ENTERPRISE, 1, 2), (4500, 450, 4950))
+        # 9000 * 1 / 7 = 1286; tax 128.6 -> 129
+        self.assertEqual(compute_upgrade_proration(STARTER, ENTERPRISE, 1, 7), (1286, 129, 1415))
+
+    def test_boundary_days(self) -> None:
+        self.assertEqual(compute_upgrade_proration(STARTER, PRO, 0, 30), (0, 0, 0))
+        self.assertEqual(compute_upgrade_proration(STARTER, PRO, 30, 30), (2000, 165, 2165))
+
+
+class UpgradeSubscriptionTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        for plan in (STARTER, PRO, STARTER_PLUS, ENTERPRISE):
+            self.svc.register_plan(plan)
+        self.sub = self.svc.start_subscription("acct_1", "starter")
+
+    def entries(self):
+        return self.svc.ledger.entries_for_account("acct_1")
+
+    def test_upgrade_records_entry_and_switches_plan(self) -> None:
+        entry = self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 10, 30, idempotency_key="k1")
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.sub.subscription_id)
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (667, 55, 722))
+        self.assertEqual(entry.metadata["old_plan_id"], "starter")
+        self.assertEqual(entry.metadata["new_plan_id"], "pro")
+        self.assertEqual(self.svc.ledger.get_subscription(self.sub.subscription_id).plan_id, "pro")
+        self.assertEqual(self.entries(), [entry])
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 722)
+
+    def test_successive_upgrades_use_current_plan_as_baseline(self) -> None:
+        self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 15, 30, idempotency_key="k1")
+        second = self.svc.upgrade_subscription(self.sub.subscription_id, "enterprise", 15, 30, idempotency_key="k2")
+        # (10000 - 3000) * 15 / 30 = 3500; tax 350
+        self.assertEqual((second.subtotal_cents, second.tax_cents, second.total_cents), (3500, 350, 3850))
+        self.assertEqual(len(self.entries()), 2)
+
+    # --- validation -------------------------------------------------------
+
+    def assert_rejected(self, *args, **kwargs) -> None:
+        kwargs.setdefault("idempotency_key", "k_bad")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(*args, **kwargs)
+        # Failed calls must not mutate state or burn the idempotency key.
+        self.assertEqual(self.entries(), [])
+        self.assertEqual(self.svc.ledger.get_subscription(self.sub.subscription_id).plan_id, "starter")
+
+    def test_rejects_unknown_ids(self) -> None:
+        self.assert_rejected("sub_missing", "pro", 10, 30)
+        self.assert_rejected(self.sub.subscription_id, "platinum", 10, 30)
+
+    def test_rejects_non_upgrades(self) -> None:
+        self.assert_rejected(self.sub.subscription_id, "starter", 10, 30)  # same plan
+        self.svc.register_plan(Plan(plan_id="free", name="Free", monthly_cents=0))
+        self.assert_rejected(self.sub.subscription_id, "free", 10, 30)  # downgrade
+        self.svc.register_plan(Plan(plan_id="starter_alt", name="Alt", monthly_cents=1000))
+        self.assert_rejected(self.sub.subscription_id, "starter_alt", 10, 30)  # equal price
+
+    def test_rejects_invalid_bounds(self) -> None:
+        sid = self.sub.subscription_id
+        self.assert_rejected(sid, "pro", 10, 0)
+        self.assert_rejected(sid, "pro", 0, -30)
+        self.assert_rejected(sid, "pro", -1, 30)
+        self.assert_rejected(sid, "pro", 31, 30)
+
+    def test_rejects_booleans_and_non_ints(self) -> None:
+        sid = self.sub.subscription_id
+        self.assert_rejected(sid, "pro", True, 30)
+        self.assert_rejected(sid, "pro", 1, True)
+        self.assert_rejected(sid, "pro", 10.0, 30)
+        self.assert_rejected(sid, "pro", 10, "30")
+
+    def test_rejects_empty_or_invalid_idempotency_key(self) -> None:
+        sid = self.sub.subscription_id
+        self.assert_rejected(sid, "pro", 10, 30, idempotency_key="")
+        self.assert_rejected(sid, "pro", 10, 30, idempotency_key="   ")
+        self.assert_rejected(sid, "pro", 10, 30, idempotency_key=None)
+
+    def test_idempotency_key_is_keyword_only(self) -> None:
+        with self.assertRaises(TypeError):
+            self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 10, 30, "k1")  # type: ignore[misc]
+
+    def test_failed_attempt_does_not_consume_key(self) -> None:
+        self.assert_rejected(self.sub.subscription_id, "pro", 31, 30, idempotency_key="k1")
+        entry = self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 10, 30, idempotency_key="k1")
+        self.assertEqual(entry.total_cents, 722)
+
+    # --- idempotency ------------------------------------------------------
+
+    def test_replay_returns_original_entry_without_duplicate(self) -> None:
+        first = self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 10, 30, idempotency_key="k1")
+        replay = self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 10, 30, idempotency_key="k1")
+        self.assertIs(replay, first)
+        self.assertEqual(len(self.entries()), 1)
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 722)
+        self.assertEqual(self.svc.ledger.get_subscription(self.sub.subscription_id).plan_id, "pro")
+
+    def test_reuse_with_different_arguments_conflicts(self) -> None:
+        sid = self.sub.subscription_id
+        self.svc.upgrade_subscription(sid, "pro", 10, 30, idempotency_key="k1")
+        other = self.svc.start_subscription("acct_1", "starter")
+        for args in (
+            (sid, "enterprise", 10, 30),
+            (sid, "pro", 11, 30),
+            (sid, "pro", 10, 31),
+            (other.subscription_id, "pro", 10, 30),
+        ):
+            with self.subTest(args=args), self.assertRaises(ValidationError):
+                self.svc.upgrade_subscription(*args, idempotency_key="k1")
+        self.assertEqual(len(self.entries()), 1)
+        self.assertEqual(self.svc.ledger.get_subscription(other.subscription_id).plan_id, "starter")
+
+    def test_distinct_keys_are_independent(self) -> None:
+        sid = self.sub.subscription_id
+        self.svc.upgrade_subscription(sid, "pro", 10, 30, idempotency_key="k1")
+        # A fresh key repeats the same request: pro -> pro is no longer an upgrade.
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sid, "pro", 10, 30, idempotency_key="k2")
+        self.assertEqual(len(self.entries()), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
