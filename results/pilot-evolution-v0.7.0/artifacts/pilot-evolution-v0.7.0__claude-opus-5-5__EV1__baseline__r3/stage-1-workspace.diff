+    def upgrade_subscription(
+        self,
+        subscription_id: str,
+        new_plan_id: str,
+        days_remaining: int,
+        cycle_days: int,
+        *,
+        idempotency_key: str,
+    ) -> LedgerEntry:
+        """Move a subscription to a pricier plan mid-cycle and charge the prorated difference.
+
+        Replaying the same ``idempotency_key`` with identical arguments returns the
+        original entry without charging again; reusing it with different arguments
+        raises ValidationError.
+        """
+        if not isinstance(idempotency_key, str) or not idempotency_key.strip():
+            raise ValidationError("idempotency_key must be a non-empty string")
+        if not isinstance(subscription_id, str) or not isinstance(new_plan_id, str):
+            raise ValidationError("subscription_id and new_plan_id must be strings")
+        # Fingerprint includes value types so e.g. 15 and 15.0 are not conflated.
+        fingerprint = (
+            "plan_upgrade",
+            subscription_id,
+            new_plan_id,
+            (type(days_remaining), days_remaining),
+            (type(cycle_days), cycle_days),
+        )
+        # Check replay before validating the plan change: after the first call the
+        # subscription is already on new_plan_id, so it would no longer be an upgrade.
+        existing = self.ledger.find_idempotent_entry(idempotency_key, fingerprint)
+        if existing is not None:
+            return existing
+
+        sub = self.ledger.get_subscription(subscription_id)
+        old_plan = self.ledger.get_plan(sub.plan_id)
+        new_plan = self.ledger.get_plan(new_plan_id)
+        subtotal, tax, total = compute_upgrade_proration(old_plan, new_plan, days_remaining, cycle_days)
+
+        entry = LedgerEntry(
+            entry_id=self.ledger.next_id("ent"),
+            account_id=sub.account_id,
+            kind="plan_upgrade",
+            subtotal_cents=subtotal,
+            tax_cents=tax,
+            total_cents=total,
+            reference_id=subscription_id,
+            reason=f"Upgrade {old_plan.plan_id} -> {new_plan.plan_id}",
+            metadata={
+                "old_plan_id": old_plan.plan_id,
+                "new_plan_id": new_plan.plan_id,
+                "days_remaining": days_remaining,
+                "cycle_days": cycle_days,
+                "idempotency_key": idempotency_key,
+            },
+        )
+        self.ledger.record_idempotent_entry(idempotency_key, fingerprint, entry)
+        sub.plan_id = new_plan.plan_id
+        return entry
