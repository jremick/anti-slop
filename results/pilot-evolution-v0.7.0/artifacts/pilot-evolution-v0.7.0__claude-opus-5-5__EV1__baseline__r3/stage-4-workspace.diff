+"""Turn 4: legacy flat-fee removal and fail-closed audit logging."""
+
+from __future__ import annotations
+
+import inspect
+import unittest
+
+from ev1_order_ledger import pricing
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, ValidationError
+
+
+ITEMS = [LineItem(sku="seat", unit_cents=1999, quantity=2)]  # subtotal 3998
+
+
+class SinkFailure(RuntimeError):
+    pass
+
+
+class RecordingSink:
+    """Records events; raises SinkFailure while ``fail`` is True."""
+
+    def __init__(self) -> None:
+        self.events: list = []
+        self.fail = False
+
+    def __call__(self, event: dict) -> None:
+        if self.fail:
+            raise SinkFailure("audit backend unavailable")
+        self.events.append(event)
+
+
+class LegacyFlatFeeRemovedTests(unittest.TestCase):
+    def test_calculate_order_totals_rejects_legacy_kwarg(self) -> None:
+        for value in (True, False):
+            with self.subTest(value=value), self.assertRaises(TypeError):
+                pricing.calculate_order_totals(ITEMS, legacy_flat_fee=value)
+
+    def test_place_order_rejects_legacy_kwarg_without_side_effects(self) -> None:
+        svc = OrderService()
+        for value in (True, False):
+            with self.subTest(value=value), self.assertRaises(TypeError):
+                svc.place_order("acct_1", ITEMS, legacy_flat_fee=value)
+        self.assertEqual(svc.get_statement("acct_1")["entry_count"], 0)
+
+    def test_no_legacy_constant_or_catch_all_kwargs(self) -> None:
+        self.assertFalse(hasattr(pricing, "LEGACY_FLAT_FEE_CENTS"))
+        for fn in (pricing.calculate_order_totals, OrderService.place_order):
+            params = inspect.signature(fn).parameters
+            self.assertNotIn("legacy_flat_fee", params)
+            self.assertFalse(any(p.kind is inspect.Parameter.VAR_KEYWORD for p in params.values()))
+
+    def test_order_totals_have_no_hidden_fee(self) -> None:
+        self.assertEqual(pricing.calculate_order_totals(ITEMS, tax_bps=825), (3998, 0, 330, 4328))
+
+
+class AuditSinkTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.sink = RecordingSink()
+        self.svc = OrderService(audit_sink=self.sink)
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+
+    def entries(self, account_id: str = "acct_1"):
+        return self.svc.ledger.entries_for_account(account_id)
+
+    def test_rejects_non_callable_sink(self) -> None:
+        with self.assertRaises(ValidationError):
+            OrderService(audit_sink="not callable")  # type: ignore[arg-type]
+
+    def test_every_mutation_emits_one_event_matching_its_entry(self) -> None:
+        order = self.svc.place_order("acct_1", ITEMS, tax_bps=825)
+        sub = self.svc.start_subscription("acct_1", "starter")
+        upgrade = self.svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="u1")
+        refund = self.svc.refund_order(order.order_id, 1000, reason="damaged", idempotency_key="r1")
+        charge = self.entries()[0]
+        self.assertEqual(
+            self.sink.events,
+            [
+                {"action": "order_charge", "account_id": "acct_1", "amount_cents": 4328, "entry_id": charge.entry_id},
+                {"action": "plan_upgrade", "account_id": "acct_1", "amount_cents": 1083, "entry_id": upgrade.entry_id},
+                {"action": "order_refund", "account_id": "acct_1", "amount_cents": -1000, "entry_id": refund.entry_id},
+            ],
+        )
+        self.assertEqual([e["entry_id"] for e in self.sink.events], [e.entry_id for e in self.entries()])
+
+    def test_idempotent_replays_are_not_audited(self) -> None:
+        order = self.svc.place_order("acct_1", ITEMS)
+        sub = self.svc.start_subscription("acct_1", "starter")
+        self.svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="u1")
+        self.svc.refund_order(order.order_id, 100, reason="r", idempotency_key="r1")
+        self.assertEqual(len(self.sink.events), 3)
+        self.svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="u1")
+        self.svc.refund_order(order.order_id, 100, reason="r", idempotency_key="r1")
+        self.assertEqual(len(self.sink.events), 3)
+
+    def test_rejected_operations_are_not_audited(self) -> None:
+        order = self.svc.place_order("acct_1", ITEMS)
+        for call in (
+            lambda: self.svc.place_order("acct_1", []),
+            lambda: self.svc.place_order("acct_1", ITEMS, promo_code="NOPE"),
+            lambda: self.svc.refund_order(order.order_id, 10**9, reason="r", idempotency_key="r1"),
+            lambda: self.svc.upgrade_subscription("sub_missing", "pro", 1, 30, idempotency_key="u1"),
+        ):
+            with self.assertRaises(ValidationError):
+                call()
+        self.assertEqual(len(self.sink.events), 1)
+
+    # --- fail closed ------------------------------------------------------
+
+    def test_place_order_fails_closed(self) -> None:
+        self.sink.fail = True
+        with self.assertRaises(SinkFailure):
+            self.svc.place_order("acct_1", ITEMS, tax_bps=825)
+        self.assertEqual(self.entries(), [])
+        self.assertEqual(self.svc.ledger._orders, {})
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 0)
+
+        self.sink.fail = False
+        order = self.svc.place_order("acct_1", ITEMS, tax_bps=825)
+        self.assertEqual(len(self.entries()), 1)
+        self.assertIs(self.svc.ledger.get_order(order.order_id), order)
+
+    def test_upgrade_fails_closed_and_keeps_key_available(self) -> None:
+        sub = self.svc.start_subscription("acct_1", "starter")
+        self.sink.fail = True
+        with self.assertRaises(SinkFailure):
+            self.svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="u1")
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "starter")
+        self.assertEqual(self.entries(), [])
+
+        self.sink.fail = False
+        entry = self.svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="u1")
+        self.assertEqual(entry.total_cents, 1083)
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "pro")
+        self.assertEqual([e["entry_id"] for e in self.sink.events], [entry.entry_id])
+
+    def test_refund_fails_closed_and_keeps_key_available(self) -> None:
+        order = self.svc.place_order("acct_1", ITEMS, tax_bps=825)
+        self.sink.fail = True
+        with self.assertRaises(SinkFailure):
+            self.svc.refund_order(order.order_id, 4328, reason="r", idempotency_key="r1")
+        self.assertEqual(self.svc.ledger.refunded_cents_for_order(order.order_id), 0)
+        self.assertEqual(len(self.entries()), 1)
+
+        self.sink.fail = False
+        entry = self.svc.refund_order(order.order_id, 4328, reason="r", idempotency_key="r1")
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents), (-3998, -330))
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 0)
+
+    def test_replay_succeeds_even_if_sink_is_down(self) -> None:
+        order = self.svc.place_order("acct_1", ITEMS)
+        first = self.svc.refund_order(order.order_id, 100, reason="r", idempotency_key="r1")
+        self.sink.fail = True
+        self.assertIs(self.svc.refund_order(order.order_id, 100, reason="r", idempotency_key="r1"), first)
+
+
+if __name__ == "__main__":
+    unittest.main()

