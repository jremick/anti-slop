+
+    def test_multi_chunk_refund_hand_calculated(self) -> None:
+        # Cumulative tax targets: round(330*1000/4328)=76, round(330*2000/4328)=152, 330.
+        e1 = self.refund(1000, "r1")
+        e2 = self.refund(1000, "r2")
+        e3 = self.refund(2328, "r3")
+        self.assertEqual((e1.subtotal_cents, e1.tax_cents, e1.total_cents), (-924, -76, -1000))
+        self.assertEqual((e2.subtotal_cents, e2.tax_cents, e2.total_cents), (-924, -76, -1000))
+        self.assertEqual((e3.subtotal_cents, e3.tax_cents, e3.total_cents), (-2150, -178, -2328))
+        for e in (e1, e2, e3):
+            self.assertEqual(e.kind, "order_refund")
+            self.assertEqual(e.reference_id, self.oid)
+            self.assertEqual(e.account_id, "acct_1")
+            self.assertEqual(e.reason, "customer request")
