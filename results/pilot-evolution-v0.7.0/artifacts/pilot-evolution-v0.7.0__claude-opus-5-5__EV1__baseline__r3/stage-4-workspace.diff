+"""Turn 3: partial refunds with exact penny conservation and credit-note export."""
+
+from __future__ import annotations
+
+import random
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, ValidationError
+from ev1_order_ledger.pricing import allocate_refund_cents
+
+
+def seat(unit_cents: int, quantity: int = 1) -> list:
+    return [LineItem(sku="seat", unit_cents=unit_cents, quantity=quantity)]
+
+
+def random_split(rng: random.Random, total: int, max_chunks: int) -> list:
+    """Split ``total`` into 1..max_chunks positive integer chunks."""
+    k = rng.randint(1, min(max_chunks, total))
+    cuts = sorted(rng.sample(range(1, total), k - 1))
+    bounds = [0] + cuts + [total]
+    return [b - a for a, b in zip(bounds, bounds[1:])]
+
+
+class AllocateRefundTests(unittest.TestCase):
+    def assert_conserves(self, tax: int, total: int, chunks: list) -> None:
+        refunded = sub_sum = tax_sum = 0
+        for amount in chunks:
+            sub, tx = allocate_refund_cents(tax, total, refunded, amount)
+            self.assertEqual(sub + tx, amount)
+            self.assertGreaterEqual(sub, 0)
+            self.assertGreaterEqual(tx, 0)
+            refunded += amount
+            sub_sum += sub
+            tax_sum += tx
+        self.assertEqual((sub_sum, tax_sum), (total - tax, tax))
+
+    def test_cumulative_allocation_avoids_per_chunk_drift(self) -> None:
+        # Rounding each third separately would reverse 0 tax three times and lose the 1 cent.
+        self.assertEqual(allocate_refund_cents(1, 3, 0, 1), (1, 0))
+        self.assertEqual(allocate_refund_cents(1, 3, 1, 1), (0, 1))
+        self.assertEqual(allocate_refund_cents(1, 3, 2, 1), (1, 0))
+
+    def test_one_cent_refunds_across_whole_order(self) -> None:
+        self.assert_conserves(330, 4328, [1] * 4328)
+
+    def test_randomized_splits_conserve_pennies(self) -> None:
+        rng = random.Random(20261127)
+        for _ in range(500):
+            total = rng.randint(1, 50_000)
+            tax = rng.randint(0, total)
+            with self.subTest(tax=tax, total=total):
+                self.assert_conserves(tax, total, random_split(rng, total, 12))
+
+    def test_all_tax_and_no_tax_extremes(self) -> None:
+        self.assert_conserves(0, 1000, [333, 333, 334])
+        self.assert_conserves(1000, 1000, [333, 333, 334])
+
+    def test_over_refund_rejected(self) -> None:
+        with self.assertRaises(ValidationError):
+            allocate_refund_cents(330, 4328, 4000, 329)
+        with self.assertRaises(ValidationError):
+            allocate_refund_cents(0, 0, 0, 1)
+
