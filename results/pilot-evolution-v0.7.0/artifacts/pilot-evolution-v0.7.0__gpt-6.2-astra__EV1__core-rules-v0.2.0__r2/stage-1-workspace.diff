+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import Plan, ValidationError
+
+
+class SubscriptionUpgradeTests(unittest.TestCase):
+    def setUp(self):
+        self.service = OrderService()
+        self.service.register_plan(Plan("basic", "Basic", 100))
+        self.service.register_plan(Plan("pro", "Pro", 109, 1000))
+        self.service.register_plan(Plan("team", "Team", 200))
+        self.sub = self.service.start_subscription("acct", "basic")
+
+    def test_proration_and_tax_each_round_half_up(self):
+        entry = self.service.upgrade_subscription(
+            self.sub.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (5, 1, 6))
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.sub.subscription_id)
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [entry])
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], 6)
+
+    def test_fractional_and_boundary_days(self):
+        for days, subtotal in [(0, 0), (1, 2), (3, 7), (4, 9)]:
+            with self.subTest(days=days):
+                sub = self.service.start_subscription("acct", "basic")
+                entry = self.service.upgrade_subscription(
+                    sub.subscription_id, "pro", days, 4, idempotency_key=str(days)
+                )
+                self.assertEqual(entry.subtotal_cents, subtotal)
+                self.assertEqual(sub.plan_id, "pro")
+
+    def test_large_amount_preserves_exact_cents(self):
+        difference = 2**54 + 1
+        self.service.register_plan(Plan("large", "Large", 100 + difference))
+        entry = self.service.upgrade_subscription(
+            self.sub.subscription_id, "large", 1, 2, idempotency_key="large"
+        )
+        self.assertEqual(entry.subtotal_cents, 2**53 + 1)
+
+    def test_invalid_requests_preserve_subscription_and_ledger(self):
+        sub_id = self.sub.subscription_id
+        self.service.register_plan(Plan("equal", "Equal", 100))
+        self.service.register_plan(Plan("cheap", "Cheap", 99))
+        cases = [
+            (sub_id, "pro", days, cycle, "key")
+            for days, cycle in [(-1, 2), (3, 2), (0, 0), (0, -1), (True, 2), (0, True)]
+        ]
+        cases.extend((sub_id, plan, 1, 2, "key") for plan in ["equal", "cheap", "missing", False])
+        cases.extend((sub, "pro", 1, 2, "key") for sub in ["missing", True])
+        cases.extend((sub_id, "pro", 1, 2, key) for key in ["", "  ", False])
+        for sub, plan, days, cycle, key in cases:
+            with self.subTest(args=(sub, plan, days, cycle, key)):
+                with self.assertRaises(ValidationError):
+                    self.service.upgrade_subscription(sub, plan, days, cycle, idempotency_key=key)
+                self.assertEqual(self.sub.plan_id, "basic")
+                self.assertEqual(self.service.ledger.entries_for_account("acct"), [])
+        self.service.upgrade_subscription(sub_id, "pro", 1, 2, idempotency_key="key")
+
+    def test_shared_ledger_replays_original_entry_after_later_upgrade(self):
+        sub_id = self.sub.subscription_id
+        first = self.service.upgrade_subscription(sub_id, "pro", 1, 2, idempotency_key="a")
+        second = self.service.upgrade_subscription(sub_id, "team", 1, 2, idempotency_key="b")
+        other_service = OrderService(self.service.ledger)
+        replay = other_service.upgrade_subscription(sub_id, "pro", 1, 2, idempotency_key="a")
+        self.assertIs(replay, first)
+        self.assertEqual(self.sub.plan_id, "team")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [first, second])
+
+    def test_key_conflicts_cover_each_argument(self):
+        sub_id = self.sub.subscription_id
+        other = self.service.start_subscription("acct", "basic")
+        original = self.service.upgrade_subscription(sub_id, "pro", 1, 1, idempotency_key="a")
+        for args in [
+            (other.subscription_id, "pro", 1, 1), (sub_id, "team", 1, 1),
+            (sub_id, "pro", 0, 1), (sub_id, "pro", 1, 2),
+            (sub_id, "pro", True, 1), (sub_id, "pro", 1, True),
+        ]:
+            with self.subTest(args=args), self.assertRaises(ValidationError):
+                self.service.upgrade_subscription(*args, idempotency_key="a")
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertEqual(other.plan_id, "basic")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [original])
