+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, ValidationError
+
+
+class RefundTests(unittest.TestCase):
+    def setUp(self):
+        self.service = OrderService()
+        self.order = self.service.place_order("acct", [LineItem("item", 10, 1)], tax_bps=2000)
+
+    def refund(self, amount, key, reason="return"):
+        return self.service.refund_order(
+            self.order.order_id, amount, reason=reason, idempotency_key=key
+        )
+
+    def test_chunk_boundaries_conserve_each_component(self):
+        # The order is 10 cents plus 2 cents tax. Cumulative tax rounds up
+        # at 3 and 9 refunded cents, including when every chunk is one cent.
+        for chunks in [[1] * 12, [2, 1, 6, 3], [7, 5], [12]]:
+            order = self.service.place_order("acct", self.order.items, tax_bps=2000)
+            subtotal = tax = refunded = 0
+            for index, amount in enumerate(chunks):
+                entry = self.service.refund_order(
+                    order.order_id, amount, reason="partial", idempotency_key=f"{order.order_id}-{index}"
+                )
+                self.assertEqual(entry.subtotal_cents + entry.tax_cents, -amount)
+                self.assertEqual(entry.total_cents, -amount)
+                subtotal -= entry.subtotal_cents
+                tax -= entry.tax_cents
+                refunded += amount
+                self.assertEqual(tax, int(refunded >= 3) + int(refunded >= 9))
+            self.assertEqual((subtotal, tax), (order.subtotal_cents, order.tax_cents))
+
+    def test_over_refund_leaves_remaining_balance_available(self):
+        self.refund(8, "first")
+        with self.assertRaises(ValidationError):
+            self.refund(5, "second")
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], 4)
+        self.refund(4, "second")
+        with self.assertRaises(ValidationError):
+            self.refund(1, "third")
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], 0)
+
+    def test_replay_and_conflicts(self):
+        original = self.refund(3, "first")
+        other = self.service.place_order("acct", self.order.items)
+        for order_id, amount, reason in [
+            (other.order_id, 3, "return"), (self.order.order_id, 4, "return"),
+            (self.order.order_id, 3, "cancel"),
+        ]:
+            with self.subTest(args=(order_id, amount, reason)), self.assertRaises(ValidationError):
+                self.service.refund_order(order_id, amount, reason=reason, idempotency_key="first")
+        self.refund(9, "last")
+        replay = OrderService(self.service.ledger).refund_order(
+            self.order.order_id, 3, reason="return", idempotency_key="first"
+        )
+        self.assertIs(replay, original)
+        self.assertEqual(self.service.get_statement("acct")["entry_count"], 4)
+
+    def test_credit_note_uses_recorded_refund(self):
+        charge, = self.service.ledger.entries_for_account("acct")
+        refund = self.refund(3, "first", "damaged item")
+        self.refund(9, "last")
+        self.assertEqual(refund.kind, "order_refund")
+        self.assertEqual(self.service.export_credit_note(refund.entry_id), {
+            "entry_id": refund.entry_id, "order_id": self.order.order_id, "account_id": "acct",
+            "subtotal_cents": 2, "tax_cents": 1, "total_cents": 3, "reason": "damaged item",
+        })
+        for entry_id in ["unknown", charge.entry_id]:
+            with self.subTest(entry_id=entry_id), self.assertRaises(ValidationError):
+                self.service.export_credit_note(entry_id)
+
+    def test_invalid_refund_inputs(self):
+        for amount in [0, -1, True, 1.5]:
+            with self.subTest(amount=amount), self.assertRaises(ValidationError):
+                self.refund(amount, "key")
+        for reason, key in [("", "key"), ("  ", "key"), (None, "key"), ("return", " "), ("return", None)]:
+            with self.subTest(reason=reason, key=key), self.assertRaises(ValidationError):
+                self.refund(1, key, reason)
+        with self.assertRaises(ValidationError):
+            self.service.refund_order("unknown", 1, reason="return", idempotency_key="key")
+        self.assertEqual(self.service.get_statement("acct")["entry_count"], 1)

