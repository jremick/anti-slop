{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cd benchmarks/sources/ev1_order_ledger && cat > tests/test_promos.py <<'PY'\nimport unittest\n\nfrom ev1_order_ledger.api import OrderService\nfrom ev1_order_ledger.models import LineItem, Plan, ValidationError\n\n\nclass PromoTests(unittest.TestCase):\n    def setUp(self):\n        self.service = OrderService()\n        self.items = [LineItem(\\\"item\\\", 105, 1)]\n\n    def test_percent_rounds_half_up_before_tax(self):\n        self.service.register_promo(\\\"TEN\\\", percent_off=10, min_subtotal_cents=105)\n        order = self.service.place_order(\\\"acct\\\", self.items, tax_bps=1000, promo_code=\\\"TEN\\\")\n        self.assertEqual((order.promo_code, order.discount_cents), (\\\"TEN\\\", 11))\n        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (94, 9, 103))\n        self.assertEqual(self.service.get_statement(\\\"acct\\\")[\\\"balance_cents\\\"], 103)\n\n    def test_fixed_discount_includes_fee_and_clamps_at_subtotal(self):\n        self.service.register_promo(\\\"FIXED\\\", amount_off_cents=200)\n        for fee, expected in [(False, (105, 0, 0, 0)), (True, (200, 405, 41, 446))]:\n            with self.subTest(fee=fee):\n                order = self.service.place_order(\n                    \\\"acct\\\", self.items, tax_bps=1000, promo_code=\\\"FIXED\\\", legacy_flat_fee=fee\n                )\n                self.assertEqual(\n                    (order.discount_cents, order.subtotal_cents, order.tax_cents, order.total_cents),\n                    expected,\n                )\n\n    def test_invalid_registration(self):\n        for code, options in [\n            (\\\" \\\", {\\\"percent_off\\\": 1}), (\\\"A,B\\\", {\\\"percent_off\\\": 1}), (\\\"A\\\", {}),\n            (\\\"A\\\", {\\\"percent_off\\\": 1, \\\"amount_off_cents\\\": 1}),\n            (\\\"A\\\", {\\\"percent_off\\\": 0}), (\\\"A\\\", {\\\"percent_off\\\": 101}),\n            (\\\"A\\\", {\\\"amount_off_cents\\\": 0}), (\\\"A\\\", {\\\"percent_off\\\": True}),\n            (\\\"A\\\", {\\\"percent_off\\\": 1, \\\"min_subtotal_cents\\\": -1}),\n            (\\\"A\\\", {\\\"percent_off\\\": 1, \\\"expires_on\\\": \\\"2025-02-29\\\"}),\n        ]:\n            with self.subTest(code=code, options=options), self.assertRaises(ValidationError):\n                self.service.register_promo(code, **options)\n\n    def test_rejected_orders_and_inclusive_expiry(self):\n        self.service.register_promo(\\\"A\\\", percent_off=100, expires_on=\\\"2024-02-29\\\")\n        self.service.register_promo(\\\"B\\\", amount_off_cents=10, min_subtotal_cents=106)\n        for code, day in [\n            (\\\"unknown\\\", None), (\\\"A,B\\\", \\\"2024-02-28\\\"), (\\\"B\\\", None), (\\\"A\\\", None),\n            (\\\"A\\\", \\\"2024-03-01\\\"), (\\\"A\\\", \\\"2024-02-30\\\"), (\\\"A\\\", \\\"20240228\\\"),\n        ]:\n            with self.subTest(code=code, day=day), self.assertRaises(ValidationError):\n                self.service.place_order(\\\"acct\\\", self.items, promo_code=code, as_of=day)\n        self.assertEqual(self.service.ledger.entries_for_account(\\\"acct\\\"), [])\n        order = self.service.place_order(\\\"acct\\\", self.items, promo_code=\\\"A\\\", as_of=\\\"2024-02-29\\\")\n        self.assertEqual((order.discount_cents, order.total_cents), (105, 0))\n\n    def test_upgrade_uses_prorated_subtotal_and_replays_discounted_charge(self):\n        self.service.register_plan(Plan(\\\"basic\\\", \\\"Basic\\\", 100))\n        self.service.register_plan(Plan(\\\"pro\\\", \\\"Pro\\\", 309, 1000))\n        sub = self.service.start_subscription(\\\"acct\\\", \\\"basic\\\")\n        self.service.register_promo(\\\"MIN\\\", percent_off=10, min_subtotal_cents=106)\n        self.service.register_promo(\\\"TEN\\\", percent_off=10, expires_on=\\\"2026-01-31\\\")\n        upgrade = OrderService(self.service.ledger).upgrade_subscription\n        args = (sub.subscription_id, \\\"pro\\\", 1, 2)\n        for code, day in [(\\\"MIN\\\", None), (\\\"TEN\\\", None), (\\\"TEN\\\", \\\"2026-02-01\\\")]:\n            with self.subTest(code=code, day=day), self.assertRaises(ValidationError):\n                upgrade(*args, idempotency_key=\\\"k\\\", promo_code=code, as_of=day)\n        self.assertEqual(sub.plan_id, \\\"basic\\\")\n        entry = upgrade(*args, idempotency_key=\\\"k\\\", promo_code=\\\"TEN\\\", as_of=\\\"2026-01-31\\\")\n        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (94, 9, 103))\n        self.assertEqual(sub.plan_id, \\\"pro\\\")\n        self.assertIs(upgrade(*args, idempotency_key=\\\"k\\\", promo_code=\\\"TEN\\\", as_of=\\\"2026-01-31\\\"), entry)\n        for code, day in [(None, \\\"2026-01-31\\\"), (\\\"TEN\\\", \\\"2026-01-30\\\")]:\n            with self.subTest(code=code, day=day), self.assertRaises(ValidationError):\n                upgrade(*args, idempotency_key=\\\"k\\\", promo_code=code, as_of=day)\n        self.assertEqual(self.service.ledger.entries_for_account(\\\"acct\\\"), [entry])\nPY\npython3 run_checks.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
