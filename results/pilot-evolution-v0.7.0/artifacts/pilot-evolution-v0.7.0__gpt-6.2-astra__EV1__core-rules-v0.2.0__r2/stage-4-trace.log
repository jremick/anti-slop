m, Plan, ValidationError\n\n\nclass AuditTests(unittest.TestCase):\n    def setUp(self):\n        self.events = []\n        self.service = OrderService(audit_sink=self.events.append)\n        self.items = [LineItem(\\\"item\\\", 100, 1)]\n        self.service.register_plan(Plan(\\\"basic\\\", \\\"Basic\\\", 100))\n        self.service.register_plan(Plan(\\\"pro\\\", \\\"Pro\\\", 200))\n        self.sub = self.service.start_subscription(\\\"acct\\\", \\\"basic\\\")\n\n    def upgrade(self, service):\n        return service.upgrade_subscription(\n            self.sub.subscription_id, \\\"pro\\\", 1, 2, idempotency_key=\\\"upgrade\\\"\n        )\n\n    def refund(self, service, order):\n        return service.refund_order(order.order_id, 100, reason=\\\"return\\\", idempotency_key=\\\"refund\\\")\n\n    def test_signed_events_once_per_committed_entry(self):\n        order = self.service.place_order(\\\"acct\\\", self.items)\n        upgrade = self.upgrade(self.service)\n        refund = self.refund(self.service, order)\n        self.assertIs(self.upgrade(self.service), upgrade)\n        self.assertIs(self.refund(self.service, order), refund)\n        charge, _, _ = self.service.ledger.entries_for_account(\\\"acct\\\")\n        self.assertEqual(self.events, [\n            {\\\"action\\\": \\\"order_charge\\\", \\\"account_id\\\": \\\"acct\\\", \\\"amount_cents\\\": 100, \\\"entry_id\\\": charge.entry_id},\n            {\\\"action\\\": \\\"plan_upgrade\\\", \\\"account_id\\\": \\\"acct\\\", \\\"amount_cents\\\": 50, \\\"entry_id\\\": upgrade.entry_id},\n            {\\\"action\\\": \\\"order_refund\\\", \\\"account_id\\\": \\\"acct\\\", \\\"amount_cents\\\": -100, \\\"entry_id\\\": refund.entry_id},\n        ])\n\n    def test_failed_audit_prevents_commits_and_allows_retries(self):\n        ledger = self.service.ledger\n        error = RuntimeError(\\\"audit unavailable\\\")\n        sink = Mock(side_effect=error)\n        failing = OrderService(ledger, audit_sink=sink)\