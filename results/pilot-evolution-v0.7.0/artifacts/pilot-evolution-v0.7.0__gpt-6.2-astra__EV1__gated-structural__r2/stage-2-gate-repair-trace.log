ls(\n    items: Sequence[LineItem],\n    *,\n    tax_bps: int = 0,\n    legacy_flat_fee: bool = False,\n) -> Tuple[int, int, int]:\n    \"\"\"Return (subtotal_cents, tax_cents, total_cents) using exact integer cents.\"\"\"\n    subtotal = compute_subtotal_cents(items, legacy_flat_fee=legacy_flat_fee)\n    return calculate_charge_totals(subtotal, tax_bps)\n\"\"\"Service facade coordinating pricing and ledger persistence for EV1.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Dict, Sequence\n\nfrom .ledger import OrderLedger\nfrom .models import LedgerEntry, LineItem, Order, Plan, Promo, Subscription, ValidationError\nfrom .pricing import (\n    calculate_charge_totals, compute_subtotal_cents, parse_date,\n    validate_non_negative_int, validate_positive_int,\n)\n\n\nclass OrderService:\n    def __init__(self, ledger: OrderLedger | None = None) -> None:\n        self.ledger = ledger if ledger is not None else OrderLedger()\n\n    def register_plan(self, plan: Plan) -> None:\n        self.ledger.add_plan(plan)\n\n    def register_promo(\n        self,\n        code: str,\n        *,\n        percent_off: int | None = None,\n        amount_off_cents: int | None = None,\n        expires_on: str | None = None,\n        min_subtotal_cents: int = 0,\n    ) -> None:\n        if not isinstance(code, str) or not code.strip() or \",\" in code:\n            raise ValidationError(\"a single non-empty promo code is required\")\n        if (percent_off is None) == (amount_off_cents is None):\n            raise ValidationError(\"provide exactly one promo discount\")\n        if percent_off is not None:\n            validate_positive_int(percent_off, \"percent_off\")\n            if percent_off > 100:\n                raise ValidationError(\"percent_off cannot exceed 100\")\n        else:\n            validate_positive_int(amount_off_cents, \"amount_off_cents\")\n        validate_non_negative_int(min_subtotal_cents, \"min_subtotal_cents\")\n        expiry = parse_d