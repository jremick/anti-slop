+import unittest
+
+from ev1_order_ledger import LineItem, OrderService, ValidationError
+
+
+class RefundTests(unittest.TestCase):
+    def setUp(self):
+        self.service = OrderService()
+        self.order = self.service.place_order("acct", [LineItem("item", 6, 1)], tax_bps=3333)
+
+    def refund(self, amount, key, reason="returned"):
+        return self.service.refund_order(
+            self.order.order_id, amount, reason=reason, idempotency_key=key
+        )
+
+    def test_partial_refunds_conserve_subtotal_and_tax(self):
+        # Order total is 8 cents, including 2 cents tax. At 2 and 6 cents
+        # refunded, cumulative tax lands on a half cent and rounds up.
+        chunks = [(1, 0), (1, 1), (3, 0), (1, 1), (2, 0)]
+        refunds = []
+        for i, (amount, tax) in enumerate(chunks):
+            entry = self.refund(amount, str(i))
+            self.assertEqual(entry.kind, "order_refund")
+            self.assertEqual(entry.tax_cents, -tax)
+            self.assertEqual(entry.total_cents, -amount)
+            self.assertEqual(entry.subtotal_cents + entry.tax_cents, entry.total_cents)
+            refunds.append(entry)
+        self.assertEqual(sum(e.tax_cents for e in refunds), -self.order.tax_cents)
+        self.assertEqual(sum(e.subtotal_cents for e in refunds), -self.order.subtotal_cents)
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], 0)
+
+    def test_over_refund_rejection_is_per_order_and_leaves_key_reusable(self):
+        other = self.service.place_order("acct", [LineItem("other", 20, 1)])
+        self.service.refund_order(other.order_id, 19, reason="return", idempotency_key="other")
+        self.refund(5, "first")
+        with self.assertRaises(ValidationError):
+            self.refund(4, "second")
+        final = self.refund(3, "second")
+        self.assertEqual(final.tax_cents, -1)
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], 1)
+
+    def test_replay_after_full_refund_and_conflicting_arguments(self):
+        first = self.refund(1, "first")
+        self.refund(7, "last")
+        retry = OrderService(self.service.ledger).refund_order
+        other = self.service.place_order("acct", [LineItem("other", 10, 1)])
+        for order_id, amount, reason in [
+            (other.order_id, 1, "returned"), (self.order.order_id, 2, "returned"),
+            (self.order.order_id, 1, "damaged"), (self.order.order_id, True, "returned"),
+        ]:
+            with self.subTest(order_id=order_id, amount=amount, reason=reason):
+                with self.assertRaises(ValidationError):
+                    retry(order_id, amount, reason=reason, idempotency_key="first")
+        self.assertIs(retry(self.order.order_id, 1, reason="returned", idempotency_key="first"), first)
+        self.assertEqual(self.service.get_statement("acct")["entry_count"], 4)
+
+    def test_invalid_inputs_leave_charge_intact(self):
+        for amount, key, reason in [
+            (0, "r", "return"), (-1, "r", "return"), (1.5, "r", "return"),
+            (1, "r", " "), (1, "r", None), (1, "", "return"), (1, False, "return"),
+        ]:
+            with self.subTest(amount=amount, key=key, reason=reason), self.assertRaises(ValidationError):
+                self.refund(amount, key, reason)
+        with self.assertRaises(ValidationError):
+            self.service.refund_order("missing", 1, reason="return", idempotency_key="r")
+        self.assertEqual(self.service.get_statement("acct")["entry_count"], 1)
+
+    def test_credit_note_uses_recorded_refund_magnitudes(self):
+        charge, = self.service.ledger.entries_for_account("acct")
+        refund = self.refund(4, "refund", "damaged")
+        self.assertEqual(self.service.export_credit_note(refund.entry_id), {
+            "entry_id": refund.entry_id, "order_id": self.order.order_id,
+            "account_id": "acct", "subtotal_cents": 3, "tax_cents": 1,
+            "total_cents": 4, "reason": "damaged",
+        })
+        for entry_id in ["missing", charge.entry_id]:
+            with self.subTest(entry_id=entry_id), self.assertRaises(ValidationError):
+                self.service.export_credit_note(entry_id)

