+import unittest
+
+from ev1_order_ledger import OrderService, Plan, ValidationError
+
+
+class SubscriptionUpgradeTests(unittest.TestCase):
+    def setUp(self):
+        self.service = OrderService()
+        self.service.register_plan(Plan("starter", "Starter", 100))
+        self.service.register_plan(Plan("pro", "Pro", 105, tax_bps=5000))
+        self.sub = self.service.start_subscription("acct", "starter")
+
+    def test_half_cent_proration_then_tax(self):
+        entry = self.service.upgrade_subscription(
+            self.sub.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+        # Prorate 5 cents to 2.5, then tax the rounded 3 cents at 50%.
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (3, 2, 5))
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.sub.subscription_id)
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [entry])
+
+    def test_cycle_endpoints_and_large_integer_precision(self):
+        difference = 2**54 + 1
+        self.service.register_plan(Plan("large", "Large", 100 + difference))
+        for days, expected in [(0, 0), (1, 2**53 + 1), (2, difference)]:
+            with self.subTest(days=days):
+                sub = self.service.start_subscription("acct", "starter")
+                entry = self.service.upgrade_subscription(
+                    sub.subscription_id, "large", days, 2, idempotency_key=str(days)
+                )
+                self.assertEqual(entry.subtotal_cents, expected)
+                self.assertEqual(sub.plan_id, "large")
+
+    def test_invalid_requests_leave_subscription_and_key_available(self):
+        self.service.register_plan(Plan("peer", "Peer", 100))
+        self.service.register_plan(Plan("lower", "Lower", 99))
+        sid = self.sub.subscription_id
+        invalid = [
+            ("missing", "pro", 1, 2), (sid, "missing", 1, 2),
+            (sid, "starter", 1, 2), (sid, "peer", 1, 2), (sid, "lower", 1, 2),
+            (sid, "pro", 0, 0), (sid, "pro", 0, -1), (sid, "pro", -1, 2),
+            (sid, "pro", 3, 2), (sid, "pro", False, 2), (sid, "pro", 1, True),
+            (sid, "pro", 1.0, 2), (sid, "pro", 1, 2.0),
+        ]
+        for args in invalid:
+            with self.subTest(args=args), self.assertRaises(ValidationError):
+                self.service.upgrade_subscription(*args, idempotency_key="retry")
+        for key in ["", "   ", False]:
+            with self.subTest(key=key), self.assertRaises(ValidationError):
+                self.service.upgrade_subscription(sid, "pro", 1, 2, idempotency_key=key)
+        self.assertEqual(self.sub.plan_id, "starter")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [])
+        self.service.upgrade_subscription(sid, "pro", 1, 2, idempotency_key="retry")
+
+    def test_shared_ledger_replay_and_conflicts_after_another_upgrade(self):
+        sid = self.sub.subscription_id
+        other = self.service.start_subscription("acct", "starter")
+        self.service.register_plan(Plan("team", "Team", 200))
+        original = self.service.upgrade_subscription(sid, "pro", 1, 1, idempotency_key="first")
+        later = self.service.upgrade_subscription(sid, "team", 1, 1, idempotency_key="second")
+
+        retry = OrderService(self.service.ledger).upgrade_subscription
+        for args in [
+            (other.subscription_id, "pro", 1, 1), (sid, "team", 1, 1),
+            (sid, "pro", 0, 1), (sid, "pro", 1, 2),
+            (sid, "pro", True, 1), (sid, "pro", 1, True),
+        ]:
+            with self.subTest(args=args), self.assertRaises(ValidationError):
+                retry(*args, idempotency_key="first")
+        self.assertIs(retry(sid, "pro", 1, 1, idempotency_key="first"), original)
+        self.assertEqual(self.sub.plan_id, "team")
+        self.assertEqual(other.plan_id, "starter")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [original, later])
