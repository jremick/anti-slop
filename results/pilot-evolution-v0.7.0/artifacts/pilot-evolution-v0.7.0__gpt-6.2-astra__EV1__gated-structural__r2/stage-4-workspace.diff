+import unittest
+from unittest.mock import Mock, patch
+
+from ev1_order_ledger import LineItem, OrderService, Plan
+
+
+class AuditTests(unittest.TestCase):
+    def setUp(self):
+        self.events = []
+        self.sink = Mock(side_effect=self.events.append)
+        self.service = OrderService(audit_sink=self.sink)
+        self.items = [LineItem("book", 100, 1)]
+        self.service.register_plan(Plan("basic", "Basic", 100))
+        self.service.register_plan(Plan("pro", "Pro", 300))
+        self.sub = self.service.start_subscription("account", "basic")
+
+    def upgrade(self):
+        return self.service.upgrade_subscription(
+            self.sub.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+
+    def refund(self, order):
+        return self.service.refund_order(
+            order.order_id, 25, reason="return", idempotency_key="refund"
+        )
+
+    def test_one_signed_event_per_new_entry(self):
+        order = self.service.place_order("account", self.items, tax_bps=500)
+        charge, = self.service.ledger.entries_for_account("account")
+        upgrade = self.upgrade()
+        refund = self.refund(order)
+        self.assertIs(self.upgrade(), upgrade)
+        self.assertIs(self.refund(order), refund)
+        self.assertEqual(self.events, [
+            dict(action="order_charge", account_id="account", amount_cents=105, entry_id=charge.entry_id),
+            dict(action="plan_upgrade", account_id="account", amount_cents=100, entry_id=upgrade.entry_id),
+            dict(action="order_refund", account_id="account", amount_cents=-25, entry_id=refund.entry_id),
+        ])
+
+    def test_failed_order_audit_leaves_no_order_or_entry(self):
+        ledger = self.service.ledger
+        self.sink.side_effect = RuntimeError("sink unavailable")
+        with patch.object(ledger, "save_order", wraps=ledger.save_order) as save_order:
+            with self.assertRaisesRegex(RuntimeError, "sink unavailable"):
+                self.service.place_order("account", self.items)
+            save_order.assert_not_called()
+        self.assertEqual(ledger.entries_for_account("account"), [])
+
+    def test_failed_upgrade_and_refund_can_retry_with_same_keys(self):
+        order = self.service.place_order("account", self.items)
+        ledger = self.service.ledger
+        charge, = ledger.entries_for_account("account")
+        self.sink.side_effect = RuntimeError("sink unavailable")
+        with self.assertRaisesRegex(RuntimeError, "sink unavailable"):
+            self.upgrade()
+        with self.assertRaisesRegex(RuntimeError, "sink unavailable"):
+            self.refund(order)
+        self.assertEqual(self.sub.plan_id, "basic")
+        self.assertEqual(ledger.entries_for_account("account"), [charge])
+        self.sink.side_effect = self.events.append
+        upgrade = self.upgrade()
+        refund = self.refund(order)
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertEqual(ledger.entries_for_account("account"), [charge, upgrade, refund])
+        self.assertEqual([event["entry_id"] for event in self.events],
+                         [charge.entry_id, upgrade.entry_id, refund.entry_id])

