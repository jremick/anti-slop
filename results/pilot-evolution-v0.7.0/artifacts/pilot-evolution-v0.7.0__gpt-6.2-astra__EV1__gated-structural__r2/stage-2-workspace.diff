+
+    def test_percentage_discount_includes_fee_and_rounds_before_tax(self):
+        self.service.register_promo("HALF", percent_off=50, min_subtotal_cents=601)
+        order = self.service.place_order(
+            "acct", self.items, legacy_flat_fee=True, tax_bps=1000, promo_code="HALF"
+        )
+        self.assertEqual(order.promo_code, "HALF")
+        self.assertEqual(order.discount_cents, 301)
+        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (300, 30, 330))
+        entry, = self.service.ledger.entries_for_account("acct")
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (300, 30, 330))
+
+    def test_fixed_discount_clamped_on_expiry_date(self):
+        self.service.register_promo("GIFT", amount_off_cents=200, expires_on="2024-02-29")
+        order = self.service.place_order(
+            "acct", self.items, promo_code="GIFT", as_of="2024-02-29", tax_bps=800
+        )
+        self.assertEqual(order.discount_cents, 101)
+        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (0, 0, 0))
+
+    def test_invalid_promo_registration(self):
+        for code, options in [
+            ("A", {}), ("A", dict(percent_off=1, amount_off_cents=1)),
+            ("", dict(percent_off=1)), ("  ", dict(percent_off=1)),
+            ("A,B", dict(percent_off=1)), ("A", dict(percent_off=0)),
+            ("A", dict(percent_off=101)), ("A", dict(percent_off=True)),
+            ("A", dict(amount_off_cents=0)), ("A", dict(amount_off_cents=1.5)),
+            ("A", dict(percent_off=1, min_subtotal_cents=-1)),
+            ("A", dict(percent_off=1, expires_on="2023-02-29")),
+        ]:
+            with self.subTest(code=code, options=options), self.assertRaises(ValidationError):
+                self.service.register_promo(code, **options)
+
+    def test_ineligible_promos_leave_no_charge(self):
+        self.service.register_promo("A", percent_off=20, expires_on="2025-01-31")
+        self.service.register_promo("B", amount_off_cents=1, min_subtotal_cents=102)
+        for code, as_of in [
+            ("A", None), ("A", "2025-02-01"), ("A", "20250130"),
+            ("A", "2025-01-32"), ("A,B", "2025-01-30"), ("unknown", None), ("B", None),
+        ]:
