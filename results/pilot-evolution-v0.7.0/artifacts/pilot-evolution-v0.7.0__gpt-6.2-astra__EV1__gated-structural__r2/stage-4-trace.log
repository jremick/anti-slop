{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc 'cat benchmarks/sources/ev1_order_ledger/{api,ledger,pricing,tests/test_orders,tests/test_promos}.py'","aggregated_output":"\"\"\"Service facade coordinating pricing and ledger persistence for EV1.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Dict, Sequence\n\nfrom .ledger import OrderLedger\nfrom .models import LedgerEntry, LineItem, Order, Plan, Promo, Subscription, ValidationError\nfrom .pricing import (\n    LEGACY_FLAT_FEE_CENTS, calculate_charge_totals, compute_subtotal_cents, parse_date,\n    validate_non_negative_int, validate_positive_int,\n)\n\n\nclass OrderService:\n    def __init__(self, ledger: OrderLedger | None = None) -> None:\n        self.ledger = ledger if ledger is not None else OrderLedger()\n\n    def register_plan(self, plan: Plan) -> None:\n        self.ledger.add_plan(plan)\n\n    def register_promo(\n        self,\n        code: str,\n        *,\n        percent_off: int | None = None,\n        amount_off_cents: int | None = None,\n        expires_on: str | None = None,\n        min_subtotal_cents: int = 0,\n    ) -> None:\n        if not isinstance(code, str) or not code.strip() or \",\" in code:\n            raise ValidationError(\"a single non-empty promo code is required\")\n        if (percent_off is None) == (amount_off_cents is None):\n            raise ValidationError(\"provide exactly one promo discount\")\n        if percent_off is not None:\n            validate_positive_int(percent_off, \"percent_off\")\n            if percent_off > 100:\n                raise ValidationError(\"percent_off cannot exceed 100\")\n        else:\n            validate_positive_int(amount_off_cents, \"amount_off_cents\")\n        validate_non_negative_int(min_subtotal_cents, \"min_subtotal_cents\")\n        expiry = parse_date(expires_on, \"expires_on\") if expires_on is not None else None\n        self.ledger.add_promo(Promo(code, percent_off, amount_off_cents, expiry, min_subtotal_cents))\n\n    def place_order(\n        self,\n        account_id: str,\n        items: Sequence[LineItem],\n        *,\n        tax_bps: int = 0,\n        legacy_flat_fee: bool = False,\n        promo_code: str | None = None,\n        as_of: str | None = None,\n    ) -> Order:\n        if not account_id.strip():\n            raise ValidationError(\"account_id must be non-empty\")\n        gross = compute_subtotal_cents(items)\n        if legacy_flat_fee:\n            gross += LEGACY_FLAT_FEE_CENTS\n        subtotal, tax, total = calculate_charge_totals(\n            gross, tax_bps, self.ledger.get_promo(promo_code), as_of,\n        )\n        order_id = self.ledger.next_id(\"ord\")\n        order = Order(\n            order_id=order_id,\n            account_id=account_id,\n            items=tuple(items),\n            discount_cents=gross - subtotal,\n            promo_code=promo_code,\n            subtotal_cents=subtotal,\n            tax_cents=tax,\n            total_cents=total,\n        )\n        self.ledger.save_order(order)\n        entry = LedgerEntry(\n            entry_id=self.ledger.next_id(\"ent\"),\n            account_id=account_id,\n            kind=\"order_charge\",\n            subtotal_cents=subtotal,\n            tax_cents=tax,\n            total_cents=total,\n            reference_id=order_id,\n        )\n        self.ledger.record_entry(entry)\n        return order\n\n    def refund_order(\n        self, order_id: str, amount_cents: int, *, reason: str, idempotency_key: str,\n    ) -> LedgerEntry:\n        return self.ledger.refund_order(\n            order_id, amount_cents, reason=reason, idempotency_key=idempotency_key,\n        )\n\n    def export_credit_note(self, refund_entry_id: str) -> dict[str, str | int]:\n        entry = self.ledger.get_entry(refund_entry_id)\n        if entry is None or entry.kind != \"order_refund\":\n            raise ValidationError(f\"Unknown refund entry: {refund_entry_id}\")\n        return {\n            \"entry_id\": entry.entry_id,\n            \"order_id\": entry.reference_id,\n            \"account_id\": entry.account_id,\n            \"subtotal_cents\": -entry.subtotal_cents,\n            \"tax_cents\": -entry.tax_cents,\n            \"total_cents\": -entry.total_cents,\n            \"reason\": entry.reason,\n        }\n\n    def start_subscription(self, account_id: str, plan_id: str) -> Subscription:\n        if not account_id.strip():\n            raise ValidationError(\"account_id must be non-empty\")\n        self.ledger.get_plan(plan_id)\n        sub = Subscription(\n            subscription_id=self.ledger.next_id(\"sub\"),\n            account_id=account_id,\n            plan_id=plan_id,\n        )\n        self.ledger.save_subscription(sub)\n        return sub\n\n    def upgrade_subscription(\n        self,\n        subscription_id: str,\n        new_plan_id: str,\n        days_remaining: int,\n        cycle_days: int,\n        *,\n        idempotency_key: str,\n        promo_code: str | None = None,\n        as_of: str | None = None,\n    ) -> LedgerEntry:\n        return self.ledger.upgrade_subscription(\n            subscription_id, new_plan_id, days_remaining, cycle_days,\n            idempotency_key=idempotency_key, promo_code=promo_code, as_of=as_of,\n        )\n\n    def get_statement(self, account_id: str) -> Dict[str, object]:\n        entries = self.ledger.entries_for_account(account_id)\n        return {\n            \"account_id\": account_id,\n            \"balance_cents\": self.ledger.account_balance_cents(account_id),\n            \"entry_count\": len(entries),\n        }\n\"\"\"In-memory order, subscription, and ledger store for EV1.\"\"\"\n\nfrom __future__ import annotations\n\nfrom threading import RLock\nfrom typing import Dict, List, Optional\n\nfrom .models import LedgerEntry, Order, Plan, Promo, Subscription, ValidationError\nfrom .pricing import (\n    calculate_upgrade_totals, round_half_up_div, validate_non_negative_int, validate_positive_int,\n)\n\n\nclass OrderLedger:\n    def __init__(self) -> None:\n        self._promos: Dict[str, Promo] = {}\n        self._plans: Dict[str, Plan] = {}\n        self._orders: Dict[str, Order] = {}\n        self._subscriptions: Dict[str, Subscription] = {}\n        self._entries: Dict[str, LedgerEntry] = {}\n        self._entry_order: List[str] = []\n        self._requests: Dict[str, tuple[tuple[object, ...], LedgerEntry]] = {}\n        self._lock = RLock()\n        self._seq = 0\n\n    def next_id(self, prefix: str) -> str:\n        with self._lock:\n            self._seq += 1\n            return f\"{prefix}_{self._seq:04d}\"\n\n    def add_promo(self, promo: Promo) -> None:\n        self._promos[promo.code] = promo\n\n    def get_promo(self, code: str | None) -> Promo | None:\n        if code is None:\n            return None\n        if not isinstance(code, str) or code not in self._promos:\n            raise ValidationError(f\"Unknown promo code: {code}\")\n        return self._promos[code]\n\n    def add_plan(self, plan: Plan) -> None:\n        if not plan.plan_id.strip():\n            raise ValidationError(\"plan_id must be non-empty\")\n        if isinstance(plan.monthly_cents, bool) or not isinstance(plan.monthly_cents, int) or plan.monthly_cents < 0:\n            raise ValidationError(\"monthly_cents must be a non-negative integer\")\n        self._plans[plan.plan_id] = plan\n\n    def get_plan(self, plan_id: str) -> Plan:\n        plan = self._plans.get(plan_id)\n        if plan is None:\n            raise ValidationError(f\"Unknown plan_id: {plan_id}\")\n        return plan\n\n    def save_order(self, order: Order) -> None:\n        self._orders[order.order_id] = order\n\n    def get_order(self, order_id: str) -> Order:\n        order = self._orders.get(order_id)\n        if order is None:\n            raise ValidationError(f\"Unknown order_id: {order_id}\")\n        return order\n\n    def save_subscription(self, sub: Subscription) -> None:\n        self._subscriptions[sub.subscription_id] = sub\n\n    def get_subscription(self, subscription_id: str) -> Subscription:\n        sub = self._subscriptions.get(subscription_id)\n        if sub is None:\n            raise ValidationError(f\"Unknown subscription_id: {subscription_id}\")\n        return sub\n\n    def _replay(self, key: str, request: tuple[object, ...]) -> LedgerEntry | None:\n        if not isinstance(key, str) or not key.strip():\n            raise ValidationError(\"idempotency_key must be a non-empty string\")\n        previous = self._requests.get(key)\n        if previous is None:\n            return None\n        previous_request, entry = previous\n        if previous_request != request:\n            raise ValidationError(\"idempotency_key already used for a different request\")\n        return entry\n\n    def refund_order(\n        self, order_id: str, amount_cents: int, *, reason: str, idempotency_key: str,\n    ) -> LedgerEntry:\n        validate_positive_int(amount_cents, \"amount_cents\")\n        if not isinstance(reason, str) or not reason.strip():\n            raise ValidationError(\"reason must be a non-empty string\")\n        if not isinstance(order_id, str):\n            raise ValidationError(\"order_id must be a string\")\n        request = (\"order_refund\", order_id, amount_cents, reason)\n        with self._lock:\n            replay = self._replay(idempotency_key, request)\n            if replay is not None:\n                return replay\n            order = self.get_order(order_id)\n            refunded = 0\n            tax_reversed = 0\n            for entry in self.entries_for_account(order.account_id):\n                if entry.kind == \"order_refund\" and entry.reference_id == order_id:\n                    refunded -= entry.total_cents\n                    tax_reversed -= entry.tax_cents\n            cumulative = refunded + amount_cents\n            if cumulative > order.total_cents:\n                raise ValidationError(\"refund exceeds the remaining order balance\")\n            cumulative_tax = round_half_up_div(cumulative * order.tax_cents, order.total_cents)\n            refund_tax = cumulative_tax - tax_reversed\n            refund = LedgerEntry(\n                entry_id=self.next_id(\"ent\"),\n                account_id=order.account_id,\n                kind=\"order_refund\",\n                subtotal_cents=-(amount_cents - refund_tax),\n                tax_cents=-refund_tax,\n                total_cents=-amount_cents,\n                reference_id=order_id,\n                reason=reason,\n            )\n            self.record_entry(refund)\n            self._requests[idempotency_key] = (request, refund)\n            return refund\n\n    def upgrade_subscription(\n        self,\n        subscription_id: str,\n        new_plan_id: str,\n        days_remaining: int,\n        cycle_days: int,\n        *,\n        idempotency_key: str,\n        promo_code: str | None = None,\n        as_of: str | None = None,\n    ) -> LedgerEntry:\n        validate_non_negative_int(days_remaining, \"days_remaining\")\n        validate_positive_int(cycle_days, \"cycle_days\")\n        if days_remaining > cycle_days:\n            raise ValidationError(\"days_remaining cannot exceed cycle_days\")\n        request = (\"plan_upgrade\", subscription_id, new_plan_id, days_remaining, cycle_days, promo_code, as_of)\n        with self._lock:\n            replay = self._replay(idempotency_key, request)\n            if replay is not None:\n                return replay\n\n            sub = self.get_subscription(subscription_id)\n            old_plan = self.get_plan(sub.plan_id)\n            new_plan = self.get_plan(new_plan_id)\n            subtotal, tax, total = calculate_upgrade_totals(\n                old_plan, new_plan, days_remaining, cycle_days,\n                promo=self.get_promo(promo_code), as_of=as_of,\n            )\n            entry = LedgerEntry(\n                entry_id=self.next_id(\"ent\"),\n                account_id=sub.account_id,\n                kind=\"plan_upgrade\",\n                subtotal_cents=subtotal,\n                tax_cents=tax,\n                total_cents=total,\n                reference_id=subscription_id,\n            )\n            self.record_entry(entry)\n            sub.plan_id = new_plan_id\n            self._requests[idempotency_key] = (request, entry)\n            return entry\n\n    def record_entry(self, entry: LedgerEntry) -> None:\n        self._entries[entry.entry_id] = entry\n        self._entry_order.append(entry.entry_id)\n\n    def get_entry(self, entry_id: str) -> Optional[LedgerEntry]:\n        return self._entries.get(entry_id)\n\n    def entries_for_account(self, account_id: str) -> List[LedgerEntry]:\n        return [\n            self._entries[eid]\n            for eid in self._entry_order\n            if self._entries[eid].account_id == account_id\n        ]\n\n    def account_balance_cents(self, account_id: str) -> int:\n        return sum(e.total_cents for e in self.entries_for_account(account_id))\n\"\"\"Canonical integer-cent pricing calculations for EV1 order ledger.\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import date\nfrom typing import Sequence, Tuple\n\nfrom .models import LineItem, Plan, Promo, ValidationError\n\n\nLEGACY_FLAT_FEE_CENTS = 500\n\n\ndef validate_non_negative_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value < 0:\n        raise ValidationError(f\"{field_name} must be a non-negative integer\")\n    return value\n\n\ndef validate_positive_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:\n        raise ValidationError(f\"{field_name} must be a positive integer\")\n    return value\n\n\ndef round_half_up_div(numerator: int, denominator: int) -> int:\n    \"\"\"Exact integer half-up division for non-negative numerator and positive denominator.\"\"\"\n    validate_non_negative_int(numerator, \"numerator\")\n    validate_positive_int(denominator, \"denominator\")\n    return (numerator * 2 + denominator) // (2 * denominator)\n\n\ndef compute_subtotal_cents(items: Sequence[LineItem]) -> int:\n    if not items:\n        raise ValidationError(\"items must be non-empty\")\n    subtotal = 0\n    for item in items:\n        validate_positive_int(item.unit_cents, \"unit_cents\")\n        validate_positive_int(item.quantity, \"quantity\")\n        subtotal += item.unit_cents * item.quantity\n    return subtotal\n\n\ndef compute_tax_cents(taxable_cents: int, tax_bps: int) -> int:\n    validate_non_negative_int(taxable_cents, \"taxable_cents\")\n    validate_non_negative_int(tax_bps, \"tax_bps\")\n    if tax_bps > 10_000:\n        raise ValidationError(\"tax_bps cannot exceed 10000\")\n    return round_half_up_div(taxable_cents * tax_bps, 10_000)\n\n\ndef parse_date(value: str, field_name: str) -> date:\n    try:\n        parsed = date.fromisoformat(value)\n    except (TypeError, ValueError):\n        raise ValidationError(f\"{field_name} must be a YYYY-MM-DD date\") from None\n    if parsed.isoformat() != value:\n        raise ValidationError(f\"{field_name} must be a YYYY-MM-DD date\")\n    return parsed\n\n\ndef calculate_charge_totals(\n    subtotal: int, tax_bps: int, promo: Promo | None = None, as_of: str | None = None,\n) -> Tuple[int, int, int]:\n    charge_date = parse_date(as_of, \"as_of\") if as_of is not None else None\n    if promo is not None:\n        if subtotal < promo.min_subtotal_cents:\n            raise ValidationError(\"subtotal is below the promo minimum\")\n        if promo.expires_on is not None and (charge_date is None or charge_date > promo.expires_on):\n            raise ValidationError(\"an as_of date on or before promo expiry is required\")\n        if promo.percent_off is not None:\n            discount = round_half_up_div(subtotal * promo.percent_off, 100)\n        else:\n            discount = promo.amount_off_cents\n        subtotal = max(0, subtotal - discount)\n    tax = compute_tax_cents(subtotal, tax_bps)\n    return subtotal, tax, subtotal + tax\n\n\ndef calculate_upgrade_totals(\n    old_plan: Plan, new_plan: Plan, days_remaining: int, cycle_days: int,\n    *, promo: Promo | None = None, as_of: str | None = None,\n) -> Tuple[int, int, int]:\n    difference = new_plan.monthly_cents - old_plan.monthly_cents\n    if difference <= 0:\n        raise ValidationError(\"new plan must have a higher monthly price\")\n    subtotal = round_half_up_div(difference * days_remaining, cycle_days)\n    return calculate_charge_totals(subtotal, new_plan.tax_bps, promo, as_of)\n\"\"\"Baseline unit tests for the initial EV1 order ledger fixture.\"\"\"\n\nfrom __future__ import annotations\n\nimport unittest\n\nfrom ev1_order_ledger.api import OrderService\nfrom ev1_order_ledger.models import LineItem, Plan, ValidationError\n\n\nclass BaselineOrderLedgerTests(unittest.TestCase):\n    def setUp(self) -> None:\n        self.svc = OrderService()\n        self.svc.register_plan(Plan(plan_id=\"starter\", name=\"Starter\", monthly_cents=1000, tax_bps=825))\n        self.svc.register_plan(Plan(plan_id=\"pro\", name=\"Pro\", monthly_cents=3000, tax_bps=825))\n\n    def test_place_order_computes_exact_integer_tax_and_records_entry(self) -> None:\n        order = self.svc.place_order(\n            \"acct_1\",\n            [LineItem(sku=\"seat\", unit_cents=1999, quantity=2)],\n            tax_bps=825,\n        )\n        self.assertEqual(order.subtotal_cents, 3998)\n        self.assertEqual(order.tax_cents, 330)  # 3998 * 825 / 10000 = 329.835 -> 330\n        self.assertEqual(order.total_cents, 4328)\n        stmt = self.svc.get_statement(\"acct_1\")\n        self.assertEqual(stmt[\"balance_cents\"], 4328)\n        self.assertEqual(stmt[\"entry_count\"], 1)\n\n    def test_legacy_flat_fee_adds_500_cents_before_tax(self) -> None:\n        order = self.svc.place_order(\n            \"acct_1\",\n            [LineItem(sku=\"seat\", unit_cents=1000, quantity=1)],\n            tax_bps=1000,\n            legacy_flat_fee=True,\n        )\n        self.assertEqual(order.subtotal_cents, 1500)\n        self.assertEqual(order.tax_cents, 150)\n        self.assertEqual(order.total_cents, 1650)\n\n    def test_invalid_order_inputs_fail_closed(self) -> None:\n        with self.assertRaises(ValidationError):\n            self.svc.place_order(\"\", [LineItem(sku=\"x\", unit_cents=100, quantity=1)])\n        with self.assertRaises(ValidationError):\n            self.svc.place_order(\"acct_1\", [])\n        with self.assertRaises(ValidationError):\n            self.svc.place_order(\"acct_1\", [LineItem(sku=\"x\", unit_cents=0, quantity=1)])\n\n    def test_start_subscription_validates_plan(self) -> None:\n        sub = self.svc.start_subscription(\"acct_1\", \"starter\")\n        self.assertEqual(sub.plan_id, \"starter\")\n        with self.assertRaises(ValidationError):\n            self.svc.start_subscription(\"acct_1\", \"nonexistent\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\nimport unittest\n\nfrom ev1_order_ledger import LineItem, OrderService, Plan, ValidationError\n\n\nclass PromoTests(unittest.TestCase):\n    def setUp(self):\n        self.service = OrderService()\n        self.items = [LineItem(\"seat\", 101, 1)]\n\n    def test_percentage_discount_includes_fee_and_rounds_before_tax(self):\n        self.service.register_promo(\"HALF\", percent_off=50, min_subtotal_cents=601)\n        order = self.service.place_order(\n            \"acct\", self.items, legacy_flat_fee=True, tax_bps=1000, promo_code=\"HALF\"\n        )\n        self.assertEqual(order.promo_code, \"HALF\")\n        self.assertEqual(order.discount_cents, 301)\n        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (300, 30, 330))\n        entry, = self.service.ledger.entries_for_account(\"acct\")\n        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (300, 30, 330))\n\n    def test_fixed_discount_clamped_on_expiry_date(self):\n        self.service.register_promo(\"GIFT\", amount_off_cents=200, expires_on=\"2024-02-29\")\n        order = self.service.place_order(\n            \"acct\", self.items, promo_code=\"GIFT\", as_of=\"2024-02-29\", tax_bps=800\n        )\n        self.assertEqual(order.discount_cents, 101)\n        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (0, 0, 0))\n\n    def test_invalid_promo_registration(self):\n        for code, options in [\n            (\"A\", {}), (\"A\", dict(percent_off=1, amount_off_cents=1)),\n            (\"\", dict(percent_off=1)), (\"  \", dict(percent_off=1)),\n            (\"A,B\", dict(percent_off=1)), (\"A\", dict(percent_off=0)),\n            (\"A\", dict(percent_off=101)), (\"A\", dict(percent_off=True)),\n            (\"A\", dict(amount_off_cents=0)), (\"A\", dict(amount_off_cents=1.5)),\n            (\"A\", dict(percent_off=1, min_subtotal_cents=-1)),\n            (\"A\", dict(percent_off=1, expires_on=\"2023-02-29\")),\n        ]:\n            with self.subTest(code=code, options=options), self.assertRaises(ValidationError):\n                self.service.register_promo(code, **options)\n\n    def test_ineligible_promos_leave_no_charge(self):\n        self.service.register_promo(\"A\", percent_off=20, expires_on=\"2025-01-31\")\n        self.service.register_promo(\"B\", amount_off_cents=1, min_subtotal_cents=102)\n        for code, as_of in [\n            (\"A\", None), (\"A\", \"2025-02-01\"), (\"A\", \"20250130\"),\n            (\"A\", \"2025-01-32\"), (\"A,B\", \"2025-01-30\"), (\"unknown\", None), (\"B\", None),\n        ]:\n            with self.subTest(code=code, as_of=as_of), self.assertRaises(ValidationError):\n                self.service.place_order(\"acct\", self.items, promo_code=code, as_of=as_of)\n        self.assertEqual(self.service.ledger.entries_for_account(\"acct\"), [])\n\n    def test_upgrade_uses_prorated_subtotal_and_replays_original_charge(self):\n        self.service.register_plan(Plan(\"basic\", \"Basic\", 100))\n        self.service.register_plan(Plan(\"pro\", \"Pro\", 301, tax_bps=1000))\n        self.service.register_promo(\"CREDIT\", amount_off_cents=11, min_subtotal_cents=101)\n        sub = self.service.start_subscription(\"acct\", \"basic\")\n        upgrade = OrderService(self.service.ledger).upgrade_subscription\n        with self.assertRaises(ValidationError):\n            upgrade(sub.subscription_id, \"pro\", 1, 3, promo_code=\"CREDIT\", idempotency_key=\"u\")\n        self.assertEqual(sub.plan_id, \"basic\")\n        args = (sub.subscription_id, \"pro\", 1, 2)\n        entry = upgrade(*args, promo_code=\"CREDIT\", as_of=\"2025-01-01\", idempotency_key=\"u\")\n        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (90, 9, 99))\n        self.assertEqual(sub.plan_id, \"pro\")\n        self.service.register_promo(\"CREDIT\", percent_off=100)\n        self.assertIs(upgrade(*args, promo_code=\"CREDIT\", as_of=\"2025-01-01\", idempotency_key=\"u\"), entry)\n        for code, as_of in [(None, \"2025-01-01\"), (\"CREDIT\", \"2025-01-02\")]:\n            with self.subTest(code=code, as_of=as_of), self.assertRaises(ValidationError):\n                upgrade(*args, promo_code=code, as_of=as_of, idempotency_key=\"u\")\n        self.assertEqual(self.service.ledger.entries_for_account(\"acct\"), [entry])\n","exit_code":0,"status":"completed"}}
