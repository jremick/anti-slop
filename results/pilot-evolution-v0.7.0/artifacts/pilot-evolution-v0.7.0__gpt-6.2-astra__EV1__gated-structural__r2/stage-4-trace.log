{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cat > benchmarks/sources/ev1_order_ledger/tests/test_audit.py <<'PY'\nimport unittest\nfrom unittest.mock import Mock, patch\n\nfrom ev1_order_ledger import LineItem, OrderService, Plan\n\n\nclass AuditTests(unittest.TestCase):\n    def setUp(self):\n        self.events = []\n        self.sink = Mock(side_effect=self.events.append)\n        self.service = OrderService(audit_sink=self.sink)\n        self.items = [LineItem(\\\"book\\\", 100, 1)]\n        self.service.register_plan(Plan(\\\"basic\\\", \\\"Basic\\\", 100))\n        self.service.register_plan(Plan(\\\"pro\\\", \\\"Pro\\\", 300))\n        self.sub = self.service.start_subscription(\\\"account\\\", \\\"basic\\\")\n\n    def upgrade(self):\n        return self.service.upgrade_subscription(\n            self.sub.subscription_id, \\\"pro\\\", 1, 2, idempotency_key=\\\"upgrade\\\"\n        )\n\n    def refund(self, order):\n        return self.service.refund_order(\n            order.order_id, 25, reason=\\\"return\\\", idempotency_key=\\\"refund\\\"\n        )\n\n    def test_one_signed_event_per_new_entry(self):\n        order = self.service.place_order(\\\"account\\\", self.items, tax_bps=500)\n        charge, = self.service.ledger.entries_for_account(\\\"account\\\")\n        upgrade = self.upgrade()\n        refund = self.refund(order)\n        self.assertIs(self.upgrade(), upgrade)\n        self.assertIs(self.refund(order), refund)\n        self.assertEqual(self.events, [\n            dict(action=\\\"order_charge\\\", account_id=\\\"account\\\", amount_cents=105, entry_id=charge.entry_id),\n            dict(action=\\\"plan_upgrade\\\", account_id=\\\"account\\\", amount_cents=100, entry_id=upgrade.entry_id),\n            dict(action=\\\"order_refund\\\", account_id=\\\"account\\\", amount_cents=-25, entry_id=refund.entry_id),\n        ])\n\n    def test_failed_order_audit_leaves_no_order_or_entry(self):\n        ledger = self.service.ledger\n        self.sink.side_effect = RuntimeError(\\\"sink unavailable\\\")\n        with patch.object(ledger, \\\"save_order\\\", wraps=ledger.save_order) as save_order:\n            with self.assertRaisesRegex(RuntimeError, \\\"sink unavailable\\\"):\n                self.service.place_order(\\\"account\\\", self.items)\n            save_order.assert_not_called()\n        self.assertEqual(ledger.entries_for_account(\\\"account\\\"), [])\n\n    def test_failed_upgrade_and_refund_can_retry_with_same_keys(self):\n        order = self.service.place_order(\\\"account\\\", self.items)\n        ledger = self.service.ledger\n        charge, = ledger.entries_for_account(\\\"account\\\")\n        self.sink.side_effect = RuntimeError(\\\"sink unavailable\\\")\n        with self.assertRaisesRegex(RuntimeError, \\\"sink unavailable\\\"):\n            self.upgrade()\n        with self.assertRaisesRegex(RuntimeError, \\\"sink unavailable\\\"):\n            self.refund(order)\n        self.assertEqual(self.sub.plan_id, \\\"basic\\\")\n        self.assertEqual(ledger.entries_for_account(\\\"account\\\"), [charge])\n        self.sink.side_effect = self.events.append\n        upgrade = self.upgrade()\n        refund = self.refund(order)\n        self.assertEqual(self.sub.plan_id, \\\"pro\\\")\n        self.assertEqual(ledger.entries_for_account(\\\"account\\\"), [charge, upgrade, refund])\n        self.assertEqual([event[\\\"entry_id\\\"] for event in self.events],\n                         [charge.entry_id, upgrade.entry_id, refund.entry_id])\nPY\npython3 benchmarks/sources/ev1_order_ledger/run_checks.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
