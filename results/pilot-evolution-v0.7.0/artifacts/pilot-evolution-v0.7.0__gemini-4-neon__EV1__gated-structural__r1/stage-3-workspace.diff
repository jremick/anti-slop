+def validate_promo_code(code: str) -> str:
+    if not isinstance(code, str) or not code.strip():
+        raise ValidationError("promo_code must be a non-empty string")
+    if any(sep in code for sep in _PROMO_STACK_SEPARATORS) or any(ch.isspace() for ch in code):
+        raise ValidationError("Multiple or stacked promo codes are not allowed")
+    return code
