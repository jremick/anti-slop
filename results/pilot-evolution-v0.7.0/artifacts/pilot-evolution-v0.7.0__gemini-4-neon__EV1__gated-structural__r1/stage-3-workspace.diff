+    )
+    subtotal, _discount, tax, total = apply_discount_and_tax(pre_discount, tax_bps)
+    return subtotal, tax, total
+
+
+def validate_proration_window(days_remaining: int, cycle_days: int) -> Tuple[int, int]:
+    """Validate integer proration window bounds, rejecting booleans and out-of-range values."""
+    validate_positive_int(cycle_days, "cycle_days")
+    validate_non_negative_int(days_remaining, "days_remaining")
+    if days_remaining > cycle_days:
+        raise ValidationError("days_remaining cannot exceed cycle_days")
+    return days_remaining, cycle_days
+
+
+def compute_prorated_upgrade_cents(
+    old_monthly_cents: int,
+    new_monthly_cents: int,
+    days_remaining: int,
+    cycle_days: int,
+) -> int:
+    """Compute exact integer-cent half-up proration for a mid-cycle plan upgrade."""
+    validate_non_negative_int(old_monthly_cents, "old_monthly_cents")
+    validate_non_negative_int(new_monthly_cents, "new_monthly_cents")
+    validate_proration_window(days_remaining, cycle_days)
+    if new_monthly_cents <= old_monthly_cents:
+        raise ValidationError("new_plan monthly_cents must exceed current plan monthly_cents")
+    delta_cents = new_monthly_cents - old_monthly_cents
+    return round_half_up_div(delta_cents * days_remaining, cycle_days)
+
+
+def calculate_upgrade_totals(
+    old_plan: Plan,
+    new_plan: Plan,
+    days_remaining: int,
+    cycle_days: int,
+) -> Tuple[int, int, int]:
+    """Return (subtotal_cents, tax_cents, total_cents) for a prorated mid-cycle plan upgrade."""
+    pre_discount = compute_prorated_upgrade_cents(
+        old_plan.monthly_cents,
+        new_plan.monthly_cents,
+        days_remaining,
+        cycle_days,
+    )
+    subtotal, _discount, tax, total = apply_discount_and_tax(pre_discount, new_plan.tax_bps)
+    return subtotal, tax, total
+
+
+def compute_cumulative_refund_split(
+    order_total_cents: int,
+    order_tax_cents: int,
+    already_refunded_total_cents: int,
+    already_refunded_tax_cents: int,
+    refund_amount_cents: int,
+) -> Tuple[int, int]:
+    """Return (refund_subtotal_cents, refund_tax_cents) with cumulative exact penny conservation."""
+    validate_non_negative_int(order_total_cents, "order_total_cents")
+    validate_non_negative_int(order_tax_cents, "order_tax_cents")
+    validate_non_negative_int(already_refunded_total_cents, "already_refunded_total_cents")
+    validate_non_negative_int(already_refunded_tax_cents, "already_refunded_tax_cents")
+    validate_positive_int(refund_amount_cents, "amount_cents")
+    if order_tax_cents > order_total_cents:
+        raise ValidationError("order_tax_cents cannot exceed order_total_cents")
+    new_cumulative_total = already_refunded_total_cents + refund_amount_cents
+    if new_cumulative_total > order_total_cents:
+        remaining = order_total_cents - already_refunded_total_cents
+        raise ValidationError(
+            f"Refund of {refund_amount_cents} exceeds remaining refundable total {remaining}"
+        )
+    target_cumulative_tax = round_half_up_div(order_tax_cents * new_cumulative_total, order_total_cents)
+    refund_tax = target_cumulative_tax - already_refunded_tax_cents
+    refund_subtotal = refund_amount_cents - refund_tax
+    return refund_subtotal, refund_tax

