+class SubscriptionUpgradeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=500))
+        self.svc.register_plan(Plan(plan_id="starter_alt", name="Starter Alt", monthly_cents=1000, tax_bps=500))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="enterprise", name="Enterprise", monthly_cents=7500, tax_bps=1000))
+
+    def test_mid_cycle_upgrade_proration_tax_and_ledger_entry(self) -> None:
+        sub = self.svc.start_subscription("acct_1", "starter")
+        entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="upg-001",
+        )
+        # Delta = 2000, 15/30 -> 1000 subtotal; tax uses new_plan.tax_bps (825): 1000 * 825 / 10000 = 82.5 -> 83
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, sub.subscription_id)
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual(entry.subtotal_cents, 1000)
+        self.assertEqual(entry.tax_cents, 83)
+        self.assertEqual(entry.total_cents, 1083)
+
+        self.assertEqual(sub.plan_id, "pro")
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "pro")
+        stmt = self.svc.get_statement("acct_1")
+        self.assertEqual(stmt["balance_cents"], 1083)
+        self.assertEqual(stmt["entry_count"], 1)
+
+    def test_proration_uses_exact_half_up_rounding(self) -> None:
+        # 0.5 -> 1 (half-up, not banker's 0)
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 1001, 1, 2), 1)
+        # 2.5 -> 3 (half-up, not banker's 2)
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 1005, 1, 2), 3)
+        # 750.5 -> 751 (half-up, not banker's 750)
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 2501, 15, 30), 751)
+        # 333.333... -> 333 and 666.666... -> 667
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 2000, 1, 3), 333)
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 2000, 2, 3), 667)
+
+        # End-to-end via OrderService with half-up proration and tax
+        self.svc.register_plan(Plan(plan_id="plus", name="Plus", monthly_cents=2501, tax_bps=1000))
+        sub = self.svc.start_subscription("acct_half_up", "starter")
+        entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "plus",
+            15,
+            30,
+            idempotency_key="upg-half-up",
+        )
+        # 1501 * 15 / 30 = 750.5 -> 751; tax = 751 * 1000 / 10000 = 75.1 -> 75
+        self.assertEqual(entry.subtotal_cents, 751)
+        self.assertEqual(entry.tax_cents, 75)
+        self.assertEqual(entry.total_cents, 826)
+
+    def test_proration_boundary_windows_zero_and_full_cycle(self) -> None:
+        sub_zero = self.svc.start_subscription("acct_zero", "starter")
+        entry_zero = self.svc.upgrade_subscription(
+            sub_zero.subscription_id,
+            "pro",
+            0,
+            30,
+            idempotency_key="upg-zero",
+        )
+        self.assertEqual(entry_zero.subtotal_cents, 0)
+        self.assertEqual(entry_zero.tax_cents, 0)
+        self.assertEqual(entry_zero.total_cents, 0)
+        self.assertEqual(sub_zero.plan_id, "pro")
+
+        sub_full = self.svc.start_subscription("acct_full", "starter")
+        entry_full = self.svc.upgrade_subscription(
+            sub_full.subscription_id,
+            "pro",
+            30,
+            30,
+            idempotency_key="upg-full",
+        )
+        # Delta = 2000, tax = 2000 * 825 / 10000 = 165
+        self.assertEqual(entry_full.subtotal_cents, 2000)
+        self.assertEqual(entry_full.tax_cents, 165)
+        self.assertEqual(entry_full.total_cents, 2165)
+        self.assertEqual(sub_full.plan_id, "pro")
+
+    def test_rejects_unknown_ids_and_non_upgrades(self) -> None:
+        sub = self.svc.start_subscription("acct_1", "pro")
+
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription("sub_unknown", "enterprise", 10, 30, idempotency_key="k1")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "plan_unknown", 10, 30, idempotency_key="k2")
+        # Same plan
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "pro", 10, 30, idempotency_key="k3")
+        # Downgrade
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "starter", 10, 30, idempotency_key="k4")
+
+        # Equal monthly_cents on a different plan_id
+        sub_starter = self.svc.start_subscription("acct_2", "starter")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub_starter.subscription_id, "starter_alt", 10, 30, idempotency_key="k5")
