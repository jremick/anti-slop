+    def test_rejects_invalid_bounds_booleans_and_empty_idempotency_key(self) -> None:
+        sub = self.svc.start_subscription("acct_1", "starter")
+
+        invalid_cases: list[tuple[Any, Any, Any, Any, Any]] = [
+            # Invalid cycle_days
+            (sub.subscription_id, "pro", 0, 0, "k-c0"),
+            (sub.subscription_id, "pro", 0, -30, "k-cneg"),
+            # Invalid days_remaining
+            (sub.subscription_id, "pro", -1, 30, "k-dneg"),
+            (sub.subscription_id, "pro", 31, 30, "k-dover"),
+            # Booleans rejected for int fields and string fields
+            (sub.subscription_id, "pro", True, 30, "k-b1"),
+            (sub.subscription_id, "pro", False, 30, "k-b2"),
+            (sub.subscription_id, "pro", 1, True, "k-b3"),
+            (sub.subscription_id, "pro", 0, False, "k-b4"),
+            (True, "pro", 10, 30, "k-b5"),
+            (sub.subscription_id, False, 10, 30, "k-b6"),
+            # Non-int numbers
+            (sub.subscription_id, "pro", 10.0, 30, "k-f1"),
+            (sub.subscription_id, "pro", 10, 30.0, "k-f2"),
+            # Empty / whitespace / non-string idempotency_key
+            (sub.subscription_id, "pro", 10, 30, ""),
+            (sub.subscription_id, "pro", 10, 30, "   "),
+            (sub.subscription_id, "pro", 10, 30, None),
+            (sub.subscription_id, "pro", 10, 30, True),
+            (sub.subscription_id, "pro", 10, 30, 123),
