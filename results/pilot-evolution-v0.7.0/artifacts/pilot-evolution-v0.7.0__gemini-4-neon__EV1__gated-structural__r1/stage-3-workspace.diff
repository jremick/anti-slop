+def parse_iso_date(value: str, field_name: str) -> date:
+    if (
+        not isinstance(value, str)
+        or len(value) != 10
+        or value[4] != "-"
+        or value[7] != "-"
+        or not (value[:4].isdigit() and value[5:7].isdigit() and value[8:10].isdigit())
+    ):
+        raise ValidationError(f"{field_name} must be a valid YYYY-MM-DD date string")
+    try:
+        return date.fromisoformat(value)
+    except ValueError as exc:
+        raise ValidationError(f"{field_name} must be a valid YYYY-MM-DD date string") from exc
+
+
+def build_promo_code(
+    code: str,
+    *,
+    percent_off: int | None = None,
+    amount_off_cents: int | None = None,
+    expires_on: str | None = None,
+    min_subtotal_cents: int = 0,
+) -> PromoCode:
+    """Validate and construct a canonical PromoCode."""
+    valid_code = validate_promo_code(code)
+    if (percent_off is None) == (amount_off_cents is None):
+        raise ValidationError("Exactly one of percent_off or amount_off_cents must be specified")
+    if percent_off is not None:
+        validate_positive_int(percent_off, "percent_off")
+        if percent_off > 100:
+            raise ValidationError("percent_off must be between 1 and 100")
+    if amount_off_cents is not None:
+        validate_positive_int(amount_off_cents, "amount_off_cents")
+    validate_non_negative_int(min_subtotal_cents, "min_subtotal_cents")
+    if expires_on is not None:
+        parse_iso_date(expires_on, "expires_on")
+    return PromoCode(
+        code=valid_code,
+        percent_off=percent_off,
+        amount_off_cents=amount_off_cents,
+        expires_on=expires_on,
+        min_subtotal_cents=min_subtotal_cents,
+    )
