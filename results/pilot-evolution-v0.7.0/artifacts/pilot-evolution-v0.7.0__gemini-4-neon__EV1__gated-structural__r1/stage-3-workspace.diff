+
+def compute_promo_discount_cents(
+    pre_discount_subtotal_cents: int,
+    promo: PromoCode,
+    *,
+    as_of: str | None = None,
+) -> int:
+    """Validate promo eligibility and return exact integer-cent discount clamped to subtotal."""
+    validate_non_negative_int(pre_discount_subtotal_cents, "subtotal_cents")
+    as_of_date = parse_iso_date(as_of, "as_of") if as_of is not None else None
+
+    if promo.expires_on is not None:
+        expires_date = parse_iso_date(promo.expires_on, "expires_on")
+        if as_of_date is None:
+            raise ValidationError(f"as_of is required for expiring promo code: {promo.code}")
+        if as_of_date > expires_date:
+            raise ValidationError(f"Promo code {promo.code} expired on {promo.expires_on}")
+
+    if pre_discount_subtotal_cents < promo.min_subtotal_cents:
+        raise ValidationError(
+            f"Subtotal {pre_discount_subtotal_cents} is below minimum {promo.min_subtotal_cents} for promo {promo.code}"
+        )
+
+    if promo.percent_off is not None:
+        raw_discount = round_half_up_div(pre_discount_subtotal_cents * promo.percent_off, 100)
+    elif promo.amount_off_cents is not None:
+        raw_discount = promo.amount_off_cents
+    else:
+        raise ValidationError("Promo must define exactly one of percent_off or amount_off_cents")
+
+    return min(raw_discount, pre_discount_subtotal_cents)
