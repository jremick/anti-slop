+"""Unit tests for Turn 3: penny-conserving partial refunds and credit-note export."""
+
+from __future__ import annotations
+
+from typing import Any
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, ValidationError
+
+
+class PartialRefundAndCreditNoteTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=500))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+
+    def test_three_chunk_refund_conserves_tax_and_subtotal_exactly(self) -> None:
+        # subtotal=1000, tax=83 (825 bps), total=1083
+        order = self.svc.place_order(
+            "acct_1",
+            [LineItem(sku="seat", unit_cents=1000, quantity=1)],
+            tax_bps=825,
+        )
+        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (1000, 83, 1083))
+
+        e1 = self.svc.refund_order(order.order_id, 361, reason="part 1", idempotency_key="r1")
+        e2 = self.svc.refund_order(order.order_id, 361, reason="part 2", idempotency_key="r2")
+        e3 = self.svc.refund_order(order.order_id, 361, reason="part 3", idempotency_key="r3")
+
+        # Cumulative tax targets: 28, 55, 83 -> per-chunk tax: 28, 27, 28 (zero drift)
+        self.assertEqual((e1.subtotal_cents, e1.tax_cents, e1.total_cents), (-333, -28, -361))
+        self.assertEqual((e2.subtotal_cents, e2.tax_cents, e2.total_cents), (-334, -27, -361))
+        self.assertEqual((e3.subtotal_cents, e3.tax_cents, e3.total_cents), (-333, -28, -361))
+
+        for entry, expected_reason in ((e1, "part 1"), (e2, "part 2"), (e3, "part 3")):
+            self.assertEqual(entry.kind, "order_refund")
+            self.assertEqual(entry.reference_id, order.order_id)
+            self.assertEqual(entry.reason, expected_reason)
+            self.assertEqual(entry.subtotal_cents + entry.tax_cents, entry.total_cents)
+
+        self.assertEqual(e1.subtotal_cents + e2.subtotal_cents + e3.subtotal_cents, -order.subtotal_cents)
+        self.assertEqual(e1.tax_cents + e2.tax_cents + e3.tax_cents, -order.tax_cents)
+        self.assertEqual(e1.total_cents + e2.total_cents + e3.total_cents, -order.total_cents)
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 0)
+
+    def test_uneven_and_discounted_multi_chunk_refunds_have_zero_penny_drift(self) -> None:
+        self.svc.register_promo("SAVE15", percent_off=15)
+        order = self.svc.place_order(
+            "acct_many",
+            [LineItem(sku="widget", unit_cents=1999, quantity=2)],
+            tax_bps=887,
+            promo_code="SAVE15",
+        )
+        chunks = [1, 7, 13, 250, 501, 999, 1000]
+        chunks.append(order.total_cents - sum(chunks))
+        self.assertGreater(chunks[-1], 0)
+
+        entries = [
+            self.svc.refund_order(
+                order.order_id,
+                chunk,
+                reason=f"chunk-{idx}",
+                idempotency_key=f"many-{idx}",
+            )
+            for idx, chunk in enumerate(chunks)
+        ]
+
+        for entry, chunk in zip(entries, chunks):
+            self.assertLessEqual(entry.subtotal_cents, 0)
+            self.assertLessEqual(entry.tax_cents, 0)
+            self.assertEqual(entry.total_cents, -chunk)
+            self.assertEqual(entry.subtotal_cents + entry.tax_cents, entry.total_cents)
+
+        self.assertEqual(sum(-e.subtotal_cents for e in entries), order.subtotal_cents)
+        self.assertEqual(sum(-e.tax_cents for e in entries), order.tax_cents)
+        self.assertEqual(sum(-e.total_cents for e in entries), order.total_cents)
+        self.assertEqual(self.svc.get_statement("acct_many")["balance_cents"], 0)
+
+    def test_over_refund_and_zero_total_order_rejected(self) -> None:
+        order = self.svc.place_order(
+            "acct_over",
+            [LineItem(sku="seat", unit_cents=1000, quantity=1)],
+            tax_bps=825,
+        )
