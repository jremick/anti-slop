+        self.assertEqual(order_pct.tax_cents, 85)
+        self.assertEqual(order_pct.total_cents, 939)
+        self.assertEqual(order_pct.promo_code, "SPRING")
+        self.assertEqual(self.svc.get_statement("acct_pct")["balance_cents"], 939)
+
+        # Fixed promo applied pre-tax (including legacy_flat_fee before discount).
