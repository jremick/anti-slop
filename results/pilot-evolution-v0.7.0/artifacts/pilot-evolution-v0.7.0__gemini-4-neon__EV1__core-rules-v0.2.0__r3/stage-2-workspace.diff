+
+
+class PromoCodeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=500))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=1000))
+        self.svc.register_promo("SAVE20", percent_off=20)
+        self.svc.register_promo("FLAT500", amount_off_cents=500)
+        self.svc.register_promo("HUGE5000", amount_off_cents=5000)
+        self.svc.register_promo("SPRING", percent_off=15, expires_on="2026-06-30")
+        self.svc.register_promo("MIN2000", amount_off_cents=400, min_subtotal_cents=2000)
+
+    def test_register_promo_validation(self) -> None:
+        # Must provide exactly one of percent_off or amount_off_cents.
+        with self.assertRaises(ValidationError):
+            self.svc.register_promo("NONE")
+        with self.assertRaises(ValidationError):
+            self.svc.register_promo("BOTH", percent_off=10, amount_off_cents=100)
+        with self.assertRaises(ValidationError):
+            self.svc.register_promo("BOTH_ZERO", percent_off=10, amount_off_cents=0)
+
+        # percent_off bounds and types.
+        for bad_pct in (0, -5, 101, True, False, 10.5):
+            with self.assertRaises(ValidationError):
+                self.svc.register_promo("BADPCT", percent_off=bad_pct)  # type: ignore[arg-type]
+
+        # amount_off_cents bounds and types.
+        for bad_amt in (0, -100, True, False, 12.5):
+            with self.assertRaises(ValidationError):
+                self.svc.register_promo("BADAMT", amount_off_cents=bad_amt)  # type: ignore[arg-type]
+
+        # min_subtotal_cents bounds and types.
+        for bad_min in (-1, True, False, 50.0):
+            with self.assertRaises(ValidationError):
+                self.svc.register_promo("BADMIN", percent_off=10, min_subtotal_cents=bad_min)  # type: ignore[arg-type]
+
+        # Empty, non-string, or multi-code promo codes.
+        for bad_code in ("", "   ", "A,B", "A;B", "A+B", "A B", "A|B", None, 123):
+            with self.assertRaises(ValidationError):
+                self.svc.register_promo(bad_code, percent_off=10)  # type: ignore[arg-type]
+
+        # Invalid expires_on formats.
+        for bad_date in ("", "2026-6-1", "2026/06/01", "2026-02-30", "2026-13-01", "not-a-date", 20260601):
+            with self.assertRaises(ValidationError):
+                self.svc.register_promo("BADDATE", percent_off=10, expires_on=bad_date)  # type: ignore[arg-type]
+
+        # Valid boundary values: percent_off=1 and percent_off=100.
+        self.svc.register_promo("PCT1", percent_off=1, min_subtotal_cents=0)
+        self.svc.register_promo("PCT100", percent_off=100, expires_on="2026-12-31")
+
+    def test_order_percentage_and_fixed_promos_and_clamping(self) -> None:
+        # Percentage promo with half-up discount rounding and tax on discounted subtotal.
+        # pre_discount = 1005; 15% = 150.75 -> 151; discounted = 854; tax @ 10% = 85.4 -> 85; total = 939.
+        order_pct = self.svc.place_order(
+            "acct_pct",
+            [LineItem(sku="widget", unit_cents=1005, quantity=1)],
+            tax_bps=1000,
