+    @staticmethod
+    def validate_idempotency_key(idempotency_key: str) -> str:
+        if not isinstance(idempotency_key, str) or not idempotency_key.strip():
+            raise ValidationError("idempotency_key must be a non-empty string")
+        return idempotency_key
+
+    @staticmethod
+    def _typed_fingerprint(fingerprint: Tuple[object, ...]) -> Tuple[Tuple[type, object], ...]:
+        return tuple((type(value), value) for value in fingerprint)
+
+    def lookup_idempotent_entry(
+        self,
+        idempotency_key: str,
+        fingerprint: Tuple[object, ...],
+    ) -> Optional[LedgerEntry]:
+        self.validate_idempotency_key(idempotency_key)
+        existing = self._idempotency.get(idempotency_key)
+        if existing is None:
+            return None
+        saved_fingerprint, entry_id = existing
+        if saved_fingerprint != self._typed_fingerprint(fingerprint):
+            raise ValidationError(
+                f"idempotency_key {idempotency_key!r} already used with different arguments"
+            )
+        entry = self.get_entry(entry_id)
+        if entry is None:
+            raise ValidationError(f"Missing ledger entry for idempotency_key {idempotency_key!r}")
+        return entry
+
+    def record_idempotent_entry(
+        self,
+        idempotency_key: str,
+        fingerprint: Tuple[object, ...],
+        entry: LedgerEntry,
+    ) -> LedgerEntry:
+        existing = self.lookup_idempotent_entry(idempotency_key, fingerprint)
+        if existing is not None:
+            return existing
+        self.record_entry(entry)
+        self._idempotency[idempotency_key] = (self._typed_fingerprint(fingerprint), entry.entry_id)
+        return entry
+
     def get_entry(self, entry_id: str) -> Optional[LedgerEntry]:
         return self._entries.get(entry_id)
 

