+    as_of: str | None = None,
+) -> Tuple[int, int, int, int]:
+    """Return (subtotal_cents, discount_cents, tax_cents, total_cents) for a mid-cycle upgrade."""
+    validate_non_negative_int(old_plan.monthly_cents, "old_plan.monthly_cents")
+    validate_non_negative_int(new_plan.monthly_cents, "new_plan.monthly_cents")
+    validate_proration_window(days_remaining, cycle_days)
+    delta_cents = new_plan.monthly_cents - old_plan.monthly_cents
+    if delta_cents <= 0:
+        raise ValidationError("new_plan.monthly_cents must exceed current plan monthly_cents")
+    prorated_subtotal = compute_prorated_cents(delta_cents, days_remaining, cycle_days)
+    return calculate_discounted_totals(prorated_subtotal, new_plan.tax_bps, promo=promo, as_of=as_of)
+
+
+def calculate_upgrade_totals(
+    old_plan: Plan,
+    new_plan: Plan,
+    days_remaining: int,
+    cycle_days: int,
+    *,
+    promo: Promo | None = None,
+    as_of: str | None = None,
+) -> Tuple[int, int, int]:
+    """Return (subtotal_cents, tax_cents, total_cents) for a mid-cycle plan upgrade."""
+    subtotal, _discount, tax, total = calculate_upgrade_pricing(
+        old_plan,
+        new_plan,
+        days_remaining,
+        cycle_days,
+        promo=promo,
+        as_of=as_of,
+    )
+    return subtotal, tax, total
+
+
+def calculate_refund_allocation(
+    order_subtotal_cents: int,
+    order_tax_cents: int,
+    order_total_cents: int,
+    already_refunded_total_cents: int,
+    already_refunded_tax_cents: int,
+    refund_amount_cents: int,
+) -> Tuple[int, int]:
+    """Return (refund_subtotal_cents, refund_tax_cents) with cumulative penny conservation."""
+    validate_non_negative_int(order_subtotal_cents, "order_subtotal_cents")
+    validate_non_negative_int(order_tax_cents, "order_tax_cents")
+    validate_non_negative_int(order_total_cents, "order_total_cents")
+    validate_non_negative_int(already_refunded_total_cents, "already_refunded_total_cents")
+    validate_non_negative_int(already_refunded_tax_cents, "already_refunded_tax_cents")
+    validate_positive_int(refund_amount_cents, "amount_cents")
+    if order_subtotal_cents + order_tax_cents != order_total_cents:
+        raise ValidationError("order_subtotal_cents + order_tax_cents must equal order_total_cents")
+    new_cumulative_total = already_refunded_total_cents + refund_amount_cents
+    if new_cumulative_total > order_total_cents:
+        raise ValidationError(
+            f"Refund of {refund_amount_cents} exceeds remaining refundable total "
+            f"{order_total_cents - already_refunded_total_cents}"
+        )
+    target_cumulative_tax = round_half_up_div(
+        order_tax_cents * new_cumulative_total,
+        order_total_cents,
+    )
+    refund_tax = target_cumulative_tax - already_refunded_tax_cents
+    refund_subtotal = refund_amount_cents - refund_tax
+    return refund_subtotal, refund_tax

