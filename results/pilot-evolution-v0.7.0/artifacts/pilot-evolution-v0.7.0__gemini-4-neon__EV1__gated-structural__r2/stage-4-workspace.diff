+"""Unit tests for Turn 1: mid-cycle prorated plan upgrades and idempotency."""
+
+from __future__ import annotations
+
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.ledger import OrderLedger
+from ev1_order_ledger.models import LedgerEntry, Plan, ValidationError
+from ev1_order_ledger.pricing import (
+    calculate_upgrade_totals,
+    compute_prorated_cents,
+    validate_proration_window,
+)
+
+
+class PlanUpgradeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.starter = Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=500)
+        self.pro = Plan(plan_id="pro", name="Pro", monthly_cents=2999, tax_bps=825)
+        self.pro_even_half = Plan(plan_id="pro_even", name="Pro Even", monthly_cents=2997, tax_bps=0)
+        self.pro_same_price = Plan(plan_id="starter_alt", name="Starter Alt", monthly_cents=1000, tax_bps=825)
+        self.enterprise = Plan(plan_id="enterprise", name="Enterprise", monthly_cents=5000, tax_bps=1000)
+        for plan in (
+            self.starter,
+            self.pro,
+            self.pro_even_half,
+            self.pro_same_price,
+            self.enterprise,
+        ):
+            self.svc.register_plan(plan)
+
+    def test_proration_half_up_rounding_and_new_plan_tax(self) -> None:
+        sub = self.svc.start_subscription("acct_1", "starter")
+        # delta = 2999 - 1000 = 1999; 1999 * 15 / 30 = 999.5 -> 1000 (half-up)
+        # tax uses new_plan.tax_bps (825, not starter's 500):
+        # 1000 * 825 / 10000 = 82.5 -> 83 (half-up, not banker's 82)
+        entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="upg-half-up-1",
+        )
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, sub.subscription_id)
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual(entry.subtotal_cents, 1000)
+        self.assertEqual(entry.tax_cents, 83)
+        self.assertEqual(entry.total_cents, 1083)
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "pro")
+
+        stmt = self.svc.get_statement("acct_1")
+        self.assertEqual(stmt["balance_cents"], 1083)
+        self.assertEqual(stmt["entry_count"], 1)
+
+    def test_proration_half_up_even_quotient_rounds_up_not_bankers(self) -> None:
+        sub = self.svc.start_subscription("acct_even", "starter")
+        # delta = 2997 - 1000 = 1997; 1997 * 15 / 30 = 998.5 -> 999 (half-up, not 998)
+        entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro_even",
+            15,
+            30,
+            idempotency_key="upg-even-half",
+        )
+        self.assertEqual(entry.subtotal_cents, 999)
+        self.assertEqual(entry.tax_cents, 0)
