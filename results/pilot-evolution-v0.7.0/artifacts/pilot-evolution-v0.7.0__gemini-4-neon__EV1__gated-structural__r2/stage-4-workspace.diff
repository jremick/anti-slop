+    def test_idempotency_replay_returns_original_entry_without_duplication(self) -> None:
+        sub = self.svc.start_subscription("acct_1", "starter")
+        first = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="idem-1",
+        )
+        replay = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="idem-1",
+        )
+        self.assertIs(replay, first)
+        self.assertEqual(self.svc.get_statement("acct_1")["entry_count"], 1)
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], first.total_cents)
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "pro")
+
+        # Subsequent valid upgrade with a new key works, and replaying the first key
+        # still returns the first entry without reverting plan_id or duplicating entries.
+        second = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "enterprise",
+            10,
+            30,
+            idempotency_key="idem-2",
+        )
+        self.assertNotEqual(second.entry_id, first.entry_id)
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "enterprise")
+        self.assertEqual(self.svc.get_statement("acct_1")["entry_count"], 2)
+
+        replay_after_second = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="idem-1",
+        )
+        self.assertIs(replay_after_second, first)
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "enterprise")
+        self.assertEqual(self.svc.get_statement("acct_1")["entry_count"], 2)
+
+    def test_idempotency_conflict_on_any_different_argument(self) -> None:
+        sub1 = self.svc.start_subscription("acct_1", "starter")
+        sub2 = self.svc.start_subscription("acct_2", "starter")
+        original = self.svc.upgrade_subscription(
+            sub1.subscription_id,
+            "pro",
+            1,
+            30,
+            idempotency_key="shared-key",
+        )
+
+        conflicting_calls = [
+            # Different subscription_id
+            (sub2.subscription_id, "pro", 1, 30),
+            # Different new_plan_id
+            (sub1.subscription_id, "enterprise", 1, 30),
+            # Different days_remaining
+            (sub1.subscription_id, "pro", 2, 30),
+            # Different cycle_days
+            (sub1.subscription_id, "pro", 1, 31),
+            # Boolean masquerading as int 1
+            (sub1.subscription_id, "pro", True, 30),
+        ]
+        for sid, pid, days, cycle in conflicting_calls:
+            with self.subTest(sid=sid, pid=pid, days=days, cycle=cycle):
+                with self.assertRaises(ValidationError):
+                    self.svc.upgrade_subscription(sid, pid, days, cycle, idempotency_key="shared-key")
+
+        # Original entry and states remain untouched
+        self.assertEqual(self.svc.get_statement("acct_1")["entry_count"], 1)
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], original.total_cents)
+        self.assertEqual(self.svc.get_statement("acct_2")["entry_count"], 0)
+        self.assertEqual(self.svc.ledger.get_subscription(sub2.subscription_id).plan_id, "starter")
