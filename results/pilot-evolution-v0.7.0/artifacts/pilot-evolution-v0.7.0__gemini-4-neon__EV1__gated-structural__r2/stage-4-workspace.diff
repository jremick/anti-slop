+"""Unit tests for Turn 2: promo codes across orders and subscription upgrades."""
+
+from __future__ import annotations
+
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, ValidationError
+from ev1_order_ledger.pricing import (
+    calculate_discounted_totals,
+    calculate_upgrade_pricing,
+)
+
+
+class PromoCodeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.starter = Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=500)
+        self.pro = Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825)
+        self.enterprise = Plan(plan_id="enterprise", name="Enterprise", monthly_cents=5000, tax_bps=1000)
+        for plan in (self.starter, self.pro, self.enterprise):
+            self.svc.register_plan(plan)
+
+    def test_register_promo_validation(self) -> None:
+        p1 = self.svc.register_promo("SAVE20", percent_off=20, min_subtotal_cents=500, expires_on="2026-12-31")
+        self.assertEqual(p1.code, "SAVE20")
+        self.assertEqual(p1.percent_off, 20)
+        self.assertIsNone(p1.amount_off_cents)
+        self.assertEqual(p1.min_subtotal_cents, 500)
+        self.assertEqual(p1.expires_on, "2026-12-31")
+
+        p2 = self.svc.register_promo("FLAT500", amount_off_cents=500)
+        self.assertEqual(p2.amount_off_cents, 500)
+        self.assertEqual(p2.min_subtotal_cents, 0)
+        self.assertIsNone(p2.expires_on)
+
+        # Boundary valid values: percent_off=1, percent_off=100, amount_off_cents=1, leap day
+        self.svc.register_promo("ONE_PCT", percent_off=1)
+        self.svc.register_promo("FREE100", percent_off=100)
+        self.svc.register_promo("ONE_CENT", amount_off_cents=1, expires_on="2024-02-29")
+
+        invalid_specs: list[tuple[object, dict[str, object]]] = [
+            # Neither or both discount types
+            ("NEITHER", {}),
+            ("BOTH", {"percent_off": 10, "amount_off_cents": 100}),
+            # Invalid percent_off
+            ("PCT0", {"percent_off": 0}),
+            ("PCTNEG", {"percent_off": -5}),
+            ("PCT101", {"percent_off": 101}),
+            ("PCTBOOL", {"percent_off": True}),
+            ("PCTFLOAT", {"percent_off": 10.0}),
+            # Invalid amount_off_cents
+            ("AMT0", {"amount_off_cents": 0}),
+            ("AMTNEG", {"amount_off_cents": -100}),
+            ("AMTBOOL", {"amount_off_cents": True}),
+            ("AMTFLOAT", {"amount_off_cents": 100.0}),
+            # Invalid min_subtotal_cents
+            ("MINNEG", {"percent_off": 10, "min_subtotal_cents": -1}),
+            ("MINBOOL", {"percent_off": 10, "min_subtotal_cents": False}),
+            ("MINFLOAT", {"percent_off": 10, "min_subtotal_cents": 100.0}),
+            # Invalid code
+            ("", {"percent_off": 10}),
+            ("   ", {"percent_off": 10}),
+            (123, {"percent_off": 10}),
+            ("A,B", {"percent_off": 10}),
+            ("A;B", {"percent_off": 10}),
+            ("A+B", {"percent_off": 10}),
+            ("A|B", {"percent_off": 10}),
+            ("A B", {"percent_off": 10}),
+            # Invalid expires_on
+            ("BADDATE1", {"percent_off": 10, "expires_on": ""}),
+            ("BADDATE2", {"percent_off": 10, "expires_on": "2026/05/01"}),
+            ("BADDATE3", {"percent_off": 10, "expires_on": "20260501"}),
+            ("BADDATE4", {"percent_off": 10, "expires_on": "2026-02-30"}),
+            ("BADDATE5", {"percent_off": 10, "expires_on": "2025-02-29"}),
+            ("BADDATE6", {"percent_off": 10, "expires_on": 20260501}),
+        ]
+        for code, kwargs in invalid_specs:
+            with self.subTest(code=code, kwargs=kwargs):
+                self.assertRaises(ValidationError, self.svc.register_promo, code, **kwargs)
+
+    def test_percentage_promo_on_order_applies_pre_tax_with_half_up_rounding(self) -> None:
+        self.svc.register_promo("PCT15", percent_off=15)
+        # Pre-discount subtotal = 1003; 15% of 1003 = 150.45 -> 150; discounted = 853
+        # tax = 853 * 825 / 10000 = 70.3725 -> 70; total = 923
+        order_pct15 = self.svc.place_order(
+            "acct_pct15",
+            [LineItem(sku="item", unit_cents=1003, quantity=1)],
+            tax_bps=825,
+            promo_code="PCT15",
+        )
+        self.assertEqual(order_pct15.discount_cents, 150)
+        self.assertEqual(order_pct15.subtotal_cents, 853)
+        self.assertEqual(order_pct15.tax_cents, 70)
+        self.assertEqual(order_pct15.total_cents, 923)
+        self.assertEqual(order_pct15.promo_code, "PCT15")
+
+        # Exact .5 half-up boundary: 105 * 10 / 100 = 10.5 -> 11
+        self.svc.register_promo("PCT10", percent_off=10)
+        order_half = self.svc.place_order(
+            "acct_half",
+            [LineItem(sku="item", unit_cents=105, quantity=1)],
+            tax_bps=1000,
+            promo_code="PCT10",
+        )
+        # Discount = 11, discounted subtotal = 94, tax = 94 * 1000 / 10000 = 9.4 -> 9, total = 103
+        self.assertEqual(order_half.discount_cents, 11)
+        self.assertEqual(order_half.subtotal_cents, 94)
+        self.assertEqual(order_half.tax_cents, 9)
+        self.assertEqual(order_half.total_cents, 103)
+        self.assertEqual(order_half.promo_code, "PCT10")
+        self.assertEqual(self.svc.get_statement("acct_half")["balance_cents"], 103)
+
+        # 100% off clamps subtotal, tax, and total to 0
+        self.svc.register_promo("ALLFREE", percent_off=100)
+        order_free = self.svc.place_order(
+            "acct_free",
+            [LineItem(sku="seat", unit_cents=2500, quantity=1)],
+            tax_bps=825,
+            promo_code="ALLFREE",
+        )
+        self.assertEqual(order_free.discount_cents, 2500)
+        self.assertEqual(order_free.subtotal_cents, 0)
+        self.assertEqual(order_free.tax_cents, 0)
+        self.assertEqual(order_free.total_cents, 0)
+        self.assertEqual(order_free.promo_code, "ALLFREE")
+
+    def test_fixed_amount_promo_on_order_and_zero_clamping(self) -> None:
+        self.svc.register_promo("OFF500", amount_off_cents=500)
+        order = self.svc.place_order(
+            "acct_1",
+            [LineItem(sku="seat", unit_cents=1200, quantity=1)],
+            tax_bps=825,
+            promo_code="OFF500",
+        )
+        # Discounted subtotal = 700, tax = 700 * 825 / 10000 = 57.75 -> 58, total = 758
+        self.assertEqual(order.discount_cents, 500)
+        self.assertEqual(order.subtotal_cents, 700)
+        self.assertEqual(order.tax_cents, 58)
+        self.assertEqual(order.total_cents, 758)
+        self.assertEqual(order.promo_code, "OFF500")
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 758)
+
+        # Fixed promo exceeding subtotal clamps discounted subtotal at 0
+        self.svc.register_promo("BIGOFF", amount_off_cents=5000)
+        clamped = self.svc.place_order(
+            "acct_clamped",
+            [LineItem(sku="seat", unit_cents=1200, quantity=1)],
+            tax_bps=1000,
+            promo_code="BIGOFF",
+        )
+        self.assertEqual(clamped.discount_cents, 1200)
+        self.assertEqual(clamped.subtotal_cents, 0)
+        self.assertEqual(clamped.tax_cents, 0)
+        self.assertEqual(clamped.total_cents, 0)
+        self.assertEqual(clamped.promo_code, "BIGOFF")
+        self.assertEqual(self.svc.get_statement("acct_clamped")["balance_cents"], 0)
+
+    def test_min_subtotal_enforcement_on_orders(self) -> None:
+        self.svc.register_promo("MIN2000", amount_off_cents=300, min_subtotal_cents=2000)
+        # Below min_subtotal_cents fails closed with no side effects
+        with self.assertRaises(ValidationError):
+            self.svc.place_order(
+                "acct_min",
+                [LineItem(sku="seat", unit_cents=1999, quantity=1)],
+                tax_bps=1000,
+                promo_code="MIN2000",
