+            (sub.subscription_id, "pro", True, 30, "k_bool_days_t"),
+            (sub.subscription_id, "pro", False, 30, "k_bool_days_f"),
+            (sub.subscription_id, "pro", 1, True, "k_bool_cycle_t"),
+            (sub.subscription_id, "pro", 0, False, "k_bool_cycle_f"),
+            (True, "pro", 10, 30, "k_bool_sub"),
+            (sub.subscription_id, True, 10, 30, "k_bool_plan"),
+            (sub.subscription_id, "pro", 10, 30, True),
+            # Non-int / non-str types
+            (sub.subscription_id, "pro", 10.0, 30, "k_float_days"),
+            (sub.subscription_id, "pro", 10, 30.0, "k_float_cycle"),
+            (sub.subscription_id, "pro", "10", 30, "k_str_days"),
+            # Empty / blank strings
+            ("", "pro", 10, 30, "k_empty_sub"),
+            (sub.subscription_id, "   ", 10, 30, "k_blank_plan"),
+            (sub.subscription_id, "pro", 10, 30, ""),
+            (sub.subscription_id, "pro", 10, 30, "   "),
+            (sub.subscription_id, "pro", 10, 30, None),
+        ]
+        for sid, pid, days, cycle, key in bad_calls:
+            with self.subTest(sid=sid, pid=pid, days=days, cycle=cycle, key=key):
+                self.assertRaises(
