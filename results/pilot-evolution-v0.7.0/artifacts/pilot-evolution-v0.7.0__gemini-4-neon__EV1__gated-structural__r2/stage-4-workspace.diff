+        self.assertEqual(order.subtotal_cents, 1700)
+        self.assertEqual(order.tax_cents, 170)
+        self.assertEqual(order.total_cents, 1870)
+        self.assertEqual(self.svc.get_statement("acct_min")["entry_count"], 1)
+
+    def test_expiry_and_as_of_enforcement(self) -> None:
+        self.svc.register_promo("SPRING", percent_off=25, expires_on="2026-06-30")
+        items = [LineItem(sku="seat", unit_cents=2000, quantity=1)]
+
+        # Missing as_of fails closed
+        with self.assertRaises(ValidationError):
+            self.svc.place_order("acct_exp", items, tax_bps=1000, promo_code="SPRING")
