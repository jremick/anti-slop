+"""Unit tests for Turn 4: legacy_flat_fee removal and fail-closed audit logging."""
+
+from __future__ import annotations
+
+from typing import Dict, List
+import unittest
+
+from ev1_order_ledger import pricing
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, ValidationError
+
+
+class AuditSinkFailure(RuntimeError):
+    """Test error raised by a failing audit sink."""
+
+
+class LegacyRemovalAndAuditTests(unittest.TestCase):
+    def test_legacy_flat_fee_completely_removed(self) -> None:
+        self.assertFalse(hasattr(pricing, "LEGACY_FLAT_FEE_CENTS"))
+
+        svc = OrderService()
+        items = [LineItem(sku="seat", unit_cents=1000, quantity=1)]
+
+        self.assertRaises(
+            TypeError,
+            pricing.calculate_order_totals,
+            items,
+            tax_bps=1000,
+            legacy_flat_fee=True,
+        )
+        self.assertRaises(
+            TypeError,
+            pricing.calculate_order_totals,
+            items,
+            tax_bps=1000,
+            legacy_flat_fee=False,
+        )
+        self.assertRaises(
+            TypeError,
+            svc.place_order,
+            "acct_1",
+            items,
+            tax_bps=1000,
+            legacy_flat_fee=True,
+        )
+        self.assertRaises(
+            TypeError,
+            svc.place_order,
+            "acct_1",
+            items,
+            tax_bps=1000,
+            legacy_flat_fee=False,
+        )
+
+    def test_audit_sink_logs_committed_mutations_and_skips_replays(self) -> None:
+        events: List[Dict[str, object]] = []
+        svc = OrderService(audit_sink=events.append)
+        svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=500))
+        svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+
+        # 1. place_order emits order_charge
+        order = svc.place_order(
+            "acct_1",
+            [LineItem(sku="seat", unit_cents=1000, quantity=1)],
+            tax_bps=1000,
+        )
+        charge_entry = svc.ledger.entries_for_reference(order.order_id, kind="order_charge")[0]
+        self.assertEqual(len(events), 1)
+        self.assertEqual(
+            events[0],
+            {
+                "action": "order_charge",
+                "account_id": "acct_1",
+                "amount_cents": 1100,
+                "entry_id": charge_entry.entry_id,
+            },
+        )
+
+        # 2. upgrade_subscription emits plan_upgrade once; replay emits nothing
+        sub = svc.start_subscription("acct_1", "starter")
+        self.assertEqual(len(events), 1)
+        upg = svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="audit-upg-1",
+        )
+        self.assertEqual(len(events), 2)
+        self.assertEqual(
+            events[1],
+            {
+                "action": "plan_upgrade",
+                "account_id": "acct_1",
+                "amount_cents": upg.total_cents,
+                "entry_id": upg.entry_id,
+            },
+        )
+        replay_upg = svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="audit-upg-1",
+        )
+        self.assertIs(replay_upg, upg)
+        self.assertEqual(len(events), 2)
+
+        # 3. refund_order emits order_refund with negative amount_cents; replay emits nothing
+        ref = svc.refund_order(
+            order.order_id,
+            400,
+            reason="partial",
+            idempotency_key="audit-ref-1",
+        )
+        self.assertEqual(len(events), 3)
+        self.assertEqual(
+            events[2],
+            {
+                "action": "order_refund",
+                "account_id": "acct_1",
+                "amount_cents": -400,
+                "entry_id": ref.entry_id,
+            },
+        )
+        replay_ref = svc.refund_order(
+            order.order_id,
+            400,
+            reason="partial",
+            idempotency_key="audit-ref-1",
+        )
+        self.assertIs(replay_ref, ref)
+        self.assertEqual(len(events), 3)
+
+    def test_audit_sink_failure_is_fail_closed_and_atomic_for_place_order(self) -> None:
+        def failing_sink(_event: Dict[str, object]) -> None:
+            raise AuditSinkFailure("sink unavailable")
+
+        svc = OrderService(audit_sink=failing_sink)
+        with self.assertRaises(AuditSinkFailure):
+            svc.place_order(
+                "acct_atomic",
+                [LineItem(sku="seat", unit_cents=1000, quantity=1)],
+                tax_bps=1000,
+            )
+
+        self.assertEqual(svc.get_statement("acct_atomic")["entry_count"], 0)
+        self.assertEqual(svc.get_statement("acct_atomic")["balance_cents"], 0)
+        self.assertRaises(ValidationError, svc.ledger.get_order, "ord_0001")
+
+    def test_audit_sink_failure_is_fail_closed_and_atomic_for_upgrade_and_refund(self) -> None:
+        events: List[Dict[str, object]] = []
+        should_fail = False
+
+        def toggle_sink(event: Dict[str, object]) -> None:
+            if should_fail:
+                raise AuditSinkFailure("sink down")
+            events.append(event)
+
+        svc = OrderService(audit_sink=toggle_sink)
+        svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=500))
+        svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+
+        order = svc.place_order(
+            "acct_1",
+            [LineItem(sku="seat", unit_cents=1000, quantity=1)],
+            tax_bps=1000,
+        )
+        sub = svc.start_subscription("acct_1", "starter")
+        self.assertEqual(len(events), 1)
+
+        should_fail = True
+        with self.assertRaises(AuditSinkFailure):
+            svc.upgrade_subscription(
+                sub.subscription_id,
+                "pro",
+                15,
+                30,
+                idempotency_key="upg-atomic-1",
+            )
+        self.assertEqual(svc.ledger.get_subscription(sub.subscription_id).plan_id, "starter")
+        self.assertEqual(svc.get_statement("acct_1")["entry_count"], 1)
+        self.assertEqual(svc.get_statement("acct_1")["balance_cents"], 1100)
+
+        with self.assertRaises(AuditSinkFailure):
+            svc.refund_order(
+                order.order_id,
+                500,
+                reason="broken",
+                idempotency_key="ref-atomic-1",
+            )
+        self.assertEqual(svc.get_statement("acct_1")["entry_count"], 1)
+        self.assertEqual(svc.get_statement("acct_1")["balance_cents"], 1100)
+
+        # Once sink recovers, the same idempotency keys succeed (never poisoned)
+        should_fail = False
+        upg = svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="upg-atomic-1",
+        )
+        ref = svc.refund_order(
+            order.order_id,
+            500,
+            reason="broken",
+            idempotency_key="ref-atomic-1",
+        )
+        self.assertEqual(svc.ledger.get_subscription(sub.subscription_id).plan_id, "pro")
+        self.assertEqual(len(events), 3)
+        self.assertEqual(events[1]["entry_id"], upg.entry_id)
+        self.assertEqual(events[2]["entry_id"], ref.entry_id)
+
+    def test_non_callable_audit_sink_rejected(self) -> None:
+        self.assertRaises(ValidationError, OrderService, audit_sink="not-callable")
+
+
+if __name__ == "__main__":
+    unittest.main()

