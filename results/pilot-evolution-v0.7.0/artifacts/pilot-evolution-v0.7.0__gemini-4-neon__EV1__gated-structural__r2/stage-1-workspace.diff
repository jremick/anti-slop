+def validate_proration_window(days_remaining: int, cycle_days: int) -> Tuple[int, int]:
+    """Validate integer proration window bounds: 0 <= days_remaining <= cycle_days and cycle_days > 0."""
+    validate_non_negative_int(days_remaining, "days_remaining")
+    validate_positive_int(cycle_days, "cycle_days")
+    if days_remaining > cycle_days:
+        raise ValidationError("days_remaining cannot exceed cycle_days")
+    return days_remaining, cycle_days
+
+
+def compute_prorated_cents(amount_cents: int, days_remaining: int, cycle_days: int) -> int:
+    """Compute exact integer half-up proration of a non-negative cent amount."""
+    validate_non_negative_int(amount_cents, "amount_cents")
+    validate_proration_window(days_remaining, cycle_days)
+    return round_half_up_div(amount_cents * days_remaining, cycle_days)
+
+
+def calculate_upgrade_totals(
+    old_plan: Plan,
+    new_plan: Plan,
+    days_remaining: int,
+    cycle_days: int,
+) -> Tuple[int, int, int]:
+    """Return (subtotal_cents, tax_cents, total_cents) for a mid-cycle plan upgrade."""
+    validate_non_negative_int(old_plan.monthly_cents, "old_plan.monthly_cents")
+    validate_non_negative_int(new_plan.monthly_cents, "new_plan.monthly_cents")
+    validate_proration_window(days_remaining, cycle_days)
+    delta_cents = new_plan.monthly_cents - old_plan.monthly_cents
+    if delta_cents <= 0:
+        raise ValidationError("new_plan.monthly_cents must exceed current plan monthly_cents")
+    subtotal = compute_prorated_cents(delta_cents, days_remaining, cycle_days)
+    tax = compute_tax_cents(subtotal, new_plan.tax_bps)
+    return subtotal, tax, subtotal + tax

