+"""Unit tests for Turn 1: mid-cycle prorated plan upgrades and idempotency."""
+
+from __future__ import annotations
+
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.ledger import OrderLedger
+from ev1_order_ledger.models import LedgerEntry, Plan, ValidationError
+from ev1_order_ledger.pricing import (
+    calculate_upgrade_totals,
+    compute_prorated_cents,
+    validate_proration_window,
+)
+
+
+class PlanUpgradeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.starter = Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=500)
+        self.pro = Plan(plan_id="pro", name="Pro", monthly_cents=2999, tax_bps=825)
+        self.pro_even_half = Plan(plan_id="pro_even", name="Pro Even", monthly_cents=2997, tax_bps=0)
+        self.pro_same_price = Plan(plan_id="starter_alt", name="Starter Alt", monthly_cents=1000, tax_bps=825)
+        self.enterprise = Plan(plan_id="enterprise", name="Enterprise", monthly_cents=5000, tax_bps=1000)
+        for plan in (
+            self.starter,
+            self.pro,
+            self.pro_even_half,
+            self.pro_same_price,
+            self.enterprise,
+        ):
+            self.svc.register_plan(plan)
+
+    def test_proration_half_up_rounding_and_new_plan_tax(self) -> None:
+        sub = self.svc.start_subscription("acct_1", "starter")
+        # delta = 2999 - 1000 = 1999; 1999 * 15 / 30 = 999.5 -> 1000 (half-up)
+        # tax uses new_plan.tax_bps (825, not starter's 500):
+        # 1000 * 825 / 10000 = 82.5 -> 83 (half-up, not banker's 82)
+        entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="upg-half-up-1",
+        )
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, sub.subscription_id)
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual(entry.subtotal_cents, 1000)
+        self.assertEqual(entry.tax_cents, 83)
+        self.assertEqual(entry.total_cents, 1083)
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "pro")
+
+        stmt = self.svc.get_statement("acct_1")
+        self.assertEqual(stmt["balance_cents"], 1083)
+        self.assertEqual(stmt["entry_count"], 1)
+
+    def test_proration_half_up_even_quotient_rounds_up_not_bankers(self) -> None:
+        sub = self.svc.start_subscription("acct_even", "starter")
+        # delta = 2997 - 1000 = 1997; 1997 * 15 / 30 = 998.5 -> 999 (half-up, not 998)
+        entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro_even",
+            15,
+            30,
+            idempotency_key="upg-even-half",
+        )
+        self.assertEqual(entry.subtotal_cents, 999)
+        self.assertEqual(entry.tax_cents, 0)
+        self.assertEqual(entry.total_cents, 999)
+
+    def test_proration_fractional_non_half_rounding(self) -> None:
+        # 100 * 1 / 3 = 33.333... -> 33; 100 * 2 / 3 = 66.666... -> 67
+        self.assertEqual(compute_prorated_cents(100, 1, 3), 33)
+        self.assertEqual(compute_prorated_cents(100, 2, 3), 67)
+        # 14 / 30 = 0.466... -> 0; 15 / 30 = 0.5 -> 1
+        self.assertEqual(compute_prorated_cents(1, 14, 30), 0)
+        self.assertEqual(compute_prorated_cents(1, 15, 30), 1)
+
+    def test_proration_boundary_zero_and_full_cycle_days(self) -> None:
+        sub_zero = self.svc.start_subscription("acct_zero", "starter")
+        entry_zero = self.svc.upgrade_subscription(
+            sub_zero.subscription_id,
+            "pro",
+            0,
+            30,
+            idempotency_key="upg-zero-days",
+        )
+        self.assertEqual(entry_zero.subtotal_cents, 0)
+        self.assertEqual(entry_zero.tax_cents, 0)
+        self.assertEqual(entry_zero.total_cents, 0)
+        self.assertEqual(self.svc.ledger.get_subscription(sub_zero.subscription_id).plan_id, "pro")
+        self.assertEqual(self.svc.get_statement("acct_zero")["entry_count"], 1)
+
+        sub_full = self.svc.start_subscription("acct_full", "starter")
+        entry_full = self.svc.upgrade_subscription(
+            sub_full.subscription_id,
+            "enterprise",
+            30,
+            30,
+            idempotency_key="upg-full-cycle",
+        )
+        # delta = 4000, tax = 4000 * 1000 / 10000 = 400, total = 4400
+        self.assertEqual(entry_full.subtotal_cents, 4000)
+        self.assertEqual(entry_full.tax_cents, 400)
+        self.assertEqual(entry_full.total_cents, 4400)
+        self.assertEqual(self.svc.ledger.get_subscription(sub_full.subscription_id).plan_id, "enterprise")
+
+    def test_unknown_ids_rejected(self) -> None:
+        sub = self.svc.start_subscription("acct_1", "starter")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription("sub_missing", "pro", 10, 30, idempotency_key="k1")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "plan_missing", 10, 30, idempotency_key="k2")
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "starter")
+        self.assertEqual(self.svc.get_statement("acct_1")["entry_count"], 0)
+
+    def test_non_upgrades_rejected_without_side_effects(self) -> None:
+        sub = self.svc.start_subscription("acct_1", "pro")
+        # Same plan
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "pro", 10, 30, idempotency_key="same-plan")
+        # Downgrade
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "starter", 10, 30, idempotency_key="downgrade")
+
+        # Equal monthly_cents different plan
+        sub_starter = self.svc.start_subscription("acct_2", "starter")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(
+                sub_starter.subscription_id,
+                "starter_alt",
+                10,
+                30,
+                idempotency_key="equal-price",
+            )
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "pro")
+        self.assertEqual(self.svc.ledger.get_subscription(sub_starter.subscription_id).plan_id, "starter")
+        self.assertEqual(self.svc.get_statement("acct_1")["entry_count"], 0)
+        self.assertEqual(self.svc.get_statement("acct_2")["entry_count"], 0)
+
+    def test_invalid_bounds_booleans_and_empty_inputs_rejected(self) -> None:
+        sub = self.svc.start_subscription("acct_1", "starter")
+        bad_calls: list[tuple[object, object, object, object, object]] = [
+            # Invalid cycle_days / days_remaining bounds
+            (sub.subscription_id, "pro", 10, 0, "k_zero_cycle"),
+            (sub.subscription_id, "pro", 10, -5, "k_neg_cycle"),
+            (sub.subscription_id, "pro", -1, 30, "k_neg_days"),
+            (sub.subscription_id, "pro", 31, 30, "k_over_days"),
+            # Booleans
+            (sub.subscription_id, "pro", True, 30, "k_bool_days_t"),
+            (sub.subscription_id, "pro", False, 30, "k_bool_days_f"),
+            (sub.subscription_id, "pro", 1, True, "k_bool_cycle_t"),
+            (sub.subscription_id, "pro", 0, False, "k_bool_cycle_f"),
+            (True, "pro", 10, 30, "k_bool_sub"),
+            (sub.subscription_id, True, 10, 30, "k_bool_plan"),
+            (sub.subscription_id, "pro", 10, 30, True),
+            # Non-int / non-str types
+            (sub.subscription_id, "pro", 10.0, 30, "k_float_days"),
+            (sub.subscription_id, "pro", 10, 30.0, "k_float_cycle"),
+            (sub.subscription_id, "pro", "10", 30, "k_str_days"),
+            # Empty / blank strings
+            ("", "pro", 10, 30, "k_empty_sub"),
+            (sub.subscription_id, "   ", 10, 30, "k_blank_plan"),
+            (sub.subscription_id, "pro", 10, 30, ""),
+            (sub.subscription_id, "pro", 10, 30, "   "),
+            (sub.subscription_id, "pro", 10, 30, None),
+        ]
+        for sid, pid, days, cycle, key in bad_calls:
+            with self.subTest(sid=sid, pid=pid, days=days, cycle=cycle, key=key):
+                self.assertRaises(
+                    ValidationError,
+                    self.svc.upgrade_subscription,
+                    sid,
+                    pid,
+                    days,
+                    cycle,
+                    idempotency_key=key,
+                )
+
+        # None of the failed attempts mutated subscription or recorded entries
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "starter")
+        self.assertEqual(self.svc.get_statement("acct_1")["entry_count"], 0)
+
+        # Failed validation must not poison idempotency_key
+        entry = self.svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="k_neg_days")
+        self.assertEqual(entry.total_cents, 1083)
+
+    def test_idempotency_key_is_keyword_only(self) -> None:
