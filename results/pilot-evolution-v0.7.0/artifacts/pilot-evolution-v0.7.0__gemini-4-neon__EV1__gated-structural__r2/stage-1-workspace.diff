+    def lookup_idempotent_entry(
+        self,
+        idempotency_key: str,
+        fingerprint: Tuple[object, ...],
+    ) -> Optional[LedgerEntry]:
+        validate_non_empty_str(idempotency_key, "idempotency_key")
+        record = self._idempotency.get(idempotency_key)
+        if record is None:
+            return None
+        stored_fingerprint, entry_id = record
+        if stored_fingerprint != _typed_fingerprint(fingerprint):
+            raise ValidationError(
+                f"Idempotency key {idempotency_key!r} already used with different arguments"
+            )
+        return self._entries[entry_id]
+
+    def record_idempotent_entry(
+        self,
+        entry: LedgerEntry,
+        *,
+        idempotency_key: str,
+        fingerprint: Tuple[object, ...],
+    ) -> LedgerEntry:
+        existing = self.lookup_idempotent_entry(idempotency_key, fingerprint)
+        if existing is not None:
+            return existing
+        self.record_entry(entry)
+        self._idempotency[idempotency_key] = (_typed_fingerprint(fingerprint), entry.entry_id)
+        return entry
+
     def get_entry(self, entry_id: str) -> Optional[LedgerEntry]:
