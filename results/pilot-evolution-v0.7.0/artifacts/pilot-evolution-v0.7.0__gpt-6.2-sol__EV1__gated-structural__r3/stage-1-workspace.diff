+"""Tests for prorated subscription upgrades and idempotency."""
+
+from __future__ import annotations
+
+import unittest
+
+from ev1_order_ledger import OrderService, Plan, ValidationError
+
+
+class SubscriptionUpgradeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.service = OrderService()
+        self.service.register_plan(Plan("starter", "Starter", 1000))
+        self.service.register_plan(Plan("pro", "Pro", 1009, tax_bps=1000))
+        self.service.register_plan(Plan("premium", "Premium", 1200))
+        self.subscription = self.service.start_subscription("acct_1", "starter")
+
+    def test_proration_and_destination_tax_both_round_half_up(self) -> None:
+        entry = self.service.upgrade_subscription(
+            self.subscription.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+
+        self.assertEqual(entry.subtotal_cents, 5)  # 9 / 2 = 4.5 cents
+        self.assertEqual(entry.tax_cents, 1)  # 10% of 5 cents
+        self.assertEqual(entry.total_cents, 6)
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.subscription.subscription_id)
+        self.assertEqual(entry.account_id, self.subscription.account_id)
+        self.assertEqual(self.subscription.plan_id, "pro")
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [entry])
+        self.assertEqual(self.service.get_statement("acct_1")["balance_cents"], 6)
+
+    def test_proration_preserves_precision_for_large_prices(self) -> None:
+        self.service.register_plan(Plan("large", "Large", 1000 + 2**54 + 1))
+        entry = self.service.upgrade_subscription(
+            self.subscription.subscription_id, "large", 1, 2, idempotency_key="upgrade"
+        )
+
+        self.assertEqual(entry.subtotal_cents, 2**53 + 1)
+
+    def test_proration_accepts_both_cycle_endpoints(self) -> None:
+        for days_remaining, expected_subtotal in [(0, 0), (30, 9)]:
+            with self.subTest(days_remaining=days_remaining):
+                subscription = self.service.start_subscription("acct_1", "starter")
+                entry = self.service.upgrade_subscription(
+                    subscription.subscription_id, "pro", days_remaining, 30,
+                    idempotency_key=subscription.subscription_id,
+                )
+                self.assertEqual(entry.subtotal_cents, expected_subtotal)
+                self.assertEqual(subscription.plan_id, "pro")
+
+    def test_invalid_cycle_arguments_leave_subscription_and_ledger_intact(self) -> None:
+        for days_remaining, cycle_days in [
+            (0, 0), (0, -1), (-1, 30), (31, 30),
+            (True, 30), (0, True), (1.0, 30), (1, 30.0),
+        ]:
+            with self.subTest(days_remaining=days_remaining, cycle_days=cycle_days):
+                with self.assertRaises(ValidationError):
+                    self.service.upgrade_subscription(
+                        self.subscription.subscription_id, "pro", days_remaining, cycle_days,
+                        idempotency_key="upgrade",
+                    )
+
+        self.assertEqual(self.subscription.plan_id, "starter")
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [])
+        entry = self.service.upgrade_subscription(
+            self.subscription.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [entry])
+
+    def test_rejects_unknown_ids_non_upgrades_and_invalid_keys(self) -> None:
+        self.service.register_plan(Plan("same_price", "Same Price", 1000))
+        self.service.register_plan(Plan("cheaper", "Cheaper", 900))
+        subscription_id = self.subscription.subscription_id
+        for requested_subscription, plan, key in [
+            ("missing", "pro", "upgrade"),
+            (subscription_id, "missing", "upgrade"),
+            (False, "pro", "upgrade"),
+            (subscription_id, True, "upgrade"),
+            (subscription_id, "same_price", "upgrade"),
+            (subscription_id, "cheaper", "upgrade"),
+            (subscription_id, "pro", ""),
+            (subscription_id, "pro", "  "),
+            (subscription_id, "pro", True),
+        ]:
+            with self.subTest(subscription_id=requested_subscription, plan=plan, key=key):
+                with self.assertRaises(ValidationError):
+                    self.service.upgrade_subscription(
+                        requested_subscription, plan, 1, 2, idempotency_key=key
+                    )
+
+        self.assertEqual(self.subscription.plan_id, "starter")
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [])
+
+    def test_replay_returns_original_entry_across_services_and_later_upgrades(self) -> None:
+        subscription_id = self.subscription.subscription_id
+        first = self.service.upgrade_subscription(
+            subscription_id, "pro", 1, 2, idempotency_key="first"
+        )
+        other_service = OrderService(self.service.ledger)
+        replay = other_service.upgrade_subscription(subscription_id, "pro", 1, 2, idempotency_key="first")
+        self.assertIs(replay, first)
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [first])
+
+        second = other_service.upgrade_subscription(
+            subscription_id, "premium", 1, 2, idempotency_key="second"
+        )
+        replay = other_service.upgrade_subscription(subscription_id, "pro", 1, 2, idempotency_key="first")
+        self.assertIs(replay, first)
+        self.assertEqual(self.subscription.plan_id, "premium")
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [first, second])
+
+    def test_reused_key_rejects_changes_to_every_argument(self) -> None:
+        subscription_id = self.subscription.subscription_id
+        other_subscription = self.service.start_subscription("acct_2", "starter")
+        original = self.service.upgrade_subscription(
+            subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+
+        for arguments in [
+            (other_subscription.subscription_id, "pro", 1, 2),
+            (subscription_id, "premium", 1, 2),
+            (subscription_id, "pro", 2, 2),
+            (subscription_id, "pro", 1, 3),
+            (subscription_id, "pro", True, 2),
+            (subscription_id, "pro", 1, 2.0),
+        ]:
+            with self.subTest(arguments=arguments):
+                with self.assertRaises(ValidationError):
+                    self.service.upgrade_subscription(*arguments, idempotency_key="upgrade")
+
+        self.assertEqual(self.subscription.plan_id, "pro")
+        self.assertEqual(other_subscription.plan_id, "starter")
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [original])
+        self.assertEqual(self.service.ledger.entries_for_account("acct_2"), [])
