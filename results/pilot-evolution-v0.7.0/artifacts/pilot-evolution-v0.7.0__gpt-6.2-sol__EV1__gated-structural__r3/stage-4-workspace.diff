+        order = self.service.place_order("acct", self.items, tax_bps=1000, promo_code="HALF")
+
+        self.assertEqual(order.promo_code, "HALF")
+        self.assertEqual(order.discount_cents, 51)
+        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (50, 5, 55))
+        entry, = self.service.ledger.entries_for_account("acct")
+        self.assertEqual(entry.reference_id, order.order_id)
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (50, 5, 55))
+
+    def test_fixed_discount_is_clamped_to_subtotal(self) -> None:
+        self.service.register_promo("FIXED", amount_off_cents=200)
+        order = self.service.place_order("acct", self.items, tax_bps=1000, promo_code="FIXED")
+
+        self.assertEqual(order.promo_code, "FIXED")
+        self.assertEqual(order.discount_cents, 101)
+        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (0, 0, 0))
+
+    def test_expiry_requires_valid_date_and_includes_expiration_day(self) -> None:
+        self.service.register_promo("DATED", percent_off=100, expires_on="2026-12-31")
+        for as_of in (None, "2027-01-01", "2026-02-30", "20261231"):
+            with self.subTest(as_of=as_of), self.assertRaises(ValidationError):
+                self.service.place_order("acct", self.items, promo_code="DATED", as_of=as_of)
+
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [])
+        order = self.service.place_order(
+            "acct", self.items, promo_code="DATED", as_of="2026-12-31"
+        )
+        self.assertEqual(order.discount_cents, 101)
+
+    def test_unknown_and_stacked_codes_are_rejected(self) -> None:
+        self.service.register_promo("A", amount_off_cents=10)
+        self.service.register_promo("B", amount_off_cents=20)
+        for promo_code in ("missing", "A,B", "A, B", "", True):
+            with self.subTest(promo_code=promo_code), self.assertRaises(ValidationError):
