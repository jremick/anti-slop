+"""Tests for partial order refunds and credit-note export."""
+
+from __future__ import annotations
+
+import unittest
+
+from ev1_order_ledger import LineItem, OrderService, Plan, ValidationError
+
+
+class RefundTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.service = OrderService()
+
+    def test_partial_refunds_reverse_exact_original_subtotal_and_tax(self) -> None:
+        self.service.register_promo("SAVE", amount_off_cents=4)
+        for chunks, expected_taxes in [((1, 1, 1, 1), (0, 1, 0, 0)), ((1, 3), (0, 1))]:
+            with self.subTest(chunks=chunks):
+                order = self.service.place_order(
+                    "acct", [LineItem("seat", 7, 1)], tax_bps=2500, promo_code="SAVE"
+                )
+                refunds = [
+                    self.service.refund_order(
+                        order.order_id, amount, reason="returned seat",
+                        idempotency_key=f"{order.order_id}-{index}",
+                    )
+                    for index, amount in enumerate(chunks)
+                ]
+
+                self.assertEqual(tuple(-entry.tax_cents for entry in refunds), expected_taxes)
+                for entry, amount in zip(refunds, chunks):
+                    self.assertEqual(entry.kind, "order_refund")
+                    self.assertEqual(entry.reference_id, order.order_id)
+                    self.assertEqual(entry.total_cents, -amount)
+                    self.assertEqual(entry.subtotal_cents + entry.tax_cents, -amount)
+                self.assertEqual(sum(entry.subtotal_cents for entry in refunds), -order.subtotal_cents)
+                self.assertEqual(sum(entry.tax_cents for entry in refunds), -order.tax_cents)
+                self.assertEqual(self.service.get_statement("acct")["balance_cents"], 0)
+
+    def test_over_refund_rejects_excess_and_leaves_key_available(self) -> None:
+        order = self.service.place_order("acct", [LineItem("seat", 100, 1)])
+        other = self.service.place_order("acct", [LineItem("seat", 100, 1)])
+        self.service.refund_order(other.order_id, 100, reason="return", idempotency_key="other")
+        self.service.refund_order(order.order_id, 70, reason="return", idempotency_key="first")
+        with self.assertRaises(ValidationError):
+            self.service.refund_order(order.order_id, 31, reason="return", idempotency_key="rest")
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], 30)
+        self.assertEqual(self.service.get_statement("acct")["entry_count"], 4)
+
+        self.service.refund_order(order.order_id, 30, reason="return", idempotency_key="rest")
+        with self.assertRaises(ValidationError):
+            self.service.refund_order(order.order_id, 1, reason="return", idempotency_key="excess")
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], 0)
+
+    def test_invalid_refund_inputs_and_zero_total_order(self) -> None:
+        order = self.service.place_order("acct", [LineItem("seat", 100, 1)])
+        self.service.register_promo("FREE", percent_off=100)
+        free = self.service.place_order("acct", [LineItem("seat", 100, 1)], promo_code="FREE")
+        for order_id, amount, reason, key in [
+            ("missing", 1, "return", "refund"),
+            (free.order_id, 1, "return", "refund"),
+            (order.order_id, 0, "return", "refund"),
+            (order.order_id, -1, "return", "refund"),
+            (order.order_id, True, "return", "refund"),
+            (order.order_id, 1.5, "return", "refund"),
+            (order.order_id, 1, "  ", "refund"),
+            (order.order_id, 1, True, "refund"),
+            (order.order_id, 1, "return", ""),
+        ]:
+            with self.subTest(order_id=order_id, amount=amount, reason=reason, key=key):
+                with self.assertRaises(ValidationError):
+                    self.service.refund_order(order_id, amount, reason=reason, idempotency_key=key)
+        self.assertEqual(self.service.get_statement("acct")["entry_count"], 2)
+
+    def test_idempotent_replay_after_full_refund_and_conflicting_arguments(self) -> None:
+        order = self.service.place_order("acct", [LineItem("seat", 100, 1)])
+        other = self.service.place_order("acct", [LineItem("seat", 100, 1)])
+        first = self.service.refund_order(
+            order.order_id, 40, reason="return", idempotency_key="first"
+        )
+        second_service = OrderService(self.service.ledger)
+        second_service.refund_order(order.order_id, 60, reason="return", idempotency_key="rest")
+        self.assertIs(
+            second_service.refund_order(order.order_id, 40, reason="return", idempotency_key="first"),
+            first,
+        )
+        for order_id, amount, reason in [
+            (other.order_id, 40, "return"),
+            (order.order_id, 41, "return"),
+            (order.order_id, 40, "other reason"),
+        ]:
+            with self.subTest(order_id=order_id, amount=amount, reason=reason):
+                with self.assertRaisesRegex(ValidationError, "different arguments"):
+                    second_service.refund_order(
+                        order_id, amount, reason=reason, idempotency_key="first"
+                    )
+        self.assertEqual(self.service.get_statement("acct")["entry_count"], 4)
+
+    def test_upgrade_and_refund_share_idempotency_keys(self) -> None:
+        order = self.service.place_order("acct", [LineItem("seat", 100, 1)])
+        self.service.register_plan(Plan("starter", "Starter", 100))
