+            ("BAD", {"percent_off": 5, "amount_off_cents": 5}),
+            ("BAD", {"percent_off": 0}),
+            ("BAD", {"percent_off": 101}),
+            ("BAD", {"percent_off": True}),
+            ("BAD", {"amount_off_cents": 0}),
+            ("BAD", {"amount_off_cents": 1.5}),
+            ("BAD", {"amount_off_cents": 5, "min_subtotal_cents": -1}),
