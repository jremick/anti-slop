+    def test_credit_note_uses_positive_magnitudes_and_requires_refund_entry(self) -> None:
+        order = self.service.place_order("acct", [LineItem("seat", 100, 1)], tax_bps=1000)
+        charge, = self.service.ledger.entries_for_account("acct")
+        refund = self.service.refund_order(order.order_id, 55, reason="return", idempotency_key="refund")
