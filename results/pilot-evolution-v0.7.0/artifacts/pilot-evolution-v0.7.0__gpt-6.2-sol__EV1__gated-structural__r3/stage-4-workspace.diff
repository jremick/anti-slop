+"""Tests for promo discounts on orders and subscription upgrades."""
+
+from __future__ import annotations
+
+import unittest
+
+from ev1_order_ledger import LineItem, OrderService, Plan, ValidationError
+
+
+class PromoTests(unittest.TestCase):
+    def setUp(self) -> None:
