+                entry = self.service.upgrade_subscription(
+                    subscription.subscription_id, "pro", days_remaining, 30,
+                    idempotency_key=subscription.subscription_id,
+                )
+                self.assertEqual(entry.subtotal_cents, expected_subtotal)
+                self.assertEqual(subscription.plan_id, "pro")
+
