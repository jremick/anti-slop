{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"cat benchmarks/sources/ev1_order_ledger/tests/test_orders.py && sed -n '48,78p' benchmarks/sources/ev1_order_ledger/tests/test_promos.py && rg -n 'before_commit|audit' benchmarks/sources/ev1_order_ledger/{api,ledger}.py\"","aggregated_output":"\"\"\"Baseline unit tests for the initial EV1 order ledger fixture.\"\"\"\n\nfrom __future__ import annotations\n\nimport unittest\n\nfrom ev1_order_ledger.api import OrderService\nfrom ev1_order_ledger.models import LineItem, Plan, ValidationError\n\n\nclass BaselineOrderLedgerTests(unittest.TestCase):\n    def setUp(self) -> None:\n        self.svc = OrderService()\n        self.svc.register_plan(Plan(plan_id=\"starter\", name=\"Starter\", monthly_cents=1000, tax_bps=825))\n        self.svc.register_plan(Plan(plan_id=\"pro\", name=\"Pro\", monthly_cents=3000, tax_bps=825))\n\n    def test_place_order_computes_exact_integer_tax_and_records_entry(self) -> None:\n        order = self.svc.place_order(\n            \"acct_1\",\n            [LineItem(sku=\"seat\", unit_cents=1999, quantity=2)],\n            tax_bps=825,\n        )\n        self.assertEqual(order.subtotal_cents, 3998)\n        self.assertEqual(order.tax_cents, 330)  # 3998 * 825 / 10000 = 329.835 -> 330\n        self.assertEqual(order.total_cents, 4328)\n        stmt = self.svc.get_statement(\"acct_1\")\n        self.assertEqual(stmt[\"balance_cents\"], 4328)\n        self.assertEqual(stmt[\"entry_count\"], 1)\n\n    def test_legacy_flat_fee_adds_500_cents_before_tax(self) -> None:\n        order = self.svc.place_order(\n            \"acct_1\",\n            [LineItem(sku=\"seat\", unit_cents=1000, quantity=1)],\n            tax_bps=1000,\n            legacy_flat_fee=True,\n        )\n        self.assertEqual(order.subtotal_cents, 1500)\n        self.assertEqual(order.tax_cents, 150)\n        self.assertEqual(order.total_cents, 1650)\n\n    def test_invalid_order_inputs_fail_closed(self) -> None:\n        with self.assertRaises(ValidationError):\n            self.svc.place_order(\"\", [LineItem(sku=\"x\", unit_cents=100, quantity=1)])\n        with self.assertRaises(ValidationError):\n            self.svc.place_order(\"acct_1\", [])\n        with self.assertRaises(ValidationError):\n            self.svc.place_order(\"acct_1\", [LineItem(sku=\"x\", unit_cents=0, quantity=1)])\n\n    def test_start_subscription_validates_plan(self) -> None:\n        sub = self.svc.start_subscription(\"acct_1\", \"starter\")\n        self.assertEqual(sub.plan_id, \"starter\")\n        with self.assertRaises(ValidationError):\n            self.svc.start_subscription(\"acct_1\", \"nonexistent\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n        self.service.register_promo(\"B\", amount_off_cents=20)\n        for promo_code in (\"missing\", \"A,B\", \"A, B\", \"\", True):\n            with self.subTest(promo_code=promo_code), self.assertRaises(ValidationError):\n                self.service.place_order(\"acct\", self.items, promo_code=promo_code)\n\n        self.assertEqual(self.service.ledger.entries_for_account(\"acct\"), [])\n\n    def test_minimum_uses_pre_discount_subtotal_including_legacy_fee(self) -> None:\n        self.service.register_promo(\"MIN\", amount_off_cents=20, min_subtotal_cents=601)\n        with self.assertRaises(ValidationError):\n            self.service.place_order(\"acct\", self.items, promo_code=\"MIN\")\n\n        order = self.service.place_order(\n            \"acct\", self.items, legacy_flat_fee=True, tax_bps=1000, promo_code=\"MIN\"\n        )\n        self.assertEqual(order.discount_cents, 20)\n        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (581, 58, 639))\n\n    def test_invalid_promo_registration(self) -> None:\n        for code, options in [\n            (\"\", {\"percent_off\": 10}),\n            (\"A,B\", {\"percent_off\": 10}),\n            (\"BAD\", {}),\n            (\"BAD\", {\"percent_off\": 5, \"amount_off_cents\": 5}),\n            (\"BAD\", {\"percent_off\": 0}),\n            (\"BAD\", {\"percent_off\": 101}),\n            (\"BAD\", {\"percent_off\": True}),\n            (\"BAD\", {\"amount_off_cents\": 0}),\n            (\"BAD\", {\"amount_off_cents\": 1.5}),\n            (\"BAD\", {\"amount_off_cents\": 5, \"min_subtotal_cents\": -1}),\n            (\"BAD\", {\"amount_off_cents\": 5, \"min_subtotal_cents\": False}),\nbenchmarks/sources/ev1_order_ledger/ledger.py:130:        before_commit: Callable[[LedgerEntry], None] | None = None,\nbenchmarks/sources/ev1_order_ledger/ledger.py:167:            self._record_mutation(entry, before_commit)\nbenchmarks/sources/ev1_order_ledger/ledger.py:179:        before_commit: Callable[[LedgerEntry], None] | None = None,\nbenchmarks/sources/ev1_order_ledger/ledger.py:211:            self._record_mutation(entry, before_commit)\nbenchmarks/sources/ev1_order_ledger/ledger.py:216:        self, entry: LedgerEntry, before_commit: Callable[[LedgerEntry], None] | None\nbenchmarks/sources/ev1_order_ledger/ledger.py:218:        if before_commit is not None:\nbenchmarks/sources/ev1_order_ledger/ledger.py:219:            before_commit(entry)\nbenchmarks/sources/ev1_order_ledger/api.py:17:        audit_sink: Callable[[Dict[str, str | int]], None] | None = None,\nbenchmarks/sources/ev1_order_ledger/api.py:20:        self._audit_sink = audit_sink\nbenchmarks/sources/ev1_order_ledger/api.py:22:    def _audit_entry(self, entry: LedgerEntry) -> None:\nbenchmarks/sources/ev1_order_ledger/api.py:23:        if self._audit_sink is not None:\nbenchmarks/sources/ev1_order_ledger/api.py:24:            self._audit_sink({\nbenchmarks/sources/ev1_order_ledger/api.py:89:        self._audit_entry(entry)\nbenchmarks/sources/ev1_order_ledger/api.py:107:            before_commit=self._audit_entry,\nbenchmarks/sources/ev1_order_ledger/api.py:157:            before_commit=self._audit_entry,\n","exit_code":0,"status":