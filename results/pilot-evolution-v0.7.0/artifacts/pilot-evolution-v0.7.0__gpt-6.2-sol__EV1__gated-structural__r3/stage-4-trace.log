order_ledger/ledger.py:166:            self.record_entry(entry)\nbenchmarks/sources/ev1_order_ledger/ledger.py:168:            self._idempotent_entries[idempotency_key] = (arguments, entry.entry_id)\nbenchmarks/sources/ev1_order_ledger/ledger.py:200:                entry_id=self.next_id(\"ent\"),\nbenchmarks/sources/ev1_order_ledger/ledger.py:209:            self.record_entry(entry)\nbenchmarks/sources/ev1_order_ledger/ledger.py:210:            self._idempotent_entries[idempotency_key] = (arguments, entry.entry_id)\nbenchmarks/sources/ev1_order_ledger/ledger.py:213:    def record_entry(self, entry: LedgerEntry) -> None:\nbenchmarks/sources/ev1_order_ledger/tests/test_orders.py:30:    def test_legacy_flat_fee_adds_500_cents_before_tax(self) -> None:\nbenchmarks/sources/ev1_order_ledger/tests/test_orders.py:35:            legacy_flat_fee=True,\nbenchmarks/sources/ev1_order_ledger/tests/test_promos.py:61:            \"acct\", self.items, legacy_flat_fee=True, tax_bps=1000, promo_code=\"MIN\"\n\"\"\"Service facade coordinating pricing and ledger persistence for EV1.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Dict, Sequence\n\nfrom .ledger import OrderLedger\nfrom .models import LedgerEntry, LineItem, Order, Plan, Subscription, ValidationError\nfrom .pricing import calculate_order_totals\n\n\nclass OrderService:\n    def __init__(self, ledger: OrderLedger | None = None) -> None:\n        self.ledger = ledger if ledger is not None else OrderLedger()\n\n    def register_plan(self, plan: Plan) -> None:\n        self.ledger.add_plan(plan)\n\n    def register_promo(\n        self,\n        code: str,\n        *,\n        percent_off: int | None = None,\n        amount_off_cents: int | None = None,\n        expires_on: str | None = None,\n        min_subtotal_cents: int = 0,\n    ) -> None:\n        self.ledger.register_promo(\n            code,\n            percent_off=percent_off,\n            amount_off_cents=amount_off_cents,\n            expires_on=expires_on,\n            min_subtotal_cents=min_subtotal_cents,\n        )\n\n    def place_order(\n        self,\n        account_id: str,\n        items: Sequence[LineItem],\n        *,\n        tax_bps: int = 0,\n        legacy_flat_fee: bool = False,\n        promo_code: str | None = None,\n        as_of: str | None = None,\n    ) -> Order:\n        if not account_id.strip():\n            raise ValidationError(\"account_id must be non-empty\")\n        promo = self.ledger.get_promo(promo_code)\n        totals = calculate_order_totals(\n            items,\n            tax_bps=tax_bps,\n            legacy_flat_fee=legacy_flat_fee,\n            promo=promo,\n            as_of=as_of,\n        )\n        order_id = self.ledger.next_id(\"ord\")\n        order = Order(\n            order_id=order_id,\n            account_id=account_id,\n            items=tuple(items),\n            subtotal_cents=totals.subtotal_cents,\n            tax_cents=totals.tax_cents,\n            total_cents=totals.total_cents,\n            discount_cents=totals.discount_cents,\n            promo_code=promo.code if promo is not None else None,\n        )\n        self.ledger.save_order(order)\n        entry = LedgerEntry(\n            entry_id=self.ledger.next_id(\"ent\"),\n            account_id=account_id,\n            kind=\"order_charge\",\n            subtotal_cents=totals.subtotal_cents,\n            tax_cents=totals.tax_cents,\n            total_cents=totals.total_cents,\n            reference_id=order_id,\n        )\n        self.ledger.record_entry(entry)\n        return order\n\n    def refund_order(\n        self,\n        order_id: str,\n        amount_cents: int,\n        *,\n        reason: str,\n        idempotency_key: str,\n    ) -> LedgerEntry:\n        return self.ledger.apply_order_refund(\n            order_id, amount_cents, reason=reason, idempotency_key=idempotency_key\n        )\n\n    def export_credit_note(self, refund_entry_id: str) -> Dict[str, str | int]:\n        if not isinstance(refund_entry_id, str):\n            raise ValidationError(\"refund_entry_id must be a string\")\n        entry = self.ledger.get_entry(refund_entry_id)\n        if entry is None or entry.kind != \"order_refund\":\n            raise ValidationError(f\"Unknown refund entry: {refund_entry_id}\")\n        return {\n            \"entry_id\": entry.entry_id,\n            \"order_id\": entry.reference_id,\n            \"account_id\": entry.account_id,\n            \"subtotal_cents\": -entry.subtotal_cents,\n            \"tax_cents\": -entry.tax_cents,\n            \"total_cents\": -entry.total_cents,\n            \"reason\": entry.reason,\n        }\n\n    def start_subscription(self, account_id: str, plan_id: str) -> Subscription:\n        if not account_id.strip():\n            raise ValidationError(\"account_id must be non-empty\")\n        self.ledger.get_plan(plan_id)\n        sub = Subscription(\n            subscription_id=self.ledger.next_id(\"sub\"),\n            account_id=account_id,\n            plan_id=plan_id,\n        )\n        self.ledger.save_subscription(sub)\n        return sub\n\n    def upgrade_subscription(\n        self,\n        subscription_id: str,\n        new_plan_id: str,\n        days_remaining: int,\n        cycle_days: int,\n        *,\n        idempotency_key: str,\n        promo_code: str | None = None,\n        as_of: str | None = None,\n    ) -> LedgerEntry:\n        return self.ledger.apply_plan_upgrade(\n            subscription_id,\n            new_plan_id,\n            days_remaining,\n            cycle_days,\n            idempotency_key=idempotency_key,\n            promo_code=promo_code,\n            as_of=as_of,\n        )\n\n    def get_statement(self, account_id: str) -> Dict[str, object]:\n        entries = self.ledger.entries_for_account(account_id)\n        return {\n            \"account_id\": account_id,\n            \"balance_cents\": self.ledger.account_balance_cents(account_id),\n            \"entry_count\": len(entries),\n        }\n\"\"\"In-memory order, subscription, and ledger store for EV1.\"\"\"\n\nfrom __future__ import annotations\n\nfrom threading import RLock\nfrom typing import Dict, List, Optional\n\nfrom .models import LedgerEntry, Order, Plan, Promo, Subscription, ValidationError\nfrom .pricing import (\n    calculate_refund_split,\n    calculate_upgrade_totals,\n    parse_optional_date,\n    validate_non_negative_int,\n    validate_positive_int,\n    validate_proration_window,\n)\n\n\ndef _validate_non_empty_string(value: str, field_name: str) -> None:\n    if not isinstance(value, str) or not value.strip():\n        raise ValidationError(f\"{field_name} must be a non-empty string\")\n\n\ndef _validate_promo_code(code: str) -> None:\n    _validate_non_empty_string(code, \"promo code\")\n    if \",\" in code:\n        raise ValidationError(\"only one promo code is allowed\")\n\n\nclass OrderLedger:\n    def __init__(self) -> None:\n        self._plans: Dict[str, Plan] = {}\n        self._promos: Dict[str, Promo] = {}\n        self._orders: Dict[str, Order] = {}\n        self._subscriptions: Dict[str, Subscription] = {}\n        self._entries: Dict[str, LedgerEntry] = {}\n        self._entry_order: List[str] = []\n        self._idempotent_entries: Dict[str, tuple[tuple[object, ...], str]] = {}\n        self._lock = RLock()\n        self._seq = 0\n\n    def next_id(self, prefix: str) -> str:\n        with self._lock:\n            self._seq += 1\n            return f\"{prefix}_{self._seq:04d}\"\n\n    def add_plan(self, plan: Plan) -> None:\n        if not plan.plan_id.strip():\n            raise ValidationError(\"plan_id must be non-empty\")\n        if isinstance(plan.monthly_cents, bool) or not isinstance(plan.monthly_cents, int) or plan.monthly_cents < 0:\n            raise ValidationError(\"monthly_cents must be a non-negative integer\")\n        self._plans[plan.plan_id] = plan\n\n    def get_plan(self, plan_id: str) -> Plan:\n        plan = self._plans.get(plan_id)\n        if plan is None:\n            raise ValidationError(f\"Unknown plan_id: {plan_id}\")\n        return plan\n\n    def register_promo(\n        self,\n        code: str,\n        *,\n        percent_off: int | None = None,\n        amount_off_cents: int | None = None,\n        expires_on: str | None = None,\n        min_subtotal_cents: int = 0,\n    ) -> None:\n        _validate_promo_code(code)\n        if (percent_off is None) == (amount_off_cents is None):\n            raise ValidationError(\"provide exactly one of percent_off and amount_off_cents\")\n        if percent_off is not None:\n            validate_positive_int(percent_off, \"percent_off\")\n            if percent_off > 100:\n                raise ValidationError(\"percent_off cannot exceed 100\")\n        if amount_off_cents is not None:\n            validate_positive_int(amount_off_cents, \"amount_off_cents\")\n        validate_non_negative_int(min_subtotal_cents, \"min_subtotal_cents\")\n        expiry = parse_optional_date(expires_on, \"expires_on\")\n        self._promos[code] = Promo(code, percent_off, amount_off_cents or 0, expiry, min_subtotal_cents)\n\n    def get_promo(self, code: str | None) -> Promo | None:\n        if code is None:\n            return None\n        _validate_promo_code(code)\n        promo = self._promos.get(code)\n        if promo is None:\n            raise ValidationError(f\"Unknown promo code: {code}\")\n        return promo\n\n    def save_order(self, order: Order) -> None:\n        self._orders[order.order_id] = order\n\n    def get_order(self, order_id: str) -> Order:\n        order = self._orders.get(order_id)\n        if order is None:\n            raise ValidationError(f\"Unknown order_id: {order_id}\")\n        return order\n\n    def save_subscription(self, sub: Subscription) -> None:\n        self._subscriptions[sub.subscription_id] = sub\n\n    def get_subscription(self, subscription_id: str) -> Subscription:\n        sub = self._subscriptions.get(subscription_id)\n        if sub is None:\n            raise ValidationError(f\"Unknown subscription_id: {subscription_id}\")\n        return sub\n\n    def _replay_entry(\n        self, idempotency_key: str, arguments: tuple[object, ...]\n    ) -> LedgerEntry | None:\n        previous = self._idempotent_entries.get(idempotency_key)\n        if previous is None:\n            return None\n        previous_arguments, entry_id = previous\n        if previous_arguments != arguments:\n            raise ValidationError(\"idempotency_key already used with different arguments\")\n        return self._entries[entry_id]\n\n    def apply_plan_upgrade(\n        self,\n        subscription_id: str,\n        new_plan_id: str,\n        days_remaining: int,\n        cycle_days: int,\n        *,\n        idempotency_key: str,\n        promo_code: str | None = None,\n        as_of: str | None = None,\n    ) -> LedgerEntry:\n        if not isinstance(subscription_id, str):\n            raise ValidationError(\"subscription_id must be a string\")\n        if not isinstance(new_plan_id, str):\n            raise ValidationError(\"new_plan_id must be a string\")\n        _validate_non_empty_string(idempotency_key, \"idempotency_key\")\n        validate_proration_window(days_remaining, cycle_days)\n        arguments = (\n            \"plan_upgrade\", subscription_id, new_plan_id, days_remaining, cycle_days, promo_code, as_of\n        )\n\n        with self._lock:\n            previous = self._replay_entry(idempotency_key, arguments)\n            if previous is not None:\n                return previous\n\n            sub = self.get_subscription(subscription_id)\n            old_plan = self.get_plan(sub.plan_id)\n            new_plan = self.get_plan(new_plan_id)\n            totals = calculate_upgrade_totals(\n                old_plan,\n                new_plan,\n                days_remaining,\n                cycle_days,\n                promo=self.get_promo(promo_code),\n                as_of=as_of,\n            )\n            entry = LedgerEntry(\n                entry_id=self.next_id(\"ent\"),\n                account_id=sub.account_id,\n                kind=\"plan_upgrade\",\n                subtotal_cents=totals.subtotal_cents,\n                tax_cents=totals.tax_cents,\n                total_cents=totals.total_cents,\n                reference_id=subscription_id,\n            )\n            self.record_entry(entry)\n            sub.plan_id = new_plan_id\n            self._idempotent_entries[idempotency_key] = (arguments, entry.entry_id)\n            return entry\n\n    def apply_order_refund(\n        self,\n        order_id: str,\n        amount_cents: int,\n        *,\n        reason: str,\n        idempotency_key: str,\n    ) -> LedgerEntry:\n        _validate_non_empty_string(order_id, \"order_id\")\n        validate_positive_int(amount_cents, \"amount_cents\")\n        _validate_non_empty_string(reason, \"reason\")\n        _validate_non_empty_string(idempotency_key, \"idempotency_key\")\n        arguments = (\"order_refund\", order_id, amount_cents, reason)\n\n        with self._lock:\n            previous = self._replay_entry(idempotency_key, arguments)\n            if previous is not None:\n                return previous\n\n            order = self.get_order(order_id)\n            already_refunded_cents = sum(\n                -entry.total_cents\n                for entry in self.entries_for_account(order.account_id)\n                if entry.kind == \"order_refund\" and entry.reference_id == order_id\n            )\n            refund_subtotal, refund_tax = calculate_refund_split(\n                order, already_refunded_cents, amount_cents\n            )\n            entry = LedgerEntry(\n                entry_id=self.next_id(\"ent\"),\n                account_id=order.account_id,\n                kind=\"order_refund\",\n                subtotal_cents=-refund_subtotal,\n                tax_cents=-refund_tax,\n                total_cents=-amount_cents,\n                reference_id=order_id,\n                reason=reason,\n            )\n            self.record_entry(entry)\n            self._idempotent_entries[idempotency_key] = (arguments, entry.entry_id)\n            return entry\n\n    def record_entry(self, entry: LedgerEntry) -> None:\n        self._entries[entry.entry_id] = entry\n        self._entry_order.append(entry.entry_id)\n\n    def get_entry(self, entry_id: str) -> Optional[LedgerEntry]:\n        return self._entries.get(entry_id)\n\n    def entries_for_account(self, account_id: str) -> List[LedgerEntry]:\n        return [\n            self._entries[eid]\n            for eid in self._entry_order\n            if self._entries[eid].account_id == account_id\n        ]\n\n    def account_balance_cents(self, account_id: str) -> int:\n        return sum(e.total_cents for e in self.entries_for_account(account_id))\n","exit_code":0,"status":"completed"}}
