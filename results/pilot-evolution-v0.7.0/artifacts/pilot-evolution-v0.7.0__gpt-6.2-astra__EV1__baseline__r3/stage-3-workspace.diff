+import unittest
+
+from ev1_order_ledger import LineItem, OrderService, ValidationError
+
+
+class RefundTests(unittest.TestCase):
+    def setUp(self):
+        self.service = OrderService()
+        self.service.register_promo("SAVE", amount_off_cents=4)
+        self.order = self.service.place_order(
+            "account", [LineItem("item", 10, 1)], tax_bps=3333, promo_code="SAVE"
+        )
+
+    def refund(self, amount, key="key", reason="return"):
+        return self.service.refund_order(
+            self.order.order_id, amount, reason=reason, idempotency_key=key
+        )
+
+    def test_partial_refunds_conserve_discounted_subtotal_and_tax(self):
+        # Original charge is 6 cents plus 2 cents tax. The second penny
+        # reaches the first half-cent of cumulative tax and rounds up.
+        entries = []
+        for amount, tax in [(1, 0), (1, 1), (3, 0), (3, 1)]:
+            entry = self.refund(amount, str(len(entries)))
+            self.assertEqual(entry.kind, "order_refund")
+            self.assertEqual(entry.total_cents, -amount)
+            self.assertEqual(entry.tax_cents, -tax)
+            self.assertEqual(entry.subtotal_cents + entry.tax_cents, entry.total_cents)
+            entries.append(entry)
+        self.assertEqual(sum(e.subtotal_cents for e in entries), -self.order.subtotal_cents)
+        self.assertEqual(sum(e.tax_cents for e in entries), -self.order.tax_cents)
+        self.assertEqual(self.service.get_statement("account")["balance_cents"], 0)
+
+    def test_over_refund_leaves_remaining_balance_and_key_available(self):
+        self.refund(3)
+        with self.assertRaises(ValidationError):
+            self.refund(6, "next")
+        self.refund(5, "next")
+        with self.assertRaises(ValidationError):
+            self.refund(1, "excess")
+        self.assertEqual(self.service.get_statement("account"), {
+            "account_id": "account", "entry_count": 3, "balance_cents": 0,
+        })
+
+    def test_replay_and_conflicting_arguments_on_shared_ledger(self):
+        original = self.refund(1)
+        other = self.service.place_order("account", [LineItem("other", 10, 1)])
+        self.refund(7, "last")
+        second_service = OrderService(self.service.ledger)
+        for order_id, amount, reason in [
+            (other.order_id, 1, "return"),
+            (self.order.order_id, 2, "return"),
+            (self.order.order_id, 1, "damaged"),
+            (self.order.order_id, True, "return"),
+        ]:
+            with self.subTest(order_id=order_id, amount=amount, reason=reason), self.assertRaises(ValidationError):
+                second_service.refund_order(order_id, amount, reason=reason, idempotency_key="key")
+        replay = second_service.refund_order(self.order.order_id, 1, reason="return", idempotency_key="key")
+        self.assertIs(replay, original)
+        self.assertEqual(self.service.get_statement("account")["entry_count"], 4)
+
+    def test_invalid_inputs_do_not_record_refunds(self):
+        for amount, key, reason in [
+            (0, "key", "return"), (-1, "key", "return"), (1.5, "key", "return"),
