+import unittest
+
+from ev1_order_ledger import OrderService, Plan, ValidationError
+
+
+class UpgradeTests(unittest.TestCase):
+    def setUp(self):
+        self.service = OrderService()
+        self.service.register_plan(Plan("base", "Base", 1000))
+        self.service.register_plan(Plan("pro", "Pro", 1201, 5000))
+        self.service.register_plan(Plan("premium", "Premium", 2000))
+        self.sub = self.service.start_subscription("account", "base")
+
+    def upgrade(self, days=1, cycle=2, plan="pro", key="request"):
+        return self.service.upgrade_subscription(
+            self.sub.subscription_id, plan, days, cycle, idempotency_key=key
+        )
+
+    def test_half_up_proration_then_half_up_tax(self):
+        entry = self.upgrade()
+        # Half the price difference is 100.5 cents. Tax on 101 cents is 50.5.
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (101, 51, 152))
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.sub.subscription_id)
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertEqual(self.service.get_statement("account"), {
+            "account_id": "account", "balance_cents": 152, "entry_count": 1,
+        })
+
+    def test_proration_preserves_large_integer_precision(self):
+        difference = 2**54 + 1
+        self.service.register_plan(Plan("large", "Large", 1000 + difference))
+        self.assertEqual(self.upgrade(plan="large").subtotal_cents, 2**53 + 1)
+
+    def test_zero_and_full_cycle(self):
+        self.assertEqual(self.upgrade(days=0).total_cents, 0)
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertEqual(self.upgrade(days=2, plan="premium", key="next").subtotal_cents, 799)
+
+    def test_invalid_periods_and_keys_leave_upgrade_retryable(self):
+        for days, cycle in [(-1, 2), (3, 2), (0, 0), (0, -1), (False, 2), (1, True), (1.0, 2)]:
+            with self.subTest(days=days, cycle=cycle), self.assertRaises(ValidationError):
+                self.upgrade(days, cycle)
+        for key in ["", "  ", False]:
+            with self.subTest(key=key), self.assertRaises(ValidationError):
+                self.upgrade(key=key)
+        self.assertEqual(self.sub.plan_id, "base")
+        self.assertEqual(self.service.get_statement("account")["entry_count"], 0)
+        self.upgrade()
+
+    def test_unknown_ids_and_non_upgrades(self):
+        self.service.register_plan(Plan("equal", "Equal", 1000))
+        self.service.register_plan(Plan("cheap", "Cheap", 999))
+        for plan in ["missing", "base", "equal", "cheap", True]:
+            with self.subTest(plan=plan), self.assertRaises(ValidationError):
+                self.upgrade(plan=plan)
+        with self.assertRaises(ValidationError):
+            self.service.upgrade_subscription("missing", "pro", 1, 2, idempotency_key="request")
+        self.assertEqual(self.sub.plan_id, "base")
+        self.assertEqual(self.service.get_statement("account")["entry_count"], 0)
+
+    def test_replay_after_another_upgrade_with_shared_ledger(self):
+        original = self.upgrade()
+        self.upgrade(plan="premium", key="next")
+        second_service = OrderService(self.service.ledger)
+        replay = second_service.upgrade_subscription(
+            self.sub.subscription_id, "pro", 1, 2, idempotency_key="request"
+        )
+        self.assertIs(replay, original)
+        self.assertEqual(self.sub.plan_id, "premium")
+        self.assertEqual(self.service.get_statement("account")["entry_count"], 2)
+
+    def test_conflicts_check_every_argument_and_preserve_original(self):
+        original = self.upgrade()
+        other = self.service.start_subscription("account", "base")
+        for args in [
+            (other.subscription_id, "pro", 1, 2),
+            (self.sub.subscription_id, "premium", 1, 2),
+            (self.sub.subscription_id, "pro", 0, 2),
+            (self.sub.subscription_id, "pro", 1, 3),
+            (self.sub.subscription_id, "pro", True, 2),
+        ]:
+            with self.subTest(args=args), self.assertRaises(ValidationError):
+                self.service.upgrade_subscription(*args, idempotency_key="request")
+        self.assertIs(self.upgrade(), original)
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertEqual(other.plan_id, "base")
+        self.assertEqual(self.service.ledger.entries_for_account("account"), [original])
