+import unittest
+
+from ev1_order_ledger import LineItem, OrderService, Plan, ValidationError
+
+
+class PromoTests(unittest.TestCase):
+    def setUp(self):
+        self.service = OrderService()
+
+    def order(self, cents, code, **kwargs):
+        return self.service.place_order(
+            "account", [LineItem("item", cents, 1)], tax_bps=1000, promo_code=code, **kwargs
+        )
+
+    def test_registration_rejects_invalid_definitions(self):
+        for code, options in [
+            ("", {"percent_off": 1}), ("  ", {"percent_off": 1}), ("A,B", {"percent_off": 1}),
+            ("P", {}), ("P", {"percent_off": 10, "amount_off_cents": 5}),
+            ("P", {"percent_off": 0}), ("P", {"percent_off": 101}), ("P", {"percent_off": True}),
+            ("P", {"amount_off_cents": 0}), ("P", {"amount_off_cents": 1.5}),
+            ("P", {"percent_off": 1, "min_subtotal_cents": -1}),
+            ("P", {"percent_off": 1, "expires_on": "2026-02-30"}),
+        ]:
+            with self.subTest(code=code, options=options), self.assertRaises(ValidationError):
+                self.service.register_promo(code, **options)
+
+    def test_percentage_rounds_half_up_before_tax(self):
+        self.service.register_promo("HALF", percent_off=50)
+        order = self.order(101, "HALF")
+        self.assertEqual((order.discount_cents, order.subtotal_cents, order.tax_cents), (51, 50, 5))
+        self.assertEqual(order.promo_code, "HALF")
+        self.assertEqual(order.total_cents, 55)
+        self.assertEqual(self.service.get_statement("account")["balance_cents"], 55)
+
+    def test_fixed_discount_clamps_and_includes_flat_fee_in_subtotal(self):
+        self.service.register_promo("FIXED", amount_off_cents=150)
+        free = self.order(100, "FIXED")
+        self.assertEqual((free.discount_cents, free.subtotal_cents, free.total_cents), (100, 0, 0))
+        order = self.order(100, "FIXED", legacy_flat_fee=True)
+        self.assertEqual((order.discount_cents, order.subtotal_cents, order.total_cents), (150, 450, 495))
+
+    def test_eligibility_and_date_boundaries(self):
+        self.service.register_promo("A", percent_off=100, min_subtotal_cents=100, expires_on="2028-02-29")
+        self.service.register_promo("B", amount_off_cents=1)
+        for cents, code, as_of in [
+            (100, "missing", None), (100, "A,B", "2028-02-29"), (99, "A", "2028-02-29"),
+            (100, "A", None), (100, "A", "2028-03-01"), (100, "A", "20280229"),
+            (100, "A", "2028-02-30"),
+        ]:
+            with self.subTest(cents=cents, code=code, as_of=as_of), self.assertRaises(ValidationError):
+                self.order(cents, code, as_of=as_of)
+        self.assertEqual(self.service.get_statement("account")["entry_count"], 0)
+        self.assertEqual(self.order(100, "A", as_of="2028-02-29").discount_cents, 100)
+
+    def test_upgrade_discounts_prorated_subtotal_and_replays(self):
+        self.service.register_plan(Plan("old", "Old", 1000))
+        self.service.register_plan(Plan("new", "New", 1201, 1000))
+        sub = self.service.start_subscription("account", "old")
+        self.service.register_promo("A", percent_off=50, expires_on="2028-01-01", min_subtotal_cents=101)
+        self.service.register_promo("B", percent_off=50)
+
+        def upgrade(code, as_of, days=1):
+            return self.service.upgrade_subscription(
+                sub.subscription_id, "new", days, 2, idempotency_key="key", promo_code=code, as_of=as_of
+            )
+
+        with self.assertRaises(ValidationError):
+            upgrade("A", "2028-01-01", days=0)
+        with self.assertRaises(ValidationError):
+            upgrade("A", None)
+        self.assertEqual(sub.plan_id, "old")
+        self.assertEqual(self.service.get_statement("account")["entry_count"], 0)
+        entry = upgrade("A", "2028-01-01")
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (50, 5, 55))
+        self.assertIs(upgrade("A", "2028-01-01"), entry)
+        for code, as_of in [("B", "2028-01-01"), ("A", "2027-12-31")]:
+            with self.subTest(code=code, as_of=as_of), self.assertRaises(ValidationError):
+                upgrade(code, as_of)
+        self.assertEqual(self.service.ledger.entries_for_account("account"), [entry])

