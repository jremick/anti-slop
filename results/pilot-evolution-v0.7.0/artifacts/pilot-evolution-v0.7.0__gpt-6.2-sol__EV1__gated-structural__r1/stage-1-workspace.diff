+    old_monthly_cents: int, new_monthly_cents: int, days_remaining: int, cycle_days: int
+) -> int:
+    """Prorate an upgrade over a validated billing period."""
+    price_increase = new_monthly_cents - old_monthly_cents
+    if price_increase <= 0:
+        raise ValidationError("new plan must cost more than the current plan")
+    return round_half_up_div(price_increase * days_remaining, cycle_days)
