+"""Unit tests for prorated, idempotent subscription upgrades."""
+
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import Plan, ValidationError
+
+
+class SubscriptionUpgradeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.service = OrderService()
+        self.service.register_plan(Plan("starter", "Starter", 1000))
+        self.service.register_plan(Plan("pro", "Pro", 1005, tax_bps=5000))
+        self.service.register_plan(Plan("premium", "Premium", 1100))
+        self.subscription = self.service.start_subscription("acct_1", "starter")
+
+    def test_upgrade_rounds_proration_and_new_plan_tax_half_up(self) -> None:
+        entry = self.service.upgrade_subscription(
+            self.subscription.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+
+        self.assertEqual(entry.subtotal_cents, 3)  # 5 * 1 / 2 = 2.5
+        self.assertEqual(entry.tax_cents, 2)  # 3 * 5000 / 10000 = 1.5
+        self.assertEqual(entry.total_cents, 5)
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.subscription.subscription_id)
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual(self.subscription.plan_id, "pro")
+        self.assertIs(self.service.ledger.get_entry(entry.entry_id), entry)
+        self.assertEqual(self.service.get_statement("acct_1")["balance_cents"], 5)
+
+    def test_proration_accepts_both_period_boundaries_and_rounds_down_below_half(self) -> None:
+        for days_remaining, cycle_days, expected_subtotal in [(0, 2, 0), (1, 4, 1), (2, 2, 5)]:
+            with self.subTest(days_remaining=days_remaining, cycle_days=cycle_days):
+                subscription = self.service.start_subscription("acct_1", "starter")
+                entry = self.service.upgrade_subscription(
+                    subscription.subscription_id,
+                    "pro",
+                    days_remaining,
+                    cycle_days,
+                    idempotency_key=subscription.subscription_id,
+                )
+                self.assertEqual(entry.subtotal_cents, expected_subtotal)
+                self.assertEqual(subscription.plan_id, "pro")
+
+    def test_invalid_inputs_leave_state_and_key_available(self) -> None:
+        self.service.register_plan(Plan("cheaper", "Cheaper", 999))
+        subscription_id = self.subscription.subscription_id
+        invalid_requests = [
+            ("missing", "pro", 1, 2, "upgrade"),
+            (subscription_id, "missing", 1, 2, "upgrade"),
+            (subscription_id, "starter", 1, 2, "upgrade"),
+            (subscription_id, "cheaper", 1, 2, "upgrade"),
+            (subscription_id, "pro", 0, 0, "upgrade"),
+            (subscription_id, "pro", 0, -1, "upgrade"),
+            (subscription_id, "pro", -1, 2, "upgrade"),
+            (subscription_id, "pro", 3, 2, "upgrade"),
+            (True, "pro", 1, 2, "upgrade"),
+            (subscription_id, True, 1, 2, "upgrade"),
+            (subscription_id, "pro", True, 2, "upgrade"),
+            (subscription_id, "pro", 1, True, "upgrade"),
+            (subscription_id, "pro", 1.0, 2, "upgrade"),
+            (subscription_id, "pro", 1, 2, True),
+            (subscription_id, "pro", 1, 2, ""),
+            (subscription_id, "pro", 1, 2, "  "),
+        ]
+        for sub_id, plan_id, remaining, cycle, key in invalid_requests:
+            with self.subTest(request=(sub_id, plan_id, remaining, cycle, key)):
+                with self.assertRaises(ValidationError):
+                    self.service.upgrade_subscription(
+                        sub_id, plan_id, remaining, cycle, idempotency_key=key
+                    )
+                self.assertEqual(self.subscription.plan_id, "starter")
+                self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [])
+
+        self.service.upgrade_subscription(subscription_id, "pro", 1, 2, idempotency_key="upgrade")
+        self.assertEqual(self.subscription.plan_id, "pro")
+
+    def test_replay_returns_original_entry_across_services_and_later_upgrades(self) -> None:
+        subscription_id = self.subscription.subscription_id
+        first = self.service.upgrade_subscription(subscription_id, "pro", 1, 2, idempotency_key="first")
+        second_service = OrderService(self.service.ledger)
+
+        replay = second_service.upgrade_subscription(subscription_id, "pro", 1, 2, idempotency_key="first")
+        self.assertIs(replay, first)
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [first])
+
+        second = second_service.upgrade_subscription(
+            subscription_id, "premium", 1, 1, idempotency_key="second"
+        )
+        self.assertEqual(second.subtotal_cents, 95)
+        replay = second_service.upgrade_subscription(subscription_id, "pro", 1, 2, idempotency_key="first")
+        self.assertIs(replay, first)
+        self.assertEqual(self.subscription.plan_id, "premium")
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [first, second])
+
+    def test_reused_key_rejects_changes_to_any_argument(self) -> None:
+        subscription_id = self.subscription.subscription_id
+        other = self.service.start_subscription("acct_2", "starter")
+        first = self.service.upgrade_subscription(subscription_id, "pro", 1, 2, idempotency_key="upgrade")
+        conflicts = [
+            (other.subscription_id, "pro", 1, 2),
+            (subscription_id, "premium", 1, 2),
+            (subscription_id, "pro", 0, 2),
+            (subscription_id, "pro", 1, 3),
+        ]
+        for arguments in conflicts:
+            with self.subTest(arguments=arguments):
+                with self.assertRaisesRegex(ValidationError, "different arguments"):
+                    self.service.upgrade_subscription(*arguments, idempotency_key="upgrade")
+
+        with self.assertRaises(ValidationError):
+            self.service.upgrade_subscription(subscription_id, "pro", True, 2, idempotency_key="upgrade")
+        self.assertEqual(self.subscription.plan_id, "pro")
+        self.assertEqual(other.plan_id, "starter")
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [first])
+        self.assertEqual(self.service.ledger.entries_for_account("acct_2"), [])
