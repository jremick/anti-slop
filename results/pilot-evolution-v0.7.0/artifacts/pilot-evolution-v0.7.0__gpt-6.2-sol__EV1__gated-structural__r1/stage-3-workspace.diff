+    cumulative_cents = already_refunded_cents + amount_cents
+    if cumulative_cents > order.total_cents:
+        raise ValidationError("refund exceeds the remaining order balance")
+    previous_tax = round_half_up_div(already_refunded_cents * order.tax_cents, order.total_cents)
+    cumulative_tax = round_half_up_div(cumulative_cents * order.tax_cents, order.total_cents)
+    return cumulative_tax - previous_tax
