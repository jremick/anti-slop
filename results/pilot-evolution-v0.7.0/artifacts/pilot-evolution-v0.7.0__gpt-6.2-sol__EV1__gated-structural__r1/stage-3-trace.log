{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc 'cat benchmarks/sources/ev1_order_ledger/{pricing,models}.py; cat AGENTS.md; rg --files --hidden'","aggregated_output":"\"\"\"Canonical integer-cent pricing calculations for EV1 order ledger.\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import date\nfrom typing import NamedTuple, Sequence\n\nfrom .models import LineItem, Promo, ValidationError\n\n\nLEGACY_FLAT_FEE_CENTS = 500\n\n\nclass ChargeTotals(NamedTuple):\n    subtotal_cents: int\n    tax_cents: int\n    total_cents: int\n    discount_cents: int\n\n\ndef validate_non_negative_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value < 0:\n        raise ValidationError(f\"{field_name} must be a non-negative integer\")\n    return value\n\n\ndef validate_positive_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:\n        raise ValidationError(f\"{field_name} must be a positive integer\")\n    return value\n\n\ndef round_half_up_div(numerator: int, denominator: int) -> int:\n    \"\"\"Exact integer half-up division for non-negative numerator and positive denominator.\"\"\"\n    validate_non_negative_int(numerator, \"numerator\")\n    validate_positive_int(denominator, \"denominator\")\n    return (numerator * 2 + denominator) // (2 * denominator)\n\n\ndef compute_subtotal_cents(items: Sequence[LineItem]) -> int:\n    if not items:\n        raise ValidationError(\"items must be non-empty\")\n    subtotal = 0\n    for item in items:\n        validate_positive_int(item.unit_cents, \"unit_cents\")\n        validate_positive_int(item.quantity, \"quantity\")\n        subtotal += item.unit_cents * item.quantity\n    return subtotal\n\n\ndef compute_tax_cents(taxable_cents: int, tax_bps: int) -> int:\n    validate_non_negative_int(taxable_cents, \"taxable_cents\")\n    validate_non_negative_int(tax_bps, \"tax_bps\")\n    if tax_bps > 10_000:\n        raise ValidationError(\"tax_bps cannot exceed 10000\")\n    return round_half_up_div(taxable_cents * tax_bps, 10_000)\n\n\ndef parse_optional_date(value: str | None, field_name: str) -> date | None:\n    if value is None:\n        return None\n    if isinstance(value, str):\n        try:\n            parsed = date.fromisoformat(value)\n        except ValueError:\n            pass\n        else:\n            if parsed.isoformat() == value:\n                return parsed\n    raise ValidationError(f\"{field_name} must be a date in YYYY-MM-DD format\")\n\n\ndef calculate_charge_totals(\n    subtotal_cents: int,\n    tax_bps: int,\n    *,\n    promo: Promo | None = None,\n    as_of: str | None = None,\n) -> ChargeTotals:\n    \"\"\"Apply an eligible promo before computing tax.\"\"\"\n    validate_non_negative_int(subtotal_cents, \"subtotal_cents\")\n    charge_date = parse_optional_date(as_of, \"as_of\")\n    discount = 0\n    if promo is not None:\n        if subtotal_cents < promo.min_subtotal_cents:\n            raise ValidationError(\"subtotal is below the promo minimum\")\n        if promo.expires_on is not None:\n            if charge_date is None:\n                raise ValidationError(\"as_of is required for a promo with an expiry date\")\n            if charge_date > promo.expires_on:\n                raise ValidationError(\"promo has expired\")\n        if promo.amount_off_cents is not None:\n            discount = min(subtotal_cents, promo.amount_off_cents)\n        elif promo.percent_off is not None:\n            discount = round_half_up_div(subtotal_cents * promo.percent_off, 100)\n        else:\n            raise ValidationError(\"promo must specify a discount\")\n\n    taxable = subtotal_cents - discount\n    tax = compute_tax_cents(taxable, tax_bps)\n    return ChargeTotals(taxable, tax, taxable + tax, discount)\n\n\ndef validate_proration_period(days_remaining: int, cycle_days: int) -> None:\n    validate_positive_int(cycle_days, \"cycle_days\")\n    validate_non_negative_int(days_remaining, \"days_remaining\")\n    if days_remaining > cycle_days:\n        raise ValidationError(\"days_remaining cannot exceed cycle_days\")\n\n\ndef compute_upgrade_subtotal_cents(\n    old_monthly_cents: int, new_monthly_cents: int, days_remaining: int, cycle_days: int\n) -> int:\n    \"\"\"Prorate an upgrade over a validated billing period.\"\"\"\n    price_increase = new_monthly_cents - old_monthly_cents\n    if price_increase <= 0:\n        raise ValidationError(\"new plan must cost more than the current plan\")\n    return round_half_up_div(price_increase * days_remaining, cycle_days)\n\n\ndef calculate_order_totals(\n    items: Sequence[LineItem],\n    *,\n    tax_bps: int = 0,\n    legacy_flat_fee: bool = False,\n    promo: Promo | None = None,\n    as_of: str | None = None,\n) -> ChargeTotals:\n    subtotal = compute_subtotal_cents(items)\n    if legacy_flat_fee:\n        subtotal += LEGACY_FLAT_FEE_CENTS\n    return calculate_charge_totals(subtotal, tax_bps, promo=promo, as_of=as_of)\n\"\"\"Core domain models for the EV1 order ledger fixture.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom datetime import date\nfrom typing import Tuple\n\n\nclass BillingError(Exception):\n    \"\"\"Base error for billing domain failures.\"\"\"\n\n\nclass ValidationError(BillingError):\n    \"\"\"Raised when input arguments or business invariants are violated.\"\"\"\n\n\n@dataclass(frozen=True)\nclass Plan:\n    plan_id: str\n    name: str\n    monthly_cents: int\n    tax_bps: int = 0\n\n\n@dataclass(frozen=True)\nclass Promo:\n    code: str\n    percent_off: int | None\n    amount_off_cents: int | None\n    expires_on: date | None\n    min_subtotal_cents: int\n\n\n@dataclass(frozen=True)\nclass LineItem:\n    sku: str\n    unit_cents: int\n    quantity: int\n\n\n@dataclass(frozen=True)\nclass Order:\n    order_id: str\n    account_id: str\n    items: Tuple[LineItem, ...]\n    subtotal_cents: int\n    tax_cents: int\n    total_cents: int\n    discount_cents: int = 0\n    promo_code: str | None = None\n\n\n@dataclass\nclass Subscription:\n    subscription_id: str\n    account_id: str\n    plan_id: str\n    status: str = \"active\"\n\n\n@dataclass(frozen=True)\nclass LedgerEntry:\n    entry_id: str\n    account_id: str\n    kind: str\n    subtotal_cents: int\n    tax_cents: int\n    total_cents: int\n    reference_id: str\n    reason: str = \"\"\n    metadata: dict = field(default_factory=dict)\nFollow the user's request directly using only the files provided in this workspace.\n\nAfter each stage, an automated anti-slop diff and structural review gate inspects your workspace changes. If it reports blocking shortcuts or compounding slop risks, resolve every reported finding before finalizing.\nAGENTS.md\nbenchmarks/sources/ev1_order_ledger/pricing.py\nbenchmarks/sources/ev1_order_ledger/run_checks.py\nbenchmarks/sources/ev1_order_ledger/api.py\nbenchmarks/sources/ev1_order_ledger/__init__.py\nbenchmarks/sources/ev1_order_ledger/ledger.py\nbenchmarks/sources/ev1_order_ledger/tests/test_orders.py\nbenchmarks/sources/ev1_order_ledger/tests/test_upgrades.py\nbenchmarks/sources/ev1_order_ledger/tests/test_promos.py\nbenchmarks/sources/ev1_order_ledger/models.py\n","exit_code":0,"status":"completed"}}
