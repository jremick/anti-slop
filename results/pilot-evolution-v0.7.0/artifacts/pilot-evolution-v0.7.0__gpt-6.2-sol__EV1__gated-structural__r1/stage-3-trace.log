{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc 'cat benchmarks/sources/ev1_order_ledger/{api,ledger}.py'","aggregated_output":"\"\"\"Service facade coordinating pricing and ledger persistence for EV1.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Dict, Sequence\n\nfrom .ledger import OrderLedger\nfrom .models import LedgerEntry, LineItem, Order, Plan, Subscription, ValidationError\nfrom .pricing import calculate_order_totals\n\n\nclass OrderService:\n    def __init__(self, ledger: OrderLedger | None = None) -> None:\n        self.ledger = ledger if ledger is not None else OrderLedger()\n\n    def register_plan(self, plan: Plan) -> None:\n        self.ledger.add_plan(plan)\n\n    def register_promo(\n        self,\n        code: str,\n        *,\n        percent_off: int | None = None,\n        amount_off_cents: int | None = None,\n        expires_on: str | None = None,\n        min_subtotal_cents: int = 0,\n    ) -> None:\n        self.ledger.register_promo(\n            code,\n            percent_off=percent_off,\n            amount_off_cents=amount_off_cents,\n            expires_on=expires_on,\n            min_subtotal_cents=min_subtotal_cents,\n        )\n\n    def place_order(\n        self,\n        account_id: str,\n        items: Sequence[LineItem],\n        *,\n        tax_bps: int = 0,\n        legacy_flat_fee: bool = False,\n        promo_code: str | None = None,\n        as_of: str | None = None,\n    ) -> Order:\n        if not account_id.strip():\n            raise ValidationError(\"account_id must be non-empty\")\n        totals = calculate_order_totals(\n            items,\n            tax_bps=tax_bps,\n            legacy_flat_fee=legacy_flat_fee,\n            promo=self.ledger.get_promo(promo_code),\n            as_of=as_of,\n        )\n        order_id = self.ledger.next_id(\"ord\")\n        order = Order(\n            order_id=order_id,\n            account_id=account_id,\n            items=tuple(items),\n            subtotal_cents=totals.subtotal_cents,\n            tax_cents=totals.tax_cents,\n            total_cents=totals.total_cents,\n            discount_cents=totals.discount_cents,\n            promo_code=promo_code,\n        )\n        self.ledger.save_order(order)\n        entry = LedgerEntry(\n            entry_id=self.ledger.next_id(\"ent\"),\n            account_id=account_id,\n            kind=\"order_charge\",\n            subtotal_cents=order.subtotal_cents,\n            tax_cents=order.tax_cents,\n            total_cents=order.total_cents,\n            reference_id=order_id,\n        )\n        self.ledger.record_entry(entry)\n        return order\n\n    def start_subscription(self, account_id: str, plan_id: str) -> Subscription:\n        if not account_id.strip():\n            raise ValidationError(\"account_id must be non-empty\")\n        self.ledger.get_plan(plan_id)\n        sub = Subscription(\n            subscription_id=self.ledger.next_id(\"sub\"),\n            account_id=account_id,\n            plan_id=plan_id,\n        )\n        self.ledger.save_subscription(sub)\n        return sub\n\n    def upgrade_subscription(\n        self,\n        subscription_id: str,\n        new_plan_id: str,\n        days_remaining: int,\n        cycle_days: int,\n        *,\n        idempotency_key: str,\n        promo_code: str | None = None,\n        as_of: str | None = None,\n    ) -> LedgerEntry:\n        return self.ledger.upgrade_subscription(\n            subscription_id,\n            new_plan_id,\n            days_remaining,\n            cycle_days,\n            idempotency_key=idempotency_key,\n            promo_code=promo_code,\n            as_of=as_of,\n        )\n\n    def get_statement(self, account_id: str) -> Dict[str, object]:\n        entries = self.ledger.entries_for_account(account_id)\n        return {\n            \"account_id\": account_id,\n            \"balance_cents\": self.ledger.account_balance_cents(account_id),\n            \"entry_count\": len(entries),\n        }\n\"\"\"In-memory order, subscription, and ledger store for EV1.\"\"\"\n\nfrom __future__ import annotations\n\nfrom threading import RLock\nfrom typing import Dict, List, Optional\n\nfrom . import pricing\nfrom .models import LedgerEntry, Order, Plan, Promo, Subscription, ValidationError\n\n\nclass OrderLedger:\n    def __init__(self) -> None:\n        self._plans: Dict[str, Plan] = {}\n        self._promos: Dict[str, Promo] = {}\n        self._orders: Dict[str, Order] = {}\n        self._subscriptions: Dict[str, Subscription] = {}\n        self._entries: Dict[str, LedgerEntry] = {}\n        self._entry_order: List[str] = []\n        self._upgrades_by_key: Dict[\n            str, tuple[tuple[str, str, int, int, str | None, str | None], LedgerEntry]\n        ] = {}\n        self._lock = RLock()\n        self._seq = 0\n\n    def next_id(self, prefix: str) -> str:\n        with self._lock:\n            self._seq += 1\n            return f\"{prefix}_{self._seq:04d}\"\n\n    def add_plan(self, plan: Plan) -> None:\n        if not plan.plan_id.strip():\n            raise ValidationError(\"plan_id must be non-empty\")\n        if isinstance(plan.monthly_cents, bool) or not isinstance(plan.monthly_cents, int) or plan.monthly_cents < 0:\n            raise ValidationError(\"monthly_cents must be a non-negative integer\")\n        self._plans[plan.plan_id] = plan\n\n    def get_plan(self, plan_id: str) -> Plan:\n        plan = self._plans.get(plan_id)\n        if plan is None:\n            raise ValidationError(f\"Unknown plan_id: {plan_id}\")\n        return plan\n\n    @staticmethod\n    def _validate_promo_code(code: str) -> None:\n        if not isinstance(code, str) or not code.strip() or \",\" in code:\n            raise ValidationError(\"promo code must be a single non-empty string\")\n\n    def register_promo(\n        self,\n        code: str,\n        *,\n        percent_off: int | None = None,\n        amount_off_cents: int | None = None,\n        expires_on: str | None = None,\n        min_subtotal_cents: int = 0,\n    ) -> None:\n        self._validate_promo_code(code)\n        if (percent_off is None) == (amount_off_cents is None):\n            raise ValidationError(\"specify exactly one of percent_off or amount_off_cents\")\n        if percent_off is not None:\n            pricing.validate_positive_int(percent_off, \"percent_off\")\n            if percent_off > 100:\n                raise ValidationError(\"percent_off cannot exceed 100\")\n        if amount_off_cents is not None:\n            pricing.validate_positive_int(amount_off_cents, \"amount_off_cents\")\n        pricing.validate_non_negative_int(min_subtotal_cents, \"min_subtotal_cents\")\n        expiry = pricing.parse_optional_date(expires_on, \"expires_on\")\n        self._promos[code] = Promo(code, percent_off, amount_off_cents, expiry, min_subtotal_cents)\n\n    def get_promo(self, code: str | None) -> Promo | None:\n        if code is None:\n            return None\n        self._validate_promo_code(code)\n        promo = self._promos.get(code)\n        if promo is None:\n            raise ValidationError(f\"Unknown promo code: {code}\")\n        return promo\n\n    def save_order(self, order: Order) -> None:\n        self._orders[order.order_id] = order\n\n    def get_order(self, order_id: str) -> Order:\n        order = self._orders.get(order_id)\n        if order is None:\n            raise ValidationError(f\"Unknown order_id: {order_id}\")\n        return order\n\n    def save_subscription(self, sub: Subscription) -> None:\n        self._subscriptions[sub.subscription_id] = sub\n\n    def get_subscription(self, subscription_id: str) -> Subscription:\n        sub = self._subscriptions.get(subscription_id)\n        if sub is None:\n            raise ValidationError(f\"Unknown subscription_id: {subscription_id}\")\n        return sub\n\n    def upgrade_subscription(\n        self,\n        subscription_id: str,\n        new_plan_id: str,\n        days_remaining: int,\n        cycle_days: int,\n        *,\n        idempotency_key: str,\n        promo_code: str | None = None,\n        as_of: str | None = None,\n    ) -> LedgerEntry:\n        if not isinstance(subscription_id, str) or not isinstance(new_plan_id, str):\n            raise ValidationError(\"subscription_id and new_plan_id must be strings\")\n        if not isinstance(idempotency_key, str) or not idempotency_key.strip():\n            raise ValidationError(\"idempotency_key must be a non-empty string\")\n        pricing.validate_proration_period(days_remaining, cycle_days)\n        arguments = (subscription_id, new_plan_id, days_remaining, cycle_days, promo_code, as_of)\n\n        with self._lock:\n            previous_upgrade = self._upgrades_by_key.get(idempotency_key)\n            if previous_upgrade is not None:\n                previous_arguments, entry = previous_upgrade\n                if arguments != previous_arguments:\n                    raise ValidationError(\"idempotency_key already used with different arguments\")\n                return entry\n\n            subscription = self.get_subscription(subscription_id)\n            old_plan = self.get_plan(subscription.plan_id)\n            new_plan = self.get_plan(new_plan_id)\n            subtotal = pricing.compute_upgrade_subtotal_cents(\n                old_plan.monthly_cents, new_plan.monthly_cents, days_remaining, cycle_days\n            )\n            promo = self.get_promo(promo_code)\n            totals = pricing.calculate_charge_totals(subtotal, new_plan.tax_bps, promo=promo, as_of=as_of)\n            entry = LedgerEntry(\n                entry_id=self.next_id(\"ent\"),\n                account_id=subscription.account_id,\n                kind=\"plan_upgrade\",\n                subtotal_cents=totals.subtotal_cents,\n                tax_cents=totals.tax_cents,\n                total_cents=totals.total_cents,\n                reference_id=subscription_id,\n                metadata={\"promo_code\": promo.code, \"discount_cents\": totals.discount_cents} if promo else {},\n            )\n            self.record_entry(entry)\n            subscription.plan_id = new_plan_id\n            self._upgrades_by_key[idempotency_key] = (arguments, entry)\n            return entry\n\n    def record_entry(self, entry: LedgerEntry) -> None:\n        self._entries[entry.entry_id] = entry\n        self._entry_order.append(entry.entry_id)\n\n    def get_entry(self, entry_id: str) -> Optional[LedgerEntry]:\n        return self._entries.get(entry_id)\n\n    def entries_for_account(self, account_id: str) -> List[LedgerEntry]:\n        return [\n            self._entries[eid]\n            for eid in self._entry_order\n            if self._entries[eid].account_id == account_id\n        ]\n\n    def account_balance_cents(self, account_id: str) -> int:\n        return sum(e.total_cents for e in self.entries_for_account(account_id))\n","exit_code":0,"status":"completed"}}
