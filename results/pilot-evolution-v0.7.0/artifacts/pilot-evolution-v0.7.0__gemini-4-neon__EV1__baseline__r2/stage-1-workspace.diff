+"""Unit tests for Turn 1: mid-cycle prorated plan upgrades and idempotency."""
+
+from __future__ import annotations
+
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LedgerEntry, Plan, ValidationError
+from ev1_order_ledger.pricing import (
+    calculate_prorated_upgrade_totals,
+    compute_prorated_upgrade_cents,
+)
+
+
+class ProratedPlanUpgradeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.starter = Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=500)
+        self.starter_alt = Plan(plan_id="starter_alt", name="Starter Alt", monthly_cents=1000, tax_bps=825)
+        self.pro = Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825)
+        self.enterprise = Plan(plan_id="enterprise", name="Enterprise", monthly_cents=7000, tax_bps=1000)
+        for plan in (self.starter, self.starter_alt, self.pro, self.enterprise):
+            self.svc.register_plan(plan)
+
+    def test_mid_cycle_upgrade_uses_new_plan_tax_updates_plan_and_records_entry(self) -> None:
+        sub = self.svc.start_subscription("acct_1", "starter")
+        entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="upg-001",
+        )
+
+        # (3000 - 1000) * 15 / 30 = 1000; tax uses pro.tax_bps (825), not starter.tax_bps (500):
+        # 1000 * 825 / 10000 = 82.5 -> half-up 83
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, sub.subscription_id)
+        self.assertEqual(entry.subtotal_cents, 1000)
+        self.assertEqual(entry.tax_cents, 83)
+        self.assertEqual(entry.total_cents, 1083)
+
+        self.assertEqual(sub.plan_id, "pro")
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "pro")
+
+        stmt = self.svc.get_statement("acct_1")
+        self.assertEqual(stmt["balance_cents"], 1083)
+        self.assertEqual(stmt["entry_count"], 1)
+
+    def test_proration_half_up_rounding_exact_ties_and_non_ties(self) -> None:
+        # Exact .5 ties with even quotients (banker's rounding would round down, half-up rounds up)
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 1001, 1, 2), 1)  # 0.5 -> 1
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 1005, 1, 2), 3)  # 2.5 -> 3
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 2001, 15, 30), 501)  # 500.5 -> 501
+
+        # Below and above .5
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 2000, 1, 3), 333)  # 333.333... -> 333
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 2000, 2, 3), 667)  # 666.666... -> 667
+
+        # Full-service upgrade exercising half-up proration + half-up tax tie
+        plan_a = Plan(plan_id="odd_base", name="Odd Base", monthly_cents=1000, tax_bps=0)
+        plan_b = Plan(plan_id="odd_plus", name="Odd Plus", monthly_cents=2009, tax_bps=1000)
+        self.svc.register_plan(plan_a)
+        self.svc.register_plan(plan_b)
+        sub = self.svc.start_subscription("acct_round", "odd_base")
+
+        # delta = 1009; 1009 * 15 / 30 = 504.5 -> half-up 505
+        # tax = 505 * 1000 / 10000 = 50.5 -> half-up 51
+        entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "odd_plus",
+            15,
+            30,
+            idempotency_key="upg-half-up",
+        )
+        self.assertEqual(entry.subtotal_cents, 505)
+        self.assertEqual(entry.tax_cents, 51)
+        self.assertEqual(entry.total_cents, 556)
+        self.assertEqual(
+            calculate_prorated_upgrade_totals(plan_a, plan_b, days_remaining=15, cycle_days=30),
+            (505, 51, 556),
+        )
+
+    def test_proration_valid_boundary_days_zero_and_full_cycle(self) -> None:
+        sub_zero = self.svc.start_subscription("acct_zero", "starter")
+        entry_zero = self.svc.upgrade_subscription(
+            sub_zero.subscription_id,
+            "pro",
+            0,
+            30,
+            idempotency_key="upg-zero-days",
+        )
+        self.assertEqual(entry_zero.subtotal_cents, 0)
+        self.assertEqual(entry_zero.tax_cents, 0)
+        self.assertEqual(entry_zero.total_cents, 0)
+        self.assertEqual(sub_zero.plan_id, "pro")
+
+        sub_full = self.svc.start_subscription("acct_full", "starter")
+        entry_full = self.svc.upgrade_subscription(
+            sub_full.subscription_id,
+            "pro",
+            30,
+            30,
+            idempotency_key="upg-full-cycle",
+        )
+        # Full delta = 2000; tax = 2000 * 825 / 10000 = 165
+        self.assertEqual(entry_full.subtotal_cents, 2000)
+        self.assertEqual(entry_full.tax_cents, 165)
+        self.assertEqual(entry_full.total_cents, 2165)
+        self.assertEqual(sub_full.plan_id, "pro")
+
+    def test_rejects_unknown_ids_non_upgrades_bounds_booleans_and_empty_key(self) -> None:
+        sub = self.svc.start_subscription("acct_err", "pro")
+
+        invalid_calls = [
+            # Unknown or invalid IDs
+            ("sub_missing", "enterprise", 15, 30, "k-unknown-sub"),
+            ("", "enterprise", 15, 30, "k-empty-sub"),
+            ("   ", "enterprise", 15, 30, "k-blank-sub"),
+            (True, "enterprise", 15, 30, "k-bool-sub"),
+            (sub.subscription_id, "plan_missing", 15, 30, "k-unknown-plan"),
+            (sub.subscription_id, "", 15, 30, "k-empty-plan"),
+            (sub.subscription_id, False, 15, 30, "k-bool-plan"),
+            # Non-upgrades (same plan, equal monthly_cents, downgrade)
+            (sub.subscription_id, "pro", 15, 30, "k-same-plan"),
+            (sub.subscription_id, "starter", 15, 30, "k-downgrade"),
+            # Invalid cycle/remaining bounds
+            (sub.subscription_id, "enterprise", 15, 0, "k-zero-cycle"),
+            (sub.subscription_id, "enterprise", 15, -30, "k-neg-cycle"),
+            (sub.subscription_id, "enterprise", -1, 30, "k-neg-rem"),
+            (sub.subscription_id, "enterprise", 31, 30, "k-rem-gt-cycle"),
+            # Booleans and non-integers
+            (sub.subscription_id, "enterprise", True, 30, "k-bool-rem-true"),
+            (sub.subscription_id, "enterprise", False, 30, "k-bool-rem-false"),
+            (sub.subscription_id, "enterprise", 1, True, "k-bool-cycle-true"),
+            (sub.subscription_id, "enterprise", 0, False, "k-bool-cycle-false"),
+            (sub.subscription_id, "enterprise", 15.0, 30, "k-float-rem"),
+            (sub.subscription_id, "enterprise", 15, 30.0, "k-float-cycle"),
+            # Empty / invalid idempotency keys
+            (sub.subscription_id, "enterprise", 15, 30, ""),
+            (sub.subscription_id, "enterprise", 15, 30, "   "),
+            (sub.subscription_id, "enterprise", 15, 30, None),
+            (sub.subscription_id, "enterprise", 15, 30, True),
+        ]
+
+        for sub_id, plan_id, days_rem, cycle_days, idem_key in invalid_calls:
+            with self.subTest(
+                sub_id=sub_id,
+                plan_id=plan_id,
+                days_rem=days_rem,
+                cycle_days=cycle_days,
+                idem_key=idem_key,
+            ):
+                with self.assertRaises(ValidationError):
+                    self.svc.upgrade_subscription(
+                        sub_id,  # type: ignore[arg-type]
+                        plan_id,  # type: ignore[arg-type]
+                        days_rem,  # type: ignore[arg-type]
+                        cycle_days,  # type: ignore[arg-type]
+                        idempotency_key=idem_key,  # type: ignore[arg-type]
+                    )
+
+        # Equal monthly_cents across two different plans is also rejected as a non-upgrade
+        sub_starter = self.svc.start_subscription("acct_eq", "starter")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(
+                sub_starter.subscription_id,
+                "starter_alt",
+                10,
+                30,
+                idempotency_key="k-equal-price",
+            )
+
+        # Failed calls must not mutate subscriptions or record entries
+        self.assertEqual(sub.plan_id, "pro")
+        self.assertEqual(sub_starter.plan_id, "starter")
+        self.assertEqual(self.svc.get_statement("acct_err")["entry_count"], 0)
+        self.assertEqual(self.svc.get_statement("acct_eq")["entry_count"], 0)
+
+        # Failed idempotency keys must not be poisoned
+        recovered = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "enterprise",
+            15,
+            30,
+            idempotency_key="k-downgrade",
+        )
+        self.assertEqual(recovered.kind, "plan_upgrade")
+        self.assertEqual(sub.plan_id, "enterprise")
+
+    def test_idempotency_replay_returns_original_entry_without_duplicating(self) -> None:
+        sub = self.svc.start_subscription("acct_idem", "starter")
