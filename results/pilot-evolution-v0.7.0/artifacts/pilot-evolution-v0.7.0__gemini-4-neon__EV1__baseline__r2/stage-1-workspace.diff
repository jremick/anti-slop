+    def lookup_idempotent_entry(
+        self,
+        idempotency_key: str,
+        fingerprint: Tuple[Any, ...],
+    ) -> Optional[LedgerEntry]:
+        """Return the recorded entry for a matching replay, None if unseen, or raise on conflict."""
+        validate_idempotency_key(idempotency_key)
+        record = self._idempotency_records.get(idempotency_key)
+        if record is None:
+            return None
+        saved_fingerprint, entry_id = record
+        if saved_fingerprint != _typed_fingerprint(fingerprint):
+            raise ValidationError(f"Idempotency key {idempotency_key!r} already used with different arguments")
+        return self._entries[entry_id]
+
+    def record_idempotent_entry(
+        self,
+        entry: LedgerEntry,
+        *,
+        idempotency_key: str,
+        fingerprint: Tuple[Any, ...],
+    ) -> LedgerEntry:
+        """Record a ledger entry under an idempotency key or return the matching prior entry."""
+        existing = self.lookup_idempotent_entry(idempotency_key, fingerprint)
+        if existing is not None:
+            return existing
+        self.record_entry(entry)
+        self._idempotency_records[idempotency_key] = (_typed_fingerprint(fingerprint), entry.entry_id)
+        return entry
+
     def get_entry(self, entry_id: str) -> Optional[LedgerEntry]:
