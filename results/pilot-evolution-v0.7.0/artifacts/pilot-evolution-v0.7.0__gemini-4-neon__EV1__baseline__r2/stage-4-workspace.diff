+        # Unknown codes, empty string, and multi-code stacking strings fail closed
+        for bad_code in ("UNKNOWN", "", "   ", "MIN2000,OTHER10", "MIN2000+OTHER10", "MIN2000;OTHER10", "MIN2000 OTHER10"):
+            with self.subTest(bad_code=bad_code):
+                with self.assertRaises(ValidationError):
+                    self.svc.place_order(
+                        "acct_min",
+                        [LineItem(sku="s", unit_cents=3000, quantity=1)],
+                        promo_code=bad_code,
+                    )
+
+        self.assertEqual(self.svc.get_statement("acct_min")["entry_count"], 1)
+
+    def test_upgrade_with_promo_uses_shared_pricing_and_preserves_idempotency(self) -> None:
+        self.svc.register_promo("UPG25", percent_off=25, expires_on="2026-12-31", min_subtotal_cents=1000)
+        self.svc.register_promo("UPG_CLAMP", amount_off_cents=5000)
+        sub = self.svc.start_subscription("acct_upg", "starter")
+
+        # Prorated gross = (3000 - 1000) * 15 / 30 = 1000 (>= min_subtotal_cents=1000)
+        # Discount = 25% of 1000 = 250 -> discounted subtotal = 750
+        # Tax using pro.tax_bps (825) = 750 * 825 / 10000 = 61.875 -> half-up 62
+        entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="upg-promo-1",
