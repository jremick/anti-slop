+                promo_code="SPRING",
+                as_of="2026-06-31",
+            )
+
+        # Only the 2 valid orders were recorded
+        self.assertEqual(self.svc.get_statement("acct_exp")["entry_count"], 2)
+
+    def test_min_subtotal_unknown_code_and_stacking_fail_closed(self) -> None:
+        self.svc.register_promo("MIN2000", amount_off_cents=400, min_subtotal_cents=2000)
+        self.svc.register_promo("OTHER10", percent_off=10)
+
+        # Below min_subtotal_cents raises ValidationError
+        with self.assertRaises(ValidationError):
+            self.svc.place_order(
+                "acct_min",
+                [LineItem(sku="s", unit_cents=1999, quantity=1)],
+                promo_code="MIN2000",
+            )
+
+        # Exact min_subtotal_cents succeeds
+        order = self.svc.place_order(
+            "acct_min",
+            [LineItem(sku="s", unit_cents=2000, quantity=1)],
+            tax_bps=1000,
+            promo_code="MIN2000",
+        )
+        self.assertEqual(order.discount_cents, 400)
+        self.assertEqual(order.subtotal_cents, 1600)
