+"""Unit tests for Turn 2: promo codes across orders and plan upgrades."""
+
+from __future__ import annotations
+
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, Promo, ValidationError
+from ev1_order_ledger.pricing import apply_promo_and_tax
+
+
+class PromoCodeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=500))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="enterprise", name="Enterprise", monthly_cents=7000, tax_bps=1000))
+
+    def test_register_promo_validation_rejects_invalid_inputs(self) -> None:
+        invalid_registrations = [
+            # Empty / invalid / stacked codes
+            ("", {"percent_off": 10}),
+            ("   ", {"percent_off": 10}),
+            ("A,B", {"percent_off": 10}),
+            ("A+B", {"percent_off": 10}),
+            ("A;B", {"percent_off": 10}),
+            ("A B", {"percent_off": 10}),
+            (True, {"percent_off": 10}),
+            # Neither or both discount types
+            ("NONE", {}),
+            ("BOTH", {"percent_off": 10, "amount_off_cents": 100}),
+            # Invalid percent_off
+            ("PCT0", {"percent_off": 0}),
+            ("PCTNEG", {"percent_off": -10}),
+            ("PCT101", {"percent_off": 101}),
+            ("PCTBOOL", {"percent_off": True}),
+            ("PCTFLOAT", {"percent_off": 10.5}),
+            # Invalid amount_off_cents
+            ("AMT0", {"amount_off_cents": 0}),
+            ("AMTNEG", {"amount_off_cents": -50}),
+            ("AMTBOOL", {"amount_off_cents": True}),
+            ("AMTFLOAT", {"amount_off_cents": 50.0}),
+            # Invalid min_subtotal_cents
+            ("MINNEG", {"amount_off_cents": 100, "min_subtotal_cents": -1}),
+            ("MINBOOL", {"amount_off_cents": 100, "min_subtotal_cents": False}),
+            # Invalid expires_on
+            ("EXP_BAD1", {"percent_off": 10, "expires_on": "2026-02-30"}),
+            ("EXP_BAD2", {"percent_off": 10, "expires_on": "2026/05/01"}),
+            ("EXP_BAD3", {"percent_off": 10, "expires_on": "2026-5-1"}),
+            ("EXP_BAD4", {"percent_off": 10, "expires_on": ""}),
+            ("EXP_BAD5", {"percent_off": 10, "expires_on": 20260501}),
+        ]
+        for code, kwargs in invalid_registrations:
+            with self.subTest(code=code, kwargs=kwargs):
+                with self.assertRaises(ValidationError):
+                    self.svc.register_promo(code, **kwargs)  # type: ignore[arg-type]
+
+    def test_percentage_promo_on_order_discounts_before_tax_with_half_up_rounding(self) -> None:
+        self.svc.register_promo("SAVE15", percent_off=15)
+        # Gross subtotal = 1005; 15% of 1005 = 150.75 -> half-up 151
+        # Discounted subtotal = 1005 - 151 = 854
+        # Tax = 854 * 1000 / 10000 = 85.4 -> 85
+        order = self.svc.place_order(
+            "acct_pct",
+            [LineItem(sku="widget", unit_cents=1005, quantity=1)],
+            tax_bps=1000,
+            promo_code="SAVE15",
+        )
+        self.assertEqual(order.discount_cents, 151)
+        self.assertEqual(order.subtotal_cents, 854)
+        self.assertEqual(order.tax_cents, 85)
+        self.assertEqual(order.total_cents, 939)
+        self.assertEqual(order.promo_code, "SAVE15")
+
+        stmt = self.svc.get_statement("acct_pct")
+        self.assertEqual(stmt["balance_cents"], 939)
+        self.assertEqual(stmt["entry_count"], 1)
+
+        # 100% off clamps subtotal, tax, and total to 0
+        self.svc.register_promo("FREE100", percent_off=100)
+        free_order = self.svc.place_order(
+            "acct_free",
+            [LineItem(sku="widget", unit_cents=1234, quantity=1)],
+            tax_bps=825,
+            promo_code="FREE100",
+        )
+        self.assertEqual(free_order.discount_cents, 1234)
+        self.assertEqual(free_order.subtotal_cents, 0)
+        self.assertEqual(free_order.tax_cents, 0)
+        self.assertEqual(free_order.total_cents, 0)
+        self.assertEqual(free_order.promo_code, "FREE100")
+
+    def test_fixed_amount_promo_on_order_clamps_subtotal_at_zero(self) -> None:
+        self.svc.register_promo("FLAT500", amount_off_cents=500)
+        # Gross = 1500; discount = 500 -> subtotal = 1000; tax @ 8.25% = 83
+        order = self.svc.place_order(
+            "acct_flat",
+            [LineItem(sku="seat", unit_cents=1500, quantity=1)],
+            tax_bps=825,
+            promo_code="FLAT500",
+        )
+        self.assertEqual(order.discount_cents, 500)
+        self.assertEqual(order.subtotal_cents, 1000)
+        self.assertEqual(order.tax_cents, 83)
+        self.assertEqual(order.total_cents, 1083)
+        self.assertEqual(order.promo_code, "FLAT500")
+
+        # Amount exceeding subtotal clamps discounted subtotal to 0 and discount to gross subtotal
+        self.svc.register_promo("BIG2000", amount_off_cents=2000)
+        clamped = self.svc.place_order(
+            "acct_clamp",
+            [LineItem(sku="mini", unit_cents=750, quantity=1)],
+            tax_bps=1000,
+            promo_code="BIG2000",
+        )
+        self.assertEqual(clamped.discount_cents, 750)
+        self.assertEqual(clamped.subtotal_cents, 0)
+        self.assertEqual(clamped.tax_cents, 0)
+        self.assertEqual(clamped.total_cents, 0)
+        self.assertEqual(clamped.promo_code, "BIG2000")
+
+    def test_expiry_and_as_of_validation(self) -> None:
+        self.svc.register_promo("SPRING", percent_off=20, expires_on="2026-06-30")
+
+        # Valid before expiry
+        o1 = self.svc.place_order(
+            "acct_exp",
+            [LineItem(sku="s", unit_cents=1000, quantity=1)],
+            tax_bps=0,
+            promo_code="SPRING",
+            as_of="2026-06-29",
+        )
+        self.assertEqual(o1.subtotal_cents, 800)
+
+        # Valid on exact expiry date (inclusive)
+        o2 = self.svc.place_order(
+            "acct_exp",
+            [LineItem(sku="s", unit_cents=1000, quantity=1)],
+            tax_bps=0,
+            promo_code="SPRING",
+            as_of="2026-06-30",
+        )
+        self.assertEqual(o2.subtotal_cents, 800)
+
+        # Missing as_of fails closed
+        with self.assertRaises(ValidationError):
+            self.svc.place_order(
+                "acct_exp",
+                [LineItem(sku="s", unit_cents=1000, quantity=1)],
+                promo_code="SPRING",
+            )
+
+        # Expired date fails closed
+        with self.assertRaises(ValidationError):
+            self.svc.place_order(
+                "acct_exp",
+                [LineItem(sku="s", unit_cents=1000, quantity=1)],
+                promo_code="SPRING",
+                as_of="2026-07-01",
