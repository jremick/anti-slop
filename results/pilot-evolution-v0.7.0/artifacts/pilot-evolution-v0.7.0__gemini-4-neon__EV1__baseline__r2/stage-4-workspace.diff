+        self.assertEqual(clamped_entry.total_cents, 0)
+        self.assertEqual(clamped_entry.metadata["discount_cents"], 2000)
+        self.assertEqual(sub.plan_id, "enterprise")
+
+    def test_upgrade_rejects_invalid_promo_conditions_without_mutating_state(self) -> None:
+        self.svc.register_promo("EXP_UPG", percent_off=10, expires_on="2026-06-01", min_subtotal_cents=1000)
+        self.svc.register_promo("ALT_UPG", amount_off_cents=100)
+        sub = self.svc.start_subscription("acct_upg_err", "starter")
+
+        # Missing as_of
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(
+                sub.subscription_id,
