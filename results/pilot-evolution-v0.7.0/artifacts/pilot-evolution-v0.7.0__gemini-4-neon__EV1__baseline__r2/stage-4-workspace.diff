+"""Unit tests for Turn 4: legacy_flat_fee removal and fail-closed audit logging."""
+
+from __future__ import annotations
+
+import unittest
+from typing import Dict, List
+
+from ev1_order_ledger import pricing
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, ValidationError
+
+
+class LegacyRemovalAndAuditSinkTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.events: List[Dict[str, object]] = []
+        self.fail_next = False
+
+        def sink(event: Dict[str, object]) -> None:
+            if self.fail_next:
+                raise RuntimeError("audit sink unavailable")
+            self.events.append(event)
+
+        self.svc = OrderService(audit_sink=sink)
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=500))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+
+    def test_legacy_flat_fee_is_completely_removed_and_raises_type_error(self) -> None:
+        self.assertFalse(hasattr(pricing, "LEGACY_FLAT_FEE_CENTS"))
+
+        items = [LineItem(sku="seat", unit_cents=1000, quantity=1)]
+        with self.assertRaises(TypeError):
+            pricing.calculate_order_totals(items, legacy_flat_fee=True)  # type: ignore[call-arg]
+        with self.assertRaises(TypeError):
+            pricing.calculate_order_pricing(items, legacy_flat_fee=True)  # type: ignore[call-arg]
+        with self.assertRaises(TypeError):
+            self.svc.place_order("acct_1", items, legacy_flat_fee=True)  # type: ignore[call-arg]
+
+    def test_audit_sink_logs_new_mutations_and_skips_idempotent_replays(self) -> None:
+        order = self.svc.place_order(
+            "acct_audit",
+            [LineItem(sku="seat", unit_cents=1000, quantity=1)],
+            tax_bps=1000,
+        )
+        sub = self.svc.start_subscription("acct_audit", "starter")
+        upg = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="aud-upg-1",
+        )
+        # Replay must not emit another audit event
+        upg_replay = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="aud-upg-1",
+        )
+        self.assertIs(upg_replay, upg)
+
+        ref = self.svc.refund_order(
+            order.order_id,
+            500,
+            reason="partial refund",
+            idempotency_key="aud-ref-1",
+        )
+        # Replay must not emit another audit event
+        ref_replay = self.svc.refund_order(
+            order.order_id,
+            500,
+            reason="partial refund",
+            idempotency_key="aud-ref-1",
+        )
+        self.assertIs(ref_replay, ref)
+
+        entries = self.svc.ledger.entries_for_account("acct_audit")
+        self.assertEqual(len(entries), 3)
+        self.assertEqual(
+            self.events,
+            [
+                {
+                    "action": "order_charge",
+                    "account_id": "acct_audit",
+                    "amount_cents": order.total_cents,
+                    "entry_id": entries[0].entry_id,
+                },
+                {
+                    "action": "plan_upgrade",
+                    "account_id": "acct_audit",
+                    "amount_cents": upg.total_cents,
+                    "entry_id": upg.entry_id,
+                },
+                {
+                    "action": "order_refund",
+                    "account_id": "acct_audit",
+                    "amount_cents": -500,
+                    "entry_id": ref.entry_id,
+                },
+            ],
+        )
+
+    def test_audit_sink_failure_rolls_back_place_order_atomically(self) -> None:
+        self.fail_next = True
+        with self.assertRaisesRegex(RuntimeError, "audit sink unavailable"):
+            self.svc.place_order(
+                "acct_fail_order",
+                [LineItem(sku="seat", unit_cents=1500, quantity=1)],
+                tax_bps=825,
+            )
+
+        self.assertEqual(self.events, [])
+        self.assertEqual(self.svc.get_statement("acct_fail_order")["entry_count"], 0)
+        self.assertEqual(self.svc.get_statement("acct_fail_order")["balance_cents"], 0)
+        self.assertEqual(self.svc.ledger._orders, {})
+
+    def test_audit_sink_failure_rolls_back_upgrade_atomically_and_allows_retry(self) -> None:
+        sub = self.svc.start_subscription("acct_fail_upg", "starter")
+        self.fail_next = True
+        with self.assertRaisesRegex(RuntimeError, "audit sink unavailable"):
+            self.svc.upgrade_subscription(
+                sub.subscription_id,
+                "pro",
+                15,
+                30,
+                idempotency_key="retry-upg-1",
+            )
+
+        self.assertEqual(sub.plan_id, "starter")
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "starter")
+        self.assertEqual(self.svc.get_statement("acct_fail_upg")["entry_count"], 0)
+        self.assertEqual(self.events, [])
+
+        # Retrying with the same idempotency_key succeeds once audit_sink recovers
+        self.fail_next = False
+        entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="retry-upg-1",
+        )
+        self.assertEqual(sub.plan_id, "pro")
+        self.assertEqual(len(self.events), 1)
+        self.assertEqual(self.events[0]["entry_id"], entry.entry_id)
+
+    def test_audit_sink_failure_rolls_back_refund_atomically_and_allows_retry(self) -> None:
+        order = self.svc.place_order(
+            "acct_fail_ref",
+            [LineItem(sku="seat", unit_cents=1000, quantity=1)],
+            tax_bps=1000,
+        )
+        self.assertEqual(len(self.events), 1)
+
+        self.fail_next = True
+        with self.assertRaisesRegex(RuntimeError, "audit sink unavailable"):
+            self.svc.refund_order(
+                order.order_id,
+                400,
+                reason="defect",
+                idempotency_key="retry-ref-1",
+            )
+
+        self.assertEqual(self.svc.ledger.refunded_totals_for_order(order.order_id), (0, 0, 0))
+        self.assertEqual(self.svc.get_statement("acct_fail_ref")["balance_cents"], 1100)
+        self.assertEqual(self.svc.get_statement("acct_fail_ref")["entry_count"], 1)
+        self.assertEqual(len(self.events), 1)
+
+        # Retrying with the same idempotency_key succeeds once audit_sink recovers
+        self.fail_next = False
+        ref_entry = self.svc.refund_order(
+            order.order_id,
+            400,
+            reason="defect",
+            idempotency_key="retry-ref-1",
+        )
+        self.assertEqual(self.svc.get_statement("acct_fail_ref")["balance_cents"], 700)
+        self.assertEqual(len(self.events), 2)
+        self.assertEqual(self.events[1]["entry_id"], ref_entry.entry_id)
+
+    def test_non_callable_audit_sink_rejected(self) -> None:
+        with self.assertRaises(ValidationError):
+            OrderService(audit_sink="not-callable")  # type: ignore[arg-type]
+
+
+if __name__ == "__main__":
+    unittest.main()

