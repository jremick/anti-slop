+    cycle_days: int,
+) -> Tuple[int, int, int]:
+    """Return (subtotal_cents, tax_cents, total_cents) for a mid-cycle plan upgrade."""
+    subtotal, _discount, tax, total = calculate_prorated_upgrade_pricing(
+        old_plan,
+        new_plan,
+        days_remaining=days_remaining,
+        cycle_days=cycle_days,
+    )
+    return subtotal, tax, total
+
+
+def calculate_refund_split(
+    order_subtotal_cents: int,
+    order_tax_cents: int,
+    order_total_cents: int,
+    *,
+    already_refunded_total_cents: int,
+    already_refunded_tax_cents: int,
+    refund_amount_cents: int,
+) -> Tuple[int, int]:
+    """Compute (refund_subtotal_cents, refund_tax_cents) with cumulative exact penny conservation."""
+    validate_non_negative_int(order_subtotal_cents, "order_subtotal_cents")
+    validate_non_negative_int(order_tax_cents, "order_tax_cents")
+    validate_non_negative_int(order_total_cents, "order_total_cents")
+    if order_subtotal_cents + order_tax_cents != order_total_cents:
+        raise ValidationError("order subtotal + tax must equal order total")
+    validate_non_negative_int(already_refunded_total_cents, "already_refunded_total_cents")
+    validate_non_negative_int(already_refunded_tax_cents, "already_refunded_tax_cents")
+    validate_positive_int(refund_amount_cents, "amount_cents")
+
+    new_refunded_total = already_refunded_total_cents + refund_amount_cents
+    if new_refunded_total > order_total_cents:
+        raise ValidationError("Refund amount exceeds remaining refundable order total")
+
+    new_refunded_tax = round_half_up_div(order_tax_cents * new_refunded_total, order_total_cents)
+    refund_tax_cents = new_refunded_tax - already_refunded_tax_cents
+    refund_subtotal_cents = refund_amount_cents - refund_tax_cents
+    return refund_subtotal_cents, refund_tax_cents

