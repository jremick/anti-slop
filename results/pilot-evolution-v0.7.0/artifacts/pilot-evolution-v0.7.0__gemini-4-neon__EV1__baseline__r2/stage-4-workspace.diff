+        # Subscription and ledger remain untouched
+        self.assertEqual(sub.plan_id, "starter")
+        self.assertEqual(self.svc.get_statement("acct_upg_err")["entry_count"], 0)
+
+    def test_shared_pricing_helper_parity(self) -> None:
+        promo = Promo(code="TEN", percent_off=10, min_subtotal_cents=500, expires_on="2026-12-31")
+        # 1005 * 10 / 100 = 100.5 -> 101; subtotal = 904; tax @ 8.25% = 74.58 -> 75; total = 979
