+    def test_idempotency_replay_returns_original_entry_without_duplicating(self) -> None:
+        sub = self.svc.start_subscription("acct_idem", "starter")
+        first = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            10,
+            30,
+            idempotency_key="idem-replay-1",
+        )
+        replay = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            10,
+            30,
+            idempotency_key="idem-replay-1",
+        )
+
+        self.assertIs(replay, first)
+        self.assertEqual(replay, first)
+        self.assertEqual(sub.plan_id, "pro")
+
+        entries = self.svc.ledger.entries_for_account("acct_idem")
+        self.assertEqual(len(entries), 1)
+        self.assertEqual(self.svc.get_statement("acct_idem")["balance_cents"], first.total_cents)
+
+        # Subsequent valid upgrade with a new key succeeds, and late replay of the first key
+        # still returns the first entry without reverting plan_id or duplicating entries.
+        second = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "enterprise",
+            10,
+            30,
+            idempotency_key="idem-replay-2",
+        )
+        self.assertEqual(sub.plan_id, "enterprise")
+        late_replay = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            10,
+            30,
+            idempotency_key="idem-replay-1",
+        )
+        self.assertIs(late_replay, first)
+        self.assertEqual(sub.plan_id, "enterprise")
+        self.assertEqual(len(self.svc.ledger.entries_for_account("acct_idem")), 2)
+        self.assertEqual(
+            self.svc.get_statement("acct_idem")["balance_cents"],
+            first.total_cents + second.total_cents,
+        )
+
+    def test_idempotency_conflict_raises_validation_error_for_any_changed_arg(self) -> None:
+        sub1 = self.svc.start_subscription("acct_conflict", "starter")
+        sub2 = self.svc.start_subscription("acct_conflict", "starter")
+
+        original = self.svc.upgrade_subscription(
+            sub1.subscription_id,
+            "pro",
+            1,
+            30,
+            idempotency_key="idem-conflict-1",
+        )
+
+        conflicting_calls = [
+            (sub2.subscription_id, "pro", 1, 30),  # different subscription_id
+            (sub1.subscription_id, "enterprise", 1, 30),  # different new_plan_id
+            (sub1.subscription_id, "pro", 2, 30),  # different days_remaining
+            (sub1.subscription_id, "pro", 1, 31),  # different cycle_days
+            (sub1.subscription_id, "pro", True, 30),  # bool must not collide with int 1
+        ]
+        for sub_id, plan_id, days_rem, cycle_days in conflicting_calls:
+            with self.subTest(sub_id=sub_id, plan_id=plan_id, days_rem=days_rem, cycle_days=cycle_days):
+                with self.assertRaises(ValidationError):
+                    self.svc.upgrade_subscription(
+                        sub_id,
+                        plan_id,
+                        days_rem,  # type: ignore[arg-type]
+                        cycle_days,
+                        idempotency_key="idem-conflict-1",
+                    )
+
+        # Ensure conflict attempts did not mutate either subscription or append entries
+        self.assertEqual(sub1.plan_id, "pro")
+        self.assertEqual(sub2.plan_id, "starter")
+        self.assertEqual(self.svc.ledger.entries_for_account("acct_conflict"), [original])
+
+    def test_ledger_idempotency_helpers_enforce_typed_fingerprints(self) -> None:
+        entry = LedgerEntry(
