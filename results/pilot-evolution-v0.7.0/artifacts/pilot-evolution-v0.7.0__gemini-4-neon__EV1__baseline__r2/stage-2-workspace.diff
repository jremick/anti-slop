+def parse_iso_date(value: str, field_name: str) -> date:
+    """Strictly parse a YYYY-MM-DD date string or raise ValidationError."""
+    if not isinstance(value, str) or len(value) != 10 or value[4] != "-" or value[7] != "-":
+        raise ValidationError(f"{field_name} must be a valid YYYY-MM-DD date string")
+    try:
+        return date.fromisoformat(value)
+    except ValueError as exc:
+        raise ValidationError(f"{field_name} must be a valid YYYY-MM-DD date string") from exc
+
