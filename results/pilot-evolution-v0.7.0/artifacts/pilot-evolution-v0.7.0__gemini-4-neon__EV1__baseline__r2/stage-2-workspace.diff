+def validate_promo_code(code: str) -> str:
+    """Validate a single non-empty promo code without stacking delimiters."""
+    if not isinstance(code, str) or not code.strip():
+        raise ValidationError("promo code must be a non-empty string")
+    if any(sep in code for sep in (",", ";", "+")) or any(ch.isspace() for ch in code):
+        raise ValidationError("promo code must be a single code without delimiters or whitespace")
+    return code
