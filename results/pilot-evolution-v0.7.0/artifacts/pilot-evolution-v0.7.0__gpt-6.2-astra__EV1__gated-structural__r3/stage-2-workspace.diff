+import unittest
+
+from ev1_order_ledger import LineItem, OrderService, Plan, ValidationError
+
+
+class PromoTests(unittest.TestCase):
+    def setUp(self):
+        self.service = OrderService()
+        self.items = [LineItem("seat", 105, 1)]
+
+    def test_percentage_rounds_half_up_on_subtotal_including_fee(self):
+        self.service.register_promo("HALF", percent_off=50, min_subtotal_cents=605)
+        order = self.service.place_order(
+            "acct", self.items, promo_code="HALF", tax_bps=1000, legacy_flat_fee=True
+        )
+        self.assertEqual(order.promo_code, "HALF")
+        self.assertEqual(order.discount_cents, 303)
+        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (302, 30, 332))
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], 332)
+
+    def test_fixed_discount_is_capped_at_subtotal(self):
+        self.service.register_promo("CREDIT", amount_off_cents=200)
+        order = self.service.place_order("acct", self.items, promo_code="CREDIT", tax_bps=5000)
+        self.assertEqual(order.discount_cents, 105)
+        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (0, 0, 0))
+
+    def test_invalid_registration(self):
+        for code, terms in [
+            ("", {"percent_off": 10}),
+            ("   ", {"percent_off": 10}),
+            ("A,B", {"percent_off": 10}),
+            ("P", {}),
+            ("P", {"percent_off": 10, "amount_off_cents": 1}),
+            ("P", {"percent_off": 0}),
+            ("P", {"percent_off": 101}),
+            ("P", {"percent_off": True}),
+            ("P", {"amount_off_cents": 0}),
+            ("P", {"amount_off_cents": -1}),
+            ("P", {"percent_off": 10, "min_subtotal_cents": -1}),
+            ("P", {"percent_off": 10, "expires_on": "2025-02-29"}),
+        ]:
+            with self.subTest(code=code, terms=terms), self.assertRaises(ValidationError):
+                self.service.register_promo(code, **terms)
+
+    def test_order_eligibility_and_inclusive_expiry(self):
+        self.service.register_promo("A", amount_off_cents=10, expires_on="2024-02-29")
+        self.service.register_promo("B", percent_off=100, min_subtotal_cents=106)
+        for code, as_of in [
+            ("missing", None), ("A,B", "2024-02-29"), ("B", None), ("A", None),
+            ("A", "2024-03-01"), ("A", "2024-02-30"), ("A", "20240228"),
+        ]:
+            with self.subTest(code=code, as_of=as_of), self.assertRaises(ValidationError):
+                self.service.place_order("acct", self.items, promo_code=code, as_of=as_of)
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [])
+        order = self.service.place_order("acct", self.items, promo_code="A", as_of="2024-02-29")
+        self.assertEqual(order.discount_cents, 10)
+
+    def test_upgrade_prices_prorated_subtotal_and_replays_identical_terms(self):
+        self.service.register_plan(Plan("base", "Base", 100))
+        self.service.register_plan(Plan("plus", "Plus", 305, tax_bps=5000))
+        sub = self.service.start_subscription("acct", "base")
+        args = (sub.subscription_id, "plus", 1, 2)
+        self.service.register_promo("TEN", amount_off_cents=10, expires_on="2025-01-10")
+        self.service.register_promo("MIN", percent_off=50, min_subtotal_cents=104)
+        for code, day in [("MIN", None), ("TEN", "2025-01-11")]:
+            with self.subTest(code=code), self.assertRaises(ValidationError):
+                self.service.upgrade_subscription(*args, idempotency_key="k", promo_code=code, as_of=day)
+        self.assertEqual(sub.plan_id, "base")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [])
+
+        terms = dict(idempotency_key="k", promo_code="TEN", as_of="2025-01-10")
+        entry = self.service.upgrade_subscription(*args, **terms)
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (93, 47, 140))
+        self.assertIs(self.service.upgrade_subscription(*args, **terms), entry)
+        for change in [dict(promo_code=None), dict(as_of="2025-01-09")]:
+            with self.subTest(change=change), self.assertRaises(ValidationError):
+                self.service.upgrade_subscription(*args, **{**terms, **change})
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [entry])

