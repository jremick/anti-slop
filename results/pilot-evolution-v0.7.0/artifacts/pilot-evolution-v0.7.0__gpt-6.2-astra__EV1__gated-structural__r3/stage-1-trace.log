st be strings\\\")\n        pricing.validate_non_negative_int(days_remaining, \\\"days_remaining\\\")\n        pricing.validate_positive_int(cycle_days, \\\"cycle_days\\\")\n        if days_remaining > cycle_days:\n            raise ValidationError(\\\"days_remaining cannot exceed cycle_days\\\")\n\n        request = (subscription_id, new_plan_id, days_remaining, cycle_days)\n        with self._upgrade_lock:\n            previous = self._upgrades.get(idempotency_key)\n            if previous is not None:\n                previous_request, entry = previous\n                if previous_request \"'!= request:\n                    raise ValidationError(\"idempotency_key already used for a different upgrade\")\n                return entry\n\n            sub = self.get_subscription(subscription_id)\n            old_plan = self.get_plan(sub.plan_id)\n            new_plan = self.get_plan(new_plan_id)\n            subtotal = pricing.prorated_upgrade_cents(old_plan, new_plan, days_remaining, cycle_days)\n            tax = pricing.compute_tax_cents(subtotal, new_plan.tax_bps)\n            entry = LedgerEntry(\n                entry_id=self.next_id(\"ent\"),\n                account_id=sub.account_id,\n                kind=\"plan_upgrade\",\n                subtotal_cents=subtotal,\n                tax_cents=tax,\n                total_cents=subtotal + tax,\n                reference_id=subscription_id,\n            )\n            self.record_entry(entry)\n            sub.plan_id = new_plan_id\n            self._upgrades[idempotency_key] = (request, entry)\n            return entry\n\n    def record_entry'\"''')\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
