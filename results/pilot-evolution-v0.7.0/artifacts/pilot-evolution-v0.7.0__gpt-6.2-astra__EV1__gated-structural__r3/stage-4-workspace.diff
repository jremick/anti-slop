+import unittest
+from unittest.mock import Mock
+
+from ev1_order_ledger import LineItem, OrderService, Plan
+
+
+class AuditTests(unittest.TestCase):
+    def setUp(self):
+        self.sink = Mock()
+        self.service = OrderService(audit_sink=self.sink)
+        self.service.register_plan(Plan("base", "Base", 100))
+        self.service.register_plan(Plan("plus", "Plus", 200))
+        self.sub = self.service.start_subscription("acct", "base")
+        self.items = [LineItem("seat", 50, 1)]
+
+    def upgrade(self):
+        return self.service.upgrade_subscription(
+            self.sub.subscription_id, "plus", 1, 2, idempotency_key="upgrade"
+        )
+
+    def refund(self, order):
+        return self.service.refund_order(order.order_id, 50, reason="return", idempotency_key="refund")
+
+    def test_audit_reports_signed_amounts_once_per_entry(self):
+        order = self.service.place_order("acct", self.items)
+        upgrade = self.upgrade()
+        refund = self.refund(order)
+        self.assertIs(self.upgrade(), upgrade)
+        self.assertIs(self.refund(order), refund)
+        charge, *_ = self.service.ledger.entries_for_account("acct")
+        events = [call.args[0] for call in self.sink.call_args_list]
+        self.assertEqual(events, [
+            {"action": "order_charge", "account_id": "acct", "amount_cents": 50, "entry_id": charge.entry_id},
+            {"action": "plan_upgrade", "account_id": "acct", "amount_cents": 50, "entry_id": upgrade.entry_id},
+            {"action": "order_refund", "account_id": "acct", "amount_cents": -50, "entry_id": refund.entry_id},
+        ])
+
+    def test_sink_failure_does_not_save_order_or_entry(self):
+        self.sink.side_effect = OSError("offline")
+        with self.assertRaisesRegex(OSError, "offline"):
+            self.service.place_order("acct", self.items)
+        self.sink.assert_called_once()
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [])
+        self.assertFalse(self.service.ledger._orders)
+
+    def test_sink_failure_leaves_upgrade_and_refund_retryable(self):
+        order = self.service.place_order("acct", self.items)
+        original = self.service.ledger.entries_for_account("acct")
+        self.sink.side_effect = OSError("offline")
+        with self.assertRaisesRegex(OSError, "offline"):
+            self.upgrade()
+        with self.assertRaisesRegex(OSError, "offline"):
+            self.refund(order)
+        self.assertEqual(self.sub.plan_id, "base")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), original)
+        self.sink.side_effect = None
+        upgrade = self.upgrade()
+        refund = self.refund(order)
+        self.assertEqual(self.sub.plan_id, "plus")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), original + [upgrade, refund])

