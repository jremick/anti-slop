+import unittest
+
+from ev1_order_ledger import OrderService, Plan, ValidationError
+
+
+class SubscriptionUpgradeTests(unittest.TestCase):
+    def setUp(self):
+        self.service = OrderService()
+        self.service.register_plan(Plan("base", "Base", 100))
+        self.service.register_plan(Plan("pro", "Pro", 105, tax_bps=5000))
+        self.sub = self.service.start_subscription("acct", "base")
+
+    def test_half_cent_rounds_up_before_new_plan_tax(self):
+        entry = self.service.upgrade_subscription(
+            self.sub.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (3, 2, 5))
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.sub.subscription_id)
+        self.assertEqual(entry.account_id, "acct")
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], 5)
+
+    def test_proration_at_zero_and_full_cycle_and_below_half(self):
+        for days, cycle, expected in [(0, 4, 0), (4, 4, 5), (1, 4, 1)]:
+            with self.subTest(days=days):
+                sub = self.service.start_subscription("acct", "base")
+                entry = self.service.upgrade_subscription(
+                    sub.subscription_id, "pro", days, cycle, idempotency_key=sub.subscription_id
+                )
+                self.assertEqual(entry.subtotal_cents, expected)
+                self.assertEqual(sub.plan_id, "pro")
+
+    def test_rejected_requests_leave_subscription_ledger_and_key_untouched(self):
+        self.service.register_plan(Plan("cheaper", "Cheaper", 90))
+        self.service.register_plan(Plan("equal", "Equal price", 100))
+        self.service.register_plan(Plan("invalid-tax", "Invalid tax", 200, tax_bps=True))
+        sid = self.sub.subscription_id
+        for sub_id, plan, days, cycle, key in [
+            (sid, "pro", -1, 2, "k"),
+            (sid, "pro", 3, 2, "k"),
+            (sid, "pro", 0, 0, "k"),
+            (sid, "pro", 0, -1, "k"),
+            ("unknown", "pro", 1, 2, "k"),
+            (sid, "unknown", 1, 2, "k"),
+            (sid, "equal", 1, 2, "k"),
+            (sid, "cheaper", 1, 2, "k"),
+            (sid, "invalid-tax", 1, 2, "k"),
+            (sid, "pro", 1, 2, ""),
+            (sid, "pro", 1, 2, "   "),
+            (sid, "pro", 1, 2, True),
+        ]:
+            with self.subTest(args=(sub_id, plan, days, cycle, key)):
+                with self.assertRaises(ValidationError):
+                    self.service.upgrade_subscription(sub_id, plan, days, cycle, idempotency_key=key)
+                self.assertEqual(self.sub.plan_id, "base")
+                self.assertEqual(self.service.ledger.entries_for_account("acct"), [])
+        self.service.upgrade_subscription(sid, "pro", 1, 2, idempotency_key="k")
+
+    def test_replay_after_later_upgrade_returns_original_entry(self):
+        sid = self.sub.subscription_id
+        original = self.service.upgrade_subscription(sid, "pro", 1, 2, idempotency_key="first")
+        self.service.register_plan(Plan("premium", "Premium", 200))
+        later = self.service.upgrade_subscription(sid, "premium", 1, 2, idempotency_key="next")
+        other_service = OrderService(self.service.ledger)
+        replay = other_service.upgrade_subscription(sid, "pro", 1, 2, idempotency_key="first")
+        self.assertIs(replay, original)
+        self.assertEqual(self.sub.plan_id, "premium")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [original, later])
+
+    def test_key_conflicts_and_boolean_replays(self):
+        sid = self.sub.subscription_id
+        original = self.service.upgrade_subscription(sid, "pro", 1, 1, idempotency_key="k")
+        other = self.service.start_subscription("acct", "base")
+        self.service.register_plan(Plan("premium", "Premium", 200))
+        for args in [
+            (other.subscription_id, "pro", 1, 1),
+            (sid, "premium", 1, 1),
+            (sid, "pro", 0, 1),
+            (sid, "pro", 1, 2),
+            (sid, "pro", True, 1),
+            (sid, "pro", 1, True),
+        ]:
+            with self.subTest(args=args), self.assertRaises(ValidationError):
+                self.service.upgrade_subscription(*args, idempotency_key="k")
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertEqual(other.plan_id, "base")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [original])
