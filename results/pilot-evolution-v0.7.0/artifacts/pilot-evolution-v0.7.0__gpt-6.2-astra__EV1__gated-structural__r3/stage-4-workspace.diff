+import unittest
+
+from ev1_order_ledger import LineItem, OrderService, ValidationError
+
+
+class RefundTests(unittest.TestCase):
+    def setUp(self):
+        self.service = OrderService()
+        self.order = self.service.place_order("acct", [LineItem("item", 5, 1)], tax_bps=4000)
+
+    def refund(self, amount, key, reason="returned"):
+        return self.service.refund_order(
+            self.order.order_id, amount, reason=reason, idempotency_key=key
+        )
+
+    def test_chunked_refunds_reverse_original_subtotal_and_tax(self):
+        refunds = []
+        for i, (amount, tax) in enumerate([(1, 0), (1, 1), (1, 0), (2, 0), (2, 1)]):
+            entry = self.refund(amount, str(i))
+            refunds.append(entry)
+            self.assertEqual(entry.kind, "order_refund")
+            self.assertEqual(entry.tax_cents, -tax)
+            self.assertEqual(entry.total_cents, -amount)
+            self.assertEqual(entry.subtotal_cents + entry.tax_cents, entry.total_cents)
+        self.assertEqual(sum(e.tax_cents for e in refunds), -self.order.tax_cents)
+        self.assertEqual(sum(e.subtotal_cents for e in refunds), -self.order.subtotal_cents)
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], 0)
+
+    def test_invalid_requests_and_over_refund_leave_balance_available(self):
+        first = self.refund(3, "first")
+        for amount, key, reason in [
+            (5, "retry", "returned"), (0, "retry", "returned"), (-1, "retry", "returned"),
+            (True, "retry", "returned"), (1.5, "retry", "returned"),
+            (1, "  ", "returned"), (1, "retry", " "),
+        ]:
+            with self.subTest(amount=amount, key=key, reason=reason), self.assertRaises(ValidationError):
+                self.refund(amount, key, reason)
+        with self.assertRaises(ValidationError):
+            self.service.refund_order("unknown", 1, reason="returned", idempotency_key="retry")
+        last = self.refund(4, "retry")
+        self.assertEqual(self.service.ledger.entries_for_account("acct")[1:], [first, last])
+
+    def test_replay_after_full_refund_and_conflicts(self):
+        other = self.service.place_order("acct", [LineItem("other", 7, 1)])
+        first = self.refund(1, "first")
+        self.refund(6, "rest")
+        shared = OrderService(self.service.ledger)
+        for order_id, amount, reason in [
+            (self.order.order_id, 2, "returned"), (self.order.order_id, 1, "damaged"),
+            (other.order_id, 1, "returned"), (self.order.order_id, True, "returned"),
+        ]:
+            with self.subTest(args=(order_id, amount, reason)), self.assertRaises(ValidationError):
+                shared.refund_order(order_id, amount, reason=reason, idempotency_key="first")
+        replay = shared.refund_order(self.order.order_id, 1, reason="returned", idempotency_key="first")
+        self.assertIs(replay, first)
+        shared.refund_order(other.order_id, 7, reason="returned", idempotency_key="other")
+        self.assertEqual(shared.get_statement("acct"), {
+            "account_id": "acct", "balance_cents": 0, "entry_count": 5,
+        })
+
+    def test_credit_note_uses_positive_amounts_and_original_reason(self):
+        entry = self.refund(4, "return", "damaged on arrival")
+        self.assertEqual(self.service.export_credit_note(entry.entry_id), {
+            "entry_id": entry.entry_id, "order_id": self.order.order_id, "account_id": "acct",
+            "subtotal_cents": 3, "tax_cents": 1, "total_cents": 4, "reason": "damaged on arrival",
+        })
+        charge = self.service.ledger.entries_for_account("acct")[0]
+        for entry_id in [charge.entry_id, "missing"]:
+            with self.subTest(entry_id=entry_id), self.assertRaises(ValidationError):
+                self.service.export_credit_note(entry_id)

