+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub1.subscription_id, "enterprise", 1, 30, idempotency_key="upg-conflict-key")
+        # Different days_remaining
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub1.subscription_id, "pro", 2, 30, idempotency_key="upg-conflict-key")
+        # Different cycle_days
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub1.subscription_id, "pro", 1, 31, idempotency_key="upg-conflict-key")
