+
+
+class PlanUpgradeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=500))
+        self.svc.register_plan(Plan(plan_id="plus", name="Plus", monthly_cents=1005, tax_bps=250))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="pro_same", name="Pro Same Price", monthly_cents=3000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="enterprise", name="Enterprise", monthly_cents=7501, tax_bps=1000))
+
+    def test_upgrade_proration_exact_half_up_rounding_and_new_plan_tax(self) -> None:
+        sub = self.svc.start_subscription("acct_1", "starter")
+
+        # (1005 - 1000) * 1 / 2 = 2.5 -> half-up rounds to 3 (banker's rounding would give 2).
+        # Tax uses new_plan.tax_bps (250), NOT old_plan.tax_bps (500):
+        # 3 * 250 / 10000 = 0.075 -> 0.
+        entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "plus",
+            1,
+            2,
+            idempotency_key="upg-half-up-1",
+        )
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, sub.subscription_id)
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual(entry.subtotal_cents, 3)
+        self.assertEqual(entry.tax_cents, 0)
+        self.assertEqual(entry.total_cents, 3)
+        self.assertEqual(sub.plan_id, "plus")
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "plus")
+
+        # Verify 0.5 boundary (banker's rounding would round 0.5 -> 0; half-up -> 1).
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 1001, 1, 2), 1)
+        # Verify fractional below/above half: 1000/3 = 333.33 -> 333; 2000/3 = 666.67 -> 667.
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 2000, 1, 3), 333)
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 3000, 1, 3), 667)
+
+    def test_upgrade_tax_uses_new_plan_rate_and_half_up_rounding(self) -> None:
+        self.svc.register_plan(Plan(plan_id="tax_half", name="Tax Half", monthly_cents=1100, tax_bps=250))
+        sub = self.svc.start_subscription("acct_tax", "starter")
+        # delta = 100, full cycle (30/30) -> subtotal = 100.
+        # tax = 100 * 250 / 10000 = 2.5 -> half-up rounds to 3 (not 2).
+        entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "tax_half",
+            30,
+            30,
+            idempotency_key="upg-tax-half-up",
+        )
+        self.assertEqual(entry.subtotal_cents, 100)
+        self.assertEqual(entry.tax_cents, 3)
+        self.assertEqual(entry.total_cents, 103)
+        stmt = self.svc.get_statement("acct_tax")
+        self.assertEqual(stmt["balance_cents"], 103)
+        self.assertEqual(stmt["entry_count"], 1)
+
+    def test_upgrade_boundary_zero_and_full_cycle_days(self) -> None:
+        sub_zero = self.svc.start_subscription("acct_zero", "starter")
+        entry_zero = self.svc.upgrade_subscription(
+            sub_zero.subscription_id,
+            "pro",
+            0,
+            30,
+            idempotency_key="upg-zero-days",
+        )
+        self.assertEqual(entry_zero.subtotal_cents, 0)
+        self.assertEqual(entry_zero.tax_cents, 0)
+        self.assertEqual(entry_zero.total_cents, 0)
+        self.assertEqual(sub_zero.plan_id, "pro")
+
+        sub_full = self.svc.start_subscription("acct_full", "starter")
+        entry_full = self.svc.upgrade_subscription(
+            sub_full.subscription_id,
+            "pro",
+            30,
+            30,
+            idempotency_key="upg-full-days",
+        )
+        # delta = 2000, tax = 2000 * 825 / 10000 = 165
+        self.assertEqual(entry_full.subtotal_cents, 2000)
+        self.assertEqual(entry_full.tax_cents, 165)
+        self.assertEqual(entry_full.total_cents, 2165)
+        self.assertEqual(sub_full.plan_id, "pro")
+
+    def test_upgrade_rejects_unknown_ids_and_non_upgrades(self) -> None:
+        sub = self.svc.start_subscription("acct_err", "pro")
+
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription("sub_missing", "enterprise", 15, 30, idempotency_key="k1")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription("", "enterprise", 15, 30, idempotency_key="k2")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "plan_missing", 15, 30, idempotency_key="k3")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "   ", 15, 30, idempotency_key="k4")
+
+        # Same plan (non-upgrade)
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="k5")
+        # Different plan with equal price (non-upgrade)
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "pro_same", 15, 30, idempotency_key="k6")
+        # Downgrade
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "starter", 15, 30, idempotency_key="k7")
+
+        # Failed calls must not mutate subscription or record entries.
+        self.assertEqual(sub.plan_id, "pro")
+        self.assertEqual(self.svc.get_statement("acct_err")["entry_count"], 0)
+
+    def test_upgrade_rejects_invalid_bounds_booleans_and_empty_idempotency_key(self) -> None:
+        sub = self.svc.start_subscription("acct_bounds", "starter")
+
+        # Invalid cycle_days
+        for bad_cycle in (0, -1, -30):
+            with self.assertRaises(ValidationError):
+                self.svc.upgrade_subscription(sub.subscription_id, "pro", 0, bad_cycle, idempotency_key="kc")
+
+        # Invalid days_remaining
+        for bad_days in (-1, -10, 31, 100):
+            with self.assertRaises(ValidationError):
+                self.svc.upgrade_subscription(sub.subscription_id, "pro", bad_days, 30, idempotency_key="kd")
+
+        # Booleans rejected for all fields
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "pro", True, 30, idempotency_key="kb1")  # type: ignore[arg-type]
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "pro", False, 30, idempotency_key="kb2")  # type: ignore[arg-type]
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "pro", 1, True, idempotency_key="kb3")  # type: ignore[arg-type]
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "pro", 0, False, idempotency_key="kb4")  # type: ignore[arg-type]
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(True, "pro", 1, 30, idempotency_key="kb5")  # type: ignore[arg-type]
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, True, 1, 30, idempotency_key="kb6")  # type: ignore[arg-type]
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "pro", 1, 30, idempotency_key=True)  # type: ignore[arg-type]
+
+        # Empty or whitespace idempotency_key
+        for bad_key in ("", "   ", "\t\n", None):
+            with self.assertRaises(ValidationError):
+                self.svc.upgrade_subscription(sub.subscription_id, "pro", 10, 30, idempotency_key=bad_key)  # type: ignore[arg-type]
+
+        # Non-int floats rejected
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "pro", 1.5, 30, idempotency_key="kf1")  # type: ignore[arg-type]
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "pro", 1, 30.0, idempotency_key="kf2")  # type: ignore[arg-type]
+
+        self.assertEqual(sub.plan_id, "starter")
+        self.assertEqual(self.svc.get_statement("acct_bounds")["entry_count"], 0)
+
+    def test_idempotency_replay_returns_original_entry_without_duplication(self) -> None:
+        sub = self.svc.start_subscription("acct_idem", "starter")
+        first = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="upg-idem-1",
+        )
+        # Replay with identical args even though subscription is already on "pro".
+        second = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="upg-idem-1",
+        )
+        self.assertEqual(first, second)
+        self.assertIs(first, second)
+        self.assertEqual(sub.plan_id, "pro")
+        entries = self.svc.ledger.entries_for_account("acct_idem")
+        self.assertEqual(len(entries), 1)
+        self.assertEqual(self.svc.get_statement("acct_idem")["balance_cents"], first.total_cents)
+
+        # A subsequent valid upgrade on the same subscription with a new key works,
+        # and replaying the first key still returns the first entry without reverting plan_id.
+        third = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "enterprise",
+            10,
+            30,
+            idempotency_key="upg-idem-2",
+        )
+        self.assertEqual(sub.plan_id, "enterprise")
+        self.assertNotEqual(third.entry_id, first.entry_id)
+        replayed_first = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="upg-idem-1",
+        )
+        self.assertIs(replayed_first, first)
+        self.assertEqual(sub.plan_id, "enterprise")
+        self.assertEqual(len(self.svc.ledger.entries_for_account("acct_idem")), 2)
+
+    def test_idempotency_conflict_raises_validation_error(self) -> None:
+        sub1 = self.svc.start_subscription("acct_conflict", "starter")
+        sub2 = self.svc.start_subscription("acct_conflict", "starter")
+
+        original = self.svc.upgrade_subscription(
+            sub1.subscription_id,
+            "pro",
+            1,
+            30,
+            idempotency_key="upg-conflict-key",
+        )
+
+        # Different subscription_id
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub2.subscription_id, "pro", 1, 30, idempotency_key="upg-conflict-key")
+        # Different new_plan_id
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub1.subscription_id, "enterprise", 1, 30, idempotency_key="upg-conflict-key")
+        # Different days_remaining
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub1.subscription_id, "pro", 2, 30, idempotency_key="upg-conflict-key")
+        # Different cycle_days
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub1.subscription_id, "pro", 1, 31, idempotency_key="upg-conflict-key")
+        # Same ratio (2/60 vs 1/30) is still different arguments
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub1.subscription_id, "pro", 2, 60, idempotency_key="upg-conflict-key")
