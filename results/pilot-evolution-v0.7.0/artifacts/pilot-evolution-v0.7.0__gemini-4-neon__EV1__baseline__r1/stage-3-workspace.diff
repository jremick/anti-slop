+    validate_positive_int(refund_amount_cents, "amount_cents")
+
+    order_total_cents = order_subtotal_cents + order_tax_cents
+    new_refunded_total_cents = already_refunded_total_cents + refund_amount_cents
+    if new_refunded_total_cents > order_total_cents:
+        raise ValidationError(
+            f"Refund amount {refund_amount_cents} exceeds remaining refundable balance "
+            f"{order_total_cents - already_refunded_total_cents}"
+        )
+
+    target_cumulative_tax = round_half_up_div(
+        order_tax_cents * new_refunded_total_cents,
+        order_total_cents,
+    )
+    refund_tax_cents = target_cumulative_tax - already_refunded_tax_cents
+    refund_subtotal_cents = refund_amount_cents - refund_tax_cents
+    return refund_subtotal_cents, refund_tax_cents

