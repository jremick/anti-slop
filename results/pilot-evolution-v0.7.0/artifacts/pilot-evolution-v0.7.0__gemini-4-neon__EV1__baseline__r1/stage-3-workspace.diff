+"""Unit tests for Turn 3 partial refunds, penny conservation, and credit-note export."""
+
+from __future__ import annotations
+
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, ValidationError
+
+
+class OrderRefundAndCreditNoteTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+
+    def test_multi_chunk_partial_refunds_conserve_exact_pennies(self) -> None:
+        # Order with non-trivial tax ratio: subtotal=3998, tax=330 (8.25%), total=4328
+        order = self.svc.place_order(
+            "acct_chunks",
+            [LineItem(sku="seat", unit_cents=1999, quantity=2)],
+            tax_bps=825,
+        )
+        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (3998, 330, 4328))
+
+        # Partition 4328 into 7 uneven chunks summing to 4328.
+        chunks = [7, 13, 101, 500, 1111, 1299, 1297]
+        self.assertEqual(sum(chunks), order.total_cents)
+
+        refund_entries = []
+        for idx, amt in enumerate(chunks):
+            entry = self.svc.refund_order(
+                order.order_id,
+                amt,
+                reason=f"partial refund {idx}",
+                idempotency_key=f"ref-chunk-{idx}",
+            )
+            self.assertEqual(entry.kind, "order_refund")
+            self.assertEqual(entry.reference_id, order.order_id)
+            self.assertEqual(entry.account_id, "acct_chunks")
+            self.assertEqual(entry.total_cents, -amt)
+            self.assertEqual(entry.subtotal_cents + entry.tax_cents, entry.total_cents)
+            self.assertLessEqual(entry.subtotal_cents, 0)
+            self.assertLessEqual(entry.tax_cents, 0)
+            refund_entries.append(entry)
+
+        # Cumulative sum across all chunks must reverse exact subtotal and tax with zero drift.
+        self.assertEqual(sum(-e.subtotal_cents for e in refund_entries), order.subtotal_cents)
+        self.assertEqual(sum(-e.tax_cents for e in refund_entries), order.tax_cents)
+        self.assertEqual(sum(-e.total_cents for e in refund_entries), order.total_cents)
+
+        stmt = self.svc.get_statement("acct_chunks")
+        self.assertEqual(stmt["balance_cents"], 0)
+        self.assertEqual(stmt["entry_count"], 1 + len(chunks))
+
+    def test_single_cent_refunds_reverse_exact_tax_without_drift(self) -> None:
+        # 101 cents at 8.25% -> tax = 8 cents, total = 109 cents.
+        # Refunding 1 cent at a time must never drift and must reverse exact 8 cents tax and 101 cents subtotal.
+        order = self.svc.place_order(
+            "acct_pennies",
+            [LineItem(sku="mini", unit_cents=101, quantity=1)],
+            tax_bps=825,
+        )
+        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (101, 8, 109))
+
+        total_sub = 0
+        total_tax = 0
+        for i in range(order.total_cents):
+            entry = self.svc.refund_order(
+                order.order_id,
+                1,
+                reason="1-cent stress",
+                idempotency_key=f"penny-{i}",
+            )
+            self.assertEqual(entry.subtotal_cents + entry.tax_cents, -1)
+            self.assertIn(entry.tax_cents, (0, -1))
+            self.assertIn(entry.subtotal_cents, (0, -1))
+            total_sub += -entry.subtotal_cents
+            total_tax += -entry.tax_cents
+
+        self.assertEqual(total_sub, order.subtotal_cents)
+        self.assertEqual(total_tax, order.tax_cents)
+        self.assertEqual(self.svc.get_statement("acct_pennies")["balance_cents"], 0)
+
+    def test_refund_on_promo_discounted_order_uses_discounted_totals(self) -> None:
+        self.svc.register_promo("OFF20", percent_off=20)
+        # gross=1000, discount=200, subtotal=800, tax(8.25%)=66, total=866
+        order = self.svc.place_order(
+            "acct_promo_ref",
+            [LineItem(sku="seat", unit_cents=1000, quantity=1)],
+            tax_bps=825,
+            promo_code="OFF20",
+        )
+        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (800, 66, 866))
+
+        # Trying to refund gross pre-discount total (1000) must fail as over-refund
+        with self.assertRaises(ValidationError):
+            self.svc.refund_order(order.order_id, 867, reason="too much", idempotency_key="promo-over")
+
+        r1 = self.svc.refund_order(order.order_id, 433, reason="half", idempotency_key="promo-r1")
+        r2 = self.svc.refund_order(order.order_id, 433, reason="rest", idempotency_key="promo-r2")
+        self.assertEqual(-(r1.subtotal_cents + r2.subtotal_cents), 800)
+        self.assertEqual(-(r1.tax_cents + r2.tax_cents), 66)
+        self.assertEqual(self.svc.get_statement("acct_promo_ref")["balance_cents"], 0)
+
+    def test_over_refund_and_invalid_inputs_rejected(self) -> None:
+        order = self.svc.place_order(
+            "acct_err",
+            [LineItem(sku="seat", unit_cents=500, quantity=1)],
