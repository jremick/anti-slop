+        # Over-refund by 1 cent
+        with self.assertRaises(ValidationError):
+            self.svc.refund_order(order.order_id, 251, reason="over", idempotency_key="over-1")
+
+        # Unknown order_id
+        with self.assertRaises(ValidationError):
+            self.svc.refund_order("ord_missing", 10, reason="missing", idempotency_key="u-1")
+        with self.assertRaises(ValidationError):
+            self.svc.refund_order("", 10, reason="empty", idempotency_key="u-2")
+
+        # Invalid amount_cents (0, negative, bool, float)
+        for bad_amt in (0, -1, True, False, 10.5):
+            with self.assertRaises(ValidationError):
+                self.svc.refund_order(order.order_id, bad_amt, reason="bad amt", idempotency_key="bad-amt")  # type: ignore[arg-type]
+
+        # Empty/invalid reason
+        for bad_reason in ("", "   ", None, True):
+            with self.assertRaises(ValidationError):
+                self.svc.refund_order(order.order_id, 10, reason=bad_reason, idempotency_key="bad-reason")  # type: ignore[arg-type]
+
+        # Empty/invalid idempotency_key
+        for bad_key in ("", "   ", None, True):
+            with self.assertRaises(ValidationError):
+                self.svc.refund_order(order.order_id, 10, reason="bad key", idempotency_key=bad_key)  # type: ignore[arg-type]
+
+        # Remaining 250 can still be refunded cleanly (failed over-refund did not poison state or key)
+        final = self.svc.refund_order(order.order_id, 250, reason="rest", idempotency_key="over-1")
+        self.assertEqual(final.total_cents, -250)
