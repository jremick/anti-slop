@@ -0,0 +1,134 @@
+"""Unit tests for prorated subscription upgrades and ledger idempotency."""
+
+from concurrent.futures import ThreadPoolExecutor
+from threading import Barrier
+import unittest
+
+from ev1_order_ledger import LedgerEntry, OrderService, Plan, ValidationError
+
+
+class SubscriptionUpgradeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.service = OrderService()
+        for plan in (
+            Plan("starter", "Starter", 1000),
+            Plan("same_price", "Same Price", 1000),
+            Plan("cheaper", "Cheaper", 999),
+            Plan("pro", "Pro", 1005, tax_bps=5000),
+            Plan("premium", "Premium", 2000),
+            Plan("bad_tax", "Bad Tax", 1005, tax_bps=10001),
+        ):
+            self.service.register_plan(plan)
+        self.sub = self.service.start_subscription("acct_1", "starter")
+
+    def test_upgrade_rounds_proration_then_tax_half_up_and_records_charge(self) -> None:
+        entry = self.service.upgrade_subscription(
+            self.sub.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+
+        # A 5-cent increase prorates to 2.5 cents, then 3 cents at 50% tax yields 1.5 cents.
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (3, 2, 5))
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.sub.subscription_id)
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertIs(self.service.ledger.get_entry(entry.entry_id), entry)
+        self.assertEqual(self.service.get_statement("acct_1")["balance_cents"], 5)
+
+    def test_period_endpoints_and_rounding_below_half(self) -> None:
+        for days, cycle, expected in (
+            (0, 4, (0, 0, 0)),
+            (1, 4, (1, 1, 2)),
+            (4, 4, (5, 3, 8)),
+        ):
+            with self.subTest(days=days, cycle=cycle):
+                sub = self.service.start_subscription("acct_1", "starter")
+                entry = self.service.upgrade_subscription(
+                    sub.subscription_id, "pro", days, cycle, idempotency_key=sub.subscription_id
+                )
+                self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), expected)
+                self.assertEqual(sub.plan_id, "pro")
+
+    def test_invalid_requests_leave_no_charge_and_do_not_consume_key(self) -> None:
+        sub_id = self.sub.subscription_id
+        for request in (
+            ("unknown", "pro", 1, 2, "upgrade"),
+            (sub_id, "unknown", 1, 2, "upgrade"),
+            (sub_id, "starter", 1, 2, "upgrade"),
+            (sub_id, "same_price", 1, 2, "upgrade"),
+            (sub_id, "cheaper", 0, 2, "upgrade"),
+            (sub_id, "bad_tax", 1, 2, "upgrade"),
+            (sub_id, "pro", 0, 0, "upgrade"),
+            (sub_id, "pro", 0, -1, "upgrade"),
+            (sub_id, "pro", -1, 2, "upgrade"),
+            (sub_id, "pro", 3, 2, "upgrade"),
+            (sub_id, "pro", 1.0, 2, "upgrade"),
+            (sub_id, "pro", 1, "2", "upgrade"),
+            (sub_id, "pro", True, 2, "upgrade"),
+            (sub_id, "pro", 1, True, "upgrade"),
+            (False, "pro", 1, 2, "upgrade"),
+            (sub_id, True, 1, 2, "upgrade"),
+            (sub_id, "pro", 1, 2, True),
+            (sub_id, "pro", 1, 2, ""),
+            (sub_id, "pro", 1, 2, "  "),
+        ):
+            with self.subTest(request=request):
+                *args, key = request
+                with self.assertRaises(ValidationError):
+                    self.service.upgrade_subscription(*args, idempotency_key=key)
+                self.assertEqual(self.sub.plan_id, "starter")
+                self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [])
+
+        self.service.upgrade_subscription(sub_id, "pro", 1, 2, idempotency_key="upgrade")
+        self.assertEqual(self.sub.plan_id, "pro")
+
+    def test_replay_returns_original_entry_after_a_later_upgrade(self) -> None:
+        args = (self.sub.subscription_id, "pro", 1, 2)
+        original = self.service.upgrade_subscription(*args, idempotency_key="first")
+        later = self.service.upgrade_subscription(
+            self.sub.subscription_id, "premium", 1, 1, idempotency_key="second"
+        )
+        other_service = OrderService(self.service.ledger)
+        self.assertIs(other_service.upgrade_subscription(*args, idempotency_key="first"), original)
+        self.assertEqual(self.sub.plan_id, "premium")
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [original, later])
+
+    def test_key_conflicts_for_each_changed_argument(self) -> None:
+        sub_id = self.sub.subscription_id
+        other_sub = self.service.start_subscription("acct_2", "starter")
+        original = self.service.upgrade_subscription(sub_id, "pro", 1, 2, idempotency_key="upgrade")
+        for args in (
+            (other_sub.subscription_id, "pro", 1, 2),
+            (sub_id, "premium", 1, 2),
+            (sub_id, "pro", 0, 2),
+            (sub_id, "pro", 1, 3),
+            (sub_id, "pro", True, 2),
+            (sub_id, "pro", 1, 2.0),
+        ):
+            with self.subTest(args=args), self.assertRaises(ValidationError):
+                self.service.upgrade_subscription(*args, idempotency_key="upgrade")
+
+        self.assertIs(
+            self.service.upgrade_subscription(sub_id, "pro", 1, 2, idempotency_key="upgrade"),
+            original,
+        )
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertEqual(other_sub.plan_id, "starter")
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [original])
+        self.assertEqual(self.service.ledger.entries_for_account("acct_2"), [])
+
+    def test_concurrent_replays_record_one_charge(self) -> None:
+        ready = Barrier(4, timeout=5)
+
+        def submit_upgrade() -> LedgerEntry:
+            ready.wait()
+            return self.service.upgrade_subscription(
+                self.sub.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+            )
+
+        with ThreadPoolExecutor(max_workers=4) as pool:
+            requests = [pool.submit(submit_upgrade) for _ in range(4)]
+            results = [request.result() for request in requests]
+
+        self.assertTrue(all(entry is results[0] for entry in results))
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [results[0]])
