+            with self.subTest(code=code, as_of=as_of), self.assertRaisesRegex(ValidationError, "idempotency_key"):
+                other_service.upgrade_subscription(*args, idempotency_key="upgrade", promo_code=code, as_of=as_of)
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [entry])

