+"""Tests for promo validation and shared order and upgrade pricing."""
+
+import unittest
+
+from ev1_order_ledger import LineItem, OrderService, Plan, ValidationError
+
+
+class PromoTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.service = OrderService()
+        self.items = [LineItem("seat", 101, 1)]
+
+    def test_percent_discount_rounds_half_up_before_tax_and_is_saved(self) -> None:
+        self.service.register_promo("HALF", percent_off=50)
+        order = self.service.place_order("acct", self.items, tax_bps=1000, promo_code="HALF")
+
+        self.assertEqual(order.discount_cents, 51)
+        self.assertEqual(order.promo_code, "HALF")
+        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (50, 5, 55))
+        self.assertIs(self.service.ledger.get_order(order.order_id), order)
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], 55)
+
+    def test_fixed_discount_with_legacy_fee_and_clamp_to_zero(self) -> None:
+        self.service.register_promo("LESS", amount_off_cents=120)
+        order = self.service.place_order(
+            "acct", self.items, tax_bps=1000, legacy_flat_fee=True, promo_code="LESS"
+        )
+        self.assertEqual((order.discount_cents, order.subtotal_cents), (120, 481))
+        self.assertEqual((order.tax_cents, order.total_cents), (48, 529))
+
+        free = self.service.place_order("acct", self.items, tax_bps=1000, promo_code="LESS")
+        self.assertEqual(free.discount_cents, 101)
+        self.assertEqual((free.subtotal_cents, free.tax_cents, free.total_cents), (0, 0, 0))
+
