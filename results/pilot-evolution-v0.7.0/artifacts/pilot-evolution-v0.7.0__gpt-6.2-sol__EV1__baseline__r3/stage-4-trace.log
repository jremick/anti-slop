{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc 'cat benchmarks/sources/ev1_order_ledger/{api,ledger,pricing}.py'","aggregated_output":"\"\"\"Service facade coordinating pricing and ledger persistence for EV1.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Dict, Sequence\n\nfrom .ledger import OrderLedger\nfrom .models import LedgerEntry, LineItem, Order, Plan, Promo, Subscription, ValidationError\nfrom .pricing import calculate_charge, compute_order_subtotal_cents, parse_optional_date\n\n\nclass OrderService:\n    def __init__(self, ledger: OrderLedger | None = None) -> None:\n        self.ledger = ledger if ledger is not None else OrderLedger()\n\n    def register_plan(self, plan: Plan) -> None:\n        self.ledger.add_plan(plan)\n\n    def register_promo(\n        self,\n        code: str,\n        *,\n        percent_off: int | None = None,\n        amount_off_cents: int | None = None,\n        expires_on: str | None = None,\n        min_subtotal_cents: int = 0,\n    ) -> None:\n        promo = Promo(\n            code=code,\n            percent_off=percent_off,\n            amount_off_cents=amount_off_cents,\n            expires_on=parse_optional_date(expires_on, \"expires_on\"),\n            min_subtotal_cents=min_subtotal_cents,\n        )\n        self.ledger.add_promo(promo)\n\n    def place_order(\n        self,\n        account_id: str,\n        items: Sequence[LineItem],\n        *,\n        tax_bps: int = 0,\n        legacy_flat_fee: bool = False,\n        promo_code: str | None = None,\n        as_of: str | None = None,\n    ) -> Order:\n        if not account_id.strip():\n            raise ValidationError(\"account_id must be non-empty\")\n        subtotal = compute_order_subtotal_cents(items, legacy_flat_fee=legacy_flat_fee)\n        subtotal, tax, total, discount = calculate_charge(\n            subtotal,\n            tax_bps=tax_bps,\n            promo=self.ledger.get_promo(promo_code),\n            as_of=parse_optional_date(as_of, \"as_of\"),\n        )\n        order_id = self.ledger.next_id(\"ord\")\n        order = Order(\n            order_id=order_id,\n            account_id=account_id,\n            items=tuple(items),\n            subtotal_cents=subtotal,\n            tax_cents=tax,\n            total_cents=total,\n            discount_cents=discount,\n            promo_code=promo_code,\n        )\n        self.ledger.save_order(order)\n        entry = LedgerEntry(\n            entry_id=self.ledger.next_id(\"ent\"),\n            account_id=account_id,\n            kind=\"order_charge\",\n            subtotal_cents=subtotal,\n            tax_cents=tax,\n            total_cents=total,\n            reference_id=order_id,\n        )\n        self.ledger.record_entry(entry)\n        return order\n\n    def refund_order(\n        self, order_id: str, amount_cents: int, *, reason: str, idempotency_key: str\n    ) -> LedgerEntry:\n        return self.ledger.refund_order(\n            order_id, amount_cents, reason=reason, idempotency_key=idempotency_key\n        )\n\n    def export_credit_note(self, refund_entry_id: str) -> Dict[str, str | int]:\n        if not isinstance(refund_entry_id, str) or not refund_entry_id.strip():\n            raise ValidationError(\"refund_entry_id must be a non-empty string\")\n        entry = self.ledger.get_entry(refund_entry_id)\n        if entry is None or entry.kind != \"order_refund\":\n            raise ValidationError(f\"Unknown refund entry_id: {refund_entry_id}\")\n        return {\n            \"entry_id\": entry.entry_id,\n            \"order_id\": entry.reference_id,\n            \"account_id\": entry.account_id,\n            \"subtotal_cents\": -entry.subtotal_cents,\n            \"tax_cents\": -entry.tax_cents,\n            \"total_cents\": -entry.total_cents,\n            \"reason\": entry.reason,\n        }\n\n    def start_subscription(self, account_id: str, plan_id: str) -> Subscription:\n        if not account_id.strip():\n            raise ValidationError(\"account_id must be non-empty\")\n        self.ledger.get_plan(plan_id)\n        sub = Subscription(\n            subscription_id=self.ledger.next_id(\"sub\"),\n            account_id=account_id,\n            plan_id=plan_id,\n        )\n        self.ledger.save_subscription(sub)\n        return sub\n\n    def upgrade_subscription(\n        self,\n        subscription_id: str,\n        new_plan_id: str,\n        days_remaining: int,\n        cycle_days: int,\n        *,\n        idempotency_key: str,\n        promo_code: str | None = None,\n        as_of: str | None = None,\n    ) -> LedgerEntry:\n        return self.ledger.upgrade_subscription(\n            subscription_id,\n            new_plan_id,\n            days_remaining,\n            cycle_days,\n            idempotency_key=idempotency_key,\n            promo_code=promo_code,\n            as_of=as_of,\n        )\n\n    def get_statement(self, account_id: str) -> Dict[str, object]:\n        entries = self.ledger.entries_for_account(account_id)\n        return {\n            \"account_id\": account_id,\n            \"balance_cents\": self.ledger.account_balance_cents(account_id),\n            \"entry_count\": len(entries),\n        }\n\"\"\"In-memory order, subscription, and ledger store for EV1.\"\"\"\n\nfrom __future__ import annotations\n\nfrom threading import RLock\nfrom typing import Dict, List, Optional\n\nfrom .models import LedgerEntry, Order, Plan, Promo, Subscription, ValidationError\nfrom .pricing import (\n    calculate_charge,\n    calculate_refund_split,\n    compute_upgrade_subtotal_cents,\n    parse_optional_date,\n    validate_non_negative_int,\n    validate_positive_int,\n    validate_proration_period,\n)\n\n\ndef _validate_promo_code(code: str) -> None:\n    if not isinstance(code, str) or not code.strip() or \",\" in code:\n        raise ValidationError(\"promo code must be a single non-empty string without commas\")\n\n\nclass OrderLedger:\n    def __init__(self) -> None:\n        self._plans: Dict[str, Plan] = {}\n        self._promos: dict[str, Promo] = {}\n        self._orders: Dict[str, Order] = {}\n        self._subscriptions: Dict[str, Subscription] = {}\n        self._entries: Dict[str, LedgerEntry] = {}\n        self._entry_order: List[str] = []\n        self._idempotent_entries: dict[str, tuple[tuple[object, ...], LedgerEntry]] = {}\n        self._lock = RLock()\n        self._seq = 0\n\n    def next_id(self, prefix: str) -> str:\n        with self._lock:\n            self._seq += 1\n            return f\"{prefix}_{self._seq:04d}\"\n\n    def add_plan(self, plan: Plan) -> None:\n        if not plan.plan_id.strip():\n            raise ValidationError(\"plan_id must be non-empty\")\n        if isinstance(plan.monthly_cents, bool) or not isinstance(plan.monthly_cents, int) or plan.monthly_cents < 0:\n            raise ValidationError(\"monthly_cents must be a non-negative integer\")\n        self._plans[plan.plan_id] = plan\n\n    def get_plan(self, plan_id: str) -> Plan:\n        plan = self._plans.get(plan_id)\n        if plan is None:\n            raise ValidationError(f\"Unknown plan_id: {plan_id}\")\n        return plan\n\n    def add_promo(self, promo: Promo) -> None:\n        _validate_promo_code(promo.code)\n        if (promo.percent_off is None) == (promo.amount_off_cents is None):\n            raise ValidationError(\"exactly one of percent_off and amount_off_cents is required\")\n        if promo.percent_off is not None:\n            validate_positive_int(promo.percent_off, \"percent_off\")\n            if promo.percent_off > 100:\n                raise ValidationError(\"percent_off cannot exceed 100\")\n        if promo.amount_off_cents is not None:\n            validate_positive_int(promo.amount_off_cents, \"amount_off_cents\")\n        validate_non_negative_int(promo.min_subtotal_cents, \"min_subtotal_cents\")\n        self._promos[promo.code] = promo\n\n    def get_promo(self, code: str | None) -> Promo | None:\n        if code is None:\n            return None\n        _validate_promo_code(code)\n        promo = self._promos.get(code)\n        if promo is None:\n            raise ValidationError(f\"Unknown promo code: {code}\")\n        return promo\n\n    def save_order(self, order: Order) -> None:\n        self._orders[order.order_id] = order\n\n    def get_order(self, order_id: str) -> Order:\n        order = self._orders.get(order_id)\n        if order is None:\n            raise ValidationError(f\"Unknown order_id: {order_id}\")\n        return order\n\n    def refund_order(\n        self, order_id: str, amount_cents: int, *, reason: str, idempotency_key: str\n    ) -> LedgerEntry:\n        validate_positive_int(amount_cents, \"amount_cents\")\n        for field, value in (\n            (\"order_id\", order_id),\n            (\"reason\", reason),\n            (\"idempotency_key\", idempotency_key),\n        ):\n            if not isinstance(value, str) or not value.strip():\n                raise ValidationError(f\"{field} must be a non-empty string\")\n        request = (\"order_refund\", order_id, amount_cents, reason)\n\n        with self._lock:\n            previous = self._replay_entry(idempotency_key, request)\n            if previous is not None:\n                return previous\n\n            order = self.get_order(order_id)\n            already_refunded = sum(\n                -entry.total_cents\n                for entry in self.entries_for_account(order.account_id)\n                if entry.kind == \"order_refund\" and entry.reference_id == order_id\n            )\n            subtotal, tax = calculate_refund_split(order, already_refunded, amount_cents)\n            entry = LedgerEntry(\n                entry_id=self.next_id(\"ent\"),\n                account_id=order.account_id,\n                kind=\"order_refund\",\n                subtotal_cents=-subtotal,\n                tax_cents=-tax,\n                total_cents=-amount_cents,\n                reference_id=order_id,\n                reason=reason,\n            )\n            self.record_entry(entry)\n            self._idempotent_entries[idempotency_key] = (request, entry)\n            return entry\n\n    def save_subscription(self, sub: Subscription) -> None:\n        self._subscriptions[sub.subscription_id] = sub\n\n    def get_subscription(self, subscription_id: str) -> Subscription:\n        sub = self._subscriptions.get(subscription_id)\n        if sub is None:\n            raise ValidationError(f\"Unknown subscription_id: {subscription_id}\")\n        return sub\n\n    def upgrade_subscription(\n        self,\n        subscription_id: str,\n        new_plan_id: str,\n        days_remaining: int,\n        cycle_days: int,\n        *,\n        idempotency_key: str,\n        promo_code: str | None = None,\n        as_of: str | None = None,\n    ) -> LedgerEntry:\n        for field, value in (\n            (\"subscription_id\", subscription_id),\n            (\"new_plan_id\", new_plan_id),\n            (\"idempotency_key\", idempotency_key),\n        ):\n            if not isinstance(value, str) or not value.strip():\n                raise ValidationError(f\"{field} must be a non-empty string\")\n        validate_proration_period(days_remaining, cycle_days)\n        pricing_date = parse_optional_date(as_of, \"as_of\")\n        request = (\n            \"plan_upgrade\", subscription_id, new_plan_id, days_remaining, cycle_days, promo_code, as_of\n        )\n\n        with self._lock:\n            previous = self._replay_entry(idempotency_key, request)\n            if previous is not None:\n                return previous\n\n            sub = self.get_subscription(subscription_id)\n            old_plan = self.get_plan(sub.plan_id)\n            new_plan = self.get_plan(new_plan_id)\n            subtotal = compute_upgrade_subtotal_cents(\n                old_plan, new_plan, days_remaining, cycle_days\n            )\n            promo = self.get_promo(promo_code)\n            subtotal, tax, total, discount = calculate_charge(\n                subtotal, tax_bps=new_plan.tax_bps, promo=promo, as_of=pricing_date\n            )\n            entry = LedgerEntry(\n                entry_id=self.next_id(\"ent\"),\n                account_id=sub.account_id,\n                kind=\"plan_upgrade\",\n                subtotal_cents=subtotal,\n                tax_cents=tax,\n                total_cents=total,\n                reference_id=subscription_id,\n                metadata={\"promo_code\": promo.code, \"discount_cents\": discount} if promo else {},\n            )\n            self.record_entry(entry)\n            sub.plan_id = new_plan_id\n            self._idempotent_entries[idempotency_key] = (request, entry)\n            return entry\n\n    def _replay_entry(self, key: str, request: tuple[object, ...]) -> LedgerEntry | None:\n        previous = self._idempotent_entries.get(key)\n        if previous is None:\n            return None\n        previous_request, entry = previous\n        if previous_request != request:\n            raise ValidationError(\"idempotency_key was already used for a different request\")\n        return entry\n\n    def record_entry(self, entry: LedgerEntry) -> None:\n        self._entries[entry.entry_id] = entry\n        self._entry_order.append(entry.entry_id)\n\n    def get_entry(self, entry_id: str) -> Optional[LedgerEntry]:\n        return self._entries.get(entry_id)\n\n    def entries_for_account(self, account_id: str) -> List[LedgerEntry]:\n        return [\n            self._entries[eid]\n            for eid in self._entry_order\n            if self._entries[eid].account_id == account_id\n        ]\n\n    def account_balance_cents(self, account_id: str) -> int:\n        return sum(e.total_cents for e in self.entries_for_account(account_id))\n\"\"\"Canonical integer-cent pricing calculations for EV1 order ledger.\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import date\nfrom typing import Sequence, Tuple\n\nfrom .models import LineItem, Order, Plan, Promo, ValidationError\n\n\nLEGACY_FLAT_FEE_CENTS = 500\n\n\ndef validate_non_negative_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value < 0:\n        raise ValidationError(f\"{field_name} must be a non-negative integer\")\n    return value\n\n\ndef validate_positive_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:\n        raise ValidationError(f\"{field_name} must be a positive integer\")\n    return value\n\n\ndef round_half_up_div(numerator: int, denominator: int) -> int:\n    \"\"\"Exact integer half-up division for non-negative numerator and positive denominator.\"\"\"\n    validate_non_negative_int(numerator, \"numerator\")\n    validate_positive_int(denominator, \"denominator\")\n    return (numerator * 2 + denominator) // (2 * denominator)\n\n\ndef compute_subtotal_cents(items: Sequence[LineItem]) -> int:\n    if not items:\n        raise ValidationError(\"items must be non-empty\")\n    subtotal = 0\n    for item in items:\n        validate_positive_int(item.unit_cents, \"unit_cents\")\n        validate_positive_int(item.quantity, \"quantity\")\n        subtotal += item.unit_cents * item.quantity\n    return subtotal\n\n\ndef compute_tax_cents(taxable_cents: int, tax_bps: int) -> int:\n    validate_non_negative_int(taxable_cents, \"taxable_cents\")\n    validate_non_negative_int(tax_bps, \"tax_bps\")\n    if tax_bps > 10_000:\n        raise ValidationError(\"tax_bps cannot exceed 10000\")\n    return round_half_up_div(taxable_cents * tax_bps, 10_000)\n\n\ndef calculate_refund_split(\n    order: Order, already_refunded_cents: int, amount_cents: int\n) -> Tuple[int, int]:\n    \"\"\"Return the subtotal and tax portions of a validated refund amount.\"\"\"\n    cumulative_cents = already_refunded_cents + amount_cents\n    if cumulative_cents > order.total_cents:\n        raise ValidationError(\"refund amount exceeds the remaining order balance\")\n\n    # Differences between rounded cumulative amounts conserve the order's exact tax.\n    previous_tax = round_half_up_div(order.tax_cents * already_refunded_cents, order.total_cents)\n    cumulative_tax = round_half_up_div(order.tax_cents * cumulative_cents, order.total_cents)\n    refund_tax = cumulative_tax - previous_tax\n    return amount_cents - refund_tax, refund_tax\n\n\ndef parse_optional_date(value: str | None, field_name: str) -> date | None:\n    if value is None:\n        return None\n    try:\n        parsed = date.fromisoformat(value)\n    except (TypeError, ValueError):\n        raise ValidationError(f\"{field_name} must be a date in YYYY-MM-DD format\") from None\n    if parsed.isoformat() != value:\n        raise ValidationError(f\"{field_name} must be a date in YYYY-MM-DD format\")\n    return parsed\n\n\ndef calculate_charge(\n    subtotal_cents: int,\n    *,\n    tax_bps: int,\n    promo: Promo | None = None,\n    as_of: date | None = None,\n) -> Tuple[int, int, int, int]:\n    \"\"\"Return discounted subtotal, tax, total, and discount in integer cents.\"\"\"\n    discount = 0\n    if promo is not None:\n        if subtotal_cents < promo.min_subtotal_cents:\n            raise ValidationError(\"subtotal is below the promo minimum\")\n        if promo.expires_on is not None:\n            if as_of is None:\n                raise ValidationError(\"as_of is required for an expiring promo\")\n            if as_of > promo.expires_on:\n                raise ValidationError(\"promo has expired\")\n        if promo.percent_off is not None:\n            discount = round_half_up_div(subtotal_cents * promo.percent_off, 100)\n        elif promo.amount_off_cents is not None:\n            discount = min(subtotal_cents, promo.amount_off_cents)\n        else:\n            raise ValidationError(\"promo must specify a discount\")\n\n    discounted_subtotal = subtotal_cents - discount\n    tax = compute_tax_cents(discounted_subtotal, tax_bps)\n    return discounted_subtotal, tax, discounted_subtotal + tax, discount\n\n\ndef validate_proration_period(days_remaining: int, cycle_days: int) -> None:\n    validate_positive_int(cycle_days, \"cycle_days\")\n    validate_non_negative_int(days_remaining, \"days_remaining\")\n    if days_remaining > cycle_days:\n        raise ValidationError(\"days_remaining cannot exceed cycle_days\")\n\n\ndef compute_upgrade_subtotal_cents(\n    old_plan: Plan, new_plan: Plan, days_remaining: int, cycle_days: int\n) -> int:\n    \"\"\"Return the price increase prorated over a validated period.\"\"\"\n    price_increase = new_plan.monthly_cents - old_plan.monthly_cents\n    if price_increase <= 0:\n        raise ValidationError(\"new plan must cost more than the current plan\")\n    return round_half_up_div(price_increase * days_remaining, cycle_days)\n\n\ndef calculate_upgrade_totals(\n    old_plan: Plan, new_plan: Plan, days_remaining: int, cycle_days: int\n) -> Tuple[int, int, int]:\n    \"\"\"Return subtotal, tax, and total for a validated proration period.\"\"\"\n    subtotal = compute_upgrade_subtotal_cents(old_plan, new_plan, days_remaining, cycle_days)\n    subtotal, tax, total, _ = calculate_charge(subtotal, tax_bps=new_plan.tax_bps)\n    return subtotal, tax, total\n\n\ndef compute_order_subtotal_cents(items: Sequence[LineItem], *, legacy_flat_fee: bool) -> int:\n    subtotal = compute_subtotal_cents(items)\n    if legacy_flat_fee:\n        subtotal += LEGACY_FLAT_FEE_CENTS\n    return subtotal\n\n\ndef calculate_order_totals(\n    items: Sequence[LineItem],\n    *,\n    tax_bps: int = 0,\n    legacy_flat_fee: bool = False,\n) -> Tuple[int, int, int]:\n    \"\"\"Return (subtotal_cents, tax_cents, total_cents) using exact integer cents.\"\"\"\n    subtotal = compute_order_subtotal_cents(items, legacy_flat_fee=legacy_flat_fee)\n    subtotal, tax, total, _ = calculate_charge(subtotal, tax_bps=tax_bps)\n    return subtotal, tax, total\n","exit_code":0,"status":"completed"}}
