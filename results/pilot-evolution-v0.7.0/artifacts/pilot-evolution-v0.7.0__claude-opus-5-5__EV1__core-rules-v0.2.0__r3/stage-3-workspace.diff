+"""Turn 1: mid-cycle prorated plan upgrades with idempotency."""
+
+from __future__ import annotations
+
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import Plan, ValidationError
+from ev1_order_ledger.pricing import calculate_upgrade_totals, compute_prorated_upgrade_cents
+
+
+def make_service() -> OrderService:
+    svc = OrderService()
+    svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=825))
+    svc.register_plan(Plan(plan_id="growth", name="Growth", monthly_cents=1025, tax_bps=0))
+    svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+    return svc
+
+
+class ProrationPricingTests(unittest.TestCase):
+    def test_exact_half_rounds_up(self) -> None:
+        # 25 * 1 / 10 = 2.5 -> 3 (banker's rounding would give 2)
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 1025, 1, 10), 3)
+        # 25 * 3 / 10 = 7.5 -> 8
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 1025, 3, 10), 8)
+
+    def test_non_half_fractions_round_to_nearest(self) -> None:
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 3000, 1, 31), 65)   # 64.516
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 3000, 2, 31), 129)  # 129.032
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 3000, 1, 30), 67)   # 66.667
+
+    def test_boundary_days(self) -> None:
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 3000, 0, 30), 0)
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 3000, 30, 30), 2000)
+
+    def test_tax_uses_new_plan_rate_with_half_up(self) -> None:
+        starter = Plan("starter", "Starter", 1000, 825)
+        pro = Plan("pro", "Pro", 3000, 825)
+        # subtotal 1000; tax 1000 * 825 / 10000 = 82.5 -> 83
+        self.assertEqual(calculate_upgrade_totals(starter, pro, 15, 30), (1000, 83, 1083))
+        untaxed = Plan("pro_nt", "Pro", 3000, 0)
+        self.assertEqual(calculate_upgrade_totals(starter, untaxed, 15, 30), (1000, 0, 1000))
+
+    def test_pricing_helper_rejects_invalid_inputs(self) -> None:
+        bad_args = [
+            (1000, 3000, 1, 0),       # cycle_days == 0
+            (1000, 3000, 1, -30),     # negative cycle
+            (1000, 3000, -1, 30),     # negative days
+            (1000, 3000, 31, 30),     # days > cycle
+            (1000, 1000, 1, 30),      # same price
+            (3000, 1000, 1, 30),      # downgrade
+            (1000, 3000, True, 30),   # bool days
+            (1000, 3000, 1, True),    # bool cycle
+            (1000, 3000, 1.0, 30),    # float days
+        ]
+        for args in bad_args:
+            with self.subTest(args=args), self.assertRaises(ValidationError):
+                compute_prorated_upgrade_cents(*args)
+
+
+class UpgradeSubscriptionTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = make_service()
+        self.sub = self.svc.start_subscription("acct_1", "starter")
+
+    def entries(self):
+        return self.svc.ledger.entries_for_account("acct_1")
+
+    def test_upgrade_records_entry_and_switches_plan(self) -> None:
+        entry = self.svc.upgrade_subscription(
+            self.sub.subscription_id, "pro", 15, 30, idempotency_key="k1"
+        )
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.sub.subscription_id)
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (1000, 83, 1083))
+        self.assertEqual(entry.metadata["old_plan_id"], "starter")
+        self.assertEqual(entry.metadata["new_plan_id"], "pro")
+        self.assertEqual(self.svc.ledger.get_subscription(self.sub.subscription_id).plan_id, "pro")
+        self.assertEqual(self.entries(), [entry])
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 1083)
+
+    def test_upgrade_half_up_through_service(self) -> None:
+        entry = self.svc.upgrade_subscription(
+            self.sub.subscription_id, "growth", 1, 10, idempotency_key="k1"
+        )
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (3, 0, 3))
+
+    def test_zero_days_remaining_switches_plan_with_zero_charge(self) -> None:
+        entry = self.svc.upgrade_subscription(
+            self.sub.subscription_id, "pro", 0, 30, idempotency_key="k1"
+        )
+        self.assertEqual(entry.total_cents, 0)
+        self.assertEqual(self.svc.ledger.get_subscription(self.sub.subscription_id).plan_id, "pro")
+
+    def assert_rejected_without_side_effects(self, *args, **kwargs) -> None:
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(*args, **kwargs)
+        self.assertEqual(self.entries(), [])
+        self.assertEqual(self.svc.ledger.get_subscription(self.sub.subscription_id).plan_id, "starter")
+
+    def test_rejects_unknown_ids(self) -> None:
+        sid = self.sub.subscription_id
+        self.assert_rejected_without_side_effects("sub_missing", "pro", 1, 30, idempotency_key="k1")
+        self.assert_rejected_without_side_effects(sid, "missing_plan", 1, 30, idempotency_key="k2")
+        self.assert_rejected_without_side_effects("", "pro", 1, 30, idempotency_key="k3")
+        self.assert_rejected_without_side_effects(sid, None, 1, 30, idempotency_key="k4")
+
+    def test_rejects_non_upgrades(self) -> None:
+        sid = self.sub.subscription_id
+        self.svc.register_plan(Plan("starter_clone", "Clone", 1000, 825))
+        self.svc.register_plan(Plan("lite", "Lite", 500, 825))
+        self.assert_rejected_without_side_effects(sid, "starter", 1, 30, idempotency_key="k1")
+        self.assert_rejected_without_side_effects(sid, "starter_clone", 1, 30, idempotency_key="k2")
+        self.assert_rejected_without_side_effects(sid, "lite", 1, 30, idempotency_key="k3")
+
+    def test_rejects_invalid_bounds_and_booleans(self) -> None:
+        sid = self.sub.subscription_id
+        cases = [
+            (0, 0), (1, 0), (1, -1), (-1, 30), (31, 30),
+            (True, 30), (False, 30), (1, True), ("1", 30), (1.5, 30),
+        ]
+        for i, (days, cycle) in enumerate(cases):
+            with self.subTest(days=days, cycle=cycle):
+                self.assert_rejected_without_side_effects(sid, "pro", days, cycle, idempotency_key=f"k{i}")
+
+    def test_rejects_empty_or_invalid_idempotency_key(self) -> None:
+        sid = self.sub.subscription_id
+        for key in ("", "   ", None, 123):
+            with self.subTest(key=key):
+                self.assert_rejected_without_side_effects(sid, "pro", 1, 30, idempotency_key=key)
+
+    def test_idempotency_key_is_keyword_only_and_required(self) -> None:
+        with self.assertRaises(TypeError):
+            self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 1, 30, "k1")  # type: ignore[misc]
+        with self.assertRaises(TypeError):
+            self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 1, 30)  # type: ignore[call-arg]
+
+
+class UpgradeIdempotencyTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = make_service()
+        self.sid = self.svc.start_subscription("acct_1", "starter").subscription_id
+        self.first = self.svc.upgrade_subscription(self.sid, "pro", 15, 30, idempotency_key="k1")
+
+    def test_replay_returns_original_entry_without_duplicate(self) -> None:
+        replay = self.svc.upgrade_subscription(self.sid, "pro", 15, 30, idempotency_key="k1")
+        self.assertIs(replay, self.first)
+        self.assertEqual(len(self.svc.ledger.entries_for_account("acct_1")), 1)
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 1083)
+        self.assertEqual(self.svc.ledger.get_subscription(self.sid).plan_id, "pro")
+
+    def test_reuse_with_different_arguments_conflicts(self) -> None:
+        other_sid = self.svc.start_subscription("acct_2", "starter").subscription_id
+        conflicting = [
+            (other_sid, "pro", 15, 30),
+            (self.sid, "growth", 15, 30),
+            (self.sid, "pro", 14, 30),
+            (self.sid, "pro", 15, 31),
+        ]
+        for args in conflicting:
+            with self.subTest(args=args), self.assertRaises(ValidationError):
+                self.svc.upgrade_subscription(*args, idempotency_key="k1")
+        self.assertEqual(len(self.svc.ledger.entries_for_account("acct_1")), 1)
+        self.assertEqual(self.svc.ledger.entries_for_account("acct_2"), [])
+        self.assertEqual(self.svc.ledger.get_subscription(other_sid).plan_id, "starter")
+
+    def test_boolean_replay_does_not_match_integer_fingerprint(self) -> None:
+        svc = make_service()
+        sid = svc.start_subscription("acct_1", "starter").subscription_id
+        svc.upgrade_subscription(sid, "pro", 1, 30, idempotency_key="kb")
+        with self.assertRaises(ValidationError):
+            svc.upgrade_subscription(sid, "pro", True, 30, idempotency_key="kb")
+
+    def test_new_key_on_already_upgraded_subscription_is_rejected(self) -> None:
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(self.sid, "pro", 15, 30, idempotency_key="k2")
+        self.assertEqual(len(self.svc.ledger.entries_for_account("acct_1")), 1)
+
+    def test_failed_attempt_does_not_consume_key(self) -> None:
+        sid = self.svc.start_subscription("acct_3", "starter").subscription_id
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sid, "pro", 31, 30, idempotency_key="k3")
+        entry = self.svc.upgrade_subscription(sid, "pro", 30, 30, idempotency_key="k3")
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (2000, 165, 2165))
+
+
+if __name__ == "__main__":
+    unittest.main()
