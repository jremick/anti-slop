+class RefundAllocationPropertyTests(unittest.TestCase):
+    def test_random_chunk_sequences_conserve_every_penny(self) -> None:
+        rng = random.Random(20261127)
+        for _ in range(500):
+            subtotal = rng.randint(1, 50_000)
+            tax = rng.randint(0, subtotal)  # covers tax_bps up to 100%
+            total = subtotal + tax
+            refunded_total = refunded_tax = 0
+            while refunded_total < total:
+                amount = rng.randint(1, total - refunded_total)
+                part_sub, part_tax = allocate_refund_cents(subtotal, tax, refunded_total, refunded_tax, amount)
+                self.assertEqual(part_sub + part_tax, amount)
+                self.assertGreaterEqual(part_sub, 0)
+                self.assertGreaterEqual(part_tax, 0)
+                refunded_total += amount
+                refunded_tax += part_tax
+            self.assertEqual(refunded_tax, tax)
+            self.assertEqual(refunded_total - refunded_tax, subtotal)
+
+    def test_over_allocation_rejected(self) -> None:
+        with self.assertRaises(ValidationError):
+            allocate_refund_cents(100, 8, 100, 7, 9)
+
+
+class RefundOrderTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = make_service()
+        # subtotal 3998, tax 330, total 4328
+        self.order = self.svc.place_order("acct_1", [LineItem("seat", 1999, 2)], tax_bps=825)
+
+    def refund(self, amount: int, key: str, reason: str = "partial"):
+        return self.svc.refund_order(self.order.order_id, amount, reason=reason, idempotency_key=key)
+
+    def refunds(self):
+        return [e for e in self.svc.ledger.entries_for_account("acct_1") if e.kind == "order_refund"]
+
+    def test_single_refund_entry_shape(self) -> None:
+        entry = self.refund(1000, "r1", reason="damaged seat")
+        # cumulative tax: 330 * 1000 / 4328 = 76.25 -> 76
+        self.assertEqual(entry.kind, "order_refund")
+        self.assertEqual(entry.reference_id, self.order.order_id)
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual(entry.reason, "damaged seat")
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (-924, -76, -1000))
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 4328 - 1000)
+
+    def test_three_chunks_reverse_exact_order_amounts(self) -> None:
+        entries = [self.refund(1000, "r1"), self.refund(1000, "r2"), self.refund(2328, "r3")]
+        # cumulative tax targets: 76 (76.25), 152 (152.495), 330
+        self.assertEqual([e.tax_cents for e in entries], [-76, -76, -178])
+        self.assertEqual([e.subtotal_cents for e in entries], [-924, -924, -2150])
+        self.assertEqual(sum(e.tax_cents for e in entries), -self.order.tax_cents)
+        self.assertEqual(sum(e.subtotal_cents for e in entries), -self.order.subtotal_cents)
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 0)
+
+    def test_penny_by_penny_refunds_have_zero_drift(self) -> None:
+        # Per-chunk rounding would refund 0 tax on every 1-cent chunk; cumulative allocation must not.
+        svc = make_service()
+        order = svc.place_order("acct_2", [LineItem("x", 101, 1)], tax_bps=825)  # 101 + 8 = 109
+        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (101, 8, 109))
+        entries = [
+            svc.refund_order(order.order_id, 1, reason="penny", idempotency_key=f"p{i}")
+            for i in range(order.total_cents)
+        ]
+        for e in entries:
+            self.assertEqual(e.subtotal_cents + e.tax_cents, e.total_cents)
+        self.assertEqual(-sum(e.tax_cents for e in entries), 8)
+        self.assertEqual(-sum(e.subtotal_cents for e in entries), 101)
+
+    def test_refund_of_discounted_order_uses_discounted_amounts(self) -> None:
+        order = self.svc.place_order("acct_3", [LineItem("seat", 1999, 2)], tax_bps=825, promo_code="SAVE10")
+        entry = self.svc.refund_order(order.order_id, order.total_cents, reason="cancel", idempotency_key="full")
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (-3598, -297, -3895))
+
+    def test_over_refund_rejected(self) -> None:
+        with self.assertRaises(ValidationError):
+            self.refund(4329, "r0")
+        self.refund(4000, "r1")
+        with self.assertRaises(ValidationError):
+            self.refund(329, "r2")
+        self.refund(328, "r2")  # exactly the remainder
+        with self.assertRaises(ValidationError):
+            self.refund(1, "r3")
+        self.assertEqual(-sum(e.total_cents for e in self.refunds()), 4328)
+
+    def test_zero_total_order_cannot_be_refunded(self) -> None:
+        order = self.svc.place_order("acct_4", [LineItem("x", 500, 1)], promo_code="FREE")
+        with self.assertRaises(ValidationError):
+            self.svc.refund_order(order.order_id, 1, reason="x", idempotency_key="z")
