+    def test_invalid_inputs_rejected_without_entries(self) -> None:
+        oid = self.order.order_id
+        cases = [
+            (oid, 0, "r", "k"), (oid, -1, "r", "k"), (oid, True, "r", "k"), (oid, 1.0, "r", "k"),
+            (oid, "1", "r", "k"), (oid, 1, "", "k"), (oid, 1, "  ", "k"), (oid, 1, None, "k"),
+            (oid, 1, "r", ""), (oid, 1, "r", None), ("ord_missing", 1, "r", "k"), ("", 1, "r", "k"),
+        ]
+        for order_id, amount, reason, key in cases:
+            with self.subTest(order_id=order_id, amount=amount, reason=reason, key=key):
+                with self.assertRaises(ValidationError):
+                    self.svc.refund_order(order_id, amount, reason=reason, idempotency_key=key)
+        self.assertEqual(self.refunds(), [])
+
+    def test_reason_and_key_are_keyword_only(self) -> None:
+        with self.assertRaises(TypeError):
+            self.svc.refund_order(self.order.order_id, 1, "r", "k")  # type: ignore[misc]
