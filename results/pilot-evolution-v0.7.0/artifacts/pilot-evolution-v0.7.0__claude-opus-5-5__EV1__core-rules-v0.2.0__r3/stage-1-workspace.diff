+    def upgrade_subscription(
+        self,
+        subscription_id: str,
+        new_plan_id: str,
+        days_remaining: int,
+        cycle_days: int,
+        *,
+        idempotency_key: str,
+    ) -> LedgerEntry:
+        """Move a subscription to a pricier plan mid-cycle and charge the prorated difference.
+
+        Replaying the same idempotency_key with identical arguments returns the original entry.
+        """
+        if not isinstance(idempotency_key, str) or not idempotency_key.strip():
+            raise ValidationError("idempotency_key must be a non-empty string")
+        for value, name in ((subscription_id, "subscription_id"), (new_plan_id, "new_plan_id")):
+            if not isinstance(value, str) or not value.strip():
+                raise ValidationError(f"{name} must be a non-empty string")
+        # Type-check before fingerprinting so True never matches a stored 1.
+        validate_non_negative_int(days_remaining, "days_remaining")
+        validate_positive_int(cycle_days, "cycle_days")
+
+        fingerprint = ("plan_upgrade", subscription_id, new_plan_id, days_remaining, cycle_days)
+        # Checked before plan comparison: after a successful upgrade the replay is no longer an upgrade.
+        existing = self.ledger.find_idempotent_entry(idempotency_key, fingerprint)
+        if existing is not None:
+            return existing
+
+        sub = self.ledger.get_subscription(subscription_id)
+        old_plan = self.ledger.get_plan(sub.plan_id)
+        new_plan = self.ledger.get_plan(new_plan_id)
+        subtotal, tax, total = calculate_upgrade_totals(old_plan, new_plan, days_remaining, cycle_days)
+
+        entry = LedgerEntry(
+            entry_id=self.ledger.next_id("ent"),
+            account_id=sub.account_id,
+            kind="plan_upgrade",
+            subtotal_cents=subtotal,
+            tax_cents=tax,
+            total_cents=total,
+            reference_id=subscription_id,
+            reason=f"upgrade {old_plan.plan_id} -> {new_plan.plan_id}",
+            metadata={
+                "old_plan_id": old_plan.plan_id,
+                "new_plan_id": new_plan.plan_id,
+                "days_remaining": days_remaining,
+                "cycle_days": cycle_days,
+                "idempotency_key": idempotency_key,
+            },
+        )
+        self.ledger.record_idempotent_entry(idempotency_key, fingerprint, entry)
+        sub.plan_id = new_plan.plan_id
+        return entry
