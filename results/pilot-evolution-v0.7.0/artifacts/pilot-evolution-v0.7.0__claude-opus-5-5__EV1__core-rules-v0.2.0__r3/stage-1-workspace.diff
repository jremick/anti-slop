+    def find_idempotent_entry(self, idempotency_key: str, fingerprint: tuple) -> Optional[LedgerEntry]:
+        """Return the entry previously recorded under this key, or None if the key is unused.
+
+        Raises ValidationError if the key was used for a request with a different fingerprint.
+        """
+        stored = self._idempotency.get(idempotency_key)
+        if stored is None:
+            return None
+        stored_fingerprint, entry_id = stored
+        if stored_fingerprint != fingerprint:
+            raise ValidationError(f"idempotency_key {idempotency_key!r} was already used with different arguments")
+        return self._entries[entry_id]
+
