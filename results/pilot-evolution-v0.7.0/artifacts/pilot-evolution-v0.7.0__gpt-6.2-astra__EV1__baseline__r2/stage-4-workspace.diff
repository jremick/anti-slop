+import unittest
+
+from ev1_order_ledger import LineItem, OrderService, ValidationError
+
+
+class RefundTests(unittest.TestCase):
+    def setUp(self):
+        self.service = OrderService()
+        self.order = self.service.place_order("acct", [LineItem("item", 5, 1)], tax_bps=2000)
+
+    def refund(self, amount, key, reason="return"):
+        return self.service.refund_order(
+            self.order.order_id, amount, reason=reason, idempotency_key=key
+        )
+
+    def test_cumulative_rounding_across_different_partitions(self):
+        # A six-cent charge includes one cent of tax. The third refunded penny
+        # reaches a cumulative tax share of exactly half a cent.
+        for amounts in [(1,) * 6, (2, 3, 1), (5, 1), (6,)]:
+            with self.subTest(amounts=amounts):
+                order = self.service.place_order("acct", self.order.items, tax_bps=2000)
+                refunded = tax = subtotal = 0
+                for index, amount in enumerate(amounts):
+                    entry = self.service.refund_order(
+                        order.order_id, amount, reason="return", idempotency_key=f"{order.order_id}-{index}"
+                    )
+                    self.assertEqual(entry.kind, "order_refund")
+                    self.assertEqual(entry.total_cents, -amount)
+                    self.assertEqual(entry.subtotal_cents + entry.tax_cents, -amount)
+                    refunded += amount
+                    tax -= entry.tax_cents
+                    subtotal -= entry.subtotal_cents
+                    self.assertEqual(tax, int(refunded >= 3))
+                self.assertEqual((subtotal, tax), (order.subtotal_cents, order.tax_cents))
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], self.order.total_cents)
+
+    def test_over_refund_does_not_consume_key_or_remaining_balance(self):
+        self.refund(4, "first")
+        with self.assertRaises(ValidationError):
+            self.refund(3, "last")
+        self.refund(2, "last")
+        with self.assertRaises(ValidationError):
+            self.refund(1, "extra")
+        self.assertEqual(self.service.get_statement("acct")["entry_count"], 3)
+
+    def test_replay_and_conflicts_across_services(self):
+        original = self.refund(1, "first")
+        self.refund(5, "rest")
+        peer = OrderService(self.service.ledger)
+        other = peer.place_order("acct", self.order.items)
+        for order_id, amount, reason in [
+            (other.order_id, 1, "return"), (self.order.order_id, 2, "return"),
+            (self.order.order_id, 1, "changed"), (self.order.order_id, True, "return"),
+        ]:
+            with self.subTest(order_id=order_id, amount=amount, reason=reason), self.assertRaises(ValidationError):
+                peer.refund_order(order_id, amount, reason=reason, idempotency_key="first")
+        self.assertIs(peer.refund_order(self.order.order_id, 1, reason="return", idempotency_key="first"), original)
+        self.assertEqual(peer.get_statement("acct")["entry_count"], 4)
+
+    def test_credit_note_uses_positive_amounts_and_refund_reference(self):
+        entry = self.refund(4, "partial", "damaged")
+        self.assertEqual(self.service.export_credit_note(entry.entry_id), {
+            "entry_id": entry.entry_id, "order_id": self.order.order_id, "account_id": "acct",
+            "subtotal_cents": 3, "tax_cents": 1, "total_cents": 4, "reason": "damaged",
+        })
+        charge = self.service.ledger.entries_for_account("acct")[0]
+        for invalid in [charge.entry_id, self.order.order_id, "missing"]:
+            with self.subTest(invalid=invalid), self.assertRaises(ValidationError):
+                self.service.export_credit_note(invalid)
+
+    def test_invalid_inputs_do_not_record_refunds(self):
+        for amount, key, reason in [(0, "k", "r"), (-1, "k", "r"), (1.5, "k", "r"),
+                                    (1, " ", "r"), (1, "k", ""), (1, "k", None)]:
+            with self.subTest(amount=amount, key=key, reason=reason), self.assertRaises(ValidationError):
+                self.refund(amount, key, reason)
+        with self.assertRaises(ValidationError):
+            self.service.refund_order("missing", 1, reason="r", idempotency_key="k")
+        self.assertEqual(self.service.get_statement("acct")["entry_count"], 1)

