{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc 'cd benchmarks/sources/ev1_order_ledger && cat pricing.py api.py ledger.py models.py __init__.py'","aggregated_output":"\"\"\"Canonical integer-cent pricing calculations for EV1 order ledger.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Sequence, Tuple\n\nfrom .models import LineItem, Plan, ValidationError\n\n\nLEGACY_FLAT_FEE_CENTS = 500\n\n\ndef validate_non_negative_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value < 0:\n        raise ValidationError(f\"{field_name} must be a non-negative integer\")\n    return value\n\n\ndef validate_positive_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:\n        raise ValidationError(f\"{field_name} must be a positive integer\")\n    return value\n\n\ndef round_half_up_div(numerator: int, denominator: int) -> int:\n    \"\"\"Exact integer half-up division for non-negative numerator and positive denominator.\"\"\"\n    validate_non_negative_int(numerator, \"numerator\")\n    validate_positive_int(denominator, \"denominator\")\n    return (numerator * 2 + denominator) // (2 * denominator)\n\n\ndef compute_subtotal_cents(items: Sequence[LineItem]) -> int:\n    if not items:\n        raise ValidationError(\"items must be non-empty\")\n    subtotal = 0\n    for item in items:\n        validate_positive_int(item.unit_cents, \"unit_cents\")\n        validate_positive_int(item.quantity, \"quantity\")\n        subtotal += item.unit_cents * item.quantity\n    return subtotal\n\n\ndef compute_tax_cents(taxable_cents: int, tax_bps: int) -> int:\n    validate_non_negative_int(taxable_cents, \"taxable_cents\")\n    validate_non_negative_int(tax_bps, \"tax_bps\")\n    if tax_bps > 10_000:\n        raise ValidationError(\"tax_bps cannot exceed 10000\")\n    return round_half_up_div(taxable_cents * tax_bps, 10_000)\n\n\ndef calculate_order_totals(\n    items: Sequence[LineItem],\n    *,\n    tax_bps: int = 0,\n    legacy_flat_fee: bool = False,\n) -> Tuple[int, int, int]:\n    \"\"\"Return (subtotal_cents, tax_cents, total_cents) using exact integer cents.\"\"\"\n    subtotal = compute_subtotal_cents(items)\n    if legacy_flat_fee:\n        subtotal += LEGACY_FLAT_FEE_CENTS\n    tax = compute_tax_cents(subtotal, tax_bps)\n    return subtotal, tax, subtotal + tax\n\n\ndef calculate_upgrade_totals(\n    old_plan: Plan, new_plan: Plan, days_remaining: int, cycle_days: int\n) -> Tuple[int, int, int]:\n    validate_positive_int(cycle_days, \"cycle_days\")\n    validate_non_negative_int(days_remaining, \"days_remaining\")\n    if days_remaining > cycle_days:\n        raise ValidationError(\"days_remaining cannot exceed cycle_days\")\n    increase = new_plan.monthly_cents - old_plan.monthly_cents\n    if increase <= 0:\n        raise ValidationError(\"new plan must have a higher monthly price\")\n    subtotal = round_half_up_div(increase * days_remaining, cycle_days)\n    tax = compute_tax_cents(subtotal, new_plan.tax_bps)\n    return subtotal, tax, subtotal + tax\n\"\"\"Service facade coordinating pricing and ledger persistence for EV1.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Dict, Sequence\n\nfrom .ledger import OrderLedger\nfrom .models import LedgerEntry, LineItem, Order, Plan, Subscription, ValidationError\nfrom .pricing import calculate_order_totals\n\n\nclass OrderService:\n    def __init__(self, ledger: OrderLedger | None = None) -> None:\n        self.ledger = ledger if ledger is not None else OrderLedger()\n\n    def register_plan(self, plan: Plan) -> None:\n        self.ledger.add_plan(plan)\n\n    def place_order(\n        self,\n        account_id: str,\n        items: Sequence[LineItem],\n        *,\n        tax_bps: int = 0,\n        legacy_flat_fee: bool = False,\n    ) -> Order:\n        if not account_id.strip():\n            raise ValidationError(\"account_id must be non-empty\")\n        subtotal, tax, total = calculate_order_totals(\n            items,\n            tax_bps=tax_bps,\n            legacy_flat_fee=legacy_flat_fee,\n        )\n        order_id = self.ledger.next_id(\"ord\")\n        order = Order(\n            order_id=order_id,\n            account_id=account_id,\n            items=tuple(items),\n            subtotal_cents=subtotal,\n            tax_cents=tax,\n            total_cents=total,\n        )\n        self.ledger.save_order(order)\n        entry = LedgerEntry(\n            entry_id=self.ledger.next_id(\"ent\"),\n            account_id=account_id,\n            kind=\"order_charge\",\n            subtotal_cents=subtotal,\n            tax_cents=tax,\n            total_cents=total,\n            reference_id=order_id,\n        )\n        self.ledger.record_entry(entry)\n        return order\n\n    def start_subscription(self, account_id: str, plan_id: str) -> Subscription:\n        if not account_id.strip():\n            raise ValidationError(\"account_id must be non-empty\")\n        self.ledger.get_plan(plan_id)\n        sub = Subscription(\n            subscription_id=self.ledger.next_id(\"sub\"),\n            account_id=account_id,\n            plan_id=plan_id,\n        )\n        self.ledger.save_subscription(sub)\n        return sub\n\n    def upgrade_subscription(\n        self,\n        subscription_id: str,\n        new_plan_id: str,\n        days_remaining: int,\n        cycle_days: int,\n        *,\n        idempotency_key: str,\n    ) -> LedgerEntry:\n        return self.ledger.upgrade_subscription(\n            subscription_id, new_plan_id, days_remaining, cycle_days,\n            idempotency_key=idempotency_key,\n        )\n\n    def get_statement(self, account_id: str) -> Dict[str, object]:\n        entries = self.ledger.entries_for_account(account_id)\n        return {\n            \"account_id\": account_id,\n            \"balance_cents\": self.ledger.account_balance_cents(account_id),\n            \"entry_count\": len(entries),\n        }\n\"\"\"In-memory order, subscription, and ledger store for EV1.\"\"\"\n\nfrom __future__ import annotations\n\nfrom threading import Lock\nfrom typing import Dict, List, Optional\n\nfrom .models import LedgerEntry, Order, Plan, Subscription, ValidationError\nfrom .pricing import calculate_upgrade_totals\n\n\nclass OrderLedger:\n    def __init__(self) -> None:\n        self._plans: Dict[str, Plan] = {}\n        self._orders: Dict[str, Order] = {}\n        self._subscriptions: Dict[str, Subscription] = {}\n        self._entries: Dict[str, LedgerEntry] = {}\n        self._entry_order: List[str] = []\n        self._upgrade_lock = Lock()\n        self._upgrades: Dict[str, tuple[tuple[str, str, int, int], LedgerEntry]] = {}\n        self._seq = 0\n\n    def next_id(self, prefix: str) -> str:\n        self._seq += 1\n        return f\"{prefix}_{self._seq:04d}\"\n\n    def add_plan(self, plan: Plan) -> None:\n        if not plan.plan_id.strip():\n            raise ValidationError(\"plan_id must be non-empty\")\n        if isinstance(plan.monthly_cents, bool) or not isinstance(plan.monthly_cents, int) or plan.monthly_cents < 0:\n            raise ValidationError(\"monthly_cents must be a non-negative integer\")\n        self._plans[plan.plan_id] = plan\n\n    def get_plan(self, plan_id: str) -> Plan:\n        plan = self._plans.get(plan_id)\n        if plan is None:\n            raise ValidationError(f\"Unknown plan_id: {plan_id}\")\n        return plan\n\n    def save_order(self, order: Order) -> None:\n        self._orders[order.order_id] = order\n\n    def get_order(self, order_id: str) -> Order:\n        order = self._orders.get(order_id)\n        if order is None:\n            raise ValidationError(f\"Unknown order_id: {order_id}\")\n        return order\n\n    def save_subscription(self, sub: Subscription) -> None:\n        self._subscriptions[sub.subscription_id] = sub\n\n    def get_subscription(self, subscription_id: str) -> Subscription:\n        sub = self._subscriptions.get(subscription_id)\n        if sub is None:\n            raise ValidationError(f\"Unknown subscription_id: {subscription_id}\")\n        return sub\n\n    def upgrade_subscription(\n        self,\n        subscription_id: str,\n        new_plan_id: str,\n        days_remaining: int,\n        cycle_days: int,\n        *,\n        idempotency_key: str,\n    ) -> LedgerEntry:\n        if not isinstance(idempotency_key, str) or not idempotency_key.strip():\n            raise ValidationError(\"idempotency_key must be a non-empty string\")\n        if not isinstance(subscription_id, str) or not isinstance(new_plan_id, str):\n            raise ValidationError(\"subscription_id and new_plan_id must be strings\")\n        # Reject numeric lookalikes before comparing requests (True == 1 == 1.0).\n        for days in (days_remaining, cycle_days):\n            if isinstance(days, bool) or not isinstance(days, int):\n                raise ValidationError(\"day counts must be integers\")\n\n        request = (subscription_id, new_plan_id, days_remaining, cycle_days)\n        with self._upgrade_lock:\n            previous = self._upgrades.get(idempotency_key)\n            if previous is not None:\n                previous_request, entry = previous\n                if previous_request != request:\n                    raise ValidationError(\"idempotency_key already used for another upgrade\")\n                return entry\n\n            sub = self.get_subscription(subscription_id)\n            old_plan = self.get_plan(sub.plan_id)\n            new_plan = self.get_plan(new_plan_id)\n            subtotal, tax, total = calculate_upgrade_totals(\n                old_plan, new_plan, days_remaining, cycle_days\n            )\n            entry = LedgerEntry(\n                entry_id=self.next_id(\"ent\"),\n                account_id=sub.account_id,\n                kind=\"plan_upgrade\",\n                subtotal_cents=subtotal,\n                tax_cents=tax,\n                total_cents=total,\n                reference_id=subscription_id,\n            )\n            self.record_entry(entry)\n            sub.plan_id = new_plan_id\n            self._upgrades[idempotency_key] = (request, entry)\n            return entry\n\n    def record_entry(self, entry: LedgerEntry) -> None:\n        self._entries[entry.entry_id] = entry\n        self._entry_order.append(entry.entry_id)\n\n    def get_entry(self, entry_id: str) -> Optional[LedgerEntry]:\n        return self._entries.get(entry_id)\n\n    def entries_for_account(self, account_id: str) -> List[LedgerEntry]:\n        return [\n            self._entries[eid]\n            for eid in self._entry_order\n            if self._entries[eid].account_id == account_id\n        ]\n\n    def account_balance_cents(self, account_id: str) -> int:\n        return sum(e.total_cents for e in self.entries_for_account(account_id))\n\"\"\"Core domain models for the EV1 order ledger fixture.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import Tuple\n\n\nclass BillingError(Exception):\n    \"\"\"Base error for billing domain failures.\"\"\"\n\n\nclass ValidationError(BillingError):\n    \"\"\"Raised when input arguments or business invariants are violated.\"\"\"\n\n\n@dataclass(frozen=True)\nclass Plan:\n    plan_id: str\n    name: str\n    monthly_cents: int\n    tax_bps: int = 0\n\n\n@dataclass(frozen=True)\nclass LineItem:\n    sku: str\n    unit_cents: int\n    quantity: int\n\n\n@dataclass(frozen=True)\nclass Order:\n    order_id: str\n    account_id: str\n    items: Tuple[LineItem, ...]\n    subtotal_cents: int\n    tax_cents: int\n    total_cents: int\n    discount_cents: int = 0\n    promo_code: str | None = None\n\n\n@dataclass\nclass Subscription:\n    subscription_id: str\n    account_id: str\n    plan_id: str\n    status: str = \"active\"\n\n\n@dataclass(frozen=True)\nclass LedgerEntry:\n    entry_id: str\n    account_id: str\n    kind: str\n    subtotal_cents: int\n    tax_cents: int\n    total_cents: int\n    reference_id: str\n    reason: str = \"\"\n    metadata: dict = field(default_factory=dict)\n\"\"\"EV1 multi-turn evolution fixture: order and subscription billing ledger.\"\"\"\n\nfrom .api import OrderService\nfrom .ledger import OrderLedger\nfrom .models import BillingError, LedgerEntry, LineItem, Order, Plan, Subscription, ValidationError\n\n__all__ = [\n    \"BillingError\",\n    \"LedgerEntry\",\n    \"LineItem\",\n    \"Order\",\n    \"OrderLedger\",\n    \"OrderService\",\n    \"Plan\",\n    \"Subscription\",\n    \"ValidationError\",\n]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"cd benchmarks/sources/ev1_order_ledger && python3 - <<'PY'\nfrom pathlib import Path\np=Path('models.py')\np.write_text(p.read_text().replace('@dataclass(frozen=True)\\\\nclass LineItem:', '''@dataclass(frozen=True)\nclass Promo:\n    code: str\n    percent_off: int | None\n    amount_off_cents: int | None\n    expires_on: str | None\n    min_subtotal_cents: int\n\n\n@dataclass(frozen=True)\nclass LineItem:'''))\np=Path('pricing.py')\ns=p.read_text().replace('from typing import', 'from datetime import date\\\\nfrom typing import').replace('Plan, ValidationError','Plan, Promo, ValidationError')\nstart=s.index('def calculate_order_totals')\nend=s.index('def calculate_upgrade_totals')\nsection='''def validate_date(value: str, field_name: str) -> None:\n    if isinstance(value, str):\n        try:\n            if date.fromisoformat(value).isoformat() == value:\n                return\n        except ValueError:\n            pass\n    raise ValidationError(f\\\"{field_name} must be a valid YYYY-MM-DD date\\\")\n\n\ndef validate_promo(promo: Promo) -> None:\n    if not isinstance(promo.code, str) or not promo.code.strip() or \\\",\\\" in promo.code:\n        raise ValidationError(\\\"code must be a single non-empty promo code\\\")\n    if (promo.percent_off is None) == (promo.amount_off_cents is None):\n        raise ValidationError(\\\"supply exactly one discount\\\")\n    if promo.percent_off is not None:\n        validate_positive_int(promo.percent_off, \\\"percent_off\\\")\n        if promo.percent_off > 100:\n            raise ValidationError(\\\"percent_off cannot exceed 100\\\")\n    else:\n        validate_positive_int(promo.amount_off_cents, \\\"amount_off_cents\\\")\n    validate_non_negative_int(promo.min_subtotal_cents, \\\"min_subtotal_cents\\\")\n    if promo.expires_on is not None:\n        validate_date(promo.expires_on, \\\"expires_on\\\")\n\n\ndef calculate_charge_totals(\n    subtotal: int, tax_bps: int, promo: Promo | None = None, as_of: str | None = None\n) -> Tuple[int, int, int]:\n    \\\"\\\"\\\"Return discounted subtotal, tax on that subtotal, and total, all in cents.\\\"\\\"\\\"\n    if as_of is not None:\n        validate_date(as_of, \\\"as_of\\\")\n    if promo is not None:\n        if promo.expires_on is not None and (as_of is None or as_of > promo.expires_on):\n            raise ValidationError(\\\"expiring promo requires as_of on or before expires_on\\\")\n        if subtotal < promo.min_subtotal_cents:\n            raise ValidationError(\\\"subtotal is below the promo minimum\\\")\n        if promo.percent_off is not None:\n            discount = round_half_up_div(subtotal * promo.percent_off, 100)\n        else:\n            discount = promo.amount_off_cents\n        subtotal = max(0, subtotal - discount)\n    tax = compute_tax_cents(subtotal, tax_bps)\n    return subtotal, tax, subtotal + tax\n\n\ndef compute_order_subtotal(items: Sequence[LineItem], legacy_flat_fee: bool) -> int:\n    subtotal = compute_subtotal_cents(items)\n    return subtotal + LEGACY_FLAT_FEE_CENTS if legacy_flat_fee else subtotal\n\n\ndef calculate_order_totals(\n    items: Sequence[LineItem],\n    *,\n    tax_bps: int = 0,\n    legacy_flat_fee: bool = False,\n) -> Tuple[int, int, int]:\n    return calculate_charge_totals(compute_order_subtotal(items, legacy_flat_fee), tax_bps)\n\n\n'''\ns=s[:start]+section+s[end:]\ns=s.replace('cycle_days: int\\\\n)', 'cycle_days: int,\\\\n    *, promo: Promo | None = None, as_of: str | None = None,\\\\n)').replace('    tax = compute_tax_cents(subtotal, new_plan.tax_bps)\\\\n    return subtotal, tax, subtotal + tax','    return calculate_charge_totals(subtotal, new_plan.tax_bps, promo, as_of)')\np.write_text(s)\np=Path('api.py')\ns=p.read_text().replace('Plan, Subscription','Plan, Promo, Subscription').replace('import calculate_order_totals','import calculate_charge_totals, compute_order_subtotal')\ns=s.replace('    def place_order(','''    def register_promo(\n        self,\n        code: str,\n        *,\n        percent_off: int | None = None,\n        amount_off_cents: int | None = None,\n        expires_on: str | None = None,\n        min_subtotal_cents: int = 0,\n    ) -> None:\n        self.ledger.add_promo(Promo(code, percent_off, amount_off_cents, expires_on, min_subtotal_cents))\n\n    def place_order(''')\nparams='        promo_code: str | None = None,\\\\n        as_of: str | None = None,\\\\n'\ns=s.replace('    ) -> Order:',params+'    ) -> Order:').replace('    ) -> LedgerEntry:',params+'    ) -> LedgerEntry:')\ns=s.replace('subtotal, tax, total = calculate_order_totals(\\\\n            items,\\\\n            tax_bps=tax_bps,\\\\n            legacy_flat_fee=legacy_flat_fee,','gross_subtotal = compute_order_subtotal(items, legacy_flat_fee)\\\\n        subtotal, tax, total = calculate_charge_totals(\\\\n            gross_subtotal, tax_bps, self.ledger.get_promo(promo_code), as_of,')\ns=s.replace('            items=tuple(items),','            items=tuple(items),\\\\n            discount_cents=gross_subtotal - subtotal,\\\\n            promo_code=promo_code,').replace('            idempotency_key=idempotency_key,','            idempotency_key=idempotency_key,\\\\n            promo_code=promo_code,\\\\n            as_of=as_of,')\np.write_text(s)\np=Path('ledger.py')\ns=p.read_text().replace('Plan, Subscription','Plan, Promo, Subscription').replace('import calculate_upgrade_totals','import calculate_upgrade_totals, validate_promo').replace('        self._orders:', '        self._promos: Dict[str, Promo] = {}\\\\n        self._orders:').replace('tuple[str, str, int, int]', 'tuple[str, str, int, int, str | None, str | None]')\ns=s.replace('    def save_order', '''    def add_promo(self, promo: Promo) -> None:\n        validate_promo(promo)\n        self._promos[promo.code] = promo\n\n    def get_promo(self, code: str | None) -> Promo | None:\n        if code is None:\n            return None\n        if not isinstance(code, str) or code not in self._promos:\n            raise ValidationError(f\\\"Unknown promo_code: {code}\\\")\n        return self._promos[code]\n\n    def save_order''').replace('    ) -> LedgerEntry:',params+'    ) -> LedgerEntry:').replace('days_remaining, cycle_days)\\\\n        with','days_remaining, cycle_days, promo_code, as_of)\\\\n        with').replace('old_plan, new_plan, days_remaining, cycle_days\\\\n','old_plan, new_plan, days_remaining, cycle_days,\\\\n                promo=self.get_promo(promo_code), as_of=as_of,\\\\n')\np.write_text(s)\nPY\ncat > tests/test_promos.py <<'PY'\nimport unittest\n\nfrom ev1_order_ledger import LineItem, OrderService, Plan, ValidationError\n\n\nclass PromoTests(unittest.TestCase):\n    def setUp(self):\n        self.service = OrderService()\n        self.items = [LineItem(\\\"seat\\\", 105, 1)]\n\n    def order(self, code, **kwargs):\n        return self.service.place_order(\\\"acct\\\", self.items, promo_code=code, tax_bps=1000, **kwargs)\n\n    def test_percent_rounds_half_up_before_tax(self):\n        self.service.register_promo(\\\"HALF\\\", percent_off=50)\n        order = self.order(\\\"HALF\\\")\n        self.assertEqual((order.discount_cents, order.subtotal_cents, order.tax_cents), (53, 52, 5))\n        self.assertEqual(order.promo_code, \\\"HALF\\\")\n        self.assertEqual(order.total_cents, 57)\n        self.assertEqual(self.service.get_statement(\\\"acct\\\")[\\\"balance_cents\\\"], 57)\n\n    def test_fixed_discount_clamps_to_subtotal(self):\n        self.service.register_promo(\\\"FREE\\\", amount_off_cents=500)\n        order = self.order(\\\"FREE\\\")\n        self.assertEqual((order.discount_cents, order.subtotal_cents, order.total_cents), (105, 0, 0))\n\n    def test_registration_validation(self):\n        for kwargs in [\n            {}, dict(percent_off=0), dict(percent_off=101), dict(percent_off=True),\n            dict(amount_off_cents=0), dict(amount_off_cents=1.5),\n            dict(percent_off=5, amount_off_cents=10), dict(percent_off=5, min_subtotal_cents=-1),\n            dict(percent_off=5, min_subtotal_cents=True), dict(percent_off=5, expires_on=\\\"2025-02-29\\\"),\n        ]:\n            with self.subTest(kwargs=kwargs), self.assertRaises(ValidationError):\n                self.service.register_promo(\\\"P\\\", **kwargs)\n        for code in (\\\"\\\", \\\" \\\", \\\"A,B\\\", None):\n            with self.subTest(code=code), self.assertRaises(ValidationError):\n                self.service.register_promo(code, percent_off=1)\n\n    def test_expiry_unknown_codes_and_stacking(self):\n        self.service.register_promo(\\\"A\\\", percent_off=10, expires_on=\\\"2024-02-29\\\")\n        self.service.register_promo(\\\"B\\\", amount_off_cents=9)\n        for code, day in [\n            (\\\"A,B\\\", \\\"2024-02-29\\\"), (\\\"unknown\\\", None), (\\\"A\\\", None), (\\\"A\\\", \\\"2024-03-01\\\"),\n            (\\\"A\\\", \\\"20240228\\\"), (\\\"A\\\", \\\"2024-02-30\\\"),\n        ]:\n            with self.subTest(code=code, day=day), self.assertRaises(ValidationError):\n                self.order(code, as_of=day)\n        self.assertEqual(self.service.get_statement(\\\"acct\\\")[\\\"entry_count\\\"], 0)\n        self.assertEqual(self.order(\\\"A\\\", as_of=\\\"2024-02-29\\\").discount_cents, 11)\n\n    def test_minimum_compares_subtotal_including_flat_fee_before_discount(self):\n        self.service.register_promo(\\\"MIN\\\", amount_off_cents=50, min_subtotal_cents=605)\n        with self.assertRaises(ValidationError):\n            self.order(\\\"MIN\\\")\n        order = self.order(\\\"MIN\\\", legacy_flat_fee=True)\n        self.assertEqual((order.subtotal_cents, order.tax_cents), (555, 56))\n\n    def test_upgrade_applies_promo_to_proration_and_replays_once(self):\n        self.service.register_plan(Plan(\\\"old\\\", \\\"Old\\\", 100))\n        self.service.register_plan(Plan(\\\"