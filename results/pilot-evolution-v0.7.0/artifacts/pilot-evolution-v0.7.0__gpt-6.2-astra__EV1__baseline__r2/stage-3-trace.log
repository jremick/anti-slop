{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc 'cd benchmarks/sources/ev1_order_ledger && cat ledger.py api.py pricing.py'","aggregated_output":"\"\"\"In-memory order, subscription, and ledger store for EV1.\"\"\"\n\nfrom __future__ import annotations\n\nfrom threading import Lock\nfrom typing import Dict, List, Optional\n\nfrom .models import LedgerEntry, Order, Plan, Promo, Subscription, ValidationError\nfrom .pricing import calculate_upgrade_totals, validate_promo\n\n\nclass OrderLedger:\n    def __init__(self) -> None:\n        self._plans: Dict[str, Plan] = {}\n        self._promos: Dict[str, Promo] = {}\n        self._orders: Dict[str, Order] = {}\n        self._subscriptions: Dict[str, Subscription] = {}\n        self._entries: Dict[str, LedgerEntry] = {}\n        self._entry_order: List[str] = []\n        self._upgrade_lock = Lock()\n        self._upgrades: Dict[str, tuple[tuple[str, str, int, int, str | None, str | None], LedgerEntry]] = {}\n        self._seq = 0\n\n    def next_id(self, prefix: str) -> str:\n        self._seq += 1\n        return f\"{prefix}_{self._seq:04d}\"\n\n    def add_plan(self, plan: Plan) -> None:\n        if not plan.plan_id.strip():\n            raise ValidationError(\"plan_id must be non-empty\")\n        if isinstance(plan.monthly_cents, bool) or not isinstance(plan.monthly_cents, int) or plan.monthly_cents < 0:\n            raise ValidationError(\"monthly_cents must be a non-negative integer\")\n        self._plans[plan.plan_id] = plan\n\n    def get_plan(self, plan_id: str) -> Plan:\n        plan = self._plans.get(plan_id)\n        if plan is None:\n            raise ValidationError(f\"Unknown plan_id: {plan_id}\")\n        return plan\n\n    def add_promo(self, promo: Promo) -> None:\n        validate_promo(promo)\n        self._promos[promo.code] = promo\n\n    def get_promo(self, code: str | None) -> Promo | None:\n        if code is None:\n            return None\n        if not isinstance(code, str) or code not in self._promos:\n            raise ValidationError(f\"Unknown promo_code: {code}\")\n        return self._promos[code]\n\n    def save_order(self, order: Order) -> None:\n        self._orders[order.order_id] = order\n\n    def get_order(self, order_id: str) -> Order:\n        order = self._orders.get(order_id)\n        if order is None:\n            raise ValidationError(f\"Unknown order_id: {order_id}\")\n        return order\n\n    def save_subscription(self, sub: Subscription) -> None:\n        self._subscriptions[sub.subscription_id] = sub\n\n    def get_subscription(self, subscription_id: str) -> Subscription:\n        sub = self._subscriptions.get(subscription_id)\n        if sub is None:\n            raise ValidationError(f\"Unknown subscription_id: {subscription_id}\")\n        return sub\n\n    def upgrade_subscription(\n        self,\n        subscription_id: str,\n        new_plan_id: str,\n        days_remaining: int,\n        cycle_days: int,\n        *,\n        idempotency_key: str,\n        promo_code: str | None = None,\n        as_of: str | None = None,\n    ) -> LedgerEntry:\n        if not isinstance(idempotency_key, str) or not idempotency_key.strip():\n            raise ValidationError(\"idempotency_key must be a non-empty string\")\n        if not isinstance(subscription_id, str) or not isinstance(new_plan_id, str):\n            raise ValidationError(\"subscription_id and new_plan_id must be strings\")\n        # Reject numeric lookalikes before comparing requests (True == 1 == 1.0).\n        for days in (days_remaining, cycle_days):\n            if isinstance(days, bool) or not isinstance(days, int):\n                raise ValidationError(\"day counts must be integers\")\n\n        request = (subscription_id, new_plan_id, days_remaining, cycle_days, promo_code, as_of)\n        with self._upgrade_lock:\n            previous = self._upgrades.get(idempotency_key)\n            if previous is not None:\n                previous_request, entry = previous\n                if previous_request != request:\n                    raise ValidationError(\"idempotency_key already used for another upgrade\")\n                return entry\n\n            sub = self.get_subscription(subscription_id)\n            old_plan = self.get_plan(sub.plan_id)\n            new_plan = self.get_plan(new_plan_id)\n            subtotal, tax, total = calculate_upgrade_totals(\n                old_plan, new_plan, days_remaining, cycle_days,\n                promo=self.get_promo(promo_code), as_of=as_of,\n            )\n            entry = LedgerEntry(\n                entry_id=self.next_id(\"ent\"),\n                account_id=sub.account_id,\n                kind=\"plan_upgrade\",\n                subtotal_cents=subtotal,\n                tax_cents=tax,\n                total_cents=total,\n                reference_id=subscription_id,\n            )\n            self.record_entry(entry)\n            sub.plan_id = new_plan_id\n            self._upgrades[idempotency_key] = (request, entry)\n            return entry\n\n    def record_entry(self, entry: LedgerEntry) -> None:\n        self._entries[entry.entry_id] = entry\n        self._entry_order.append(entry.entry_id)\n\n    def get_entry(self, entry_id: str) -> Optional[LedgerEntry]:\n        return self._entries.get(entry_id)\n\n    def entries_for_account(self, account_id: str) -> List[LedgerEntry]:\n        return [\n            self._entries[eid]\n            for eid in self._entry_order\n            if self._entries[eid].account_id == account_id\n        ]\n\n    def account_balance_cents(self, account_id: str) -> int:\n        return sum(e.total_cents for e in self.entries_for_account(account_id))\n\"\"\"Service facade coordinating pricing and ledger persistence for EV1.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Dict, Sequence\n\nfrom .ledger import OrderLedger\nfrom .models import LedgerEntry, LineItem, Order, Plan, Promo, Subscription, ValidationError\nfrom .pricing import calculate_charge_totals, compute_order_subtotal\n\n\nclass OrderService:\n    def __init__(self, ledger: OrderLedger | None = None) -> None:\n        self.ledger = ledger if ledger is not None else OrderLedger()\n\n    def register_plan(self, plan: Plan) -> None:\n        self.ledger.add_plan(plan)\n\n    def register_promo(\n        self,\n        code: str,\n        *,\n        percent_off: int | None = None,\n        amount_off_cents: int | None = None,\n        expires_on: str | None = None,\n        min_subtotal_cents: int = 0,\n    ) -> None:\n        self.ledger.add_promo(Promo(code, percent_off, amount_off_cents, expires_on, min_subtotal_cents))\n\n    def place_order(\n        self,\n        account_id: str,\n        items: Sequence[LineItem],\n        *,\n        tax_bps: int = 0,\n        legacy_flat_fee: bool = False,\n        promo_code: str | None = None,\n        as_of: str | None = None,\n    ) -> Order:\n        if not account_id.strip():\n            raise ValidationError(\"account_id must be non-empty\")\n        gross_subtotal = compute_order_subtotal(items, legacy_flat_fee)\n        subtotal, tax, total = calculate_charge_totals(\n            gross_subtotal, tax_bps, self.ledger.get_promo(promo_code), as_of,\n        )\n        order_id = self.ledger.next_id(\"ord\")\n        order = Order(\n            order_id=order_id,\n            account_id=account_id,\n            items=tuple(items),\n            discount_cents=gross_subtotal - subtotal,\n            promo_code=promo_code,\n            subtotal_cents=subtotal,\n            tax_cents=tax,\n            total_cents=total,\n        )\n        self.ledger.save_order(order)\n        entry = LedgerEntry(\n            entry_id=self.ledger.next_id(\"ent\"),\n            account_id=account_id,\n            kind=\"order_charge\",\n            subtotal_cents=subtotal,\n            tax_cents=tax,\n            total_cents=total,\n            reference_id=order_id,\n        )\n        self.ledger.record_entry(entry)\n        return order\n\n    def start_subscription(self, account_id: str, plan_id: str) -> Subscription:\n        if not account_id.strip():\n            raise ValidationError(\"account_id must be non-empty\")\n        self.ledger.get_plan(plan_id)\n        sub = Subscription(\n            subscription_id=self.ledger.next_id(\"sub\"),\n            account_id=account_id,\n            plan_id=plan_id,\n        )\n        self.ledger.save_subscription(sub)\n        return sub\n\n    def upgrade_subscription(\n        self,\n        subscription_id: str,\n        new_plan_id: str,\n        days_remaining: int,\n        cycle_days: int,\n        *,\n        idempotency_key: str,\n        promo_code: str | None = None,\n        as_of: str | None = None,\n    ) -> LedgerEntry:\n        return self.ledger.upgrade_subscription(\n            subscription_id, new_plan_id, days_remaining, cycle_days,\n            idempotency_key=idempotency_key,\n            promo_code=promo_code,\n            as_of=as_of,\n        )\n\n    def get_statement(self, account_id: str) -> Dict[str, object]:\n        entries = self.ledger.entries_for_account(account_id)\n        return {\n            \"account_id\": account_id,\n            \"balance_cents\": self.ledger.account_balance_cents(account_id),\n            \"entry_count\": len(entries),\n        }\n\"\"\"Canonical integer-cent pricing calculations for EV1 order ledger.\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import date\nfrom typing import Sequence, Tuple\n\nfrom .models import LineItem, Plan, Promo, ValidationError\n\n\nLEGACY_FLAT_FEE_CENTS = 500\n\n\ndef validate_non_negative_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value < 0:\n        raise ValidationError(f\"{field_name} must be a non-negative integer\")\n    return value\n\n\ndef validate_positive_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:\n        raise ValidationError(f\"{field_name} must be a positive integer\")\n    return value\n\n\ndef round_half_up_div(numerator: int, denominator: int) -> int:\n    \"\"\"Exact integer half-up division for non-negative numerator and positive denominator.\"\"\"\n    validate_non_negative_int(numerator, \"numerator\")\n    validate_positive_int(denominator, \"denominator\")\n    return (numerator * 2 + denominator) // (2 * denominator)\n\n\ndef compute_subtotal_cents(items: Sequence[LineItem]) -> int:\n    if not items:\n        raise ValidationError(\"items must be non-empty\")\n    subtotal = 0\n    for item in items:\n        validate_positive_int(item.unit_cents, \"unit_cents\")\n        validate_positive_int(item.quantity, \"quantity\")\n        subtotal += item.unit_cents * item.quantity\n    return subtotal\n\n\ndef compute_tax_cents(taxable_cents: int, tax_bps: int) -> int:\n    validate_non_negative_int(taxable_cents, \"taxable_cents\")\n    validate_non_negative_int(tax_bps, \"tax_bps\")\n    if tax_bps > 10_000:\n        raise ValidationError(\"tax_bps cannot exceed 10000\")\n    return round_half_up_div(taxable_cents * tax_bps, 10_000)\n\n\ndef validate_date(value: str, field_name: str) -> None:\n    if isinstance(value, str):\n        try:\n            if date.fromisoformat(value).isoformat() == value:\n                return\n        except ValueError:\n            pass\n    raise ValidationError(f\"{field_name} must be a valid YYYY-MM-DD date\")\n\n\ndef validate_promo(promo: Promo) -> None:\n    if not isinstance(promo.code, str) or not promo.code.strip() or \",\" in promo.code:\n        raise ValidationError(\"code must be a single non-empty promo code\")\n    if (promo.percent_off is None) == (promo.amount_off_cents is None):\n        raise ValidationError(\"supply exactly one discount\")\n    if promo.percent_off is not None:\n        validate_positive_int(promo.percent_off, \"percent_off\")\n        if promo.percent_off > 100:\n            raise ValidationError(\"percent_off cannot exceed 100\")\n    else:\n        validate_positive_int(promo.amount_off_cents, \"amount_off_cents\")\n    validate_non_negative_int(promo.min_subtotal_cents, \"min_subtotal_cents\")\n    if promo.expires_on is not None:\n        validate_date(promo.expires_on, \"expires_on\")\n\n\ndef calculate_charge_totals(\n    subtotal: int, tax_bps: int, promo: Promo | None = None, as_of: str | None = None\n) -> Tuple[int, int, int]:\n    \"\"\"Return discounted subtotal, tax on that subtotal, and total, all in cents.\"\"\"\n    if as_of is not None:\n        validate_date(as_of, \"as_of\")\n    if promo is not None:\n        if promo.expires_on is not None and (as_of is None or as_of > promo.expires_on):\n            raise ValidationError(\"expiring promo requires as_of on or before expires_on\")\n        if subtotal < promo.min_subtotal_cents:\n            raise ValidationError(\"subtotal is below the promo minimum\")\n        if promo.percent_off is not None:\n            discount = round_half_up_div(subtotal * promo.percent_off, 100)\n        else:\n            discount = promo.amount_off_cents\n        subtotal = max(0, subtotal - discount)\n    tax = compute_tax_cents(subtotal, tax_bps)\n    return subtotal, tax, subtotal + tax\n\n\ndef compute_order_subtotal(items: Sequence[LineItem], legacy_flat_fee: bool) -> int:\n    subtotal = compute_subtotal_cents(items)\n    return subtotal + LEGACY_FLAT_FEE_CENTS if legacy_flat_fee else subtotal\n\n\ndef calculate_order_totals(\n    items: Sequence[LineItem],\n    *,\n    tax_bps: int = 0,\n    legacy_flat_fee: bool = False,\n) -> Tuple[int, int, int]:\n    return calculate_charge_totals(compute_order_subtotal(items, legacy_flat_fee), tax_bps)\n\n\ndef calculate_upgrade_totals(\n    old_plan: Plan, new_plan: Plan, days_remaining: int, cycle_days: int,\n    *, promo: Promo | None = None, as_of: str | None = None,\n) -> Tuple[int, int, int]:\n    validate_positive_int(cycle_days, \"cycle_days\")\n    validate_non_negative_int(days_remaining, \"days_remaining\")\n    if days_remaining > cycle_days:\n        raise ValidationError(\"days_remaining cannot exceed cycle_days\")\n    increase = new_plan.monthly_cents - old_plan.monthly_cents\n    if increase <= 0:\n        raise ValidationError(\"new plan must have a higher monthly price\")\n    subtotal = round_half_up_div(increase * days_remaining, cycle_days)\n    return calculate_charge_totals(subtotal, new_plan.tax_bps, promo, as_of)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"cd benchmarks/sources/ev1_order_ledger && python3 - <<'PY'\nfrom pathlib import Path\np = Path(\\\"ledger.py\\\")\ns = p.read_text().replace(\\\"calculate_upgrade_totals, validate_promo\\\", \\\"calculate_upgrade_totals, round_half_up_div, validate_positive_int, validate_promo\\\")\ns = s.replace(\\\"self._upgrade_lock\\\", \\\"self._billing_lock\\\").replace(\\\"self._upgrades: Dict[str, tuple[tuple[str, str, int, int, str | None, str | None], LedgerEntry]]\\\", \\\"self._refunded_cents: Dict[str, int] = {}\\\\n        self._requests: Dict[str, tuple[tuple[object, ...], LedgerEntry]]\\\")\nvalidation = '''        if not isinstance(idempotency_key, str) or not idempotency_key.strip():\n            raise ValidationError(\\\"idempotency_key must be a non-empty string\\\")\n'''\ns = s.replace(validation, \\\"\\\")\na = s.index(\\\"            previous = self._upgrades\\\")\nb = s.index(\\\"            sub = \\\", a)\ns = s[:a] + '''            replay = self._replay(idempotency_key, request)\n            if replay is not None:\n                return replay\n\n''' + s[b:]\ns = s.replace(\\\"request = (subscription_id,\\\", 'request = (\\\"plan_upgrade\\\", subscription_id,').replace(\\\"self._upgrades[\\\", \\\"self._requests[\\\")\nsig = '''    def refund_order(\n        self, order_id: str, amount_cents: int, *, reason: str, idempotency_key: str\n    ) -> LedgerEntry:\n'''\ns = s.replace(\\\"    def record_entry\\\", '''    def _replay(self, idempotency_key: str, request: tuple[object, ...]) -> LedgerEntry | None:\n''' + validation + '''        previous = self._requests.get(idempotency_key)\n        if previous is None:\n            return None\n        previous_request, entry = previous\n        if previous_request \"'!= request:\n            raise ValidationError(\"idempotency_key already used for a different request\")\n        return entry\n\n'\"''' + sig + '''        validate_positive_int(amount_cents, \\\"amount_cents\\\")\n        if not isinstance(order_id, str):\n            raise ValidationError(\\\"order_id must be a string\\\")\n        if not isinstance(reason, str) or not reason.strip():\n            raise ValidationError(\\\"reason must be a non-empty string\\\")\n\n        request = (\\\"order_refund\\\", order_id, amount_cents, reason)\n        with self._billing_lock:\n            replay = self._replay(idempotency_key, request)\n            if replay is not None:\n                return replay\n\n            order = self.get_order(order_id)\n            already_refunded = self._refunded_cents.get(order_id, 0)\n            cumulative = already_refunded + amount_cents\n            if cumulative > order.total_cents:\n                raise ValidationError(\\\"refund exceeds the remaining order balance\\\")\n\n            # Consecutive rounded cumulative tax shares telescope to the original tax.\n            prior_tax = round_half_up_div(already_refunded * order.tax_cents, order.total_cents)\n            cumulative_tax = round_half_up_div(cumulative * order.tax_cents, order.total_cents)\n            refund_tax = cumulative_tax - prior_tax\n            entry = LedgerEntry(\n                entry_id=self.next_id(\\\"ent\\\"),\n                account_id=order.account_id,\n                kind=\\\"order_refund\\\",\n                subtotal_cents=-(amount_cents - refund_tax),\n                tax_cents=-refund_tax,\n                total_cents=-amount_cents,\n                reference_id=order_id,\n                reason=reason,\n            )\n            self.record_entry(entry)\n            self._refunded_cents[order_id] = cumulative\n            self._requests[idempotency_key] = (request, entry)\n            return entry\n\n    def record_entry''')\np.write_text(s)\np = Path(\\\"api.py\\\")\np.write_text(p.read_text().replace(\\\"    def get_statement\\\", sig + '''        return self.ledger.refund_order(\n            