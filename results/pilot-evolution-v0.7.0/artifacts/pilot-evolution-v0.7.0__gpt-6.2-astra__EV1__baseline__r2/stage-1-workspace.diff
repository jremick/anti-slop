+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import Plan, ValidationError
+
+
+class SubscriptionUpgradeTests(unittest.TestCase):
+    def setUp(self):
+        self.service = OrderService()
+        self.service.register_plan(Plan("starter", "Starter", 100))
+        self.service.register_plan(Plan("pro", "Pro", 109, tax_bps=1000))
+        self.service.register_plan(Plan("team", "Team", 200))
+        self.sub = self.service.start_subscription("account", "starter")
+
+    def upgrade(self, plan="pro", days=1, cycle=2, key="upgrade"):
+        return self.service.upgrade_subscription(
+            self.sub.subscription_id, plan, days, cycle, idempotency_key=key
+        )
+
+    def test_rounds_proration_then_tax_half_up(self):
+        entry = self.upgrade()  # 4.5 cents rounds to 5, then 0.5 cents tax rounds to 1.
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (5, 1, 6))
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.sub.subscription_id)
+        self.assertEqual(entry.account_id, "account")
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertEqual(self.service.ledger.entries_for_account("account"), [entry])
+
+    def test_endpoints_and_fraction_below_half(self):
+        for days, cycle, expected in [(0, 7, 0), (7, 7, 9), (1, 7, 1)]:
+            with self.subTest(days=days):
+                sub = self.service.start_subscription("account", "starter")
+                entry = self.service.upgrade_subscription(
+                    sub.subscription_id, "pro", days, cycle, idempotency_key=sub.subscription_id
+                )
+                self.assertEqual(entry.subtotal_cents, expected)
+                self.assertEqual(sub.plan_id, "pro")
+
+    def test_large_half_cent_is_exact(self):
+        self.service.register_plan(Plan("large", "Large", 100 + 2**55 + 1))
+        self.assertEqual(self.upgrade("large").subtotal_cents, 2**54 + 1)
+
+    def test_invalid_requests_leave_subscription_ledger_and_key_available(self):
+        self.service.register_plan(Plan("equal", "Equal", 100))
+        self.service.register_plan(Plan("lower", "Lower", 99))
+        self.service.register_plan(Plan("bad_tax", "Bad tax", 110, tax_bps=True))
+        sid = self.sub.subscription_id
+        cases = [
+            (sid, "pro", -1, 2), (sid, "pro", 3, 2), (sid, "pro", 0, 0),
+            (sid, "pro", 0, -1), (sid, "pro", False, 2), (sid, "pro", 1, True),
+            (sid, "pro", 1.0, 2), ("missing", "pro", 1, 2), (False, "pro", 1, 2),
+        ]
+        cases.extend((sid, plan, 1, 2) for plan in ("starter", "equal", "lower", "missing", "bad_tax", True))
+        for args in cases:
+            with self.subTest(args=args), self.assertRaises(ValidationError):
+                self.service.upgrade_subscription(*args, idempotency_key="upgrade")
+        for key in ("", "   ", False):
+            with self.subTest(key=key), self.assertRaises(ValidationError):
+                self.upgrade(key=key)
+        self.assertEqual(self.sub.plan_id, "starter")
+        self.assertEqual(self.service.ledger.entries_for_account("account"), [])
+        self.assertEqual(self.upgrade().total_cents, 6)
+
+    def test_replay_after_later_upgrade_through_shared_ledger(self):
+        original = self.upgrade()
+        later = self.upgrade("team", key="next")
+        other_service = OrderService(self.service.ledger)
+        replay = other_service.upgrade_subscription(
+            self.sub.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+        self.assertIs(replay, original)
+        self.assertEqual(self.sub.plan_id, "team")
+        self.assertEqual(self.service.ledger.entries_for_account("account"), [original, later])
+
+    def test_key_conflicts_for_each_argument(self):
+        original = self.upgrade(cycle=1)
+        sid = self.sub.subscription_id
+        other = self.service.start_subscription("account", "starter")
+        for args in [
+            (other.subscription_id, "pro", 1, 1), (sid, "team", 1, 1),
+            (sid, "pro", 0, 1), (sid, "pro", 1, 2),
+            (sid, "pro", True, 1), (sid, "pro", 1, True),
+        ]:
+            with self.subTest(args=args), self.assertRaises(ValidationError):
+                self.service.upgrade_subscription(*args, idempotency_key="upgrade")
+        self.assertEqual(other.plan_id, "starter")
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertEqual(self.service.ledger.entries_for_account("account"), [original])
+        self.assertIs(self.upgrade(cycle=1), original)
