> tests/test_audit.py <<'PY'\nimport unittest\nfrom unittest.mock import Mock, patch\n\nfrom ev1_order_ledger import LineItem, OrderService, Plan\n\n\nclass AuditTests(unittest.TestCase):\n    def setUp(self):\n        self.sink = Mock()\n        self.service = OrderService(audit_sink=self.sink)\n        self.service.register_plan(Plan(\\\"base\\\", \\\"Base\\\", 100))\n        self.service.register_plan(Plan(\\\"pro\\\", \\\"Pro\\\", 300))\n        self.sub = self.service.start_subscription(\\\"acct\\\", \\\"base\\\")\n\n    def order(self):\n        return self.service.place_order(\\\"acct\\\", [LineItem(\\\"item\\\", 100, 1)], tax_bps=1000)\n\n    def upgrade(self):\n        return self.service.upgrade_subscription(\n            self.sub.subscription_id, \\\"pro\\\", 1, 2, idempotency_key=\\\"upgrade\\\"\n        )\n\n    def refund(self, order):\n        return self.service.refund_order(\n            order.order_id, order.total_cents, reason=\\\"return\\\", idempotency_key=\\\"refund\\\"\n        )\n\n    def test_events_match_new_entries_only(self):\n        order = self.order()\n        charge, = self.service.ledger.entries_for_account(\\\"acct\\\")\n        upgrade = self.upgrade()\n        refund = self.refund(order)\n        self.assertIs(self.upgrade(), upgrade)\n        self.assertIs(self.refund(order), refund)\n        self.assertEqual([call.args[0] for call in self.sink.call_args_list], [\n            {\\\"action\\\": \\\"order_charge\\\", \\\"account_id\\\": \\\"acct\\\", \\\"amount_cents\\\": 110, \\\"entry_id\\\": charge.entry_id},\n            {\\\"action\\\": \\\"plan_upgrade\\\", \\\"account_id\\\": \\\"acct\\\", \\\"amount_cents\\\": 100, \\\"entry_id\\\": upgrade.entry_id},\n            {\\\"action\\\": \\\"order_refund\\\", \\\"account_id\\\": \\\"acct\\\", \\\"amount_cents\\\": -110, \\\"entry_id\\\": refund.entry_id},\n        ])\n\n    def test_failed_order_audit_prevents_order_and_entry(self):\n        failure = RuntimeError(\\\"audit unava