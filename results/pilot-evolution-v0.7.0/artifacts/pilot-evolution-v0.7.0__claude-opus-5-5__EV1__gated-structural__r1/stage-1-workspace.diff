+    def upgrade_subscription(
+        self,
+        subscription_id: str,
+        new_plan_id: str,
+        days_remaining: int,
+        cycle_days: int,
+        *,
+        idempotency_key: str,
+    ) -> LedgerEntry:
+        """Move a subscription to a pricier plan mid-cycle and charge the prorated difference.
+
+        Replaying the same ``idempotency_key`` with identical arguments returns the
+        original entry without charging again.
+        """
+        for value, field_name in (
+            (subscription_id, "subscription_id"),
+            (new_plan_id, "new_plan_id"),
+            (idempotency_key, "idempotency_key"),
+        ):
+            if not isinstance(value, str) or not value.strip():
+                raise ValidationError(f"{field_name} must be a non-empty string")
+        # Stateless shape checks run before the replay lookup so that, e.g., True is
+        # never accepted as a replay of 1 (True == 1 in a tuple comparison).
+        validate_upgrade_window(days_remaining, cycle_days)
+
+        fingerprint = ("upgrade_subscription", subscription_id, new_plan_id, days_remaining, cycle_days)
+        replayed = self.ledger.find_idempotent_entry(idempotency_key, fingerprint)
+        if replayed is not None:
+            return replayed
+
+        sub = self.ledger.get_subscription(subscription_id)
+        old_plan = self.ledger.get_plan(sub.plan_id)
+        new_plan = self.ledger.get_plan(new_plan_id)
+        subtotal = compute_upgrade_proration_cents(
+            old_plan.monthly_cents, new_plan.monthly_cents, days_remaining, cycle_days
+        )
+        tax = compute_tax_cents(subtotal, new_plan.tax_bps)
+        entry = LedgerEntry(
+            entry_id=self.ledger.next_id("ent"),
+            account_id=sub.account_id,
+            kind="plan_upgrade",
+            subtotal_cents=subtotal,
+            tax_cents=tax,
+            total_cents=subtotal + tax,
+            reference_id=subscription_id,
+            reason=f"upgrade {old_plan.plan_id} -> {new_plan.plan_id}",
+            metadata={
+                "old_plan_id": old_plan.plan_id,
+                "new_plan_id": new_plan.plan_id,
+                "days_remaining": days_remaining,
+                "cycle_days": cycle_days,
+                "idempotency_key": idempotency_key,
+            },
+        )
+        self.ledger.record_idempotent_entry(idempotency_key, fingerprint, entry)
+        sub.plan_id = new_plan.plan_id
+        return entry
