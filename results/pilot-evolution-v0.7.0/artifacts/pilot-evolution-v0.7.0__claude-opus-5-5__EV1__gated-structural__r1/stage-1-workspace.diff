+    def find_idempotent_entry(self, idempotency_key: str, fingerprint: Hashable) -> Optional[LedgerEntry]:
+        """Return the entry previously recorded under ``idempotency_key``, if any.
+
+        Raises ValidationError when the key was already used for a different request.
+        """
+        stored = self._idempotency.get(idempotency_key)
+        if stored is None:
+            return None
+        stored_fingerprint, entry_id = stored
+        if stored_fingerprint != fingerprint:
+            raise ValidationError(f"idempotency_key {idempotency_key!r} was already used with different arguments")
+        return self._entries[entry_id]
+
+    def record_idempotent_entry(self, idempotency_key: str, fingerprint: Hashable, entry: LedgerEntry) -> None:
+        if idempotency_key in self._idempotency:
+            raise ValidationError(f"idempotency_key {idempotency_key!r} is already recorded")
+        self.record_entry(entry)
+        self._idempotency[idempotency_key] = (fingerprint, entry.entry_id)
+
     def get_entry(self, entry_id: str) -> Optional[LedgerEntry]:
         return self._entries.get(entry_id)
 

