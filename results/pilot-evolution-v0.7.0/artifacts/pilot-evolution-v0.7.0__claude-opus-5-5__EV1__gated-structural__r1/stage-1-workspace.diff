+"""Turn 1: mid-cycle prorated plan upgrades with idempotency."""
+
+from __future__ import annotations
+
+from fractions import Fraction
+import math
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import Plan, ValidationError
+from ev1_order_ledger.pricing import compute_upgrade_proration_cents
+
+
+def _reference_half_up(numerator: int, denominator: int) -> int:
+    return math.floor(Fraction(numerator, denominator) + Fraction(1, 2))
+
+
+class ProrationPricingTests(unittest.TestCase):
+    def test_exact_half_rounds_up(self) -> None:
+        # (1001 - 1000) * 1 / 2 = 0.5 -> 1
+        self.assertEqual(compute_upgrade_proration_cents(1000, 1001, 1, 2), 1)
+        # 3 * 1 / 2 = 1.5 -> 2 ; 5 * 1 / 2 = 2.5 -> 3 (not banker's rounding)
+        self.assertEqual(compute_upgrade_proration_cents(1000, 1003, 1, 2), 2)
+        self.assertEqual(compute_upgrade_proration_cents(1000, 1005, 1, 2), 3)
+
+    def test_below_half_rounds_down(self) -> None:
+        # 1 * 1 / 3 = 0.333 -> 0 ; 2000 * 20 / 30 = 1333.33 -> 1333
+        self.assertEqual(compute_upgrade_proration_cents(1000, 1001, 1, 3), 0)
+        self.assertEqual(compute_upgrade_proration_cents(1000, 3000, 20, 30), 1333)
+
+    def test_above_half_rounds_up(self) -> None:
+        # 2000 * 1 / 30 = 66.67 -> 67
+        self.assertEqual(compute_upgrade_proration_cents(1000, 3000, 1, 30), 67)
+
+    def test_boundary_days(self) -> None:
+        self.assertEqual(compute_upgrade_proration_cents(1000, 3000, 0, 30), 0)
+        self.assertEqual(compute_upgrade_proration_cents(1000, 3000, 30, 30), 2000)
+
+    def test_matches_exact_rational_reference(self) -> None:
+        for diff in (1, 3, 7, 999, 2000, 12345):
+            for cycle in (1, 2, 7, 28, 29, 30, 31):
+                for days in range(cycle + 1):
+                    with self.subTest(diff=diff, cycle=cycle, days=days):
+                        self.assertEqual(
+                            compute_upgrade_proration_cents(500, 500 + diff, days, cycle),
+                            _reference_half_up(diff * days, cycle),
+                        )
+
+    def test_rejects_non_upgrade_and_bad_window(self) -> None:
+        bad_args = [
+            (3000, 3000, 1, 30),  # same price
+            (3000, 1000, 1, 30),  # downgrade
+            (1000, 3000, 1, 0),  # cycle_days == 0
+            (1000, 3000, 1, -30),  # negative cycle
+            (1000, 3000, -1, 30),  # negative days
+            (1000, 3000, 31, 30),  # days > cycle
+            (1000, 3000, True, 30),  # bool days
+            (1000, 3000, 1, True),  # bool cycle
+            (1000, 3000, 1.0, 30),  # float days
+        ]
+        for args in bad_args:
+            with self.subTest(args=args), self.assertRaises(ValidationError):
+                compute_upgrade_proration_cents(*args)
+
+
+class UpgradeSubscriptionTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="biz", name="Biz", monthly_cents=5000, tax_bps=1000))
+        self.sub = self.svc.start_subscription("acct_1", "starter")
+
+    def _entries(self):
+        return self.svc.ledger.entries_for_account("acct_1")
+
+    def test_upgrade_records_prorated_entry_with_half_up_tax(self) -> None:
+        entry = self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 15, 30, idempotency_key="k1")
+        # 2000 * 15 / 30 = 1000 ; tax 1000 * 825 / 10000 = 82.5 -> 83
+        self.assertEqual(entry.subtotal_cents, 1000)
+        self.assertEqual(entry.tax_cents, 83)
+        self.assertEqual(entry.total_cents, 1083)
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.sub.subscription_id)
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual(entry.metadata["old_plan_id"], "starter")
+        self.assertEqual(entry.metadata["new_plan_id"], "pro")
+        self.assertEqual(self.svc.ledger.get_subscription(self.sub.subscription_id).plan_id, "pro")
+        self.assertEqual(self._entries(), [entry])
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 1083)
+
+    def test_tax_uses_new_plan_rate(self) -> None:
+        entry = self.svc.upgrade_subscription(self.sub.subscription_id, "biz", 1, 30, idempotency_key="k1")
+        # 4000 * 1 / 30 = 133.33 -> 133 ; tax at new plan 1000 bps: 13.3 -> 13
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (133, 13, 146))
+
+    def test_successive_upgrades_prorate_from_current_plan(self) -> None:
+        self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 20, 30, idempotency_key="k1")
+        second = self.svc.upgrade_subscription(self.sub.subscription_id, "biz", 10, 30, idempotency_key="k2")
+        # 2000 * 10 / 30 = 666.67 -> 667 ; tax 66.7 -> 67
+        self.assertEqual((second.subtotal_cents, second.tax_cents), (667, 67))
+        self.assertEqual(second.metadata["old_plan_id"], "pro")
+        self.assertEqual(len(self._entries()), 2)
+
+    def test_zero_days_remaining_records_zero_charge(self) -> None:
+        entry = self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 0, 30, idempotency_key="k1")
+        self.assertEqual(entry.total_cents, 0)
+        self.assertEqual(self.svc.ledger.get_subscription(self.sub.subscription_id).plan_id, "pro")
+
+    def assert_rejected_without_side_effects(self, *args, **kwargs) -> None:
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(*args, **kwargs)
+        self.assertEqual(self._entries(), [])
+        self.assertEqual(self.svc.ledger.get_subscription(self.sub.subscription_id).plan_id, "starter")
+
+    def test_rejects_unknown_ids(self) -> None:
+        self.assert_rejected_without_side_effects("sub_missing", "pro", 1, 30, idempotency_key="k1")
+        self.assert_rejected_without_side_effects(self.sub.subscription_id, "missing", 1, 30, idempotency_key="k2")
+
+    def test_rejects_non_upgrades(self) -> None:
+        self.svc.register_plan(Plan(plan_id="starter_alt", name="Alt", monthly_cents=1000))
+        self.svc.register_plan(Plan(plan_id="free", name="Free", monthly_cents=0))
+        sid = self.sub.subscription_id
+        self.assert_rejected_without_side_effects(sid, "starter", 1, 30, idempotency_key="k1")
+        self.assert_rejected_without_side_effects(sid, "starter_alt", 1, 30, idempotency_key="k2")
+        self.assert_rejected_without_side_effects(sid, "free", 1, 30, idempotency_key="k3")
+
+    def test_rejects_invalid_bounds_and_types(self) -> None:
+        sid = self.sub.subscription_id
+        cases = [
+            ((sid, "pro", 1, 0), "k"),
+            ((sid, "pro", 1, -1), "k"),
+            ((sid, "pro", -1, 30), "k"),
+            ((sid, "pro", 31, 30), "k"),
+            ((sid, "pro", True, 30), "k"),
+            ((sid, "pro", 1, True), "k"),
+            ((sid, "pro", False, 30), "k"),
+            ((sid, "pro", 1.5, 30), "k"),
+            ((sid, "pro", 1, 30), ""),
+            ((sid, "pro", 1, 30), "   "),
+            ((sid, "pro", 1, 30), None),
+            ((sid, "pro", 1, 30), True),
+            (("", "pro", 1, 30), "k"),
+            ((sid, "", 1, 30), "k"),
+        ]
+        for args, key in cases:
+            with self.subTest(args=args, key=key):
+                self.assert_rejected_without_side_effects(*args, idempotency_key=key)
+
+    def test_failed_attempt_does_not_reserve_key(self) -> None:
+        self.assert_rejected_without_side_effects(self.sub.subscription_id, "pro", 31, 30, idempotency_key="k1")
+        entry = self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 15, 30, idempotency_key="k1")
+        self.assertEqual(entry.total_cents, 1083)
+
+    def test_replay_returns_original_entry_without_duplicate(self) -> None:
+        first = self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 15, 30, idempotency_key="k1")
+        # Replay succeeds even though the subscription is now on "pro".
+        again = self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 15, 30, idempotency_key="k1")
+        self.assertIs(again, first)
+        self.assertEqual(self._entries(), [first])
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 1083)
+
+    def test_key_reuse_with_different_arguments_conflicts(self) -> None:
+        other = self.svc.start_subscription("acct_1", "starter")
+        first = self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 15, 30, idempotency_key="k1")
+        conflicting = [
+            (other.subscription_id, "pro", 15, 30),
+            (self.sub.subscription_id, "biz", 15, 30),
+            (self.sub.subscription_id, "pro", 14, 30),
+            (self.sub.subscription_id, "pro", 15, 31),
+        ]
+        for args in conflicting:
+            with self.subTest(args=args), self.assertRaises(ValidationError):
+                self.svc.upgrade_subscription(*args, idempotency_key="k1")
+        self.assertEqual(self._entries(), [first])
+        self.assertEqual(self.svc.ledger.get_subscription(other.subscription_id).plan_id, "starter")
+        self.assertEqual(self.svc.ledger.get_subscription(self.sub.subscription_id).plan_id, "pro")
+
+    def test_bool_is_not_a_replay_of_int(self) -> None:
+        self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 1, 30, idempotency_key="k1")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(self.sub.subscription_id, "pro", True, 30, idempotency_key="k1")
+        self.assertEqual(len(self._entries()), 1)
+
+    def test_new_key_is_validated_against_current_plan(self) -> None:
+        self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 15, 30, idempotency_key="k1")
+        # Same subscription is now on "pro"; upgrading to "pro" again under a new key is a non-upgrade.
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 15, 30, idempotency_key="k2")
+        self.assertEqual(len(self._entries()), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
