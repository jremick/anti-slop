+class PriceChargeTests(unittest.TestCase):
+    def test_no_promo_is_plain_tax(self) -> None:
+        self.assertEqual(tuple(price_charge(3998, 825)), (3998, 0, 3998, 330, 4328))
+
+    def test_percent_discount_rounds_half_up_then_taxes_discounted_subtotal(self) -> None:
+        promo = Promo(code="HALF", percent_off=50)
+        # 1001 * 50% = 500.5 -> 501 off ; subtotal 500 ; tax 10% = 50
+        self.assertEqual(tuple(price_charge(1001, 1000, promo=promo)), (1001, 501, 500, 50, 550))
+
+    def test_fixed_discount_clamps_at_zero(self) -> None:
+        promo = Promo(code="BIG", amount_off_cents=5000)
+        self.assertEqual(tuple(price_charge(1000, 825, promo=promo)), (1000, 1000, 0, 0, 0))
+
+    def test_expiry_boundary_is_inclusive(self) -> None:
+        promo = Promo(code="X", percent_off=10, expires_on=date(2026, 12, 31))
+        self.assertEqual(price_charge(1000, 0, promo=promo, as_of=date(2026, 12, 31)).discount_cents, 100)
+        with self.assertRaises(ValidationError):
+            price_charge(1000, 0, promo=promo, as_of=date(2027, 1, 1))
+        with self.assertRaises(ValidationError):
+            price_charge(1000, 0, promo=promo)
+
+
