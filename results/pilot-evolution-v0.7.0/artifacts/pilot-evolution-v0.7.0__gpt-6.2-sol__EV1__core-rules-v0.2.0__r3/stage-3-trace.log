{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"PYTHONPATH=benchmarks/sources python3 - <<'PY'\nfrom ev1_order_ledger.models import Order\nfrom ev1_order_ledger.pricing import compute_refund_split\n\n\ndef partitions(total):\n    if total == 0:\n        yield ()\n    for first in range(1, total + 1):\n        for rest in partitions(total - first):\n            yield (first,) + rest\n\n\nchecked = 0\nfor total in range(1, 13):\n    for tax in range(total // 2 + 1):\n        order = Order(\\\"order\\\", \\\"account\\\", (), total - tax, tax, total)\n        for parts in partitions(total):\n            refunded = subtotal_reversed = tax_reversed = 0\n            for amount in parts:\n                subtotal, tax_part = compute_refund_split(order, refunded, amount)\n                assert subtotal >= 0 and tax_part >= 0\n                assert subtotal + tax_part == amount\n                refunded += amount\n                subtotal_reversed += subtotal\n                tax_reversed += tax_part\n            assert (subtotal_reversed, tax_reversed) == (order.subtotal_cents, order.tax_cents)\n            checked += 1\nprint(f\\\"Verified {checked} refund sequences for orders of 1–12 cents.\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
