+"""Unit tests for prorated subscription upgrades."""
+
+from concurrent.futures import ThreadPoolExecutor
+import unittest
+
+from ev1_order_ledger import OrderService, Plan, ValidationError
+
+
+class SubscriptionUpgradeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.service = OrderService()
+        self.service.register_plan(Plan("starter", "Starter", 1000))
+        self.service.register_plan(Plan("pro", "Pro", 1103, tax_bps=1250))
+        self.service.register_plan(Plan("premium", "Premium", 2000))
+        self.subscription = self.service.start_subscription("account", "starter")
+        self.arguments = (self.subscription.subscription_id, "pro", 1, 2)
+
+    def test_rounds_proration_half_up_and_taxes_rounded_subtotal_at_new_rate(self) -> None:
+        entry = self.service.upgrade_subscription(*self.arguments, idempotency_key="upgrade")
+
+        self.assertEqual(entry.subtotal_cents, 52)  # 103 / 2 = 51.5
+        self.assertEqual(entry.tax_cents, 7)  # 52 * 1250 / 10000 = 6.5
+        self.assertEqual(entry.total_cents, 59)
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.subscription.subscription_id)
+        self.assertEqual(entry.account_id, "account")
+        self.assertEqual(self.subscription.plan_id, "pro")
+        self.assertIs(self.service.ledger.get_entry(entry.entry_id), entry)
+        self.assertEqual(
+            self.service.get_statement("account"),
+            {"account_id": "account", "balance_cents": 59, "entry_count": 1},
+        )
+
+    def test_proration_rounds_on_either_side_of_half_and_accepts_endpoints(self) -> None:
+        for days_remaining, expected_subtotal in ((0, 0), (1, 34), (2, 69), (3, 103)):
+            with self.subTest(days_remaining=days_remaining):
+                sub = self.service.start_subscription("account", "starter")
+                entry = self.service.upgrade_subscription(
+                    sub.subscription_id,
+                    "pro",
+                    days_remaining,
+                    3,
+                    idempotency_key=sub.subscription_id,
+                )
+                self.assertEqual(entry.subtotal_cents, expected_subtotal)
+                self.assertEqual(sub.plan_id, "pro")
+
+    def test_rejects_invalid_periods_and_leaves_key_available(self) -> None:
+        subscription_id = self.subscription.subscription_id
+        for days_remaining, cycle_days in (
+            (0, 0), (0, -1), (-1, 2), (3, 2), (True, 2), (1, True), (1.0, 2), (1, 2.0),
+        ):
+            with self.subTest(days_remaining=days_remaining, cycle_days=cycle_days):
+                with self.assertRaises(ValidationError):
+                    self.service.upgrade_subscription(
+                        subscription_id,
+                        "pro",
+                        days_remaining,
+                        cycle_days,
+                        idempotency_key="upgrade",
+                    )
+                self.assertEqual(self.subscription.plan_id, "starter")
+                self.assertEqual(self.service.ledger.entries_for_account("account"), [])
+
+        self.service.upgrade_subscription(*self.arguments, idempotency_key="upgrade")
+        self.assertEqual(self.subscription.plan_id, "pro")
+
+    def test_rejects_unknown_ids_non_upgrades_and_invalid_keys(self) -> None:
+        self.service.register_plan(Plan("equal", "Equal", 1000))
+        self.service.register_plan(Plan("lower", "Lower", 999))
+        subscription_id = self.subscription.subscription_id
+        for sub_id, plan_id, key in (
+            ("missing", "pro", "upgrade"),
+            (True, "pro", "upgrade"),
+            (subscription_id, "missing", "upgrade"),
+            (subscription_id, True, "upgrade"),
+            (subscription_id, "starter", "upgrade"),
+            (subscription_id, "equal", "upgrade"),
+            (subscription_id, "lower", "upgrade"),
+            (subscription_id, "pro", ""),
+            (subscription_id, "pro", "  "),
+            (subscription_id, "pro", True),
+        ):
+            with self.subTest(subscription_id=sub_id, plan_id=plan_id, key=key):
+                with self.assertRaises(ValidationError):
+                    self.service.upgrade_subscription(sub_id, plan_id, 1, 2, idempotency_key=key)
+                self.assertEqual(self.subscription.plan_id, "starter")
+                self.assertEqual(self.service.ledger.entries_for_account("account"), [])
+
+    def test_replays_original_entry_across_services_after_a_later_upgrade(self) -> None:
+        original = self.service.upgrade_subscription(*self.arguments, idempotency_key="first")
+        other_service = OrderService(self.service.ledger)
+        later = other_service.upgrade_subscription(
+            self.subscription.subscription_id, "premium", 1, 2, idempotency_key="second"
+        )
+
+        replay = other_service.upgrade_subscription(*self.arguments, idempotency_key="first")
+        self.assertIs(replay, original)
+        self.assertEqual(self.subscription.plan_id, "premium")
+        self.assertEqual(self.service.ledger.entries_for_account("account"), [original, later])
+
+    def test_rejects_changes_to_each_replay_argument(self) -> None:
+        original = self.service.upgrade_subscription(*self.arguments, idempotency_key="upgrade")
+        subscription_id = self.subscription.subscription_id
+        other_sub = self.service.start_subscription("other_account", "starter")
+        for arguments in (
+            (other_sub.subscription_id, "pro", 1, 2),
+            (subscription_id, "premium", 1, 2),
+            (subscription_id, "pro", 0, 2),
+            (subscription_id, "pro", 1, 3),
+            (subscription_id, "pro", True, 2),
+            (subscription_id, "pro", 1, 2.0),
+        ):
+            with self.subTest(arguments=arguments):
+                with self.assertRaises(ValidationError):
+                    self.service.upgrade_subscription(*arguments, idempotency_key="upgrade")
+
+        replay = self.service.upgrade_subscription(*self.arguments, idempotency_key="upgrade")
+        self.assertIs(replay, original)
+        self.assertEqual(self.subscription.plan_id, "pro")
+        self.assertEqual(other_sub.plan_id, "starter")
+        self.assertEqual(self.service.ledger.entries_for_account("account"), [original])
+        self.assertEqual(self.service.ledger.entries_for_account("other_account"), [])
+
+    def test_concurrent_replays_record_one_entry(self) -> None:
+        with ThreadPoolExecutor(max_workers=4) as executor:
+            requests = [
+                executor.submit(
+                    self.service.upgrade_subscription, *self.arguments, idempotency_key="upgrade"
+                )
+                for _ in range(8)
+            ]
+            entries = [request.result() for request in requests]
+
+        for entry in entries:
+            self.assertIs(entry, entries[0])
+        self.assertEqual(self.service.ledger.entries_for_account("account"), [entries[0]])
