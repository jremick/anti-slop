+"""Unit tests for synchronous, fail-closed order ledger audit logging."""
+
+import unittest
+from unittest.mock import Mock, call, patch
+
+from ev1_order_ledger import LineItem, OrderService, Plan, ValidationError
+
+
+class AuditTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.sink = Mock()
+        self.service = OrderService(audit_sink=self.sink)
+        self.items = [LineItem("seat", 100, 1)]
+        self.service.register_plan(Plan("basic", "Basic", 1000))
+        self.service.register_plan(Plan("pro", "Pro", 1400))
+        self.sub = self.service.start_subscription("account", "basic")
+        self.upgrade_args = (self.sub.subscription_id, "pro", 1, 2)
+        self.failure = RuntimeError("audit unavailable")
+
+    def test_logs_exact_events_for_commits_and_skips_replays_and_rejections(self) -> None:
+        order = self.service.place_order("account", self.items, tax_bps=1000)
+        charge, = self.service.ledger.entries_for_account("account")
+        upgrade = self.service.upgrade_subscription(*self.upgrade_args, idempotency_key="upgrade")
+        refund = self.service.refund_order(order.order_id, 30, reason="return", idempotency_key="refund")
+
+        self.sink.side_effect = self.failure
+        self.assertIs(
+            self.service.upgrade_subscription(*self.upgrade_args, idempotency_key="upgrade"), upgrade
+        )
+        self.assertIs(
+            self.service.refund_order(order.order_id, 30, reason="return", idempotency_key="refund"), refund
+        )
+        with self.assertRaises(ValidationError):
+            self.service.refund_order(order.order_id, 100, reason="return", idempotency_key="over")
+        with self.assertRaises(ValidationError):
+            self.service.refund_order(order.order_id, 31, reason="return", idempotency_key="refund")
+
+        self.assertEqual(self.sink.call_args_list, [
+            call({"action": "order_charge", "account_id": "account", "amount_cents": 110, "entry_id": charge.entry_id}),
+            call({"action": "plan_upgrade", "account_id": "account", "amount_cents": 200, "entry_id": upgrade.entry_id}),
+            call({"action": "order_refund", "account_id": "account", "amount_cents": -30, "entry_id": refund.entry_id}),
+        ])
+
+    def test_failed_order_audit_leaves_no_order_or_charge(self) -> None:
+        self.sink.side_effect = self.failure
+        ledger = self.service.ledger
+        with patch.object(ledger, "save_order", wraps=ledger.save_order) as save_order:
+            with self.assertRaises(RuntimeError) as raised:
+                self.service.place_order("account", self.items)
+        self.assertIs(raised.exception, self.failure)
+        save_order.assert_not_called()
+        self.assertIsNone(ledger.get_entry(self.sink.call_args.args[0]["entry_id"]))
+        self.assertEqual(ledger.entries_for_account("account"), [])
+
