+"""Unit tests for partial order refunds and credit notes."""
+
+from concurrent.futures import ThreadPoolExecutor
+from threading import Barrier
+import unittest
+
+from ev1_order_ledger import LineItem, OrderService, Plan, ValidationError
+
+
+class RefundTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.service = OrderService()
+        self.items = [LineItem("seat", 3, 1)]
+        self.order = self.service.place_order("account", self.items, tax_bps=3333)
+
+    def test_partial_refunds_reverse_exact_subtotal_and_tax_across_chunkings(self) -> None:
+        self.service.register_promo("SAVE2", amount_off_cents=2)
+        for amounts, expected_taxes in (
+            ((1, 1, 1, 1), (0, 1, 0, 0)),
+            ((1, 1, 2), (0, 1, 0)),
+            ((3, 1), (1, 0)),
+        ):
+            with self.subTest(amounts=amounts):
+                account = str(amounts)
+                order = self.service.place_order(
+                    account, [LineItem("seat", 5, 1)], tax_bps=3333, promo_code="SAVE2"
+                )
+                self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (3, 1, 4))
+                refunds = []
+                for index, (amount, tax) in enumerate(zip(amounts, expected_taxes)):
+                    entry = self.service.refund_order(
+                        order.order_id, amount, reason="partial return", idempotency_key=f"{account}-{index}"
+                    )
+                    self.assertEqual(entry.kind, "order_refund")
+                    self.assertEqual(entry.reference_id, order.order_id)
+                    self.assertEqual(entry.account_id, account)
+                    self.assertEqual(entry.reason, "partial return")
+                    self.assertEqual((entry.subtotal_cents, entry.tax_cents), (-(amount - tax), -tax))
+                    self.assertEqual(entry.subtotal_cents + entry.tax_cents, entry.total_cents)
+                    self.assertEqual(entry.total_cents, -amount)
+                    refunds.append(entry)
+
+                self.assertEqual(sum(entry.subtotal_cents for entry in refunds), -order.subtotal_cents)
+                self.assertEqual(sum(entry.tax_cents for entry in refunds), -order.tax_cents)
+                self.assertEqual(self.service.get_statement(account)["balance_cents"], 0)
+
+    def test_over_refund_is_rejected_and_does_not_claim_key(self) -> None:
+        order_id = self.order.order_id
+        self.service.refund_order(order_id, 3, reason="return", idempotency_key="partial")
+        with self.assertRaises(ValidationError):
+            self.service.refund_order(order_id, 2, reason="return", idempotency_key="remainder")
+        self.assertEqual(self.service.get_statement("account")["balance_cents"], 1)
+        self.assertEqual(self.service.get_statement("account")["entry_count"], 2)
+
+        self.service.refund_order(order_id, 1, reason="return", idempotency_key="remainder")
+        with self.assertRaises(ValidationError):
+            self.service.refund_order(order_id, 1, reason="return", idempotency_key="over")
+        self.assertEqual(self.service.get_statement("account")["balance_cents"], 0)
+
+    def test_refund_rejects_invalid_arguments_and_zero_total(self) -> None:
+        self.service.register_promo("FREE", percent_off=100)
+        free_order = self.service.place_order("free account", self.items, promo_code="FREE")
+        order_id = self.order.order_id
+        for refund_order_id, amount, reason, key in (
+            ("missing", 1, "return", "key"),
+            ([], 1, "return", "key"),
+            (free_order.order_id, 1, "return", "key"),
+            (order_id, 0, "return", "key"),
+            (order_id, -1, "return", "key"),
+            (order_id, True, "return", "key"),
+            (order_id, 1.0, "return", "key"),
+            (order_id, 1, "", "key"),
+            (order_id, 1, "  ", "key"),
+            (order_id, 1, None, "key"),
+            (order_id, 1, "return", ""),
+            (order_id, 1, "return", "  "),
+            (order_id, 1, "return", None),
+        ):
+            with self.subTest(order_id=refund_order_id, amount=amount, reason=reason, key=key):
+                with self.assertRaises(ValidationError):
+                    self.service.refund_order(refund_order_id, amount, reason=reason, idempotency_key=key)
+        self.assertEqual(self.service.get_statement("account")["entry_count"], 1)
+        self.assertEqual(self.service.get_statement("free account")["entry_count"], 1)
+
+    def test_idempotent_replay_after_full_refund_and_conflicts(self) -> None:
+        order_id = self.order.order_id
+        other = self.service.place_order("account", self.items)
+        original = self.service.refund_order(order_id, 1, reason="return", idempotency_key="first")
+        self.service.refund_order(order_id, 3, reason="return", idempotency_key="second")
+        shared_service = OrderService(self.service.ledger)
+        replay = shared_service.refund_order(order_id, 1, reason="return", idempotency_key="first")
+        self.assertIs(replay, original)
+
+        for changed_order_id, amount, reason in (
+            (other.order_id, 1, "return"),
+            (order_id, 2, "return"),
+            (order_id, 1, "changed reason"),
+        ):
+            with self.subTest(order_id=changed_order_id, amount=amount, reason=reason):
+                with self.assertRaisesRegex(ValidationError, "different arguments"):
+                    shared_service.refund_order(changed_order_id, amount, reason=reason, idempotency_key="first")
+        with self.assertRaises(ValidationError):
+            shared_service.refund_order(order_id, True, reason="return", idempotency_key="first")
+
+        self.service.register_plan(Plan("basic", "Basic", 100))
+        self.service.register_plan(Plan("pro", "Pro", 200))
+        sub = self.service.start_subscription("account", "basic")
+        with self.assertRaisesRegex(ValidationError, "different arguments"):
+            self.service.upgrade_subscription(sub.subscription_id, "pro", 1, 2, idempotency_key="first")
+        self.assertEqual(self.service.get_statement("account")["entry_count"], 4)
+
+    def test_competing_refunds_cannot_exceed_order_total(self) -> None:
+        ready = Barrier(2)
+
+        def attempt(key: str) -> bool:
+            ready.wait(timeout=5)
+            try:
+                self.service.refund_order(self.order.order_id, 3, reason="return", idempotency_key=key)
+            except ValidationError:
+                return False
+            return True
+
+        with ThreadPoolExecutor(max_workers=2) as executor:
+            self.assertCountEqual(executor.map(attempt, ("one", "two")), (True, False))
+        self.assertEqual(self.service.get_statement("account")["balance_cents"], 1)
+
+    def test_credit_note_exports_positive_amounts_and_rejects_other_entries(self) -> None:
+        charge, = self.service.ledger.entries_for_account("account")
+        refund = self.service.refund_order(self.order.order_id, 2, reason="return", idempotency_key="credit")
+        self.assertEqual(
+            self.service.export_credit_note(refund.entry_id),
+            {
+                "entry_id": refund.entry_id,
+                "order_id": self.order.order_id,
+                "account_id": "account",
+                "subtotal_cents": 1,
+                "tax_cents": 1,
+                "total_cents": 2,
+                "reason": "return",
+            },
+        )
+        for entry_id in ("missing", charge.entry_id, []):
+            with self.subTest(entry_id=entry_id):
+                with self.assertRaises(ValidationError):
+                    self.service.export_credit_note(entry_id)

