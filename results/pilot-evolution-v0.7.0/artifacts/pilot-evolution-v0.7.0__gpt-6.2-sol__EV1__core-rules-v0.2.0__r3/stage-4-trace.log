{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc 'cat benchmarks/sources/ev1_order_ledger/pricing.py && python3 benchmarks/sources/ev1_order_ledger/run_checks.py'","aggregated_output":"\"\"\"Canonical integer-cent pricing calculations for EV1 order ledger.\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import date\nfrom typing import Sequence, Tuple\n\nfrom .models import LineItem, Order, Plan, Promo, ValidationError\n\n\nLEGACY_FLAT_FEE_CENTS = 500\n\n\ndef validate_non_negative_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value < 0:\n        raise ValidationError(f\"{field_name} must be a non-negative integer\")\n    return value\n\n\ndef validate_positive_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:\n        raise ValidationError(f\"{field_name} must be a positive integer\")\n    return value\n\n\ndef round_half_up_div(numerator: int, denominator: int) -> int:\n    \"\"\"Exact integer half-up division for non-negative numerator and positive denominator.\"\"\"\n    validate_non_negative_int(numerator, \"numerator\")\n    validate_positive_int(denominator, \"denominator\")\n    return (numerator * 2 + denominator) // (2 * denominator)\n\n\ndef compute_subtotal_cents(items: Sequence[LineItem], *, legacy_flat_fee: bool = False) -> int:\n    if not items:\n        raise ValidationError(\"items must be non-empty\")\n    subtotal = 0\n    for item in items:\n        validate_positive_int(item.unit_cents, \"unit_cents\")\n        validate_positive_int(item.quantity, \"quantity\")\n        subtotal += item.unit_cents * item.quantity\n    if legacy_flat_fee:\n        subtotal += LEGACY_FLAT_FEE_CENTS\n    return subtotal\n\n\ndef compute_tax_cents(taxable_cents: int, tax_bps: int) -> int:\n    validate_non_negative_int(taxable_cents, \"taxable_cents\")\n    validate_non_negative_int(tax_bps, \"tax_bps\")\n    if tax_bps > 10_000:\n        raise ValidationError(\"tax_bps cannot exceed 10000\")\n    return round_half_up_div(taxable_cents * tax_bps, 10_000)\n\n\ndef parse_optional_date(value: str | None, field_name: str) -> date | None:\n    if value is None:\n        return None\n    try:\n        parsed = date.fromisoformat(value)\n    except (TypeError, ValueError):\n        raise ValidationError(f\"{field_name} must use YYYY-MM-DD\") from None\n    if parsed.isoformat() != value:\n        raise ValidationError(f\"{field_name} must use YYYY-MM-DD\")\n    return parsed\n\n\ndef apply_discount_and_tax(\n    subtotal_cents: int,\n    tax_bps: int,\n    *,\n    promo: Promo | None = None,\n    as_of: str | None = None,\n) -> Tuple[int, int, int, int]:\n    \"\"\"Return the discounted subtotal, tax, total, and applied discount in cents.\"\"\"\n    effective_date = parse_optional_date(as_of, \"as_of\")\n    discount = 0\n    if promo is not None:\n        if subtotal_cents < promo.min_subtotal_cents:\n            raise ValidationError(\"subtotal is below the promo minimum\")\n        if promo.expires_on is not None:\n            if effective_date is None:\n                raise ValidationError(\"as_of is required for an expiring promo\")\n            if effective_date > promo.expires_on:\n                raise ValidationError(\"promo has expired\")\n        if promo.percent_off is not None:\n            discount = round_half_up_div(subtotal_cents * promo.percent_off, 100)\n        elif promo.amount_off_cents is not None:\n            discount = min(subtotal_cents, promo.amount_off_cents)\n        else:\n            raise ValidationError(\"promo is missing a discount\")\n\n    taxable = subtotal_cents - discount\n    tax = compute_tax_cents(taxable, tax_bps)\n    return taxable, tax, taxable + tax, discount\n\n\ndef calculate_order_totals(\n    items: Sequence[LineItem],\n    *,\n    tax_bps: int = 0,\n    legacy_flat_fee: bool = False,\n) -> Tuple[int, int, int]:\n    \"\"\"Return (subtotal_cents, tax_cents, total_cents) using exact integer cents.\"\"\"\n    subtotal = compute_subtotal_cents(items, legacy_flat_fee=legacy_flat_fee)\n    taxable, tax, total, _ = apply_discount_and_tax(subtotal, tax_bps)\n    return taxable, tax, total\n\n\ndef calculate_upgrade_totals(\n    old_plan: Plan,\n    new_plan: Plan,\n    days_remaining: int,\n    cycle_days: int,\n) -> Tuple[int, int, int]:\n    \"\"\"Return the prorated price difference, its tax, and the total in cents.\"\"\"\n    subtotal = compute_upgrade_subtotal_cents(old_plan, new_plan, days_remaining, cycle_days)\n    taxable, tax, total, _ = apply_discount_and_tax(subtotal, new_plan.tax_bps)\n    return taxable, tax, total\n\n\ndef compute_upgrade_subtotal_cents(\n    old_plan: Plan,\n    new_plan: Plan,\n    days_remaining: int,\n    cycle_days: int,\n) -> int:\n    validate_non_negative_int(days_remaining, \"days_remaining\")\n    validate_positive_int(cycle_days, \"cycle_days\")\n    if days_remaining > cycle_days:\n        raise ValidationError(\"days_remaining cannot exceed cycle_days\")\n\n    price_difference = new_plan.monthly_cents - old_plan.monthly_cents\n    if price_difference <= 0:\n        raise ValidationError(\"new plan must cost more than the current plan\")\n\n    return round_half_up_div(price_difference * days_remaining, cycle_days)\n\n\ndef compute_refund_split(\n    order: Order, already_refunded_cents: int, amount_cents: int\n) -> Tuple[int, int]:\n    \"\"\"Return the subtotal and tax to reverse for the next refund.\"\"\"\n    refunded_after = already_refunded_cents + amount_cents\n    if refunded_after > order.total_cents:\n        raise ValidationError(\"refund exceeds the remaining order total\")\n\n    # Rounding each chunk independently can lose tax cents across partial refunds.\n    tax_before = round_half_up_div(order.tax_cents * already_refunded_cents, order.total_cents)\n    tax_after = round_half_up_div(order.tax_cents * refunded_after, order.total_cents)\n    refund_tax = tax_after - tax_before\n    return amount_cents - refund_tax, refund_tax\ntest_invalid_order_inputs_fail_closed (test_orders.BaselineOrderLedgerTests) ... ok\ntest_legacy_flat_fee_adds_500_cents_before_tax (test_orders.BaselineOrderLedgerTests) ... ok\ntest_place_order_computes_exact_integer_tax_and_records_entry (test_orders.BaselineOrderLedgerTests) ... ok\ntest_start_subscription_validates_plan (test_orders.BaselineOrderLedgerTests) ... ok\ntest_expiry_requires_valid_date_and_includes_expiry_day (test_promos.PromoTests) ... ok\ntest_fixed_discount_applies_to_legacy_fee_and_clamps_at_subtotal (test_promos.PromoTests) ... ok\ntest_minimum_is_inclusive_and_checks_pre_discount_subtotal (test_promos.PromoTests) ... ok\ntest_percentage_discount_rounds_half_up_before_tax (test_promos.PromoTests) ... ok\ntest_registration_rejects_invalid_rules (test_promos.PromoTests) ... ok\ntest_unknown_and_stacked_codes_fail_closed (test_promos.PromoTests) ... ok\ntest_upgrade_discounts_prorated_subtotal_and_preserves_idempotency (test_promos.PromoTests) ... ok\ntest_competing_refunds_cannot_exceed_order_total (test_refunds.RefundTests) ... ok\ntest_credit_note_exports_positive_amounts_and_rejects_other_entries (test_refunds.RefundTests) ... ok\ntest_idempotent_replay_after_full_refund_and_conflicts (test_refunds.RefundTests) ... ok\ntest_over_refund_is_rejected_and_does_not_claim_key (test_refunds.RefundTests) ... ok\ntest_partial_refunds_reverse_exact_subtotal_and_tax_across_chunkings (test_refunds.RefundTests) ... ok\ntest_refund_rejects_invalid_arguments_and_zero_total (test_refunds.RefundTests) ... ok\ntest_concurrent_replays_record_one_entry (test_upgrades.SubscriptionUpgradeTests) ... ok\ntest_proration_rounds_on_either_side_of_half_and_accepts_endpoints (test_upgrades.SubscriptionUpgradeTests) ... ok\ntest_rejects_changes_to_each_replay_argument (test_upgrades.SubscriptionUpgradeTests) ... ok\ntest_rejects_invalid_periods_and