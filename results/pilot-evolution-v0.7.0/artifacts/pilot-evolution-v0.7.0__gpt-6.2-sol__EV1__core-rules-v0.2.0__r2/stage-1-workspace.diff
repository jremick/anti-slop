+"""Unit tests for prorated subscription upgrades and idempotency."""
+
+from concurrent.futures import ThreadPoolExecutor
+import unittest
+
+from ev1_order_ledger import OrderService, Plan, ValidationError
+
+
+class SubscriptionUpgradeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.service = OrderService()
+        self.service.register_plan(Plan("starter", "Starter", 100, 0))
+        self.service.register_plan(Plan("pro", "Pro", 109, 1000))
+        self.service.register_plan(Plan("premium", "Premium", 200))
+        self.subscription = self.service.start_subscription("acct_1", "starter")
+
+    def test_half_up_proration_and_tax_are_recorded(self) -> None:
+        # The 9-cent difference becomes 5 cents at half a cycle, then tax rounds to 1.
+        entry = self.service.upgrade_subscription(
+            self.subscription.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (5, 1, 6))
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.subscription.subscription_id)
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual(self.subscription.plan_id, "pro")
+        self.assertIs(self.service.ledger.get_entry(entry.entry_id), entry)
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [entry])
+        self.assertEqual(self.service.get_statement("acct_1")["balance_cents"], 6)
+
+    def test_proration_rounds_below_half_and_accepts_both_endpoints(self) -> None:
+        for days, cycle, expected in ((1, 20, 0), (0, 20, 0), (20, 20, 9)):
+            with self.subTest(days=days, cycle=cycle):
+                sub = self.service.start_subscription("acct_1", "starter")
+                entry = self.service.upgrade_subscription(
+                    sub.subscription_id, "pro", days, cycle, idempotency_key=sub.subscription_id
+                )
+                self.assertEqual(entry.subtotal_cents, expected)
+                self.assertEqual(sub.plan_id, "pro")
+
+    def test_invalid_requests_leave_subscription_and_ledger_unchanged(self) -> None:
+        self.service.register_plan(Plan("equal", "Equal", 100))
+        self.service.register_plan(Plan("cheaper", "Cheaper", 99))
+        self.service.register_plan(Plan("invalid_tax", "Invalid tax", 109, 10_001))
+        valid_args = dict(
+            subscription_id=self.subscription.subscription_id,
+            new_plan_id="pro",
+            days_remaining=1,
+            cycle_days=2,
+            idempotency_key="upgrade",
+        )
+        for field, invalid_values in (
+            ("subscription_id", ("missing", True)),
+            ("new_plan_id", ("missing", "starter", "equal", "cheaper", "invalid_tax", False)),
+            ("days_remaining", (-1, 3, True, 1.0)),
+            ("cycle_days", (-1, 0, False, 2.0)),
+            ("idempotency_key", ("", "  ", True)),
+        ):
+            for value in invalid_values:
+                with self.subTest(field=field, value=value):
+                    with self.assertRaises(ValidationError):
+                        self.service.upgrade_subscription(**{**valid_args, field: value})
+                    self.assertEqual(self.subscription.plan_id, "starter")
+                    self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [])
+
+        self.service.upgrade_subscription(**valid_args)
+        self.assertEqual(self.subscription.plan_id, "pro")
+
+    def test_replay_through_shared_ledger_after_later_upgrade(self) -> None:
+        sub_id = self.subscription.subscription_id
+        original = self.service.upgrade_subscription(sub_id, "pro", 1, 2, idempotency_key="first")
+        later = self.service.upgrade_subscription(sub_id, "premium", 1, 2, idempotency_key="second")
+        other_service = OrderService(self.service.ledger)
+
+        replay = other_service.upgrade_subscription(sub_id, "pro", 1, 2, idempotency_key="first")
+
+        self.assertIs(replay, original)
+        self.assertEqual(self.subscription.plan_id, "premium")
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [original, later])
+
+    def test_reusing_key_with_any_changed_argument_fails(self) -> None:
+        sub_id = self.subscription.subscription_id
+        other_sub = self.service.start_subscription("acct_2", "starter")
+        original = self.service.upgrade_subscription(sub_id, "pro", 1, 2, idempotency_key="upgrade")
+
+        for args in (
+            (other_sub.subscription_id, "pro", 1, 2),
+            (sub_id, "premium", 1, 2),
+            (sub_id, "pro", 0, 2),
+            (sub_id, "pro", 1, 3),
+            (sub_id, "pro", True, 2),  # True compares equal to 1.
+        ):
+            with self.subTest(args=args):
+                with self.assertRaises(ValidationError):
+                    self.service.upgrade_subscription(*args, idempotency_key="upgrade")
+
+        self.assertEqual(self.subscription.plan_id, "pro")
+        self.assertEqual(other_sub.plan_id, "starter")
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [original])
+        self.assertEqual(self.service.ledger.entries_for_account("acct_2"), [])
+
+    def test_concurrent_replays_share_one_entry(self) -> None:
+        def upgrade(_: int):
+            return self.service.upgrade_subscription(
+                self.subscription.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+            )
+
+        with ThreadPoolExecutor(max_workers=4) as pool:
+            entries = list(pool.map(upgrade, range(8)))
+
+        for entry in entries:
+            self.assertIs(entry, entries[0])
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [entries[0]])
