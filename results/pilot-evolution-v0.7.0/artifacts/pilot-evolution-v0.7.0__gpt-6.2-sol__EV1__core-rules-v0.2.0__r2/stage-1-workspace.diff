+    def apply_subscription_upgrade(
+        self,
+        subscription_id: str,
+        new_plan_id: str,
+        days_remaining: int,
+        cycle_days: int,
+        *,
+        idempotency_key: str,
+    ) -> LedgerEntry:
+        """Apply a validated upgrade request or return its recorded result."""
+        request = (subscription_id, new_plan_id, days_remaining, cycle_days)
+        with self._lock:
+            prior = self._upgrade_requests.get(idempotency_key)
+            if prior is not None:
+                prior_request, entry = prior
+                if request != prior_request:
+                    raise ValidationError("idempotency_key already used for a different upgrade")
+                return entry
+
+            sub = self.get_subscription(subscription_id)
+            old_plan = self.get_plan(sub.plan_id)
+            new_plan = self.get_plan(new_plan_id)
+            subtotal, tax, total = calculate_upgrade_totals(
+                old_plan, new_plan, days_remaining, cycle_days
+            )
+            entry = LedgerEntry(
+                entry_id=self.next_id("ent"),
+                account_id=sub.account_id,
+                kind="plan_upgrade",
+                subtotal_cents=subtotal,
+                tax_cents=tax,
+                total_cents=total,
+                reference_id=subscription_id,
+            )
+            self.record_entry(entry)
+            sub.plan_id = new_plan_id
+            self._upgrade_requests[idempotency_key] = (request, entry)
+            return entry
+
     def record_entry(self, entry: LedgerEntry) -> None:
         self._entries[entry.entry_id] = entry
