+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [])
+        failed_entry_id = self.sink.call_args.args[0]["entry_id"]
+        self.assertIsNone(self.service.ledger.get_entry(failed_entry_id))
+
+        self.sink.side_effect = None
+        entry = self.service.upgrade_subscription(*args, idempotency_key="upgrade")
+        self.assertEqual(sub.plan_id, "pro")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [entry])
+        self.assertEqual(self.sink.call_count, 2)
+
+    def test_refund_audit_failure_preserves_balance_and_allows_same_key_retry(self) -> None:
+        order = self.service.place_order("acct", self.items)
+        self.sink.side_effect = self.error
+        fields = dict(reason="returned", idempotency_key="refund")
+        with self.assertRaises(RuntimeError) as failure:
+            self.service.refund_order(order.order_id, order.total_cents, **fields)
+        self.assertIs(failure.exception, self.error)
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], order.total_cents)
+        self.assertEqual(self.service.get_statement("acct")["entry_count"], 1)
+        failed_entry_id = self.sink.call_args.args[0]["entry_id"]
+        with self.assertRaises(ValidationError):
+            self.service.export_credit_note(failed_entry_id)
+
+        self.sink.side_effect = None
+        self.service.refund_order(order.order_id, order.total_cents, **fields)
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], 0)
+        self.assertEqual(self.service.get_statement("acct")["entry_count"], 2)
+        self.assertEqual(self.sink.call_count, 3)
+
+    def test_sink_cannot_commit_a_second_refund_during_audit(self) -> None:
+        order = self.service.place_order("acct", self.items)
+        other_service = OrderService(self.service.ledger)
+
+        def refund_during_audit(_event) -> None:
+            other_service.refund_order(
+                order.order_id, 60, reason="return", idempotency_key="second"
+            )
+
+        self.sink.side_effect = refund_during_audit
+        with self.assertRaisesRegex(RuntimeError, "cannot commit another mutation"):
+            self.service.refund_order(
+                order.order_id, 60, reason="return", idempotency_key="first"
+            )
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], 100)
+        self.assertEqual(self.service.get_statement("acct")["entry_count"], 1)

