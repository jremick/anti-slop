+        self.error = RuntimeError("audit unavailable")
+
+    def start_subscription(self):
+        self.service.register_plan(Plan("starter", "Starter", 100))
+        self.service.register_plan(Plan("pro", "Pro", 300))
+        return self.service.start_subscription("acct", "starter")
+
+    def test_audit_payloads_for_new_entries_only(self) -> None:
+        order = self.service.place_order("acct", self.items, tax_bps=1000)
+        sub = self.start_subscription()
+        upgrade = self.service.upgrade_subscription(
+            sub.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+        refund = self.service.refund_order(
+            order.order_id, 50, reason="return", idempotency_key="refund"
+        )
