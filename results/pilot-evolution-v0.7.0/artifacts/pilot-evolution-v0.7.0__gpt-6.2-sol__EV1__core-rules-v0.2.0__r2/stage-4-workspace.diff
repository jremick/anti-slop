+"""Partial refunds and credit notes through the order service."""
+
+from concurrent.futures import ThreadPoolExecutor
+import unittest
+
+from ev1_order_ledger import LineItem, OrderService, ValidationError
+
+
+class RefundTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.service = OrderService()
+        self.service.register_promo("SAVE", amount_off_cents=5)
+        self.order = self.service.place_order(
+            "acct", [LineItem("seat", 12, 1)], tax_bps=4286, promo_code="SAVE"
+        )
+
+    def test_partial_refunds_conserve_discounted_subtotal_and_rounded_tax(self) -> None:
+        self.assertEqual((self.order.subtotal_cents, self.order.tax_cents, self.order.total_cents), (7, 3, 10))
+        refunds = []
+        for index, (amount, tax) in enumerate(((1, 0), (1, 1), (3, 1), (1, 0), (4, 1))):
+            refund = self.service.refund_order(
+                self.order.order_id, amount, reason="partial return", idempotency_key=str(index)
+            )
+            self.assertEqual(refund.kind, "order_refund")
+            self.assertEqual(refund.reference_id, self.order.order_id)
+            self.assertEqual(refund.account_id, self.order.account_id)
+            self.assertEqual(refund.total_cents, -amount)
+            self.assertEqual(refund.tax_cents, -tax)
+            self.assertEqual(refund.subtotal_cents + refund.tax_cents, refund.total_cents)
+            refunds.append(refund)
+
+        self.assertEqual(sum(entry.tax_cents for entry in refunds), -self.order.tax_cents)
+        self.assertEqual(sum(entry.subtotal_cents for entry in refunds), -self.order.subtotal_cents)
+        statement = self.service.get_statement("acct")
+        self.assertEqual(statement["balance_cents"], 0)
+        self.assertEqual(statement["entry_count"], 1 + len(refunds))
+
+    def test_over_refund_is_rejected_and_failed_key_can_be_retried(self) -> None:
+        order_id = self.order.order_id
+        self.service.refund_order(order_id, 6, reason="return", idempotency_key="first")
+        with self.assertRaises(ValidationError):
+            self.service.refund_order(order_id, 5, reason="return", idempotency_key="second")
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], 4)
+        self.assertEqual(self.service.get_statement("acct")["entry_count"], 2)
+
+        self.service.refund_order(order_id, 4, reason="return", idempotency_key="second")
+        with self.assertRaises(ValidationError):
+            self.service.refund_order(order_id, 1, reason="return", idempotency_key="third")
+
+    def test_replay_returns_original_after_full_refund_and_conflicts_fail(self) -> None:
+        order_id = self.order.order_id
+        fields = dict(order_id=order_id, amount_cents=1, reason="return", idempotency_key="first")
+        original = self.service.refund_order(**fields)
+        self.service.refund_order(order_id, 9, reason="return", idempotency_key="second")
+        other_order = self.service.place_order("acct", [LineItem("seat", 12, 1)])
+        other_service = OrderService(self.service.ledger)
+
+        self.assertIs(other_service.refund_order(**fields), original)
+        for field, value in (
+            ("order_id", other_order.order_id), ("amount_cents", 2), ("reason", "changed"),
+        ):
+            with self.subTest(field=field), self.assertRaisesRegex(ValidationError, "idempotency_key"):
+                other_service.refund_order(**{**fields, field: value})
+        self.assertEqual(self.service.get_statement("acct")["entry_count"], 4)
+
+    def test_invalid_refund_arguments_do_not_record_entries(self) -> None:
+        fields = dict(order_id=self.order.order_id, amount_cents=1, reason="return", idempotency_key="key")
+        for field, values in (
+            ("order_id", ("missing", [], "")),
+            ("amount_cents", (0, -1, True, 1.0)),
+            ("reason", ("", "  ", None)),
+            ("idempotency_key", ("", "  ", False)),
+        ):
+            for value in values:
+                with self.subTest(field=field, value=value), self.assertRaises(ValidationError):
+                    self.service.refund_order(**{**fields, field: value})
+        self.assertEqual(self.service.get_statement("acct")["entry_count"], 1)
+
+    def test_credit_note_exports_positive_magnitudes_for_refunds_only(self) -> None:
+        [charge] = self.service.ledger.entries_for_account("acct")
+        refund = self.service.refund_order(
+            self.order.order_id, 5, reason="returned seat", idempotency_key="refund"
+        )
+        self.assertEqual(self.service.export_credit_note(refund.entry_id), {
+            "entry_id": refund.entry_id,
+            "order_id": self.order.order_id,
+            "account_id": "acct",
+            "subtotal_cents": 3,
+            "tax_cents": 2,
+            "total_cents": 5,
+            "reason": "returned seat",
+        })
+        for entry_id in (charge.entry_id, "missing"):
+            with self.subTest(entry_id=entry_id), self.assertRaises(ValidationError):
+                self.service.export_credit_note(entry_id)
+
+    def test_concurrent_refunds_cannot_exceed_order_total(self) -> None:
+        with ThreadPoolExecutor(max_workers=2) as pool:
+            attempts = [
+                pool.submit(
+                    self.service.refund_order,
+                    self.order.order_id,
+                    6,
+                    reason="return",
+                    idempotency_key=key,
+                )
+                for key in ("first", "second")
+            ]
+        self.assertEqual(sum(isinstance(attempt.exception(), ValidationError) for attempt in attempts), 1)
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], 4)
+        self.assertEqual(self.service.get_statement("acct")["entry_count"], 2)

