{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"PYTHONPATH=benchmarks/sources python3 - <<'PY'\nfrom fractions import Fraction\n\nfrom ev1_order_ledger import Order\nfrom ev1_order_ledger.pricing import calculate_refund_split\n\nchecked = 0\nfor subtotal in range(1, 26):\n    for tax in range(subtotal + 1):\n        total = subtotal + tax\n        order = Order(\\\"order\\\", \\\"account\\\", (), subtotal, tax, total)\n        for before in range(total):\n            previous_tax = int(Fraction(before * tax, total) + Fraction(1, 2))\n            for after in range(before + 1, total + 1):\n                part_subtotal, part_tax = calculate_refund_split(order, before, after - before)\n                expected_tax = int(Fraction(after * tax, total) + Fraction(1, 2))\n                assert part_subtotal >= 0 and part_tax >= 0\n                assert part_subtotal + part_tax == after - before\n                assert previous_tax + part_tax == expected_tax\n                if after == total:\n                    assert expected_tax == tax and after - expected_tax == subtotal\n                checked += 1\nprint(f\\\"Verified {checked:,} refund transitions against exact fractions.\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
