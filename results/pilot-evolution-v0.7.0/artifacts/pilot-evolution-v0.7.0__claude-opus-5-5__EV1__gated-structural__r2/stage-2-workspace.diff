+"""Tests for promo codes applied to orders and subscription upgrades."""
+
+from __future__ import annotations
+
+import unittest
+from datetime import date
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, ValidationError
+from ev1_order_ledger.pricing import Charge, build_promo, price_charge
+
+
+STARTER = Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=825)
+PRO = Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825)
+
+SEATS = [LineItem(sku="seat", unit_cents=1999, quantity=2)]  # 3998 cents
+
+
+def _promo(code: str, **kwargs):
+    kwargs.setdefault("percent_off", None)
+    kwargs.setdefault("amount_off_cents", None)
+    kwargs.setdefault("expires_on", None)
+    kwargs.setdefault("min_subtotal_cents", 0)
+    return build_promo(code, **kwargs)
+
+
+class PriceChargeHelperTests(unittest.TestCase):
+    """The shared canonical discount + tax helper."""
+
+    def test_no_promo_is_plain_tax(self) -> None:
+        self.assertEqual(price_charge(1000, 825), Charge(1000, 0, 1000, 83, 1083))
+
+    def test_percent_discount_rounds_half_up_then_taxes_discounted_subtotal(self) -> None:
+        # 15% of 1010 = 151.5 -> 152; 858 * 10% = 85.8 -> 86
+        promo = _promo("P15", percent_off=15)
+        self.assertEqual(price_charge(1010, 1000, promo=promo), Charge(1010, 152, 858, 86, 944))
+
+    def test_fixed_discount_clamps_at_zero(self) -> None:
+        promo = _promo("BIG", amount_off_cents=5000)
+        self.assertEqual(price_charge(1000, 825, promo=promo), Charge(1000, 1000, 0, 0, 0))
+
+    def test_expiry_uses_as_of_inclusively(self) -> None:
+        promo = _promo("EXP", percent_off=10, expires_on="2026-06-30")
+        self.assertEqual(price_charge(1000, 0, promo=promo, as_of=date(2026, 6, 30)).discount_cents, 100)
+        with self.assertRaises(ValidationError):
+            price_charge(1000, 0, promo=promo, as_of=date(2026, 7, 1))
+        with self.assertRaises(ValidationError):
+            price_charge(1000, 0, promo=promo)
+
+
+class RegisterPromoTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+
+    def test_registers_percent_and_fixed_promos(self) -> None:
+        pct = self.svc.register_promo("SAVE10", percent_off=10)
+        fixed = self.svc.register_promo("FIVE", amount_off_cents=500, expires_on="2026-12-31", min_subtotal_cents=1000)
+        self.assertEqual((pct.percent_off, pct.amount_off_cents, pct.expires_on), (10, None, None))
+        self.assertEqual(fixed.amount_off_cents, 500)
+        self.assertEqual(fixed.expires_on, date(2026, 12, 31))
+        self.assertEqual(fixed.min_subtotal_cents, 1000)
+        self.assertEqual(self.svc.register_promo("ALL", percent_off=100).percent_off, 100)
+
+    def test_rejects_invalid_definitions(self) -> None:
+        bad = [
+            ("", {"percent_off": 10}),
+            ("   ", {"percent_off": 10}),
+            (None, {"percent_off": 10}),
+            ("A,B", {"percent_off": 10}),
+            ("A B", {"percent_off": 10}),
+            ("X", {}),
+            ("X", {"percent_off": 10, "amount_off_cents": 100}),
+            ("X", {"percent_off": 0}),
+            ("X", {"percent_off": 101}),
+            ("X", {"percent_off": -5}),
+            ("X", {"percent_off": True}),
+            ("X", {"percent_off": 12.5}),
+            ("X", {"amount_off_cents": 0}),
+            ("X", {"amount_off_cents": -100}),
+            ("X", {"amount_off_cents": True}),
+            ("X", {"percent_off": 10, "min_subtotal_cents": -1}),
+            ("X", {"percent_off": 10, "min_subtotal_cents": True}),
+            ("X", {"percent_off": 10, "expires_on": "2026/12/31"}),
+            ("X", {"percent_off": 10, "expires_on": "2026-02-30"}),
+            ("X", {"percent_off": 10, "expires_on": date(2026, 12, 31)}),
