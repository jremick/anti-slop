+
+    def test_duplicate_code_is_rejected(self) -> None:
+        self.svc.register_promo("SAVE10", percent_off=10)
+        with self.assertRaises(ValidationError):
+            self.svc.register_promo("SAVE10", amount_off_cents=100)
+        self.assertEqual(self.svc.ledger.get_promo("SAVE10").percent_off, 10)
