+        self.assertEqual(self.svc.ledger.get_subscription(self.sub.subscription_id).plan_id, "pro")
+        self.assertEqual(self._entries(), [entry])
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 1083)
+
+    def test_half_up_rounding_through_service(self) -> None:
+        entry = self.svc.upgrade_subscription(
+            self.sub.subscription_id, "starter_plus", 1, 2, idempotency_key="up-half"
+        )
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (13, 0, 13))
+
+    def test_successive_upgrades_prorate_from_current_plan(self) -> None:
+        self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 20, 30, idempotency_key="k1")
+        second = self.svc.upgrade_subscription(
+            self.sub.subscription_id, "enterprise", 10, 30, idempotency_key="k2"
+        )
+        # (9000 - 3000) * 10 / 30 = 2000; tax 165
+        self.assertEqual((second.subtotal_cents, second.tax_cents, second.total_cents), (2000, 165, 2165))
+        self.assertEqual(second.metadata["old_plan_id"], "pro")
+        self.assertEqual(len(self._entries()), 2)
+
+    def test_invalid_requests_raise_and_leave_state_untouched(self) -> None:
+        sid = self.sub.subscription_id
+        bad_calls = [
+            ("sub_missing", "pro", 15, 30, "k"),
+            (sid, "missing_plan", 15, 30, "k"),
+            (sid, "starter", 15, 30, "k"),
+            (sid, "starter_twin", 15, 30, "k"),
+            (sid, "pro", 15, 0, "k"),
+            (sid, "pro", 15, -1, "k"),
+            (sid, "pro", -1, 30, "k"),
+            (sid, "pro", 31, 30, "k"),
+            (sid, "pro", True, 30, "k"),
+            (sid, "pro", 15, True, "k"),
+            (sid, "pro", False, 30, "k"),
+            (sid, "pro", 15, 30, ""),
+            (sid, "pro", 15, 30, "   "),
+            (sid, "pro", 15, 30, None),
+        ]
+        for sub_id, plan_id, days, cycle, key in bad_calls:
+            with self.subTest(sub_id=sub_id, plan_id=plan_id, days=days, cycle=cycle, key=key):
