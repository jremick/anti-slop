+"""Unit tests for Turn 1: mid-cycle prorated plan upgrades and idempotency."""
+
+from __future__ import annotations
+
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.ledger import OrderLedger
+from ev1_order_ledger.models import LedgerEntry, Plan, ValidationError
+from ev1_order_ledger.pricing import (
+    calculate_plan_upgrade_totals,
+    compute_prorated_upgrade_cents,
+)
+
+
+class PlanUpgradeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.svc.register_plan(Plan(plan_id="free", name="Free", monthly_cents=0, tax_bps=0))
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=500))
+        self.svc.register_plan(Plan(plan_id="starter_alt", name="Starter Alt", monthly_cents=1000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="plus", name="Plus", monthly_cents=2005, tax_bps=100))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="enterprise", name="Enterprise", monthly_cents=10000, tax_bps=1000))
+
+    def test_proration_half_up_rounding_and_new_plan_tax_rate(self) -> None:
+        sub = self.svc.start_subscription("acct_1", "starter")
+        # delta = 2005 - 1000 = 1005; 1005 * 15 / 30 = 502.5 -> half-up rounds to 503 (not banker's 502)
+        # tax uses new_plan.tax_bps (100, not starter's 500): 503 * 100 / 10000 = 5.03 -> 5
+        entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "plus",
+            15,
+            30,
+            idempotency_key="upg-half-up-1",
+        )
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, sub.subscription_id)
+        self.assertEqual(entry.subtotal_cents, 503)
+        self.assertEqual(entry.tax_cents, 5)
+        self.assertEqual(entry.total_cents, 508)
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "plus")
+
+        stmt = self.svc.get_statement("acct_1")
+        self.assertEqual(stmt["balance_cents"], 508)
+        self.assertEqual(stmt["entry_count"], 1)
+
+    def test_proration_half_up_for_both_subtotal_and_tax_ties(self) -> None:
+        self.svc.register_plan(Plan(plan_id="mid", name="Mid", monthly_cents=1500, tax_bps=100))
+        sub = self.svc.start_subscription("acct_2", "starter")
+        # delta = 500; 500 * 15 / 30 = 250; tax = 250 * 100 / 10000 = 2.5 -> 3 (half-up, not 2)
+        entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "mid",
+            15,
+            30,
+            idempotency_key="upg-tax-tie",
+        )
+        self.assertEqual(entry.subtotal_cents, 250)
+        self.assertEqual(entry.tax_cents, 3)
+        self.assertEqual(entry.total_cents, 253)
+
+    def test_proration_fractional_rounding_down_and_up(self) -> None:
+        # 5 * 1 / 2 = 2.5 -> 3 (half-up)
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 1005, 1, 2), 3)
+        # 1000 * 1 / 3 = 333.333... -> 333
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 2000, 1, 3), 333)
+        # 2000 * 1 / 3 = 666.666... -> 667
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 3000, 1, 3), 667)
+
+        old_plan = Plan(plan_id="a", name="A", monthly_cents=1000, tax_bps=0)
+        new_plan = Plan(plan_id="b", name="B", monthly_cents=3000, tax_bps=825)
+        # subtotal = 667, tax = 667 * 825 / 10000 = 55.0275 -> 55
+        self.assertEqual(calculate_plan_upgrade_totals(old_plan, new_plan, 1, 3), (667, 55, 722))
+
+    def test_proration_boundary_days_zero_full_cycle_and_free_plan(self) -> None:
+        sub_zero = self.svc.start_subscription("acct_zero", "starter")
+        entry_zero = self.svc.upgrade_subscription(
+            sub_zero.subscription_id,
+            "pro",
+            0,
+            30,
+            idempotency_key="upg-zero-days",
+        )
+        self.assertEqual((entry_zero.subtotal_cents, entry_zero.tax_cents, entry_zero.total_cents), (0, 0, 0))
+        self.assertEqual(self.svc.ledger.get_subscription(sub_zero.subscription_id).plan_id, "pro")
+
+        sub_full = self.svc.start_subscription("acct_full", "free")
+        entry_full = self.svc.upgrade_subscription(
+            sub_full.subscription_id,
+            "pro",
+            30,
+            30,
+            idempotency_key="upg-full-cycle",
+        )
+        # delta = 3000, tax = 3000 * 825 / 10000 = 247.5 -> 248
+        self.assertEqual((entry_full.subtotal_cents, entry_full.tax_cents, entry_full.total_cents), (3000, 248, 3248))
+        self.assertEqual(self.svc.ledger.get_subscription(sub_full.subscription_id).plan_id, "pro")
+
+    def test_rejects_unknown_ids_non_upgrades_bounds_booleans_and_empty_key(self) -> None:
+        sub = self.svc.start_subscription("acct_err", "pro")
+
+        invalid_calls = [
+            # Unknown IDs
+            ("sub_missing", "enterprise", 15, 30, "k-unknown-sub"),
+            (sub.subscription_id, "plan_missing", 15, 30, "k-unknown-plan"),
+            ("", "enterprise", 15, 30, "k-empty-sub"),
+            (sub.subscription_id, "   ", 15, 30, "k-blank-plan"),
+            # Non-upgrades (same plan, same price, downgrade)
+            (sub.subscription_id, "pro", 15, 30, "k-same-plan"),
+            (sub.subscription_id, "starter", 15, 30, "k-downgrade"),
+            # Invalid bounds
+            (sub.subscription_id, "enterprise", 15, 0, "k-zero-cycle"),
+            (sub.subscription_id, "enterprise", 15, -30, "k-neg-cycle"),
+            (sub.subscription_id, "enterprise", -1, 30, "k-neg-days"),
+            (sub.subscription_id, "enterprise", 31, 30, "k-days-gt-cycle"),
+            # Booleans and invalid types
+            (sub.subscription_id, "enterprise", True, 30, "k-bool-days-true"),
+            (sub.subscription_id, "enterprise", False, 30, "k-bool-days-false"),
+            (sub.subscription_id, "enterprise", 1, True, "k-bool-cycle-true"),
+            (sub.subscription_id, "enterprise", 0, False, "k-bool-cycle-false"),
+            (True, "enterprise", 15, 30, "k-bool-sub"),
+            (sub.subscription_id, False, 15, 30, "k-bool-plan"),
+            # Empty / invalid idempotency_key
+            (sub.subscription_id, "enterprise", 15, 30, ""),
+            (sub.subscription_id, "enterprise", 15, 30, "   "),
+            (sub.subscription_id, "enterprise", 15, 30, True),
+            (sub.subscription_id, "enterprise", 15, 30, None),
+        ]
+
+        for sub_id, plan_id, days_rem, cycle_days, key in invalid_calls:
+            with self.subTest(sub_id=sub_id, plan_id=plan_id, days_rem=days_rem, cycle_days=cycle_days, key=key):
+                with self.assertRaises(ValidationError):
+                    self.svc.upgrade_subscription(
+                        sub_id,
+                        plan_id,
+                        days_rem,
+                        cycle_days,
+                        idempotency_key=key,
+                    )
+
+        # Also test equal-price different plan
+        sub_starter = self.svc.start_subscription("acct_err", "starter")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(
+                sub_starter.subscription_id,
+                "starter_alt",
+                10,
+                30,
+                idempotency_key="k-equal-price",
+            )
+
+        # None of the failed attempts mutated subscriptions or recorded entries
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "pro")
+        self.assertEqual(self.svc.ledger.get_subscription(sub_starter.subscription_id).plan_id, "starter")
+        self.assertEqual(self.svc.get_statement("acct_err")["entry_count"], 0)
+
+        # A key from a failed call is not burned and can succeed on a valid request
+        ok_entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "enterprise",
+            15,
+            30,
+            idempotency_key="k-downgrade",
+        )
+        self.assertEqual(ok_entry.subtotal_cents, 3500)
+        self.assertEqual(self.svc.get_statement("acct_err")["entry_count"], 1)
+
+    def test_idempotency_replay_returns_original_entry_without_duplicate(self) -> None:
+        sub = self.svc.start_subscription("acct_idem", "starter")
+        first = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            10,
+            30,
+            idempotency_key="idem-replay-1",
+        )
+        replay = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            10,
+            30,
+            idempotency_key="idem-replay-1",
+        )
+        self.assertIs(replay, first)
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "pro")
+        stmt = self.svc.get_statement("acct_idem")
+        self.assertEqual(stmt["entry_count"], 1)
+        self.assertEqual(stmt["balance_cents"], first.total_cents)
+
+        # Even after a subsequent upgrade to enterprise, replaying the first key still returns first entry
+        second = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "enterprise",
+            10,
+            30,
+            idempotency_key="idem-replay-2",
+        )
+        self.assertNotEqual(second.entry_id, first.entry_id)
+        replay_after_second = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            10,
+            30,
+            idempotency_key="idem-replay-1",
+        )
+        self.assertIs(replay_after_second, first)
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "enterprise")
+        self.assertEqual(self.svc.get_statement("acct_idem")["entry_count"], 2)
+
+    def test_idempotency_conflict_raises_validation_error(self) -> None:
+        sub1 = self.svc.start_subscription("acct_conf", "starter")
+        sub2 = self.svc.start_subscription("acct_conf", "starter")
+
+        original = self.svc.upgrade_subscription(
+            sub1.subscription_id,
+            "pro",
+            1,
