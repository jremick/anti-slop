+    def get_idempotent_entry(
+        self,
+        idempotency_key: str,
+        request_fingerprint: Tuple[object, ...],
+    ) -> Optional[LedgerEntry]:
+        """Return existing entry on identical replay, None if unseen, or raise on conflict."""
+        validate_idempotency_key(idempotency_key)
+        existing = self._idempotency_records.get(idempotency_key)
+        if existing is None:
+            return None
+        stored_fingerprint, entry_id = existing
+        if stored_fingerprint != _typed_fingerprint(request_fingerprint):
+            raise ValidationError(f"Idempotency key conflict: {idempotency_key}")
+        return self._entries[entry_id]
+
+    def record_idempotent_entry(
+        self,
+        idempotency_key: str,
+        request_fingerprint: Tuple[object, ...],
+        entry: LedgerEntry,
+    ) -> LedgerEntry:
+        """Record a ledger entry under an idempotency key, enforcing replay/conflict rules."""
+        existing = self.get_idempotent_entry(idempotency_key, request_fingerprint)
+        if existing is not None:
+            return existing
+        self.record_entry(entry)
+        self._idempotency_records[idempotency_key] = (
+            _typed_fingerprint(request_fingerprint),
+            entry.entry_id,
+        )
+        return entry
+
     def get_entry(self, entry_id: str) -> Optional[LedgerEntry]:
         return self._entries.get(entry_id)
 

