+"""Subscription upgrade pricing, validation, and ledger replay tests."""
+
+import unittest
+
+from ev1_order_ledger import OrderService, Plan, ValidationError
+
+
+class UpgradeTests(unittest.TestCase):
+    def setUp(self):
+        self.service = OrderService()
+        self.service.register_plan(Plan("basic", "Basic", 100, 0))
+        self.service.register_plan(Plan("pro", "Pro", 105, 5000))
+        self.service.register_plan(Plan("premium", "Premium", 200))
+        self.sub = self.service.start_subscription("acct", "basic")
+
+    def upgrade(self, remaining=1, cycle=2, plan="pro", key="upgrade"):
+        return self.service.upgrade_subscription(
+            self.sub.subscription_id, plan, remaining, cycle, idempotency_key=key
+        )
+
+    def test_half_up_proration_then_half_up_tax(self):
+        entry = self.upgrade()
+        # 5 cents * 1/2 rounds to 3 cents. Tax on those 3 cents rounds to 2.
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (3, 2, 5))
+        self.assertEqual((entry.account_id, entry.kind, entry.reference_id),
+                         ("acct", "plan_upgrade", self.sub.subscription_id))
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [entry])
+
+    def test_proration_boundaries_and_large_integer_precision(self):
+        for days, cycle, difference, expected in (
+            (0, 30, 5, 0), (30, 30, 5, 5), (2, 3, 5, 3),
+            (1, 2, 2**54 + 1, 2**53 + 1),
+        ):
+            with self.subTest(days=days, cycle=cycle, difference=difference):
+                self.service.register_plan(Plan("target", "Target", 100 + difference))
+                sub = self.service.start_subscription("acct", "basic")
+                entry = self.service.upgrade_subscription(
+                    sub.subscription_id, "target", days, cycle, idempotency_key=sub.subscription_id
+                )
+                self.assertEqual(entry.total_cents, expected)
+                self.assertEqual(sub.plan_id, "target")
+
+    def test_invalid_requests_leave_plan_entries_and_key_untouched(self):
+        self.service.register_plan(Plan("equal", "Equal", 100))
+        self.service.register_plan(Plan("lower", "Lower", 99))
+        self.service.register_plan(Plan("bad-tax", "Bad tax", 105, 10001))
+        for changes in (
+            {"cycle": 0}, {"cycle": -1}, {"remaining": -1}, {"remaining": 3},
+            {"remaining": True}, {"cycle": False}, {"plan": True}, {"key": True},
+            {"key": ""}, {"key": "  "}, {"plan": "unknown"}, {"plan": "basic"},
+            {"plan": "equal"}, {"plan": "lower"}, {"plan": "bad-tax"},
+        ):
+            with self.subTest(changes=changes), self.assertRaises(ValidationError):
+                self.upgrade(**changes)
+        for unknown in ("missing", True):
+            with self.assertRaises(ValidationError):
+                self.service.upgrade_subscription(unknown, "pro", 1, 2, idempotency_key="upgrade")
+        self.assertEqual(self.sub.plan_id, "basic")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [])
+        self.assertEqual(self.upgrade().total_cents, 5)
+
+    def test_replay_after_later_upgrade_uses_original_entry(self):
+        first = self.upgrade()
+        second = self.upgrade(plan="premium", key="next")
+        other_service = OrderService(self.service.ledger)
+        replay = other_service.upgrade_subscription(
+            self.sub.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+        self.assertIs(replay, first)
+        self.assertEqual(self.sub.plan_id, "premium")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [first, second])
+
+    def test_conflicts_check_every_argument_and_preserve_original(self):
+        first = self.upgrade(cycle=1)
+        other = self.service.start_subscription("acct", "basic")
+        for sub_id, plan, days, cycle in (
+            (other.subscription_id, "pro", 1, 1),
+            (self.sub.subscription_id, "premium", 1, 1),
+            (self.sub.subscription_id, "pro", 0, 1),
+            (self.sub.subscription_id, "pro", 1, 2),
+            (self.sub.subscription_id, "pro", True, 1),
+            (self.sub.subscription_id, "pro", 1, True),
+        ):
+            with self.subTest(sub_id=sub_id, plan=plan, days=days, cycle=cycle):
+                with self.assertRaises(ValidationError):
+                    self.service.upgrade_subscription(sub_id, plan, days, cycle, idempotency_key="upgrade")
+        self.assertIs(self.upgrade(cycle=1), first)
+        self.assertEqual((self.sub.plan_id, other.plan_id), ("pro", "basic"))
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [first])
