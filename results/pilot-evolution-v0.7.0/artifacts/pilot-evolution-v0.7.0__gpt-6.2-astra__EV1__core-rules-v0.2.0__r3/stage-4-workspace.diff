+import unittest
+from unittest.mock import Mock, patch
+
+from ev1_order_ledger import LineItem, OrderService, Plan, ValidationError
+
+
+class AuditTests(unittest.TestCase):
+    def setUp(self):
+        self.events = []
+        self.service = OrderService(audit_sink=self.events.append)
+        self.service.register_plan(Plan("basic", "Basic", 100))
+        self.service.register_plan(Plan("pro", "Pro", 200))
+        self.sub = self.service.start_subscription("acct", "basic")
+        self.items = [LineItem("item", 20, 1)]
+
+    def upgrade(self, service):
+        return service.upgrade_subscription(
+            self.sub.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+
+    def refund(self, service, order):
+        return service.refund_order(order.order_id, 7, reason="return", idempotency_key="refund")
+
+    def test_emits_exact_events_once_per_new_entry(self):
+        order = self.service.place_order("acct", self.items)
+        charge, = self.service.ledger.entries_for_account("acct")
+        upgrade = self.upgrade(self.service)
+        refund = self.refund(self.service, order)
+        self.assertIs(self.upgrade(self.service), upgrade)
+        self.assertIs(self.refund(self.service, order), refund)
+        with self.assertRaises(ValidationError):
+            self.service.refund_order(order.order_id, 8, reason="return", idempotency_key="refund")
+        self.assertEqual(self.events, [
+            {"action": "order_charge", "account_id": "acct", "amount_cents": 20, "entry_id": charge.entry_id},
+            {"action": "plan_upgrade", "account_id": "acct", "amount_cents": 50, "entry_id": upgrade.entry_id},
+            {"action": "order_refund", "account_id": "acct", "amount_cents": -7, "entry_id": refund.entry_id},
+        ])
+
+    def test_sink_error_propagates_before_any_billing_state_is_written(self):
+        ledger = self.service.ledger
+        order = self.service.place_order("acct", self.items)
+        original_entries = ledger.entries_for_account("acct")
+        error = RuntimeError("audit unavailable")
+        sink = Mock(side_effect=error)
+        failing = OrderService(ledger, audit_sink=sink)
+
+        with patch.object(ledger, "save_order", wraps=ledger.save_order) as save_order:
+            for operation in (
+                lambda: failing.place_order("acct", self.items),
+                lambda: self.upgrade(failing),
+                lambda: self.refund(failing, order),
+            ):
+                with self.assertRaises(RuntimeError) as caught:
+                    operation()
+                self.assertIs(caught.exception, error)
+                event, = sink.call_args.args
+                self.assertIsNone(ledger.get_entry(event["entry_id"]))
+                self.assertEqual(ledger.entries_for_account("acct"), original_entries)
+                self.assertEqual(self.sub.plan_id, "basic")
+            save_order.assert_not_called()
+
+        self.assertEqual(sink.call_count, 3)
+        # The same ledger can accept both idempotency keys after audit recovers.
+        self.upgrade(self.service)
+        self.refund(self.service, order)
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], 63)

