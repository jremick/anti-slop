+        self.service.register_promo("FIXED", amount_off_cents=200)
+        order = self.order("FIXED")
+        self.assertEqual((order.discount_cents, order.subtotal_cents, order.total_cents), (101, 0, 0))
+
+    def test_invalid_promos_leave_both_charge_paths_untouched(self):
+        self.service.register_promo("A", percent_off=100, expires_on="2026-04-30")
+        self.service.register_promo("B", amount_off_cents=10, min_subtotal_cents=102)
+        for charge in (self.order, self.upgrade):
+            for code, day in (
+                ("unknown", None), ("A,B", "2026-04-29"), ("B", None), ("A", None),
+                ("A", "2026-05-01"), ("A", "2026-02-30"), ("A", "20260429"),
+            ):
+                with self.subTest(path=charge.__name__, code=code, day=day):
+                    with self.assertRaises(ValidationError):
+                        charge(code, as_of=day)
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [])
+        self.assertEqual(self.sub.plan_id, "base")
+        self.assertEqual(self.order("A", as_of="2026-04-30").discount_cents, 101)
+        self.assertEqual(self.upgrade("A", as_of="2026-04-30").total_cents, 0)
+
+    def test_upgrade_discounts_prorated_charge_and_replays_original(self):
+        self.service.register_promo("SAVE", amount_off_cents=16, expires_on="2026-04-30")
+        entry = self.upgrade("SAVE", as_of="2026-04-29")
+        # Proration rounds 100.5 up to 101. Tax on the remaining 85 rounds up to 9.
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (85, 9, 94))
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.service.register_promo("SAVE", amount_off_cents=100)
+        self.assertIs(self.upgrade("SAVE", as_of="2026-04-29"), entry)
+        for code, day in ((None, "2026-04-29"), ("SAVE", "2026-04-30")):
+            with self.subTest(code=code, day=day), self.assertRaises(ValidationError):
+                self.upgrade(code, as_of=day)
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [entry])

