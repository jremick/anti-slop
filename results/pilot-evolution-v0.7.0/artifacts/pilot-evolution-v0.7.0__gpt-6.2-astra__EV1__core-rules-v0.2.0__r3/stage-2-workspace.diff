+import unittest
+
+from ev1_order_ledger import LineItem, OrderService, Plan, ValidationError
+
+
+class PromoTests(unittest.TestCase):
+    def setUp(self):
+        self.service = OrderService()
+        self.service.register_plan(Plan("base", "Base", 100))
+        self.service.register_plan(Plan("pro", "Pro", 301, tax_bps=1000))
+        self.sub = self.service.start_subscription("acct", "base")
+
+    def order(self, code, **kwargs):
+        return self.service.place_order(
+            "acct", [LineItem("item", 101, 1)], tax_bps=1000, promo_code=code, **kwargs
+        )
+
+    def upgrade(self, code, **kwargs):
+        return self.service.upgrade_subscription(
+            self.sub.subscription_id, "pro", 1, 2, idempotency_key="upgrade",
+            promo_code=code, **kwargs
+        )
+
+    def test_registration_validates_before_replacing_a_code(self):
+        self.service.register_promo("A", amount_off_cents=1)
+        for fields in (
+            {}, {"percent_off": 2, "amount_off_cents": 1}, {"percent_off": 0},
+            {"percent_off": 101}, {"percent_off": True}, {"percent_off": 2.5},
+            {"amount_off_cents": 0}, {"amount_off_cents": -1}, {"amount_off_cents": False},
+            {"percent_off": 1, "min_subtotal_cents": -1},
+            {"percent_off": 1, "min_subtotal_cents": True},
+            {"percent_off": 1, "expires_on": "2025-02-29"},
+        ):
+            with self.subTest(fields=fields), self.assertRaises(ValidationError):
+                self.service.register_promo("A", **fields)
+        for code in ("", "  ", "A,B", None):
+            with self.subTest(code=code), self.assertRaises(ValidationError):
+                self.service.register_promo(code, percent_off=10)
+        self.assertEqual(self.order("A").discount_cents, 1)
+
+    def test_percentage_rounds_half_up_before_tax(self):
+        self.service.register_promo("HALF", percent_off=50, min_subtotal_cents=101)
+        order = self.order("HALF")
+        self.assertEqual((order.promo_code, order.discount_cents), ("HALF", 51))
+        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (50, 5, 55))
+        entry, = self.service.ledger.entries_for_account("acct")
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (50, 5, 55))
+
+    def test_fixed_discount_clamps_to_subtotal_and_includes_flat_fee(self):
+        self.service.register_promo("FIXED", amount_off_cents=200)
+        order = self.order("FIXED")
+        self.assertEqual((order.discount_cents, order.subtotal_cents, order.total_cents), (101, 0, 0))
+        order = self.order("FIXED", legacy_flat_fee=True)
+        self.assertEqual((order.discount_cents, order.subtotal_cents, order.total_cents), (200, 401, 441))
+
+    def test_invalid_promos_leave_both_charge_paths_untouched(self):
+        self.service.register_promo("A", percent_off=100, expires_on="2026-04-30")
+        self.service.register_promo("B", amount_off_cents=10, min_subtotal_cents=102)
+        for charge in (self.order, self.upgrade):
+            for code, day in (
+                ("unknown", None), ("A,B", "2026-04-29"), ("B", None), ("A", None),
+                ("A", "2026-05-01"), ("A", "2026-02-30"), ("A", "20260429"),
