+                        charge(code, as_of=day)
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [])
+        self.assertEqual(self.sub.plan_id, "base")
+        self.assertEqual(self.order("A", as_of="2026-04-30").discount_cents, 101)
+        self.assertEqual(self.upgrade("A", as_of="2026-04-30").total_cents, 0)
+
+    def test_upgrade_discounts_prorated_charge_and_replays_original(self):
+        self.service.register_promo("SAVE", amount_off_cents=16, expires_on="2026-04-30")
+        entry = self.upgrade("SAVE", as_of="2026-04-29")
+        # Proration rounds 100.5 up to 101. Tax on the remaining 85 rounds up to 9.
