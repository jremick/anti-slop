ency_key)):\n            if not isinstance(value, str) or not value.strip():\n                raise ValidationError(f\"{name} must be a non-empty string\")\n\n        request = (\"order_refund\", order_id, amount_cents, reason)\n        with self._mutation_lock:\n            previous = self._replay(idempotency_key, request)\n            if previous is not None:\n                return previous\n\n            order = self.get_order(order_id)\n            already_refunded = sum(\n                -entry.total_cents for entry in self.entries_for_account(order.account_id)\n                if entry.kind == \"order_refund\" and entry.reference_id == order_id\n            )\n            subtotal, tax = calculate_refund_split(order, already_refunded, amount_cents)\n            entry = LedgerEntry(\n                entry_id=self.next_id(\"ent\"),\n                account_id=order.account_id,\n                kind=\"order_refund\",\n                subtotal_cents=-subtotal,\n                tax_cents=-tax,\n                total_cents=-amount_cents,\n                reference_id=order_id,\n                reason=reason,\n            )\n            self.record_entry(entry)\n            self._requests[idempotency_key] = (request, entry)\n            return entry\n\n    def record_entry'\"''')\np.write_text(s)\np = Path(\\\"pricing.py\\\")\np.write_text(p.read_text().replace(\\\"import LineItem, Plan\\\", \\\"import LineItem, Order, Plan\\\") + '''\n\ndef calculate_refund_split(order: Order, already_refunded: int, amount_cents: int) -> Tuple[int, int]:\n    \\\"\\\"\\\"Allocate this refund the change in rounded cumulative tax.\\\"\\\"\\\"\n    cumulative = already_refunded + amount_cents\n    if cumulative > order.total_cents:\n        raise ValidationError(\\\"refund exceeds the remaining order total\\\")\n    tax_before = round_half_up_div(already_refunded * order.tax_cents, order.total_cents)\n    tax_after = round_half_up_div(cumulative * order.tax_cents, order.total_cents)\n    tax = tax_after - tax_before\n    return amount_cents - tax, tax\n''')\np = Path(\\\"api.py\\\")\np.write_text(p.read_text().replace(\\\"    def get_statement\\\", '''    def refund_order(\n        self, order_id: str, amount_cents: int, *, reason: str, idempotency_key: str,\n    ) -> LedgerEntry:\n        return self.ledger.refund_order(\n            order_id, amount_cents, reason=reason, idempotency_key=idempotency_key\n        )\n\n    def export_credit_note(self, refund_entry_id: str) -> Dict[str, object]:\n        if not isinstance(refund_entry_id, str):\n            raise ValidationError(\\\"refund_entry_id must be a string\\\")\n        entry = self.ledger.get_entry(refund_entry_id)\n        if entry is None or entry.kind \"'!= \"order_refund\":\n            raise ValidationError(\"expected an order refund entry\")\n        return {\n            \"entry_id\": entry.entry_id,\n            \"order_id\": entry.reference_id,\n            \"account_id\": entry.account_id,\n            \"subtotal_cents\": -entry.subtotal_cents,\n            \"tax_cents\": -entry.tax_cents,\n            \"total_cents\": -entry.total_cents,\n            \"reason\": entry.reason,\n        }\n\n    def get_statement'\"'''))\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cat > benchmarks/sources/ev1_order_ledger/tests/test_refunds.py <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nimport unittest\n\nfrom ev1_order_ledger import LineItem, OrderService, ValidationError\n\n\nclass RefundTests(unittest.TestCase):\n    def setUp(self):\n        self.service = OrderService()\n        self.service.register_promo(\\\"LESS\\\", amount_off_cents=5)\n        self.order = self.service.place_order(\n            \\\"acct\\\", [LineItem(\\\"item\\\", 15, 1)], tax_bps=2000, promo_code=\\\"LESS\\\"\n        )\n\n    def refund(self, amount, key=\\\"refund\\\", reason=\\\"returned\\\"):\n        return self.service.refund_order(\n            self.order.order_id, amount, reason=reason, idempotency_key=key\n        )\n\n    def test_cumulative_allocation_and_conservation(self):\n        # The charge is 10 cents plus 2 tax. After 3 cents, cumulative tax is\n        # exactly half a cent, so that refund must reverse the first penny.\n        entries = []\n        for i, (amount, tax) in enumerate(((1, 0), (2, 1), (4, 0), (5, 1))):\n            entry = self.refund(amount, str(i))\n            self.assertEqual((entry.kind, entry.reference_id), (\\\"order_refund\\\", self.order.order_id))\n            self.assertEqual(entry.subtotal_cents + entry.tax_cents, entry.total_cents)\n            self.assertEqual((entry.total_cents, entry.tax_cents), (-amount, -tax))\n            entries.append(entry)\n        self.assertEqual(sum(e.subtotal_cents for e in entries), -self.order.subtotal_cents)\n        self.assertEqual(sum(e.tax_cents for e in entries), -self.order.tax_cents)\n        self.assertEqual(self.service.get_statement(\\\"acct\\\")[\\\"balance_cents\\\"], 0)\n\n    def test_invalid_requests_do_not_post_or_consume_key(self):\n        self.refund(9, \\\"initial\\\")\n        for amount, reason, key in (\n            (4, \\\"returned\\\", \\\"retry\\\"), (0, \\\"returned\\\", \\\"retry\\\"), (-1, \\\"returned\\\", \\\"retry\\\"),\n            (True, \\\"returned\\\", \\\"retry\\\"), (1.5, \\\"returned\\\", \\\"retry\\\"), (1, \\\" \\\", \\\"retry\\\"),\n            (1, None, \\\"retry\\\"), (1, \\\"returned\\\", \\\"\\\"), (1, \\\"returned\\\", False),\n        ):\n            with self.subTest(amount=amount, reason=reason, key=key), self.assertRaises(ValidationError):\n                self.refund(amount, key, reason)\n        with self.assertRaises(ValidationError):\n            self.service.refund_order(\\\"unknown\\\", 1, reason=\\\"returned\\\", idempotency_key=\\\"retry\\\")\n        self.refund(3, \\\"retry\\\")\n        with self.assertRaises(ValidationError):\n            self.refund(1)\n        self.assertEqual(self.service.get_statement(\\\"acct\\\")[\\\"entry_count\\\"], 3)\n\n    def test_replay_and_conflict_after_order_is_fully_refunded(self):\n        first = self.refund(1)\n        self.refund(11, \\\"remainder\\\")\n        other_order = self.service.place_order(\\\"acct\\\", [LineItem(\\\"item\\\", 1, 1)])\n        service = OrderService(self.service.ledger)\n        for order_id, amount, reason in (\n            (self.order.order_id, 2, \\\"returned\\\"), (self.order.order_id, 1, \\\"damaged\\\"),\n            (other_order.order_id, 1, \\\"returned\\\"), (self.order.order_id, True, \\\"returned\\\"),\n        ):\n            with self.subTest(order_id=order_id, amount=amount, reason=reason):\n                with self.assertRaises(ValidationError):\n                    service.refund_order(order_id, amount, reason=reason, idempotency_key=\\\"refund\\\")\n        replay = service.refund_order(self.order.order_id, 1, reason=\\\"returned\\\", idempotency_key=\\\"refund\\\")\n        self.assertIs(replay, first)\n        self.assertEqual(service.get_statement(\\\"acct\\\")[\\\"entry_count\\\"], 4)\n        self.assertEqual(service.refund_order(\n            other_order.order_id, 1, reason=\\\"returned\\\", idempotency_key=\\\"other\\\"\n        ).tax_cents, 0)\n\n    def test_credit_note_exports_partial_refund_magnitudes(self):\n        charge, = self.service.ledger.entries_for_account(\\\"acct\\\")\n        for invalid in (charge.entry_id, \\\"unknown\\\"):\n            with self.assertRaises(ValidationError):\n                self.service.export_credit_note(invalid)\n        refund = self.refund(3)\n        self.assertEqual(self.service.export_credit_note(refund.entry_id), {\n            \\\"entry_id\\\": refund.entry_id, \\\"order_id\\\": self.order.order_id,\n            \\\"account_id\\\": \\\"acct\\\", \\\"subtotal_cents\\\": 2, \\\"tax_cents\\\": 1,\n            \\\"total_cents\\\": 3, \\\"reason\\\": \\\"returned\\\",\n        })\n\n    def test_concurrent_refunds_share_one_remaining_balance(self):\n        def attempt(key):\n            try:\n                return self.refund(7, str(key))\n            except ValidationError:\n                return None\n\n        with ThreadPoolExecutor(max_workers=4) as pool:\n            refunds = list(pool.map(attempt, range(8)))\n        self.assertEqual(sum(entry is not None for entry in refunds), 1)\n        self.assertEqual(self.service.get_statement(\\\"acct\\\")[\\\"balance_cents\\\"], 5)\nPY\npython3 benchmarks/sources/ev1_order_ledger/run_checks.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
