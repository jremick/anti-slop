{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"PYTHONPATH=benchmarks/sources python3 - <<'PY'\nfrom ev1_order_ledger.models import Order\nfrom ev1_order_ledger.pricing import calculate_refund_components\n\ncount = 0\nfor total in range(1, 41):\n    for tax in range(total // 2 + 1):\n        order = Order(\\\"ord\\\", \\\"acct\\\", (), total - tax, tax, total)\n        for start in range(total):\n            for end in range(start + 1, total + 1):\n                subtotal, reversed_tax = calculate_refund_components(order, start, end - start)\n                assert subtotal >= 0 and reversed_tax >= 0\n                assert subtotal + reversed_tax == end - start\n                prior = (0, 0) if start == 0 else calculate_refund_components(order, 0, start)\n                cumulative = calculate_refund_components(order, 0, end)\n                assert (prior[0] + subtotal, prior[1] + reversed_tax) == cumulative\n                if end == total:\n                    assert cumulative == (order.subtotal_cents, tax)\n                count += 1\nprint(f\\\"Verified {count} refund intervals for totals through 40 cents.\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
