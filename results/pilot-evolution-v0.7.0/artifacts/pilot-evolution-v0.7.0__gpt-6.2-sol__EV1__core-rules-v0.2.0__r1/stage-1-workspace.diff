+"""Tests for prorated subscription upgrades and ledger idempotency."""
+
+import unittest
+from concurrent.futures import ThreadPoolExecutor
+from threading import Barrier
+
+from ev1_order_ledger import OrderService, Plan, ValidationError
+
+
+class SubscriptionUpgradeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.service = OrderService()
+        self.service.register_plan(Plan("starter", "Starter", 1000, tax_bps=1000))
+        self.service.register_plan(Plan("pro", "Pro", 1005, tax_bps=5000))
+        self.service.register_plan(Plan("premium", "Premium", 2000))
+        self.subscription = self.service.start_subscription("acct_1", "starter")
+        self.subscription_id = self.subscription.subscription_id
+
+    def test_proration_rounds_half_up_then_taxes_at_new_plan_rate(self) -> None:
+        entry = self.service.upgrade_subscription(
+            self.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+
+        self.assertEqual(entry.subtotal_cents, 3)  # 5 * 1 / 2 = 2.5
+        self.assertEqual(entry.tax_cents, 2)  # 3 * 5000 / 10000 = 1.5
+        self.assertEqual(entry.total_cents, 5)
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.subscription_id)
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual(self.subscription.plan_id, "pro")
+        self.assertIs(self.service.ledger.get_entry(entry.entry_id), entry)
+        statement = self.service.get_statement("acct_1")
+        self.assertEqual(statement["balance_cents"], 5)
+        self.assertEqual(statement["entry_count"], 1)
+
+    def test_accepts_zero_remaining_days_and_full_cycle(self) -> None:
+        for days_remaining, expected_subtotal in ((0, 0), (2, 5)):
+            with self.subTest(days_remaining=days_remaining):
+                sub = self.service.start_subscription("acct_1", "starter")
+                entry = self.service.upgrade_subscription(
+                    sub.subscription_id, "pro", days_remaining, 2,
+                    idempotency_key=f"upgrade-{days_remaining}",
+                )
+                self.assertEqual(entry.subtotal_cents, expected_subtotal)
+                self.assertEqual(sub.plan_id, "pro")
+
+    def test_rejects_invalid_day_counts_without_consuming_key(self) -> None:
+        for days_remaining, cycle_days in (
+            (0, 0), (0, -1), (-1, 2), (3, 2), (True, 2), (0, True),
+            (1.0, 2), (1, 2.0),
+        ):
+            with self.subTest(days_remaining=days_remaining, cycle_days=cycle_days):
+                with self.assertRaises(ValidationError):
+                    self.service.upgrade_subscription(
+                        self.subscription_id, "pro", days_remaining, cycle_days,
+                        idempotency_key="upgrade",
+                    )
+                self.assertEqual(self.subscription.plan_id, "starter")
+                self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [])
+
+        self.service.upgrade_subscription(
+            self.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+
+    def test_rejects_unknown_ids_non_upgrades_and_invalid_keys(self) -> None:
+        self.service.register_plan(Plan("equal", "Equal", 1000))
+        self.service.register_plan(Plan("cheaper", "Cheaper", 999))
+        for subscription_id, plan_id, key in (
+            ("missing", "pro", "upgrade"),
+            (True, "pro", "upgrade"),
+            (self.subscription_id, "missing", "upgrade"),
+            (self.subscription_id, False, "upgrade"),
+            (self.subscription_id, "starter", "upgrade"),
+            (self.subscription_id, "equal", "upgrade"),
+            (self.subscription_id, "cheaper", "upgrade"),
+            (self.subscription_id, "pro", ""),
+            (self.subscription_id, "pro", "  "),
+            (self.subscription_id, "pro", True),
+        ):
+            with self.subTest(subscription_id=subscription_id, plan_id=plan_id, key=key):
+                with self.assertRaises(ValidationError):
+                    self.service.upgrade_subscription(
+                        subscription_id, plan_id, 1, 2, idempotency_key=key
+                    )
+                self.assertEqual(self.subscription.plan_id, "starter")
+                self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [])
+
+    def test_replay_returns_original_entry_after_a_later_upgrade(self) -> None:
+        original = self.service.upgrade_subscription(
+            self.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+        other_service = OrderService(self.service.ledger)
+        later = other_service.upgrade_subscription(
+            self.subscription_id, "premium", 1, 2, idempotency_key="later"
+        )
+
+        replay = other_service.upgrade_subscription(
+            self.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+
+        self.assertIs(replay, original)
+        self.assertEqual(self.subscription.plan_id, "premium")
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [original, later])
+
+    def test_key_conflicts_leave_ledger_and_subscriptions_unchanged(self) -> None:
+        other = self.service.start_subscription("acct_2", "starter")
+        original = self.service.upgrade_subscription(
+            self.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+
+        for args in (
+            (other.subscription_id, "pro", 1, 2),
+            (self.subscription_id, "premium", 1, 2),
+            (self.subscription_id, "pro", 0, 2),
+            (self.subscription_id, "pro", 1, 3),
+            (self.subscription_id, "pro", True, 2),
+            (self.subscription_id, "pro", 1, 2.0),
+        ):
+            with self.subTest(args=args):
+                with self.assertRaises(ValidationError):
+                    self.service.upgrade_subscription(*args, idempotency_key="upgrade")
+
+        self.assertEqual(self.subscription.plan_id, "pro")
+        self.assertEqual(other.plan_id, "starter")
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [original])
+        self.assertEqual(self.service.ledger.entries_for_account("acct_2"), [])
+        self.assertIs(
+            self.service.upgrade_subscription(
+                self.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+            ),
+            original,
+        )
+
+    def test_concurrent_replays_record_one_entry(self) -> None:
+        barrier = Barrier(2)
+
+        def upgrade():
+            barrier.wait(timeout=5)
+            return self.service.upgrade_subscription(
+                self.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+            )
+
+        with ThreadPoolExecutor(max_workers=2) as pool:
+            first = pool.submit(upgrade)
+            second = pool.submit(upgrade)
+            entry = first.result()
+            self.assertIs(second.result(), entry)
+
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [entry])
