+    def lookup_idempotent_entry(self, idempotency_key: str, fingerprint: tuple) -> Optional[LedgerEntry]:
+        """Return the entry previously recorded under ``idempotency_key``, or None if unused.
+
+        Raises ValidationError if the key was already used for a different request.
+        """
+        stored = self._idempotency.get(idempotency_key)
+        if stored is None:
+            return None
+        stored_fingerprint, entry_id = stored
+        if stored_fingerprint != fingerprint:
+            raise ValidationError(
+                f"idempotency_key {idempotency_key!r} was already used with different arguments"
+            )
+        return self._entries[entry_id]
+
+    def record_idempotent_entry(self, idempotency_key: str, fingerprint: tuple, entry: LedgerEntry) -> None:
+        """Record ``entry`` and bind it to ``idempotency_key`` in one step."""
+        if idempotency_key in self._idempotency:
+            raise ValidationError(f"idempotency_key {idempotency_key!r} is already in use")
+        self.record_entry(entry)
+        self._idempotency[idempotency_key] = (fingerprint, entry.entry_id)

