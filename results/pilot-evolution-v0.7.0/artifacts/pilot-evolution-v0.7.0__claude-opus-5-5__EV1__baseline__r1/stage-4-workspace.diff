+            while remaining > 0:
+                amount = rng.randint(1, min(remaining, max(1, order.total_cents // rng.randint(1, 12))))
+                e = svc.refund_order(order.order_id, amount, reason="r", idempotency_key=f"k{n}")
+                self.assertEqual(e.subtotal_cents + e.tax_cents, -amount)
