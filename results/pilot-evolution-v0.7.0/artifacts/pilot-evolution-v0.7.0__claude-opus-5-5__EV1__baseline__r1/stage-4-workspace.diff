+    def test_rejected_codes_fail_closed_without_side_effects(self) -> None:
+        for bad in ["NOPE", "save10", "SAVE10,FIVE", "SAVE10 FIVE", "SAVE10;FIVE", "SAVE10+FIVE", " SAVE10", "", 10]:
