+    promo: Optional[Promo] = None,
+    as_of: Optional[str] = None,
+) -> PricedTotals:
+    """Price a mid-cycle upgrade: prorated difference, then promo, then tax at the new plan's rate."""
+    gross = compute_prorated_upgrade_cents(
+        old_plan.monthly_cents, new_plan.monthly_cents, days_remaining, cycle_days
+    )
+    return price_with_promo(gross, new_plan.tax_bps, promo=promo, as_of=as_of)
+
+
+def calculate_upgrade_totals(
+    old_plan: Plan,
+    new_plan: Plan,
+    days_remaining: int,
+    cycle_days: int,
+) -> Tuple[int, int, int]:
+    """Return (subtotal_cents, tax_cents, total_cents) for an upgrade without a promo."""
+    totals = price_upgrade(old_plan, new_plan, days_remaining, cycle_days)
+    return totals.subtotal_cents, totals.tax_cents, totals.total_cents
+
+
+def allocate_refund_cents(
+    order_total_cents: int,
+    order_tax_cents: int,
+    already_refunded_cents: int,
+    already_refunded_tax_cents: int,
+    amount_cents: int,
+) -> Tuple[int, int]:
+    """Split a refund into (subtotal_cents, tax_cents) with zero cumulative penny drift.
+
+    The tax portion is allocated cumulatively: after this refund, total tax
+    reversed equals ``round_half_up_div(order_tax * refunded_so_far, order_total)``.
+    Each refund's tax is the difference from what was already reversed, so the
+    parts always sum to ``amount_cents`` and refunding the full total reverses
+    exactly ``order_tax_cents`` (and therefore exactly the order subtotal).
+    """
+    validate_non_negative_int(order_total_cents, "order_total_cents")
+    validate_non_negative_int(order_tax_cents, "order_tax_cents")
+    validate_non_negative_int(already_refunded_cents, "already_refunded_cents")
+    validate_non_negative_int(already_refunded_tax_cents, "already_refunded_tax_cents")
+    validate_positive_int(amount_cents, "amount_cents")
+    if order_tax_cents > order_total_cents:
+        raise ValidationError("order_tax_cents cannot exceed order_total_cents")
+    refunded_after = already_refunded_cents + amount_cents
+    if refunded_after > order_total_cents:
+        raise ValidationError(
+            f"refund of {amount_cents} cents exceeds remaining refundable "
+            f"{order_total_cents - already_refunded_cents} cents"
+        )
+    cumulative_tax = round_half_up_div(order_tax_cents * refunded_after, order_total_cents)
+    refund_tax = cumulative_tax - already_refunded_tax_cents
+    if not 0 <= refund_tax <= amount_cents:
+        # Only reachable if prior refunds were not allocated by this function.
+        raise ValidationError("prior refunds are inconsistent with cumulative tax allocation")
+    return amount_cents - refund_tax, refund_tax

