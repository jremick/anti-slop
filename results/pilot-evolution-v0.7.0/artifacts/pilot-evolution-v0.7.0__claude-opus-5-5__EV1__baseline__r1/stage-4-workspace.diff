+class AllocateRefundTests(unittest.TestCase):
+    def test_full_refund_reverses_exact_split(self) -> None:
+        self.assertEqual(allocate_refund_cents(4328, 330, 0, 0, 4328), (3998, 330))
+
+    def test_cumulative_allocation_avoids_drift(self) -> None:
+        # Order: subtotal 100, tax 1 (1%), total 101. Refund one cent at a time.
+        # Per-chunk rounding would give round(1/101) = 0 tax every time and never
+        # reverse the 1 cent of tax; cumulative allocation reverses it exactly once.
+        refunded = refunded_tax = 0
+        taxes = []
+        for _ in range(101):
+            sub, tax = allocate_refund_cents(101, 1, refunded, refunded_tax, 1)
+            self.assertEqual(sub + tax, 1)
+            taxes.append(tax)
+            refunded += 1
+            refunded_tax += tax
+        self.assertEqual(sum(taxes), 1)
+        self.assertEqual(refunded_tax, 1)
+        # The tax cent is reversed at the half-way point (half-up), not the end.
+        self.assertEqual(taxes.index(1), 50)
+
+    def test_zero_tax_order(self) -> None:
+        self.assertEqual(allocate_refund_cents(1000, 0, 0, 0, 333), (333, 0))
+
+    def test_rejects_invalid_inputs(self) -> None:
+        bad = [
+            (1000, 100, 0, 0, 0),       # zero amount
+            (1000, 100, 0, 0, -1),
+            (1000, 100, 0, 0, True),
+            (1000, 100, 0, 0, 1.0),
+            (1000, 100, 0, 0, 1001),    # over-refund
+            (1000, 100, 900, 90, 101),  # over-refund after partials
+            (0, 0, 0, 0, 1),            # nothing to refund
+            (100, 101, 0, 0, 1),        # tax > total
+        ]
+        for args in bad:
+            with self.subTest(args=args), self.assertRaises(ValidationError):
+                allocate_refund_cents(*args)
+
