+"""Unit tests for legacy flat-fee removal and fail-closed audit logging."""
+
+from __future__ import annotations
+
+import unittest
+
+from ev1_order_ledger import pricing
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, ValidationError
+from ev1_order_ledger.pricing import calculate_order_totals
+
+
+def seat(unit_cents: int, quantity: int = 1) -> list:
+    return [LineItem(sku="seat", unit_cents=unit_cents, quantity=quantity)]
+
+
+class LegacyFlatFeeRemovedTests(unittest.TestCase):
+    def test_calculate_order_totals_rejects_keyword(self) -> None:
+        for value in (True, False):
+            with self.subTest(value=value), self.assertRaises(TypeError):
+                calculate_order_totals(seat(1000), tax_bps=1000, legacy_flat_fee=value)
+
+    def test_price_order_rejects_keyword(self) -> None:
+        with self.assertRaises(TypeError):
+            pricing.price_order(seat(1000), legacy_flat_fee=True)
+
+    def test_place_order_rejects_keyword_without_side_effects(self) -> None:
+        svc = OrderService()
+        for value in (True, False):
+            with self.subTest(value=value), self.assertRaises(TypeError):
+                svc.place_order("acct_1", seat(1000), tax_bps=1000, legacy_flat_fee=value)
+        self.assertEqual(svc.ledger.entries_for_account("acct_1"), [])
+
+    def test_constant_is_gone(self) -> None:
+        self.assertFalse(hasattr(pricing, "LEGACY_FLAT_FEE_CENTS"))
+
+    def test_order_totals_have_no_hidden_fee(self) -> None:
+        self.assertEqual(calculate_order_totals(seat(1000), tax_bps=1000), (1000, 100, 1100))
+
+
+class RecordingSink:
+    def __init__(self) -> None:
+        self.events: list = []
+
+    def __call__(self, event: dict) -> None:
+        self.events.append(event)
+
+
+class FailingSink:
+    def __init__(self) -> None:
+        self.calls = 0
+
+    def __call__(self, event: dict) -> None:
+        self.calls += 1
+        raise RuntimeError("audit store unavailable")
+
+
+class AuditSinkTests(unittest.TestCase):
+    def _service(self, sink) -> OrderService:
+        svc = OrderService(audit_sink=sink)
+        svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=825))
+        svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+        return svc
+
+    def test_logs_each_new_mutation(self) -> None:
+        sink = RecordingSink()
+        svc = self._service(sink)
+        order = svc.place_order("acct_1", seat(1999, 2), tax_bps=825)
+        sub = svc.start_subscription("acct_1", "starter")  # not a ledger mutation
+        upgrade = svc.upgrade_subscription(sub.subscription_id, "pro", 10, 30, idempotency_key="u1")
+        refund = svc.refund_order(order.order_id, 1000, reason="r", idempotency_key="r1")
+        charge = svc.ledger.entries_for_account("acct_1")[0]
+        self.assertEqual(sink.events, [
+            {"action": "order_charge", "account_id": "acct_1", "amount_cents": 4328, "entry_id": charge.entry_id},
+            {"action": "plan_upgrade", "account_id": "acct_1", "amount_cents": 722, "entry_id": upgrade.entry_id},
+            {"action": "order_refund", "account_id": "acct_1", "amount_cents": -1000, "entry_id": refund.entry_id},
+        ])
+        # Every event refers to a committed ledger entry.
+        for event in sink.events:
+            self.assertIsNotNone(svc.ledger.get_entry(event["entry_id"]))
+
+    def test_idempotent_replays_are_not_logged(self) -> None:
+        sink = RecordingSink()
+        svc = self._service(sink)
+        order = svc.place_order("acct_1", seat(1999, 2), tax_bps=825)
+        sub = svc.start_subscription("acct_1", "starter")
+        svc.upgrade_subscription(sub.subscription_id, "pro", 10, 30, idempotency_key="u1")
+        svc.refund_order(order.order_id, 1000, reason="r", idempotency_key="r1")
+        self.assertEqual(len(sink.events), 3)
+        svc.upgrade_subscription(sub.subscription_id, "pro", 10, 30, idempotency_key="u1")
+        svc.refund_order(order.order_id, 1000, reason="r", idempotency_key="r1")
+        self.assertEqual(len(sink.events), 3)
+
+    def test_rejected_mutations_are_not_logged(self) -> None:
+        sink = RecordingSink()
+        svc = self._service(sink)
+        with self.assertRaises(ValidationError):
+            svc.place_order("acct_1", [])
+        order = svc.place_order("acct_1", seat(100))
+        with self.assertRaises(ValidationError):
+            svc.refund_order(order.order_id, 101, reason="r", idempotency_key="r1")
+        self.assertEqual([e["action"] for e in sink.events], ["order_charge"])
+
+    def test_events_are_independent_dicts(self) -> None:
+        sink = RecordingSink()
+        svc = self._service(sink)
+        svc.place_order("acct_1", seat(100))
+        sink.events[0]["amount_cents"] = 0
+        self.assertEqual(svc.get_statement("acct_1")["balance_cents"], 100)
+
+    def test_no_sink_is_fine(self) -> None:
+        svc = OrderService()
+        self.assertEqual(svc.place_order("acct_1", seat(100)).total_cents, 100)
+
+    def test_non_callable_sink_rejected(self) -> None:
+        with self.assertRaises(TypeError):
+            OrderService(audit_sink="not callable")
+
+    def test_place_order_fails_closed(self) -> None:
+        sink = FailingSink()
+        svc = self._service(sink)
+        with self.assertRaises(RuntimeError):
+            svc.place_order("acct_1", seat(1999, 2), tax_bps=825)
+        self.assertEqual(sink.calls, 1)
+        self.assertEqual(svc.ledger.entries_for_account("acct_1"), [])
+        self.assertEqual(svc.ledger._orders, {})
+        self.assertEqual(svc.get_statement("acct_1")["balance_cents"], 0)
+
+    def test_upgrade_fails_closed_and_key_remains_usable(self) -> None:
+        recorder = RecordingSink()
+        svc = self._service(recorder)
+        sub = svc.start_subscription("acct_1", "starter")
+        svc._audit_sink = FailingSink()
+        with self.assertRaises(RuntimeError):
+            svc.upgrade_subscription(sub.subscription_id, "pro", 10, 30, idempotency_key="u1")
+        self.assertEqual(svc.ledger.get_subscription(sub.subscription_id).plan_id, "starter")
+        self.assertEqual(svc.ledger.entries_for_account("acct_1"), [])
+        # The idempotency key was not bound, so a retry with a healthy sink commits once.
+        svc._audit_sink = recorder
+        entry = svc.upgrade_subscription(sub.subscription_id, "pro", 10, 30, idempotency_key="u1")
+        self.assertEqual(svc.ledger.get_subscription(sub.subscription_id).plan_id, "pro")
+        self.assertEqual(svc.ledger.entries_for_account("acct_1"), [entry])
+        self.assertEqual(len(recorder.events), 1)
+
+    def test_refund_fails_closed_and_key_remains_usable(self) -> None:
+        recorder = RecordingSink()
+        svc = self._service(recorder)
+        order = svc.place_order("acct_1", seat(1999, 2), tax_bps=825)
+        svc._audit_sink = FailingSink()
+        with self.assertRaises(RuntimeError):
+            svc.refund_order(order.order_id, order.total_cents, reason="r", idempotency_key="r1")
+        self.assertEqual(svc.ledger.entries_for_reference("order_refund", order.order_id), [])
+        self.assertEqual(svc.get_statement("acct_1")["balance_cents"], order.total_cents)
+        svc._audit_sink = recorder
+        # Full amount is still refundable: the failed attempt did not count against the order.
+        entry = svc.refund_order(order.order_id, order.total_cents, reason="r", idempotency_key="r1")
+        self.assertEqual(entry.tax_cents, -order.tax_cents)
+        self.assertEqual(svc.get_statement("acct_1")["balance_cents"], 0)
+
+    def test_sink_exception_type_propagates_unchanged(self) -> None:
+        class Boom(Exception):
+            pass
+
+        def sink(event: dict) -> None:
+            raise Boom(event["action"])
+
+        svc = OrderService(audit_sink=sink)
+        with self.assertRaises(Boom) as ctx:
+            svc.place_order("acct_1", seat(100))
+        self.assertEqual(str(ctx.exception), "order_charge")
+
+
+if __name__ == "__main__":
+    unittest.main()

