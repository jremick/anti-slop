+class PriceWithPromoTests(unittest.TestCase):
+    """The shared discount + tax helper used by both orders and upgrades."""
+
+    def test_no_promo_is_plain_tax(self) -> None:
+        t = price_with_promo(3998, 825)
+        self.assertEqual((t.discount_cents, t.subtotal_cents, t.tax_cents, t.total_cents), (0, 3998, 330, 4328))
+        self.assertIsNone(t.promo_code)
+
+    def test_percent_discount_rounds_half_up(self) -> None:
+        # 15% of 1010 = 151.5 -> 152
+        t = price_with_promo(1010, 0, promo=Promo("P15", percent_off=15))
+        self.assertEqual((t.gross_subtotal_cents, t.discount_cents, t.subtotal_cents), (1010, 152, 858))
+
+    def test_tax_is_on_discounted_subtotal(self) -> None:
+        # 10% off 2000 = 200; tax 1800 * 8.25% = 148.5 -> 149
+        t = price_with_promo(2000, 825, promo=Promo("P10", percent_off=10))
+        self.assertEqual((t.subtotal_cents, t.tax_cents, t.total_cents), (1800, 149, 1949))
+
+    def test_fixed_discount_clamps_at_zero(self) -> None:
+        t = price_with_promo(300, 825, promo=Promo("BIG", amount_off_cents=1000))
+        self.assertEqual((t.discount_cents, t.subtotal_cents, t.tax_cents, t.total_cents), (300, 0, 0, 0))
+
+    def test_hundred_percent_off(self) -> None:
+        t = price_with_promo(4321, 825, promo=Promo("FREE", percent_off=100))
+        self.assertEqual((t.discount_cents, t.total_cents), (4321, 0))
+
+    def test_rejects_malformed_as_of(self) -> None:
+        for bad in ["2026-1-01", "20260101", "2026-02-30", "", 20260101, date(2026, 1, 1)]:
+            with self.subTest(bad=bad), self.assertRaises(ValidationError):
+                price_with_promo(1000, 0, as_of=bad)
