+"""Unit tests for mid-cycle prorated plan upgrades with idempotency."""
+
+from __future__ import annotations
+
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LedgerEntry, Plan, ValidationError
+from ev1_order_ledger.pricing import calculate_upgrade_totals, compute_prorated_upgrade_cents
+
