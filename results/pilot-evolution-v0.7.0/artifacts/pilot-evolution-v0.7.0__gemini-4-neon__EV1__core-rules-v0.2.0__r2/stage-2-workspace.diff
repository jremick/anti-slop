+class PlanUpgradeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=500))
+        self.svc.register_plan(Plan(plan_id="starter_alt", name="Starter Alt", monthly_cents=1000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="enterprise", name="Enterprise", monthly_cents=5000, tax_bps=1000))
+
+    def test_prorated_upgrade_computes_exact_totals_and_updates_subscription(self) -> None:
+        sub = self.svc.start_subscription("acct_1", "starter")
+        entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="upg_1",
+        )
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, sub.subscription_id)
+        self.assertEqual(entry.account_id, "acct_1")
+        # (3000 - 1000) * 15 / 30 = 1000; tax uses new_plan.tax_bps (825): 1000 * 825 / 10000 = 82.5 -> 83
+        self.assertEqual(entry.subtotal_cents, 1000)
+        self.assertEqual(entry.tax_cents, 83)
+        self.assertEqual(entry.total_cents, 1083)
+
+        updated = self.svc.ledger.get_subscription(sub.subscription_id)
+        self.assertEqual(updated.plan_id, "pro")
+
+        stmt = self.svc.get_statement("acct_1")
+        self.assertEqual(stmt["balance_cents"], 1083)
+        self.assertEqual(stmt["entry_count"], 1)
+
+    def test_proration_uses_exact_half_up_rounding(self) -> None:
+        # Half-up on even quotient (0.5 -> 1, 500.5 -> 501) and odd quotient (501.5 -> 502)
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 1001, 1, 2), 1)
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 2001, 1, 2), 501)
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 2003, 1, 2), 502)
+        # Below half rounds down; above half rounds up
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 2000, 1, 3), 333)
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 2000, 2, 3), 667)
+
+        # End-to-end via OrderService with half-up proration and half-up tax
+        old_p = Plan(plan_id="p_base", name="Base", monthly_cents=1000, tax_bps=0)
+        new_p = Plan(plan_id="p_odd", name="Odd", monthly_cents=2001, tax_bps=50)  # 0.5%
+        self.svc.register_plan(old_p)
+        self.svc.register_plan(new_p)
+        sub = self.svc.start_subscription("acct_half", "p_base")
+        entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "p_odd",
+            1,
+            2,
+            idempotency_key="half_up_1",
+        )
+        # delta=1001, 1001 * 1 / 2 = 500.5 -> 501
+        # tax = 501 * 50 / 10000 = 2.505 -> 3
+        self.assertEqual(entry.subtotal_cents, 501)
+        self.assertEqual(entry.tax_cents, 3)
+        self.assertEqual(entry.total_cents, 504)
+        self.assertEqual(calculate_upgrade_totals(old_p, new_p, days_remaining=1, cycle_days=2), (501, 3, 504))
+
+    def test_zero_days_remaining_and_full_cycle_bounds_are_valid(self) -> None:
