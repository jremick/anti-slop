+    if not isinstance(code, str) or not code.strip():
+        raise ValidationError(f"{field_name} must be a non-empty string")
+    if any(ch.isspace() for ch in code) or any(sep in code for sep in _DISALLOWED_PROMO_CHARS):
+        raise ValidationError(f"Invalid or stacked {field_name}: {code}")
+    return code
