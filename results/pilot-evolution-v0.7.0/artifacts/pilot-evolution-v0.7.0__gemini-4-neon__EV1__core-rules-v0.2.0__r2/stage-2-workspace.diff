+    def test_rejects_unknown_ids_non_upgrades_bounds_booleans_and_empty_key(self) -> None:
+        sub = self.svc.start_subscription("acct_err", "pro")
+
+        # Unknown IDs
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription("sub_missing", "enterprise", 10, 30, idempotency_key="k_unk_sub")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "plan_missing", 10, 30, idempotency_key="k_unk_plan")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription("", "enterprise", 10, 30, idempotency_key="k_empty_sub")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "   ", 10, 30, idempotency_key="k_empty_plan")
+
+        # Non-upgrades (same plan, equal monthly_cents, downgrade)
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "pro", 10, 30, idempotency_key="k_same")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "starter", 10, 30, idempotency_key="k_down")
+        sub_s = self.svc.start_subscription("acct_eq", "starter")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub_s.subscription_id, "starter_alt", 10, 30, idempotency_key="k_eq")
+
+        # Invalid bounds
+        for days_rem, cyc in [(10, 0), (10, -5), (-1, 30), (31, 30)]:
+            with self.assertRaises(ValidationError):
+                self.svc.upgrade_subscription(
+                    sub.subscription_id,
+                    "enterprise",
+                    days_rem,
+                    cyc,
+                    idempotency_key=f"k_bounds_{days_rem}_{cyc}",
+                )
+
+        # Booleans and non-ints
+        for bad_days, bad_cycle in [
+            (True, 30),
+            (False, 30),
+            (1, True),
+            (0, False),
+            (1.5, 30),  # type: ignore[arg-type]
+            (10, 30.0),  # type: ignore[arg-type]
+            ("10", 30),  # type: ignore[arg-type]
