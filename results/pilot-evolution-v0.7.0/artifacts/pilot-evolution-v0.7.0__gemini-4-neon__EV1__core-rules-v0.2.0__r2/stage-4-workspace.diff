+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+
+    def test_multi_chunk_refunds_conserve_every_penny_of_tax_and_subtotal(self) -> None:
+        # subtotal=3998, tax=330 (8.25%), total=4328
+        order = self.svc.place_order(
+            "acct_1",
+            [LineItem(sku="seat", unit_cents=1999, quantity=2)],
+            tax_bps=825,
+        )
+        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (3998, 330, 4328))
+
+        # Split into 7 uneven chunks summing exactly to 4328
+        chunks = [1, 7, 13, 333, 999, 1500, 1475]
+        self.assertEqual(sum(chunks), order.total_cents)
+
+        entries = []
+        for idx, amt in enumerate(chunks):
+            entry = self.svc.refund_order(
+                order.order_id,
+                amt,
+                reason=f"partial refund {idx}",
+                idempotency_key=f"ref_{idx}",
+            )
+            self.assertEqual(entry.kind, "order_refund")
+            self.assertEqual(entry.reference_id, order.order_id)
+            self.assertEqual(entry.account_id, "acct_1")
+            self.assertEqual(entry.reason, f"partial refund {idx}")
+            self.assertEqual(entry.total_cents, -amt)
+            self.assertLessEqual(entry.subtotal_cents, 0)
+            self.assertLessEqual(entry.tax_cents, 0)
+            self.assertEqual(entry.subtotal_cents + entry.tax_cents, entry.total_cents)
+            entries.append(entry)
+
+        # Cumulative conservation: zero penny drift on tax, subtotal, and total
+        self.assertEqual(sum(-e.subtotal_cents for e in entries), order.subtotal_cents)
+        self.assertEqual(sum(-e.tax_cents for e in entries), order.tax_cents)
+        self.assertEqual(sum(-e.total_cents for e in entries), order.total_cents)
+
+        stmt = self.svc.get_statement("acct_1")
+        self.assertEqual(stmt["balance_cents"], 0)
+        self.assertEqual(stmt["entry_count"], 1 + len(chunks))
+
+    def test_one_cent_at_a_time_refund_conserves_exact_tax_and_subtotal(self) -> None:
