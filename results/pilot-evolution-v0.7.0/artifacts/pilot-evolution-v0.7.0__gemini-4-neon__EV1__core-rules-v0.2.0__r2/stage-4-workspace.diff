+"""Unit tests for Turn 2: promo codes across orders and upgrades."""
+
+from __future__ import annotations
+
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, Promo, ValidationError
+from ev1_order_ledger.pricing import apply_discount_and_tax
+
+
+class PromoCodeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=500))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="enterprise", name="Enterprise", monthly_cents=5000, tax_bps=1000))
+
+    def test_register_promo_validation(self) -> None:
+        # Valid percentage promo
+        p_pct = self.svc.register_promo("SAVE10", percent_off=10, expires_on="2026-12-31", min_subtotal_cents=500)
+        self.assertEqual(p_pct.code, "SAVE10")
+        self.assertEqual(p_pct.percent_off, 10)
+        self.assertIsNone(p_pct.amount_off_cents)
+
+        # Valid fixed promo (boundary values: percent 1/100, amount 1, min_subtotal 0)
+        self.svc.register_promo("PCT1", percent_off=1)
+        self.svc.register_promo("PCT100", percent_off=100)
+        self.svc.register_promo("OFF1", amount_off_cents=1, min_subtotal_cents=0)
+
+        # Neither or both discount types
+        with self.assertRaises(ValidationError):
+            self.svc.register_promo("NONE")
+        with self.assertRaises(ValidationError):
+            self.svc.register_promo("BOTH", percent_off=10, amount_off_cents=100)
+
+        # Out-of-range or boolean discount values
+        for bad_pct in [0, -5, 101, True, False, 10.5, "10"]:
+            with self.assertRaises(ValidationError):
+                self.svc.register_promo("BADPCT", percent_off=bad_pct)  # type: ignore[arg-type]
+        for bad_amt in [0, -100, True, False, 10.5, "100"]:
+            with self.assertRaises(ValidationError):
+                self.svc.register_promo("BADAMT", amount_off_cents=bad_amt)  # type: ignore[arg-type]
+
+        # Invalid min_subtotal_cents
+        for bad_min in [-1, True, False, 10.0, "10"]:
+            with self.assertRaises(ValidationError):
+                self.svc.register_promo("BADMIN", percent_off=10, min_subtotal_cents=bad_min)  # type: ignore[arg-type]
+
+        # Empty, multi-code, or non-string codes
+        for bad_code in ["", "   ", "A,B", "A;B", "A B", "A+B", "A|B", None, True, 123]:
+            with self.assertRaises(ValidationError):
+                self.svc.register_promo(bad_code, percent_off=10)  # type: ignore[arg-type]
+
+        # Invalid expires_on format or calendar date
+        for bad_date in ["", "2026-13-01", "2026-02-29", "2026-1-1", "20260101", True, 20260101]:
+            with self.assertRaises(ValidationError):
+                self.svc.register_promo("BADDATE", percent_off=10, expires_on=bad_date)  # type: ignore[arg-type]
+
+    def test_order_percentage_promo_and_half_up_rounding(self) -> None:
+        self.svc.register_promo("SAVE15", percent_off=15)
+        order = self.svc.place_order(
+            "acct_1",
+            [LineItem(sku="widget", unit_cents=1005, quantity=1)],
+            tax_bps=825,
+            promo_code="SAVE15",
+        )
+        # discount = round_half_up(1005 * 15 / 100) = round_half_up(150.75) = 151
+        # discounted_subtotal = 1005 - 151 = 854
+        # tax = round_half_up(854 * 825 / 10000) = round_half_up(70.455) = 70
+        self.assertEqual(order.discount_cents, 151)
+        self.assertEqual(order.subtotal_cents, 854)
+        self.assertEqual(order.tax_cents, 70)
+        self.assertEqual(order.total_cents, 924)
+        self.assertEqual(order.promo_code, "SAVE15")
+
+        stmt = self.svc.get_statement("acct_1")
+        self.assertEqual(stmt["balance_cents"], 924)
+        self.assertEqual(stmt["entry_count"], 1)
+
+    def test_order_fixed_promo_clamps_subtotal_at_zero(self) -> None:
+        self.svc.register_promo("BIGOFF", amount_off_cents=5000)
+        order = self.svc.place_order(
+            "acct_clamp",
+            [LineItem(sku="widget", unit_cents=1200, quantity=1)],
+            tax_bps=1000,
+            promo_code="BIGOFF",
+        )
+        self.assertEqual(order.discount_cents, 1200)
+        self.assertEqual(order.subtotal_cents, 0)
+        self.assertEqual(order.tax_cents, 0)
+        self.assertEqual(order.total_cents, 0)
+        self.assertEqual(order.promo_code, "BIGOFF")
+
+    def test_order_fixed_promo_reduces_subtotal_before_tax(self) -> None:
+        self.svc.register_promo("FLAT250", amount_off_cents=250, min_subtotal_cents=1500)
+        order = self.svc.place_order(
+            "acct_fixed",
+            [LineItem(sku="seat", unit_cents=1500, quantity=1)],
+            tax_bps=1000,
+            promo_code="FLAT250",
+        )
+        # gross = 1500 (meets min_subtotal_cents=1500)
+        # discounted = 1500 - 250 = 1250; tax = 125; total = 1375
+        self.assertEqual(order.discount_cents, 250)
+        self.assertEqual(order.subtotal_cents, 1250)
+        self.assertEqual(order.tax_cents, 125)
+        self.assertEqual(order.total_cents, 1375)
+        self.assertEqual(order.promo_code, "FLAT250")
+
+    def test_promo_expiry_and_stacking_and_unknown_fail_closed(self) -> None:
+        self.svc.register_promo("A", percent_off=10)
+        self.svc.register_promo("B", amount_off_cents=100)
+        self.svc.register_promo("EXP", percent_off=20, expires_on="2026-06-30")
+        items = [LineItem(sku="seat", unit_cents=1000, quantity=1)]
+
+        # Unknown promo code fails closed
+        with self.assertRaises(ValidationError):
+            self.svc.place_order("acct_err", items, promo_code="DOES_NOT_EXIST")
+
+        # Empty promo code string fails closed
+        with self.assertRaises(ValidationError):
+            self.svc.place_order("acct_err", items, promo_code="")
+
+        # Multi-code stacking strings fail closed
+        for stacked in ["A,B", "A, B", "A;B", "A+B", "A B", "A|B"]:
+            with self.assertRaises(ValidationError):
+                self.svc.place_order("acct_err", items, promo_code=stacked)
+
+        # Expiring promo requires as_of
+        with self.assertRaises(ValidationError):
+            self.svc.place_order("acct_err", items, promo_code="EXP")
+
+        # Expiring promo rejects as_of > expires_on
+        with self.assertRaises(ValidationError):
+            self.svc.place_order("acct_err", items, promo_code="EXP", as_of="2026-07-01")
