+"""Unit tests for Turn 4: legacy_flat_fee removal and fail-closed audit logging."""
+
+from __future__ import annotations
+
+import unittest
+from typing import Dict, List
+
+import ev1_order_ledger.pricing as pricing
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, ValidationError
+
+
+class LegacyRemovalAndAuditTests(unittest.TestCase):
+    def test_legacy_flat_fee_is_completely_removed(self) -> None:
+        self.assertFalse(hasattr(pricing, "LEGACY_FLAT_FEE_CENTS"))
+
+        svc = OrderService()
+        items = [LineItem(sku="seat", unit_cents=1000, quantity=1)]
+
+        with self.assertRaises(TypeError):
+            pricing.calculate_order_totals(items, tax_bps=1000, legacy_flat_fee=True)  # type: ignore[call-arg]
+        with self.assertRaises(TypeError):
+            pricing.calculate_order_totals(items, legacy_flat_fee=False)  # type: ignore[call-arg]
+        with self.assertRaises(TypeError):
+            svc.place_order("acct_1", items, tax_bps=1000, legacy_flat_fee=True)  # type: ignore[call-arg]
+        with self.assertRaises(TypeError):
+            svc.place_order("acct_1", items, legacy_flat_fee=False)  # type: ignore[call-arg]
+
+    def test_audit_sink_emits_for_committed_mutations_and_skips_replays(self) -> None:
+        events: List[Dict[str, object]] = []
+        svc = OrderService(audit_sink=events.append)
+        svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=825))
+        svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+
+        # 1. place_order
+        order = svc.place_order("acct_1", [LineItem(sku="seat", unit_cents=1000, quantity=1)], tax_bps=1000)
+        order_entry = svc.ledger.entries_for_account("acct_1")[0]
+        self.assertEqual(len(events), 1)
+        self.assertEqual(
+            events[0],
+            {
+                "action": "order_charge",
+                "account_id": "acct_1",
+                "amount_cents": order.total_cents,
+                "entry_id": order_entry.entry_id,
+            },
+        )
+
+        # 2. upgrade_subscription + replay
+        sub = svc.start_subscription("acct_1", "starter")
+        upg_entry = svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="u1")
+        self.assertEqual(len(events), 2)
+        self.assertEqual(
+            events[1],
+            {
+                "action": "plan_upgrade",
+                "account_id": "acct_1",
+                "amount_cents": upg_entry.total_cents,
+                "entry_id": upg_entry.entry_id,
+            },
+        )
+        # Replay must NOT emit a duplicate audit event
+        replay_upg = svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="u1")
+        self.assertEqual(replay_upg, upg_entry)
+        self.assertEqual(len(events), 2)
+
+        # 3. refund_order + replay
+        ref_entry = svc.refund_order(order.order_id, 500, reason="partial", idempotency_key="r1")
+        self.assertEqual(len(events), 3)
+        self.assertEqual(
+            events[2],
+            {
+                "action": "order_refund",
+                "account_id": "acct_1",
+                "amount_cents": -500,
+                "entry_id": ref_entry.entry_id,
+            },
+        )
+        # Replay must NOT emit a duplicate audit event
+        replay_ref = svc.refund_order(order.order_id, 500, reason="partial", idempotency_key="r1")
+        self.assertEqual(replay_ref, ref_entry)
+        self.assertEqual(len(events), 3)
+
+    def test_audit_sink_failure_is_atomic_and_fail_closed(self) -> None:
+        should_fail = True
+        recorded: List[Dict[str, object]] = []
+
+        def flaky_sink(event: Dict[str, object]) -> None:
+            if should_fail:
+                raise RuntimeError("audit pipeline unavailable")
+            recorded.append(event)
+
+        svc = OrderService(audit_sink=flaky_sink)
+        svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=825))
+        svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+
+        # 1. place_order fails closed: no order or ledger entry committed
+        with self.assertRaisesRegex(RuntimeError, "audit pipeline unavailable"):
+            svc.place_order("acct_fail", [LineItem(sku="seat", unit_cents=1000, quantity=1)], tax_bps=1000)
+        self.assertEqual(svc.get_statement("acct_fail")["entry_count"], 0)
+        self.assertEqual(svc.get_statement("acct_fail")["balance_cents"], 0)
+        self.assertEqual(len(recorded), 0)
+
+        # Recover sink to place a valid order for refund test
+        should_fail = False
+        order = svc.place_order("acct_fail", [LineItem(sku="seat", unit_cents=1000, quantity=1)], tax_bps=1000)
+        self.assertEqual(svc.get_statement("acct_fail")["entry_count"], 1)
+        self.assertEqual(len(recorded), 1)
+
+        # 2. upgrade_subscription fails closed: plan_id unchanged, no entry, idempotency key not poisoned
+        sub = svc.start_subscription("acct_fail", "starter")
+        should_fail = True
+        with self.assertRaisesRegex(RuntimeError, "audit pipeline unavailable"):
+            svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="upg_atomic")
+        self.assertEqual(svc.ledger.get_subscription(sub.subscription_id).plan_id, "starter")
+        self.assertEqual(svc.get_statement("acct_fail")["entry_count"], 1)
+
+        # Once sink recovers, same idempotency_key succeeds cleanly
+        should_fail = False
+        upg_entry = svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="upg_atomic")
+        self.assertEqual(svc.ledger.get_subscription(sub.subscription_id).plan_id, "pro")
+        self.assertEqual(svc.get_statement("acct_fail")["entry_count"], 2)
+        self.assertEqual(recorded[-1]["entry_id"], upg_entry.entry_id)
+
+        # 3. refund_order fails closed: no refund entry, refundable balance intact, key not poisoned
+        should_fail = True
+        with self.assertRaisesRegex(RuntimeError, "audit pipeline unavailable"):
+            svc.refund_order(order.order_id, 500, reason="broken", idempotency_key="ref_atomic")
+        self.assertEqual(svc.ledger.order_refunded_totals(order.order_id), (0, 0, 0))
+        self.assertEqual(svc.get_statement("acct_fail")["entry_count"], 2)
+
+        # Once sink recovers, same idempotency_key succeeds cleanly
+        should_fail = False
+        ref_entry = svc.refund_order(order.order_id, 500, reason="broken", idempotency_key="ref_atomic")
+        self.assertEqual(svc.ledger.order_refunded_totals(order.order_id)[2], 500)
+        self.assertEqual(svc.get_statement("acct_fail")["entry_count"], 3)
+        self.assertEqual(recorded[-1]["entry_id"], ref_entry.entry_id)
+
+    def test_non_callable_audit_sink_rejected(self) -> None:
+        with self.assertRaises(ValidationError):
+            OrderService(audit_sink="not-callable")  # type: ignore[arg-type]
+
+
+if __name__ == "__main__":
+    unittest.main()

