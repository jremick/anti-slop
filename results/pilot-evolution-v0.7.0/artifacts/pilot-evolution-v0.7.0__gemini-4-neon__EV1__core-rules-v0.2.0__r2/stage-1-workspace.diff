+    @staticmethod
+    def validate_idempotency_key(idempotency_key: str) -> str:
+        if not isinstance(idempotency_key, str) or not idempotency_key.strip():
+            raise ValidationError("idempotency_key must be a non-empty string")
+        return idempotency_key
+
+    @staticmethod
+    def _normalize_fingerprint(fingerprint: Tuple[object, ...]) -> Tuple[Tuple[type, object], ...]:
+        return tuple((type(part), part) for part in fingerprint)
+
+    def lookup_idempotent_entry(
+        self,
+        idempotency_key: str,
+        fingerprint: Tuple[object, ...],
+    ) -> Optional[LedgerEntry]:
+        key = self.validate_idempotency_key(idempotency_key)
+        existing = self._idempotency.get(key)
+        if existing is None:
+            return None
+        stored_fingerprint, entry_id = existing
+        if stored_fingerprint != self._normalize_fingerprint(fingerprint):
+            raise ValidationError(f"Idempotency key conflict for key: {key}")
+        return self._entries[entry_id]
+
+    def record_idempotent_entry(
+        self,
+        idempotency_key: str,
+        fingerprint: Tuple[object, ...],
+        entry: LedgerEntry,
+    ) -> LedgerEntry:
+        key = self.validate_idempotency_key(idempotency_key)
+        normalized = self._normalize_fingerprint(fingerprint)
+        existing = self._idempotency.get(key)
+        if existing is not None:
+            stored_fingerprint, entry_id = existing
+            if stored_fingerprint != normalized:
+                raise ValidationError(f"Idempotency key conflict for key: {key}")
+            return self._entries[entry_id]
+        self.record_entry(entry)
+        self._idempotency[key] = (normalized, entry.entry_id)
+        return entry
+
     def get_entry(self, entry_id: str) -> Optional[LedgerEntry]:
         return self._entries.get(entry_id)
 

