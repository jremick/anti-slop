+"""Unit tests for prorated subscription upgrades."""
+
+import unittest
+
+from ev1_order_ledger import OrderService, Plan, ValidationError
+
+
+class SubscriptionUpgradeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.service = OrderService()
+        self.service.register_plan(Plan("starter", "Starter", 1000, tax_bps=825))
+        self.service.register_plan(Plan("pro", "Pro", 1005, tax_bps=5000))
+        self.service.register_plan(Plan("max", "Max", 1020))
+        self.service.register_plan(Plan("peer", "Peer", 1000))
+        self.service.register_plan(Plan("basic", "Basic", 900))
+        self.sub = self.service.start_subscription("acct_1", "starter")
+
+    def test_proration_and_new_plan_tax_round_half_up(self) -> None:
+        entry = self.service.upgrade_subscription(
+            self.sub.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+
+        # The 5-cent increase prorates to 2.5 cents, then 3 cents is taxed at 50%.
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (3, 2, 5))
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.sub.subscription_id)
+        self.assertEqual(entry.account_id, self.sub.account_id)
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertIs(self.service.ledger.get_entry(entry.entry_id), entry)
+        self.assertEqual(self.service.get_statement(self.sub.account_id)["balance_cents"], 5)
+
+    def test_proration_at_window_edges_and_on_either_side_of_half(self) -> None:
+        self.service.register_plan(Plan("max_plus", "Max Plus", 1031))
+        for days_remaining, expected_subtotal in ((0, 0), (2, 4), (3, 7), (5, 11)):
+            with self.subTest(days_remaining=days_remaining):
+                sub = self.service.start_subscription("acct_1", "max")
+                entry = self.service.upgrade_subscription(
+                    sub.subscription_id, "max_plus", days_remaining, 5,
+                    idempotency_key=str(days_remaining),
+                )
+                self.assertEqual(entry.subtotal_cents, expected_subtotal)
+                self.assertEqual(sub.plan_id, "max_plus")
+
+    def test_invalid_upgrades_leave_subscription_and_ledger_unchanged(self) -> None:
+        sub_id = self.sub.subscription_id
+        cases = (
+            ("unknown", "pro", 1, 2, "upgrade"),
+            (sub_id, "unknown", 1, 2, "upgrade"),
+            (sub_id, "starter", 1, 2, "upgrade"),
+            (sub_id, "peer", 1, 2, "upgrade"),
+            (sub_id, "basic", 1, 2, "upgrade"),
+            (sub_id, "pro", 0, 0, "upgrade"),
+            (sub_id, "pro", 0, -1, "upgrade"),
+            (sub_id, "pro", -1, 2, "upgrade"),
+            (sub_id, "pro", 3, 2, "upgrade"),
+            (sub_id, "pro", True, 2, "upgrade"),
+            (sub_id, "pro", 1, True, "upgrade"),
+            (sub_id, "pro", 1.0, 2, "upgrade"),
+            (True, "pro", 1, 2, "upgrade"),
+            (sub_id, True, 1, 2, "upgrade"),
+            (sub_id, "pro", 1, 2, True),
+            (sub_id, "pro", 1, 2, ""),
+            (sub_id, "pro", 1, 2, "  "),
+        )
+        for subscription_id, plan_id, remaining, cycle, key in cases:
+            with self.subTest(args=(subscription_id, plan_id, remaining, cycle, key)):
+                with self.assertRaises(ValidationError):
+                    self.service.upgrade_subscription(
+                        subscription_id, plan_id, remaining, cycle, idempotency_key=key
+                    )
+                self.assertEqual(self.sub.plan_id, "starter")
+                self.assertEqual(self.service.ledger.entries_for_account(self.sub.account_id), [])
+
+        self.service.upgrade_subscription(sub_id, "pro", 1, 2, idempotency_key="upgrade")
+        self.assertEqual(self.sub.plan_id, "pro")
+
+    def test_replay_returns_original_entry_even_after_another_upgrade(self) -> None:
+        sub_id = self.sub.subscription_id
+        original = self.service.upgrade_subscription(sub_id, "pro", 1, 2, idempotency_key="first")
+        second_service = OrderService(self.service.ledger)
+        replay = second_service.upgrade_subscription(sub_id, "pro", 1, 2, idempotency_key="first")
+        self.assertIs(replay, original)
+        self.assertEqual(self.service.ledger.entries_for_account(self.sub.account_id), [original])
+
+        later = self.service.upgrade_subscription(sub_id, "max", 1, 2, idempotency_key="later")
+        replay = second_service.upgrade_subscription(sub_id, "pro", 1, 2, idempotency_key="first")
+        self.assertIs(replay, original)
+        self.assertEqual(self.sub.plan_id, "max")
+        self.assertEqual(self.service.ledger.entries_for_account(self.sub.account_id), [original, later])
+
+    def test_reused_key_rejects_changes_to_each_argument(self) -> None:
+        sub_id = self.sub.subscription_id
+        other = self.service.start_subscription("acct_2", "starter")
+        original = self.service.upgrade_subscription(sub_id, "pro", 1, 2, idempotency_key="upgrade")
+        cases = (
+            (other.subscription_id, "pro", 1, 2),
+            (sub_id, "max", 1, 2),
+            (sub_id, "pro", 2, 2),
+            (sub_id, "pro", 1, 3),
+            (sub_id, "pro", True, 2),  # True compares equal to 1 in Python.
+            (sub_id, "pro", 1.0, 2),
+        )
+        for args in cases:
+            with self.subTest(args=args):
+                with self.assertRaises(ValidationError):
+                    self.service.upgrade_subscription(*args, idempotency_key="upgrade")
+
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertEqual(other.plan_id, "starter")
+        self.assertEqual(self.service.ledger.entries_for_account(self.sub.account_id), [original])
+        self.assertEqual(self.service.ledger.entries_for_account(other.account_id), [])
+        replay = self.service.upgrade_subscription(sub_id, "pro", 1, 2, idempotency_key="upgrade")
+        self.assertIs(replay, original)
