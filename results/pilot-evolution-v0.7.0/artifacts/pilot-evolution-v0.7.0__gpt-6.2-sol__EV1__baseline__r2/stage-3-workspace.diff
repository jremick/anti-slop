+def parse_optional_date(value: str | None, field_name: str) -> date | None:
+    if value is None:
+        return None
+    if not isinstance(value, str):
+        raise ValidationError(f"{field_name} must be a YYYY-MM-DD date")
+    try:
+        parsed = date.fromisoformat(value)
+    except ValueError as exc:
+        raise ValidationError(f"{field_name} must be a YYYY-MM-DD date") from exc
+    if parsed.isoformat() != value:
+        raise ValidationError(f"{field_name} must be a YYYY-MM-DD date")
+    return parsed
+
+
+def calculate_charge_totals(
+    subtotal_cents: int,
+    tax_bps: int,
+    *,
+    promo: Promo | None = None,
+    as_of: str | None = None,
+) -> Tuple[int, int, int, int]:
+    """Return discounted subtotal, tax, total, and applied discount in cents."""
+    pricing_date = parse_optional_date(as_of, "as_of")
+    discount = 0
+    if promo is not None:
+        if promo.expires_on is not None:
+            if pricing_date is None or pricing_date > promo.expires_on:
+                raise ValidationError("as_of is required and must be on or before the promo expiry date")
+        if subtotal_cents < promo.min_subtotal_cents:
+            raise ValidationError("subtotal is below the promo minimum")
+        if promo.percent_off is not None:
+            discount = round_half_up_div(subtotal_cents * promo.percent_off, 100)
+        elif promo.amount_off_cents is not None:
+            discount = min(subtotal_cents, promo.amount_off_cents)
+    subtotal = subtotal_cents - discount
+    tax = compute_tax_cents(subtotal, tax_bps)
+    return subtotal, tax, subtotal + tax, discount
