+
+        # Failed calls must not mutate subscription or poison idempotency keys
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "starter")
+        self.assertEqual(self.svc.get_statement("acct_1")["entry_count"], 0)
+        entry = self.svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="bad-win-0")
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(self.svc.get_statement("acct_1")["entry_count"], 1)
