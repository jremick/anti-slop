+    def test_rejects_invalid_bounds_booleans_and_empty_idempotency_key(self) -> None:
+        sub = self.svc.start_subscription("acct_1", "starter")
+
+        invalid_windows = [
+            (15, 0),
+            (15, -30),
+            (-1, 30),
+            (31, 30),
+            (True, 30),
+            (False, 30),
+            (1, True),
+            (0, False),
+            (15.0, 30),
+            (15, 30.0),
+            ("15", 30),
+            (None, 30),
+        ]
+        for idx, (days_rem, cycle) in enumerate(invalid_windows):
+            with self.subTest(days_remaining=days_rem, cycle_days=cycle):
+                with self.assertRaises(ValidationError):
+                    self.svc.upgrade_subscription(
+                        sub.subscription_id,
+                        "pro",
+                        days_rem,  # type: ignore[arg-type]
+                        cycle,  # type: ignore[arg-type]
+                        idempotency_key=f"bad-win-{idx}",
+                    )
+
+        invalid_keys = ["", "   ", "\t\n", None, True, False, 123]
+        for bad_key in invalid_keys:
+            with self.subTest(idempotency_key=bad_key):
+                with self.assertRaises(ValidationError):
+                    self.svc.upgrade_subscription(
+                        sub.subscription_id,
+                        "pro",
+                        15,
+                        30,
+                        idempotency_key=bad_key,  # type: ignore[arg-type]
+                    )
+
+        # Booleans for string IDs
+        with self.assertRaises(ValidationError):
