+"""Unit tests for legacy_flat_fee removal and fail-closed audit_sink logging."""
+
+from __future__ import annotations
+
+import unittest
+from typing import Dict, List
+
+from ev1_order_ledger import pricing
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, ValidationError
+
+
+class AuditFailError(RuntimeError):
+    """Sentinel error raised by a failing audit sink."""
+
+
+class LegacyCleanupAndAuditSinkTests(unittest.TestCase):
+    def test_legacy_flat_fee_completely_removed(self) -> None:
+        self.assertFalse(hasattr(pricing, "LEGACY_FLAT_FEE_CENTS"))
+
+        items = [LineItem(sku="seat", unit_cents=1000, quantity=1)]
+        with self.assertRaises(TypeError):
+            pricing.calculate_order_totals(items, tax_bps=1000, legacy_flat_fee=True)  # type: ignore[call-arg]
+        with self.assertRaises(TypeError):
+            pricing.calculate_order_totals(items, tax_bps=1000, legacy_flat_fee=False)  # type: ignore[call-arg]
+        with self.assertRaises(TypeError):
+            pricing.calculate_order_pricing(items, tax_bps=1000, legacy_flat_fee=True)  # type: ignore[call-arg]
+
+        svc = OrderService()
+        with self.assertRaises(TypeError):
+            svc.place_order("acct_1", items, tax_bps=1000, legacy_flat_fee=True)  # type: ignore[call-arg]
+        with self.assertRaises(TypeError):
+            svc.place_order("acct_1", items, tax_bps=1000, legacy_flat_fee=False)  # type: ignore[call-arg]
+        self.assertEqual(svc.get_statement("acct_1")["entry_count"], 0)
+
+    def test_audit_sink_logs_committed_mutations_and_skips_replays(self) -> None:
+        events: List[Dict[str, object]] = []
+        svc = OrderService(audit_sink=events.append)
+        svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=825))
+        svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+
+        # 1) place_order
+        order = svc.place_order("acct_1", [LineItem(sku="seat", unit_cents=1000, quantity=1)], tax_bps=1000)
+        order_entry = svc.ledger.entries_for_account("acct_1")[0]
+        self.assertEqual(len(events), 1)
+        self.assertEqual(
+            events[0],
+            {
+                "action": "order_charge",
+                "account_id": "acct_1",
+                "amount_cents": order.total_cents,
+                "entry_id": order_entry.entry_id,
+            },
+        )
+
+        # 2) upgrade_subscription + idempotent replay (replay must NOT emit duplicate event)
+        sub = svc.start_subscription("acct_1", "starter")
+        self.assertEqual(len(events), 1)
+        upg_entry = svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="aud-upg-1")
+        self.assertEqual(len(events), 2)
+        self.assertEqual(
+            events[1],
+            {
+                "action": "plan_upgrade",
+                "account_id": "acct_1",
+                "amount_cents": upg_entry.total_cents,
+                "entry_id": upg_entry.entry_id,
+            },
+        )
+        replay_upg = svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="aud-upg-1")
+        self.assertEqual(replay_upg, upg_entry)
+        self.assertEqual(len(events), 2)
+
+        # 3) refund_order + idempotent replay (replay must NOT emit duplicate event)
+        ref_entry = svc.refund_order(order.order_id, 500, reason="partial", idempotency_key="aud-ref-1")
+        self.assertEqual(len(events), 3)
+        self.assertEqual(
+            events[2],
+            {
+                "action": "order_refund",
+                "account_id": "acct_1",
+                "amount_cents": -500,
+                "entry_id": ref_entry.entry_id,
+            },
+        )
+        replay_ref = svc.refund_order(order.order_id, 500, reason="partial", idempotency_key="aud-ref-1")
+        self.assertEqual(replay_ref, ref_entry)
+        self.assertEqual(len(events), 3)
+
+    def test_audit_sink_failure_is_fail_closed_and_atomic_for_all_mutations(self) -> None:
+        events: List[Dict[str, object]] = []
+        should_fail = {"flag": False}
+
+        def flaky_sink(event: Dict[str, object]) -> None:
+            if should_fail["flag"]:
+                raise AuditFailError("audit backend unavailable")
+            events.append(event)
+
+        svc = OrderService(audit_sink=flaky_sink)
+        svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=825))
+        svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+
+        # 1) Failing place_order commits neither order nor ledger entry
+        should_fail["flag"] = True
+        with self.assertRaises(AuditFailError):
+            svc.place_order("acct_1", [LineItem(sku="seat", unit_cents=1000, quantity=1)], tax_bps=1000)
+        self.assertEqual(svc.get_statement("acct_1")["entry_count"], 0)
+        self.assertEqual(svc.get_statement("acct_1")["balance_cents"], 0)
+        self.assertEqual(len(svc.ledger._orders), 0)
+        self.assertEqual(len(events), 0)
+
+        # Recover and place order for refund test
+        should_fail["flag"] = False
+        order = svc.place_order("acct_1", [LineItem(sku="seat", unit_cents=1000, quantity=1)], tax_bps=1000)
+        self.assertEqual(len(events), 1)
+        self.assertEqual(svc.get_statement("acct_1")["balance_cents"], 1100)
+
+        # 2) Failing upgrade_subscription commits neither plan change nor ledger entry nor idempotency key
+        sub = svc.start_subscription("acct_1", "starter")
+        should_fail["flag"] = True
+        with self.assertRaises(AuditFailError):
+            svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="retry-upg")
+        self.assertEqual(svc.ledger.get_subscription(sub.subscription_id).plan_id, "starter")
+        self.assertEqual(svc.get_statement("acct_1")["entry_count"], 1)
+        self.assertEqual(svc.get_statement("acct_1")["balance_cents"], 1100)
+
+        # Retry with same idempotency_key after recovery succeeds cleanly
+        should_fail["flag"] = False
+        upg_entry = svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="retry-upg")
+        self.assertEqual(svc.ledger.get_subscription(sub.subscription_id).plan_id, "pro")
+        self.assertEqual(len(events), 2)
+        self.assertEqual(events[1]["entry_id"], upg_entry.entry_id)
+
+        # 3) Failing refund_order commits neither ledger entry nor refunded totals nor idempotency key
+        balance_before_refund = svc.get_statement("acct_1")["balance_cents"]
+        should_fail["flag"] = True
+        with self.assertRaises(AuditFailError):
+            svc.refund_order(order.order_id, 500, reason="broken", idempotency_key="retry-ref")
+        self.assertEqual(svc.get_statement("acct_1")["entry_count"], 2)
+        self.assertEqual(svc.get_statement("acct_1")["balance_cents"], balance_before_refund)
+        self.assertEqual(svc.ledger.refunded_totals_for_order(order.order_id), (0, 0, 0))
+
+        # Retry with same idempotency_key after recovery succeeds cleanly
+        should_fail["flag"] = False
+        ref_entry = svc.refund_order(order.order_id, 500, reason="broken", idempotency_key="retry-ref")
+        self.assertEqual(len(events), 3)
+        self.assertEqual(events[2]["entry_id"], ref_entry.entry_id)
+        self.assertEqual(svc.ledger.refunded_totals_for_order(order.order_id)[2], 500)
+
+    def test_non_callable_audit_sink_rejected(self) -> None:
+        with self.assertRaises(ValidationError):
+            OrderService(audit_sink="not-callable")  # type: ignore[arg-type]
+
+
+if __name__ == "__main__":
+    unittest.main()

