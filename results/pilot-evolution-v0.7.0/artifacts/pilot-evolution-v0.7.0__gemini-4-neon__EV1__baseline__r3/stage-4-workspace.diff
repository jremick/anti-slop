+"""Unit tests for promo codes across orders and mid-cycle subscription upgrades."""
+
+from __future__ import annotations
+
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, Promo, ValidationError
+from ev1_order_ledger.pricing import apply_promo_and_tax, compute_tax_cents
+
+
+class PromoCodeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=500))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="enterprise", name="Enterprise", monthly_cents=5000, tax_bps=1000))
+
+    def test_register_promo_validation(self) -> None:
+        p1 = self.svc.register_promo("SAVE10", percent_off=10, min_subtotal_cents=500, expires_on="2026-12-31")
+        self.assertEqual(p1.code, "SAVE10")
+        p2 = self.svc.register_promo("FLAT500", amount_off_cents=500)
+        self.assertEqual(p2.amount_off_cents, 500)
+        self.svc.register_promo("FREE100", percent_off=100)
+        self.svc.register_promo("TINY1", percent_off=1, amount_off_cents=None, min_subtotal_cents=0)
+
+        invalid_registrations = [
+            # Neither or both discount types
+            ("NONE", {}),
+            ("BOTH", {"percent_off": 10, "amount_off_cents": 100}),
+            # Invalid percent_off
+            ("P0", {"percent_off": 0}),
+            ("P101", {"percent_off": 101}),
+            ("PNEG", {"percent_off": -5}),
+            ("PBOOL", {"percent_off": True}),
+            ("PFLOAT", {"percent_off": 10.0}),
+            # Invalid amount_off_cents
+            ("A0", {"amount_off_cents": 0}),
+            ("ANEG", {"amount_off_cents": -100}),
+            ("ABOOL", {"amount_off_cents": True}),
+            ("AFLOAT", {"amount_off_cents": 50.5}),
+            # Invalid min_subtotal_cents
+            ("MNEG", {"percent_off": 10, "min_subtotal_cents": -1}),
+            ("MBOOL", {"percent_off": 10, "min_subtotal_cents": True}),
+            # Invalid codes (empty, whitespace, multi-code separators, non-string)
+            ("", {"percent_off": 10}),
+            ("   ", {"percent_off": 10}),
+            ("A,B", {"percent_off": 10}),
+            ("A;B", {"percent_off": 10}),
+            ("A+B", {"percent_off": 10}),
+            ("A|B", {"percent_off": 10}),
+            ("A B", {"percent_off": 10}),
+            (True, {"percent_off": 10}),
+            # Invalid expires_on
+            ("BADDATE1", {"percent_off": 10, "expires_on": ""}),
+            ("BADDATE2", {"percent_off": 10, "expires_on": "2026-02-30"}),
+            ("BADDATE3", {"percent_off": 10, "expires_on": "20260601"}),
+            ("BADDATE4", {"percent_off": 10, "expires_on": "2026-6-1"}),
+            ("BADDATE5", {"percent_off": 10, "expires_on": True}),
+        ]
+        for code, kwargs in invalid_registrations:
+            with self.subTest(code=code, kwargs=kwargs):
+                with self.assertRaises(ValidationError):
+                    self.svc.register_promo(code, **kwargs)  # type: ignore[arg-type]
+
+    def test_percentage_and_fixed_promos_on_orders(self) -> None:
+        self.svc.register_promo("PCT10", percent_off=10)
+        self.svc.register_promo("FLAT500", amount_off_cents=500)
+        self.svc.register_promo("BIG2000", amount_off_cents=2000)
+        self.svc.register_promo("ALL100", percent_off=100)
+
+        # Percentage with half-up tie: 1005 * 10 / 100 = 100.5 -> 101
+        # Discounted subtotal = 904; tax = 904 * 1000 / 10000 = 90.4 -> 90; total = 994
+        o1 = self.svc.place_order(
+            "acct_1",
+            [LineItem(sku="widget", unit_cents=1005, quantity=1)],
+            tax_bps=1000,
+            promo_code="PCT10",
+        )
+        self.assertEqual(o1.discount_cents, 101)
+        self.assertEqual(o1.subtotal_cents, 904)
+        self.assertEqual(o1.tax_cents, 90)
+        self.assertEqual(o1.total_cents, 994)
+        self.assertEqual(o1.promo_code, "PCT10")
+
+        # Fixed promo: 2000 - 500 = 1500; tax @ 825 bps = 1500 * 825 / 10000 = 123.75 -> 124
+        o2 = self.svc.place_order(
+            "acct_2",
+            [LineItem(sku="seat", unit_cents=1000, quantity=2)],
+            tax_bps=825,
+            promo_code="FLAT500",
+        )
+        self.assertEqual(o2.discount_cents, 500)
+        self.assertEqual(o2.subtotal_cents, 1500)
+        self.assertEqual(o2.tax_cents, 124)
+        self.assertEqual(o2.total_cents, 1624)
+        self.assertEqual(o2.promo_code, "FLAT500")
+
+        # Fixed promo exceeding subtotal clamps discounted subtotal at 0 (and tax is 0)
+        o3 = self.svc.place_order(
+            "acct_3",
+            [LineItem(sku="addon", unit_cents=750, quantity=1)],
+            tax_bps=1000,
+            promo_code="BIG2000",
+        )
+        self.assertEqual(o3.discount_cents, 750)
+        self.assertEqual(o3.subtotal_cents, 0)
+        self.assertEqual(o3.tax_cents, 0)
+        self.assertEqual(o3.total_cents, 0)
+        self.assertEqual(o3.promo_code, "BIG2000")
+
+        # 100% off promo
+        o4 = self.svc.place_order(
+            "acct_4",
+            [LineItem(sku="addon", unit_cents=1234, quantity=1)],
+            tax_bps=825,
+            promo_code="ALL100",
+        )
+        self.assertEqual(o4.discount_cents, 1234)
+        self.assertEqual(o4.subtotal_cents, 0)
+        self.assertEqual(o4.tax_cents, 0)
+        self.assertEqual(o4.total_cents, 0)
+        self.assertEqual(o4.promo_code, "ALL100")
+
+        # Ledger entries match discounted totals
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 994)
+        self.assertEqual(self.svc.get_statement("acct_2")["balance_cents"], 1624)
+        self.assertEqual(self.svc.get_statement("acct_3")["balance_cents"], 0)
+
+    def test_expiry_and_stacking_and_unknown_promos_fail_closed(self) -> None:
+        self.svc.register_promo("A", percent_off=10)
+        self.svc.register_promo("B", amount_off_cents=100)
+        self.svc.register_promo("SPRING", percent_off=20, expires_on="2026-06-30")
+
+        item = [LineItem(sku="seat", unit_cents=1000, quantity=1)]
+
+        # Valid on and before expiry date
+        o_before = self.svc.place_order("acct_ok", item, tax_bps=1000, promo_code="SPRING", as_of="2026-06-29")
+        self.assertEqual(o_before.subtotal_cents, 800)
+        self.assertEqual(o_before.discount_cents, 200)
+        self.assertEqual(o_before.tax_cents, 80)
+
+        o_on = self.svc.place_order("acct_ok", item, tax_bps=1000, promo_code="SPRING", as_of="2026-06-30")
+        self.assertEqual(o_on.subtotal_cents, 800)
+
+        # Missing as_of for expiring promo -> fail closed
+        with self.assertRaises(ValidationError):
+            self.svc.place_order("acct_fail", item, tax_bps=1000, promo_code="SPRING")
+
+        # Expired (as_of > expires_on) -> fail closed
+        with self.assertRaises(ValidationError):
+            self.svc.place_order("acct_fail", item, tax_bps=1000, promo_code="SPRING", as_of="2026-07-01")
+
+        # Invalid as_of format -> fail closed
+        with self.assertRaises(ValidationError):
+            self.svc.place_order("acct_fail", item, tax_bps=1000, promo_code="SPRING", as_of="2026/06/30")
+
+        # Unknown and multi-code / stacked strings -> fail closed
+        for bad_code in ("UNKNOWN", "A,B", "A, B", "A;B", "A+B", "A|B", "A B", "", "   ", ["A", "B"]):
+            with self.subTest(promo_code=bad_code):
+                with self.assertRaises(ValidationError):
+                    self.svc.place_order("acct_fail", item, promo_code=bad_code)  # type: ignore[arg-type]
+
+        # None of the failed orders should have written ledger entries
+        self.assertEqual(self.svc.get_statement("acct_fail")["entry_count"], 0)
+
+    def test_minimum_subtotal_enforced_on_orders_and_upgrades(self) -> None:
+        self.svc.register_promo("MIN1000", amount_off_cents=250, min_subtotal_cents=1000)
+
+        # Below minimum on order -> fail closed (never silently 0 discount)
+        with self.assertRaises(ValidationError):
+            self.svc.place_order(
+                "acct_1",
+                [LineItem(sku="x", unit_cents=999, quantity=1)],
+                promo_code="MIN1000",
+            )
+        self.assertEqual(self.svc.get_statement("acct_1")["entry_count"], 0)
+
+        # Exact minimum on order -> succeeds
+        order = self.svc.place_order(
+            "acct_1",
+            [LineItem(sku="x", unit_cents=1000, quantity=1)],
+            tax_bps=1000,
+            promo_code="MIN1000",
+        )
+        self.assertEqual(order.discount_cents, 250)
+        self.assertEqual(order.subtotal_cents, 750)
+        self.assertEqual(order.tax_cents, 75)
+        self.assertEqual(order.total_cents, 825)
+
+        # Below minimum on upgrade: starter(1000) -> pro(3000), 14/30 days = 933 < 1000 -> fail closed
+        sub = self.svc.start_subscription("acct_2", "starter")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(
+                sub.subscription_id,
+                "pro",
+                14,
+                30,
+                idempotency_key="upg-min-fail",
+                promo_code="MIN1000",
+            )
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "starter")
+        self.assertEqual(self.svc.get_statement("acct_2")["entry_count"], 0)
+
+        # Exact minimum on upgrade: 15/30 days = 1000 == 1000 -> succeeds (and key was not poisoned)
+        entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="upg-min-fail",
+            promo_code="MIN1000",
+        )
+        self.assertEqual(entry.subtotal_cents, 750)
+        self.assertEqual(entry.tax_cents, compute_tax_cents(750, 825))
+        self.assertEqual(entry.total_cents, 750 + compute_tax_cents(750, 825))
+        self.assertEqual(entry.metadata["discount_cents"], 250)
+        self.assertEqual(entry.metadata["promo_code"], "MIN1000")
+
+    def test_upgrade_with_promo_expiry_clamping_and_idempotency(self) -> None:
+        self.svc.register_promo("UPG25", percent_off=25, expires_on="2026-08-15")
+        self.svc.register_promo("HUGE", amount_off_cents=5000)
+
+        # 1) Percentage promo on prorated upgrade:
+        # delta = 2000, 10/30 -> prorated = 667
+        # 25% of 667 = 166.75 -> 167; discounted subtotal = 500
+        # tax on 500 @ 825 bps = 41.25 -> 41; total = 541
+        sub1 = self.svc.start_subscription("acct_1", "starter")
+        e1 = self.svc.upgrade_subscription(
+            sub1.subscription_id,
+            "pro",
+            10,
+            30,
+            idempotency_key="upg-promo-1",
+            promo_code="UPG25",
