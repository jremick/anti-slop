+    """Return (subtotal_cents, discount_cents, tax_cents, total_cents) for a mid-cycle plan upgrade."""
+    pre_discount_subtotal = compute_prorated_upgrade_cents(
+        old_plan.monthly_cents,
+        new_plan.monthly_cents,
+        days_remaining,
+        cycle_days,
+    )
+    return apply_promo_and_tax(
+        pre_discount_subtotal,
+        tax_bps=new_plan.tax_bps,
+        promo=promo,
+        as_of=as_of,
+    )
+
+
+def calculate_upgrade_totals(
+    old_plan: Plan,
+    new_plan: Plan,
+    days_remaining: int,
+    cycle_days: int,
+    *,
+    promo: Promo | None = None,
+    as_of: str | None = None,
+) -> Tuple[int, int, int]:
+    """Return (subtotal_cents, tax_cents, total_cents) for a mid-cycle plan upgrade."""
+    subtotal, _discount, tax, total = calculate_upgrade_pricing(
+        old_plan,
+        new_plan,
+        days_remaining,
+        cycle_days,
+        promo=promo,
+        as_of=as_of,
+    )
+    return subtotal, tax, total
+
+
+def compute_cumulative_refund_split(
+    order_total_cents: int,
+    order_tax_cents: int,
+    already_refunded_total_cents: int,
+    already_refunded_tax_cents: int,
+    refund_amount_cents: int,
+) -> Tuple[int, int]:
+    """Return (refund_subtotal_cents, refund_tax_cents) with exact cumulative penny conservation."""
+    validate_non_negative_int(order_total_cents, "order_total_cents")
+    validate_non_negative_int(order_tax_cents, "order_tax_cents")
+    validate_non_negative_int(already_refunded_total_cents, "already_refunded_total_cents")
+    validate_non_negative_int(already_refunded_tax_cents, "already_refunded_tax_cents")
+    validate_positive_int(refund_amount_cents, "amount_cents")
+
+    if order_tax_cents > order_total_cents:
+        raise ValidationError("order_tax_cents cannot exceed order_total_cents")
+    if already_refunded_tax_cents > order_tax_cents:
+        raise ValidationError("already_refunded_tax_cents cannot exceed order_tax_cents")
+
+    new_cumulative_total = already_refunded_total_cents + refund_amount_cents
+    if new_cumulative_total > order_total_cents:
+        raise ValidationError(
+            f"Refund amount {refund_amount_cents} exceeds remaining refundable total "
+            f"{order_total_cents - already_refunded_total_cents}"
+        )
+
+    new_cumulative_tax = round_half_up_div(
+        order_tax_cents * new_cumulative_total,
+        order_total_cents,
+    )
+    refund_tax_cents = new_cumulative_tax - already_refunded_tax_cents
+    refund_subtotal_cents = refund_amount_cents - refund_tax_cents
+    return refund_subtotal_cents, refund_tax_cents

