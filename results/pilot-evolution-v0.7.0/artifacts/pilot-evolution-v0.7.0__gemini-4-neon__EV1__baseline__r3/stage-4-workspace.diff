+    def test_idempotency_replay_returns_original_entry_without_duplication(self) -> None:
+        sub = self.svc.start_subscription("acct_1", "starter")
+        first = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="replay-key-1",
+        )
+        replay = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="replay-key-1",
+        )
+        self.assertEqual(replay, first)
+        self.assertEqual(replay.entry_id, first.entry_id)
+        self.assertEqual(self.svc.get_statement("acct_1")["entry_count"], 1)
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], first.total_cents)
+
+        # Subsequent upgrade to enterprise, then replay original key must still return first entry
+        # and must not revert subscription plan_id back to pro.
+        second = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "enterprise",
+            10,
+            30,
+            idempotency_key="replay-key-2",
+        )
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "enterprise")
+        replay_after_second = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="replay-key-1",
+        )
+        self.assertEqual(replay_after_second, first)
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "enterprise")
+        self.assertEqual(self.svc.get_statement("acct_1")["entry_count"], 2)
+        self.assertEqual(
+            self.svc.get_statement("acct_1")["balance_cents"],
+            first.total_cents + second.total_cents,
+        )
+
+    def test_idempotency_conflict_raises_validation_error(self) -> None:
+        sub1 = self.svc.start_subscription("acct_1", "starter")
+        sub2 = self.svc.start_subscription("acct_2", "starter")
+
+        first = self.svc.upgrade_subscription(
+            sub1.subscription_id,
+            "pro",
+            1,
+            30,
+            idempotency_key="conflict-key",
+        )
+
+        conflicting_calls = [
+            (sub2.subscription_id, "pro", 1, 30),        # different subscription_id
+            (sub1.subscription_id, "enterprise", 1, 30), # different new_plan_id
+            (sub1.subscription_id, "pro", 2, 30),        # different days_remaining
+            (sub1.subscription_id, "pro", 1, 31),        # different cycle_days
+            (sub1.subscription_id, "pro", True, 30),     # bool instead of 1
+            ("unknown_sub", "pro", 1, 30),               # unknown sub with reused key
+        ]
+        for args in conflicting_calls:
+            with self.subTest(args=args):
+                with self.assertRaises(ValidationError):
+                    self.svc.upgrade_subscription(*args, idempotency_key="conflict-key")  # type: ignore[arg-type]
+
+        # Original entry and subscription states remain intact
+        self.assertEqual(self.svc.get_statement("acct_1")["entry_count"], 1)
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], first.total_cents)
+        self.assertEqual(self.svc.ledger.get_subscription(sub1.subscription_id).plan_id, "pro")
+        self.assertEqual(self.svc.ledger.get_subscription(sub2.subscription_id).plan_id, "starter")
