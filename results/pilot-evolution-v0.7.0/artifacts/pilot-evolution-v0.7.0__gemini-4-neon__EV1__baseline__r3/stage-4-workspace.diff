+"""Unit tests for mid-cycle prorated subscription upgrades and idempotency."""
+
+from __future__ import annotations
+
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.ledger import OrderLedger
+from ev1_order_ledger.models import LedgerEntry, Plan, ValidationError
+from ev1_order_ledger.pricing import (
+    calculate_upgrade_totals,
+    compute_prorated_upgrade_cents,
+    compute_tax_cents,
+    round_half_up_div,
+    validate_proration_window,
+)
+
+
+class SubscriptionUpgradeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=500))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="pro_same", name="Pro Alt", monthly_cents=3000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="enterprise", name="Enterprise", monthly_cents=5000, tax_bps=1000))
+
+    def test_prorated_upgrade_computes_exact_half_up_and_uses_new_plan_tax_bps(self) -> None:
+        sub = self.svc.start_subscription("acct_1", "starter")
+        # delta = 2000, 2000 * 10 / 30 = 666.666... -> 667
+        # tax uses new_plan.tax_bps (825, not starter's 500): 667 * 825 / 10000 = 55.0275 -> 55
+        entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            10,
+            30,
+            idempotency_key="upg-001",
+        )
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, sub.subscription_id)
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual(entry.subtotal_cents, 667)
+        self.assertEqual(entry.tax_cents, 55)
+        self.assertEqual(entry.total_cents, 722)
+
+        updated_sub = self.svc.ledger.get_subscription(sub.subscription_id)
+        self.assertEqual(updated_sub.plan_id, "pro")
+
+        stmt = self.svc.get_statement("acct_1")
+        self.assertEqual(stmt["balance_cents"], 722)
+        self.assertEqual(stmt["entry_count"], 1)
+
+    def test_proration_half_up_rounding_ties_round_up(self) -> None:
+        # Exact .5 cases (including even-floor tie 2.5 -> 3 to rule out banker's rounding)
+        self.svc.register_plan(Plan(plan_id="base", name="Base", monthly_cents=1000, tax_bps=0))
+        self.svc.register_plan(Plan(plan_id="plus_1", name="Plus 1", monthly_cents=1001, tax_bps=0))
+        self.svc.register_plan(Plan(plan_id="plus_5", name="Plus 5", monthly_cents=1005, tax_bps=1000))
+
+        # 1 * 15 / 30 = 0.5 -> 1
+        sub1 = self.svc.start_subscription("acct_1", "base")
+        e1 = self.svc.upgrade_subscription(sub1.subscription_id, "plus_1", 15, 30, idempotency_key="tie-1")
+        self.assertEqual(e1.subtotal_cents, 1)
+        self.assertEqual(e1.tax_cents, 0)
+        self.assertEqual(e1.total_cents, 1)
+
+        # 5 * 15 / 30 = 2.5 -> 3 (not 2)
+        # tax: 3 * 1000 / 10000 = 0.3 -> 0
+        sub2 = self.svc.start_subscription("acct_2", "base")
+        e2 = self.svc.upgrade_subscription(sub2.subscription_id, "plus_5", 15, 30, idempotency_key="tie-2")
+        self.assertEqual(e2.subtotal_cents, 3)
+        self.assertEqual(e2.tax_cents, 0)
+        self.assertEqual(e2.total_cents, 3)
+
+        # Tax tie 0.5 -> 1: delta=5, days=30/30 -> subtotal=5, tax_bps=1000 -> 5*1000/10000 = 0.5 -> 1
+        sub3 = self.svc.start_subscription("acct_3", "base")
+        e3 = self.svc.upgrade_subscription(sub3.subscription_id, "plus_5", 30, 30, idempotency_key="tie-3")
+        self.assertEqual(e3.subtotal_cents, 5)
+        self.assertEqual(e3.tax_cents, 1)
+        self.assertEqual(e3.total_cents, 6)
+
+        # Direct helper verification across rounding down, exact half, and rounding up
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 1001, 1, 3), 0)  # 0.333 -> 0
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 1001, 2, 3), 1)  # 0.666 -> 1
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 1005, 1, 2), 3)  # 2.5 -> 3
+        self.assertEqual(
+            compute_prorated_upgrade_cents(1000, 2999, 13, 31),
+            round_half_up_div((2999 - 1000) * 13, 31),
+        )
+
+    def test_boundary_days_remaining_zero_and_full_cycle(self) -> None:
+        sub_zero = self.svc.start_subscription("acct_zero", "starter")
+        e_zero = self.svc.upgrade_subscription(
+            sub_zero.subscription_id,
+            "pro",
+            0,
+            30,
+            idempotency_key="zero-days",
+        )
+        self.assertEqual(e_zero.subtotal_cents, 0)
+        self.assertEqual(e_zero.tax_cents, 0)
+        self.assertEqual(e_zero.total_cents, 0)
+        self.assertEqual(self.svc.ledger.get_subscription(sub_zero.subscription_id).plan_id, "pro")
+
+        sub_full = self.svc.start_subscription("acct_full", "starter")
+        e_full = self.svc.upgrade_subscription(
+            sub_full.subscription_id,
+            "pro",
+            30,
+            30,
+            idempotency_key="full-cycle",
+        )
+        self.assertEqual(e_full.subtotal_cents, 2000)
+        self.assertEqual(e_full.tax_cents, compute_tax_cents(2000, 825))
+        self.assertEqual(e_full.total_cents, 2000 + compute_tax_cents(2000, 825))
+
+    def test_rejects_unknown_ids_and_non_upgrades(self) -> None:
+        sub = self.svc.start_subscription("acct_1", "pro")
+
+        # Unknown subscription_id and plan_id
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription("sub_missing", "enterprise", 15, 30, idempotency_key="err-1")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "plan_missing", 15, 30, idempotency_key="err-2")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription("", "enterprise", 15, 30, idempotency_key="err-3")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "   ", 15, 30, idempotency_key="err-4")
+
+        # Same plan, equal-price plan, and downgrade
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="err-same")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "pro_same", 15, 30, idempotency_key="err-eq")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "starter", 15, 30, idempotency_key="err-down")
+
+        # State unchanged and no ledger entries recorded
