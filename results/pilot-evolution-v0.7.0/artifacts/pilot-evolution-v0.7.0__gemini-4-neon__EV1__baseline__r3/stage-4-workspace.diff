+            (order2.order_id, 100, "", "k9"),
+            (order2.order_id, 100, "   ", "k10"),
+            (order2.order_id, 100, True, "k11"),
+            (order2.order_id, 100, "ok", ""),
+            (order2.order_id, 100, "ok", "   "),
+            (order2.order_id, 100, "ok", None),
+            (order2.order_id, 100, "ok", True),
+        ]
