+            self.assertEqual(e.subtotal_cents + e.tax_cents, -1)
+            self.assertLessEqual(e.subtotal_cents, 0)
+            self.assertLessEqual(e.tax_cents, 0)
+            entries.append(e)
+
+        self.assertEqual(sum(-e.subtotal_cents for e in entries), 100)
+        self.assertEqual(sum(-e.tax_cents for e in entries), 8)
+        self.assertEqual(sum(-e.total_cents for e in entries), 108)
+        self.assertEqual(self.svc.get_statement("acct_penny")["balance_cents"], 0)
+
+        # Discounted order refunded in 7 uneven chunks
