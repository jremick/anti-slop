+def parse_iso_date(value: str, field_name: str) -> date:
+    """Strictly validate and parse a YYYY-MM-DD calendar date."""
+    if not isinstance(value, str) or len(value) != 10:
+        raise ValidationError(f"{field_name} must be a YYYY-MM-DD date string")
+    try:
+        parsed = date.fromisoformat(value)
+    except ValueError as exc:
+        raise ValidationError(f"{field_name} must be a valid YYYY-MM-DD date") from exc
+    if parsed.isoformat() != value:
+        raise ValidationError(f"{field_name} must be formatted as YYYY-MM-DD")
+    return parsed
+
+
+def validate_promo_code(code: str) -> str:
+    """Validate a single non-empty promo code, rejecting stacked/multi-code strings."""
+    if not isinstance(code, str) or not code.strip():
+        raise ValidationError("promo_code must be a non-empty string")
+    if any(ch.isspace() for ch in code) or any(sep in code for sep in _DISALLOWED_PROMO_DELIMITERS):
+        raise ValidationError("promo_code must be a single code without whitespace or separators")
+    return code
