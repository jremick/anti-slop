{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cat > benchmarks/sources/ev1_order_ledger/tests/test_audit.py <<'PY'\nimport unittest\nfrom unittest.mock import Mock\n\nfrom ev1_order_ledger.api import OrderService\nfrom ev1_order_ledger.models import LineItem, Plan, ValidationError\n\n\nclass AuditTests(unittest.TestCase):\n    def setUp(self):\n        self.sink = Mock()\n        self.service = OrderService(audit_sink=self.sink)\n        self.service.register_plan(Plan(\\\"base\\\", \\\"Base\\\", 100))\n        self.service.register_plan(Plan(\\\"pro\\\", \\\"Pro\\\", 200))\n        self.sub = self.service.start_subscription(\\\"acct\\\", \\\"base\\\")\n\n    def place_order(self):\n        return self.service.place_order(\\\"acct\\\", [LineItem(\\\"seat\\\", 100, 1)], tax_bps=1000)\n\n    def upgrade(self):\n        return self.service.upgrade_subscription(\n            self.sub.subscription_id, \\\"pro\\\", 1, 2, idempotency_key=\\\"upgrade\\\"\n        )\n\n    def refund(self, order):\n        return self.service.refund_order(order.order_id, 30, reason=\\\"return\\\", idempotency_key=\\\"refund\\\")\n\n    def entries(self):\n        return self.service.ledger.entries_for_account(\\\"acct\\\")\n\n    def test_audits_each_new_entry_once_with_signed_amount(self):\n        order = self.place_order()\n        upgrade = self.upgrade()\n        refund = self.refund(order)\n        self.assertIs(self.upgrade(), upgrade)\n        self.assertIs(self.refund(order), refund)\n        with self.assertRaises(ValidationError):\n            self.service.refund_order(order.order_id, 31, reason=\\\"return\\\", idempotency_key=\\\"refund\\\")\n\n        charge, = [entry for entry in self.entries() if entry.kind == \\\"order_charge\\\"]\n        events = [call.args[0] for call in self.sink.call_args_list]\n        self.assertEqual(events, [\n            dict(action=\\\"order_charge\\\", account_id=\\\"acct\\\", amount_cents=110, entry_id=charge.entry_id),\n            dict(action=\\\"plan_upgrade\\\", account_id=\\\"acct\\\", amount_cents=50, entry_id=upgrade.entry_id),\n            dict(action=\\\"order_refund\\\", account_id=\\\"acct\\\", amount_cents=-30, entry_id=refund.entry_id),\n        ])\n\n    def test_sink_error_leaves_order_and_charge_uncommitted(self):\n        self.sink.side_effect = RuntimeError(\\\"audit unavailable\\\")\n        with self.assertRaisesRegex(RuntimeError, \\\"audit unavailable\\\"):\n            self.place_order()\n        self.assertEqual(self.service.ledger._orders, {})\n        self.assertEqual(self.entries(), [])\n        entry_id = self.sink.call_args.args[0][\\\"entry_id\\\"]\n        self.assertIsNone(self.service.ledger.get_entry(entry_id))\n\n    def test_sink_error_preserves_plan_refundable_amount_and_retry_keys(self):\n        order = self.place_order()\n        original_entries = self.entries()\n        self.sink.side_effect = RuntimeError(\\\"audit unavailable\\\")\n        with self.assertRaisesRegex(RuntimeError, \\\"audit unavailable\\\"):\n            self.upgrade()\n        with self.assertRaisesRegex(RuntimeError, \\\"audit unavailable\\\"):\n            self.refund(order)\n        self.assertEqual(self.sub.plan_id, \\\"base\\\")\n        self.assertEqual(self.entries(), original_entries)\n\n        self.sink.side_effect = None\n        upgrade = self.upgrade()\n        refund = self.refund(order)\n        self.assertEqual(self.sub.plan_id, \\\"pro\\\")\n        self.assertEqual(self.entries(), original_entries + [upgrade, refund])\n        remaining = self.service.refund_order(order.order_id, 80, reason=\\\"rest\\\", idempotency_key=\\\"rest\\\")\n        self.assertEqual(remaining.total_cents, -80)\nPY\npython3 benchmarks/sources/ev1_order_ledger/run_checks.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
