{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cat > benchmarks/sources/ev1_order_ledger/tests/test_promos.py <<'PY'\nimport unittest\n\nfrom ev1_order_ledger.api import OrderService\nfrom ev1_order_ledger.models import LineItem, Plan, ValidationError\n\n\nclass PromoTests(unittest.TestCase):\n    def setUp(self):\n        self.service = OrderService()\n\n    def order(self, cents, code, **kwargs):\n        return self.service.place_order(\n            \\\"acct\\\", [LineItem(\\\"seat\\\", cents, 1)], promo_code=code, tax_bps=1000, **kwargs\n        )\n\n    def test_percentage_discount_includes_fee_and_rounds_half_up(self):\n        self.service.register_promo(\\\"HALF\\\", percent_off=50, min_subtotal_cents=521)\n        order = self.order(21, \\\"HALF\\\", legacy_flat_fee=True)\n        self.assertEqual(order.promo_code, \\\"HALF\\\")\n        self.assertEqual(order.discount_cents, 261)\n        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (260, 26, 286))\n        self.assertEqual(self.service.get_statement(\\\"acct\\\")[\\\"balance_cents\\\"], 286)\n\n    def test_fixed_discount_clamps_at_subtotal(self):\n        self.service.register_promo(\\\"FIXED\\\", amount_off_cents=200)\n        order = self.order(101, \\\"FIXED\\\")\n        self.assertEqual(order.discount_cents, 101)\n        self.assertEqual((order.subtotal_cents, order.tax_cents, order.total_cents), (0, 0, 0))\n\n    def test_rejected_promos_do_not_record_orders(self):\n        self.service.register_promo(\\\"A\\\", amount_off_cents=10, expires_on=\\\"2028-02-29\\\")\n        self.service.register_promo(\\\"B\\\", percent_off=100, min_subtotal_cents=101)\n        for code, as_of in (\n            (\\\"missing\\\", None), (\\\"A,B\\\", \\\"2028-02-29\\\"), (\\\"A\\\", None), (\\\"A\\\", \\\"2028-03-01\\\"),\n            (\\\"A\\\", \\\"2028-2-28\\\"), (\\\"A\\\", \\\"2028-02-30\\\"), (\\\"B\\\", None), (\\\"\\\", None),\n        ):\n            with self.subTest(code=code, as_of=as_of), self.assertRaises(ValidationError):\n                self.order(100, code, as_of=as_of)\n        self.assertEqual(self.service.ledger.entries_for_account(\\\"acct\\\"), [])\n        self.assertEqual(self.order(100, \\\"A\\\", as_of=\\\"2028-02-29\\\").total_cents, 99)\n        self.assertEqual(self.order(101, \\\"B\\\").total_cents, 0)\n\n    def test_invalid_registration(self):\n        for code, fields in (\n            (\\\"X\\\", {}), (\\\"X\\\", dict(amount_off_cents=1, percent_off=1)),\n            (\\\"X\\\", dict(percent_off=0)), (\\\"X\\\", dict(percent_off=101)),\n            (\\\"X\\\", dict(percent_off=True)), (\\\"X\\\", dict(amount_off_cents=0)),\n            (\\\"X\\\", dict(amount_off_cents=1.5)), (\\\"X\\\", dict(percent_off=1, min_subtotal_cents=-1)),\n            (\\\"X\\\", dict(percent_off=1, expires_on=\\\"2027-02-29\\\")),\n            (\\\" \\\", dict(percent_off=1)), (\\\"A,B\\\", dict(percent_off=1)),\n        ):\n            with self.subTest(code=code, fields=fields), self.assertRaises(ValidationError):\n                self.service.register_promo(code, **fields)\n\n    def test_upgrade_prices_prorated_amount_and_replays_promo_request(self):\n        self.service.register_plan(Plan(\\\"base\\\", \\\"Base\\\", 100))\n        self.service.register_plan(Plan(\\\"pro\\\", \\\"Pro\\\", 305, 1000))\n        sub = self.service.start_subscription(\\\"acct\\\", \\\"base\\\")\n        self.service.register_promo(\\\"LARGE\\\", percent_off=20, min_subtotal_cents=104)\n        self.service.register_promo(\\\"SAVE\\\", amount_off_cents=13, expires_on=\\\"2028-02-29\\\")\n        args = (sub.subscription_id, \\\"pro\\\", 1, 2)\n        kwargs = dict(idempotency_key=\\\"k\\\", promo_code=\\\"SAVE\\\", as_of=\\\"2028-02-29\\\")\n        for changes in (dict(promo_code=\\\"LARGE\\\"), dict(as_of=None), dict(promo_code=\\\"unknown\\\")):\n            with self.subTest(changes=changes), self.assertRaises(ValidationError):\n                self.service.upgrade_subscription(*args, **{**kwargs, **changes})\n        self.assertEqual(sub.plan_id, \\\"base\\\")\n        entry = self.service.upgrade_subscription(*args, **kwargs)\n        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (90, 9, 99))\n        self.assertIs(self.service.upgrade_subscription(*args, **kwargs), entry)\n        for changes in (dict(promo_code=None), dict(as_of=\\\"2028-02-28\\\")):\n            with self.subTest(changes=changes), self.assertRaises(ValidationError):\n                self.service.upgrade_subscription(*args, **{**kwargs, **changes})\n        self.assertEqual(self.service.ledger.entries_for_account(\\\"acct\\\"), [entry])\nPY\npython3 benchmarks/sources/ev1_order_ledger/run_checks.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
