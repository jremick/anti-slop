def apply_discount_and_tax(\n    subtotal: int, tax_bps: int, promo: Promo | None = None, as_of: str | None = None\n) -> Tuple[int, int, int, int]:\n    \"\"\"Return discounted subtotal, tax, total, and discount in integer cents.\"\"\"\n    if as_of is not None:\n        validate_date(as_of, \"as_of\")\n    discount = 0\n    if promo is not None:\n        if promo.expires_on is not None and (as_of is None or as_of > promo.expires_on):\n            raise ValidationError(\"expiring promo requires as_of on or before expires_on\")\n        if subtotal < promo.min_subtotal_cents:\n            raise ValidationError(\"subtotal is below the promo minimum\")\n        if promo.percent_off is not None:\n            discount = round_half_up_div(subtotal * promo.percent_off, 100)\n        else:\n            discount = min(subtotal, promo.amount_off_cents)\n    taxable = subtotal - discount\n    tax = compute_tax_cents(taxable, tax_bps)\n    return taxable, tax, taxable + tax, discount\n\n\ndef order_subtotal(items: Sequence[LineItem], legacy_flat_fee: bool) -> int:\n    subtotal = compute_subtotal_cents(items)\n    if legacy_flat_fee:\n        subtotal += LEGACY_FLAT_FEE_CENTS\n    return subtotal\n\n\n'\"'''+s[i:]\ni=s.index('    subtotal = compute_subtotal_cents',s.index('def calculate_order_totals'))\ns=s[:i]+'''    subtotal = order_subtotal(items, legacy_flat_fee)\n    taxable, tax, total, _ = apply_discount_and_tax(subtotal, tax_bps)\n    return taxable, tax, total\n'''+s[s.index('\\\\n\\\\ndef validate_proration_days',i):]\ns=s.replace('def calculate_upgrade_totals(', 'def upgrade_subtotal(')\ni=s.index(') -> Tuple[int, int, int]:',s.index('def upgrade_subtotal'))\ns=s[:i]+s[i:].replace(') -> Tuple[int, int, int]:',') -> int:',1)\ns=s[:s.index('    subtotal = round_half_up_div(difference')]+'''    return round_half_up_div(difference * days_remaining, cycle_days)\n\n\ndef calculate_upgrade_totals(\n    old_plan: Plan, new_plan: Plan, days_remaining: int, cycle_days: int\n) -> Tuple[int, int, int]:\n    subtotal = upgrade_subtotal(old_plan, new_plan, days_remaining, cycle_days)\n    taxable, tax, total, _ = apply_discount_and_tax(subtotal, new_plan.tax_bps)\n    return taxable, tax, total\n'''\np.write_text(s)\nargs='        promo_code: str | None = None,\\\\n        as_of: str | None = None,\\\\n'\np=Path('api.py')\ns=p.read_text().replace('Plan, Subscription','Plan, Promo, Subscription').replace('from .pricing import calculate_order_totals','from .pricing import apply_discount_and_tax, order_subtotal')\ns=s.replace('    def place_order(','''    def register_promo(\n        self,\n        code: str,\n        *,\n        percent_off: int | None = None,\n        amount_off_cents: int | None = None,\n        expires_on: str | None = None,\n        min_subtotal_cents: int = 0,\n    ) -> None:\n        self.ledger.add_promo(Promo(code, percent_off, amount_off_cents, expires_on, min_subtotal_cents))\n\n    def place_order(''')\ns=s.replace('        legacy_flat_fee: bool = False,\\\\n','        legacy_flat_fee: bool = False,\\\\n'+args).replace('        idempotency_key: str,\\\\n','        idempotency_key: str,\\\\n'+args).replace('            idempotency_key=idempotency_key,','            idempotency_key=idempotency_key, promo_code=promo_code, as_of=as_of,')\ni=s.index('        subtotal, tax, total')\ns=s[:i]+'''        subtotal, tax, total, discount = apply_discount_and_tax(\n            order_subtotal(items, legacy_flat_fee), tax_bps, self.ledger.get_promo(promo_code), as_of\n        )\n'''+s[s.index('        order_id =',i):]\ns=s.replace('            items=tuple(items),','            items=tuple(items),\\\\n            discount_cents=discount,\\\\n            promo_code=promo_code,')\np.write_text(s)\np=Path('ledger.py')\ns=p.read_text().replace('Plan, Subscription','Plan, Promo, Subscription').replace('calculate_upgrade_totals, validate_proration_days','apply_discount_and_tax, upgrade_subtotal, validate_promo, validate_promo_code, valid