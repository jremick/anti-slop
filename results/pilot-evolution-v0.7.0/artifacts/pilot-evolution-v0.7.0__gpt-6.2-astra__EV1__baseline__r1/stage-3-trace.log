{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cat > benchmarks/sources/ev1_order_ledger/tests/test_refunds.py <<'PY'\nimport unittest\n\nfrom ev1_order_ledger.api import OrderService\nfrom ev1_order_ledger.models import LineItem, ValidationError\n\n\nclass RefundTests(unittest.TestCase):\n    def setUp(self):\n        self.service = OrderService()\n        self.service.register_promo(\\\"SAVE\\\", amount_off_cents=4)\n        self.order = self.place_order()\n\n    def place_order(self):\n        return self.service.place_order(\n            \\\"acct\\\", [LineItem(\\\"seat\\\", 10, 1)], promo_code=\\\"SAVE\\\", tax_bps=3333\n        )\n\n    def refund(self, amount, key=\\\"key\\\", reason=\\\"returned\\\"):\n        return self.service.refund_order(\n            self.order.order_id, amount, reason=reason, idempotency_key=key\n        )\n\n    def test_every_partition_of_eight_cents_conserves_subtotal_and_tax(self):\n        # A 6-cent discounted subtotal plus 2 cents of tax. Each bit ends a chunk.\n        expected_cumulative_tax = [0, 0, 1, 1, 1, 1, 2, 2, 2]\n        for cuts in range(128):\n            with self.subTest(cuts=cuts):\n                order = self.place_order()\n                previous = tax = subtotal = 0\n                for end in range(1, 9):\n                    if end < 8 and not cuts & (1 << (end - 1)):\n                        continue\n                    amount = end - previous\n                    entry = self.service.refund_order(\n                        order.order_id, amount, reason=\\\"returned\\\", idempotency_key=f\\\"{cuts}-{end}\\\"\n                    )\n                    self.assertEqual(entry.total_cents, -amount)\n                    self.assertEqual(entry.subtotal_cents + entry.tax_cents, entry.total_cents)\n                    self.assertLessEqual(entry.subtotal_cents, 0)\n                    self.assertLessEqual(entry.tax_cents, 0)\n                    tax -= entry.tax_cents\n                    subtotal -= entry.subtotal_cents\n                    self.assertEqual(tax, expected_cumulative_tax[end])\n                    previous = end\n                self.assertEqual((subtotal, tax), (order.subtotal_cents, order.tax_cents))\n\n    def test_over_refund_is_rejected_without_consuming_key(self):\n        self.refund(3)\n        with self.assertRaises(ValidationError):\n            self.refund(6, \\\"final\\\")\n        self.refund(5, \\\"final\\\")\n        with self.assertRaises(ValidationError):\n            self.refund(1, \\\"extra\\\")\n        self.assertEqual(self.service.get_statement(\\\"acct\\\"), {\n            \\\"account_id\\\": \\\"acct\\\", \\\"balance_cents\\\": 0, \\\"entry_count\\\": 3,\n        })\n\n    def test_replay_after_full_refund_and_conflicting_arguments(self):\n        original = self.refund(2)\n        self.refund(6, \\\"rest\\\")\n        self.service = OrderService(self.service.ledger)\n        self.assertIs(self.refund(2), original)\n        for amount, reason in [(1, \\\"returned\\\"), (2, \\\"damaged\\\")]:\n            with self.assertRaises(ValidationError):\n                self.refund(amount, reason=reason)\n        other = self.place_order()\n        with self.assertRaises(ValidationError):\n            self.service.refund_order(other.order_id, 2, reason=\\\"returned\\\", idempotency_key=\\\"key\\\")\n        self.assertEqual(self.service.get_statement(\\\"acct\\\")[\\\"entry_count\\\"], 4)\n\n    def test_invalid_refund_requests(self):\n        for amount, key, reason in [\n            (0, \\\"k\\\", \\\"r\\\"), (-1, \\\"k\\\", \\\"r\\\"), (True, \\\"k\\\", \\\"r\\\"), (1.0, \\\"k\\\", \\\"r\\\"),\n            (1, \\\"\\\", \\\"r\\\"), (1, None, \\\"r\\\"), (1, \\\"k\\\", \\\" \\\"), (1, \\\"k\\\", False),\n        ]:\n            with self.subTest(amount=amount, key=key, reason=reason), self.assertRaises(ValidationError):\n                self.refund(amount, key, reason)\n        with self.assertRaises(ValidationError):\n            self.service.refund_order(\\\"unknown\\\", 1, reason=\\\"returned\\\", idempotency_key=\\\"k\\\")\n        self.assertEqual(self.service.get_statement(\\\"acct\\\")[\\\"entry_count\\\"], 1)\n\n    def test_credit_note_exports_only_refunds_and_uses_positive_magnitudes(self):\n        charge, = self.service.ledger.entries_for_account(\\\"acct\\\")\n        for invalid_id in (charge.entry_id, \\\"missing\\\"):\n            with self.assertRaises(ValidationError):\n                self.service.export_credit_note(invalid_id)\n        refund = self.refund(3)\n        self.assertEqual(refund.kind, \\\"order_refund\\\")\n        self.assertEqual(self.service.export_credit_note(refund.entry_id), {\n            \\\"entry_id\\\": refund.entry_id, \\\"order_id\\\": self.order.order_id, \\\"account_id\\\": \\\"acct\\\",\n            \\\"subtotal_cents\\\": 2, \\\"tax_cents\\\": 1, \\\"total_cents\\\": 3, \\\"reason\\\": \\\"returned\\\",\n        })\nPY\npython3 benchmarks/sources/ev1_order_ledger/run_checks.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
