{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"cat > benchmarks/sources/ev1_order_ledger/tests/test_upgrades.py <<'PY'\nimport unittest\n\nfrom ev1_order_ledger.api import OrderService\nfrom ev1_order_ledger.models import Plan, ValidationError\n\n\nclass SubscriptionUpgradeTests(unittest.TestCase):\n    def setUp(self):\n        self.service = OrderService()\n        for plan in (\n            Plan(\\\"base\\\", \\\"Base\\\", 1000),\n            Plan(\\\"pro\\\", \\\"Pro\\\", 1005, 5000),\n            Plan(\\\"premium\\\", \\\"Premium\\\", 2000),\n            Plan(\\\"equal\\\", \\\"Equal\\\", 1000),\n            Plan(\\\"cheaper\\\", \\\"Cheaper\\\", 999),\n        ):\n            self.service.register_plan(plan)\n        self.sub = self.service.start_subscription(\\\"acct\\\", \\\"base\\\")\n        self.request = dict(subscription_id=self.sub.subscription_id, new_plan_id=\\\"pro\\\",\n                            days_remaining=1, cycle_days=2, idempotency_key=\\\"upgrade\\\")\n\n    def upgrade(self, **changes):\n        return self.service.upgrade_subscription(**{**self.request, **changes})\n\n    def test_rounds_proration_then_tax_half_up(self):\n        entry = self.upgrade()\n        # Five cents for half a cycle rounds to three, then 50% tax rounds to two.\n        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (3, 2, 5))\n        self.assertEqual((entry.kind, entry.reference_id), (\\\"plan_upgrade\\\", self.sub.subscription_id))\n        self.assertEqual(self.sub.plan_id, \\\"pro\\\")\n        self.assertEqual(self.service.ledger.entries_for_account(\\\"acct\\\"), [entry])\n        self.assertEqual(self.service.get_statement(\\\"acct\\\")[\\\"balance_cents\\\"], 5)\n\n    def test_zero_partial_and_full_cycle(self):\n        for days, expected in [(0, 0), (1, 1), (4, 5)]:\n            with self.subTest(days=days):\n                sub = self.service.start_subscription(\\\"acct\\\", \\\"base\\\")\n                entry = self.upgrade(subscription_id=sub.subscription_id, days_remaining=days,\n                                     cycle_days=4, idempotency_key=sub.subscription_id)\n                self.assertEqual(entry.subtotal_cents, expected)\n                self.assertEqual(sub.plan_id, \\\"pro\\\")\n\n    def test_invalid_requests_leave_plan_ledger_and_key_untouched(self):\n        for changes in (\n            dict(subscription_id=\\\"missing\\\"), dict(new_plan_id=\\\"missing\\\"),\n            dict(new_plan_id=\\\"base\\\"), dict(new_plan_id=\\\"equal\\\"), dict(new_plan_id=\\\"cheaper\\\"),\n            dict(cycle_days=0), dict(cycle_days=-1), dict(days_remaining=-1),\n            dict(days_remaining=3), dict(days_remaining=True), dict(cycle_days=True),\n            dict(days_remaining=1.0), dict(cycle_days=2.0), dict(subscription_id=False),\n            dict(new_plan_id=True), dict(idempotency_key=\\\"\\\"), dict(idempotency_key=\\\" \\\"),\n            dict(idempotency_key=False),\n        ):\n            with self.subTest(changes=changes), self.assertRaises(ValidationError):\n                self.upgrade(**changes)\n        self.assertEqual(self.sub.plan_id, \\\"base\\\")\n        self.assertEqual(self.service.ledger.entries_for_account(\\\"acct\\\"), [])\n        self.upgrade()\n\n    def test_replay_after_further_upgrade_returns_original_entry(self):\n        original = self.upgrade()\n        later = self.upgrade(new_plan_id=\\\"premium\\\", idempotency_key=\\\"second\\\")\n        self.service = OrderService(self.service.ledger)\n        self.assertIs(self.upgrade(), original)\n        self.assertEqual(self.sub.plan_id, \\\"premium\\\")\n        self.assertEqual(self.service.ledger.entries_for_account(\\\"acct\\\"), [original, later])\n\n    def test_conflict_checks_all_arguments(self):\n        original = self.upgrade()\n        other = self.service.start_subscription(\\\"acct\\\", \\\"base\\\")\n        for changes in (\n            dict(subscription_id=other.subscription_id), dict(new_plan_id=\\\"premium\\\"),\n            dict(days_remaining=0), dict(cycle_days=3), dict(days_remaining=True),\n        ):\n            with self.subTest(changes=changes), self.assertRaises(ValidationError):\n                self.upgrade(**changes)\n        self.assertEqual(other.plan_id, \\\"base\\\")\n        self.assertEqual(self.sub.plan_id, \\\"pro\\\")\n        self.assertEqual(self.service.ledger.entries_for_account(\\\"acct\\\"), [original])\nPY\npython3 benchmarks/sources/ev1_order_ledger/run_checks.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
