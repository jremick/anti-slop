{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc 'cat benchmarks/sources/ev1_order_ledger/{api,ledger,pricing,models,run_checks}.py benchmarks/sources/ev1_order_ledger/tests/test_orders.py'","aggregated_output":"\"\"\"Service facade coordinating pricing and ledger persistence for EV1.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Dict, Sequence\n\nfrom .ledger import OrderLedger\nfrom .models import LedgerEntry, LineItem, Order, Plan, Subscription, ValidationError\nfrom .pricing import calculate_order_totals\n\n\nclass OrderService:\n    def __init__(self, ledger: OrderLedger | None = None) -> None:\n        self.ledger = ledger if ledger is not None else OrderLedger()\n\n    def register_plan(self, plan: Plan) -> None:\n        self.ledger.add_plan(plan)\n\n    def place_order(\n        self,\n        account_id: str,\n        items: Sequence[LineItem],\n        *,\n        tax_bps: int = 0,\n        legacy_flat_fee: bool = False,\n    ) -> Order:\n        if not account_id.strip():\n            raise ValidationError(\"account_id must be non-empty\")\n        subtotal, tax, total = calculate_order_totals(\n            items,\n            tax_bps=tax_bps,\n            legacy_flat_fee=legacy_flat_fee,\n        )\n        order_id = self.ledger.next_id(\"ord\")\n        order = Order(\n            order_id=order_id,\n            account_id=account_id,\n            items=tuple(items),\n            subtotal_cents=subtotal,\n            tax_cents=tax,\n            total_cents=total,\n        )\n        self.ledger.save_order(order)\n        entry = LedgerEntry(\n            entry_id=self.ledger.next_id(\"ent\"),\n            account_id=account_id,\n            kind=\"order_charge\",\n            subtotal_cents=subtotal,\n            tax_cents=tax,\n            total_cents=total,\n            reference_id=order_id,\n        )\n        self.ledger.record_entry(entry)\n        return order\n\n    def start_subscription(self, account_id: str, plan_id: str) -> Subscription:\n        if not account_id.strip():\n            raise ValidationError(\"account_id must be non-empty\")\n        self.ledger.get_plan(plan_id)\n        sub = Subscription(\n            subscription_id=self.ledger.next_id(\"sub\"),\n            account_id=account_id,\n            plan_id=plan_id,\n        )\n        self.ledger.save_subscription(sub)\n        return sub\n\n    def get_statement(self, account_id: str) -> Dict[str, object]:\n        entries = self.ledger.entries_for_account(account_id)\n        return {\n            \"account_id\": account_id,\n            \"balance_cents\": self.ledger.account_balance_cents(account_id),\n            \"entry_count\": len(entries),\n        }\n\"\"\"In-memory order, subscription, and ledger store for EV1.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Dict, List, Optional\n\nfrom .models import LedgerEntry, Order, Plan, Subscription, ValidationError\n\n\nclass OrderLedger:\n    def __init__(self) -> None:\n        self._plans: Dict[str, Plan] = {}\n        self._orders: Dict[str, Order] = {}\n        self._subscriptions: Dict[str, Subscription] = {}\n        self._entries: Dict[str, LedgerEntry] = {}\n        self._entry_order: List[str] = []\n        self._seq = 0\n\n    def next_id(self, prefix: str) -> str:\n        self._seq += 1\n        return f\"{prefix}_{self._seq:04d}\"\n\n    def add_plan(self, plan: Plan) -> None:\n        if not plan.plan_id.strip():\n            raise ValidationError(\"plan_id must be non-empty\")\n        if isinstance(plan.monthly_cents, bool) or not isinstance(plan.monthly_cents, int) or plan.monthly_cents < 0:\n            raise ValidationError(\"monthly_cents must be a non-negative integer\")\n        self._plans[plan.plan_id] = plan\n\n    def get_plan(self, plan_id: str) -> Plan:\n        plan = self._plans.get(plan_id)\n        if plan is None:\n            raise ValidationError(f\"Unknown plan_id: {plan_id}\")\n        return plan\n\n    def save_order(self, order: Order) -> None:\n        self._orders[order.order_id] = order\n\n    def get_order(self, order_id: str) -> Order:\n        order = self._orders.get(order_id)\n        if order is None:\n            raise ValidationError(f\"Unknown order_id: {order_id}\")\n        return order\n\n    def save_subscription(self, sub: Subscription) -> None:\n        self._subscriptions[sub.subscription_id] = sub\n\n    def get_subscription(self, subscription_id: str) -> Subscription:\n        sub = self._subscriptions.get(subscription_id)\n        if sub is None:\n            raise ValidationError(f\"Unknown subscription_id: {subscription_id}\")\n        return sub\n\n    def record_entry(self, entry: LedgerEntry) -> None:\n        self._entries[entry.entry_id] = entry\n        self._entry_order.append(entry.entry_id)\n\n    def get_entry(self, entry_id: str) -> Optional[LedgerEntry]:\n        return self._entries.get(entry_id)\n\n    def entries_for_account(self, account_id: str) -> List[LedgerEntry]:\n        return [\n            self._entries[eid]\n            for eid in self._entry_order\n            if self._entries[eid].account_id == account_id\n        ]\n\n    def account_balance_cents(self, account_id: str) -> int:\n        return sum(e.total_cents for e in self.entries_for_account(account_id))\n\"\"\"Canonical integer-cent pricing calculations for EV1 order ledger.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Sequence, Tuple\n\nfrom .models import LineItem, ValidationError\n\n\nLEGACY_FLAT_FEE_CENTS = 500\n\n\ndef validate_non_negative_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value < 0:\n        raise ValidationError(f\"{field_name} must be a non-negative integer\")\n    return value\n\n\ndef validate_positive_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:\n        raise ValidationError(f\"{field_name} must be a positive integer\")\n    return value\n\n\ndef round_half_up_div(numerator: int, denominator: int) -> int:\n    \"\"\"Exact integer half-up division for non-negative numerator and positive denominator.\"\"\"\n    validate_non_negative_int(numerator, \"numerator\")\n    validate_positive_int(denominator, \"denominator\")\n    return (numerator * 2 + denominator) // (2 * denominator)\n\n\ndef compute_subtotal_cents(items: Sequence[LineItem]) -> int:\n    if not items:\n        raise ValidationError(\"items must be non-empty\")\n    subtotal = 0\n    for item in items:\n        validate_positive_int(item.unit_cents, \"unit_cents\")\n        validate_positive_int(item.quantity, \"quantity\")\n        subtotal += item.unit_cents * item.quantity\n    return subtotal\n\n\ndef compute_tax_cents(taxable_cents: int, tax_bps: int) -> int:\n    validate_non_negative_int(taxable_cents, \"taxable_cents\")\n    validate_non_negative_int(tax_bps, \"tax_bps\")\n    if tax_bps > 10_000:\n        raise ValidationError(\"tax_bps cannot exceed 10000\")\n    return round_half_up_div(taxable_cents * tax_bps, 10_000)\n\n\ndef calculate_order_totals(\n    items: Sequence[LineItem],\n    *,\n    tax_bps: int = 0,\n    legacy_flat_fee: bool = False,\n) -> Tuple[int, int, int]:\n    \"\"\"Return (subtotal_cents, tax_cents, total_cents) using exact integer cents.\"\"\"\n    subtotal = compute_subtotal_cents(items)\n    if legacy_flat_fee:\n        subtotal += LEGACY_FLAT_FEE_CENTS\n    tax = compute_tax_cents(subtotal, tax_bps)\n    return subtotal, tax, subtotal + tax\n\"\"\"Core domain models for the EV1 order ledger fixture.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import Tuple\n\n\nclass BillingError(Exception):\n    \"\"\"Base error for billing domain failures.\"\"\"\n\n\nclass ValidationError(BillingError):\n    \"\"\"Raised when input arguments or business invariants are violated.\"\"\"\n\n\n@dataclass(frozen=True)\nclass Plan:\n    plan_id: str\n    name: str\n    monthly_cents: int\n    tax_bps: int = 0\n\n\n@dataclass(frozen=True)\nclass LineItem:\n    sku: str\n    unit_cents: int\n    quantity: int\n\n\n@dataclass(frozen=True)\nclass Order:\n    order_id: str\n    account_id: str\n    items: Tuple[LineItem, ...]\n    subtotal_cents: int\n    tax_cents: int\n    total_cents: int\n    discount_cents: int = 0\n    promo_code: str | None = None\n\n\n@dataclass\nclass Subscription:\n    subscription_id: str\n    account_id: str\n    plan_id: str\n    status: str = \"active\"\n\n\n@dataclass(frozen=True)\nclass LedgerEntry:\n    entry_id: str\n    account_id: str\n    kind: str\n    subtotal_cents: int\n    tax_cents: int\n    total_cents: int\n    reference_id: str\n    reason: str = \"\"\n    metadata: dict = field(default_factory=dict)\n#!/usr/bin/env python3\n\"\"\"Stdlib test runner for EV1 order ledger fixture.\"\"\"\n\nfrom __future__ import annotations\n\nfrom pathlib import Path\nimport sys\nimport unittest\n\n\ndef main() -> int:\n    pkg_dir = Path(__file__).resolve().parent\n    parent_dir = str(pkg_dir.parent)\n    if parent_dir not in sys.path:\n        sys.path.insert(0, parent_dir)\n    suite = unittest.defaultTestLoader.discover(\n        start_dir=str(pkg_dir / \"tests\"),\n        pattern=\"test_*.py\",\n        top_level_dir=str(pkg_dir / \"tests\"),\n    )\n    runner = unittest.TextTestRunner(verbosity=2)\n    result = runner.run(suite)\n    return 0 if result.wasSuccessful() else 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n\"\"\"Baseline unit tests for the initial EV1 order ledger fixture.\"\"\"\n\nfrom __future__ import annotations\n\nimport unittest\n\nfrom ev1_order_ledger.api import OrderService\nfrom ev1_order_ledger.models import LineItem, Plan, ValidationError\n\n\nclass BaselineOrderLedgerTests(unittest.TestCase):\n    def setUp(self) -> None:\n        self.svc = OrderService()\n        self.svc.register_plan(Plan(plan_id=\"starter\", name=\"Starter\", monthly_cents=1000, tax_bps=825))\n        self.svc.register_plan(Plan(plan_id=\"pro\", name=\"Pro\", monthly_cents=3000, tax_bps=825))\n\n    def test_place_order_computes_exact_integer_tax_and_records_entry(self) -> None:\n        order = self.svc.place_order(\n            \"acct_1\",\n            [LineItem(sku=\"seat\", unit_cents=1999, quantity=2)],\n            tax_bps=825,\n        )\n        self.assertEqual(order.subtotal_cents, 3998)\n        self.assertEqual(order.tax_cents, 330)  # 3998 * 825 / 10000 = 329.835 -> 330\n        self.assertEqual(order.total_cents, 4328)\n        stmt = self.svc.get_statement(\"acct_1\")\n        self.assertEqual(stmt[\"balance_cents\"], 4328)\n        self.assertEqual(stmt[\"entry_count\"], 1)\n\n    def test_legacy_flat_fee_adds_500_cents_before_tax(self) -> None:\n        order = self.svc.place_order(\n            \"acct_1\",\n            [LineItem(sku=\"seat\", unit_cents=1000, quantity=1)],\n            tax_bps=1000,\n            legacy_flat_fee=True,\n        )\n        self.assertEqual(order.subtotal_cents, 1500)\n        self.assertEqual(order.tax_cents, 150)\n        self.assertEqual(order.total_cents, 1650)\n\n    def test_invalid_order_inputs_fail_closed(self) -> None:\n        with self.assertRaises(ValidationError):\n            self.svc.place_order(\"\", [LineItem(sku=\"x\", unit_cents=100, quantity=1)])\n        with self.assertRaises(ValidationError):\n            self.svc.place_order(\"acct_1\", [])\n        with self.assertRaises(ValidationError):\n            self.svc.place_order(\"acct_1\", [LineItem(sku=\"x\", unit_cents=0, quantity=1)])\n\n    def test_start_subscription_validates_plan(self) -> None:\n        sub = self.svc.start_subscription(\"acct_1\", \"starter\")\n        self.assertEqual(sub.plan_id, \"starter\")\n        with self.assertRaises(ValidationError):\n            self.svc.start_subscription(\"acct_1\", \"nonexistent\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","exit_code":0,"status":"completed"}}
