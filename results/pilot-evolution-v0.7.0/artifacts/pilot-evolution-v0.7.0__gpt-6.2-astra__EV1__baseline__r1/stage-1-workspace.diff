+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import Plan, ValidationError
+
+
+class SubscriptionUpgradeTests(unittest.TestCase):
+    def setUp(self):
+        self.service = OrderService()
+        for plan in (
+            Plan("base", "Base", 1000),
+            Plan("pro", "Pro", 1005, 5000),
+            Plan("premium", "Premium", 2000),
+            Plan("equal", "Equal", 1000),
+            Plan("cheaper", "Cheaper", 999),
+        ):
+            self.service.register_plan(plan)
+        self.sub = self.service.start_subscription("acct", "base")
+        self.request = dict(subscription_id=self.sub.subscription_id, new_plan_id="pro",
+                            days_remaining=1, cycle_days=2, idempotency_key="upgrade")
+
+    def upgrade(self, **changes):
+        return self.service.upgrade_subscription(**{**self.request, **changes})
+
+    def test_rounds_proration_then_tax_half_up(self):
+        entry = self.upgrade()
+        # Five cents for half a cycle rounds to three, then 50% tax rounds to two.
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (3, 2, 5))
+        self.assertEqual((entry.kind, entry.reference_id), ("plan_upgrade", self.sub.subscription_id))
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [entry])
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], 5)
+
+    def test_zero_partial_and_full_cycle(self):
+        for days, expected in [(0, 0), (1, 1), (4, 5)]:
+            with self.subTest(days=days):
+                sub = self.service.start_subscription("acct", "base")
+                entry = self.upgrade(subscription_id=sub.subscription_id, days_remaining=days,
+                                     cycle_days=4, idempotency_key=sub.subscription_id)
+                self.assertEqual(entry.subtotal_cents, expected)
+                self.assertEqual(sub.plan_id, "pro")
+
+    def test_invalid_requests_leave_plan_ledger_and_key_untouched(self):
+        for changes in (
+            dict(subscription_id="missing"), dict(new_plan_id="missing"),
+            dict(new_plan_id="base"), dict(new_plan_id="equal"), dict(new_plan_id="cheaper"),
+            dict(cycle_days=0), dict(cycle_days=-1), dict(days_remaining=-1),
+            dict(days_remaining=3), dict(days_remaining=True), dict(cycle_days=True),
+            dict(days_remaining=1.0), dict(cycle_days=2.0), dict(subscription_id=False),
+            dict(new_plan_id=True), dict(idempotency_key=""), dict(idempotency_key=" "),
+            dict(idempotency_key=False),
+        ):
+            with self.subTest(changes=changes), self.assertRaises(ValidationError):
+                self.upgrade(**changes)
+        self.assertEqual(self.sub.plan_id, "base")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [])
+        self.upgrade()
+
+    def test_replay_after_further_upgrade_returns_original_entry(self):
+        original = self.upgrade()
+        later = self.upgrade(new_plan_id="premium", idempotency_key="second")
+        self.service = OrderService(self.service.ledger)
+        self.assertIs(self.upgrade(), original)
+        self.assertEqual(self.sub.plan_id, "premium")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [original, later])
+
+    def test_conflict_checks_all_arguments(self):
+        original = self.upgrade()
+        other = self.service.start_subscription("acct", "base")
+        for changes in (
+            dict(subscription_id=other.subscription_id), dict(new_plan_id="premium"),
+            dict(days_remaining=0), dict(cycle_days=3), dict(days_remaining=True),
+        ):
+            with self.subTest(changes=changes), self.assertRaises(ValidationError):
+                self.upgrade(**changes)
+        self.assertEqual(other.plan_id, "base")
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertEqual(self.service.ledger.entries_for_account("acct"), [original])
