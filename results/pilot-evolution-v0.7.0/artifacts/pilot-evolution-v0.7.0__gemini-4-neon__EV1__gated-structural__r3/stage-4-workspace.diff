+"""Unit tests for promo codes across orders and mid-cycle plan upgrades."""
+
+from __future__ import annotations
+
+from typing import Any
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, Promo, ValidationError
+from ev1_order_ledger.pricing import apply_promo_and_tax
+
+
+class PromoCodeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=500))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="enterprise", name="Enterprise", monthly_cents=7000, tax_bps=1000))
+
+    def test_register_promo_validation_rejects_invalid_configs(self) -> None:
+        invalid_kwargs: list[tuple[Any, dict[str, Any]]] = [
+            # Neither or both discount types
+            ("NONE", {}),
+            ("BOTH", {"percent_off": 10, "amount_off_cents": 100}),
+            # Invalid percent_off
+            ("PCT0", {"percent_off": 0}),
+            ("PCTNEG", {"percent_off": -5}),
+            ("PCT101", {"percent_off": 101}),
+            ("PCTBOOL", {"percent_off": True}),
+            ("PCTFLOAT", {"percent_off": 10.0}),
+            # Invalid amount_off_cents
+            ("AMT0", {"amount_off_cents": 0}),
+            ("AMTNEG", {"amount_off_cents": -100}),
+            ("AMTBOOL", {"amount_off_cents": True}),
+            ("AMTFLOAT", {"amount_off_cents": 50.0}),
+            # Invalid min_subtotal_cents
+            ("MINNEG", {"percent_off": 10, "min_subtotal_cents": -1}),
+            ("MINBOOL", {"percent_off": 10, "min_subtotal_cents": False}),
+            # Invalid code
+            ("", {"percent_off": 10}),
+            ("   ", {"percent_off": 10}),
+            ("A,B", {"percent_off": 10}),
+            ("A;B", {"percent_off": 10}),
+            ("A+B", {"percent_off": 10}),
+            ("A B", {"percent_off": 10}),
+            (None, {"percent_off": 10}),
+            # Invalid expires_on
+            ("BADDATE1", {"percent_off": 10, "expires_on": "2026-02-29"}),
+            ("BADDATE2", {"percent_off": 10, "expires_on": "2026-13-01"}),
+            ("BADDATE3", {"percent_off": 10, "expires_on": "20260101"}),
+            ("BADDATE4", {"percent_off": 10, "expires_on": "2026-1-5"}),
+            ("BADDATE5", {"percent_off": 10, "expires_on": ""}),
+        ]
+        for code, kwargs in invalid_kwargs:
+            with self.subTest(code=code, kwargs=kwargs):
+                with self.assertRaises(ValidationError):
+                    self.svc.register_promo(code, **kwargs)
+
+        # Valid boundary registrations
+        p1 = self.svc.register_promo("MIN1", percent_off=1, min_subtotal_cents=0)
+        p100 = self.svc.register_promo("FREE100", percent_off=100, expires_on="2026-12-31")
+        pamt = self.svc.register_promo("PENNY", amount_off_cents=1, min_subtotal_cents=100)
+        self.assertEqual(p1.percent_off, 1)
+        self.assertEqual(p100.percent_off, 100)
+        self.assertEqual(pamt.amount_off_cents, 1)
+
+    def test_percentage_promo_on_order_computes_pre_tax_discount_and_tax(self) -> None:
+        self.svc.register_promo("SAVE15", percent_off=15)
+        # Raw subtotal = 1999; 15% half-up = 1999 * 15 / 100 = 299.85 -> 300
+        # Discounted subtotal = 1699; tax @ 825 bps = 1699 * 825 / 10000 = 140.1675 -> 140
+        order = self.svc.place_order(
+            "acct_1",
+            [LineItem(sku="seat", unit_cents=1999, quantity=1)],
+            tax_bps=825,
+            promo_code="SAVE15",
+        )
+        self.assertEqual(order.discount_cents, 300)
+        self.assertEqual(order.subtotal_cents, 1699)
+        self.assertEqual(order.tax_cents, 140)
+        self.assertEqual(order.total_cents, 1839)
+        self.assertEqual(order.promo_code, "SAVE15")
+
+        stmt = self.svc.get_statement("acct_1")
+        self.assertEqual(stmt["balance_cents"], 1839)
+        self.assertEqual(stmt["entry_count"], 1)
+
+        # Half-up exact .5 percentage discount: 1005 * 10 / 100 = 100.5 -> 101
+        self.svc.register_promo("SAVE10", percent_off=10)
+        order_half = self.svc.place_order(
+            "acct_2",
+            [LineItem(sku="seat", unit_cents=1005, quantity=1)],
+            tax_bps=1000,
+            promo_code="SAVE10",
+        )
+        self.assertEqual(order_half.discount_cents, 101)
+        self.assertEqual(order_half.subtotal_cents, 904)
+        self.assertEqual(order_half.tax_cents, 90)
+        self.assertEqual(order_half.total_cents, 994)
+
+    def test_fixed_amount_promo_and_zero_clamping_on_order(self) -> None:
+        self.svc.register_promo("FLAT500", amount_off_cents=500)
+        order = self.svc.place_order(
+            "acct_1",
+            [LineItem(sku="seat", unit_cents=1200, quantity=1)],
+            tax_bps=1000,
+            promo_code="FLAT500",
+        )
+        self.assertEqual(order.discount_cents, 500)
+        self.assertEqual(order.subtotal_cents, 700)
+        self.assertEqual(order.tax_cents, 70)
+        self.assertEqual(order.total_cents, 770)
+        self.assertEqual(order.promo_code, "FLAT500")
+
+        # Amount exceeding subtotal clamps discounted subtotal at 0 and tax at 0
+        self.svc.register_promo("HUGE5000", amount_off_cents=5000)
+        clamped = self.svc.place_order(
+            "acct_2",
+            [LineItem(sku="seat", unit_cents=1200, quantity=1)],
+            tax_bps=1000,
+            promo_code="HUGE5000",
+        )
+        self.assertEqual(clamped.discount_cents, 1200)
+        self.assertEqual(clamped.subtotal_cents, 0)
+        self.assertEqual(clamped.tax_cents, 0)
+        self.assertEqual(clamped.total_cents, 0)
+        self.assertEqual(clamped.promo_code, "HUGE5000")
+
+    def test_order_promo_expiry_stacking_unknown_and_min_subtotal_fail_closed(self) -> None:
+        self.svc.register_promo("A", amount_off_cents=100)
+        self.svc.register_promo("B", amount_off_cents=100)
+        self.svc.register_promo("SPRING", percent_off=20, expires_on="2026-05-01")
+        self.svc.register_promo("MIN2000", amount_off_cents=300, min_subtotal_cents=2000)
+
+        items_1000 = [LineItem(sku="seat", unit_cents=1000, quantity=1)]
+        items_2000 = [LineItem(sku="seat", unit_cents=2000, quantity=1)]
+
+        # Unknown and empty promo codes
+        for bad_code in ("NOPE", "", "   "):
+            with self.assertRaises(ValidationError):
+                self.svc.place_order("acct_err", items_1000, promo_code=bad_code)
