+"""Unit tests for legacy_flat_fee removal and fail-closed audit logging."""
+
+from __future__ import annotations
+
+from typing import Any, Dict, List
+import unittest
+
+from ev1_order_ledger import pricing
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, ValidationError
+
+
+class LegacyCleanupAndAuditTests(unittest.TestCase):
+    def test_legacy_flat_fee_removed_and_raises_type_error(self) -> None:
+        self.assertFalse(hasattr(pricing, "LEGACY_FLAT_FEE_CENTS"))
+
+        svc = OrderService()
+        items = [LineItem(sku="seat", unit_cents=1000, quantity=1)]
+
+        for flag_value in (True, False):
+            bad_kwargs: Dict[str, Any] = {"legacy_flat_fee": flag_value}
+            with self.assertRaises(TypeError):
+                pricing.calculate_order_totals(items, tax_bps=1000, **bad_kwargs)
+            with self.assertRaises(TypeError):
+                svc.place_order("acct_1", items, tax_bps=1000, **bad_kwargs)
+
+    def test_audit_sink_emits_for_committed_mutations_and_skips_replays(self) -> None:
+        events: List[Dict[str, object]] = []
+        svc = OrderService(audit_sink=events.append)
+        svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=825))
+        svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+
+        order = svc.place_order(
+            "acct_1",
+            [LineItem(sku="seat", unit_cents=1000, quantity=1)],
+            tax_bps=1000,
+        )
+        order_entry = svc.ledger.entries_for_account("acct_1")[0]
+
+        sub = svc.start_subscription("acct_1", "starter")
+        upgrade_entry = svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="upg-aud-1",
+        )
+        # Idempotent replay must NOT emit another audit event
+        replay_upgrade = svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="upg-aud-1",
+        )
+        self.assertIs(replay_upgrade, upgrade_entry)
+
+        refund_entry = svc.refund_order(
+            order.order_id,
+            400,
+            reason="partial",
+            idempotency_key="ref-aud-1",
+        )
+        # Idempotent replay must NOT emit another audit event
+        replay_refund = svc.refund_order(
+            order.order_id,
+            400,
+            reason="partial",
+            idempotency_key="ref-aud-1",
+        )
+        self.assertIs(replay_refund, refund_entry)
+
+        self.assertEqual(
+            events,
+            [
+                {
+                    "action": "order_charge",
+                    "account_id": "acct_1",
+                    "amount_cents": order_entry.total_cents,
+                    "entry_id": order_entry.entry_id,
+                },
+                {
+                    "action": "plan_upgrade",
+                    "account_id": "acct_1",
+                    "amount_cents": upgrade_entry.total_cents,
+                    "entry_id": upgrade_entry.entry_id,
+                },
+                {
+                    "action": "order_refund",
+                    "account_id": "acct_1",
+                    "amount_cents": refund_entry.total_cents,
+                    "entry_id": refund_entry.entry_id,
+                },
+            ],
+        )
+
+    def test_audit_sink_failure_is_fail_closed_and_atomic(self) -> None:
+        should_fail = True
+        events: List[Dict[str, object]] = []
+
+        def flaky_sink(event: Dict[str, object]) -> None:
+            if should_fail:
+                raise RuntimeError("audit backend unavailable")
+            events.append(event)
+
+        svc = OrderService(audit_sink=flaky_sink)
+        svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=825))
+        svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+
+        # 1. Failing place_order commits neither order nor ledger entry
+        with self.assertRaisesRegex(RuntimeError, "audit backend unavailable"):
+            svc.place_order("acct_fail", [LineItem(sku="seat", unit_cents=1000, quantity=1)], tax_bps=1000)
+        self.assertEqual(svc.get_statement("acct_fail")["entry_count"], 0)
+        self.assertEqual(svc.get_statement("acct_fail")["balance_cents"], 0)
+        with self.assertRaises(ValidationError):
+            svc.ledger.get_order("ord_0001")
+
+        # Allow a baseline order to succeed so we can test refund atomicity
+        should_fail = False
+        order = svc.place_order("acct_fail", [LineItem(sku="seat", unit_cents=1000, quantity=1)], tax_bps=1000)
+        sub = svc.start_subscription("acct_fail", "starter")
+        self.assertEqual(len(events), 1)
+
+        # 2. Failing upgrade_subscription leaves plan_id, ledger, and idempotency key untouched
+        should_fail = True
+        with self.assertRaisesRegex(RuntimeError, "audit backend unavailable"):
+            svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="upg-atomic")
+        self.assertEqual(svc.ledger.get_subscription(sub.subscription_id).plan_id, "starter")
+        self.assertEqual(svc.get_statement("acct_fail")["entry_count"], 1)
+
+        # 3. Failing refund_order leaves balance, refunded totals, and idempotency key untouched
+        with self.assertRaisesRegex(RuntimeError, "audit backend unavailable"):
+            svc.refund_order(order.order_id, 500, reason="retryable", idempotency_key="ref-atomic")
+        self.assertEqual(svc.ledger.refunded_totals_for_order(order.order_id), (0, 0))
+        self.assertEqual(svc.get_statement("acct_fail")["entry_count"], 1)
+        self.assertEqual(svc.get_statement("acct_fail")["balance_cents"], order.total_cents)
+
+        # 4. Once audit sink recovers, retrying with the same idempotency keys succeeds cleanly
+        should_fail = False
+        upg = svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="upg-atomic")
+        ref = svc.refund_order(order.order_id, 500, reason="retryable", idempotency_key="ref-atomic")
+        self.assertEqual(svc.ledger.get_subscription(sub.subscription_id).plan_id, "pro")
+        self.assertEqual(svc.ledger.refunded_totals_for_order(order.order_id)[0], 500)
+        self.assertEqual(svc.get_statement("acct_fail")["entry_count"], 3)
+        self.assertEqual([e["entry_id"] for e in events[1:]], [upg.entry_id, ref.entry_id])
+
+    def test_non_callable_audit_sink_rejected(self) -> None:
+        bad_sink: Any = "not-callable"
+        with self.assertRaises(ValidationError):
+            OrderService(audit_sink=bad_sink)
+
+
+if __name__ == "__main__":
+    unittest.main()

