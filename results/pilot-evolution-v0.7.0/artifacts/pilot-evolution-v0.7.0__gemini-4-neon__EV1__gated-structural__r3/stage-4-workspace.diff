+            (sub.subscription_id, "enterprise", True, 30, "k_bool_rem_true"),
+            (sub.subscription_id, "enterprise", False, 30, "k_bool_rem_false"),
+            (sub.subscription_id, "enterprise", 1, True, "k_bool_cycle_true"),
