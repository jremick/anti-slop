+    def lookup_idempotent_entry(
+        self,
+        idempotency_key: str,
+        fingerprint: Tuple[object, ...],
+    ) -> Optional[LedgerEntry]:
+        """Return the prior LedgerEntry for an identical replay, or raise on conflict."""
+        key = validate_idempotency_key(idempotency_key)
+        existing = self._idempotency.get(key)
+        if existing is None:
+            return None
+        stored_fingerprint, entry_id = existing
+        if stored_fingerprint != _normalize_fingerprint(fingerprint):
+            raise ValidationError(f"Idempotency key already used with different arguments: {key}")
+        return self._entries[entry_id]
+
+    def record_idempotent_entry(
+        self,
+        idempotency_key: str,
+        fingerprint: Tuple[object, ...],
+        entry: LedgerEntry,
+    ) -> LedgerEntry:
+        """Record a LedgerEntry under idempotency_key, replaying or failing closed on conflict."""
+        existing = self.lookup_idempotent_entry(idempotency_key, fingerprint)
+        if existing is not None:
+            return existing
+        self.record_entry(entry)
+        self._idempotency[idempotency_key] = (_normalize_fingerprint(fingerprint), entry.entry_id)
+        return entry
+
     def get_entry(self, entry_id: str) -> Optional[LedgerEntry]:
