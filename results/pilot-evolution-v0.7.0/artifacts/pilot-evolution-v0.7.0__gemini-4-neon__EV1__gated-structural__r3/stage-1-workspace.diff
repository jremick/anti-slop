+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "enterprise")
+        self.assertIs(
+            self.svc.upgrade_subscription(
+                sub.subscription_id,
+                "pro",
+                1,
+                30,
+                idempotency_key="upg-replay-1",
+            ),
+            first,
+        )
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "enterprise")
+        self.assertEqual(self.svc.get_statement("acct_1")["entry_count"], 2)
+        self.assertEqual(
+            self.svc.get_statement("acct_1")["balance_cents"],
+            first.total_cents + second.total_cents,
