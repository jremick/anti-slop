+def parse_iso_date(value: str, field_name: str) -> date:
+    """Parse a strict YYYY-MM-DD calendar date or raise ValidationError."""
+    if not isinstance(value, str) or len(value) != 10 or value[4] != "-" or value[7] != "-":
+        raise ValidationError(f"{field_name} must be a valid YYYY-MM-DD date")
+    try:
+        return date.fromisoformat(value)
+    except ValueError as exc:
+        raise ValidationError(f"{field_name} must be a valid YYYY-MM-DD date") from exc
+
+
+def validate_promo_code(code: str) -> str:
+    """Validate that a promo code is a single non-empty token without stacking separators."""
+    if not isinstance(code, str) or not code.strip():
+        raise ValidationError("promo_code must be a non-empty string")
+    if any(sep in code for sep in (",", ";", "+", "|")) or any(ch.isspace() for ch in code):
+        raise ValidationError("promo_code must be a single code without separators or whitespace")
+    return code
+
+
+def validate_promo(promo: Promo) -> Promo:
+    """Validate Promo definition invariants."""
+    validate_promo_code(promo.code)
+    has_percent = promo.percent_off is not None
+    has_amount = promo.amount_off_cents is not None
+    if has_percent == has_amount:
+        raise ValidationError("Exactly one of percent_off or amount_off_cents must be specified")
+    if promo.percent_off is not None:
+        validate_positive_int(promo.percent_off, "percent_off")
+        if promo.percent_off > 100:
+            raise ValidationError("percent_off cannot exceed 100")
+    if promo.amount_off_cents is not None:
+        validate_positive_int(promo.amount_off_cents, "amount_off_cents")
+    validate_non_negative_int(promo.min_subtotal_cents, "min_subtotal_cents")
+    if promo.expires_on is not None:
+        parse_iso_date(promo.expires_on, "expires_on")
+    return promo
+
+
+def apply_promo_and_tax(
+    subtotal_cents: int,
