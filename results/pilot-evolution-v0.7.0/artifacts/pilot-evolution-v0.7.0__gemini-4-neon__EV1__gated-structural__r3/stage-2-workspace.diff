+class PlanUpgradeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=500))
+        self.svc.register_plan(Plan(plan_id="starter_alt", name="Starter Alt", monthly_cents=1000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="enterprise", name="Enterprise", monthly_cents=7000, tax_bps=1000))
+
+    def test_mid_cycle_upgrade_proration_tax_and_ledger_entry(self) -> None:
+        sub = self.svc.start_subscription("acct_1", "starter")
+        entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "pro",
+            15,
+            30,
+            idempotency_key="upg-001",
+        )
+        # (3000 - 1000) * 15 / 30 = 1000; tax uses new_plan.tax_bps (825), not old_plan (500):
+        # 1000 * 825 / 10000 = 82.5 -> 83 (half-up)
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, sub.subscription_id)
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual(entry.subtotal_cents, 1000)
+        self.assertEqual(entry.tax_cents, 83)
+        self.assertEqual(entry.total_cents, 1083)
+
+        updated_sub = self.svc.ledger.get_subscription(sub.subscription_id)
+        self.assertEqual(updated_sub.plan_id, "pro")
+        stmt = self.svc.get_statement("acct_1")
+        self.assertEqual(stmt["balance_cents"], 1083)
+        self.assertEqual(stmt["entry_count"], 1)
+
+    def test_proration_and_tax_half_up_rounding(self) -> None:
+        # Exact .5 cases where half-up differs from banker's rounding (0.5 -> 1, 2.5 -> 3)
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 1001, 1, 2), 1)
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 1003, 1, 2), 2)
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 1005, 1, 2), 3)
+        # Non-half repeating fractions: 1000/3 = 333.33 -> 333, 2000/3 = 666.66 -> 667
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 2000, 1, 3), 333)
+        self.assertEqual(compute_prorated_upgrade_cents(1000, 3000, 1, 3), 667)
+
+        # End-to-end upgrade verifying half-up on both proration and tax:
+        # diff = 1001, days = 1/2 -> 500.5 -> 501; tax = 501 * 50 / 10000 = 2.505 -> 3
+        old_p = Plan(plan_id="p_old", name="Old", monthly_cents=1000, tax_bps=0)
+        new_p = Plan(plan_id="p_new", name="New", monthly_cents=2001, tax_bps=50)
+        self.svc.register_plan(old_p)
+        self.svc.register_plan(new_p)
+        self.assertEqual(calculate_upgrade_totals(old_p, new_p, 1, 2), (501, 3, 504))
+
+        # Exact .5 tax on even integer: 500 * 50 / 10000 = 2.5 -> 3 (not 2)
+        even_new = Plan(plan_id="p_even_tax", name="EvenTax", monthly_cents=2000, tax_bps=50)
+        self.svc.register_plan(even_new)
+        sub = self.svc.start_subscription("acct_half", "p_old")
+        entry = self.svc.upgrade_subscription(
+            sub.subscription_id,
+            "p_even_tax",
+            1,
+            2,
+            idempotency_key="upg-half",
+        )
+        self.assertEqual(entry.subtotal_cents, 500)
+        self.assertEqual(entry.tax_cents, 3)
+        self.assertEqual(entry.total_cents, 503)
+
+    def test_boundary_zero_and_full_cycle_days(self) -> None:
