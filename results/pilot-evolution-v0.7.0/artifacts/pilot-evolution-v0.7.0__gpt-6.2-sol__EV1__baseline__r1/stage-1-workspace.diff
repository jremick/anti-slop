@@ -0,0 +1,129 @@
+"""Tests for prorated subscription upgrades and ledger idempotency."""
+
+from concurrent.futures import ThreadPoolExecutor
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import Plan, ValidationError
+
+
+class SubscriptionUpgradeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.svc.register_plan(Plan("starter", "Starter", 1000))
+        self.svc.register_plan(Plan("pro", "Pro", 1005, tax_bps=5000))
+        self.svc.register_plan(Plan("premium", "Premium", 2000))
+        self.sub = self.svc.start_subscription("acct_1", "starter")
+
+    def test_upgrade_rounds_proration_and_new_plan_tax_half_up(self) -> None:
+        entry = self.svc.upgrade_subscription(
+            self.sub.subscription_id, "pro", 1, 2, idempotency_key="upgrade"
+        )
+
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (3, 2, 5))
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.sub.subscription_id)
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertIs(self.svc.ledger.get_entry(entry.entry_id), entry)
+        self.assertEqual(self.svc.get_statement("acct_1"), {
+            "account_id": "acct_1", "balance_cents": 5, "entry_count": 1,
+        })
+
+    def test_valid_proration_periods_include_both_endpoints(self) -> None:
+        for remaining, cycle, expected in ((0, 4, 0), (1, 4, 1), (1, 3, 2), (4, 4, 5)):
+            with self.subTest(remaining=remaining, cycle=cycle):
+                sub = self.svc.start_subscription("acct_2", "starter")
+                entry = self.svc.upgrade_subscription(
+                    sub.subscription_id, "pro", remaining, cycle, idempotency_key=sub.subscription_id
+                )
+                self.assertEqual(entry.subtotal_cents, expected)
+                self.assertEqual(sub.plan_id, "pro")
+
+    def test_invalid_arguments_leave_subscription_and_ledger_unchanged(self) -> None:
+        self.svc.register_plan(Plan("cheaper", "Cheaper", 999))
+        self.svc.register_plan(Plan("equal", "Equal", 1000))
+        self.svc.register_plan(Plan("bad_tax", "Bad tax", 2000, tax_bps=True))
+        sub_id = self.sub.subscription_id
+        invalid_requests = (
+            (sub_id, "pro", 1, 0, "upgrade"),
+            (sub_id, "pro", 0, -1, "upgrade"),
+            (sub_id, "pro", -1, 2, "upgrade"),
+            (sub_id, "pro", 3, 2, "upgrade"),
+            (sub_id, "pro", True, 2, "upgrade"),
+            (sub_id, "pro", 0, True, "upgrade"),
+            (sub_id, "pro", 1.0, 2, "upgrade"),
+            (sub_id, "pro", 1, 2.0, "upgrade"),
+            ("missing", "pro", 1, 2, "upgrade"),
+            (True, "pro", 1, 2, "upgrade"),
+            (sub_id, "missing", 1, 2, "upgrade"),
+            (sub_id, True, 1, 2, "upgrade"),
+            (sub_id, "starter", 1, 2, "upgrade"),
+            (sub_id, "cheaper", 1, 2, "upgrade"),
+            (sub_id, "equal", 1, 2, "upgrade"),
+            (sub_id, "bad_tax", 1, 2, "upgrade"),
+            (sub_id, "pro", 1, 2, ""),
+            (sub_id, "pro", 1, 2, "  "),
+            (sub_id, "pro", 1, 2, True),
+        )
+        for subscription, plan, remaining, cycle, key in invalid_requests:
+            with self.subTest(arguments=(subscription, plan, remaining, cycle, key)):
+                with self.assertRaises(ValidationError):
+                    self.svc.upgrade_subscription(
+                        subscription, plan, remaining, cycle, idempotency_key=key
+                    )
+                self.assertEqual(self.sub.plan_id, "starter")
+                self.assertEqual(self.svc.ledger.entries_for_account("acct_1"), [])
+
+        self.svc.upgrade_subscription(sub_id, "pro", 1, 2, idempotency_key="upgrade")
+        self.assertEqual(self.svc.get_statement("acct_1")["entry_count"], 1)
+
+    def test_idempotent_replay_uses_shared_ledger_and_survives_later_upgrade(self) -> None:
+        sub_id = self.sub.subscription_id
+        entry = self.svc.upgrade_subscription(sub_id, "pro", 1, 2, idempotency_key="first")
+        self.svc.upgrade_subscription(sub_id, "premium", 1, 2, idempotency_key="second")
+
+        another_service = OrderService(self.svc.ledger)
+        replay = another_service.upgrade_subscription(sub_id, "pro", 1, 2, idempotency_key="first")
+        self.assertIs(replay, entry)
+        self.assertEqual(self.sub.plan_id, "premium")
+        self.assertEqual(self.svc.get_statement("acct_1")["entry_count"], 2)
+
+    def test_idempotency_key_rejects_conflicts_and_invalid_replays(self) -> None:
+        sub_id = self.sub.subscription_id
+        other_sub = self.svc.start_subscription("acct_2", "starter")
+        entry = self.svc.upgrade_subscription(sub_id, "pro", 1, 2, idempotency_key="upgrade")
+        for arguments in (
+            (other_sub.subscription_id, "pro", 1, 2),
+            (sub_id, "premium", 1, 2),
+            (sub_id, "pro", 2, 2),
+            (sub_id, "pro", 1, 3),
+            (sub_id, "pro", True, 2),
+            (sub_id, "pro", 1.0, 2),
+        ):
+            with self.subTest(arguments=arguments):
+                with self.assertRaises(ValidationError):
+                    self.svc.upgrade_subscription(*arguments, idempotency_key="upgrade")
+
+        self.assertEqual(self.sub.plan_id, "pro")
+        self.assertEqual(other_sub.plan_id, "starter")
+        self.assertEqual(self.svc.ledger.entries_for_account("acct_1"), [entry])
+        self.assertEqual(self.svc.ledger.entries_for_account("acct_2"), [])
+
+    def test_concurrent_replays_record_one_entry(self) -> None:
+        with ThreadPoolExecutor(max_workers=4) as pool:
+            requests = [
+                pool.submit(
+                    self.svc.upgrade_subscription,
+                    self.sub.subscription_id,
+                    "pro",
+                    1,
+                    2,
+                    idempotency_key="upgrade",
+                )
+                for _ in range(4)
+            ]
+            entry = requests[0].result()
+            for request in requests[1:]:
+                self.assertIs(request.result(), entry)
+        self.assertEqual(self.svc.ledger.entries_for_account("acct_1"), [entry])
