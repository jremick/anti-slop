{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc 'cat benchmarks/sources/ev1_order_ledger/models.py'","aggregated_output":"\"\"\"Core domain models for the EV1 order ledger fixture.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom datetime import date\nfrom typing import Tuple\n\n\nclass BillingError(Exception):\n    \"\"\"Base error for billing domain failures.\"\"\"\n\n\nclass ValidationError(BillingError):\n    \"\"\"Raised when input arguments or business invariants are violated.\"\"\"\n\n\n@dataclass(frozen=True)\nclass Plan:\n    plan_id: str\n    name: str\n    monthly_cents: int\n    tax_bps: int = 0\n\n\n@dataclass(frozen=True)\nclass Promo:\n    code: str\n    percent_off: int | None\n    amount_off_cents: int | None\n    expires_on: date | None\n    min_subtotal_cents: int\n\n\n@dataclass(frozen=True)\nclass LineItem:\n    sku: str\n    unit_cents: int\n    quantity: int\n\n\n@dataclass(frozen=True)\nclass Order:\n    order_id: str\n    account_id: str\n    items: Tuple[LineItem, ...]\n    subtotal_cents: int\n    tax_cents: int\n    total_cents: int\n    discount_cents: int = 0\n    promo_code: str | None = None\n\n\n@dataclass\nclass Subscription:\n    subscription_id: str\n    account_id: str\n    plan_id: str\n    status: str = \"active\"\n\n\n@dataclass(frozen=True)\nclass LedgerEntry:\n    entry_id: str\n    account_id: str\n    kind: str\n    subtotal_cents: int\n    tax_cents: int\n    total_cents: int\n    reference_id: str\n    reason: str = \"\"\n    metadata: dict = field(default_factory=dict)\n","exit_code":0,"status":"completed"}}
