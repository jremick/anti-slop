{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc 'cat benchmarks/sources/ev1_order_ledger/pricing.py benchmarks/sources/ev1_order_ledger/tests/test_orders.py'","aggregated_output":"\"\"\"Canonical integer-cent pricing calculations for EV1 order ledger.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom datetime import date\nfrom typing import Sequence, Tuple\n\nfrom .models import LineItem, Order, Plan, Promo, ValidationError\n\n\nLEGACY_FLAT_FEE_CENTS = 500\n\n\n@dataclass(frozen=True)\nclass ChargeTotals:\n    subtotal_cents: int\n    tax_cents: int\n    total_cents: int\n    discount_cents: int\n\n\ndef validate_non_negative_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value < 0:\n        raise ValidationError(f\"{field_name} must be a non-negative integer\")\n    return value\n\n\ndef validate_positive_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:\n        raise ValidationError(f\"{field_name} must be a positive integer\")\n    return value\n\n\ndef round_half_up_div(numerator: int, denominator: int) -> int:\n    \"\"\"Exact integer half-up division for non-negative numerator and positive denominator.\"\"\"\n    validate_non_negative_int(numerator, \"numerator\")\n    validate_positive_int(denominator, \"denominator\")\n    return (numerator * 2 + denominator) // (2 * denominator)\n\n\ndef compute_subtotal_cents(items: Sequence[LineItem]) -> int:\n    if not items:\n        raise ValidationError(\"items must be non-empty\")\n    subtotal = 0\n    for item in items:\n        validate_positive_int(item.unit_cents, \"unit_cents\")\n        validate_positive_int(item.quantity, \"quantity\")\n        subtotal += item.unit_cents * item.quantity\n    return subtotal\n\n\ndef compute_tax_cents(taxable_cents: int, tax_bps: int) -> int:\n    validate_non_negative_int(taxable_cents, \"taxable_cents\")\n    validate_non_negative_int(tax_bps, \"tax_bps\")\n    if tax_bps > 10_000:\n        raise ValidationError(\"tax_bps cannot exceed 10000\")\n    return round_half_up_div(taxable_cents * tax_bps, 10_000)\n\n\ndef calculate_refund_split(\n    order: Order, already_refunded_cents: int, amount_cents: int\n) -> tuple[int, int]:\n    \"\"\"Return the subtotal and tax for the next refund using cumulative rounding.\"\"\"\n    refunded_after = already_refunded_cents + amount_cents\n    if refunded_after > order.total_cents:\n        raise ValidationError(\"refund amount exceeds the order's remaining refundable balance\")\n    tax_before = round_half_up_div(already_refunded_cents * order.tax_cents, order.total_cents)\n    tax_after = round_half_up_div(refunded_after * order.tax_cents, order.total_cents)\n    refund_tax = tax_after - tax_before\n    return amount_cents - refund_tax, refund_tax\n\n\ndef parse_optional_date(value: str | None, field_name: str) -> date | None:\n    if value is None:\n        return None\n    try:\n        parsed = date.fromisoformat(value)\n        if parsed.isoformat() == value:\n            return parsed\n    except (TypeError, ValueError):\n        pass\n    raise ValidationError(f\"{field_name} must be a valid YYYY-MM-DD date\")\n\n\ndef calculate_charge_totals(\n    subtotal_cents: int,\n    tax_bps: int,\n    *,\n    promo: Promo | None = None,\n    as_of: date | None = None,\n) -> ChargeTotals:\n    discount = 0\n    if promo is not None:\n        if subtotal_cents < promo.min_subtotal_cents:\n            raise ValidationError(\"subtotal is below the promo minimum\")\n        if promo.expires_on is not None and (as_of is None or as_of > promo.expires_on):\n            raise ValidationError(\"expiring promo requires as_of on or before expires_on\")\n        if promo.percent_off is not None:\n            discount = round_half_up_div(subtotal_cents * promo.percent_off, 100)\n        elif promo.amount_off_cents is not None:\n            discount = min(subtotal_cents, promo.amount_off_cents)\n        else:\n            raise ValidationError(\"promo has no discount\")\n\n    subtotal = subtotal_cents - discount\n    tax = compute_tax_cents(subtotal, tax_bps)\n    return ChargeTotals(subtotal, tax, subtotal + tax, discount)\n\n\ndef validate_proration_period(days_remaining: int, cycle_days: int) -> None:\n    validate_positive_int(cycle_days, \"cycle_days\")\n    validate_non_negative_int(days_remaining, \"days_remaining\")\n    if days_remaining > cycle_days:\n        raise ValidationError(\"days_remaining cannot exceed cycle_days\")\n\n\ndef price_upgrade(\n    old_plan: Plan,\n    new_plan: Plan,\n    days_remaining: int,\n    cycle_days: int,\n    *,\n    promo: Promo | None = None,\n    as_of: date | None = None,\n) -> ChargeTotals:\n    \"\"\"Price an upgrade for a validated proration period.\"\"\"\n    price_difference = new_plan.monthly_cents - old_plan.monthly_cents\n    if price_difference <= 0:\n        raise ValidationError(\"new plan must cost more than the current plan\")\n    subtotal = round_half_up_div(price_difference * days_remaining, cycle_days)\n    return calculate_charge_totals(subtotal, new_plan.tax_bps, promo=promo, as_of=as_of)\n\n\ndef price_order(\n    items: Sequence[LineItem],\n    *,\n    tax_bps: int = 0,\n    legacy_flat_fee: bool = False,\n    promo: Promo | None = None,\n    as_of: date | None = None,\n) -> ChargeTotals:\n    subtotal = compute_subtotal_cents(items)\n    if legacy_flat_fee:\n        subtotal += LEGACY_FLAT_FEE_CENTS\n    return calculate_charge_totals(subtotal, tax_bps, promo=promo, as_of=as_of)\n\n\ndef calculate_upgrade_totals(\n    old_plan: Plan,\n    new_plan: Plan,\n    days_remaining: int,\n    cycle_days: int,\n) -> Tuple[int, int, int]:\n    \"\"\"Return the undiscounted subtotal, tax, and total for a validated proration period.\"\"\"\n    totals = price_upgrade(old_plan, new_plan, days_remaining, cycle_days)\n    return totals.subtotal_cents, totals.tax_cents, totals.total_cents\n\n\ndef calculate_order_totals(\n    items: Sequence[LineItem],\n    *,\n    tax_bps: int = 0,\n    legacy_flat_fee: bool = False,\n) -> Tuple[int, int, int]:\n    \"\"\"Return the undiscounted subtotal, tax, and total in integer cents.\"\"\"\n    totals = price_order(items, tax_bps=tax_bps, legacy_flat_fee=legacy_flat_fee)\n    return totals.subtotal_cents, totals.tax_cents, totals.total_cents\n\"\"\"Baseline unit tests for the initial EV1 order ledger fixture.\"\"\"\n\nfrom __future__ import annotations\n\nimport unittest\n\nfrom ev1_order_ledger.api import OrderService\nfrom ev1_order_ledger.models import LineItem, Plan, ValidationError\n\n\nclass BaselineOrderLedgerTests(unittest.TestCase):\n    def setUp(self) -> None:\n        self.svc = OrderService()\n        self.svc.register_plan(Plan(plan_id=\"starter\", name=\"Starter\", monthly_cents=1000, tax_bps=825))\n        self.svc.register_plan(Plan(plan_id=\"pro\", name=\"Pro\", monthly_cents=3000, tax_bps=825))\n\n    def test_place_order_computes_exact_integer_tax_and_records_entry(self) -> None:\n        order = self.svc.place_order(\n            \"acct_1\",\n            [LineItem(sku=\"seat\", unit_cents=1999, quantity=2)],\n            tax_bps=825,\n        )\n        self.assertEqual(order.subtotal_cents, 3998)\n        self.assertEqual(order.tax_cents, 330)  # 3998 * 825 / 10000 = 329.835 -> 330\n        self.assertEqual(order.total_cents, 4328)\n        stmt = self.svc.get_statement(\"acct_1\")\n        self.assertEqual(stmt[\"balance_cents\"], 4328)\n        self.assertEqual(stmt[\"entry_count\"], 1)\n\n    def test_legacy_flat_fee_adds_500_cents_before_tax(self) -> None:\n        order = self.svc.place_order(\n            \"acct_1\",\n            [LineItem(sku=\"seat\", unit_cents=1000, quantity=1)],\n            tax_bps=1000,\n            legacy_flat_fee=True,\n        )\n        self.assertEqual(order.subtotal_cents, 1500)\n        self.assertEqual(order.tax_cents, 150)\n        self.assertEqual(order.total_cents, 1650)\n\n    def test_invalid_order_inputs_fail_closed(self) -> None:\n        with self.assertRaises(ValidationError):\n            self.svc.place_order(\"\", [LineItem(sku=\"x\", unit_cents=100, quantity=1)])\n        with self.assertRaises(ValidationError):\n            self.svc.place_order(\"acct_1\", [])\n        with self.assertRaises(ValidationError):\n            self.svc.place_order(\"acct_1\", [LineItem(sku=\"x\", unit_cents=0, quantity=1)])\n\n    def test_start_subscription_validates_plan(self) -> None:\n        sub = self.svc.start_subscription(\"acct_1\", \"starter\")\n        self.assertEqual(sub.plan_id, \"starter\")\n        with self.assertRaises(ValidationError):\n            self.svc.start_subscription(\"acct_1\", \"nonexistent\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","exit_code":0,"status":"completed"}}
