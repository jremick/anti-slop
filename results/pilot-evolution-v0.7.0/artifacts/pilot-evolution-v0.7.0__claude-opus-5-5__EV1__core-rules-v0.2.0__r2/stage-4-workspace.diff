+        self.assertEqual(self.svc.ledger.get_subscription(other.subscription_id).plan_id, "starter")
+
+    def test_distinct_keys_allow_sequential_upgrades(self) -> None:
+        self.svc.upgrade_subscription(self.sub.subscription_id, "starter_plus", 1, 2, idempotency_key="k1")
+        second = self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 1, 2, idempotency_key="k2")
+        # (3000 - 1015) * 1 / 2 = 992.5 -> 993; tax 993 * 825 / 10000 = 81.92 -> 82
+        self.assertEqual((second.subtotal_cents, second.tax_cents, second.total_cents), (993, 82, 1075))
+        self.assertEqual(len(self.entries()), 2)
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 8 + 1075)
+
+    def test_unknown_ids_rejected(self) -> None:
