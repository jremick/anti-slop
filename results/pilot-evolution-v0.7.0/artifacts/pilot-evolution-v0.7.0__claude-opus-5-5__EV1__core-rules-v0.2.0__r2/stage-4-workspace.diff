+        for plan in (STARTER, PRO, STARTER_PLUS):
+            self.svc.register_plan(plan)
+        self.sub = self.svc.start_subscription("acct_1", "starter")
+
+    def entries(self):
+        return self.svc.ledger.entries_for_account("acct_1")
+
+    def test_upgrade_records_entry_and_updates_plan(self) -> None:
+        entry = self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 1, 30, idempotency_key="k1")
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.sub.subscription_id)
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (67, 6, 73))
+        self.assertEqual(self.svc.ledger.get_subscription(self.sub.subscription_id).plan_id, "pro")
+        self.assertEqual(self.entries(), [entry])
+        self.assertEqual(self.svc.get_statement("acct_1"), {"account_id": "acct_1", "balance_cents": 73, "entry_count": 1})
+
+    def test_replay_with_identical_args_returns_original_without_duplicate(self) -> None:
