+"""Turn 4: legacy flat fee removed; fail-closed audit logging."""
+
+from __future__ import annotations
+
+import inspect
+import unittest
+
+from ev1_order_ledger import api, pricing
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, ValidationError
+
+
+ITEMS = [LineItem(sku="seat", unit_cents=1999, quantity=2)]  # 3998 + 330 tax (825 bps) = 4328
+
+
+class LegacyFlatFeeRemovedTests(unittest.TestCase):
+    def test_place_order_rejects_legacy_flat_fee(self) -> None:
+        svc = OrderService()
+        for value in (True, False):
+            with self.subTest(value=value), self.assertRaises(TypeError):
+                svc.place_order("acct_1", ITEMS, legacy_flat_fee=value)
+        self.assertEqual(svc.get_statement("acct_1")["entry_count"], 0)
+
+    def test_calculate_order_totals_rejects_legacy_flat_fee(self) -> None:
+        for value in (True, False):
+            with self.subTest(value=value), self.assertRaises(TypeError):
+                pricing.calculate_order_totals(ITEMS, legacy_flat_fee=value)
+
+    def test_no_shims_or_constants_remain(self) -> None:
+        self.assertFalse(hasattr(pricing, "LEGACY_FLAT_FEE_CENTS"))
+        for fn in (pricing.calculate_order_totals, OrderService.place_order):
+            params = inspect.signature(fn).parameters.values()
+            with self.subTest(fn=fn.__qualname__):
+                self.assertNotIn("legacy_flat_fee", [p.name for p in params])
+                self.assertFalse(any(p.kind is inspect.Parameter.VAR_KEYWORD for p in params))
+
+
+class SinkFailure(Exception):
+    pass
+
+
+class RecordingSink:
+    def __init__(self) -> None:
+        self.events: list = []
+        self.fail = False
+
+    def __call__(self, event: dict) -> None:
+        if self.fail:
+            raise SinkFailure("audit backend unavailable")
+        self.events.append(event)
+
+
+class AuditTestCase(unittest.TestCase):
+    def setUp(self) -> None:
+        self.sink = RecordingSink()
+        self.svc = OrderService(audit_sink=self.sink)
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+        self.sub = self.svc.start_subscription("acct_1", "starter")
+
+    def entries(self):
+        return self.svc.ledger.entries_for_account("acct_1")
+
+    def plan_id(self) -> str:
+        return self.svc.ledger.get_subscription(self.sub.subscription_id).plan_id
+
+
+class AuditLoggingTests(AuditTestCase):
+    def test_each_committed_mutation_emits_one_event(self) -> None:
+        order = self.svc.place_order("acct_1", ITEMS, tax_bps=825)
+        charge = self.entries()[-1]
+        upgrade = self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 1, 30, idempotency_key="u1")
+        refund = self.svc.refund_order(order.order_id, 1000, reason="partial", idempotency_key="r1")
+        self.assertEqual(self.sink.events, [
+            {"action": "order_charge", "account_id": "acct_1", "amount_cents": 4328, "entry_id": charge.entry_id},
+            {"action": "plan_upgrade", "account_id": "acct_1", "amount_cents": 73, "entry_id": upgrade.entry_id},
+            {"action": "order_refund", "account_id": "acct_1", "amount_cents": -1000, "entry_id": refund.entry_id},
+        ])
+        self.assertEqual([e.entry_id for e in self.entries()], [ev["entry_id"] for ev in self.sink.events])
+
+    def test_idempotent_replays_are_not_logged(self) -> None:
+        order = self.svc.place_order("acct_1", ITEMS, tax_bps=825)
+        self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 1, 30, idempotency_key="u1")
+        self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 1, 30, idempotency_key="u1")
+        self.svc.refund_order(order.order_id, 1000, reason="partial", idempotency_key="r1")
+        self.svc.refund_order(order.order_id, 1000, reason="partial", idempotency_key="r1")
+        self.assertEqual([ev["action"] for ev in self.sink.events], ["order_charge", "plan_upgrade", "order_refund"])
+
+    def test_rejected_requests_are_not_logged(self) -> None:
+        with self.assertRaises(ValidationError):
+            self.svc.place_order("acct_1", [])
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 31, 30, idempotency_key="u1")
+        with self.assertRaises(ValidationError):
+            self.svc.refund_order("ord_missing", 1, reason="r", idempotency_key="r1")
+        self.assertEqual(self.sink.events, [])
+
+    def test_service_without_sink_still_works(self) -> None:
+        svc = OrderService()
+        self.assertEqual(svc.place_order("acct_1", ITEMS, tax_bps=825).total_cents, 4328)
+
+    def test_non_callable_sink_rejected(self) -> None:
+        with self.assertRaises(ValidationError):
+            OrderService(audit_sink="not callable")
+
+
+class AuditFailClosedTests(AuditTestCase):
+    def test_place_order_commits_nothing_when_sink_fails(self) -> None:
+        self.sink.fail = True
+        with self.assertRaises(SinkFailure):
+            self.svc.place_order("acct_1", ITEMS, tax_bps=825)
+        self.assertEqual(self.entries(), [])
+        self.assertEqual(self.svc.ledger._orders, {})  # no public order listing exists
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 0)
+
+    def test_upgrade_commits_nothing_and_keeps_key_when_sink_fails(self) -> None:
+        self.sink.fail = True
+        with self.assertRaises(SinkFailure):
+            self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 1, 30, idempotency_key="u1")
+        self.assertEqual(self.plan_id(), "starter")
+        self.assertEqual(self.entries(), [])
+        self.sink.fail = False
+        entry = self.svc.upgrade_subscription(self.sub.subscription_id, "pro", 1, 30, idempotency_key="u1")
+        self.assertEqual(entry.total_cents, 73)
+        self.assertEqual(self.plan_id(), "pro")
+        self.assertEqual(self.entries(), [entry])
+        self.assertEqual(len(self.sink.events), 1)
+
+    def test_refund_commits_nothing_and_keeps_key_when_sink_fails(self) -> None:
+        order = self.svc.place_order("acct_1", ITEMS, tax_bps=825)
+        self.sink.fail = True
+        with self.assertRaises(SinkFailure):
+            self.svc.refund_order(order.order_id, 4328, reason="full", idempotency_key="r1")
+        self.assertEqual(self.svc.ledger.refund_entries_for_order(order.order_id), [])
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 4328)
+        self.sink.fail = False
+        # Full amount is still refundable and the key was not consumed by the failed attempt.
+        refund = self.svc.refund_order(order.order_id, 4328, reason="full", idempotency_key="r1")
+        self.assertEqual((refund.subtotal_cents, refund.tax_cents), (-3998, -330))
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 0)
+
+
+if __name__ == "__main__":
+    unittest.main()

