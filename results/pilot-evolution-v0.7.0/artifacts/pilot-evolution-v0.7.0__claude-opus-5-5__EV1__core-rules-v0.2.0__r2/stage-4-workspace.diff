+"""Turn 3: partial refunds with exact penny conservation and credit-note export."""
+
+from __future__ import annotations
+
+import random
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, ValidationError
+from ev1_order_ledger.pricing import RefundSplit, allocate_refund
+
+
+class AllocateRefundTests(unittest.TestCase):
+    def test_hand_computed_chunks(self) -> None:
+        # order: subtotal 3998, tax 330, total 4328
+        # cumulative tax = round_half_up(330 * refunded / 4328): 76.25->76, 152.50->152, 228.74->229, 330
+        self.assertEqual(allocate_refund(3998, 330, 0, 0, 1000), RefundSplit(924, 76))
+        self.assertEqual(allocate_refund(3998, 330, 1000, 76, 1000), RefundSplit(924, 76))
+        self.assertEqual(allocate_refund(3998, 330, 2000, 152, 1000), RefundSplit(923, 77))
+        self.assertEqual(allocate_refund(3998, 330, 3000, 229, 1328), RefundSplit(1227, 101))
+
+    def test_randomized_sequences_conserve_every_penny(self) -> None:
+        rng = random.Random(20261127)
+        for _ in range(500):
+            subtotal = rng.randint(0, 50_000)
+            tax = rng.randint(0, subtotal)  # tax never exceeds subtotal (tax_bps <= 10000)
+            total = subtotal + tax
+            if total == 0:
+                continue
+            refunded = refunded_tax = 0
+            while refunded < total:
+                amount = rng.randint(1, min(total - refunded, rng.choice([1, 7, 100, total])))
+                split = allocate_refund(subtotal, tax, refunded, refunded_tax, amount)
+                self.assertEqual(split.subtotal_cents + split.tax_cents, amount)
+                self.assertTrue(0 <= split.tax_cents <= amount)
+                self.assertTrue(0 <= split.subtotal_cents)
+                refunded += amount
+                refunded_tax += split.tax_cents
+            self.assertEqual(refunded_tax, tax)
+            self.assertEqual(refunded - refunded_tax, subtotal)
+
+
+class RefundServiceTestCase(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.order = self.svc.place_order(
+            "acct_1", [LineItem(sku="seat", unit_cents=1999, quantity=2)], tax_bps=825
+        )  # subtotal 3998, tax 330, total 4328
+
+    def refunds(self):
+        return self.svc.ledger.refund_entries_for_order(self.order.order_id)
+
+    def refund(self, amount: int, key: str, reason: str = "partial"):
+        return self.svc.refund_order(self.order.order_id, amount, reason=reason, idempotency_key=key)
+
+
+class RefundOrderTests(RefundServiceTestCase):
+    def test_multi_chunk_refund_reverses_exact_subtotal_and_tax(self) -> None:
+        entries = [self.refund(a, f"k{i}") for i, a in enumerate((1000, 1000, 1000, 1328))]
+        self.assertEqual([(e.subtotal_cents, e.tax_cents, e.total_cents) for e in entries],
+                         [(-924, -76, -1000), (-924, -76, -1000), (-923, -77, -1000), (-1227, -101, -1328)])
+        for e in entries:
+            self.assertEqual(e.kind, "order_refund")
+            self.assertEqual(e.reference_id, self.order.order_id)
+            self.assertEqual(e.account_id, "acct_1")
+            self.assertEqual(e.reason, "partial")
+        self.assertEqual(sum(e.subtotal_cents for e in entries), -self.order.subtotal_cents)
+        self.assertEqual(sum(e.tax_cents for e in entries), -self.order.tax_cents)
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 0)
+
+    def test_penny_by_penny_refund_reverses_all_tax(self) -> None:
+        # Rounding each 1-cent refund on its own would reverse 0 tax; the cumulative method reverses all 330.
+        for i in range(self.order.total_cents):
+            self.refund(1, f"p{i}")
+        self.assertEqual(-sum(e.tax_cents for e in self.refunds()), 330)
+        self.assertEqual(-sum(e.subtotal_cents for e in self.refunds()), 3998)
+        with self.assertRaises(ValidationError):
+            self.refund(1, "one-more")
+
+    def test_refund_of_discounted_order_uses_charged_amounts(self) -> None:
+        self.svc.register_promo("PCT10", percent_off=10)
+        order = self.svc.place_order("acct_2", [LineItem(sku="seat", unit_cents=1999, quantity=2)],
+                                     tax_bps=825, promo_code="PCT10")  # 3598 + 297 = 3895
