+            self.svc.upgrade_subscription("sub_missing", "pro", 1, 30, idempotency_key="k1")
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(self.sub.subscription_id, "enterprise", 1, 30, idempotency_key="k1")
+        self.assertEqual(self.entries(), [])
