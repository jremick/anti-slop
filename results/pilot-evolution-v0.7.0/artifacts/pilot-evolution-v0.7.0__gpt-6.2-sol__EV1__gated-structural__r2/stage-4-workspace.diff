+
+    def fail_audit(self, event: dict) -> None:
+        self.events.append(event)
+        raise self.sink_error
+
+    def test_each_mutation_emits_one_event_and_replays_skip_the_sink(self) -> None:
+        order = self.service.place_order("acct", self.items, tax_bps=1_000)
+        upgrade = self.service.upgrade_subscription(
+            self.subscription.subscription_id, "pro", 1, 2, idempotency_key="upgrade",
+        )
+        refund = self.service.refund_order(order.order_id, 30, reason="Return", idempotency_key="refund")
+
