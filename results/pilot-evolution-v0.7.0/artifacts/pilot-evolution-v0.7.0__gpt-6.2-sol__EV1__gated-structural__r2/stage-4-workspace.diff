+        self.assertEqual((capped.discount_cents, capped.subtotal_cents), (105, 0))
+        self.assertEqual((capped.tax_cents, capped.total_cents), (0, 0))
+
+    def test_invalid_promo_registrations_raise(self) -> None:
+        for settings in (
+            {},
