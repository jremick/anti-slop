+    def test_percentage_discount_rounds_half_up_before_tax(self) -> None:
+        self.service.register_promo("HALF", percent_off=50)
+        order = self.service.place_order("acct", self.items, tax_bps=1_000, promo_code="HALF")
+
+        self.assertEqual(order.promo_code, "HALF")
+        self.assertEqual(order.discount_cents, 53)
+        self.assertEqual(order.subtotal_cents, 52)
+        self.assertEqual(order.tax_cents, 5)
+        self.assertEqual(order.total_cents, 57)
