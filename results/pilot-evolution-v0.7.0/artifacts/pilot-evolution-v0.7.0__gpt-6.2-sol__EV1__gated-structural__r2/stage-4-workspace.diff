+"""Tests for refund allocation, replay, and credit notes."""
+
+from concurrent.futures import ThreadPoolExecutor
+import unittest
+
+from ev1_order_ledger import LineItem, OrderService, Plan, ValidationError
+
+
+class OrderRefundTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.service = OrderService()
+        self.order = self.service.place_order("acct", [LineItem("seat", 7, 1)], tax_bps=4_000)
+
+    def test_partial_refunds_reverse_every_penny_of_discounted_order(self) -> None:
+        self.service.register_promo("FIXED", amount_off_cents=3)
+        order = self.service.place_order(
+            "promo-acct", [LineItem("seat", 10, 1)], tax_bps=4_000, promo_code="FIXED",
+        )
+        entries = []
+        for index, (amount, expected_tax) in enumerate(((2, 1), (2, 0), (2, 1), (4, 1))):
+            with self.subTest(amount=amount, index=index):
+                entry = self.service.refund_order(
+                    order.order_id, amount, reason="Return", idempotency_key=f"refund-{index}",
+                )
+                self.assertEqual(entry.kind, "order_refund")
+                self.assertEqual(entry.reference_id, order.order_id)
+                self.assertEqual(entry.account_id, order.account_id)
+                self.assertEqual(entry.total_cents, -amount)
+                self.assertEqual(entry.tax_cents, -expected_tax)
+                self.assertEqual(entry.subtotal_cents + entry.tax_cents, entry.total_cents)
+                entries.append(entry)
+
+        self.assertEqual(sum(entry.subtotal_cents for entry in entries), -order.subtotal_cents)
+        self.assertEqual(sum(entry.tax_cents for entry in entries), -order.tax_cents)
+        self.assertEqual(self.service.get_statement(order.account_id)["balance_cents"], 0)
+
+    def test_over_refund_leaves_balance_and_key_available(self) -> None:
+        order_id = self.order.order_id
+        self.service.refund_order(order_id, 7, reason="Return", idempotency_key="first")
+
+        with self.assertRaises(ValidationError):
+            self.service.refund_order(order_id, 4, reason="Return", idempotency_key="last")
+        statement = self.service.get_statement("acct")
+        self.assertEqual(statement["balance_cents"], 3)
+        self.assertEqual(statement["entry_count"], 2)
+
+        self.service.refund_order(order_id, 3, reason="Return", idempotency_key="last")
+        with self.assertRaises(ValidationError):
+            self.service.refund_order(order_id, 1, reason="Return", idempotency_key="over")
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], 0)
+
+    def test_invalid_refund_arguments_raise_validation_error(self) -> None:
+        order_id = self.order.order_id
+        for args in (
+            (order_id, 0, "Return", "refund"),
+            (order_id, -1, "Return", "refund"),
+            (order_id, True, "Return", "refund"),
+            (order_id, 1.0, "Return", "refund"),
+            ("unknown", 1, "Return", "refund"),
+            (order_id, 1, "  ", "refund"),
+            (order_id, 1, True, "refund"),
+            (order_id, 1, "Return", ""),
+        ):
+            with self.subTest(args=args), self.assertRaises(ValidationError):
+                order_id_arg, amount, reason, key = args
+                self.service.refund_order(order_id_arg, amount, reason=reason, idempotency_key=key)
+        self.assertEqual(self.service.get_statement("acct")["entry_count"], 1)
+
+    def test_refunds_replay_after_full_reversal_and_conflict_on_changed_arguments(self) -> None:
+        order_id = self.order.order_id
+        other = self.service.place_order("acct", [LineItem("other", 20, 1)])
+        entry = self.service.refund_order(order_id, 4, reason="Return", idempotency_key="refund")
+        self.service.refund_order(order_id, 6, reason="Return", idempotency_key="remainder")
+        second_service = OrderService(self.service.ledger)
+
+        replay = second_service.refund_order(order_id, 4, reason="Return", idempotency_key="refund")
+        self.assertIs(replay, entry)
+        for ref, amount, reason in ((other.order_id, 4, "Return"), (order_id, 3, "Return"), (order_id, 4, "Damage")):
+            with self.subTest(order_id=ref, amount=amount, reason=reason):
+                with self.assertRaisesRegex(ValidationError, "idempotency_key"):
+                    second_service.refund_order(ref, amount, reason=reason, idempotency_key="refund")
+        self.assertEqual(self.service.get_statement("acct")["entry_count"], 4)
+
+    def test_upgrade_and_refund_share_idempotency_keys(self) -> None:
+        self.service.register_plan(Plan("basic", "Basic", 100))
+        self.service.register_plan(Plan("pro", "Pro", 200))
+        subscription = self.service.start_subscription("acct", "basic")
+        self.service.upgrade_subscription(subscription.subscription_id, "pro", 1, 2, idempotency_key="used")
+
+        with self.assertRaisesRegex(ValidationError, "idempotency_key"):
+            self.service.refund_order(self.order.order_id, 1, reason="Return", idempotency_key="used")
+        self.assertEqual(self.service.get_statement("acct")["entry_count"], 2)
+
+    def test_concurrent_refunds_cannot_exceed_order_balance(self) -> None:
+        with ThreadPoolExecutor(max_workers=2) as executor:
+            requests = [
+                executor.submit(
+                    self.service.refund_order, self.order.order_id, 6, reason="Return", idempotency_key=key,
+                )
+                for key in ("first", "second")
+            ]
+        errors = [request.exception() for request in requests]
+        self.assertEqual(errors.count(None), 1)
+        self.assertIsInstance(next(error for error in errors if error is not None), ValidationError)
+        self.assertEqual(self.service.get_statement("acct")["balance_cents"], 4)
+
+    def test_export_credit_note_has_positive_magnitudes(self) -> None:
+        entry = self.service.refund_order(
+            self.order.order_id, 4, reason="Damaged in transit", idempotency_key="refund",
+        )
+        self.assertEqual(self.service.export_credit_note(entry.entry_id), {
+            "entry_id": entry.entry_id,
+            "order_id": self.order.order_id,
+            "account_id": "acct",
+            "subtotal_cents": 3,
+            "tax_cents": 1,
+            "total_cents": 4,
+            "reason": "Damaged in transit",
+        })
+        charge, _ = self.service.ledger.entries_for_account("acct")
+        for entry_id in (charge.entry_id, "unknown"):
+            with self.subTest(entry_id=entry_id), self.assertRaises(ValidationError):
+                self.service.export_credit_note(entry_id)

