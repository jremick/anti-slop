+        self.assertEqual((entry.subtotal_cents, entry.tax_cents, entry.total_cents), (52, 5, 57))
+
+    def test_fixed_discount_is_applied_before_tax_and_capped_at_subtotal(self) -> None:
+        self.service.register_promo("FIXED", amount_off_cents=120)
