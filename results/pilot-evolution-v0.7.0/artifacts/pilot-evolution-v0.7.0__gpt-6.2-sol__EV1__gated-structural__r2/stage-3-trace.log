{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc 'cat benchmarks/sources/ev1_order_ledger/{pricing,models}.py; python3 benchmarks/sources/ev1_order_ledger/run_checks.py'","aggregated_output":"\"\"\"Canonical integer-cent pricing calculations for EV1 order ledger.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom datetime import date\nfrom typing import Sequence\n\nfrom .models import LineItem, Promo, ValidationError\n\n\nLEGACY_FLAT_FEE_CENTS = 500\n\n\n@dataclass(frozen=True)\nclass PriceTotals:\n    subtotal_cents: int\n    discount_cents: int\n    tax_cents: int\n    total_cents: int\n\n\ndef parse_billing_date(value: str | None, field_name: str) -> date | None:\n    if value is None:\n        return None\n    if not isinstance(value, str):\n        raise ValidationError(f\"{field_name} must be a YYYY-MM-DD date\")\n    try:\n        parsed = date.fromisoformat(value)\n    except ValueError as error:\n        raise ValidationError(f\"{field_name} must be a YYYY-MM-DD date\") from error\n    if parsed.isoformat() != value:\n        raise ValidationError(f\"{field_name} must be a YYYY-MM-DD date\")\n    return parsed\n\n\ndef validate_non_negative_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value < 0:\n        raise ValidationError(f\"{field_name} must be a non-negative integer\")\n    return value\n\n\ndef validate_positive_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:\n        raise ValidationError(f\"{field_name} must be a positive integer\")\n    return value\n\n\ndef round_half_up_div(numerator: int, denominator: int) -> int:\n    \"\"\"Exact integer half-up division for non-negative numerator and positive denominator.\"\"\"\n    validate_non_negative_int(numerator, \"numerator\")\n    validate_positive_int(denominator, \"denominator\")\n    return (numerator * 2 + denominator) // (2 * denominator)\n\n\ndef compute_subtotal_cents(items: Sequence[LineItem]) -> int:\n    if not items:\n        raise ValidationError(\"items must be non-empty\")\n    subtotal = 0\n    for item in items:\n        validate_positive_int(item.unit_cents, \"unit_cents\")\n        validate_positive_int(item.quantity, \"quantity\")\n        subtotal += item.unit_cents * item.quantity\n    return subtotal\n\n\ndef compute_tax_cents(taxable_cents: int, tax_bps: int) -> int:\n    validate_non_negative_int(taxable_cents, \"taxable_cents\")\n    validate_non_negative_int(tax_bps, \"tax_bps\")\n    if tax_bps > 10_000:\n        raise ValidationError(\"tax_bps cannot exceed 10000\")\n    return round_half_up_div(taxable_cents * tax_bps, 10_000)\n\n\ndef calculate_totals(\n    subtotal_cents: int,\n    tax_bps: int,\n    *,\n    promo: Promo | None,\n    as_of: str | None,\n) -> PriceTotals:\n    \"\"\"Apply one eligible promo to the pre-tax subtotal, then calculate tax.\"\"\"\n    billing_date = parse_billing_date(as_of, \"as_of\")\n    discount = 0\n    if promo is not None:\n        if promo.expires_on is not None:\n            if billing_date is None:\n                raise ValidationError(\"as_of is required for an expiring promo\")\n            if billing_date > promo.expires_on:\n                raise ValidationError(\"promo has expired\")\n        if subtotal_cents < promo.min_subtotal_cents:\n            raise ValidationError(\"subtotal is below the promo minimum\")\n\n        if promo.amount_off_cents is not None:\n            discount = min(promo.amount_off_cents, subtotal_cents)\n        elif promo.percent_off is not None:\n            discount = round_half_up_div(subtotal_cents * promo.percent_off, 100)\n        else:\n            raise ValidationError(\"promo has no discount\")\n\n    taxable_cents = subtotal_cents - discount\n    tax = compute_tax_cents(taxable_cents, tax_bps)\n    return PriceTotals(taxable_cents, discount, tax, taxable_cents + tax)\n\n\ndef calculate_order_totals(\n    items: Sequence[LineItem],\n    *,\n    tax_bps: int = 0,\n    legacy_flat_fee: bool = False,\n    promo: Promo | None = None,\n    as_of: str | None = None,\n) -> PriceTotals:\n    subtotal = compute_subtotal_cents(items)\n    if legacy_flat_fee:\n        subtotal += LEGACY_FLAT_FEE_CENTS\n    return calculate_totals(subtotal, tax_bps, promo=promo, as_of=as_of)\n\n\ndef calculate_upgrade_totals(\n    monthly_difference_cents: int,\n    days_remaining: int,\n    cycle_days: int,\n    tax_bps: int,\n    *,\n    promo: Promo | None = None,\n    as_of: str | None = None,\n) -> PriceTotals:\n    \"\"\"Price a validated upgrade period, rounding the subtotal before tax.\"\"\"\n    subtotal = round_half_up_div(monthly_difference_cents * days_remaining, cycle_days)\n    return calculate_totals(subtotal, tax_bps, promo=promo, as_of=as_of)\n\"\"\"Core domain models for the EV1 order ledger fixture.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom datetime import date\nfrom typing import Tuple\n\n\nclass BillingError(Exception):\n    \"\"\"Base error for billing domain failures.\"\"\"\n\n\nclass ValidationError(BillingError):\n    \"\"\"Raised when input arguments or business invariants are violated.\"\"\"\n\n\n@dataclass(frozen=True)\nclass Plan:\n    plan_id: str\n    name: str\n    monthly_cents: int\n    tax_bps: int = 0\n\n\n@dataclass(frozen=True)\nclass Promo:\n    code: str\n    percent_off: int | None\n    amount_off_cents: int | None\n    expires_on: date | None\n    min_subtotal_cents: int\n\n\n@dataclass(frozen=True)\nclass LineItem:\n    sku: str\n    unit_cents: int\n    quantity: int\n\n\n@dataclass(frozen=True)\nclass Order:\n    order_id: str\n    account_id: str\n    items: Tuple[LineItem, ...]\n    subtotal_cents: int\n    tax_cents: int\n    total_cents: int\n    discount_cents: int = 0\n    promo_code: str | None = None\n\n\n@dataclass\nclass Subscription:\n    subscription_id: str\n    account_id: str\n    plan_id: str\n    status: str = \"active\"\n\n\n@dataclass(frozen=True)\nclass LedgerEntry:\n    entry_id: str\n    account_id: str\n    kind: str\n    subtotal_cents: int\n    tax_cents: int\n    total_cents: int\n    reference_id: str\n    reason: str = \"\"\n    metadata: dict = field(default_factory=dict)\ntest_invalid_order_inputs_fail_closed (test_orders.BaselineOrderLedgerTests) ... ok\ntest_legacy_flat_fee_adds_500_cents_before_tax (test_orders.BaselineOrderLedgerTests) ... ok\ntest_place_order_computes_exact_integer_tax_and_records_entry (test_orders.BaselineOrderLedgerTests) ... ok\ntest_start_subscription_validates_plan (test_orders.BaselineOrderLedgerTests) ... ok\ntest_fixed_discount_includes_legacy_fee_and_is_capped_at_subtotal (test_promos.PromoTests) ... ok\ntest_ineligible_promos_fail_closed_on_both_paths (test_promos.PromoTests) ... ok\ntest_invalid_promo_registrations_raise (test_promos.PromoTests) ... ok\ntest_order_accepts_minimum_subtotal_on_expiry_date (test_promos.PromoTests) ... ok\ntest_percentage_discount_rounds_half_up_before_tax (test_promos.PromoTests) ... ok\ntest_upgrade_applies_promo_after_rounding_proration_and_before_tax (test_promos.PromoTests) ... ok\ntest_upgrade_replay_compares_promo_code_and_as_of (test_promos.PromoTests) ... ok\ntest_concurrent_replays_record_one_entry (test_upgrades.SubscriptionUpgradeTests) ... ok\ntest_invalid_periods_do_not_change_subscription_or_consume_key (test_upgrades.SubscriptionUpgradeTests) ... ok\ntest_proration_accepts_zero_and_the_full_cycle (test_upgrades.SubscriptionUpgradeTests) ... ok\ntest_replay_returns_original_entry_after_another_upgrade (test_upgrades.SubscriptionUpgradeTests) ... ok\ntest_reused_key_rejects_changes_to_any_argument (test_upgrades.SubscriptionUpgradeTests) ... ok\ntest_unknown_ids_non_upgrades_and_invalid_keys_raise (test_upgrades.SubscriptionUpgradeTests) ... ok\ntest_upgrade_rounds_subtotal_half_up_before_applying_new_plan_tax (test_upgrades.SubscriptionUpgradeTests) ... ok\n\n----------------------------------------------------------------------\nRan 18 tests in 0.001s\n\nOK\n","exit_code":0,"status":"completed"}}
