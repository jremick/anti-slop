+"""Tests for prorated subscription upgrades and idempotency."""
+
+from concurrent.futures import ThreadPoolExecutor
+import unittest
+
+from ev1_order_ledger import OrderService, Plan, ValidationError
+
+
+class SubscriptionUpgradeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.service = OrderService()
+        for plan in (
+            Plan("basic", "Basic", 1_000),
+            Plan("plus", "Plus", 1_009, tax_bps=1_000),
+            Plan("premium", "Premium", 2_000),
+        ):
+            self.service.register_plan(plan)
+        self.subscription = self.service.start_subscription("acct_1", "basic")
+
+    def test_upgrade_rounds_subtotal_half_up_before_applying_new_plan_tax(self) -> None:
+        entry = self.service.upgrade_subscription(
+            self.subscription.subscription_id, "plus", 1, 2, idempotency_key="upgrade",
+        )
+
+        self.assertEqual(entry.subtotal_cents, 5)  # 9 / 2 rounds to 5.
+        self.assertEqual(entry.tax_cents, 1)  # 10% of 5 rounds to 1.
+        self.assertEqual(entry.total_cents, 6)
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.subscription.subscription_id)
+        self.assertEqual(entry.account_id, self.subscription.account_id)
+        self.assertEqual(self.subscription.plan_id, "plus")
+        self.assertIs(self.service.ledger.get_entry(entry.entry_id), entry)
+        statement = self.service.get_statement(self.subscription.account_id)
+        self.assertEqual(statement["balance_cents"], 6)
+        self.assertEqual(statement["entry_count"], 1)
+
+    def test_proration_accepts_zero_and_the_full_cycle(self) -> None:
+        for days_remaining, expected_subtotal in ((0, 0), (30, 9)):
+            with self.subTest(days_remaining=days_remaining):
+                subscription = self.service.start_subscription("acct_1", "basic")
+                entry = self.service.upgrade_subscription(
+                    subscription.subscription_id, "plus", days_remaining, 30,
+                    idempotency_key=f"upgrade-{days_remaining}",
+                )
+                self.assertEqual(entry.subtotal_cents, expected_subtotal)
+                self.assertEqual(subscription.plan_id, "plus")
+
+    def test_invalid_periods_do_not_change_subscription_or_consume_key(self) -> None:
+        for days_remaining, cycle_days in (
+            (0, 0), (0, -1), (-1, 30), (31, 30), (True, 30), (0, True), (1.0, 30), (1, 30.0),
+        ):
