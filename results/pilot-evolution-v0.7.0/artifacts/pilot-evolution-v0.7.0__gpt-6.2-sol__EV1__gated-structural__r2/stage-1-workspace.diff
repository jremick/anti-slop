+"""Tests for prorated subscription upgrades and idempotency."""
+
+from concurrent.futures import ThreadPoolExecutor
+import unittest
+
+from ev1_order_ledger import OrderService, Plan, ValidationError
+
+
+class SubscriptionUpgradeTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.service = OrderService()
+        for plan in (
+            Plan("basic", "Basic", 1_000),
+            Plan("plus", "Plus", 1_009, tax_bps=1_000),
+            Plan("premium", "Premium", 2_000),
+        ):
+            self.service.register_plan(plan)
+        self.subscription = self.service.start_subscription("acct_1", "basic")
+
+    def test_upgrade_rounds_subtotal_half_up_before_applying_new_plan_tax(self) -> None:
+        entry = self.service.upgrade_subscription(
+            self.subscription.subscription_id, "plus", 1, 2, idempotency_key="upgrade",
+        )
+
+        self.assertEqual(entry.subtotal_cents, 5)  # 9 / 2 rounds to 5.
+        self.assertEqual(entry.tax_cents, 1)  # 10% of 5 rounds to 1.
+        self.assertEqual(entry.total_cents, 6)
+        self.assertEqual(entry.kind, "plan_upgrade")
+        self.assertEqual(entry.reference_id, self.subscription.subscription_id)
+        self.assertEqual(entry.account_id, self.subscription.account_id)
+        self.assertEqual(self.subscription.plan_id, "plus")
+        self.assertIs(self.service.ledger.get_entry(entry.entry_id), entry)
+        statement = self.service.get_statement(self.subscription.account_id)
+        self.assertEqual(statement["balance_cents"], 6)
+        self.assertEqual(statement["entry_count"], 1)
+
+    def test_proration_accepts_zero_and_the_full_cycle(self) -> None:
+        for days_remaining, expected_subtotal in ((0, 0), (30, 9)):
+            with self.subTest(days_remaining=days_remaining):
+                subscription = self.service.start_subscription("acct_1", "basic")
+                entry = self.service.upgrade_subscription(
+                    subscription.subscription_id, "plus", days_remaining, 30,
+                    idempotency_key=f"upgrade-{days_remaining}",
+                )
+                self.assertEqual(entry.subtotal_cents, expected_subtotal)
+                self.assertEqual(subscription.plan_id, "plus")
+
+    def test_invalid_periods_do_not_change_subscription_or_consume_key(self) -> None:
+        for days_remaining, cycle_days in (
+            (0, 0), (0, -1), (-1, 30), (31, 30), (True, 30), (0, True), (1.0, 30), (1, 30.0),
+        ):
+            with self.subTest(days_remaining=days_remaining, cycle_days=cycle_days):
+                with self.assertRaises(ValidationError):
+                    self.service.upgrade_subscription(
+                        self.subscription.subscription_id, "plus", days_remaining, cycle_days,
+                        idempotency_key="upgrade",
+                    )
+        self.assertEqual(self.subscription.plan_id, "basic")
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [])
+        self.service.upgrade_subscription(
+            self.subscription.subscription_id, "plus", 1, 30, idempotency_key="upgrade",
+        )
+
+    def test_unknown_ids_non_upgrades_and_invalid_keys_raise(self) -> None:
+        self.service.register_plan(Plan("same-price", "Same Price", 1_000))
+        self.service.register_plan(Plan("cheaper", "Cheaper", 500))
+        subscription_id = self.subscription.subscription_id
+        for sub_id, plan_id, key in (
+            ("unknown", "plus", "upgrade"),
+            (subscription_id, "unknown", "upgrade"),
+            (subscription_id, "basic", "upgrade"),
+            (subscription_id, "same-price", "upgrade"),
+            (subscription_id, "cheaper", "upgrade"),
+            (False, "plus", "upgrade"),
+            (subscription_id, True, "upgrade"),
+            (subscription_id, "plus", True),
+            (subscription_id, "plus", ""),
+            (subscription_id, "plus", "  "),
+        ):
+            with self.subTest(subscription_id=sub_id, new_plan_id=plan_id, key=key):
+                with self.assertRaises(ValidationError):
+                    self.service.upgrade_subscription(sub_id, plan_id, 1, 2, idempotency_key=key)
+        self.assertEqual(self.subscription.plan_id, "basic")
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [])
+
+    def test_replay_returns_original_entry_after_another_upgrade(self) -> None:
+        subscription_id = self.subscription.subscription_id
+        entry = self.service.upgrade_subscription(
+            subscription_id, "plus", 1, 2, idempotency_key="first",
+        )
+        later_entry = self.service.upgrade_subscription(
+            subscription_id, "premium", 1, 2, idempotency_key="second",
+        )
+        another_service = OrderService(self.service.ledger)
+
+        replay = another_service.upgrade_subscription(
+            subscription_id, "plus", 1, 2, idempotency_key="first",
+        )
+
+        self.assertIs(replay, entry)
+        self.assertEqual(self.subscription.plan_id, "premium")
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [entry, later_entry])
+
+    def test_reused_key_rejects_changes_to_any_argument(self) -> None:
+        subscription_id = self.subscription.subscription_id
+        other = self.service.start_subscription("acct_2", "basic")
+        entry = self.service.upgrade_subscription(
+            subscription_id, "plus", 1, 2, idempotency_key="upgrade",
+        )
+        for arguments in (
+            (other.subscription_id, "plus", 1, 2),
+            (subscription_id, "premium", 1, 2),
+            (subscription_id, "plus", 0, 2),
+            (subscription_id, "plus", 1, 3),
+        ):
+            with self.subTest(arguments=arguments):
+                with self.assertRaisesRegex(ValidationError, "idempotency_key"):
+                    self.service.upgrade_subscription(*arguments, idempotency_key="upgrade")
+        with self.assertRaises(ValidationError):
+            self.service.upgrade_subscription(
+                subscription_id, "plus", True, 2, idempotency_key="upgrade",
+            )
+        self.assertEqual(self.subscription.plan_id, "plus")
+        self.assertEqual(other.plan_id, "basic")
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [entry])
+        self.assertEqual(self.service.ledger.entries_for_account("acct_2"), [])
+
+    def test_concurrent_replays_record_one_entry(self) -> None:
+        def upgrade() -> object:
+            return self.service.upgrade_subscription(
+                self.subscription.subscription_id, "plus", 1, 2, idempotency_key="upgrade",
+            )
+
+        with ThreadPoolExecutor(max_workers=4) as executor:
+            pending = [executor.submit(upgrade) for _ in range(4)]
+            entries = [future.result() for future in pending]
+
+        for entry in entries:
+            self.assertIs(entry, entries[0])
+        self.assertEqual(self.service.ledger.entries_for_account("acct_1"), [entries[0]])
