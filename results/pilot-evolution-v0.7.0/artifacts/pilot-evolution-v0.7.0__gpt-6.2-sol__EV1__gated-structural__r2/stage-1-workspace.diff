+    def upgrade_subscription(
+        self,
+        subscription_id: str,
+        new_plan_id: str,
+        days_remaining: int,
+        cycle_days: int,
+        *,
+        idempotency_key: str,
+    ) -> LedgerEntry:
+        for field, value in (
+            ("subscription_id", subscription_id),
+            ("new_plan_id", new_plan_id),
+            ("idempotency_key", idempotency_key),
+        ):
+            if not isinstance(value, str) or not value.strip():
+                raise ValidationError(f"{field} must be a non-empty string")
+        validate_non_negative_int(days_remaining, "days_remaining")
+        validate_positive_int(cycle_days, "cycle_days")
+        if days_remaining > cycle_days:
+            raise ValidationError("days_remaining cannot exceed cycle_days")
+
+        request = (subscription_id, new_plan_id, days_remaining, cycle_days)
+        with self._lock:
+            previous = self._upgrades.get(idempotency_key)
+            if previous is not None:
+                previous_request, entry = previous
+                if request != previous_request:
+                    raise ValidationError("idempotency_key already used with different arguments")
+                return entry
+
+            subscription = self.get_subscription(subscription_id)
+            old_plan = self.get_plan(subscription.plan_id)
+            new_plan = self.get_plan(new_plan_id)
+            difference = new_plan.monthly_cents - old_plan.monthly_cents
+            if difference <= 0:
+                raise ValidationError("new plan must cost more than the current plan")
+
+            subtotal, tax, total = calculate_upgrade_totals(
+                difference, days_remaining, cycle_days, new_plan.tax_bps,
+            )
+            entry = LedgerEntry(
+                entry_id=self.next_id("ent"),
+                account_id=subscription.account_id,
+                kind="plan_upgrade",
+                subtotal_cents=subtotal,
+                tax_cents=tax,
+                total_cents=total,
+                reference_id=subscription_id,
+            )
+            self.record_entry(entry)
+            subscription.plan_id = new_plan_id
+            self._upgrades[idempotency_key] = (request, entry)
+            return entry
+
     def record_entry(self, entry: LedgerEntry) -> None:
         self._entries[entry.entry_id] = entry
         self._entry_order.append(entry.entry_id)

