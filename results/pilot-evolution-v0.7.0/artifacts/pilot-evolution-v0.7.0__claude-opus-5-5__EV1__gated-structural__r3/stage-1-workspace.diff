+
+def validate_proration_window(days_remaining: int, cycle_days: int) -> None:
+    validate_positive_int(cycle_days, "cycle_days")
+    validate_non_negative_int(days_remaining, "days_remaining")
+    if days_remaining > cycle_days:
+        raise ValidationError("days_remaining cannot exceed cycle_days")
+
+
+def calculate_upgrade_proration(
+    old_plan: Plan,
+    new_plan: Plan,
+    days_remaining: int,
+    cycle_days: int,
+) -> Tuple[int, int, int]:
+    """Return (subtotal_cents, tax_cents, total_cents) for a mid-cycle plan upgrade.
+
+    The subtotal is the monthly price difference prorated over the remaining
+    days with exact half-up rounding; tax uses the new plan's rate.
+    """
+    validate_proration_window(days_remaining, cycle_days)
+    if new_plan.monthly_cents <= old_plan.monthly_cents:
+        raise ValidationError("new plan must cost more than the current plan")
+    subtotal = round_half_up_div(
+        (new_plan.monthly_cents - old_plan.monthly_cents) * days_remaining,
+        cycle_days,
+    )
+    tax = compute_tax_cents(subtotal, new_plan.tax_bps)
+    return subtotal, tax, subtotal + tax

