+def allocate_refund_cents(
+    order_subtotal_cents: int,
+    order_tax_cents: int,
+    refunded_total_cents: int,
+    refunded_tax_cents: int,
+    amount_cents: int,
+) -> Tuple[int, int]:
+    """Split a refund into (subtotal_cents, tax_cents) that sum to ``amount_cents``.
+
+    Tax is reversed cumulatively: after this refund the total tax reversed is
+    ``round_half_up(order_tax * refunded_so_far / order_total)``. Because that
+    target is computed from the running total rather than per chunk, rounding
+    never accumulates and a full refund reverses exactly ``order_tax_cents``.
+    """
+    validate_non_negative_int(order_subtotal_cents, "order_subtotal_cents")
+    validate_non_negative_int(order_tax_cents, "order_tax_cents")
+    validate_non_negative_int(refunded_total_cents, "refunded_total_cents")
+    validate_non_negative_int(refunded_tax_cents, "refunded_tax_cents")
+    validate_positive_int(amount_cents, "amount_cents")
+    order_total = order_subtotal_cents + order_tax_cents
+    cumulative_total = refunded_total_cents + amount_cents
+    if cumulative_total > order_total:
+        raise ValidationError(
+            f"refund of {amount_cents} cents exceeds the remaining "
+            f"{order_total - refunded_total_cents} refundable cents"
+        )
+    cumulative_tax = round_half_up_div(order_tax_cents * cumulative_total, order_total)
+    refund_tax = cumulative_tax - refunded_tax_cents
+    return amount_cents - refund_tax, refund_tax

