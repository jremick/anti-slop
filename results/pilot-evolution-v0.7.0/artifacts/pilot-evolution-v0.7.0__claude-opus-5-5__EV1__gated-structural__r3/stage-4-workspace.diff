+"""Unit tests for partial order refunds and credit-note export."""
+
+from __future__ import annotations
+
+import random
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, ValidationError
+from ev1_order_ledger.pricing import allocate_refund_cents
+
+
+def seat(unit_cents: int, quantity: int = 1) -> list:
+    return [LineItem(sku="seat", unit_cents=unit_cents, quantity=quantity)]
+
+
+class RefundTestCase(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        # subtotal 3998, tax 329.835 -> 330, total 4328
+        self.order = self.svc.place_order("acct_1", seat(1999, 2), tax_bps=825)
+        self.key_seq = 0
+
+    def refund(self, amount: int, *, order_id: str | None = None, reason: str = "partial", key: str | None = None):
+        if key is None:
+            self.key_seq += 1
+            key = f"r{self.key_seq}"
+        return self.svc.refund_order(
+            order_id or self.order.order_id, amount, reason=reason, idempotency_key=key
+        )
+
+    def refunds(self) -> list:
+        return [e for e in self.svc.ledger.entries_for_account("acct_1") if e.kind == "order_refund"]
+
+    def assertRefund(self, entry, subtotal: int, tax: int) -> None:
+        self.assertEqual(
+            (entry.subtotal_cents, entry.tax_cents, entry.total_cents),
+            (-subtotal, -tax, -(subtotal + tax)),
+        )
+
+
+class RefundAllocationTests(RefundTestCase):
+    def test_single_partial_refund_records_negative_entry(self) -> None:
+        entry = self.refund(1000, reason="damaged seat")
+        # cumulative tax 330 * 1000 / 4328 = 76.25 -> 76
+        self.assertRefund(entry, 924, 76)
+        self.assertEqual(entry.kind, "order_refund")
+        self.assertEqual(entry.reference_id, self.order.order_id)
+        self.assertEqual(entry.account_id, "acct_1")
+        self.assertEqual(entry.reason, "damaged seat")
+        self.assertIs(self.svc.ledger.get_entry(entry.entry_id), entry)
+        self.assertEqual(self.svc.get_statement("acct_1"), {"account_id": "acct_1", "balance_cents": 3328, "entry_count": 2})
+
+    def test_multi_chunk_refund_reverses_exact_order_amounts(self) -> None:
+        first, second, third = self.refund(1000), self.refund(1000), self.refund(2328)
+        self.assertRefund(first, 924, 76)    # cum tax 76.25 -> 76
