+"""Unit tests for fail-closed audit logging of ledger mutations."""
+
+from __future__ import annotations
+
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, ValidationError
+
+
+class AuditUnavailable(RuntimeError):
+    pass
+
+
+class RecordingSink:
+    """Collects audit events; raises (after recording the attempt) while ``failing`` is set."""
+
+    def __init__(self) -> None:
+        self.events: list = []
+        self.attempts: list = []
+        self.failing = False
+
+    def __call__(self, event: dict) -> None:
+        self.attempts.append(dict(event))
+        if self.failing:
+            raise AuditUnavailable("audit backend down")
+        self.events.append(event)
+
+
+def seat(unit_cents: int, quantity: int = 1) -> list:
+    return [LineItem(sku="seat", unit_cents=unit_cents, quantity=quantity)]
+
+
+class AuditTestCase(unittest.TestCase):
+    def setUp(self) -> None:
+        self.sink = RecordingSink()
+        self.svc = OrderService(audit_sink=self.sink)
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+
+    def entries(self) -> list:
+        return self.svc.ledger.entries_for_account("acct_1")
+
+
+class AuditEmissionTests(AuditTestCase):
+    def test_each_committed_mutation_emits_one_event(self) -> None:
+        order = self.svc.place_order("acct_1", seat(1999, 2), tax_bps=825)
+        sub = self.svc.start_subscription("acct_1", "starter")
+        upgrade = self.svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="u1")
+        refund = self.svc.refund_order(order.order_id, 1000, reason="partial", idempotency_key="r1")
+        charge = self.entries()[0]
+        self.assertEqual(
+            self.sink.events,
+            [
+                {"action": "order_charge", "account_id": "acct_1", "amount_cents": 4328, "entry_id": charge.entry_id},
+                {"action": "plan_upgrade", "account_id": "acct_1", "amount_cents": 1083, "entry_id": upgrade.entry_id},
+                {"action": "order_refund", "account_id": "acct_1", "amount_cents": -1000, "entry_id": refund.entry_id},
+            ],
+        )
+        self.assertEqual([e.entry_id for e in self.entries()], [ev["entry_id"] for ev in self.sink.events])
+
+    def test_idempotent_replays_are_not_logged(self) -> None:
+        order = self.svc.place_order("acct_1", seat(1000))
+        sub = self.svc.start_subscription("acct_1", "starter")
+        self.svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="u1")
+        self.svc.refund_order(order.order_id, 500, reason="partial", idempotency_key="r1")
+        self.svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="u1")
+        self.svc.refund_order(order.order_id, 500, reason="partial", idempotency_key="r1")
+        self.assertEqual([ev["action"] for ev in self.sink.events], ["order_charge", "plan_upgrade", "order_refund"])
+
+    def test_rejected_mutations_are_not_logged(self) -> None:
+        order = self.svc.place_order("acct_1", seat(1000))
+        sub = self.svc.start_subscription("acct_1", "starter")
+        with self.assertRaises(ValidationError):
+            self.svc.place_order("acct_1", [])
+        with self.assertRaises(ValidationError):
+            self.svc.upgrade_subscription(sub.subscription_id, "starter", 15, 30, idempotency_key="u1")
+        with self.assertRaises(ValidationError):
+            self.svc.refund_order(order.order_id, 1001, reason="too much", idempotency_key="r1")
+        self.assertEqual(len(self.sink.attempts), 1)
+
+    def test_service_without_sink_still_commits(self) -> None:
+        svc = OrderService()
+        order = svc.place_order("acct_1", seat(1000))
+        self.assertEqual(svc.get_statement("acct_1")["balance_cents"], order.total_cents)
+
+    def test_non_callable_sink_is_rejected(self) -> None:
+        with self.assertRaises(ValidationError):
+            OrderService(audit_sink="not callable")
+
+
+class AuditFailClosedTests(AuditTestCase):
+    def test_failed_audit_does_not_commit_order(self) -> None:
+        self.sink.failing = True
+        with self.assertRaises(AuditUnavailable):
+            self.svc.place_order("acct_1", seat(1999, 2), tax_bps=825)
+        attempted = self.sink.attempts[-1]
+        self.assertIsNone(self.svc.ledger.get_entry(attempted["entry_id"]))
+        self.assertEqual(self.entries(), [])
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 0)
+        with self.assertRaises(ValidationError):
+            self.svc.ledger.get_order("ord_0001")  # the order id drawn for the failed attempt
+
+        self.sink.failing = False
+        order = self.svc.place_order("acct_1", seat(1999, 2), tax_bps=825)
+        self.assertIs(self.svc.ledger.get_order(order.order_id), order)
+        self.assertEqual([ev["entry_id"] for ev in self.sink.events], [e.entry_id for e in self.entries()])
+
+    def test_failed_audit_does_not_commit_upgrade(self) -> None:
+        sub = self.svc.start_subscription("acct_1", "starter")
+        self.sink.failing = True
+        with self.assertRaises(AuditUnavailable):
+            self.svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="u1")
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "starter")
+        self.assertEqual(self.entries(), [])
+
+        # The idempotency key was not consumed: a retry commits and is logged.
+        self.sink.failing = False
+        entry = self.svc.upgrade_subscription(sub.subscription_id, "pro", 15, 30, idempotency_key="u1")
+        self.assertEqual(entry.total_cents, 1083)
+        self.assertEqual(self.svc.ledger.get_subscription(sub.subscription_id).plan_id, "pro")
+        self.assertEqual(self.sink.events[-1]["entry_id"], entry.entry_id)
+
+    def test_failed_audit_does_not_commit_refund(self) -> None:
+        order = self.svc.place_order("acct_1", seat(1999, 2), tax_bps=825)
+        self.sink.failing = True
+        with self.assertRaises(AuditUnavailable):
+            self.svc.refund_order(order.order_id, 1000, reason="partial", idempotency_key="r1")
+        self.assertEqual([e.kind for e in self.entries()], ["order_charge"])
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 4328)
+
+        # Nothing was counted as refunded, so the full total is still refundable under the same key.
+        self.sink.failing = False
+        refund = self.svc.refund_order(order.order_id, 4328, reason="partial", idempotency_key="r1")
+        self.assertEqual((refund.subtotal_cents, refund.tax_cents), (-3998, -330))
+        self.assertEqual(self.svc.get_statement("acct_1")["balance_cents"], 0)
+
+    def test_sink_mutating_event_cannot_alter_ledger(self) -> None:
+        def tampering_sink(event: dict) -> None:
+            event["amount_cents"] = 0
+            event["entry_id"] = "forged"
+
+        svc = OrderService(audit_sink=tampering_sink)
+        order = svc.place_order("acct_1", seat(1000))
+        (entry,) = svc.ledger.entries_for_account("acct_1")
+        self.assertEqual(entry.total_cents, order.total_cents)
+        self.assertNotEqual(entry.entry_id, "forged")
+
+
+if __name__ == "__main__":
+    unittest.main()

