+    def test_cumulative_rounding_avoids_drift_that_per_chunk_rounding_would_cause(self) -> None:
+        order = self.svc.place_order("acct_1", seat(101), tax_bps=1000)  # 101 + 10 = 111
+        # Rounding each 37-cent chunk independently gives 3.33 -> 3 three times = 9 (drift of 1).
+        chunks = [self.refund(37, order_id=order.order_id) for _ in range(3)]
+        self.assertEqual([-e.tax_cents for e in chunks], [3, 4, 3])
+        self.assertEqual([-e.subtotal_cents for e in chunks], [34, 33, 34])
