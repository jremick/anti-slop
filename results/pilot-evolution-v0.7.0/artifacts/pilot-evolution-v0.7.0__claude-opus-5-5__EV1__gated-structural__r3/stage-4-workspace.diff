+    def test_random_chunkings_conserve_pennies(self) -> None:
+        rng = random.Random(20261127)
+        for _ in range(200):
+            subtotal = rng.randint(1, 50_000)
+            tax = rng.randint(0, subtotal)
+            total = subtotal + tax
+            refunded_total = refunded_tax = refunded_subtotal = 0
+            while refunded_total < total:
+                amount = rng.randint(1, total - refunded_total)
+                chunk_subtotal, chunk_tax = allocate_refund_cents(subtotal, tax, refunded_total, refunded_tax, amount)
+                self.assertEqual(chunk_subtotal + chunk_tax, amount)
+                self.assertGreaterEqual(chunk_subtotal, 0)
+                self.assertGreaterEqual(chunk_tax, 0)
+                refunded_total += amount
+                refunded_tax += chunk_tax
+                refunded_subtotal += chunk_subtotal
+            self.assertEqual((refunded_subtotal, refunded_tax), (subtotal, tax), msg=(subtotal, tax))
+
+    def test_refund_of_discounted_order_uses_discounted_amounts(self) -> None:
