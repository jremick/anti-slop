+def calculate_upgrade_proration(
+    old_plan: Plan,
+    new_plan: Plan,
+    days_remaining: int,
+    cycle_days: int,
+    *,
+    promo: Optional[Promo] = None,
+    as_of: Optional[date] = None,
+) -> PricedTotals:
+    """Price a mid-cycle plan upgrade.
+
+    The pre-discount subtotal is the monthly price difference prorated over the
+    remaining days with exact half-up rounding; tax uses the new plan's rate.
+    """
+    validate_proration_window(days_remaining, cycle_days)
+    if new_plan.monthly_cents <= old_plan.monthly_cents:
+        raise ValidationError("new plan must cost more than the current plan")
+    subtotal = round_half_up_div(
+        (new_plan.monthly_cents - old_plan.monthly_cents) * days_remaining,
+        cycle_days,
+    )
+    return apply_promo_and_tax(subtotal, new_plan.tax_bps, promo, as_of)
