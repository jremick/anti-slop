+def compute_discount_cents(subtotal_cents: int, promo: Promo, as_of: Optional[date]) -> int:
+    """Discount for ``promo`` on a pre-tax subtotal, never exceeding the subtotal."""
+    validate_non_negative_int(subtotal_cents, "subtotal_cents")
+    if promo.expires_on is not None:
+        if as_of is None:
+            raise ValidationError(f"promo {promo.code} expires; as_of is required")
+        if as_of > promo.expires_on:
+            raise ValidationError(f"promo {promo.code} expired on {promo.expires_on.isoformat()}")
+    if subtotal_cents < promo.min_subtotal_cents:
+        raise ValidationError(
+            f"promo {promo.code} requires a subtotal of at least {promo.min_subtotal_cents} cents"
