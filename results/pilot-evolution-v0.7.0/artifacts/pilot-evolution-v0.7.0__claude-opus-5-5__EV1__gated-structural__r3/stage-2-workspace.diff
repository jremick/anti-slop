+"""Unit tests for promo codes applied to orders and subscription upgrades."""
+
+from __future__ import annotations
+
+from datetime import date
+import unittest
+
+from ev1_order_ledger.api import OrderService
+from ev1_order_ledger.models import LineItem, Plan, ValidationError
+
+
+def seat(unit_cents: int, quantity: int = 1) -> list:
+    return [LineItem(sku="seat", unit_cents=unit_cents, quantity=quantity)]
+
+
+class PromoTestCase(unittest.TestCase):
+    def setUp(self) -> None:
+        self.svc = OrderService()
+        self.svc.register_plan(Plan(plan_id="starter", name="Starter", monthly_cents=1000, tax_bps=825))
+        self.svc.register_plan(Plan(plan_id="pro", name="Pro", monthly_cents=3000, tax_bps=825))
+        self.svc.register_promo("SAVE10", percent_off=10)
+        self.svc.register_promo("FIVE", amount_off_cents=500)
+        self.svc.register_promo("BIGFIXED", amount_off_cents=5000)
+        self.svc.register_promo("MIN20", percent_off=50, min_subtotal_cents=2000)
+        self.svc.register_promo("XMAS", percent_off=20, expires_on="2026-12-31")
+
+    def entry_count(self, account_id: str = "acct_1") -> int:
+        return len(self.svc.ledger.entries_for_account(account_id))
+
+    def assertOrderRejected(self, items, **kwargs) -> None:
+        before = self.entry_count()
+        with self.assertRaises(ValidationError):
+            self.svc.place_order("acct_1", items, **kwargs)
+        self.assertEqual(self.entry_count(), before)
+
+    def assertTotals(self, order, subtotal: int, discount: int, tax: int, total: int) -> None:
+        self.assertEqual(
+            (order.subtotal_cents, order.discount_cents, order.tax_cents, order.total_cents),
+            (subtotal, discount, tax, total),
+        )
+
+
+class RegisterPromoTests(PromoTestCase):
+    def test_returns_parsed_promo(self) -> None:
+        promo = self.svc.register_promo("NY", amount_off_cents=250, expires_on="2027-01-01", min_subtotal_cents=1000)
+        self.assertEqual(promo.amount_off_cents, 250)
+        self.assertIsNone(promo.percent_off)
+        self.assertEqual(promo.expires_on, date(2027, 1, 1))
+        self.assertEqual(promo.min_subtotal_cents, 1000)
+
+    def test_percent_bounds_are_inclusive(self) -> None:
+        one = self.svc.register_promo("ONE", percent_off=1)
+        everything = self.svc.register_promo("ALL", percent_off=100)
+        self.assertEqual((one.percent_off, everything.percent_off), (1, 100))
+        self.assertIs(self.svc.ledger.get_promo("ONE"), one)
+        self.assertIs(self.svc.ledger.get_promo("ALL"), everything)
+        # Both boundary promos must actually price orders: 1% of 1050 = 10.5 -> 11; 100% -> 0.
+        self.assertTotals(self.svc.place_order("acct_1", seat(1050), tax_bps=825, promo_code="ONE"), 1039, 11, 86, 1125)
+        self.assertTotals(self.svc.place_order("acct_1", seat(1050), tax_bps=825, promo_code="ALL"), 0, 1050, 0, 0)
+
+    def test_rejects_invalid_definitions(self) -> None:
+        cases = {
+            "neither discount": {},
+            "both discounts": {"percent_off": 10, "amount_off_cents": 100},
+            "zero percent": {"percent_off": 0},
+            "over 100 percent": {"percent_off": 101},
+            "bool percent": {"percent_off": True},
+            "float percent": {"percent_off": 10.0},
+            "zero amount": {"amount_off_cents": 0},
+            "negative amount": {"amount_off_cents": -100},
+            "bool amount": {"amount_off_cents": True},
+            "negative minimum": {"percent_off": 10, "min_subtotal_cents": -1},
+            "bool minimum": {"percent_off": 10, "min_subtotal_cents": True},
+            "bad expiry format": {"percent_off": 10, "expires_on": "12/31/2026"},
+            "compact expiry": {"percent_off": 10, "expires_on": "20261231"},
+            "impossible expiry": {"percent_off": 10, "expires_on": "2026-02-30"},
+            "date object expiry": {"percent_off": 10, "expires_on": date(2026, 12, 31)},
+        }
+        for label, kwargs in cases.items():
+            with self.subTest(label), self.assertRaises(ValidationError):
+                self.svc.register_promo("NEWCODE", **kwargs)
+
+    def test_rejects_bad_or_duplicate_codes(self) -> None:
+        for code in ("", "   ", "A,B", "A B", " SAVE", None):
+            with self.subTest(code=code), self.assertRaises(ValidationError):
+                self.svc.register_promo(code, percent_off=10)
+        with self.assertRaises(ValidationError):
+            self.svc.register_promo("SAVE10", percent_off=50)
+
+
