elf, attempt: int) -> int:\n    20\t        # Compute exponential backoff delay in milliseconds\n    21\t        if isinstance(attempt, bool) or not isinstance(attempt, int) or attempt < 1:\n    22\t            raise JobError(\"attempt must be a positive integer\")\n    23\t        shift = attempt - 1\n    24\t        multiplier = 1 << shift\n    25\t        delay = self.base_delay_ms * multiplier\n    26\t        return delay\n    27\t\n    28\t    def should_dead_letter(self, job: Job) -> bool:\n    29\t        # Return True once attempts reach max_attempts\n    30\t        return job.attempts >= self.max_attempts\n    31\t\n    32\t    def record_failure(self, job: Job, error_message: str) -> bool:\n    33\t        # Increment attempts counter and update job status\n    34\t        job.attempts += 1\n    35\t        job.last_error = str(error_message)\n    36\t        if self.should_dead_letter(job):\n    37\t            job.status = \"dead_letter\"\n    38\t            return True\n    39\t        job.status = \"retrying\"\n    40\t        return False\n     1\tfrom __future__ import annotations\n     2\t\n     3\tfrom collections import deque\n     4\tfrom typing import Any, Callable\n     5\t\n     6\ttry:\n     7\t    from .dedupe import DedupeRegistry\n     8\t    from .models import DeadLetterRecord, Job, JobError, JobResult\n     9\t    from .retry import RetryPolicy\n    10\t    from .storage import DeadLetterStore, ResultStore\n    11\texcept ImportError:\n    12\t    from dedupe import DedupeRegistry\n    13\t    from models import DeadLetterRecord, Job, JobError, JobResult\n    14\t    from retry import RetryPolicy\n    15\t    from storage import DeadLetterStore, ResultStore\n    16\t\n    17\t\n    18\t# FIFO in-memory queue with in-flight tracking\n    19\tclass InMemoryQueue:\n    20\t    def __init__(self) -> None:\n    21\t        # Initialize pending deque, in-flight map, and acked set\n    22\t        self._pending: deque[Job] = deque()\n    23\t        self._in_flight: dict[str, Job] = {}\n    24\t        self._acked: set[str] = set()\n    25\t\n    26\t    def enqueue(self, job: Job) -> None:\n    27\t        # Push job onto the pending queue\n    28\t        self._pending.append(job)\n    29\t\n    30\t    def dequeue(self) -> Job | None:\n    31\t        # Pop the next pending job and mark it in flight\n    32\t        if not self._pending:\n    33\t            return None\n    34\t        job = self._pending.popleft()\n    35\t        self._in_flight[job.job_id] = job\n    36\t        return job\n    37\t\n    38\t    def ack(self, job_id: str) -> None:\n    39\t        # Acknowledge an in-flight job and remove it from active tracking\n    40\t        if job_id not in self._in_flight:\n    41\t            raise JobError(f\"cannot ack job not in flight: {job_id}\")\n    42\t        self._in_flight.pop(job_id)\n    43\t        self._acked.add(job_id)\n    44\t\n    45\t    def nack(self, job_id: str, *, requeue: bool = True) -> Job:\n    46\t        # Release an in-flight job and optionally re-enqueue it\n    47\t        if job_id not in self._in_flight:\n    48\t            raise JobError(f\"cannot nack job not in flight: {job_id}\")\n    49\t        job = self._in_flight.pop(job_id)\n    50\t        if requeue:\n    51\t            self._pending.append(job)\n    52\t        return job\n    53\t\n    54\t    def pending_count(self) -> int:\n    55\t        # Return number of queued jobs\n    56\t        return len(self._pending)\n    57\t\n    58\t    def in_flight_ids(self) -> list[str]:\n    59\t        # Return list of currently in-flight job IDs\n    60\t        return list(self._in_flight)\n    61\t\n    62\t    def acked_ids(self) -> set[str]:\n    63\t        # Return copy of acknowledged job IDs\n    64\t        return set(self._acked)\n    65\t\n    66\t\n    67\t# Worker executing queued jobs with dedupe and retry handling\n    68\tclass JobWorker:\n    69\t    def __init__(self, queue: InMe