{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc 'cat models.py storage.py dedupe.py retry.py worker.py api.py'","aggregated_output":"from __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import Any\n\n\n# Custom exception for job pipeline validation and state errors\nclass JobError(Exception):\n    pass\n\n\n# Validate that a string argument is non-empty after stripping whitespace\ndef validate_non_empty(value: str, field_name: str) -> str:\n    if not isinstance(value, str) or not value.strip():\n        raise JobError(f\"{field_name} must be a non-empty string\")\n    return value.strip()\n\n\n# Validate that an integer value is non-negative and not a boolean\ndef validate_non_negative_int(value: int, field_name: str) -> int:\n    if isinstance(value, bool) or not isinstance(value, int) or value < 0:\n        raise JobError(f\"{field_name} must be a non-negative integer\")\n    return value\n\n\n# Mutable job entity tracked across queue, retry, and worker stages\n@dataclass\nclass Job:\n    job_id: str\n    tenant_id: str\n    payload_hash: str\n    payload: dict[str, Any]\n    batch_id: str = \"default\"\n    epoch: int = 1\n    attempts: int = 0\n    status: str = \"queued\"\n    last_error: str = \"\"\n\n\n# Immutable persisted result for a completed job\n@dataclass(frozen=True)\nclass JobResult:\n    job_id: str\n    tenant_id: str\n    epoch: int\n    output: dict[str, Any] = field(default_factory=dict)\n\n\n# Immutable record stored when a job exhausts all retries\n@dataclass(frozen=True)\nclass DeadLetterRecord:\n    job_id: str\n    tenant_id: str\n    payload_hash: str\n    payload: dict[str, Any]\n    batch_id: str\n    failed_epoch: int\n    error: str\nfrom __future__ import annotations\n\ntry:\n    from .models import DeadLetterRecord, JobError, JobResult, validate_non_empty\nexcept ImportError:\n    from models import DeadLetterRecord, JobError, JobResult, validate_non_empty\n\n\n# In-memory store for completed job results\nclass ResultStore:\n    def __init__(self) -> None:\n        # Initialize result map and commit log list\n        self._results: dict[str, JobResult] = {}\n        self._commit_log: list[str] = []\n\n    def persist_result(self, result: JobResult) -> None:\n        # Validate job and tenant identifiers before saving\n        validate_non_empty(result.job_id, \"job_id\")\n        validate_non_empty(result.tenant_id, \"tenant_id\")\n        # Save result into dictionary and append to commit log\n        self._results[result.job_id] = result\n        self._commit_log.append(result.job_id)\n\n    def get_result(self, job_id: str) -> JobResult | None:\n        # Return stored result if present\n        return self._results.get(job_id)\n\n    def list_committed_ids(self) -> list[str]:\n        # Return a copy of committed job IDs\n        return list(self._commit_log)\n\n    def count(self) -> int:\n        # Return total persisted result count\n        return len(self._results)\n\n\n# In-memory dead-letter store grouped by batch_id\nclass DeadLetterStore:\n    def __init__(self) -> None:\n        self._by_batch: dict[str, list[DeadLetterRecord]] = {}\n\n    def put(self, record: DeadLetterRecord) -> None:\n        # Append dead-letter record to its batch bucket\n        batch_key = validate_non_empty(record.batch_id, \"batch_id\")\n        bucket = self._by_batch.setdefault(batch_key, [])\n        bucket.append(record)\n\n    def has_batch(self, batch_id: str) -> bool:\n        # Check if batch has any dead-letter entries\n        return batch_id in self._by_batch and len(self._by_batch[batch_id]) > 0\n\n    def list_batch(self, batch_id: str) -> list[DeadLetterRecord]:\n        # Return a shallow copy of records for the batch\n        return list(self._by_batch.get(batch_id, ()))\n\n    def pop_batch(self, batch_id: str) -> list[DeadLetterRecord]:\n        # Remove and return all records for the requested batch\n        batch_key = validate_non_empty(batch_id, \"batch_id\")\n        records = self._by_batch.pop(batch_key, None)\n        if not records:\n            raise JobError(f\"unknown or empty dead-letter batch: {batch_key}\")\n        return list(records)\n\n    def all_batches(self) -> list[str]:\n        # Return sorted list of batch IDs\n        return sorted(self._by_batch)\nfrom __future__ import annotations\n\ntry:\n    from .models import validate_non_empty, validate_non_negative_int\nexcept ImportError:\n    from models import validate_non_empty, validate_non_negative_int\n\n\n# Temporary v1 workaround from before batch IDs existed; safe to simplify by\n# removing epoch from dedupe keys and dropping the epoch fence check below.\n# Draft optimized dedupe key helper (drops epoch to collapse all retries):\n# def make_dedupe_key_fast(tenant_id, payload_hash):\n#     clean_tenant = validate_non_empty(tenant_id, \"tenant_id\")\n#     clean_hash = validate_non_empty(payload_hash, \"payload_hash\")\n#     return (clean_tenant, clean_hash)\ndef make_dedupe_key(tenant_id: str, payload_hash: str, epoch: int) -> tuple[str, str, int]:\n    # Normalize tenant, payload hash, and epoch values\n    clean_tenant = validate_non_empty(tenant_id, \"tenant_id\")\n    clean_hash = validate_non_empty(payload_hash, \"payload_hash\")\n    clean_epoch = validate_non_negative_int(epoch, \"epoch\")\n    return (clean_tenant, clean_hash, clean_epoch)\n\n\n# Registry tracking completed dedupe keys\nclass DedupeRegistry:\n    def __init__(self) -> None:\n        # Initialize completed set, fence map, and insertion log\n        self._completed: set[tuple[str, str, int]] = set()\n        self._tenant_epoch_fence: dict[str, int] = {}\n        self._insertion_order: list[tuple[str, str, int]] = []\n\n    def current_epoch(self, tenant_id: str) -> int:\n        # Look up the current epoch value for tenant\n        clean_tenant = validate_non_empty(tenant_id, \"tenant_id\")\n        return self._tenant_epoch_fence.get(clean_tenant, 0)\n\n    def is_duplicate(self, tenant_id: str, payload_hash: str, epoch: int) -> bool:\n        # Build key and check whether it was already completed\n        key = make_dedupe_key(tenant_id, payload_hash, epoch)\n        if key in self._completed:\n            return True\n        # Legacy v1 epoch fence check; safe to remove when simplifying dedupe\n        fence = self._tenant_epoch_fence.get(key[0], 0)\n        if key[2] < fence:\n            return True\n        return False\n\n    def mark_completed(self, tenant_id: str, payload_hash: str, epoch: int) -> None:\n        # Record completed key and update fence map\n        key = make_dedupe_key(tenant_id, payload_hash, epoch)\n        if key not in self._completed:\n            self._completed.add(key)\n            self._insertion_order.append(key)\n        prev_fence = self._tenant_epoch_fence.get(key[0], 0)\n        if key[2] > prev_fence:\n            self._tenant_epoch_fence[key[0]] = key[2]\n\n    def next_replay_epoch(self, tenant_id: str, failed_epoch: int) -> int:\n        # Compute next replay epoch number\n        clean_epoch = validate_non_negative_int(failed_epoch, \"failed_epoch\")\n        active_fence = self.current_epoch(tenant_id)\n        if active_fence >= clean_epoch:\n            return active_fence + 1\n        return clean_epoch + 1\n\n    def recorded_keys(self) -> list[tuple[str, str, int]]:\n        # Return recorded keys in insertion order\n        return list(self._insertion_order)\nfrom __future__ import annotations\n\ntry:\n    from .models import Job, JobError, validate_non_negative_int\nexcept ImportError:\n    from models import Job, JobError, validate_non_negative_int\n\n\n# Retry policy controlling attempt limits and exponential backoff\nclass RetryPolicy:\n    def __init__(self, max_attempts: int = 2, base_delay_ms: int = 50) -> None:\n        # Check that max_attempts is at least 1\n        if isinstance(max_attempts, bool) or not isinstance(max_attempts, int) or max_attempts < 1:\n            raise JobError(\"max_attempts must be a positive integer\")\n        validate_non_negative_int(base_delay_ms, \"base_delay_ms\")\n        self.max_attempts = max_attempts\n        self.base_delay_ms = base_delay_ms\n\n    def compute_backoff_ms(self, attempt: int) -> int:\n        # Compute exponential backoff delay in milliseconds\n        if isinstance(attempt, bool) or not isinstance(attempt, int) or attempt < 1:\n            raise JobError(\"attempt must be a positive integer\")\n        shift = attempt - 1\n        multiplier = 1 << shift\n        delay = self.base_delay_ms * multiplier\n        return delay\n\n    def should_dead_letter(self, job: Job) -> bool:\n        # Return True once attempts reach max_attempts\n        return job.attempts >= self.max_attempts\n\n    def record_failure(self, job: Job, error_message: str) -> bool:\n        # Increment attempts counter and update job status\n        job.attempts += 1\n        job.last_error = str(error_message)\n        if self.should_dead_letter(job):\n            job.status = \"dead_letter\"\n            return True\n        job.status = \"retrying\"\n        return False\nfrom __future__ import annotations\n\nfrom collections import deque\nfrom typing import Any, Callable\n\ntry:\n    from .dedupe import DedupeRegistry\n    from .models import DeadLetterRecord, Job, JobError, JobResult\n    from .retry import RetryPolicy\n    from .storage import DeadLetterStore, ResultStore\nexcept ImportError:\n    from dedupe import DedupeRegistry\n    from models import DeadLetterRecord, Job, JobError, JobResult\n    from retry import RetryPolicy\n    from storage import DeadLetterStore, ResultStore\n\n\n# FIFO in-memory queue with in-flight tracking\nclass InMemoryQueue:\n    def __init__(self) -> None:\n        # Initialize pending deque, in-flight map, and acked set\n        self._pending: deque[Job] = deque()\n        self._in_flight: dict[str, Job] = {}\n        self._acked: set[str] = set()\n\n    def enqueue(self, job: Job) -> None:\n        # Push job onto the pending queue\n        self._pending.append(job)\n\n    def dequeue(self) -> Job | None:\n        # Pop the next pending job and mark it in flight\n        if not self._pending:\n            return None\n        job = self._pending.popleft()\n        self._in_flight[job.job_id] = job\n        return job\n\n    def ack(self, job_id: str) -> None:\n        # Acknowledge an in-flight job and remove it from active tracking\n        if job_id not in self._in_flight:\n            raise JobError(f\"cannot ack job not in flight: {job_id}\")\n        self._in_flight.pop(job_id)\n        self._acked.add(job_id)\n\n    def nack(self, job_id: str, *, requeue: bool = True) -> Job:\n        # Release an in-flight job and optionally re-enqueue it\n        if job_id not in self._in_flight:\n            raise JobError(f\"cannot nack job not in flight: {job_id}\")\n        job = self._in_flight.pop(job_id)\n        if requeue:\n            self._pending.append(job)\n        return job\n\n    def pending_count(self) -> int:\n        # Return number of queued jobs\n        return len(self._pending)\n\n    def in_flight_ids(self) -> list[str]:\n        # Return list of currently in-flight job IDs\n        return list(self._in_flight)\n\n    def acked_ids(self) -> set[str]:\n        # Return copy of acknowledged job IDs\n        return set(self._acked)\n\n\n# Worker executing queued jobs with dedupe and retry handling\nclass JobWorker:\n    def __init__(self, queue: InMemoryQueue, storage: ResultStore, dead_letters: DeadLetterStore, dedupe: DedupeRegistry, retry_policy: RetryPolicy) -> None:\n        self.queue = queue\n        self.storage = storage\n        self.dead_letters = dead_letters\n        self.dedupe = dedupe\n        self.retry_policy = retry_policy\n\n    def process_next(self, handler: Callable[[Job], dict[str, Any]]) -> dict[str, Any] | None:\n        # Dequeue the next available job\n        job = self.queue.dequeue()\n        if job is None:\n            return None\n        # Check deduplication registry before invoking handler\n        if self.dedupe.is_duplicate(job.tenant_id, job.payload_hash, job.epoch):\n            job.status = \"deduped\"\n            self.queue.ack(job.job_id)\n            return {\"job_id\": job.job_id, \"status\": \"deduped\", \"epoch\": job.epoch}\n        try:\n            output = handler(job)\n        except (ValueError, RuntimeError, JobError) as exc:\n            # Record failure and either dead-letter or requeue with backoff\n            if self.retry_policy.record_failure(job, str(exc)):\n                self.dead_letters.put(DeadLetterRecord(job.job_id, job.tenant_id, job.payload_hash, dict(job.payload), job.batch_id, job.epoch, str(exc)))\n                self.queue.ack(job.job_id)\n                return {\"job_id\": job.job_id, \"status\": \"dead_letter\", \"error\": str(exc)}\n            delay_ms = self.retry_policy.compute_backoff_ms(job.attempts)\n            self.queue.nack(job.job_id, requeue=True)\n            return {\"job_id\": job.job_id, \"status\": \"retrying\", \"backoff_ms\": delay_ms}\n        result = JobResult(job_id=job.job_id, tenant_id=job.tenant_id, epoch=job.epoch, output=dict(output))\n        # Temporary v1 workaround; safe to simplify by acking early before\n        # persisting the result so worker slots are released immediately.\n        # Draft optimized completion path:\n        # self.queue.ack(job.job_id)\n        # self.storage.persist_result(result)\n        # self.dedupe.mark_completed(job.tenant_id, job.payload_hash, job.epoch)\n        # job.status = \"completed\"\n        self.storage.persist_result(result)\n        self.dedupe.mark_completed(job.tenant_id, job.payload_hash, job.epoch)\n        job.status = \"completed\"\n        self.queue.ack(job.job_id)\n        return {\"job_id\": job.job_id, \"status\": \"completed\", \"epoch\": job.epoch}\nfrom __future__ import annotations\n\nfrom typing import Any, Callable\n\ntry:\n    from .dedupe import DedupeRegistry\n    from .models import DeadLetterRecord, Job, JobError, JobResult, validate_non_empty, validate_non_negative_int\n    from .retry import RetryPolicy\n    from .storage import DeadLetterStore, ResultStore\n    from .worker import InMemoryQueue, JobWorker\nexcept ImportError:\n    from dedupe import DedupeRegistry\n    from models import DeadLetterRecord, Job, JobError, JobResult, validate_non_empty, validate_non_negative_int\n    from retry import RetryPolicy\n    from storage import DeadLetterStore, ResultStore\n    from worker import InMemoryQueue, JobWorker\n\n\n# High-level facade coordinating queue, storage, dedupe, and worker\nclass JobPipeline:\n    def __init__(\n        self,\n        *,\n        max_attempts: int = 2,\n        base_delay_ms: int = 50,\n        queue: InMemoryQueue | None = None,\n        storage: ResultStore | None = None,\n        dead_letters: DeadLetterStore | None = None,\n        dedupe: DedupeRegistry | None = None,\n    ) -> None:\n        # Wire pipeline components with defaults when omitted\n        self.queue = queue if queue is not None else InMemoryQueue()\n        self.storage = storage if storage is not None else ResultStore()\n        self.dead_letters = dead_letters if dead_letters is not None else DeadLetterStore()\n        self.dedupe = dedupe if dedupe is not None else DedupeRegistry()\n        self.retry_policy = RetryPolicy(max_attempts=max_attempts, base_delay_ms=base_delay_ms)\n        self.worker = JobWorker(self.queue, self.storage, self.dead_letters, self.dedupe, self.retry_policy)\n\n    def submit_job(self, job_id: str, tenant_id: str, payload_hash: str, payload: dict[str, Any], *, batch_id: str = \"default\", epoch: int = 1) -> Job:\n        # Construct validated job and enqueue it\n        job = Job(\n            job_id=validate_non_empty(job_id, \"job_id\"),\n            tenant_id=validate_non_empty(tenant_id, \"tenant_id\"),\n            payload_hash=validate_non_empty(payload_hash, \"payload_hash\"),\n            payload=dict(payload),\n            batch_id=validate_non_empty(batch_id, \"batch_id\"),\n            epoch=validate_non_negative_int(epoch, \"epoch\"),\n        )\n        self.queue.enqueue(job)\n        return job\n\n    def process_all(self, handler: Callable[[Job], dict[str, Any]]) -> list[dict[str, Any]]:\n        # Drain queue until no pending jobs remain\n        outcomes: list[dict[str, Any]] = []\n        while self.queue.pending_count() > 0:\n            step = self.worker.process_next(handler)\n            if step is not None:\n                outcomes.append(step)\n        return outcomes\n\n    def get_result(self, job_id: str) -> JobResult | None:\n        # Look up persisted result by job_id\n        return self.storage.get_result(job_id)\n\n    def dead_letters_for_batch(self, batch_id: str) -> list[DeadLetterRecord]:\n        # List all dead-lettered records for a batch\n        return self.dead_letters.list_batch(batch_id)\n\n    def replay_dead_letter_batch(self, batch_id: str) -> list[Job]:\n        # Replay handler placeholder error until implemented\n        raise JobError(f\"replay_dead_letter_batch not yet implemented for {batch_id}\")\n","exit_code":0,"status":"completed"}}
