leted\\\",\n]\nassert replayed[0].epoch > replayed[1].epoch > 10\nfor job in replayed:\n    assert pipe.get_result(job.job_id).output == job.payload\nassert pipe.queue.in_flight_ids() == []\nprint(\\\"Multi-record replay, epoch fencing, retry, and batch isolation passed.\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
